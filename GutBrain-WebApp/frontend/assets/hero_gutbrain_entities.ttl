<http://purl.obolibrary.org/obo/NCIT_C39737> rdf:type owl:NamedIndividual ,
                                                      skos:Concept ,
                                                      <https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding> ;
