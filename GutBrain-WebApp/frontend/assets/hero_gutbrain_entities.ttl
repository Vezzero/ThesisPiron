                                                      <https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding> ;
                                             skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/DiseaseDisorderOrFinding> ;
                                             gutprop:changeAbundance <http://purl.obolibrary.org/obo/NCBITaxon_1407607> ,
                                                                     <http://purl.obolibrary.org/obo/NCBITaxon_191303> ,
                                                                     <http://purl.obolibrary.org/obo/NCBITaxon_207244> ,
                                                                     <https://uts.nlm.nih.gov/uts/umls/concept/C1495786> ;
                                             gutprop:containedIn <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/a815760bb5463a25> ,
                                                                 <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/ddc09adfee164e1e> ,
                                                                 <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/5fce4d9e3743fc48> ;
                                             gutprop:isA <http://purl.obolibrary.org/obo/OMIT_0002893> ;
                                             gutprop:target <https://uts.nlm.nih.gov/uts/umls/concept/C1706180> ,
                                                            <https://www.ncbi.nlm.nih.gov/mesh/D011153> ;
                                             rdfs:comment "An anxiety disorder precipitated by an experience of intense fear or horror while exposed to a traumatic (especially life-threatening) event. The disorder is characterized by dissociative symptoms; vivid recollections of the traumatic event; avoidance of stimuli associated with the traumatic event; and a constant state of hyperarousal for no more than one month. [Definition Source: NCIT]" ,
                                                          "NCIT Match" ;
                                             rdfs:label "Acute Stress Disorder" .


###  http://purl.obolibrary.org/obo/NCIT_C92622
<http://purl.obolibrary.org/obo/NCIT_C92622> rdf:type owl:NamedIndividual ,
                                                      skos:Concept ,
                                                      <https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding> ;
                                             skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/DiseaseDisorderOrFinding> ;
                                             gutprop:containedIn <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/eb80f49219752a6e> ,
                                                                 <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/fbd8630265c4812d> ,
                                                                 <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/14142f937b835cc2> ,
                                                                 <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/29ab268f7aba55d2> ;
                                             gutprop:target <https://uts.nlm.nih.gov/uts/umls/concept/C0043210> ,
                                                            <https://uts.nlm.nih.gov/uts/umls/concept/C0237401> ,
                                                            <https://www.ncbi.nlm.nih.gov/mesh/D008571> ;
                                             rdfs:comment "An anxiety disorder characterized by excessive and difficult-to-control worry about a number of life situations. The worry is accompanied by restlessness, fatigue, inability to concentrate, irritability, muscle tension, and/or sleep disturbance and lasts for at least 6 months. [Definition Source: NCIT]" ,
                                                          "NCIT Match" ;
                                             rdfs:label "Generalized Anxiety Disorder" .


###  http://purl.obolibrary.org/obo/NCIT_C92847
<http://purl.obolibrary.org/obo/NCIT_C92847> rdf:type owl:NamedIndividual ,
