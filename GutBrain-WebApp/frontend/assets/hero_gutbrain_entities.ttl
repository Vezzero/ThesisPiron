                                             gutprop:affect <http://purl.obolibrary.org/obo/OGMS_0000045> ;
                                             gutprop:containedIn <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/75eb93fd0de5cc35> ;
                                             gutprop:target <https://www.ncbi.nlm.nih.gov/mesh/D000328> ;
                                             rdfs:comment "A sleep disorder characterized by difficulty in falling asleep and/or remaining asleep. [Definition Source: NCIT]" ,
                                                          "NCIT Match" ;
                                             rdfs:label "Insomnia" .


###  http://purl.obolibrary.org/obo/NCIT_C283
<http://purl.obolibrary.org/obo/NCIT_C283> rdf:type owl:NamedIndividual ,
                                                    skos:Concept ,
