###  http://purl.obolibrary.org/obo/NCIT_C82342
<http://purl.obolibrary.org/obo/NCIT_C82342> rdf:type owl:NamedIndividual ,
                                                      skos:Concept ,
                                                      <https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding> ;
                                             skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/DiseaseDisorderOrFinding> ;
                                             gutprop:containedIn <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/c89280db2814eddb> ,
                                                                 <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/7e3f8692469cb230> ;
                                             gutprop:isA <http://purl.obolibrary.org/obo/NCIT_C26835> ;
                                             rdfs:comment "A progressive hereditary neurodegenerative disorder inherited in an autosomal dominant fashion. Symptoms may appear at any age and include uncontrolled movements, clumsiness, balance problems, difficulty walking, talking, or swallowing. The disease has a progressive course with a decline in mental abilities, and the development of psychiatric problems. [Definition Source: NCIT]" ,
                                                          "NCIT Match" ;
                                             rdfs:label "Huntington'S Disease" .


###  http://purl.obolibrary.org/obo/NCIT_C83196
<http://purl.obolibrary.org/obo/NCIT_C83196> rdf:type owl:NamedIndividual ,
