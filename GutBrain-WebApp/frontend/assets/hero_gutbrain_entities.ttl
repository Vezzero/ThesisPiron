                                             rdfs:comment "Elevated levels of lipids in the blood. [Definition Source: NCIT]" ,
                                                          "NCIT Match" ;
                                             rdfs:label "Hyperlipidemia" .


###  http://purl.obolibrary.org/obo/NCIT_C34858
<http://purl.obolibrary.org/obo/NCIT_C34858> rdf:type owl:NamedIndividual ,
                                                      skos:Concept ,
                                                      <https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding> ;
                                             skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/DiseaseDisorderOrFinding> ;
