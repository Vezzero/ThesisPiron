                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36191806> ;
                                                                             gutprop:hasSentenceText "Given the role of subdiaphragmatic vagus nerve in gut-microbiota-brain axis, we investigated whether subdiaphragmatic vagotomy (SDV) could affect depression-like behaviors, abnormal composition of gut microbiota, and microbes-derived metabolites in Chrna7 KO mice." ;
                                                                             rdfs:label "sentence_36191806_3" .


