                                             rdfs:comment "NCIT Match" ,
                                                          "The cavity located at the upper end of the alimentary canal, behind the teeth and gums that is bounded on the outside by the lips, above by the hard and soft palates and below by the tongue. [Definition Source: NCIT]" ;
                                             rdfs:label "Oral Cavity" .


###  http://purl.obolibrary.org/obo/NCIT_C12423
<http://purl.obolibrary.org/obo/NCIT_C12423> rdf:type owl:NamedIndividual ,
                                                      skos:Concept ,
                                                      <https://w3id.org/brainteaser/ontology/schema/AnatomicalSite> ;
