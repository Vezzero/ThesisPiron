###  http://purl.obolibrary.org/obo/NCIT_C34510
<http://purl.obolibrary.org/obo/NCIT_C34510> rdf:type owl:NamedIndividual ,
                                                      skos:Concept ,
                                                      <https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding> ;
                                             skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/DiseaseDisorderOrFinding> ;
                                             gutprop:containedIn <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/4650056dd18e34f5> ;
                                             rdfs:comment "An endocrine disorder characterized by excessive production of aldosterone by the adrenal glands. Causes include adrenal gland adenoma and adrenal gland hyperplasia. The overproduction of aldosterone results in sodium and water retention and hypokalemia. Patients present with high blood pressure, muscle weakness, and headache. [Definition Source: NCIT]" ,
                                                          "NCIT Match" ;
                                             rdfs:label "Conn Syndrome" .


###  http://purl.obolibrary.org/obo/NCIT_C34511
<http://purl.obolibrary.org/obo/NCIT_C34511> rdf:type owl:NamedIndividual ,
                                                      skos:Concept ,
                                                      <https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding> ;
