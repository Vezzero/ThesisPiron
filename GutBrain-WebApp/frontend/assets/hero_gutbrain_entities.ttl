                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37368331> ;
                                                                              gutprop:hasSentenceText "In contrast, a significant decrease in 1." ;
                                                                              rdfs:label "sentence_37368331_35" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37368331_36
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37368331_36> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37368331> ;
                                                                              gutprop:hasSentenceText "Phylum: Firmicutes, its Family: <i>Lachnospiraceae</i>, and its Genus: <i>Roseburia</i> and 2." ;
                                                                              rdfs:label "sentence_37368331_36" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37368331_37
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37368331_37> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37368331> ;
                                                                              gutprop:hasSentenceText "Genus: <i>Ruminococcus</i> of the Phylum: Firmicutes, was described." ;
                                                                              rdfs:label "sentence_37368331_37" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37368331_38
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37368331_38> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37368331> ;
                                                                              gutprop:hasSentenceText "(4) Conclusion: A significant gut dysbiosis, involving multiple bacterial taxa, was found in PD patients compared to healthy people in the occidental regions." ;
                                                                              rdfs:label "sentence_37368331_38" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37368331_39
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37368331_39> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37368331> ;
                                                                              gutprop:hasSentenceText "However, more studies are needed to find the precise pathophysiologic involvement of other groups of pathogens, such as fungi and parasites, in the development and progression of PD." ;
                                                                              rdfs:label "sentence_37368331_39" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37368331_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37368331_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37368331> ;
                                                                             gutprop:hasSentenceText "(2) Methods: Preferred Reporting Items for Systematic Review and Meta-Analysis (PRISMA) and Meta-analyses Of Observational Studies in Epidemiology (MOOSE) protocols were used for this systematic review." ;
                                                                             rdfs:label "sentence_37368331_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37368331_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37368331_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37368331> ;
                                                                             gutprop:hasSentenceText "PubMed was used as the database search engine." ;
                                                                             rdfs:label "sentence_37368331_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37368331_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37368331_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37368331> ;
                                                                             gutprop:hasSentenceText "Of the 166 studies found, only 10 were used, as they met our inclusion criteria: case-control studies, studies that assessed the correlation of PD and gut microbiome, studies that took place in occidental regions, and studies that were performed on humans and were written in English." ;
                                                                             rdfs:label "sentence_37368331_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37368331_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37368331_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37368331> ;
                                                                             gutprop:hasSentenceText "The Newcastle-Ottawa Scale was used as the assessment tool for overall risk of bias in this systematic review." ;
                                                                             rdfs:label "sentence_37368331_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37368331_8
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37368331_8> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37368331> ;
                                                                             gutprop:hasSentenceText "(3) Results: The studies analyzed were divided into three geographic areas: Region 1: United States of America and Canada; Region 2: Germany, Ireland, and Finland; and Region 3: Italy; based on geographical similarities among these populations." ;
                                                                             rdfs:label "sentence_37368331_8" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37368331_9
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37368331_9> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37368331> ;
                                                                             gutprop:hasSentenceText "The following statistically significant results were described in PD patients, compared with non-PD controls." ;
                                                                             rdfs:label "sentence_37368331_9" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37371676_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37371676_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/37371676> ;
                                                                             gutprop:hasSentenceText "Using the Microbiome as a Regenerative Medicine Strategy for Autoimmune Diseases." ;
                                                                             rdfs:label "sentence_37371676_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37371676_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37371676_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37371676> ;
                                                                             gutprop:hasSentenceText "Autoimmune (AI) diseases, which present in a multitude of systemic manifestations, have been connected to many underlying factors." ;
                                                                             rdfs:label "sentence_37371676_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37371676_10
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37371676_10> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37371676> ;
                                                                              gutprop:hasSentenceText "By doing this, the review also introduces the concept of altering an individual's specific gut microbiota as a form of regenerative medicine and potential tailored therapy for joint destruction seen in AI." ;
                                                                              rdfs:label "sentence_37371676_10" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37371676_11
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37371676_11> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37371676> ;
                                                                              gutprop:hasSentenceText "We hope to show multiple, specific ways to target the microbiome through diet changes, rebalancing microbial diversity, or decreasing specific microbes associated with increased gut permeability, leading to reduced systemic inflammation contributing to joint pathology." ;
                                                                              rdfs:label "sentence_37371676_11" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37371676_12
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37371676_12> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37371676> ;
                                                                              gutprop:hasSentenceText "Additionally, we plan to show that diet alterations can promote beneficial changes in the gut microbiota, supporting the body's own endogenous processes to decrease inflammation and increase healing." ;
                                                                              rdfs:label "sentence_37371676_12" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37371676_13
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37371676_13> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37371676> ;
                                                                              gutprop:hasSentenceText "This concept of microbial alteration falls under the definition of regenerative medicine and should be included accordingly." ;
                                                                              rdfs:label "sentence_37371676_13" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37371676_14
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37371676_14> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37371676> ;
                                                                              gutprop:hasSentenceText "By implementing microbial alterations in regenerative medicine, this current study could lend increasing support to the current research on the associations of the gut microbiota, bone metabolism, and AI-related musculoskeletal pathology." ;
                                                                              rdfs:label "sentence_37371676_14" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37371676_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37371676_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37371676> ;
                                                                             gutprop:hasSentenceText "These factors include the environment, genetics, individual microbiomes, and diet." ;
                                                                             rdfs:label "sentence_37371676_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37371676_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37371676_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37371676> ;
                                                                             gutprop:hasSentenceText "An individual's gut microbiota is an integral aspect of human functioning, as it is intimately integrated into the metabolic, mechanical, immunological, and neurologic pathways of the body." ;
                                                                             rdfs:label "sentence_37371676_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37371676_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37371676_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37371676> ;
                                                                             gutprop:hasSentenceText "The microbiota dynamically changes throughout our lifetimes and is individually unique." ;
                                                                             rdfs:label "sentence_37371676_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37371676_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37371676_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37371676> ;
                                                                             gutprop:hasSentenceText "While the gut microbiome is ever-adaptive, gut dysbiosis can exert a significant influence on physical and mental health." ;
                                                                             rdfs:label "sentence_37371676_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37371676_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37371676_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37371676> ;
                                                                             gutprop:hasSentenceText "Gut dysbiosis is a common factor in various AI, and diets with elevated fat and sugar content have been linked to gut microbiome alterations, contributing to increased systemic inflammation." ;
                                                                             rdfs:label "sentence_37371676_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37371676_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37371676_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37371676> ;
                                                                             gutprop:hasSentenceText "Additionally, multiple AI's have increased levels of certain inflammatory markers such as TNF-a, IL-6, and IL-17 that have been shown to contribute to arthropathy and are also linked to increased levels of gut dysbiosis." ;
                                                                             rdfs:label "sentence_37371676_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37371676_8
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37371676_8> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37371676> ;
                                                                             gutprop:hasSentenceText "While chronic inflammation has been shown to affect many physiologic systems, this review explores the connection between gut microbiota, bone metabolism, and the skeletal and joint destruction associated with various AI, including psoriatic arthritis, systemic lupus erythematosus, irritable bowel disease, and rheumatoid arthritis." ;
                                                                             rdfs:label "sentence_37371676_8" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37371676_9
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37371676_9> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37371676> ;
                                                                             gutprop:hasSentenceText "This review aims to define the mechanisms of microbiome crosstalk between the cells of bone and cartilage, as well as to investigate the potential bidirectional connections between AI, bony and cartilaginous tissue, and the gut microbiome." ;
                                                                             rdfs:label "sentence_37371676_9" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37377497_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37377497_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/37377497> ;
                                                                             gutprop:hasSentenceText "Insights into the potential benefits of triphala polyphenols toward the promotion of resilience against stress-induced depression and cognitive impairment." ;
                                                                             rdfs:label "sentence_37377497_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37377497_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37377497_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37377497> ;
                                                                             gutprop:hasSentenceText "In response to environmental challenges, stress is a common reaction, but dysregulation of the stress response can lead to neuropsychiatric disorders, including depression and cognitive impairment." ;
                                                                             rdfs:label "sentence_37377497_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37377497_10
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37377497_10> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37377497> ;
                                                                              gutprop:hasSentenceText "Additionally, we summarize recent advances demonstrating that triphala polyphenols are beneficial to cognitive and psychological resilience by regulating 5-hydroxytryptamine (5-HT) and brain-derived neurotrophic factor (BDNF) receptors, gut microbiota, and antioxidant-related signaling pathways." ;
                                                                              rdfs:label "sentence_37377497_10" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37377497_11
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37377497_11> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37377497> ;
                                                                              gutprop:hasSentenceText "Overall, scientific exploration of triphala polyphenols is warranted to understand their therapeutic efficacy." ;
                                                                              rdfs:label "sentence_37377497_11" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37377497_12
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37377497_12> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37377497> ;
                                                                              gutprop:hasSentenceText "In addition to providing novel insights into the mechanisms of triphala polyphenols for promoting stress resilience, blood brain barrier (BBB) permeability and systemic bioavailability of triphala polyphenols also need to be improved by the research community." ;
                                                                              rdfs:label "sentence_37377497_12" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37377497_13
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37377497_13> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37377497> ;
                                                                              gutprop:hasSentenceText "Moreover, well-designed clinical trials are needed to increase the scientific validity of triphala polyphenols' beneficial effects for preventing and treating cognitive impairment and psychological dysfunction." ;
                                                                              rdfs:label "sentence_37377497_13" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37377497_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37377497_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37377497> ;
                                                                             gutprop:hasSentenceText "Particularly, there is ample evidence that overexposure to mental stress can have lasting detrimental consequences for psychological health, cognitive function, and ultimately well-being." ;
                                                                             rdfs:label "sentence_37377497_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37377497_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37377497_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37377497> ;
                                                                             gutprop:hasSentenceText "In fact, some individuals are resilient to the same stressor." ;
                                                                             rdfs:label "sentence_37377497_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37377497_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37377497_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37377497> ;
                                                                             gutprop:hasSentenceText "A major benefit of enhancing stress resilience in at-risk groups is that it may help prevent the onset of stress-induced mental health problems." ;
                                                                             rdfs:label "sentence_37377497_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37377497_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37377497_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37377497> ;
                                                                             gutprop:hasSentenceText "A potential therapeutic strategy for maintaining a healthy life is to address stress-induced health problems with botanicals or dietary supplements such as polyphenols." ;
                                                                             rdfs:label "sentence_37377497_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37377497_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37377497_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37377497> ;
                                                                             gutprop:hasSentenceText "Triphala, also known as Zhe Busong decoction in Tibetan, is a well-recognized <i>Ayurvedic</i> polyherbal medicine comprising dried fruits from three different plant species." ;
                                                                             rdfs:label "sentence_37377497_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37377497_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37377497_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37377497> ;
                                                                             gutprop:hasSentenceText "As a promising food-sourced phytotherapy, triphala polyphenols have been used throughout history to treat a variety of medical conditions, including brain health maintenance." ;
                                                                             rdfs:label "sentence_37377497_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37377497_8
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37377497_8> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37377497> ;
                                                                             gutprop:hasSentenceText "Nevertheless, a comprehensive review is still lacking." ;
                                                                             rdfs:label "sentence_37377497_8" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37377497_9
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37377497_9> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37377497> ;
                                                                             gutprop:hasSentenceText "Here, the primary objective of this review article is to provide an overview of the classification, safety, and pharmacokinetics of triphala polyphenols, as well as recommendations for the development of triphala polyphenols as a novel therapeutic strategy for promoting resilience in susceptible individuals." ;
                                                                             rdfs:label "sentence_37377497_9" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37396336_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37396336_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/37396336> ;
                                                                             gutprop:hasSentenceText "Sex-specific effects of voluntary wheel running on behavior and the gut microbiota-immune-brain axis in mice." ;
                                                                             rdfs:label "sentence_37396336_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37396336_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37396336_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37396336> ;
                                                                             gutprop:hasSentenceText "Physical exercise has been positioned as a promising strategy to prevent and/or alleviate anxiety and depression, but the biological processes associated with its effects on mental health have yet to be entirely determined." ;
                                                                             rdfs:label "sentence_37396336_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37396336_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37396336_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37396336> ;
                                                                             gutprop:hasSentenceText "Although the prevalence of depression and anxiety in women is about twice that of men, very few studies have examined whether physical exercise could affect mental health differently according to sex." ;
                                                                             rdfs:label "sentence_37396336_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37396336_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37396336_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37396336> ;
                                                                             gutprop:hasSentenceText "This study examined, in singly-housed mice, the sex-specific effects of voluntary exercise on depressive- and anxiety-like behaviors as well as on different markers along the gut microbiota-immune-brain axis." ;
                                                                             rdfs:label "sentence_37396336_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37396336_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37396336_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37396336> ;
                                                                             gutprop:hasSentenceText "Male and female C57BL/6N mice had voluntary access to running wheels in their home-cages for 24 days or were left undisturbed in identical home-cages without running wheels." ;
                                                                             rdfs:label "sentence_37396336_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37396336_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37396336_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37396336> ;
                                                                             gutprop:hasSentenceText "Behaviors were then examined in the open field, splash, elevated plus maze, and tail suspension tests." ;
                                                                             rdfs:label "sentence_37396336_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37396336_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37396336_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37396336> ;
                                                                             gutprop:hasSentenceText "Gene expression of pro-inflammatory cytokines, microglia activation-related genes, and tight junction proteins was determined in the jejunum and the hippocampus, while microbiota composition and predicted function were verified in cecum contents." ;
                                                                             rdfs:label "sentence_37396336_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37396336_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37396336_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37396336> ;
                                                                             gutprop:hasSentenceText "Voluntary exercise reduced anxiety-like behaviors and altered grooming patterns in males exclusively." ;
                                                                             rdfs:label "sentence_37396336_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37396336_8
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37396336_8> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37396336> ;
                                                                             gutprop:hasSentenceText "Although the exercise intervention resulted in changes to brain inflammatory activity and to cecal microbiota composition and inferred function in both sexes, reductions in the jejunal expression of pro-inflammatory markers were observed in females only." ;
                                                                             rdfs:label "sentence_37396336_8" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37396336_9
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37396336_9> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37396336> ;
                                                                             gutprop:hasSentenceText "These findings support the view that voluntary exercise, even when performed during a short period, is beneficial for mental and intestinal health and that its sex-specific effects on behavior could be, at least in part, related to some components of the gut microbiota-immune-brain axis." ;
                                                                             rdfs:label "sentence_37396336_9" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37400971_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37400971_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/37400971> ;
                                                                             gutprop:hasSentenceText "Maternal microbiome disturbance induces deficits in the offspring's behaviors: a systematic review and meta-analysis." ;
                                                                             rdfs:label "sentence_37400971_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37400971_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37400971_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37400971> ;
                                                                             gutprop:hasSentenceText "Recent evidence has suggested that changes in maternal gut microbiota in early life may generate neurobiological consequences associated with psychiatric-related abnormalities." ;
                                                                             rdfs:label "sentence_37400971_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37400971_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37400971_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37400971> ;
                                                                             gutprop:hasSentenceText "However, the number of studies on humans investigating this problem is limited, and preclinical findings sometimes conflict." ;
                                                                             rdfs:label "sentence_37400971_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37400971_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37400971_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37400971> ;
                                                                             gutprop:hasSentenceText "Therefore, we run a meta-analysis to examine whether maternal microbiota disturbance (MMD) during neurodevelopment might affect the offspring during adulthood." ;
                                                                             rdfs:label "sentence_37400971_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37400971_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37400971_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37400971> ;
                                                                             gutprop:hasSentenceText "We found thirteen studies, from a set of 459 records selected by strategy registered on PROSPERO (#289224), to target preclinical studies that evaluated the behavioral outcomes of the rodents generated by dams submitted to perinatal enteric microbiota perturbation." ;
                                                                             rdfs:label "sentence_37400971_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37400971_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37400971_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37400971> ;
                                                                             gutprop:hasSentenceText "The analysis revealed a significant effect size (SMD = -0.51, 95% CI = -0.79 to -0.22, <i>p</i> < .001, T2 = 0.54, I2 = 79.85%), indicating that MMD might provoke behavioral impairments in the adult offspring." ;
                                                                             rdfs:label "sentence_37400971_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37400971_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37400971_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37400971> ;
                                                                             gutprop:hasSentenceText "The MMD also induces a significant effect size for the reduction of the sociability behavior (SMD = -0.63, 95% CI = -1.18 to -0.07, <i>p</i> = 0.011, T2 = 0.30, I2 = 76.11%) and obsessive-compulsive-like behavior (SMD = -0.68, 95% CI = -0.01 to -1.36, <i>p</i> = 0.009, T2 = 0.25, I2 = 62.82%) parameters." ;
                                                                             rdfs:label "sentence_37400971_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37400971_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37400971_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37400971> ;
                                                                             gutprop:hasSentenceText "The effect size was not significant or inconclusive for memory and anxiety-like behavior, or inconclusive for schizophrenia-like and depressive-like behavior." ;
                                                                             rdfs:label "sentence_37400971_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37400971_8
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37400971_8> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37400971> ;
                                                                             gutprop:hasSentenceText "Therefore, experimental perinatal MMD is vertically transmitted to the offspring, negatively impacting behavioral parameters related to psychiatric disorders." ;
                                                                             rdfs:label "sentence_37400971_8" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37403161_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37403161_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/37403161> ;
                                                                             gutprop:hasSentenceText "Overexpression of human alpha-Synuclein leads to dysregulated microbiome/metabolites with ageing in a rat model of Parkinson disease." ;
                                                                             rdfs:label "sentence_37403161_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37403161_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37403161_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37403161> ;
                                                                             gutprop:hasSentenceText "Braak's hypothesis states that sporadic Parkinson's disease (PD) follows a specific progression of pathology from the peripheral to the central nervous system, and this progression can be monitored by detecting the accumulation of alpha-Synuclein (α-Syn) protein." ;
                                                                             rdfs:label "sentence_37403161_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37403161_10
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37403161_10> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37403161> ;
                                                                              gutprop:hasSentenceText "Interestingly, this ratio then increased with ageing." ;
                                                                              rdfs:label "sentence_37403161_10" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37403161_11
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37403161_11> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37403161> ;
                                                                              gutprop:hasSentenceText "The dynamics of Lactobacillus and Alistipes were monitored and reduced Lactobacillus and increased Alistipes abundance was discerned in ageing TG rats." ;
                                                                              rdfs:label "sentence_37403161_11" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37403161_12
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37403161_12> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37403161> ;
                                                                              gutprop:hasSentenceText "Additionally, the SNCA gene overexpression resulted in gut α-Syn protein expression and increased with advanced age." ;
                                                                              rdfs:label "sentence_37403161_12" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37403161_13
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37403161_13> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37403161> ;
                                                                              gutprop:hasSentenceText "Further, older TG animals had increased intestinal inflammation, decreased Na<sup>+</sup> current and a robust alteration in metabolite production characterized by the increase of succinate levels in feces and serum." ;
                                                                              rdfs:label "sentence_37403161_13" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37403161_14
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37403161_14> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37403161> ;
                                                                              gutprop:hasSentenceText "Manipulation of the gut bacteria by short-term antibiotic cocktail treatment revealed a complete loss of short-chain fatty acids and a reduction in succinate levels." ;
                                                                              rdfs:label "sentence_37403161_14" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37403161_15
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37403161_15> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37403161> ;
                                                                              gutprop:hasSentenceText "Although antibiotic cocktail treatment did not change α-Syn expression in the enteric nervous system of the colon, however, reduced α-Syn expression was detected in the olfactory bulbs (forebrain) of the TG rats." ;
                                                                              rdfs:label "sentence_37403161_15" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37403161_16
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37403161_16> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37403161> ;
                                                                              gutprop:hasSentenceText "Our data emphasize that the gut microbiome dysbiosis synchronous with ageing leads to a specific alteration of gut metabolites and can be modulated by antibiotics which may affect PD pathology." ;
                                                                              rdfs:label "sentence_37403161_16" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37403161_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37403161_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37403161> ;
                                                                             gutprop:hasSentenceText "Consequently, there is growing interest in understanding how the gut (commensal) microbiome can regulate α-Syn accumulation, as this could potentially lead to PD." ;
                                                                             rdfs:label "sentence_37403161_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37403161_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37403161_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37403161> ;
                                                                             gutprop:hasSentenceText "We used 16S rRNA and shotgun sequencing to characterise microbial diversity." ;
                                                                             rdfs:label "sentence_37403161_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37403161_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37403161_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37403161> ;
                                                                             gutprop:hasSentenceText "<sup>1</sup>H-NMR was employed to understand the metabolite production and intestinal inflammation estimated using ELISA and RNA-sequencing from feces and the intestinal epithelial layer respectively." ;
                                                                             rdfs:label "sentence_37403161_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37403161_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37403161_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37403161> ;
                                                                             gutprop:hasSentenceText "The Na<sup>+</sup> channel current and gut permeability were measured using an Ussing chamber." ;
                                                                             rdfs:label "sentence_37403161_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37403161_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37403161_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37403161> ;
                                                                             gutprop:hasSentenceText "Immunohistochemistry and immunofluorescence imaging were applied to detect the α-Syn protein." ;
                                                                             rdfs:label "sentence_37403161_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37403161_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37403161_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37403161> ;
                                                                             gutprop:hasSentenceText "LC-MS/MS was used for characterization of proteins from metabolite treated neuronal cells." ;
                                                                             rdfs:label "sentence_37403161_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37403161_8
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37403161_8> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37403161> ;
                                                                             gutprop:hasSentenceText "Finally, Metascape and Ingenuity Pathway Analysis (IPA) bioinformatics tools were used for identification of dysregulated pathways." ;
                                                                             rdfs:label "sentence_37403161_8" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37403161_9
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37403161_9> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37403161> ;
                                                                             gutprop:hasSentenceText "We studied a transgenic (TG) rat model overexpressing the human SNCA gene and found that a progressive gut microbial composition alteration characterized by the reduction of Firmicutes to Bacteroidetes ratio could be detected in the young TG rats." ;
                                                                             rdfs:label "sentence_37403161_9" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37449597_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37449597_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/37449597> ;
                                                                             gutprop:hasSentenceText "Gut-microbiome-brain axis: the crosstalk between the vagus nerve, alpha-synuclein and the brain in Parkinson's disease." ;
                                                                             rdfs:label "sentence_37449597_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37449597_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37449597_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37449597> ;
                                                                             gutprop:hasSentenceText "This critical review of the literature shows that there is a close link between the microbiome, the gut, and the brain in Parkinson's disease." ;
                                                                             rdfs:label "sentence_37449597_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37449597_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37449597_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37449597> ;
                                                                             gutprop:hasSentenceText "The vagus nerve, the main component of the parasympathetic nervous system, is involved in the regulation of immune response, digestion, heart rate, and control of mood." ;
                                                                             rdfs:label "sentence_37449597_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37449597_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37449597_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37449597> ;
                                                                             gutprop:hasSentenceText "It can detect microbiota metabolites through its afferents, transferring this gut information to the central nervous system." ;
                                                                             rdfs:label "sentence_37449597_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37449597_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37449597_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37449597> ;
                                                                             gutprop:hasSentenceText "Preclinical and clinical studies have shown the important role played by the gut microbiome and gut-related factors in disease development and progression, as well as treatment responses." ;
                                                                             rdfs:label "sentence_37449597_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37449597_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37449597_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37449597> ;
                                                                             gutprop:hasSentenceText "These findings suggest that the gut microbiome may be a valuable target for new therapeutic strategies for Parkinson's disease." ;
                                                                             rdfs:label "sentence_37449597_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37449597_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37449597_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37449597> ;
                                                                             gutprop:hasSentenceText "More studies are needed to better understand the underlying biology and how this axis can be modulated for the patient's benefit." ;
                                                                             rdfs:label "sentence_37449597_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37464164_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37464164_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/37464164> ;
                                                                             gutprop:hasSentenceText "Gastrointestinal and Microbiome Profiling in Rodent Models of Neurological and Psychiatric Disorders." ;
                                                                             rdfs:label "sentence_37464164_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37464164_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37464164_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37464164> ;
                                                                             gutprop:hasSentenceText "Mice and other rodent models have been widely used to understand the role of the gut microbiome in various neurological and psychiatric disorders." ;
                                                                             rdfs:label "sentence_37464164_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37464164_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37464164_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37464164> ;
                                                                             gutprop:hasSentenceText "Here we describe a protocol to characterize the structural and functional phenotype of the rodent gut and to examine the gut microbiota composition through V4 16S rRNA gene sequencing and microbiome profiling." ;
                                                                             rdfs:label "sentence_37464164_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37464164_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37464164_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37464164> ;
                                                                             gutprop:hasSentenceText "This protocol will have utility for those investigating the gut, and associated microbiota, in a wide range of different rodent models of human disorders." ;
                                                                             rdfs:label "sentence_37464164_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37468912_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37468912_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/37468912> ;
                                                                             gutprop:hasSentenceText "Altered gut microbiota-host bile acid metabolism in IBS-D patients with liver depression and spleen deficiency pattern." ;
                                                                             rdfs:label "sentence_37468912_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37468912_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37468912_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37468912> ;
                                                                             gutprop:hasSentenceText "Dysregulation of gut microbiota-host bile acid (BA) co-metabolism is a critical pathogenic factor of diarrhea-predominant irritable bowel syndrome (IBS-D)." ;
                                                                             rdfs:label "sentence_37468912_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37468912_10
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37468912_10> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37468912> ;
                                                                              gutprop:hasSentenceText "The score of bowel symptoms (stool frequency and abdominal pain) showing greater severity in the LDSD pattern were positively correlated with bai-expressing bacterial abundances and fecal DCA levels separately." ;
                                                                              rdfs:label "sentence_37468912_10" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37468912_11
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37468912_11> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37468912> ;
                                                                              gutprop:hasSentenceText "We clarified a differed BA metabolic phenotype in IBS patients with LDSD, which closely correlates with the severity of bowel symptoms." ;
                                                                              rdfs:label "sentence_37468912_11" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37468912_12
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37468912_12> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37468912> ;
                                                                              gutprop:hasSentenceText "It demonstrates that gut microbiota and host co-metabolism of BAs would provide crucial insight into the biology of the LDSD pattern and its internal relationship with IBS progression." ;
                                                                              rdfs:label "sentence_37468912_12" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37468912_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37468912_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37468912> ;
                                                                             gutprop:hasSentenceText "Traditional Chinese Medicine (TCM), instructed by pattern differentiation, is effective in treating IBS-D, in which liver depression and spleen deficiency (LDSD) is the most prevalent pattern." ;
                                                                             rdfs:label "sentence_37468912_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37468912_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37468912_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37468912> ;
                                                                             gutprop:hasSentenceText "Still, it is unclear the linkage between the LDSD pattern and the BA metabolic phenotype." ;
                                                                             rdfs:label "sentence_37468912_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37468912_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37468912_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37468912> ;
                                                                             gutprop:hasSentenceText "This study aimed to uncover the biological basis of the LDSD pattern from the BA metabolic perspective." ;
                                                                             rdfs:label "sentence_37468912_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37468912_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37468912_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37468912> ;
                                                                             gutprop:hasSentenceText "Patients with IBS-D completed questionnaires regarding the irritable bowel severity scoring system (IBS-SSS), stool frequency, Stool Bristol scale, and Self-Rating Scales of mental health." ;
                                                                             rdfs:label "sentence_37468912_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37468912_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37468912_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37468912> ;
                                                                             gutprop:hasSentenceText "Fasting blood and morning feces were collected to analyze the gut metagenome and BA-related indices/metabolites." ;
                                                                             rdfs:label "sentence_37468912_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37468912_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37468912_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37468912> ;
                                                                             gutprop:hasSentenceText "IBS-D patients with LDSD had a higher incidence of BA overexcretion (41% vs. 23% non-LDSD) with significant elevations in fecal total BAs and serum BA precursor 7α-hydroxy-4-cholesten-3-one levels." ;
                                                                             rdfs:label "sentence_37468912_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37468912_8
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37468912_8> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37468912> ;
                                                                             gutprop:hasSentenceText "Compared to controls or non-LDSD patients, LDSD patients had a featured fecal BA profile, with higher proportions of deoxycholic acid (DCA), 7-ketodeoxycholic acid, and lithocholic acid." ;
                                                                             rdfs:label "sentence_37468912_8" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37468912_9
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37468912_9> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37468912> ;
                                                                             gutprop:hasSentenceText "It is consistent with the BA-metabolizing genomic changes in the LDSD gut microbiota characterized by overabundances of 7-dehydroxylating bacteria and BA-inducible genes (baiCD/E/H)." ;
                                                                             rdfs:label "sentence_37468912_9" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37469436_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37469436_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/37469436> ;
                                                                             gutprop:hasSentenceText "Exopolysaccharide is the potential effector of <i>Lactobacillus fermentum</i> PS150, a hypnotic psychobiotic strain." ;
                                                                             rdfs:label "sentence_37469436_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37469436_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37469436_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37469436> ;
                                                                             gutprop:hasSentenceText "Psychobiotics are a class of probiotics that confer beneficial effects on the mental health of the host." ;
                                                                             rdfs:label "sentence_37469436_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37469436_10
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37469436_10> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37469436> ;
                                                                              gutprop:hasSentenceText "Through the pentobarbital-induced sleep test, we confirmed the hypnotic effects of the C-EPS isolated from PS150, as evidenced by a significant reduction in sleep latency and recovery time following oral administration in mice." ;
                                                                              rdfs:label "sentence_37469436_10" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37469436_11
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37469436_11> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37469436> ;
                                                                              gutprop:hasSentenceText "In summary, we utilized a comparative approach to delineate differences between PS150 and GR1009 and proposed that EPS may serve as a key factor that mediates the observed hypnotic effect." ;
                                                                              rdfs:label "sentence_37469436_11" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37469436_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37469436_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37469436> ;
                                                                             gutprop:hasSentenceText "We have previously reported hypnotic effects of a psychobiotic strain, <i>Lactobacillus fermentum</i> PS150 (PS150), which significantly shortens sleep latency in experimental mice, and effectively ameliorate sleep disturbances caused by either caffeine consumption or a novel environment." ;
                                                                             rdfs:label "sentence_37469436_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37469436_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37469436_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37469436> ;
                                                                             gutprop:hasSentenceText "In the present study, we discovered a <i>L. fermentum</i> strain" ;
                                                                             rdfs:label "sentence_37469436_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37469436_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37469436_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37469436> ;
                                                                             gutprop:hasSentenceText "GR1009, isolated from the same source of PS150, and found that GR1009 is phenotypically distinct but genetically similar to PS150." ;
                                                                             rdfs:label "sentence_37469436_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37469436_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37469436_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37469436> ;
                                                                             gutprop:hasSentenceText "Compared with PS150, GR1009 have no significant hypnotic effects in the pentobarbital-induced sleep test in mice." ;
                                                                             rdfs:label "sentence_37469436_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37469436_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37469436_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37469436> ;
                                                                             gutprop:hasSentenceText "In addition, we found that heat-killed PS150 exhibited hypnotic effects and altered the gut microbiota in a manner similar to live bacteria, suggesting that a heat-stable effector, such as exopolysaccharide (EPS), could be responsible for these effects." ;
                                                                             rdfs:label "sentence_37469436_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37469436_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37469436_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37469436> ;
                                                                             gutprop:hasSentenceText "Our comparative genomics analysis also revealed distinct genetic characteristics in EPS biosynthesis between GR1009 and PS150." ;
                                                                             rdfs:label "sentence_37469436_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37469436_8
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37469436_8> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37469436> ;
                                                                             gutprop:hasSentenceText "Furthermore, scanning electron microscopy imaging showed a sheet-like EPS structure in PS150, while GR1009 displayed no apparent EPS structure." ;
                                                                             rdfs:label "sentence_37469436_8" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37469436_9
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37469436_9> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37469436> ;
                                                                             gutprop:hasSentenceText "Using the phenol-sulfate assay, we found that the sugar content value of the crude extract containing EPS (C-EPS) from PS150 was approximately five times higher than that of GR1009, indicating that GR1009 has a lower EPS production activity than PS150." ;
                                                                             rdfs:label "sentence_37469436_9" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37481569_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37481569_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/37481569> ;
                                                                             gutprop:hasSentenceText "Study of the gut microbiome in Egyptian patients with Parkinson's Disease." ;
                                                                             rdfs:label "sentence_37481569_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37481569_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37481569_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37481569> ;
                                                                             gutprop:hasSentenceText "Recently, an important relationship between Parkinson's disease and the gut microbiota, through the brain-gut axis interactions, has been established." ;
                                                                             rdfs:label "sentence_37481569_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37481569_10
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37481569_10> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37481569> ;
                                                                              gutprop:hasSentenceText "Comparing the PD clinical phenotypes with the control group, the Mixed phenotype had significantly higher Bacteroides, Tremors predominant had lower Firmicutes and Firmicutes / Bacteroidetes ratio, and both tremors and postural instability and gait disability (PIGD) phenotypes had lower Bifidobacteria." ;
                                                                              rdfs:label "sentence_37481569_10" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37481569_11
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37481569_11> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37481569> ;
                                                                              gutprop:hasSentenceText "However, there was no statistically significant difference between these phenotypes." ;
                                                                              rdfs:label "sentence_37481569_11" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37481569_12
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37481569_12> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37481569> ;
                                                                              gutprop:hasSentenceText "Furthermore, when comparing tremors and non-tremors predominant phenotypes; Lactobacilli showed a significant decrease in non-tremors predominant phenotypes." ;
                                                                              rdfs:label "sentence_37481569_12" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37481569_13
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37481569_13> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37481569> ;
                                                                              gutprop:hasSentenceText "The current study showed evidence of changes in the gut microbiome of Parkinson's disease patients compared to the healthy controls." ;
                                                                              rdfs:label "sentence_37481569_13" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37481569_14
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37481569_14> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37481569> ;
                                                                              gutprop:hasSentenceText "These observations may highlight the importance of the identification of microbiome and specific bacterial changes that can be targeted for the treatment of Parkinson's disease." ;
                                                                              rdfs:label "sentence_37481569_14" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37481569_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37481569_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37481569> ;
                                                                             gutprop:hasSentenceText "Previous studies have declared that alterations in the gut microbiota have a great impact on the pathogenesis and clinical picture of Parkinson's disease (PD)." ;
                                                                             rdfs:label "sentence_37481569_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37481569_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37481569_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37481569> ;
                                                                             gutprop:hasSentenceText "The present study aimed to identify the gut microbiome that is likely related to Parkinson's disease as well as their possible relation to clinical phenotypes." ;
                                                                             rdfs:label "sentence_37481569_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37481569_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37481569_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37481569> ;
                                                                             gutprop:hasSentenceText "Thirty patients with Parkinson's disease, who presented to the Parkinson's disease Neurology Clinic of Alexandria University Hospital were enrolled in our study." ;
                                                                             rdfs:label "sentence_37481569_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37481569_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37481569_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37481569> ;
                                                                             gutprop:hasSentenceText "A cross-matching control group of 35 healthy subjects of similar age and sex were included." ;
                                                                             rdfs:label "sentence_37481569_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37481569_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37481569_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37481569> ;
                                                                             gutprop:hasSentenceText "Stool specimens were taken from each." ;
                                                                             rdfs:label "sentence_37481569_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37481569_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37481569_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37481569> ;
                                                                             gutprop:hasSentenceText "Quantitative SYBR Green Real-Time PCR was done for the identification and quantitation of selected bacterial phyla, genera and/or species." ;
                                                                             rdfs:label "sentence_37481569_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37481569_8
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37481569_8> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37481569> ;
                                                                             gutprop:hasSentenceText "There was a significant increase in Bacteroides and a significant decrease of Firmicutes and Firmicutes / Bacteroidetes ratio and Bifidobacteria in PD patients." ;
                                                                             rdfs:label "sentence_37481569_8" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37481569_9
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37481569_9> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37481569> ;
                                                                             gutprop:hasSentenceText "Although Prevotella was decreased among PD patients relative to the healthy control, the difference was not statistically significant." ;
                                                                             rdfs:label "sentence_37481569_9" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37485386_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37485386_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/37485386> ;
                                                                             gutprop:hasSentenceText "Prebiotics for depression: how does the gut microbiota play a role?" ;
                                                                             rdfs:label "sentence_37485386_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37485386_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37485386_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37485386> ;
                                                                             gutprop:hasSentenceText "Depression, a mood disorder characterized by persistent feelings of sadness and aversion to activity that can interfere with daily life, is a condition of great concern." ;
                                                                             rdfs:label "sentence_37485386_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37485386_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37485386_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37485386> ;
                                                                             gutprop:hasSentenceText "Prebiotics, which are non-digestible substances selectively utilized by host microorganisms for health benefits, have gained attention for their potential to improve overall wellness and alleviate various disorders including depression." ;
                                                                             rdfs:label "sentence_37485386_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37485386_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37485386_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37485386> ;
                                                                             gutprop:hasSentenceText "This study aims to review clinical trials utilizing carbohydrate-type prebiotics such as inulin-type fructans, galactooligosaccharides (GOS), human milk oligosaccharides, resistant starch, prebiotic phytochemicals including epigallocatechin gallate (EGCG), chlorogenic acids, resveratrol, and prebiotic lipids (n-3 polysaturated fatty acids) to determine their effects on depression." ;
                                                                             rdfs:label "sentence_37485386_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37485386_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37485386_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37485386> ;
                                                                             gutprop:hasSentenceText "Our findings suggest that GOS at a daily dosage of 5 g and eicosapentaenoic acid at or less than 1 g can effectively mitigate depressive symptoms." ;
                                                                             rdfs:label "sentence_37485386_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37485386_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37485386_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37485386> ;
                                                                             gutprop:hasSentenceText "While EGCG exhibits potential antidepressant properties, a higher dosage of 3 g/d may be necessary to elicit significant effects." ;
                                                                             rdfs:label "sentence_37485386_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37485386_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37485386_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37485386> ;
                                                                             gutprop:hasSentenceText "The plausible mechanisms underlying the impact of prebiotics on depression include the synthesis of neurotransmitters, production of short-chain fatty acids, and regulation of inflammation." ;
                                                                             rdfs:label "sentence_37485386_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37485660_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37485660_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/37485660> ;
                                                                             gutprop:hasSentenceText "Flavonoids from Seabuckthorn (<i>Hippophae rhamnoides</i> L.) restore CUMS-induced depressive disorder and regulate the gut microbiota in mice." ;
                                                                             rdfs:label "sentence_37485660_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37485660_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37485660_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37485660> ;
                                                                             gutprop:hasSentenceText "Seabuckthorn (<i>Hippophae rhamnoides</i> L.), which is enriched with flavonoids, including isorhamnetin, quercetin and kaempferol, is a representative example of \"medicine food homology\" targeting several diseases." ;
                                                                             rdfs:label "sentence_37485660_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37485660_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37485660_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37485660> ;
                                                                             gutprop:hasSentenceText "Major depressive disorders seriously threaten mental health worldwide and may even lead to death." ;
                                                                             rdfs:label "sentence_37485660_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37485660_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37485660_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37485660> ;
                                                                             gutprop:hasSentenceText "Chronic unpredictable mild stress (CUMS)-induced depressive-like symptoms in mice are usually considered as the highest similarity to the situation in humans." ;
                                                                             rdfs:label "sentence_37485660_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37485660_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37485660_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37485660> ;
                                                                             gutprop:hasSentenceText "Herein, we determined the potential functions of the flavonoid-enriched fraction from Seabuckthorn, which was named SBF, in treating major depressive disorder in mice." ;
                                                                             rdfs:label "sentence_37485660_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37485660_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37485660_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37485660> ;
                                                                             gutprop:hasSentenceText "In the CUMS-induced mouse model, the intake of SBF reversed their depressive behaviors and relieved the CUMS-disturbed levels of neurotrophins, neurotransmitters, stress-related hormones, and inflammation-related cytokines." ;
                                                                             rdfs:label "sentence_37485660_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37485660_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37485660_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37485660> ;
                                                                             gutprop:hasSentenceText "Additionally, the treatment of depressive mice with SBF showed ability to regulate the gut microbiota, especially in decreasing the abundance of <i>Lactobacillaceae</i>, while increasing the abundance of <i>Lachnospiraceae</i> at the family level." ;
                                                                             rdfs:label "sentence_37485660_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37485660_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37485660_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37485660> ;
                                                                             gutprop:hasSentenceText "The results suggest the beneficial effects of Seabuckthorn flavonoids in functioning as a health food supplement to treat major depressive disorders." ;
                                                                             rdfs:label "sentence_37485660_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37502424_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37502424_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/37502424> ;
                                                                             gutprop:hasSentenceText "Effects of human probiotics on memory and psychological and physical measures in community-dwelling older adults with normal and mildly impaired cognition: results of a bi-center, double-blind, randomized, and placebo-controlled clinical trial (CleverAge biota)." ;
                                                                             rdfs:label "sentence_37502424_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37502424_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37502424_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37502424> ;
                                                                             gutprop:hasSentenceText "This study presents results of our randomized clinical trial studying the effect of human probiotics on memory and psychological and physical measures following our study protocol registered at clinicaltrials.gov NCT05051501 and described in detail in our previous paper." ;
                                                                             rdfs:label "sentence_37502424_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37502424_10
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37502424_10> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37502424> ;
                                                                              gutprop:hasSentenceText "At follow-up visits after 3, 6, and 8  months, no cross-sectional differences in any of the measures were found between the groups except worse sentence recall of the ALBA test after 3  months of probiotic use." ;
                                                                              rdfs:label "sentence_37502424_10" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37502424_11
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37502424_11> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37502424> ;
                                                                              gutprop:hasSentenceText "Score changes were not observed for all cognitive tests but one in any group between visits 1 and 3 and between visits 3 and 6." ;
                                                                              rdfs:label "sentence_37502424_11" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37502424_12
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37502424_12> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37502424> ;
                                                                              gutprop:hasSentenceText "The only change was observed for the TMT B test after the first three months but no change was observed after the second three months." ;
                                                                              rdfs:label "sentence_37502424_12" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37502424_13
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37502424_13> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37502424> ;
                                                                              gutprop:hasSentenceText "The treatment with human probiotics and prebiotics did not improve cognitive, affective, or physical measures in community-dwelling individuals with normal or mildly impaired cognitive functions." ;
                                                                              rdfs:label "sentence_37502424_13" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37502424_14
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37502424_14> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37502424> ;
                                                                              gutprop:hasSentenceText "clinicaltrials.gov, identifier NCT05051501." ;
                                                                              rdfs:label "sentence_37502424_14" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37502424_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37502424_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37502424> ;
                                                                             gutprop:hasSentenceText "Community dwelling participants aged between 55 and 80  years were randomly assigned to receive a single dose of 10<sup>6</sup> colony-forming units of human <i>Streptococcus thermophilus</i> GH, <i>Streptococcus salivarius</i> GH NEXARS, Lactobacilus plantarum GH, and <i>Pediococcus pentosaceus</i> GH or placebo." ;
                                                                             rdfs:label "sentence_37502424_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37502424_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37502424_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37502424> ;
                                                                             gutprop:hasSentenceText "A cross-over design allowed each group to receive probiotics and placebo for 3  months each in reverse order." ;
                                                                             rdfs:label "sentence_37502424_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37502424_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37502424_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37502424> ;
                                                                             gutprop:hasSentenceText "A small subset of participants was examined online due to the COVID-19 pandemic." ;
                                                                             rdfs:label "sentence_37502424_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37502424_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37502424_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37502424> ;
                                                                             gutprop:hasSentenceText "After 6  months a small number of volunteers were additionally assessed after 2  months without any intervention." ;
                                                                             rdfs:label "sentence_37502424_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37502424_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37502424_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37502424> ;
                                                                             gutprop:hasSentenceText "Primary outcome measures included changes in cognitive functions assessed using brief tests and a neuropsychological battery and changes in mood assessed using validated questionnaires." ;
                                                                             rdfs:label "sentence_37502424_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37502424_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37502424_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37502424> ;
                                                                             gutprop:hasSentenceText "Secondary outcome measures included changes in self-report and subjective measures using depression and anxiety questionnaires, seven visual analog scales of subjective feelings (memory, digestion, etc." ;
                                                                             rdfs:label "sentence_37502424_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37502424_8
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37502424_8> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37502424> ;
                                                                             gutprop:hasSentenceText "), and physical performance." ;
                                                                             rdfs:label "sentence_37502424_8" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37502424_9
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37502424_9> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37502424> ;
                                                                             gutprop:hasSentenceText "At baseline, the probiotic-placebo group A (<i>n</i> = 40, age 69 ± 7 years, education 16 ± 3 years, 63% females, body mass index 28.5 ± 6, subjective memory complaint in 43%) did not differ from the placebo-probiotic group B (<i>n</i> = 32) in any of the sociodemographic characteristics and evaluated measures including cognitive status." ;
                                                                             rdfs:label "sentence_37502424_9" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37511699_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37511699_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/37511699> ;
                                                                             gutprop:hasSentenceText "Pharmacomicrobiomics of Antidepressants in Depression: A Systematic Review." ;
                                                                             rdfs:label "sentence_37511699_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37511699_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37511699_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37511699> ;
                                                                             gutprop:hasSentenceText "This systematic review evaluated the animal and human evidence for pharmacomicrobiomics (PMx) interactions of antidepressant medications." ;
                                                                             rdfs:label "sentence_37511699_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37511699_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37511699_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37511699> ;
                                                                             gutprop:hasSentenceText "Studies of gut microbiota effects on functional and behavioral effects of antidepressants in human and animal models were identified from PubMed up to December 2022." ;
                                                                             rdfs:label "sentence_37511699_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37511699_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37511699_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37511699> ;
                                                                             gutprop:hasSentenceText "Risk of bias was assessed, and results are presented as a systematic review following PRISMA guidelines." ;
                                                                             rdfs:label "sentence_37511699_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37511699_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37511699_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37511699> ;
                                                                             gutprop:hasSentenceText "A total of 28 (21 animal, 7 human) studies were included in the review." ;
                                                                             rdfs:label "sentence_37511699_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37511699_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37511699_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37511699> ;
                                                                             gutprop:hasSentenceText "The reviewed papers converged on three themes: (1) Antidepressants can alter the composition and metabolites of gut microbiota, (2) gut microbiota can alter the bioavailability of certain antidepressants, and (3) gut microbiota may modulate the clinical or modeled mood modifying effects of antidepressants." ;
                                                                             rdfs:label "sentence_37511699_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37511699_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37511699_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37511699> ;
                                                                             gutprop:hasSentenceText "The majority (n = 22) of studies had at least moderate levels of bias present." ;
                                                                             rdfs:label "sentence_37511699_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37511699_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37511699_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37511699> ;
                                                                             gutprop:hasSentenceText "While strong evidence is still lacking to understand the clinical role of antidepressant PMx in human health, there is evidence for interactions among antidepressants, microbiota changes, microbiota metabolite changes, and behavior." ;
                                                                             rdfs:label "sentence_37511699_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37511699_8
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37511699_8> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37511699> ;
                                                                             gutprop:hasSentenceText "Well-controlled studies of the mediating and moderating effects of baseline and treatment-emergent changes in microbiota on therapeutic and adverse responses to antidepressants are needed to better establish a potential role of PMx in personalizing antidepressant treatment selection and response prediction." ;
                                                                             rdfs:label "sentence_37511699_8" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37571393_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37571393_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/37571393> ;
                                                                             gutprop:hasSentenceText "Underlying Mechanisms of Brain Aging and Neurodegenerative Diseases as Potential Targets for Preventive or Therapeutic Strategies Using Phytochemicals." ;
                                                                             rdfs:label "sentence_37571393_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37571393_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37571393_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37571393> ;
                                                                             gutprop:hasSentenceText "During aging, several tissues and biological systems undergo a progressive decline in function, leading to age-associated diseases such as neurodegenerative, inflammatory, metabolic, and cardiovascular diseases and cancer." ;
                                                                             rdfs:label "sentence_37571393_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37571393_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37571393_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37571393> ;
                                                                             gutprop:hasSentenceText "In this review, we focus on the molecular underpinning of senescence and neurodegeneration related to age-associated brain diseases, in particular, Alzheimer's and Parkinson's diseases, along with introducing nutrients or phytochemicals that modulate age-associated molecular dysfunctions, potentially offering preventive or therapeutic benefits." ;
                                                                             rdfs:label "sentence_37571393_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37571393_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37571393_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37571393> ;
                                                                             gutprop:hasSentenceText "Based on current knowledge, the dysregulation of microglia genes and neuroinflammation, telomere attrition, neuronal stem cell degradation, vascular system dysfunction, reactive oxygen species, loss of chromosome X inactivation in females, and gut microbiome dysbiosis have been seen to play pivotal roles in neurodegeneration in an interactive manner." ;
                                                                             rdfs:label "sentence_37571393_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37571393_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37571393_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37571393> ;
                                                                             gutprop:hasSentenceText "There are several phytochemicals (e.g., curcumin, EGCG, fucoidan, galangin, astin C, apigenin, resveratrol, phytic acid, acacetin, daucosterol, silibinin, sulforaphane, withaferin A, and betulinic acid) that modulate the dysfunction of one or several key genes (e.g., TREM2, C3, C3aR1, TNFA, NF-kb, TGFB1&2, SIRT1&6, HMGB1, and STING) affected in the aged brain." ;
                                                                             rdfs:label "sentence_37571393_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37571393_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37571393_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37571393> ;
                                                                             gutprop:hasSentenceText "Although phytochemicals have shown promise in slowing down the progression of age-related brain diseases, more studies to identify their efficacy, alone or in combinations, in preclinical systems can help to design novel nutritional strategies for the management of neurodegenerative diseases in humans." ;
                                                                             rdfs:label "sentence_37571393_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37574818_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37574818_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/37574818> ;
                                                                             gutprop:hasSentenceText "Ameliorative effect of Lactobacillus plantarum CCFM8661 on oleic acid-induced acne: integrated gut microbiota link to acne pathogenesis." ;
                                                                             rdfs:label "sentence_37574818_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37574818_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37574818_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37574818> ;
                                                                             gutprop:hasSentenceText "Acne vulgaris is an inflammatory disease of the pilosebaceous unit of the skin that has serious adverse effects on the physical and mental health of patients." ;
                                                                             rdfs:label "sentence_37574818_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37574818_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37574818_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37574818> ;
                                                                             gutprop:hasSentenceText "Probiotics are extensively employed in dermatology and could be an alternative option for acne therapy." ;
                                                                             rdfs:label "sentence_37574818_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37574818_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37574818_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37574818> ;
                                                                             gutprop:hasSentenceText "Here, we evaluated the effect of oral ingestion of live and inactivated Lactobacillus plantarum CCFM8661 on oleic acid-induced acne using a mouse model." ;
                                                                             rdfs:label "sentence_37574818_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37574818_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37574818_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37574818> ;
                                                                             gutprop:hasSentenceText "Results indicated that live L. plantarum CCFM8661 suppressed skin inflammation and serum hormone (insulin and testosterone) production in acne mice." ;
                                                                             rdfs:label "sentence_37574818_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37574818_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37574818_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37574818> ;
                                                                             gutprop:hasSentenceText "Parallelly, live L. plantarum CCFM8661 effectively reduced the formation of skin lipids (triglycerides and non-esterified free fatty acids), and normalized the expression of skin lipid metabolism-related genes (PPAR-γ, SREBP-1c, ACCα, FASN, PPAR-α, ACOX1, HSL and ATGL)." ;
                                                                             rdfs:label "sentence_37574818_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37574818_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37574818_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37574818> ;
                                                                             gutprop:hasSentenceText "In comparison, inactivated L. plantarum CCFM8661 had no effect on skin inflammation or serum hormone secretion, but decreased skin triglycerides and normalized the expression of skin lipid metabolism-related genes (PPAR-γ, SREBP-1c, FASN and ATGL) in acne mice." ;
                                                                             rdfs:label "sentence_37574818_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37574818_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37574818_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37574818> ;
                                                                             gutprop:hasSentenceText "Both live and inactivated L. plantarum CCFM8661 raised the richness of gut microbiota, reduced the ratio of Bacteroidetes to Firmicutes and decreased the relative abundance of Staphylococcus in the feces of acne mice." ;
                                                                             rdfs:label "sentence_37574818_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37574818_8
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37574818_8> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37574818> ;
                                                                             gutprop:hasSentenceText "Oral ingestion of L. plantarum CCFM8661, particularly live cells, could alleviate acne by suppressing skin inflammation, normalizing the metabolism of hormones and skin lipids, which may be achieved by improving the gut microbial ecosystem." ;
                                                                             rdfs:label "sentence_37574818_8" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37574818_9
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37574818_9> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37574818> ;
                                                                             gutprop:hasSentenceText "© 2023 Society of Chemical Industry." ;
                                                                             rdfs:label "sentence_37574818_9" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37576972_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37576972_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/37576972> ;
                                                                             gutprop:hasSentenceText "Profiles and diagnostic value of intestinal microbiota in schizophrenia patients with metabolic syndrome." ;
                                                                             rdfs:label "sentence_37576972_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37576972_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37576972_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37576972> ;
                                                                             gutprop:hasSentenceText "It is widely thought that the intestinal microbiota plays a significant role in the pathogenesis of metabolic disorders." ;
                                                                             rdfs:label "sentence_37576972_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37576972_10
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37576972_10> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37576972> ;
                                                                              gutprop:hasSentenceText "In addition, a significant correlation was observed between the metabolic-related parameters and abundance of altered microbiota including HDL-c (r2 = 0.203, p=0.0005), GLU (r2 = 0.286, p=0.0005) and WC (r2 = 0.061, p=0.037)." ;
                                                                              rdfs:label "sentence_37576972_10" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37576972_11
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37576972_11> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37576972> ;
                                                                              gutprop:hasSentenceText "Furthermore, KEGG pathway analysis showed that 16 signaling pathways were significantly enriched between the two groups (p<0.05)." ;
                                                                              rdfs:label "sentence_37576972_11" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37576972_12
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37576972_12> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37576972> ;
                                                                              gutprop:hasSentenceText "Importantly, our diagnostic model based on five microorganisms established by decision tree analysis could effectively distinguish between patients with and without MetS (AUC = 0.94)." ;
                                                                              rdfs:label "sentence_37576972_12" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37576972_13
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37576972_13> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37576972> ;
                                                                              gutprop:hasSentenceText "Our study established the compositional and functional characteristics of intestinal microbiota in schizophrenia patients with MetS." ;
                                                                              rdfs:label "sentence_37576972_13" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37576972_14
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37576972_14> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37576972> ;
                                                                              gutprop:hasSentenceText "These new findings provide novel insights into a better understanding of this disease and provide the theoretical basis for implementing new interventional therapies in clinical practice." ;
                                                                              rdfs:label "sentence_37576972_14" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37576972_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37576972_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37576972> ;
                                                                             gutprop:hasSentenceText "However, the gut microbiota composition and characteristics of schizophrenia patients with metabolic syndrome (MetS) have been largely understudied." ;
                                                                             rdfs:label "sentence_37576972_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37576972_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37576972_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37576972> ;
                                                                             gutprop:hasSentenceText "Herein, we investigated the association between the metabolic status of mainland Chinese schizophrenia patients with MetS and the intestinal microbiome." ;
                                                                             rdfs:label "sentence_37576972_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37576972_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37576972_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37576972> ;
                                                                             gutprop:hasSentenceText "Fecal microbiota communities from 115 male schizophrenia patients (57 with MetS and 58 without MetS) were assessed by 16S ribosomal RNA gene sequencing." ;
                                                                             rdfs:label "sentence_37576972_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37576972_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37576972_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37576972> ;
                                                                             gutprop:hasSentenceText "We assessed the variations of gut microbiome between both groups and explored potential associations between intestinal microbiota and parameters of MetS." ;
                                                                             rdfs:label "sentence_37576972_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37576972_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37576972_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37576972> ;
                                                                             gutprop:hasSentenceText "In addition, the Phylogenetic Investigation of Communities by Reconstruction of Unobserved States (PICRUSt) based on the KEGG database was used to predict the function of intestinal microbiota." ;
                                                                             rdfs:label "sentence_37576972_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37576972_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37576972_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37576972> ;
                                                                             gutprop:hasSentenceText "We also conducted Decision Tree Analysis to develop a diagnostic model for the MetS in patients with schizophrenia based on the composition of intestinal microbiota." ;
                                                                             rdfs:label "sentence_37576972_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37576972_8
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37576972_8> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37576972> ;
                                                                             gutprop:hasSentenceText "The fecal microbial diversity significantly differed between groups with or without MetS (α-diversity (Shannon index and Simpson index): p=0.0155, p=0.0089; β-diversity: p=0.001)." ;
                                                                             rdfs:label "sentence_37576972_8" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37576972_9
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37576972_9> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37576972> ;
                                                                             gutprop:hasSentenceText "Moreover, the microbial composition was significantly different between the two groups, involving five phyla and 38 genera (p<0.05)." ;
                                                                             rdfs:label "sentence_37576972_9" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37577447_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37577447_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/37577447> ;
                                                                             gutprop:hasSentenceText "The association between oral and gut microbiota in male patients with alcohol dependence." ;
                                                                             rdfs:label "sentence_37577447_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37577447_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37577447_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37577447> ;
                                                                             gutprop:hasSentenceText "The relationship between oral and gut microbiota in alcohol dependence (AD) is not well understood, particularly the effects of oral microbiota on the intestinal microbiota." ;
                                                                             rdfs:label "sentence_37577447_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37577447_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37577447_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37577447> ;
                                                                             gutprop:hasSentenceText "The current study aimed to explore the association between oral and gut microbiota in AD to clarify whether oral microbiota could ectopically colonize into the gut." ;
                                                                             rdfs:label "sentence_37577447_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37577447_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37577447_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37577447> ;
                                                                             gutprop:hasSentenceText "16S rRNA sequence libraries were used to compare oral and gut microbial profiles in persons with AD and healthy controls (HC)." ;
                                                                             rdfs:label "sentence_37577447_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37577447_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37577447_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37577447> ;
                                                                             gutprop:hasSentenceText "Source Tracker and NetShift were used to identify bacteria responsible for ectopic colonization and indicate the driver function of ectopic colonization bacteria." ;
                                                                             rdfs:label "sentence_37577447_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37577447_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37577447_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37577447> ;
                                                                             gutprop:hasSentenceText "The α-diversity of oral microbiota and intestinal microbiota was significantly decreased in persons with AD (all <i>p</i> < 0.05)." ;
                                                                             rdfs:label "sentence_37577447_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37577447_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37577447_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37577447> ;
                                                                             gutprop:hasSentenceText "Principal coordinate analysis indicated greater similarity between oral and gut microbiota in persons with AD than that in HC, and oral-gut overlaps in microbiota were found for 9 genera in persons with AD relative to only 3 genera in HC." ;
                                                                             rdfs:label "sentence_37577447_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37577447_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37577447_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37577447> ;
                                                                             gutprop:hasSentenceText "The contribution ratio of oral microbiota to intestinal microbiota composition in AD is 5.26% based on Source Tracker，and the AD with ectopic colonization showed the daily maximum standard drinks, red blood cell counts, hemoglobin content, and PACS scores decreasing (all <i>p</i> < 0.05)." ;
                                                                             rdfs:label "sentence_37577447_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37577447_8
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37577447_8> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37577447> ;
                                                                             gutprop:hasSentenceText "Results highlight the connection between oral-gut microbiota in AD and suggest novel potential mechanistic possibilities." ;
                                                                             rdfs:label "sentence_37577447_8" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37606895_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37606895_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/37606895> ;
                                                                             gutprop:hasSentenceText "Gastrointestinal involvement in post-acute Coronavirus disease (COVID)-19 syndrome." ;
                                                                             rdfs:label "sentence_37606895_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37606895_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37606895_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37606895> ;
                                                                             gutprop:hasSentenceText "Ten percentage of patients with coronavirus disease (COVID)-19 report having gastrointestinal (GI) symptoms as severe acute respiratory syndrome coronavirus-2 (SARS-CoV2) not only infects the pulmonary but also the GI tract." ;
                                                                             rdfs:label "sentence_37606895_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37606895_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37606895_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37606895> ;
                                                                             gutprop:hasSentenceText "GI infections including that due to viral infection is known to cause postinfection disorders of gut-brain interaction (DGBI); hence, we wish to review the long-term GI consequences following COVID-19, particularly post-COVID-19 DGBI." ;
                                                                             rdfs:label "sentence_37606895_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37606895_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37606895_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37606895> ;
                                                                             gutprop:hasSentenceText "At least 12 cohort studies, four of which also included controls documented the occurrence of post-COVID-19 DGBI, particularly IBS following COVID-19." ;
                                                                             rdfs:label "sentence_37606895_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37606895_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37606895_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37606895> ;
                                                                             gutprop:hasSentenceText "The risk factors for post-COVID-19 DGBI included female gender, symptomatic COVID-19, particularly GI symptoms, the severity of COVID-19, the occurrence of anosmia and ageusia, use of antibiotics and hospitalization during the acute illness, persistent GI symptoms beyond 1 month after recovery, presence of mental health factors, The putative mechanisms for post-COVID-19 DGBI include altered gut motility, visceral hypersensitivity, gut microbiota dysbiosis, GI inflammation, and immune activation, changes in intestinal permeability, and alterations in the enteroendocrine system and serotonin metabolism." ;
                                                                             rdfs:label "sentence_37606895_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37606895_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37606895_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37606895> ;
                                                                             gutprop:hasSentenceText "Long-term sequelae of SARS-CoV2 infection may persist even after recovery from COVID-19." ;
                                                                             rdfs:label "sentence_37606895_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37606895_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37606895_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37606895> ;
                                                                             gutprop:hasSentenceText "Patients with COVID-19 are more likely to develop post-COVID-19 IBS than healthy controls." ;
                                                                             rdfs:label "sentence_37606895_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37606895_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37606895_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37606895> ;
                                                                             gutprop:hasSentenceText "Post-COVID-19 IBS may pose a substantial healthcare burden to society." ;
                                                                             rdfs:label "sentence_37606895_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37607587_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37607587_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/37607587> ;
                                                                             gutprop:hasSentenceText "Gastrointestinal Dysfunction in Neurological and Neurodegenerative Disorders." ;
                                                                             rdfs:label "sentence_37607587_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37607587_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37607587_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37607587> ;
                                                                             gutprop:hasSentenceText "Increasing research links the gut microbiome to neurodegenerative disorders." ;
                                                                             rdfs:label "sentence_37607587_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37607587_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37607587_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37607587> ;
                                                                             gutprop:hasSentenceText "The gut microbiome communicates with the central nervous system via the gut-brain axis and affects behavioral and cognitive phenotypes." ;
                                                                             rdfs:label "sentence_37607587_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37607587_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37607587_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37607587> ;
                                                                             gutprop:hasSentenceText "Dysbiosis (a dysfunctional microbiome) drives increased intestinal permeability and inflammation that can negatively affect the brain via the gut-brain axis." ;
                                                                             rdfs:label "sentence_37607587_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37607587_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37607587_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37607587> ;
                                                                             gutprop:hasSentenceText "Healthier metabolic and lipid profiles and cognitive phenotypes are observed in individuals with more distinct microbiomes." ;
                                                                             rdfs:label "sentence_37607587_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37607587_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37607587_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37607587> ;
                                                                             gutprop:hasSentenceText "In this review, we discuss the role of the gut microbiome and gut-brain axis in neurodegenerative diseases such as Parkinson's disease and Alzheimer's disease and related animal models, in cancer and cancer treatments, and in metabolic syndrome." ;
                                                                             rdfs:label "sentence_37607587_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37607587_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37607587_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37607587> ;
                                                                             gutprop:hasSentenceText "We also discuss strategies to improve the gut microbiome and ultimately brain function." ;
                                                                             rdfs:label "sentence_37607587_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37607587_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37607587_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37607587> ;
                                                                             gutprop:hasSentenceText "Because healthier cognitive phenotypes are observed in individuals with more distinct microbiomes, increased efforts are warranted to develop therapeutic strategies for those at increased risk of developing neurological disorders and patients diagnosed with those disorders." ;
                                                                             rdfs:label "sentence_37607587_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37624502_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37624502_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/37624502> ;
                                                                             gutprop:hasSentenceText "The association between greenery type and gut microbiome in schizophrenia: did all greenspaces play the equivalent role?" ;
                                                                             rdfs:label "sentence_37624502_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37624502_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37624502_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37624502> ;
                                                                             gutprop:hasSentenceText "In recent years, attention has been focused on the benefit of greenspace on mental health, and it is suggested this link may vary with the type of greenspace." ;
                                                                             rdfs:label "sentence_37624502_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37624502_10
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37624502_10> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37624502> ;
                                                                              gutprop:hasSentenceText "Tree coverage was consistently associated with microbial composition in both 1500 m (R<sup>2</sup> = 0.007, P = 0.030) and 3000 m (R<sup>2</sup> = 0.007, P = 0.039)." ;
                                                                              rdfs:label "sentence_37624502_10" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37624502_11
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37624502_11> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37624502> ;
                                                                              gutprop:hasSentenceText "In contrast, there was no association with grass cover in any of the buffer zones." ;
                                                                              rdfs:label "sentence_37624502_11" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37624502_12
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37624502_12> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37624502> ;
                                                                              gutprop:hasSentenceText "In the regression analysis, higher tree coverage was significantly correlated with the relative abundance of several taxa." ;
                                                                              rdfs:label "sentence_37624502_12" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37624502_13
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37624502_13> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37624502> ;
                                                                              gutprop:hasSentenceText "Among them, tree coverage was positively associated with increased Bifidobacterium longum (β = 1.069, P = 0.004), which was the dominant composition in the gut microbiota." ;
                                                                              rdfs:label "sentence_37624502_13" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37624502_14
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37624502_14> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37624502> ;
                                                                              gutprop:hasSentenceText "The relationship between greenspace and gut microbiome in SCZ differed by the type of greenspace." ;
                                                                              rdfs:label "sentence_37624502_14" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37624502_15
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37624502_15> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37624502> ;
                                                                              gutprop:hasSentenceText "Besides, \"tree coverage\" may present a dominant effect on the important taxonomic composition." ;
                                                                              rdfs:label "sentence_37624502_15" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37624502_16
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37624502_16> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37624502> ;
                                                                              gutprop:hasSentenceText "Our findings might provide instructive evidence for the design of urban greenspace to optimize health and well-being in SCZ as well as the whole people." ;
                                                                              rdfs:label "sentence_37624502_16" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37624502_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37624502_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37624502> ;
                                                                             gutprop:hasSentenceText "More and more studies have emphasized the influence of the gut microbiome on schizophrenia (SCZ)." ;
                                                                             rdfs:label "sentence_37624502_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37624502_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37624502_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37624502> ;
                                                                             gutprop:hasSentenceText "However, the effects of greenspaces on the gut microbiota in SCZ and the effect of different types of greenspaces on the gut microbiota remain unclear." ;
                                                                             rdfs:label "sentence_37624502_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37624502_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37624502_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37624502> ;
                                                                             gutprop:hasSentenceText "We aim to examine if there were variations in the effects of various greenspace types on the gut microbiome in SCZ." ;
                                                                             rdfs:label "sentence_37624502_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37624502_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37624502_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37624502> ;
                                                                             gutprop:hasSentenceText "Besides, we sink to explore important taxonomic compositions associated with different greenspace types." ;
                                                                             rdfs:label "sentence_37624502_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37624502_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37624502_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37624502> ;
                                                                             gutprop:hasSentenceText "We recruited 243 objects with schizophrenia from Anhui Mental Health Center and collected fecal samples for 16Sr RNA gene sequencing." ;
                                                                             rdfs:label "sentence_37624502_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37624502_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37624502_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37624502> ;
                                                                             gutprop:hasSentenceText "Three types of greenery coverage were calculated with different circular buffers (800, 1500, and 3000 m) corresponding to individual addresses." ;
                                                                             rdfs:label "sentence_37624502_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37624502_8
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37624502_8> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37624502> ;
                                                                             gutprop:hasSentenceText "The association between greenspace and microbiome composition was analyzed with permutational analysis of variance (PERMANOVA)." ;
                                                                             rdfs:label "sentence_37624502_8" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37624502_9
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37624502_9> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37624502> ;
                                                                             gutprop:hasSentenceText "We conducted the linear regression to capture specific gut microbiome taxa associated with greenery coverage." ;
                                                                             rdfs:label "sentence_37624502_9" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37627638_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37627638_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/37627638> ;
                                                                             gutprop:hasSentenceText "Multi-Omics Approach Reveals Prebiotic and Potential Antioxidant Effects of Essential Oils from the Mediterranean Diet on Cardiometabolic Disorder Using Humanized Gnotobiotic Mice." ;
                                                                             rdfs:label "sentence_37627638_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37627638_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37627638_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37627638> ;
                                                                             gutprop:hasSentenceText "Essential oils sourced from herbs commonly used in the Mediterranean diet have demonstrated advantageous attributes as nutraceuticals and prebiotics within a model of severe cardiometabolic disorder." ;
                                                                             rdfs:label "sentence_37627638_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37627638_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37627638_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37627638> ;
                                                                             gutprop:hasSentenceText "The primary objective of this study was to assess the influences exerted by essential oils derived from thyme (<i>Thymus vulgaris</i>) and oregano (<i>Origanum vulgare</i>) via a comprehensive multi-omics approach within a gnotobiotic murine model featuring colonic microbiota acquired from patients diagnosed with coronary artery disease (CAD) and type-2 diabetes mellitus (T2DM)." ;
                                                                             rdfs:label "sentence_37627638_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37627638_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37627638_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37627638> ;
                                                                             gutprop:hasSentenceText "Our findings demonstrated prebiotic and potential antioxidant effects elicited by these essential oils." ;
                                                                             rdfs:label "sentence_37627638_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37627638_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37627638_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37627638> ;
                                                                             gutprop:hasSentenceText "We observed a substantial increase in the relative abundance of the <i>Lactobacillus</i> genus in the gut microbiota, accompanied by higher levels of short-chain fatty acids and a reduction in trimethylamine N-oxide levels and protein oxidation in the plasma." ;
                                                                             rdfs:label "sentence_37627638_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37627638_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37627638_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37627638> ;
                                                                             gutprop:hasSentenceText "Moreover, functional enrichment analysis of the cardiac tissue proteome unveiled an over-representation of pathways related to mitochondrial function, oxidative stress, and cardiac contraction." ;
                                                                             rdfs:label "sentence_37627638_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37627638_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37627638_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37627638> ;
                                                                             gutprop:hasSentenceText "These findings provide compelling evidence of the prebiotic and antioxidant actions of thyme- and oregano-derived essential oils, which extend to cardiac function." ;
                                                                             rdfs:label "sentence_37627638_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37627638_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37627638_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37627638> ;
                                                                             gutprop:hasSentenceText "These results encourage further investigation into the promising utility of essential oils derived from herbs commonly used in the Mediterranean diet as potential nutraceutical interventions for mitigating chronic diseases linked to CAD and T2DM." ;
                                                                             rdfs:label "sentence_37627638_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37655441_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37655441_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/37655441> ;
                                                                             gutprop:hasSentenceText "The curious case of <i>Prevotella copri</i>." ;
                                                                             rdfs:label "sentence_37655441_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37655441_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37655441_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37655441> ;
                                                                             gutprop:hasSentenceText "<i>Prevotella copri</i> is an abundant member of the human gastrointestinal microbiome, whose relative abundance has curiously been associated with positive and negative impacts on diseases, such as Parkinson's disease and rheumatoid arthritis." ;
                                                                             rdfs:label "sentence_37655441_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37655441_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37655441_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37655441> ;
                                                                             gutprop:hasSentenceText "Yet, the verdict is still out on the definitive role of" ;
                                                                             rdfs:label "sentence_37655441_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37655441_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37655441_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37655441> ;
                                                                             gutprop:hasSentenceText "<i>P. copri</i> in human health, and on the effect of different diets on its relative abundance in the gut microbiome." ;
                                                                             rdfs:label "sentence_37655441_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37655441_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37655441_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37655441> ;
                                                                             gutprop:hasSentenceText "The puzzling discrepancies among" ;
                                                                             rdfs:label "sentence_37655441_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37655441_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37655441_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37655441> ;
                                                                             gutprop:hasSentenceText "<i>P. copri</i> studies have only recently been attributed to the diversity of its strains, which substantially differ in their encoded metabolic patterns from the commonly used reference strain." ;
                                                                             rdfs:label "sentence_37655441_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37655441_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37655441_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37655441> ;
                                                                             gutprop:hasSentenceText "However, such strain differences cannot be resolved by common 16S rRNA amplicon profiling methods." ;
                                                                             rdfs:label "sentence_37655441_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37655441_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37655441_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37655441> ;
                                                                             gutprop:hasSentenceText "Here, we scrutinize" ;
                                                                             rdfs:label "sentence_37655441_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37655441_8
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37655441_8> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37655441> ;
                                                                             gutprop:hasSentenceText "<i>P. copri</i>, its versatile metabolic potential, and the hypotheses behind the conflicting observations on its association with diet and human health." ;
                                                                             rdfs:label "sentence_37655441_8" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37655441_9
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37655441_9> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37655441> ;
                                                                             gutprop:hasSentenceText "We also provide suggestions for designing studies and bioinformatics pipelines to better research <i>P. copri</i>." ;
                                                                             rdfs:label "sentence_37655441_9" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37657622_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37657622_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/37657622> ;
                                                                             gutprop:hasSentenceText "Strain-level structure of gut microbiome showed potential association with cognitive function in major depressive disorder: A pilot study." ;
                                                                             rdfs:label "sentence_37657622_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37657622_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37657622_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37657622> ;
                                                                             gutprop:hasSentenceText "Although the association between gut microbiota and the pathogenesis of major depressive disorder (MDD) has been well studied, it is unclear whether gut microbiota affects cognitive function in patients with MDD." ;
                                                                             rdfs:label "sentence_37657622_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37657622_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37657622_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37657622> ;
                                                                             gutprop:hasSentenceText "In this study, we explored the association between gut microbiota and cognitive function in MDD and its possible mechanisms." ;
                                                                             rdfs:label "sentence_37657622_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37657622_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37657622_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37657622> ;
                                                                             gutprop:hasSentenceText "We enrolled 57 patients with MDD and 30 healthy controls (HCs) and used 16S rRNA gene sequencing analysis and shotgun metagenomic sequencing analysis to determine gut microbial composition." ;
                                                                             rdfs:label "sentence_37657622_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37657622_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37657622_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37657622> ;
                                                                             gutprop:hasSentenceText "The richness and diversity of gut microbiota in patients with MDD were the same as those in HCs, but there were differences in the abundance of Bifidobacterium and Blautia." ;
                                                                             rdfs:label "sentence_37657622_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37657622_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37657622_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37657622> ;
                                                                             gutprop:hasSentenceText "Compared with HCs, two strains (bin_32 and bin_55) were significantly increased, and one strain (bin_31) was significantly decreased in patients with MDD based on the strain-level meta-analysis." ;
                                                                             rdfs:label "sentence_37657622_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37657622_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37657622_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37657622> ;
                                                                             gutprop:hasSentenceText "Time to complete the Stroop-C had significant negative correlations with bin_31 and bin_32." ;
                                                                             rdfs:label "sentence_37657622_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37657622_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37657622_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37657622> ;
                                                                             gutprop:hasSentenceText "Bin_55 had significant negative correlations with time to complete the Stroop-C, time to complete the Stroop-CW, and repeated animal words in 60 s but significant positive correlations with correct answers in 120 s on the Stroop-CW." ;
                                                                             rdfs:label "sentence_37657622_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37657622_8
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37657622_8> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37657622> ;
                                                                             gutprop:hasSentenceText "This study only tested the cognitive function of MDD in a small sample, which may have caused some bias." ;
                                                                             rdfs:label "sentence_37657622_8" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37657622_9
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37657622_9> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37657622> ;
                                                                             gutprop:hasSentenceText "Based on our strain-level analysis, we found that gut microbiota may be associated with the pathogenesis of MDD and may have potential effects on cognitive function." ;
                                                                             rdfs:label "sentence_37657622_9" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37676767_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37676767_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/37676767> ;
                                                                             gutprop:hasSentenceText "Fiber deprivation and microbiome-borne curli shift gut bacterial populations and accelerate disease in a mouse model of Parkinson's disease." ;
                                                                             rdfs:label "sentence_37676767_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37676767_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37676767_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37676767> ;
                                                                             gutprop:hasSentenceText "Parkinson's disease (PD) is a neurological disorder characterized by motor dysfunction, dopaminergic neuron loss, and alpha-synuclein (αSyn) inclusions." ;
                                                                             rdfs:label "sentence_37676767_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37676767_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37676767_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37676767> ;
                                                                             gutprop:hasSentenceText "Many PD risk factors are known, but those affecting disease progression are not." ;
                                                                             rdfs:label "sentence_37676767_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37676767_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37676767_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37676767> ;
                                                                             gutprop:hasSentenceText "Lifestyle and microbial dysbiosis are candidates in this context." ;
                                                                             rdfs:label "sentence_37676767_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37676767_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37676767_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37676767> ;
                                                                             gutprop:hasSentenceText "Diet-driven gut dysbiosis and reduced barrier function may increase exposure of enteric neurons to toxins." ;
                                                                             rdfs:label "sentence_37676767_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37676767_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37676767_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37676767> ;
                                                                             gutprop:hasSentenceText "Here, we study whether fiber deprivation and exposure to bacterial curli, a protein cross-seeding with αSyn, individually or together, exacerbate disease in the enteric and central nervous systems of a transgenic PD mouse model." ;
                                                                             rdfs:label "sentence_37676767_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37676767_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37676767_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37676767> ;
                                                                             gutprop:hasSentenceText "We analyze the gut microbiome, motor behavior, and gastrointestinal and brain pathologies." ;
                                                                             rdfs:label "sentence_37676767_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37676767_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37676767_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37676767> ;
                                                                             gutprop:hasSentenceText "We find that diet and bacterial curli alter the microbiome and exacerbate motor performance, as well as intestinal and brain pathologies, but to different extents." ;
                                                                             rdfs:label "sentence_37676767_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37676767_8
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37676767_8> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37676767> ;
                                                                             gutprop:hasSentenceText "Our results shed important insights on how diet and microbiome-borne insults modulate PD progression via the gut-brain axis and have implications for lifestyle management of PD." ;
                                                                             rdfs:label "sentence_37676767_8" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37764088_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37764088_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/37764088> ;
                                                                             gutprop:hasSentenceText "Altered Gut Microbiota Composition Is Associated with Difficulty in Explicit Emotion Regulation in Young Children." ;
                                                                             rdfs:label "sentence_37764088_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37764088_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37764088_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37764088> ;
                                                                             gutprop:hasSentenceText "Executive function (EF) consists of explicit emotion regulation (EER) and cognitive control (CC)." ;
                                                                             rdfs:label "sentence_37764088_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37764088_10
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37764088_10> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37764088> ;
                                                                              gutprop:hasSentenceText "Our results show that children with EER-risk (an index of inhibitory self-control) had a higher abundance of the genera <i>Actinomyces</i> and <i>Sutterella</i>." ;
                                                                              rdfs:label "sentence_37764088_10" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37764088_11
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37764088_11> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37764088> ;
                                                                              gutprop:hasSentenceText "Although we have not established a direct link between GM and CC risk, our findings indicate that GM of preschoolers is closely associated with emotional processing and that EERrisk children have more inflammation-related bacteria." ;
                                                                              rdfs:label "sentence_37764088_11" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37764088_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37764088_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37764088> ;
                                                                             gutprop:hasSentenceText "Childhood EER in particular predicts mental and physical health in adulthood." ;
                                                                             rdfs:label "sentence_37764088_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37764088_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37764088_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37764088> ;
                                                                             gutprop:hasSentenceText "Identifying factors affecting EER development has implications for lifelong physical and mental health." ;
                                                                             rdfs:label "sentence_37764088_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37764088_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37764088_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37764088> ;
                                                                             gutprop:hasSentenceText "Gut microbiota (GM) has attracted attention as a potential biomarker for risk of physical and mental problems in adulthood." ;
                                                                             rdfs:label "sentence_37764088_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37764088_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37764088_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37764088> ;
                                                                             gutprop:hasSentenceText "Furthermore, GM is related to brain function/structure, which plays a crucial role in emotional processing." ;
                                                                             rdfs:label "sentence_37764088_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37764088_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37764088_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37764088> ;
                                                                             gutprop:hasSentenceText "However, little is known about how GM compositions are associated with the development of emotion regulation in early childhood." ;
                                                                             rdfs:label "sentence_37764088_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37764088_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37764088_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37764088> ;
                                                                             gutprop:hasSentenceText "Therefore, in this study, we examined 257 children aged 3-4 to investigate links between GM and risk to EF." ;
                                                                             rdfs:label "sentence_37764088_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37764088_8
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37764088_8> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37764088> ;
                                                                             gutprop:hasSentenceText "EF was measured using the Mother-Reported Behavior Rating Inventory of Executive Function-Preschool version." ;
                                                                             rdfs:label "sentence_37764088_8" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37764088_9
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37764088_9> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37764088> ;
                                                                             gutprop:hasSentenceText "GM composition (alpha/beta diversity and genus abundance) was evaluated using 16S rRNA gene sequencing and compared between EF-risk and non-risk groups." ;
                                                                             rdfs:label "sentence_37764088_9" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37764277_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37764277_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/37764277> ;
                                                                             gutprop:hasSentenceText "Therapeutic Effects of Baicalin on Diseases Related to Gut-Brain Axis Dysfunctions." ;
                                                                             rdfs:label "sentence_37764277_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37764277_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37764277_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37764277> ;
                                                                             gutprop:hasSentenceText "The gut-brain axis is an active area of research." ;
                                                                             rdfs:label "sentence_37764277_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37764277_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37764277_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37764277> ;
                                                                             gutprop:hasSentenceText "Several representative diseases, including central nervous system disorders (Alzheimer's disease, Parkinson's disease, and depression), metabolic disorders (obesity-related diseases), and intestinal disorders (inflammatory bowel disease and dysbiosis), are associated with the dysfunctional gut-brain axis." ;
                                                                             rdfs:label "sentence_37764277_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37764277_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37764277_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37764277> ;
                                                                             gutprop:hasSentenceText "Baicalin, a bioactive flavonoid extracted from <i>Scutellaria baicalensis</i>, is reported to exert various pharmacological effects." ;
                                                                             rdfs:label "sentence_37764277_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37764277_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37764277_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37764277> ;
                                                                             gutprop:hasSentenceText "This narrative review summarizes the molecular mechanisms and potential targets of baicalin in disorders of the gut-brain axis." ;
                                                                             rdfs:label "sentence_37764277_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37764277_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37764277_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37764277> ;
                                                                             gutprop:hasSentenceText "Baicalin protects the central nervous system through anti-neuroinflammatory and anti-neuronal apoptotic effects, suppresses obesity through anti-inflammatory and antioxidant effects, and alleviates intestinal disorders through regulatory effects on intestinal microorganisms and short-chain fatty acid production." ;
                                                                             rdfs:label "sentence_37764277_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37764277_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37764277_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37764277> ;
                                                                             gutprop:hasSentenceText "The bioactivities of baicalin are mediated through the gut-brain axis." ;
                                                                             rdfs:label "sentence_37764277_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37764277_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37764277_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37764277> ;
                                                                             gutprop:hasSentenceText "This review comprehensively summarizes the regulatory role of baicalin in gut-brain axis disorders, laying a foundation for future research, although further confirmatory basic research is required." ;
                                                                             rdfs:label "sentence_37764277_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37834373_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37834373_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/37834373> ;
                                                                             gutprop:hasSentenceText "Impact of Microbiome-Brain Communication on Neuroinflammation and Neurodegeneration." ;
                                                                             rdfs:label "sentence_37834373_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37834373_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37834373_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37834373> ;
                                                                             gutprop:hasSentenceText "The gut microbiome plays a pivotal role in maintaining human health, with numerous studies demonstrating that alterations in microbial compositions can significantly affect the development and progression of various immune-mediated diseases affecting both the digestive tract and the central nervous system (CNS)." ;
                                                                             rdfs:label "sentence_37834373_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37834373_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37834373_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37834373> ;
                                                                             gutprop:hasSentenceText "This complex interplay between the microbiota, the gut, and the CNS is referred to as the gut-brain axis." ;
                                                                             rdfs:label "sentence_37834373_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37834373_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37834373_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37834373> ;
                                                                             gutprop:hasSentenceText "The role of the gut microbiota in the pathogenesis of neurodegenerative diseases has gained increasing attention in recent years, and evidence suggests that gut dysbiosis may contribute to disease development and progression." ;
                                                                             rdfs:label "sentence_37834373_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37834373_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37834373_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37834373> ;
                                                                             gutprop:hasSentenceText "Clinical studies have shown alterations in the composition of the gut microbiota in multiple sclerosis patients, with a decrease in beneficial bacteria and an increase in pro-inflammatory bacteria." ;
                                                                             rdfs:label "sentence_37834373_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37834373_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37834373_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37834373> ;
                                                                             gutprop:hasSentenceText "Furthermore, changes within the microbial community have been linked to the pathogenesis of Parkinson's disease and Alzheimer's disease." ;
                                                                             rdfs:label "sentence_37834373_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37834373_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37834373_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37834373> ;
                                                                             gutprop:hasSentenceText "Microbiota-gut-brain communication can impact neurodegenerative diseases through various mechanisms, including the regulation of immune function, the production of microbial metabolites, as well as modulation of host-derived soluble factors." ;
                                                                             rdfs:label "sentence_37834373_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37834373_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37834373_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37834373> ;
                                                                             gutprop:hasSentenceText "This review describes the current literature on the gut-brain axis and highlights novel communication systems that allow cross-talk between the gut microbiota and the host that might influence the pathogenesis of neuroinflammation and neurodegeneration." ;
                                                                             rdfs:label "sentence_37834373_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37841274_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37841274_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/37841274> ;
                                                                             gutprop:hasSentenceText "Melanin: a unifying theory of disease as exemplified by Parkinson's, Alzheimer's, and Lewy body dementia." ;
                                                                             rdfs:label "sentence_37841274_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37841274_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37841274_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37841274> ;
                                                                             gutprop:hasSentenceText "Melanin, a ubiquitous dark pigment, plays important roles in the immune system, including scavenging reactive oxygen species formed in response to ultraviolet radiation absorption, absorbing metals, thermal regulation, drug uptake, innate immune system functions, redox, and energy transduction." ;
                                                                             rdfs:label "sentence_37841274_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37841274_10
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37841274_10> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37841274> ;
                                                                              gutprop:hasSentenceText "Our theory that energy retained in melanin fuels cells in an inverse relationship with ATP is supported by studies showing alterations in ATP production in relationship to melanin levels in melanomas, vitiligo, and healthy cells." ;
                                                                              rdfs:label "sentence_37841274_10" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37841274_11
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37841274_11> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37841274> ;
                                                                              gutprop:hasSentenceText "Therefore, alteration of melanin levels may be at the core of many diseases." ;
                                                                              rdfs:label "sentence_37841274_11" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37841274_12
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37841274_12> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37841274> ;
                                                                              gutprop:hasSentenceText "We propose regulating melanin levels may offer new avenues for treatment development." ;
                                                                              rdfs:label "sentence_37841274_12" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37841274_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37841274_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37841274> ;
                                                                             gutprop:hasSentenceText "Many tissue types, including brain, heart, arteries, ovaries, and others, contain melanin." ;
                                                                             rdfs:label "sentence_37841274_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37841274_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37841274_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37841274> ;
                                                                             gutprop:hasSentenceText "Almost all cells contain precursors to melanin." ;
                                                                             rdfs:label "sentence_37841274_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37841274_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37841274_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37841274> ;
                                                                             gutprop:hasSentenceText "A growing number of diseases in which there is a loss of melanin and/or neuromelanin are increasingly thought to have infectious etiologies, for example, Alzheimer's disease (AD), Parkinson's disease (PD), Lewy Body Dementia (LBD), and vitiligo." ;
                                                                             rdfs:label "sentence_37841274_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37841274_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37841274_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37841274> ;
                                                                             gutprop:hasSentenceText "AD, PD, LBD, and vitiligo have been linked with herpesvirus, which enters melanosomes and causes apoptosis, and with gut dysbiosis and inflammation." ;
                                                                             rdfs:label "sentence_37841274_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37841274_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37841274_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37841274> ;
                                                                             gutprop:hasSentenceText "Herpesvirus is also linked with gut dysbiosis and inflammation." ;
                                                                             rdfs:label "sentence_37841274_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37841274_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37841274_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37841274> ;
                                                                             gutprop:hasSentenceText "We theorize that under normal healthy states, melanin retains some of the energy it absorbs from electromagnetic radiation, which is then used to fuel cells, and energy from ATP is used to compliment that energy supply." ;
                                                                             rdfs:label "sentence_37841274_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37841274_8
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37841274_8> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37841274> ;
                                                                             gutprop:hasSentenceText "We further theorize that loss of melanin reduces the energy supply of cells, which in the case of AD, PD, and LBD results in an inability to sustain immune system defenses and remove the plaques associated with the disease, which appear to be part of the immune system's attempt to eradicate the pathogens seen in these neurodegenerative diseases." ;
                                                                             rdfs:label "sentence_37841274_8" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37841274_9
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37841274_9> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37841274> ;
                                                                             gutprop:hasSentenceText "In addition, in an attempt to explain why removing these plaques does not result in improvements in cognition and mood and why cognitions and moods in these individuals have ebbs and flows, we postulate that it is not the plaques that cause the cognitive symptoms but, rather, inflammation in the brain resulting from the immune system's response to pathogens." ;
                                                                             rdfs:label "sentence_37841274_9" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37845499_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37845499_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/37845499> ;
                                                                             gutprop:hasSentenceText "Emerging role of the host microbiome in neuropsychiatric disorders: overview and future directions." ;
                                                                             rdfs:label "sentence_37845499_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37845499_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37845499_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37845499> ;
                                                                             gutprop:hasSentenceText "The human body harbors a diverse ecosystem of microorganisms, including bacteria, viruses, and fungi, collectively known as the microbiota." ;
                                                                             rdfs:label "sentence_37845499_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37845499_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37845499_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37845499> ;
                                                                             gutprop:hasSentenceText "Current research is increasingly focusing on the potential association between the microbiota and various neuropsychiatric disorders." ;
                                                                             rdfs:label "sentence_37845499_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37845499_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37845499_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37845499> ;
                                                                             gutprop:hasSentenceText "The microbiota resides in various parts of the body, such as the oral cavity, nasal passages, lungs, gut, skin, bladder, and vagina." ;
                                                                             rdfs:label "sentence_37845499_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37845499_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37845499_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37845499> ;
                                                                             gutprop:hasSentenceText "The gut microbiota in the gastrointestinal tract has received particular attention due to its high abundance and its potential role in psychiatric and neurodegenerative disorders." ;
                                                                             rdfs:label "sentence_37845499_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37845499_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37845499_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37845499> ;
                                                                             gutprop:hasSentenceText "However, the microbiota presents in other body tissues, though less abundant, also plays crucial role in immune system and human homeostasis, thus influencing the development and progression of neuropsychiatric disorders." ;
                                                                             rdfs:label "sentence_37845499_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37845499_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37845499_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37845499> ;
                                                                             gutprop:hasSentenceText "For example, oral microbiota imbalance and associated periodontitis might increase the risk for neuropsychiatric disorders." ;
                                                                             rdfs:label "sentence_37845499_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37845499_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37845499_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37845499> ;
                                                                             gutprop:hasSentenceText "Additionally, studies using the postmortem brain samples have detected the widespread presence of oral bacteria in the brains of patients with Alzheimer's disease." ;
                                                                             rdfs:label "sentence_37845499_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37845499_8
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37845499_8> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37845499> ;
                                                                             gutprop:hasSentenceText "This article provides an overview of the emerging role of the host microbiota in neuropsychiatric disorders and discusses future directions, such as underlying biological mechanisms, reliable biomarkers associated with the host microbiota, and microbiota-targeted interventions, for research in this field." ;
                                                                             rdfs:label "sentence_37845499_8" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37849234_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37849234_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/37849234> ;
                                                                             gutprop:hasSentenceText "Microbiota from Alzheimer's patients induce deficits in cognition and hippocampal neurogenesis." ;
                                                                             rdfs:label "sentence_37849234_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37849234_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37849234_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37849234> ;
                                                                             gutprop:hasSentenceText "Alzheimer's disease is a complex neurodegenerative disorder leading to a decline in cognitive function and mental health." ;
                                                                             rdfs:label "sentence_37849234_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37849234_10
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37849234_10> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37849234> ;
                                                                              gutprop:hasSentenceText "Our findings reveal for the first time, that Alzheimer's symptoms can be transferred to a healthy young organism via the gut microbiota, confirming a causal role of gut microbiota in Alzheimer's disease, and highlight hippocampal neurogenesis as a converging central cellular process regulating systemic circulatory and gut-mediated factors in Alzheimer's." ;
                                                                              rdfs:label "sentence_37849234_10" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37849234_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37849234_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37849234> ;
                                                                             gutprop:hasSentenceText "Recent research has positioned the gut microbiota as an important susceptibility factor in Alzheimer's disease by showing specific alterations in the gut microbiome composition of Alzheimer's patients and in rodent models." ;
                                                                             rdfs:label "sentence_37849234_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37849234_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37849234_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37849234> ;
                                                                             gutprop:hasSentenceText "However, it is unknown whether gut microbiota alterations are causal in the manifestation of Alzheimer's symptoms." ;
                                                                             rdfs:label "sentence_37849234_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37849234_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37849234_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37849234> ;
                                                                             gutprop:hasSentenceText "To understand the involvement of Alzheimer's patient gut microbiota in host physiology and behaviour, we transplanted faecal microbiota from Alzheimer's patients and age-matched healthy controls into microbiota-depleted young adult rats." ;
                                                                             rdfs:label "sentence_37849234_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37849234_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37849234_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37849234> ;
                                                                             gutprop:hasSentenceText "We found impairments in behaviours reliant on adult hippocampal neurogenesis, an essential process for certain memory functions and mood, resulting from Alzheimer's patient transplants." ;
                                                                             rdfs:label "sentence_37849234_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37849234_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37849234_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37849234> ;
                                                                             gutprop:hasSentenceText "Notably, the severity of impairments correlated with clinical cognitive scores in donor patients." ;
                                                                             rdfs:label "sentence_37849234_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37849234_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37849234_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37849234> ;
                                                                             gutprop:hasSentenceText "Discrete changes in the rat caecal and hippocampal metabolome were also evident." ;
                                                                             rdfs:label "sentence_37849234_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37849234_8
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37849234_8> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37849234> ;
                                                                             gutprop:hasSentenceText "As hippocampal neurogenesis cannot be measured in living humans but is modulated by the circulatory systemic environment, we assessed the impact of the Alzheimer's systemic environment on proxy neurogenesis readouts." ;
                                                                             rdfs:label "sentence_37849234_8" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37849234_9
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37849234_9> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37849234> ;
                                                                             gutprop:hasSentenceText "Serum from Alzheimer's patients decreased neurogenesis in human cells in vitro and were associated with cognitive scores and key microbial genera." ;
                                                                             rdfs:label "sentence_37849234_9" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37881577_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37881577_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/37881577> ;
                                                                             gutprop:hasSentenceText "Repeated Social Defeat Stress Induces an Inflammatory Gut Milieu by Altering the Mucosal Barrier Integrity and Gut Microbiota Homeostasis." ;
                                                                             rdfs:label "sentence_37881577_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37881577_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37881577_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37881577> ;
                                                                             gutprop:hasSentenceText "Posttraumatic stress disorder (PTSD) is a mental health condition triggered by exposure to traumatic events in an individual's life." ;
                                                                             rdfs:label "sentence_37881577_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37881577_10
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37881577_10> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37881577> ;
                                                                              gutprop:hasSentenceText "The RSDS mice further showed significant dysregulation of gut barrier functions, including transepithelial electrical resistance, mucin homeostasis, and antimicrobial responses." ;
                                                                              rdfs:label "sentence_37881577_10" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37881577_11
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37881577_11> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37881577> ;
                                                                              gutprop:hasSentenceText "RSDS mice also showed a specific increase in intestinal expression of claudin-2, a tight junction protein, and epinephrine, a stress-induced neurotransmitter." ;
                                                                              rdfs:label "sentence_37881577_11" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37881577_12
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37881577_12> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37881577> ;
                                                                              gutprop:hasSentenceText "Treating intestinal epithelial cells or 3-dimensional cultured crypts with norepinephrine or intestinal luminal contents (fecal contents) upregulated claudin-2 expression and inhibited transepithelial electrical resistance." ;
                                                                              rdfs:label "sentence_37881577_12" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37881577_13
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37881577_13> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37881577> ;
                                                                              gutprop:hasSentenceText "Traumatic stress induces dysregulation of gut barrier functions, which may underlie the observed gut microbiota changes and proinflammatory gut milieu, all of which may have an interdependent effect on the health and increased risk of comorbidities in patients with PTSD." ;
                                                                              rdfs:label "sentence_37881577_13" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37881577_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37881577_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37881577> ;
                                                                             gutprop:hasSentenceText "Patients with PTSD are also at a higher risk for comorbidities." ;
                                                                             rdfs:label "sentence_37881577_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37881577_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37881577_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37881577> ;
                                                                             gutprop:hasSentenceText "However, it is not well understood how PTSD affects human health and/or promotes the risk for comorbidities." ;
                                                                             rdfs:label "sentence_37881577_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37881577_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37881577_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37881577> ;
                                                                             gutprop:hasSentenceText "Nevertheless, patients with PTSD harbor a proinflammatory milieu and dysbiotic gut microbiota." ;
                                                                             rdfs:label "sentence_37881577_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37881577_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37881577_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37881577> ;
                                                                             gutprop:hasSentenceText "Gut barrier integrity helps to maintain normal gut homeostasis and its dysregulation promotes gut dysbiosis and inflammation." ;
                                                                             rdfs:label "sentence_37881577_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37881577_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37881577_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37881577> ;
                                                                             gutprop:hasSentenceText "We used a mouse model of repeated social defeat stress (RSDS), a preclinical model of PTSD." ;
                                                                             rdfs:label "sentence_37881577_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37881577_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37881577_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37881577> ;
                                                                             gutprop:hasSentenceText "Behavioral studies, metagenomics analysis of the microbiome, gut permeability assay (on mouse colon, using an Ussing chamber), immunoblotting, and immunohistochemical analyses were performed." ;
                                                                             rdfs:label "sentence_37881577_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37881577_8
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37881577_8> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37881577> ;
                                                                             gutprop:hasSentenceText "Polarized intestinal epithelial cells and 3-dimensional crypt cultures were used for mechanistic analysis." ;
                                                                             rdfs:label "sentence_37881577_8" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37881577_9
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37881577_9> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37881577> ;
                                                                             gutprop:hasSentenceText "The RSDS mice harbor a heightened proinflammatory gut environment and microbiota dysbiosis." ;
                                                                             rdfs:label "sentence_37881577_9" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37900921_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37900921_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/37900921> ;
                                                                             gutprop:hasSentenceText "4-Ethylphenol-fluxes, metabolism and excretion of a gut microbiome derived neuromodulator implicated in autism." ;
                                                                             rdfs:label "sentence_37900921_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37900921_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37900921_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37900921> ;
                                                                             gutprop:hasSentenceText "Gut-microbiome-derived metabolites, such as 4-Ethylphenol [4EP], have been shown to modulate neurological health and function." ;
                                                                             rdfs:label "sentence_37900921_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37900921_10
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37900921_10> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37900921> ;
                                                                              gutprop:hasSentenceText "We conclude that future research should focus on physical (e.g., ingestion of sorbents) or metabolic mechanisms (e.g., conversion to 4EP-glucuronide) that are capable of being used as interventions to reduce the flux of 4EP from the gut into the body, increase the efflux of 4EP and/or 4EPS from the brain, or increase excretion from the kidneys as a means of addressing the neurological impacts of 4EP." ;
                                                                              rdfs:label "sentence_37900921_10" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37900921_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37900921_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37900921> ;
                                                                             gutprop:hasSentenceText "Although the source of such metabolites is becoming better understood, knowledge gaps remain as to the mechanisms by which they enter host circulation, how they are transported in the body, how they are metabolised and excreted, and the way they exert their effects." ;
                                                                             rdfs:label "sentence_37900921_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37900921_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37900921_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37900921> ;
                                                                             gutprop:hasSentenceText "High blood concentrations of host-modified 4EP, 4-ethylphenol sulfate [4EPS], are associated with an anxiety phenotype in autistic individuals." ;
                                                                             rdfs:label "sentence_37900921_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37900921_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37900921_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37900921> ;
                                                                             gutprop:hasSentenceText "We have reviewed the existing literature and discuss mechanisms that are proposed to contribute influx from the gut microbiome, metabolism, and excretion of 4EP." ;
                                                                             rdfs:label "sentence_37900921_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37900921_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37900921_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37900921> ;
                                                                             gutprop:hasSentenceText "We note that increased intestinal permeability is common in autistic individuals, potentially explaining increased flux of 4EP and/or 4EPS across the gut epithelium and the Blood Brain Barrier [BBB]." ;
                                                                             rdfs:label "sentence_37900921_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37900921_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37900921_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37900921> ;
                                                                             gutprop:hasSentenceText "Similarly, kidney dysfunction, another complication observed in autistic individuals, impacts clearance of 4EP and its derivatives from circulation." ;
                                                                             rdfs:label "sentence_37900921_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37900921_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37900921_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37900921> ;
                                                                             gutprop:hasSentenceText "Evidence indicates that accumulation of 4EPS in the brain of mice affects connectivity between subregions, particularly those linked to anxiety." ;
                                                                             rdfs:label "sentence_37900921_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37900921_8
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37900921_8> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37900921> ;
                                                                             gutprop:hasSentenceText "However, we found no data on the presence or quantity of 4EP and/or 4EPS in human brains, irrespective of neurological status, likely due to challenges sampling this organ." ;
                                                                             rdfs:label "sentence_37900921_8" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37900921_9
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37900921_9> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37900921> ;
                                                                             gutprop:hasSentenceText "We argue that the penetrative ability of 4EP is dependent on its form at the BBB and its physicochemical similarity to endogenous metabolites with dedicated active transport mechanisms across the BBB." ;
                                                                             rdfs:label "sentence_37900921_9" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37927130_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37927130_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/37927130> ;
                                                                             gutprop:hasSentenceText "<i>Lactobacillus reuteri</i> ATG-F4 Alleviates Chronic Stress-induced Anhedonia by Modulating the Prefrontal Serotonergic System." ;
                                                                             rdfs:label "sentence_37927130_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37927130_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37927130_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37927130> ;
                                                                             gutprop:hasSentenceText "Mental health is influenced by the gut-brain axis; for example, gut dysbiosis has been observed in patients with major depressive disorder (MDD)." ;
                                                                             rdfs:label "sentence_37927130_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37927130_10
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37927130_10> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37927130> ;
                                                                              gutprop:hasSentenceText "We further demonstrated the role of <i>Htr1a</i> using AAV-shRNA to downregulate <i>Htr1a</i> in the mPFC of CUS mice, effectively reversing CUS-induced anhedonic behavior." ;
                                                                              rdfs:label "sentence_37927130_10" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37927130_11
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37927130_11> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37927130> ;
                                                                              gutprop:hasSentenceText "Together, our findings suggest F4 as a potential therapeutic approach for relieving some depressive symptoms and highlight the involvement of the tryptophan metabolism in mitigating CUS-induced depressive-like behaviors through the action of this bacterium." ;
                                                                              rdfs:label "sentence_37927130_11" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37927130_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37927130_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37927130> ;
                                                                             gutprop:hasSentenceText "Gut microbial changes by fecal microbiota transplantation or probiotics treatment reportedly modulates depressive symptoms." ;
                                                                             rdfs:label "sentence_37927130_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37927130_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37927130_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37927130> ;
                                                                             gutprop:hasSentenceText "However, it remains unclear how gut dysbiosis contributes to mental dysfunction, and how correction of the gut microbiota alleviates neuropsychiatric disorders." ;
                                                                             rdfs:label "sentence_37927130_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37927130_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37927130_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37927130> ;
                                                                             gutprop:hasSentenceText "Our previous study showed that chronic consumption of <i>Lactobacillus reuteri</i> ATG-F4 (F4) induced neurometabolic alterations in healthy mice." ;
                                                                             rdfs:label "sentence_37927130_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37927130_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37927130_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37927130> ;
                                                                             gutprop:hasSentenceText "Here, we investigated whether F4 exerted therapeutic effects on depressive-like behavior by influencing the central nervous system." ;
                                                                             rdfs:label "sentence_37927130_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37927130_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37927130_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37927130> ;
                                                                             gutprop:hasSentenceText "Using chronic unpredictable stress (CUS) to induce anhedonia, a key symptom of MDD, we found that chronic F4 consumption alleviated CUS-induced anhedonic behaviors, accompanied by biochemical changes in the gut, serum, and brain." ;
                                                                             rdfs:label "sentence_37927130_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37927130_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37927130_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37927130> ;
                                                                             gutprop:hasSentenceText "Serum and brain metabolite concentrations involved in tryptophan metabolism were regulated by CUS and F4." ;
                                                                             rdfs:label "sentence_37927130_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37927130_8
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37927130_8> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37927130> ;
                                                                             gutprop:hasSentenceText "F4 consumption reduced the elevated levels of serotonin (5-HT) in the brain observed in the CUS group." ;
                                                                             rdfs:label "sentence_37927130_8" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37927130_9
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37927130_9> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37927130> ;
                                                                             gutprop:hasSentenceText "Additionally, the increased expression of <i>Htr1a</i>, a subtype of the 5-HT receptor, in the medial prefrontal cortex (mPFC) of stressed mice was restored to levels observed in stress-naïve mice following F4 supplementation." ;
                                                                             rdfs:label "sentence_37927130_9" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37960197_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37960197_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/37960197> ;
                                                                             gutprop:hasSentenceText "Causality Investigation between Gut Microbiota, Derived Metabolites, and Obstructive Sleep Apnea: A Bidirectional Mendelian Randomization Study." ;
                                                                             rdfs:label "sentence_37960197_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37960197_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37960197_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37960197> ;
                                                                             gutprop:hasSentenceText "Various studies have highlighted the important associations between obstructive sleep apnea (OSA) and gut microbiota and related metabolites." ;
                                                                             rdfs:label "sentence_37960197_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37960197_10
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37960197_10> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37960197> ;
                                                                              gutprop:hasSentenceText "Moreover, the reverse MR analysis demonstrated a suggestive association between OSA exposure and six microbiota taxa." ;
                                                                              rdfs:label "sentence_37960197_10" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37960197_11
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37960197_11> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37960197> ;
                                                                              gutprop:hasSentenceText "This study offers compelling evidence regarding the potential beneficial or detrimental causative impact of the gut microbiota and its associated metabolites on OSA risk, thereby providing new insights into the mechanisms of gut microbiome-mediated OSA development." ;
                                                                              rdfs:label "sentence_37960197_11" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37960197_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37960197_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37960197> ;
                                                                             gutprop:hasSentenceText "Nevertheless, the establishment of causal relationships between these associations remains to be determined." ;
                                                                             rdfs:label "sentence_37960197_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37960197_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37960197_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37960197> ;
                                                                             gutprop:hasSentenceText "Multiple mendelian randomization (MR) analyses were performed to genetically predict the causative impact of 196 gut microbiota and 83 metabolites on OSA." ;
                                                                             rdfs:label "sentence_37960197_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37960197_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37960197_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37960197> ;
                                                                             gutprop:hasSentenceText "Two-sample MR was used to assess the potential association, and causality was evaluated using inverse variance weighted (IVW), MR-Egger, and weighted median (WM) methods." ;
                                                                             rdfs:label "sentence_37960197_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37960197_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37960197_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37960197> ;
                                                                             gutprop:hasSentenceText "Multivariable MR (MVMR) was employed to ascertain the causal independence between gut microbiota and the metabolites linked to OSA." ;
                                                                             rdfs:label "sentence_37960197_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37960197_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37960197_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37960197> ;
                                                                             gutprop:hasSentenceText "Additionally, Cochran's Q test, the MR Egger intercept test and the MR Steiger test were used for the sensitivity analyses." ;
                                                                             rdfs:label "sentence_37960197_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37960197_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37960197_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37960197> ;
                                                                             gutprop:hasSentenceText "The analysis of the 196 gut microbiota revealed that <i>genus</i>_<i>Ruminococcaceae</i> (<i>UCG009</i>) (P<sub>IVW</sub> = 0.010) and <i>genus</i>_<i>Subdoligranulum</i> (P<sub>IVW</sub> = 0.041) were associated with an increased risk of OSA onset." ;
                                                                             rdfs:label "sentence_37960197_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37960197_8
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37960197_8> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37960197> ;
                                                                             gutprop:hasSentenceText "Conversely, <i>Family</i>_<i>Ruminococcaceae</i> (P<sub>IVW</sub> = 0.030), <i>genus</i>_<i>Coprococcus2</i> (P<sub>WM</sub> = 0.025), <i>genus</i>_<i>Eggerthella</i> (P<sub>IVW</sub> = 0.011), and <i>genus</i>_<i>Eubacterium</i> (<i>xylanophilum</i>_<i>group</i>) (P<sub>IVW</sub> = 0.001) were negatively related to the risk of OSA." ;
                                                                             rdfs:label "sentence_37960197_8" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37960197_9
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37960197_9> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37960197> ;
                                                                             gutprop:hasSentenceText "Among the 83 metabolites evaluated, 3-dehydrocarnitine, epiandrosterone sulfate, and leucine were determined to be potential independent risk factors associated with OSA." ;
                                                                             rdfs:label "sentence_37960197_9" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37978477_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37978477_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/37978477> ;
                                                                             gutprop:hasSentenceText "Intricate role of intestinal microbe and metabolite in schizophrenia." ;
                                                                             rdfs:label "sentence_37978477_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37978477_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37978477_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37978477> ;
                                                                             gutprop:hasSentenceText "The brain-gut axis has gained increasing attention due to its contribution to the etiology of various central nervous system disorders." ;
                                                                             rdfs:label "sentence_37978477_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37978477_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37978477_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37978477> ;
                                                                             gutprop:hasSentenceText "This study aims to elucidate the hypothesis that schizophrenia is associated with disturbances in intestinal microflora and imbalance in intestinal metabolites." ;
                                                                             rdfs:label "sentence_37978477_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37978477_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37978477_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37978477> ;
                                                                             gutprop:hasSentenceText "By exploring the intricate relationship between the gut and the brain, with the goal of offering fresh perspectives and valuable insights into the potential contribution of intestinal microbial and metabolites dysbiosis to the etiology of schizophrenia." ;
                                                                             rdfs:label "sentence_37978477_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37978477_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37978477_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37978477> ;
                                                                             gutprop:hasSentenceText "In this study, we used a 16S ribosomal RNA (16S rRNA) gene sequence-based approach and an untargeted liquid chromatography-mass spectrometry-based metabolic profiling approach to measure the gut microbiome and microbial metabolites from 44 healthy controls, 41 acute patients, and 39 remission patients, to evaluate whether microbial dysbiosis and microbial metabolite biomarkers were linked with the severity of schizophrenic symptoms." ;
                                                                             rdfs:label "sentence_37978477_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37978477_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37978477_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37978477> ;
                                                                             gutprop:hasSentenceText "Here, we identified 20 dominant disturbances in the gut microbial composition of patients compared with healthy controls, with 3 orders, 4 families, 9 genera, and 4 species." ;
                                                                             rdfs:label "sentence_37978477_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37978477_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37978477_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37978477> ;
                                                                             gutprop:hasSentenceText "Several unique bacterial taxa associated with schizophrenia severity." ;
                                                                             rdfs:label "sentence_37978477_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37978477_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37978477_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37978477> ;
                                                                             gutprop:hasSentenceText "Compared with healthy controls, 145 unusual microflora metabolites were detected in the acute and remission groups, which were mainly involved in environmental information processing, metabolism, organismal systems, and human diseases in the Kyoto encyclopedia of genes and genomes pathway." ;
                                                                             rdfs:label "sentence_37978477_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37978477_8
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37978477_8> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37978477> ;
                                                                             gutprop:hasSentenceText "The Sankey diagram showed that 4 abnormal intestinal and 4 anomalous intestinal microbial metabolites were associated with psychiatric clinical symptoms." ;
                                                                             rdfs:label "sentence_37978477_8" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37978477_9
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37978477_9> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37978477> ;
                                                                             gutprop:hasSentenceText "These findings suggest a possible interactive influence of the gut microbiota and their metabolites on the pathophysiology of schizophrenia." ;
                                                                             rdfs:label "sentence_37978477_9" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37995075_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37995075_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/37995075> ;
                                                                             gutprop:hasSentenceText "Microbiota Alters and Its Correlation with Molecular Regulation Underlying Depression in PCOS Patients." ;
                                                                             rdfs:label "sentence_37995075_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37995075_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37995075_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37995075> ;
                                                                             gutprop:hasSentenceText "Depression is one of the complications in patients with polycystic ovary syndrome (PCOS) that leads to considerable mental health." ;
                                                                             rdfs:label "sentence_37995075_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37995075_10
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37995075_10> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37995075> ;
                                                                              gutprop:hasSentenceText "Intriguingly, genes correlated with the gut microbiota were found to be significantly enriched in pathways of neurodegenerative diseases and the immune system, suggesting that changes in the microbiota may have a systemic impact on the expression of neurodegenerative diseases and immune genes." ;
                                                                              rdfs:label "sentence_37995075_10" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37995075_11
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37995075_11> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37995075> ;
                                                                              gutprop:hasSentenceText "Gut microbe-related DEGs of CREB3L3 and CCDC173 were possible molecular biomarkers and therapeutic targets of women with PCOS-DP." ;
                                                                              rdfs:label "sentence_37995075_11" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37995075_12
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37995075_12> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37995075> ;
                                                                              gutprop:hasSentenceText "Our multi-omics data indicate shifts in the gut microbiome and host gene regulation in PCOS patients with depression, which is of possible etiological and diagnostic importance." ;
                                                                              rdfs:label "sentence_37995075_12" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37995075_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37995075_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37995075> ;
                                                                             gutprop:hasSentenceText "Accumulating evidence suggests that human gut microbiomes are associated with the progression of PCOS and depression." ;
                                                                             rdfs:label "sentence_37995075_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37995075_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37995075_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37995075> ;
                                                                             gutprop:hasSentenceText "However, whether microbiota influences depression development in PCOS patients is still uncharacterized." ;
                                                                             rdfs:label "sentence_37995075_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37995075_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37995075_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37995075> ;
                                                                             gutprop:hasSentenceText "In this study, we employed metagenomic sequencing and transcriptome sequencing (RNA-seq) to profile the composition of the fecal microbiota and gene expression of peripheral blood mononuclear cells in depressed women with PCOS (PCOS-DP, n = 27) in comparison to mentally healthy women with PCOS (PCOS, n = 18) and compared with healthy control (HC, n = 27) and patients with major depressive disorder (MDD, n = 29)." ;
                                                                             rdfs:label "sentence_37995075_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37995075_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37995075_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37995075> ;
                                                                             gutprop:hasSentenceText "Gut microbiota assessment revealed distinct patterns in the relative abundance in the PCOS-DP compared to HC, MDD, and PCOS groups." ;
                                                                             rdfs:label "sentence_37995075_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37995075_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37995075_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37995075> ;
                                                                             gutprop:hasSentenceText "Several gut microbes exhibited uniquely and significantly higher abundance in the PCOS-DP compared to PCOS patients, inducing EC Ruminococcus torques, Coprococcus comes, Megasphaera elsdenii, Acidaminococcus intestini, and Barnesiella viscericola." ;
                                                                             rdfs:label "sentence_37995075_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37995075_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37995075_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37995075> ;
                                                                             gutprop:hasSentenceText "Bacteroides eggerthii was a potential gut microbial biomarker for the PCOS-DP." ;
                                                                             rdfs:label "sentence_37995075_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37995075_8
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37995075_8> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37995075> ;
                                                                             gutprop:hasSentenceText "RNA-seq profiling identified that 35 and 37 genes were significantly elevated and downregulated in the PCOS-DP, respectively." ;
                                                                             rdfs:label "sentence_37995075_8" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37995075_9
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37995075_9> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37995075> ;
                                                                             gutprop:hasSentenceText "The enhanced differential expressed genes (DEGs) in the PCOS-DP were enriched in pathways involved in signal transduction and endocrine and metabolic diseases, whereas several lipid metabolism pathways were downregulated." ;
                                                                             rdfs:label "sentence_37995075_9" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37995475_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37995475_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/37995475> ;
                                                                             gutprop:hasSentenceText "Guardians of Rest?" ;
                                                                             rdfs:label "sentence_37995475_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37995475_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37995475_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37995475> ;
                                                                             gutprop:hasSentenceText "Investigating the gut microbiota in central hypersomnolence disorders." ;
                                                                             rdfs:label "sentence_37995475_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37995475_10
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37995475_10> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37995475> ;
                                                                              gutprop:hasSentenceText "This indicates that the divergence in beta diversity in the narcolepsy type 1 and idiopathic hypersomnia groups did not arise due to sleep disturbances." ;
                                                                              rdfs:label "sentence_37995475_10" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37995475_11
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37995475_11> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37995475> ;
                                                                              gutprop:hasSentenceText "This study implies that using metabolomics and proteomics approaches to study the role of microbiota in sleep disorders might prove beneficial." ;
                                                                              rdfs:label "sentence_37995475_11" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37995475_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37995475_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37995475> ;
                                                                             gutprop:hasSentenceText "In recent years, there has been an increased interest in elucidating the influence of the gut microbiota on sleep physiology." ;
                                                                             rdfs:label "sentence_37995475_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37995475_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37995475_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37995475> ;
                                                                             gutprop:hasSentenceText "The gut microbiota affects the central nervous system by modulating neuronal pathways through the neuroendocrine and immune system, the hypothalamus-pituitary-adrenal axis, and various metabolic pathways." ;
                                                                             rdfs:label "sentence_37995475_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37995475_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37995475_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37995475> ;
                                                                             gutprop:hasSentenceText "The gut microbiota can also influence circadian rhythms." ;
                                                                             rdfs:label "sentence_37995475_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37995475_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37995475_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37995475> ;
                                                                             gutprop:hasSentenceText "In this study, we observed the gut microbiota composition of patients suffering from narcolepsy type 1, narcolepsy type 2, and idiopathic hypersomnia." ;
                                                                             rdfs:label "sentence_37995475_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37995475_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37995475_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37995475> ;
                                                                             gutprop:hasSentenceText "We did not observe any changes in the alpha diversity of the gut microbiota among patient groups and healthy controls." ;
                                                                             rdfs:label "sentence_37995475_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37995475_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37995475_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37995475> ;
                                                                             gutprop:hasSentenceText "We observed changes in beta diversity in accordance with Jaccard dissimilarities between the control group and groups of patients suffering from narcolepsy type 1 and idiopathic hypersomnia." ;
                                                                             rdfs:label "sentence_37995475_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37995475_8
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37995475_8> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37995475> ;
                                                                             gutprop:hasSentenceText "Our results indicate that both these patient groups differ from controls relative to the presence of rare bacterial taxa." ;
                                                                             rdfs:label "sentence_37995475_8" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37995475_9
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37995475_9> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37995475> ;
                                                                             gutprop:hasSentenceText "However, after adjustment for various confounding factors such as BMI, age, and gender, there were no statistical differences among the groups." ;
                                                                             rdfs:label "sentence_37995475_9" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38010793_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38010793_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/38010793> ;
                                                                             gutprop:hasSentenceText "Multi-omics analyses demonstrate the modulating role of gut microbiota on the associations of unbalanced dietary intake with gastrointestinal symptoms in children with autism spectrum disorder." ;
                                                                             rdfs:label "sentence_38010793_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38010793_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38010793_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38010793> ;
                                                                             gutprop:hasSentenceText "Our previous work revealed that unbalanced dietary intake was an important independent factor associated with constipation and gastrointestinal (GI) symptoms in children with autism spectrum disorder (ASD)." ;
                                                                             rdfs:label "sentence_38010793_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38010793_10
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38010793_10> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38010793> ;
                                                                              gutprop:hasSentenceText "Together, the altered microbiota strengthens the relationship between unbalanced dietary intake and GI symptoms." ;
                                                                              rdfs:label "sentence_38010793_10" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38010793_11
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38010793_11> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38010793> ;
                                                                              gutprop:hasSentenceText "Among the altered metabolites, ten metabolites derived from microbiota (<i>Turicibacter</i>, <i>Coprococcus 1</i>, Eggerthellaceae, and <i>Clostridium sp. BR31</i>) were screened out" ;
                                                                              rdfs:label "sentence_38010793_11" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38010793_12
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38010793_12> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38010793> ;
                                                                              gutprop:hasSentenceText "enriched in eight metabolic pathways, and were identified to correlate with constipation and total GI symptoms in ASD children (FDR-corrected P-value <0.25)." ;
                                                                              rdfs:label "sentence_38010793_12" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38010793_13
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38010793_13> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38010793> ;
                                                                              gutprop:hasSentenceText "These metabolomics findings further support the modulating role of gut microbiota on the associations of unbalanced dietary intake with GI symptoms." ;
                                                                              rdfs:label "sentence_38010793_13" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38010793_14
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38010793_14> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38010793> ;
                                                                              gutprop:hasSentenceText "Collectively, our research provides insights into the relationship between diet, the gut microbiota, and GI symptoms in children with ASD." ;
                                                                              rdfs:label "sentence_38010793_14" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38010793_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38010793_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38010793> ;
                                                                             gutprop:hasSentenceText "Growing evidence has shown the alterations in the gut microbiota and gut microbiota-derived metabolites in ASD." ;
                                                                             rdfs:label "sentence_38010793_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38010793_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38010793_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38010793> ;
                                                                             gutprop:hasSentenceText "However, how the altered microbiota might affect the associations between unbalanced diets and GI symptoms in ASD remains unknown." ;
                                                                             rdfs:label "sentence_38010793_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38010793_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38010793_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38010793> ;
                                                                             gutprop:hasSentenceText "We analyzed microbiome and metabolomics data in 90 ASD and 90 typically developing (TD) children based on 16S rRNA and untargeted metabolomics, together with dietary intake and GI symptoms assessment." ;
                                                                             rdfs:label "sentence_38010793_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38010793_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38010793_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38010793> ;
                                                                             gutprop:hasSentenceText "We found that there existed 11 altered gut microbiota (FDR-corrected P-value <0.05) and 397 altered metabolites (P-value <0.05) in children with ASD compared with TD children." ;
                                                                             rdfs:label "sentence_38010793_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38010793_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38010793_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38010793> ;
                                                                             gutprop:hasSentenceText "Among the 11 altered microbiota, the <i>Turicibacter</i>, <i>Coprococcus 1</i>, and <i>Lachnospiraceae FCS020 group</i> were positively correlated with constipation (FDR-corrected P-value <0.25)." ;
                                                                             rdfs:label "sentence_38010793_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38010793_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38010793_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38010793> ;
                                                                             gutprop:hasSentenceText "The Eggerthellaceae was positively correlated with total GI symptoms (FDR-corrected P-value <0.25)." ;
                                                                             rdfs:label "sentence_38010793_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38010793_8
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38010793_8> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38010793> ;
                                                                             gutprop:hasSentenceText "More importantly, three increased microbiota including <i>Turicibacter</i>, <i>Coprococcus 1</i>, and Eggerthellaceae positively modulated the associations of unbalanced dietary intake with constipation and total GI symptoms, and the decreased <i>Clostridium sp. BR31</i>" ;
                                                                             rdfs:label "sentence_38010793_8" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38010793_9
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38010793_9> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38010793> ;
                                                                             gutprop:hasSentenceText "BR31</i> negatively modulated their associations in ASD children (P-value <0.05)." ;
                                                                             rdfs:label "sentence_38010793_9" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38011787_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38011787_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/38011787> ;
                                                                             gutprop:hasSentenceText "Cryptotanshinone regulates gut microbiota and PI3K-AKT pathway in rats to alleviate CUMS induced depressive symptoms." ;
                                                                             rdfs:label "sentence_38011787_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38011787_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38011787_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38011787> ;
                                                                             gutprop:hasSentenceText "Cryptotanshinone (CPT), a bioactive compound derived from the traditional Chinese herb Salvia miltiorrhiza, exhibits promising antidepressant properties." ;
                                                                             rdfs:label "sentence_38011787_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38011787_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38011787_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38011787> ;
                                                                             gutprop:hasSentenceText "Employing a rat model subjected to Chronic Unpredictable Mild Stress (CUMS), behavioral analyses (open field experiment, elevated cross maze experiment, sugar water preference experiment, forced swimming experiment) and inflammatory factor assessments were conducted to assess the efficacy of CPT in alleviating depressive symptoms and inflammatory responses induced by CUMS." ;
                                                                             rdfs:label "sentence_38011787_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38011787_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38011787_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38011787> ;
                                                                             gutprop:hasSentenceText "Moreover, 16 S rDNA analysis revealed alterations in the gut microbiota of rats exposed to both CUMS and CPT administration." ;
                                                                             rdfs:label "sentence_38011787_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38011787_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38011787_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38011787> ;
                                                                             gutprop:hasSentenceText "Notably, CPT administration was found to mitigate harmful bacterial shifts associated with depression." ;
                                                                             rdfs:label "sentence_38011787_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38011787_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38011787_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38011787> ;
                                                                             gutprop:hasSentenceText "Preliminary exploration of the molecular mechanism underlying CPT's antidepressant effects via transcriptomics analysis and molecular docking indicated that CPT might exert its influence by regulating the PI3K-AKT pathway." ;
                                                                             rdfs:label "sentence_38011787_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38011787_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38011787_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38011787> ;
                                                                             gutprop:hasSentenceText "This study sheds light on the potential therapeutic role of CPT in managing depressive disorders, offering a comprehensive understanding of its impact on behavior, inflammation, gut microbiota, and molecular pathways." ;
                                                                             rdfs:label "sentence_38011787_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38026003_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38026003_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/38026003> ;
                                                                             gutprop:hasSentenceText "The importance of the intestinal microbiota in humans and dogs in the neonatal period." ;
                                                                             rdfs:label "sentence_38026003_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38026003_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38026003_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38026003> ;
                                                                             gutprop:hasSentenceText "The neonatal period represents a critical stage for the establishment and development of the gut microbiota, which profoundly influences the future health trajectory of individuals." ;
                                                                             rdfs:label "sentence_38026003_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38026003_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38026003_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38026003> ;
                                                                             gutprop:hasSentenceText "This review examines the importance of intestinal microbiota in humans and dogs, aiming to elucidate the distinct characteristics and variations in the composition between these two species." ;
                                                                             rdfs:label "sentence_38026003_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38026003_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38026003_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38026003> ;
                                                                             gutprop:hasSentenceText "In humans, the intestinal microbiota contributes to several crucial physiological processes, including digestion, nutrient absorption, immune system development, and modulation of host metabolism." ;
                                                                             rdfs:label "sentence_38026003_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38026003_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38026003_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38026003> ;
                                                                             gutprop:hasSentenceText "Dysbiosis, an imbalance or disruption of the gut microbial community, has been linked to various disorders, such as inflammatory bowel disease, obesity, and even neurological conditions." ;
                                                                             rdfs:label "sentence_38026003_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38026003_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38026003_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38026003> ;
                                                                             gutprop:hasSentenceText "Furthermore, recent research has unveiled the profound influence of the gut-brain axis, emphasizing the bidirectional communication between the gut microbiota and the central nervous system, impacting cognitive function and mental health." ;
                                                                             rdfs:label "sentence_38026003_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38026003_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38026003_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38026003> ;
                                                                             gutprop:hasSentenceText "Similarly, alterations in the canine intestinal microbiota have been associated with gastrointestinal disorders, including chronic enteropathy, such as inflammatory bowel disease, food allergies, and ulcerative histiocytic colitis." ;
                                                                             rdfs:label "sentence_38026003_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38026003_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38026003_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38026003> ;
                                                                             gutprop:hasSentenceText "However, our understanding of the intricacies and functional significance of the intestinal microbiota in dogs remains limited." ;
                                                                             rdfs:label "sentence_38026003_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38026003_8
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38026003_8> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38026003> ;
                                                                             gutprop:hasSentenceText "Understanding the complex dynamics of the intestinal microbiota in both humans and dogs is crucial for devising effective strategies to promote health and manage disease." ;
                                                                             rdfs:label "sentence_38026003_8" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38026003_9
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38026003_9> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38026003> ;
                                                                             gutprop:hasSentenceText "Moreover, exploring the similarities and differences in the gut microbial composition between these two species can facilitate translational research, potentially leading to innovative therapeutic interventions and strategies to enhance the well-being of both humans and dogs." ;
                                                                             rdfs:label "sentence_38026003_9" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38045924_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38045924_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/38045924> ;
                                                                             gutprop:hasSentenceText "Microbiota-gut-brain axis and ketogenic diet: how close are we to tackling epilepsy?" ;
                                                                             rdfs:label "sentence_38045924_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38045924_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38045924_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38045924> ;
                                                                             gutprop:hasSentenceText "The microbiota-gut-brain axis refers to the intricate bidirectional communication between commensal microorganisms residing in the digestive tract and the central nervous system, along neuroendocrine, metabolic, immune, and inflammatory pathways." ;
                                                                             rdfs:label "sentence_38045924_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38045924_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38045924_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38045924> ;
                                                                             gutprop:hasSentenceText "This axis has been suggested to play a role in several neurological disorders, such as Parkinson's disease, Alzheimer's disease, multiple sclerosis, and epilepsy, paving the way for microbiome-based intervention strategies for the mitigation and treatment of symptoms." ;
                                                                             rdfs:label "sentence_38045924_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38045924_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38045924_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38045924> ;
                                                                             gutprop:hasSentenceText "Epilepsy is a multifaceted neurological condition affecting more than 50 million individuals worldwide, 30% of whom do not respond to conventional pharmacological therapies." ;
                                                                             rdfs:label "sentence_38045924_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38045924_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38045924_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38045924> ;
                                                                             gutprop:hasSentenceText "Among the first-hand microbiota modulation strategies, nutritional interventions represent an easily applicable option in both clinical and home settings." ;
                                                                             rdfs:label "sentence_38045924_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38045924_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38045924_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38045924> ;
                                                                             gutprop:hasSentenceText "In this narrative review, we summarize the mechanisms underlying the microbiota-gut-brain axis involvement in epilepsy, discuss the impact of antiepileptic drugs on the gut microbiome, and then the impact of a particular dietary pattern, the ketogenic diet, on the microbiota-gut-brain axis in epileptic patients." ;
                                                                             rdfs:label "sentence_38045924_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38045924_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38045924_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38045924> ;
                                                                             gutprop:hasSentenceText "The investigation of the microbiota response to non-pharmacological therapies is an ever-expanding field with the potential to allow the design of increasingly accessible and successful intervention strategies." ;
                                                                             rdfs:label "sentence_38045924_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38068763_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38068763_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/38068763> ;
                                                                             gutprop:hasSentenceText "Analysis of the Efficacy of Diet and Short-Term Probiotic Intervention on Depressive Symptoms in Patients after Bariatric Surgery: A Randomized Double-Blind Placebo Controlled Pilot Study." ;
                                                                             rdfs:label "sentence_38068763_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38068763_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38068763_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38068763> ;
                                                                             gutprop:hasSentenceText "(1) Background: studies have shown that some patients experience mental deterioration after bariatric surgery." ;
                                                                             rdfs:label "sentence_38068763_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38068763_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38068763_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38068763> ;
                                                                             gutprop:hasSentenceText "(2) Methods: We examined whether the use of probiotics and improved eating habits can improve the mental health of people who suffered from mood disorders after bariatric surgery." ;
                                                                             rdfs:label "sentence_38068763_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38068763_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38068763_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38068763> ;
                                                                             gutprop:hasSentenceText "We also analyzed patients' mental states, eating habits and microbiota." ;
                                                                             rdfs:label "sentence_38068763_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38068763_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38068763_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38068763> ;
                                                                             gutprop:hasSentenceText "(3) Results: Depressive symptoms were observed in 45% of 200 bariatric patients." ;
                                                                             rdfs:label "sentence_38068763_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38068763_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38068763_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38068763> ;
                                                                             gutprop:hasSentenceText "After 5 weeks, we noted an improvement in patients' mental functioning (reduction in BDI and HRSD), but it was not related to the probiotic used." ;
                                                                             rdfs:label "sentence_38068763_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38068763_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38068763_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38068763> ;
                                                                             gutprop:hasSentenceText "The consumption of vegetables and whole grain cereals increased (DQI-I adequacy), the consumption of simple sugars and SFA decreased (moderation DQI-I), and the consumption of monounsaturated fatty acids increased it." ;
                                                                             rdfs:label "sentence_38068763_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38068763_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38068763_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38068763> ;
                                                                             gutprop:hasSentenceText "In the feces of patients after RYGB, there was a significantly higher abundance of two members of the Muribaculaceae family, namely Veillonella and Roseburia, while those after SG had more Christensenellaceae R-7 group, Subdoligranulum, Oscillibacter, and UCG-005." ;
                                                                             rdfs:label "sentence_38068763_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38068763_8
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38068763_8> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38068763> ;
                                                                             gutprop:hasSentenceText "(4) Conclusions: the noted differences in the composition of the gut microbiota (RYGB vs. SG) may be one of the determinants of the proper functioning of the gut-brain microbiota axis, although there is currently a need for further research into this topic using a larger group of patients and different probiotic doses." ;
                                                                             rdfs:label "sentence_38068763_8" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38089822_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38089822_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/38089822> ;
                                                                             gutprop:hasSentenceText "The relationship between gut microbiota and insomnia: a bi-directional two-sample Mendelian randomization research." ;
                                                                             rdfs:label "sentence_38089822_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38089822_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38089822_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38089822> ;
                                                                             gutprop:hasSentenceText "Insomnia is the second most common mental health issue, also is a social and financial burden." ;
                                                                             rdfs:label "sentence_38089822_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38089822_10
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38089822_10> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38089822> ;
                                                                              gutprop:hasSentenceText "Our findings may offer beneficial biomarkers for disease development and prospective candidate treatment targets for insomnia." ;
                                                                              rdfs:label "sentence_38089822_10" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38089822_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38089822_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38089822> ;
                                                                             gutprop:hasSentenceText "Insomnia affects the balance between sleep, the immune system, and the central nervous system, which may raise the risk of different systemic disorders." ;
                                                                             rdfs:label "sentence_38089822_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38089822_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38089822_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38089822> ;
                                                                             gutprop:hasSentenceText "The gut microbiota, referred to as the \"second genome,\" has the ability to control host homeostasis." ;
                                                                             rdfs:label "sentence_38089822_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38089822_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38089822_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38089822> ;
                                                                             gutprop:hasSentenceText "It has been discovered that disruption of the gut-brain axis is linked to insomnia." ;
                                                                             rdfs:label "sentence_38089822_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38089822_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38089822_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38089822> ;
                                                                             gutprop:hasSentenceText "In this study, we conducted MR analysis between large-scale GWAS data of GMs and insomnia to uncover potential associations." ;
                                                                             rdfs:label "sentence_38089822_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38089822_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38089822_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38089822> ;
                                                                             gutprop:hasSentenceText "Ten GM taxa were detected to have causal associations with insomnia." ;
                                                                             rdfs:label "sentence_38089822_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38089822_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38089822_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38089822> ;
                                                                             gutprop:hasSentenceText "Among them, class <i>Negativicutes</i>, genus <i>Clostridiuminnocuumgroup</i>, genus <i>Dorea</i>, genus <i>Lachnoclostridium</i>, genus <i>Prevotella7</i>, and order <i>Selenomonadalesare</i> were linked to a higher risk of insomnia." ;
                                                                             rdfs:label "sentence_38089822_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38089822_8
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38089822_8> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38089822> ;
                                                                             gutprop:hasSentenceText "In reverse MR analysis, we discovered a causal link between insomnia and six other GM taxa." ;
                                                                             rdfs:label "sentence_38089822_8" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38089822_9
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38089822_9> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38089822> ;
                                                                             gutprop:hasSentenceText "It suggested that the relationship between insomnia and intestinal flora was convoluted." ;
                                                                             rdfs:label "sentence_38089822_9" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38123016_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38123016_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/38123016> ;
                                                                             gutprop:hasSentenceText "The many faces of microbiota-gut-brain axis in autism spectrum disorder." ;
                                                                             rdfs:label "sentence_38123016_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38123016_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38123016_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38123016> ;
                                                                             gutprop:hasSentenceText "The gut-brain axis is gaining more attention in neurodevelopmental disorders, especially autism spectrum disorder (ASD)." ;
                                                                             rdfs:label "sentence_38123016_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38123016_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38123016_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38123016> ;
                                                                             gutprop:hasSentenceText "Many factors can influence microbiota in early life, including host genetics and perinatal events (infections, mode of birth/delivery, medications, nutritional supply, and environmental stressors)." ;
                                                                             rdfs:label "sentence_38123016_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38123016_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38123016_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38123016> ;
                                                                             gutprop:hasSentenceText "The gut microbiome can influence blood-brain barrier (BBB) permeability, drug bioavailability, and social behaviors." ;
                                                                             rdfs:label "sentence_38123016_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38123016_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38123016_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38123016> ;
                                                                             gutprop:hasSentenceText "Developing microbiota-based interventions such as probiotics, gastrointestinal (GI) microbiota transplantation, or metabolite supplementation may offer an exciting approach to treating ASD." ;
                                                                             rdfs:label "sentence_38123016_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38123016_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38123016_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38123016> ;
                                                                             gutprop:hasSentenceText "This review highlights that RNA sequencing, metabolomics, and transcriptomics data are needed to understand how microbial modulators can influence ASD pathophysiology." ;
                                                                             rdfs:label "sentence_38123016_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38123016_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38123016_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38123016> ;
                                                                             gutprop:hasSentenceText "Due to the substantial clinical heterogeneity of ASD, medical caretakers may be unlikely to develop a broad and effective general gut microbiota modulator." ;
                                                                             rdfs:label "sentence_38123016_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38123016_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38123016_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38123016> ;
                                                                             gutprop:hasSentenceText "However, dietary modulation followed by administration of microbiota modulators is a promising option for treating ASD-related behavioral and gastrointestinal symptoms." ;
                                                                             rdfs:label "sentence_38123016_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38123016_8
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38123016_8> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38123016> ;
                                                                             gutprop:hasSentenceText "Future work should focus on the accuracy of biomarker tests and developing specific psychobiotic agents tailored towards the gut microbiota seen in ASD patients, which may include developing individualized treatment options." ;
                                                                             rdfs:label "sentence_38123016_8" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38132705_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38132705_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/38132705> ;
                                                                             gutprop:hasSentenceText "Association of homelessness and diet on the gut microbiome: a United States-Veteran Microbiome Project (US-VMP) study." ;
                                                                             rdfs:label "sentence_38132705_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38132705_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38132705_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38132705> ;
                                                                             gutprop:hasSentenceText "Military veterans account for 8% of homeless individuals living in the United States." ;
                                                                             rdfs:label "sentence_38132705_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38132705_10
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38132705_10> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38132705> ;
                                                                              gutprop:hasSentenceText "We analyzed, for the first time, bacterial gut microbiome associations among those with experiences of homelessness on alpha diversity, beta diversity, and taxonomic differences." ;
                                                                              rdfs:label "sentence_38132705_10" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38132705_11
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38132705_11> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38132705> ;
                                                                              gutprop:hasSentenceText "Additionally, we characterized the influences of diet, demographic characteristics, military service history, and mental health conditions on the microbiome of veterans with and without any lifetime history of homelessness." ;
                                                                              rdfs:label "sentence_38132705_11" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38132705_12
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38132705_12> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38132705> ;
                                                                              gutprop:hasSentenceText "Future longitudinal research to evaluate the complex relationships between homelessness, the gut microbiome, and mental health outcomes is recommended." ;
                                                                              rdfs:label "sentence_38132705_12" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38132705_13
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38132705_13> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38132705> ;
                                                                              gutprop:hasSentenceText "Ultimately, differences in the gut microbiome of individuals experiencing and not experiencing homelessness could assist in identification of treatment targets to improve health outcomes." ;
                                                                              rdfs:label "sentence_38132705_13" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38132705_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38132705_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38132705> ;
                                                                             gutprop:hasSentenceText "To highlight associations between history of homelessness and the gut microbiome, we compared the gut microbiome of veterans who reported having a previous experience of homelessness to those from individuals who reported never having experienced a period of homelessness." ;
                                                                             rdfs:label "sentence_38132705_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38132705_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38132705_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38132705> ;
                                                                             gutprop:hasSentenceText "Moreover, we examined the impact of the cumulative exposure of prior and current homelessness to understand possible associations between these experiences and the gut microbiome." ;
                                                                             rdfs:label "sentence_38132705_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38132705_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38132705_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38132705> ;
                                                                             gutprop:hasSentenceText "Microbiome samples underwent genomic sequencing and were analyzed based on alpha diversity, beta diversity, and taxonomic differences." ;
                                                                             rdfs:label "sentence_38132705_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38132705_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38132705_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38132705> ;
                                                                             gutprop:hasSentenceText "Additionally, demographic information, dietary data, and mental health history were collected." ;
                                                                             rdfs:label "sentence_38132705_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38132705_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38132705_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38132705> ;
                                                                             gutprop:hasSentenceText "A lifetime history of homelessness was found to be associated with alcohol use disorder, substance use disorder, and healthy eating index compared to those without such a history." ;
                                                                             rdfs:label "sentence_38132705_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38132705_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38132705_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38132705> ;
                                                                             gutprop:hasSentenceText "In terms of differences in gut microbiota, beta diversity was significantly different between veterans who had experienced homelessness and veterans who had never been homeless (<i>P</i> = 0.047, weighted UniFrac), while alpha diversity was similar." ;
                                                                             rdfs:label "sentence_38132705_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38132705_8
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38132705_8> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38132705> ;
                                                                             gutprop:hasSentenceText "The microbial community differences were, in part, driven by a lower relative abundance of <i>Akkermansia</i> in veterans who had experienced homelessness (mean; range [in percentages], 1.07; 0-33.9) compared to veterans who had never been homeless (2.02; 0-36.8) (<i>P</i> = 0.014, ancom-bc2)." ;
                                                                             rdfs:label "sentence_38132705_8" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38132705_9
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38132705_9> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38132705> ;
                                                                             gutprop:hasSentenceText "Additional research is required to facilitate understanding regarding the complex associations between homelessness, the gut microbiome, and mental and physical health conditions, with a focus on increasing understanding regarding the longitudinal impact of housing instability throughout the lifespan.IMPORTANCEAlthough there are known stressors related to homelessness as well as chronic health conditions experienced by those without stable housing, there has been limited work evaluating the associations between microbial community composition and homelessness." ;
                                                                             rdfs:label "sentence_38132705_9" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38139446_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38139446_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/38139446> ;
                                                                             gutprop:hasSentenceText "A Pilot Interaction Analysis of Gut Microbiota and Peripheral Markers of Aging in Severe Psychiatric Disorders: A Role for <i>Lachnoclostridium</i>?" ;
                                                                             rdfs:label "sentence_38139446_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38139446_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38139446_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38139446> ;
                                                                             gutprop:hasSentenceText "Excessive predominance of pathological species in the gut microbiota could increase the production of inflammatory mediators at the gut level and, via modification of the gut-blood barrier, at the systemic level." ;
                                                                             rdfs:label "sentence_38139446_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38139446_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38139446_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38139446> ;
                                                                             gutprop:hasSentenceText "This pro-inflammatory state could, in turn, increase biological aging that is generally proxied by telomere shortening." ;
                                                                             rdfs:label "sentence_38139446_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38139446_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38139446_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38139446> ;
                                                                             gutprop:hasSentenceText "In this study, we present findings from a secondary interaction analysis of gut microbiota, aging, and inflammatory marker data from a cohort of patients with different diagnoses of severe mental disorders." ;
                                                                             rdfs:label "sentence_38139446_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38139446_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38139446_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38139446> ;
                                                                             gutprop:hasSentenceText "We analyzed 15 controls, 35 patients with schizophrenia (SCZ), and 31 patients with major depressive disorder (MDD) recruited among those attending a community mental health center (50 males and 31 females, mean and median age 46.8 and 46.3 years, respectively)." ;
                                                                             rdfs:label "sentence_38139446_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38139446_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38139446_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38139446> ;
                                                                             gutprop:hasSentenceText "We performed 16S rRNA sequencing as well as measurement of telomere length via quantitative fluorescence in situ hybridization and high-sensitivity C-reactive protein." ;
                                                                             rdfs:label "sentence_38139446_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38139446_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38139446_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38139446> ;
                                                                             gutprop:hasSentenceText "We applied statistical modeling with logistic regression to test for interaction between gut microbiota and these markers." ;
                                                                             rdfs:label "sentence_38139446_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38139446_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38139446_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38139446> ;
                                                                             gutprop:hasSentenceText "Our results showed statistically significant interactions between telomere length and gut microbiota pointing to the genus <i>Lachnostridium</i>, which remained significantly associated with a reduced likelihood of MDD even after adjustment for a series of covariates." ;
                                                                             rdfs:label "sentence_38139446_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38139446_8
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38139446_8> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38139446> ;
                                                                             gutprop:hasSentenceText "Although exploratory, these findings show that specific gut microbiota signatures overexpressing <i>Lachnoclostridium</i> and interacting with biological aging could modulate the liability for MDD." ;
                                                                             rdfs:label "sentence_38139446_8" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38203207_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38203207_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/38203207> ;
                                                                             gutprop:hasSentenceText "Our Mental Health Is Determined by an Intrinsic Interplay between the Central Nervous System, Enteric Nerves, and Gut Microbiota." ;
                                                                             rdfs:label "sentence_38203207_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38203207_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38203207_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38203207> ;
                                                                             gutprop:hasSentenceText "Bacteria in the gut microbiome play an intrinsic part in immune activation, intestinal permeability, enteric reflex, and entero-endocrine signaling." ;
                                                                             rdfs:label "sentence_38203207_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38203207_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38203207_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38203207> ;
                                                                             gutprop:hasSentenceText "The gut microbiota communicates with the central nervous system (CNS) through the production of bile acids, short-chain fatty acids (SCFAs), glutamate (Glu), γ-aminobutyric acid (GABA), dopamine (DA), norepinephrine (NE), serotonin (5-HT), and histamine." ;
                                                                             rdfs:label "sentence_38203207_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38203207_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38203207_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38203207> ;
                                                                             gutprop:hasSentenceText "A vast number of signals generated in the gastrointestinal tract (GIT) reach the brain via afferent fibers of the vagus nerve (VN)." ;
                                                                             rdfs:label "sentence_38203207_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38203207_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38203207_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38203207> ;
                                                                             gutprop:hasSentenceText "Signals from the CNS are returned to entero-epithelial cells (EES) via efferent VN fibers and communicate with 100 to 500 million neurons in the submucosa and myenteric plexus of the gut wall, which is referred to as the enteric nervous system (ENS)." ;
                                                                             rdfs:label "sentence_38203207_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38203207_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38203207_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38203207> ;
                                                                             gutprop:hasSentenceText "Intercommunications between the gut and CNS regulate mood, cognitive behavior, and neuropsychiatric disorders such as autism, depression, and schizophrenia." ;
                                                                             rdfs:label "sentence_38203207_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38203207_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38203207_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38203207> ;
                                                                             gutprop:hasSentenceText "The modulation, development, and renewal of nerves in the ENS and changes in the gut microbiome alter the synthesis and degradation of neurotransmitters, ultimately influencing our mental health." ;
                                                                             rdfs:label "sentence_38203207_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38203207_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38203207_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38203207> ;
                                                                             gutprop:hasSentenceText "The more we decipher the gut microbiome and understand its effect on neurotransmission, the closer we may get to developing novel therapeutic and psychobiotic compounds to improve cognitive functions and prevent mental disorders." ;
                                                                             rdfs:label "sentence_38203207_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38203207_8
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38203207_8> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38203207> ;
                                                                             gutprop:hasSentenceText "In this review, the intricate control of entero-endocrine signaling and immune responses that keep the gut microbiome in a balanced state, and the influence that changing gut bacteria have on neuropsychiatric disorders, are discussed." ;
                                                                             rdfs:label "sentence_38203207_8" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38204948_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38204948_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/38204948> ;
                                                                             gutprop:hasSentenceText "Neuroendocrine, neurotransmitter, and gut microbiota imbalance contributing to potential psychiatric disorder prevalence in polycystic ovarian syndrome." ;
                                                                             rdfs:label "sentence_38204948_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38204948_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38204948_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38204948> ;
                                                                             gutprop:hasSentenceText "Polycystic ovarian syndrome (PCOS) is the most common endocrine disorder in women, affecting up to 15% of reproductive-aged women." ;
                                                                             rdfs:label "sentence_38204948_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38204948_10
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38204948_10> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38204948> ;
                                                                              gutprop:hasSentenceText "In this review, we examine different theories regarding the association between PCOS and psychiatric disorders and point out different areas of research that are needed to broaden our understanding of this association." ;
                                                                              rdfs:label "sentence_38204948_10" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38204948_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38204948_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38204948> ;
                                                                             gutprop:hasSentenceText "Polycystic ovarian syndrome is a heterogeneous disorder, both in the sense that many different factors may play a role in its manifestation and that multiple systems throughout the body can be affected." ;
                                                                             rdfs:label "sentence_38204948_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38204948_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38204948_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38204948> ;
                                                                             gutprop:hasSentenceText "Polycystic ovarian syndrome has been linked to an increased prevalence of various psychiatric disorders, including depression and anxiety." ;
                                                                             rdfs:label "sentence_38204948_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38204948_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38204948_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38204948> ;
                                                                             gutprop:hasSentenceText "Despite the socioeconomic effect that these disorders may have on patients with PCOS and society as a whole, this association is largely lacking in research." ;
                                                                             rdfs:label "sentence_38204948_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38204948_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38204948_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38204948> ;
                                                                             gutprop:hasSentenceText "There are currently several theories regarding the link between PCOS and mental health." ;
                                                                             rdfs:label "sentence_38204948_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38204948_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38204948_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38204948> ;
                                                                             gutprop:hasSentenceText "Some suggest that the overactive hypothalamic-pituitary-ovarian and hypothalamic-pituitary-adrenal axes in PCOS patients may alter the hormonal profile and contribute to the development of psychiatric disorders." ;
                                                                             rdfs:label "sentence_38204948_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38204948_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38204948_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38204948> ;
                                                                             gutprop:hasSentenceText "Other studies speculate that abnormal levels of neurotransmitters and neuronal signaling may play a role." ;
                                                                             rdfs:label "sentence_38204948_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38204948_8
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38204948_8> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38204948> ;
                                                                             gutprop:hasSentenceText "Recently, more research has begun to focus on the gut-brain axis, addressing the nutritional needs of PCOS patients." ;
                                                                             rdfs:label "sentence_38204948_8" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38204948_9
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38204948_9> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38204948> ;
                                                                             gutprop:hasSentenceText "Studies show that dietary factors such as probiotics and micronutrient supplementation may significantly improve psychiatric symptoms in PCOS patients while helping regulate neurotransmitter levels in the body." ;
                                                                             rdfs:label "sentence_38204948_9" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38229613_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38229613_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/38229613> ;
                                                                             gutprop:hasSentenceText "Dysbiosis of the Beneficial Gut Bacteria in Patients with Parkinson's Disease from India." ;
                                                                             rdfs:label "sentence_38229613_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38229613_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38229613_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38229613> ;
                                                                             gutprop:hasSentenceText "Recent advancement in understanding neurological disorders has revealed the involvement of dysbiosis of the gut microbiota in the pathophysiology of Parkinson's disease (PD)." ;
                                                                             rdfs:label "sentence_38229613_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38229613_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38229613_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38229613> ;
                                                                             gutprop:hasSentenceText "We sequenced microbial DNA using fecal samples collected from PD cases and healthy controls (HCs) to evaluate the role of gut microbiota." ;
                                                                             rdfs:label "sentence_38229613_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38229613_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38229613_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38229613> ;
                                                                             gutprop:hasSentenceText "Full-length bacterial 16S rRNA gene sequencing of fecal samples was performed using amplified polymerase chain reaction (PCR) products on the GridION Nanopore sequencer." ;
                                                                             rdfs:label "sentence_38229613_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38229613_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38229613_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38229613> ;
                                                                             gutprop:hasSentenceText "Sequenced data were analyzed using web-based tools BugSeq and MicrobiomeAnalyst." ;
                                                                             rdfs:label "sentence_38229613_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38229613_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38229613_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38229613> ;
                                                                             gutprop:hasSentenceText "We found that certain bacterial families like Clostridia UCG 014, Cristensenellaceae, and Oscillospiraceae are higher in abundance, and Lachinospiracea, Coriobacteriaceae and genera associated with short-chain fatty acid production, <i>Faecalibacterium</i>, <i>Fusicatenibacter</i>, <i>Roseburia</i> and <i>Blautia</i>, are lower in abundance among PD cases when compared with the HC." ;
                                                                             rdfs:label "sentence_38229613_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38229613_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38229613_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38229613> ;
                                                                             gutprop:hasSentenceText "Genus <i>Akkermansia</i>, <i>Dialister</i>, <i>Bacteroides</i>, and <i>Lachnospiraceae NK4A136</i> group positively correlated with constipation in PD." ;
                                                                             rdfs:label "sentence_38229613_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38229613_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38229613_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38229613> ;
                                                                             gutprop:hasSentenceText "Observations from this study support the other global research on the PD gut microbiome background and provide fresh insight into the gut microbial composition of PD patients from a south Indian population." ;
                                                                             rdfs:label "sentence_38229613_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38229613_8
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38229613_8> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38229613> ;
                                                                             gutprop:hasSentenceText "We report a higher abundance of Clostridia UCG 014 group, previously not linked to PD." ;
                                                                             rdfs:label "sentence_38229613_8" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38247868_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38247868_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/38247868> ;
                                                                             gutprop:hasSentenceText "Psychiatric Comorbidities of Inflammatory Bowel Disease: It Is a Matter of Microglia's Gut Feeling." ;
                                                                             rdfs:label "sentence_38247868_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38247868_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38247868_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38247868> ;
                                                                             gutprop:hasSentenceText "Inflammatory bowel disease (IBD), a common term for Crohn's disease and ulcerative colitis, is a chronic, relapse-remitting condition of the gastrointestinal tract that is increasing worldwide." ;
                                                                             rdfs:label "sentence_38247868_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38247868_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38247868_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38247868> ;
                                                                             gutprop:hasSentenceText "Psychiatric comorbidities, including depression and anxiety, are more prevalent in IBD patients than in healthy individuals." ;
                                                                             rdfs:label "sentence_38247868_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38247868_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38247868_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38247868> ;
                                                                             gutprop:hasSentenceText "Evidence suggests that varying levels of neuroinflammation might underlie these states in IBD patients." ;
                                                                             rdfs:label "sentence_38247868_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38247868_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38247868_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38247868> ;
                                                                             gutprop:hasSentenceText "Within this context, microglia are the crucial non-neural cells in the brain responsible for innate immune responses following inflammatory insults." ;
                                                                             rdfs:label "sentence_38247868_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38247868_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38247868_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38247868> ;
                                                                             gutprop:hasSentenceText "Alterations in microglia's functions, such as secretory profile, phagocytic activity, and synaptic pruning, might play significant roles in mediating psychiatric manifestations of IBD." ;
                                                                             rdfs:label "sentence_38247868_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38247868_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38247868_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38247868> ;
                                                                             gutprop:hasSentenceText "In this review, we discuss the role played by microglia in IBD-associated comorbidities." ;
                                                                             rdfs:label "sentence_38247868_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38260914_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38260914_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/38260914> ;
                                                                             gutprop:hasSentenceText "Rosacea, microbiome and probiotics: the gut-skin axis." ;
                                                                             rdfs:label "sentence_38260914_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38260914_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38260914_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38260914> ;
                                                                             gutprop:hasSentenceText "Rosacea is an inflammatory skin disease involving diverse symptoms with a variable clinical progress which can severely impact the patient's quality of life as well as their mental health." ;
                                                                             rdfs:label "sentence_38260914_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38260914_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38260914_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38260914> ;
                                                                             gutprop:hasSentenceText "The pathophysiological model of rosacea involves an unbalanced immune system predisposed to excessive inflammation, in addition to vascular and nervous alterations, being certain cutaneous microorganisms' triggers of the symptoms onset." ;
                                                                             rdfs:label "sentence_38260914_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38260914_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38260914_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38260914> ;
                                                                             gutprop:hasSentenceText "The gut-skin axis explains a bidirectional interaction between skin and gut microbiota in some inflammatory skin diseases such as atopic dermatitis, psoriasis, or rosacea." ;
                                                                             rdfs:label "sentence_38260914_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38260914_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38260914_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38260914> ;
                                                                             gutprop:hasSentenceText "The introduction and consolidation of the next-generation sequencing in recent years has provided unprecedented information about the microbiome." ;
                                                                             rdfs:label "sentence_38260914_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38260914_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38260914_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38260914> ;
                                                                             gutprop:hasSentenceText "However, the characterization of the gut and skin microbiota and the impact of the gut-skin axis in patients with rosacea has been little explored, in contrast to other inflammatory skin diseases such as atopic dermatitis or psoriasis." ;
                                                                             rdfs:label "sentence_38260914_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38260914_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38260914_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38260914> ;
                                                                             gutprop:hasSentenceText "Furthermore, the clinical evolution of patients with rosacea is not always adequate and it is common for them to present a sustained symptomatology with frequent flare-ups." ;
                                                                             rdfs:label "sentence_38260914_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38260914_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38260914_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38260914> ;
                                                                             gutprop:hasSentenceText "In this context, probiotic supplementation could improve the clinical evolution of these patients as happens in other pathologies." ;
                                                                             rdfs:label "sentence_38260914_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38260914_8
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38260914_8> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38260914> ;
                                                                             gutprop:hasSentenceText "Through this review we aim to establish and compile the basics and directions of current knowledge to understand the mechanisms by which the microbiome influences the pathogenesis of rosacea, and how modulation of the skin and gut microbiota could benefit these patients." ;
                                                                             rdfs:label "sentence_38260914_8" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38278499_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38278499_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/38278499> ;
                                                                             gutprop:hasSentenceText "Alcohol use-associated alterations in the circulating metabolite profile in the general population and in individuals with major depressive disorder." ;
                                                                             rdfs:label "sentence_38278499_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38278499_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38278499_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38278499> ;
                                                                             gutprop:hasSentenceText "Our aim was to evaluate whether alcohol use is associated with changes in the circulating metabolite profile similar to those present in persons with depression." ;
                                                                             rdfs:label "sentence_38278499_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38278499_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38278499_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38278499> ;
                                                                             gutprop:hasSentenceText "If so, these findings could partially explain the link between alcohol use and depression." ;
                                                                             rdfs:label "sentence_38278499_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38278499_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38278499_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38278499> ;
                                                                             gutprop:hasSentenceText "We applied a targeted liquid chromatography mass spectrometry method to evaluate correlates between concentrations of 86 circulating metabolites and self-reported alcohol use in a cohort of the non-depressed general population (GP) (n = 247) and a cohort of individuals with major depressive disorder (MDD) (n = 99)." ;
                                                                             rdfs:label "sentence_38278499_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38278499_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38278499_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38278499> ;
                                                                             gutprop:hasSentenceText "Alcohol use was associated with alterations in circulating concentrations of metabolites in both cohorts." ;
                                                                             rdfs:label "sentence_38278499_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38278499_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38278499_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38278499> ;
                                                                             gutprop:hasSentenceText "Our main finding was that self-reported alcohol use was negatively correlated with serum concentrations of hippuric acid in the GP cohort." ;
                                                                             rdfs:label "sentence_38278499_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38278499_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38278499_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38278499> ;
                                                                             gutprop:hasSentenceText "In the GP cohort, consumption of six or more doses per week was associated with low hippuric acid concentrations, similar to those observed in the MDD cohort, but in these individuals it was regardless of their level of alcohol use." ;
                                                                             rdfs:label "sentence_38278499_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38278499_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38278499_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38278499> ;
                                                                             gutprop:hasSentenceText "Reduced serum concentrations of hippuric acid suggest that already-moderate alcohol use is associated with depression-like changes in the serum levels of metabolites associated with gut microbiota and liver function; this may be one possible molecular level link between alcohol use and depression." ;
                                                                             rdfs:label "sentence_38278499_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38283894_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38283894_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/38283894> ;
                                                                             gutprop:hasSentenceText "A comparison between children and adolescents with autism spectrum disorders and healthy controls in biomedical factors, trace elements, and microbiota biomarkers: a meta-analysis." ;
                                                                             rdfs:label "sentence_38283894_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38283894_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38283894_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38283894> ;
                                                                             gutprop:hasSentenceText "Autism spectrum disorder (ASD) is a multifaceted developmental condition that commonly appears during early childhood." ;
                                                                             rdfs:label "sentence_38283894_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38283894_10
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38283894_10> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38283894> ;
                                                                              gutprop:hasSentenceText "The results of the overall analyses were stable after performing the sensitivity analyses." ;
                                                                              rdfs:label "sentence_38283894_10" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38283894_11
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38283894_11> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38283894> ;
                                                                              gutprop:hasSentenceText "Additionally, no substantial publication bias was observed among the studies." ;
                                                                              rdfs:label "sentence_38283894_11" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38283894_12
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38283894_12> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38283894> ;
                                                                              gutprop:hasSentenceText "Children with ASD have significantly higher levels of CRP and GABA, lower levels of oxytocin, iron, and zinc, lower relative abundance of <i>Bifidobacterium</i> and <i>Parabacteroides</i>, and higher relative abundance of <i>Faecalibacterium</i>, <i>Bacteroides,</i> and <i>Clostridium</i> when compared with controls." ;
                                                                              rdfs:label "sentence_38283894_12" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38283894_13
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38283894_13> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38283894> ;
                                                                              gutprop:hasSentenceText "These results suggest that these indicators may be a potential biomarker panel for the diagnosis or determining therapeutic targets of ASD." ;
                                                                              rdfs:label "sentence_38283894_13" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38283894_14
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38283894_14> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38283894> ;
                                                                              gutprop:hasSentenceText "Furthermore, large, sample-based, and randomized controlled trials are needed to confirm these results." ;
                                                                              rdfs:label "sentence_38283894_14" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38283894_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38283894_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38283894> ;
                                                                             gutprop:hasSentenceText "The etiology of ASD remains multifactorial and not yet fully understood." ;
                                                                             rdfs:label "sentence_38283894_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38283894_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38283894_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38283894> ;
                                                                             gutprop:hasSentenceText "The identification of biomarkers may provide insights into the underlying mechanisms and pathophysiology of the disorder." ;
                                                                             rdfs:label "sentence_38283894_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38283894_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38283894_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38283894> ;
                                                                             gutprop:hasSentenceText "The present study aimed to explore the causes of ASD by investigating the key biomedical markers, trace elements, and microbiota factors between children with autism spectrum disorder (ASD) and control subjects." ;
                                                                             rdfs:label "sentence_38283894_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38283894_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38283894_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38283894> ;
                                                                             gutprop:hasSentenceText "Medline, PubMed, ProQuest, EMBASE, Cochrane Library, PsycINFO, Web of Science, and EMBSCO databases have been searched for publications from 2012 to 2023 with no language restrictions using the population, intervention, control, and outcome (PICO) approach." ;
                                                                             rdfs:label "sentence_38283894_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38283894_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38283894_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38283894> ;
                                                                             gutprop:hasSentenceText "Keywords including \"autism spectrum disorder,\" \"oxytocin,\" \"GABA,\" \"Serotonin,\" \"CRP,\" \"IL-6,\" \"Fe,\" \"Zn,\" \"Cu,\" and \"gut microbiota\" were used for the search." ;
                                                                             rdfs:label "sentence_38283894_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38283894_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38283894_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38283894> ;
                                                                             gutprop:hasSentenceText "The Joanna Briggs Institute (JBI) critical appraisal checklist was used to assess the article quality, and a random model was used to assess the mean difference and standardized difference between ASD and the control group in all biomedical markers, trace elements, and microbiota factors." ;
                                                                             rdfs:label "sentence_38283894_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38283894_8
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38283894_8> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38283894> ;
                                                                             gutprop:hasSentenceText "From 76,217 records, 43 studies met the inclusion and exclusion criteria and were included in this meta-analysis." ;
                                                                             rdfs:label "sentence_38283894_8" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38283894_9
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38283894_9> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38283894> ;
                                                                             gutprop:hasSentenceText "The pooled analyses showed that children with ASD had significantly lower levels of oxytocin (mean differences, MD = -45.691, 95% confidence interval, CI: -61.667, -29.717), iron (MD = -3.203, 95% CI: -4.891, -1.514), and zinc (MD = -6.707, 95% CI: -12.691, -0.722), lower relative abundance of <i>Bifidobacterium</i> (MD = -1.321, 95% CI: -2.403, -0.238) and <i>Parabacteroides</i> (MD = -0.081, 95% CI: -0.148, -0.013), higher levels of c-reactive protein, CRP (MD = 0.401, 95% CI: 0.036, 0.772), and GABA (MD = 0.115, 95% CI: 0.045, 0.186), and higher relative abundance of <i>Bacteroides</i> (MD = 1.386, 95% CI: 0.717, 2.055) and <i>Clostridium</i> (MD = 0.281, 95% CI: 0.035, 0.526) when compared with controls." ;
                                                                             rdfs:label "sentence_38283894_9" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38292207_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38292207_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/38292207> ;
                                                                             gutprop:hasSentenceText "Gut-Brain Axis Impact on Canine Anxiety Disorders: New Challenges for Behavioral Veterinary Medicine." ;
                                                                             rdfs:label "sentence_38292207_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38292207_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38292207_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38292207> ;
                                                                             gutprop:hasSentenceText "Anxiety disorders in dogs are ever-growing and represent an important concern in the veterinary behavior field." ;
                                                                             rdfs:label "sentence_38292207_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38292207_10
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38292207_10> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38292207> ;
                                                                              gutprop:hasSentenceText "However, regarding the canine veterinary behavior field, there is still a lack of insightful research on this topic." ;
                                                                              rdfs:label "sentence_38292207_10" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38292207_11
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38292207_11> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38292207> ;
                                                                              gutprop:hasSentenceText "In this review, we explore the few but relevant studies performed on canine anxiety disorders." ;
                                                                              rdfs:label "sentence_38292207_11" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38292207_12
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38292207_12> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38292207> ;
                                                                              gutprop:hasSentenceText "We agree that innovative bacterial therapeutical approaches for canine anxiety disorders will become a promising field of investigation and certainly pave the way for new approaches to these behavioral conditions." ;
                                                                              rdfs:label "sentence_38292207_12" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38292207_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38292207_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38292207> ;
                                                                             gutprop:hasSentenceText "These disorders are often disregarded in veterinary clinical practice, negatively impacting the animal's and owner's quality of life." ;
                                                                             rdfs:label "sentence_38292207_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38292207_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38292207_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38292207> ;
                                                                             gutprop:hasSentenceText "Moreover, these anxiety disorders can potentially result in the abandonment or euthanasia of dogs." ;
                                                                             rdfs:label "sentence_38292207_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38292207_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38292207_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38292207> ;
                                                                             gutprop:hasSentenceText "Growing evidence shows that the gut microbiota is a central player in the gut-brain axis." ;
                                                                             rdfs:label "sentence_38292207_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38292207_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38292207_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38292207> ;
                                                                             gutprop:hasSentenceText "A variety of microorganisms inhabit the intestines of dogs, which are essential in maintaining intestinal homeostasis." ;
                                                                             rdfs:label "sentence_38292207_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38292207_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38292207_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38292207> ;
                                                                             gutprop:hasSentenceText "These microbes can impact mental health through several mechanisms, including metabolic, neural, endocrine, and immune-mediated pathways." ;
                                                                             rdfs:label "sentence_38292207_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38292207_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38292207_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38292207> ;
                                                                             gutprop:hasSentenceText "The disruption of a balanced composition of resident commensal communities, or dysbiosis, is implicated in several pathological conditions, including mental disorders such as anxiety." ;
                                                                             rdfs:label "sentence_38292207_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38292207_8
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38292207_8> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38292207> ;
                                                                             gutprop:hasSentenceText "Studies carried out in rodent models and humans demonstrate that the intestinal microbiota can influence mental health through these mechanisms, including anxiety disorders." ;
                                                                             rdfs:label "sentence_38292207_8" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38292207_9
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38292207_9> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38292207> ;
                                                                             gutprop:hasSentenceText "Furthermore, novel therapeutic strategies using prebiotics and probiotics have been shown to ameliorate anxiety-related symptoms." ;
                                                                             rdfs:label "sentence_38292207_9" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38302874_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38302874_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/38302874> ;
                                                                             gutprop:hasSentenceText "Chronic intestinal pseudo-obstruction: associations with gut microbiota and genes expression of intestinal serotonergic pathway." ;
                                                                             rdfs:label "sentence_38302874_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38302874_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38302874_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38302874> ;
                                                                             gutprop:hasSentenceText "Pediatric chronic intestinal pseudo-obstruction (PIPO) is a rare disease characterized by symptoms and radiological signs suggestive of intestinal obstruction, in the absence of lumen-occluding lesions." ;
                                                                             rdfs:label "sentence_38302874_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38302874_10
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38302874_10> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38302874> ;
                                                                              gutprop:hasSentenceText "The expression of genes implicated in serotoninergic pathway (TPH1, SLC6A4, 5-HTR3 and 5-HTR4) was established by qPCR, and correlations with MAM and clinical parameters of PIPO have been evaluated." ;
                                                                              rdfs:label "sentence_38302874_10" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38302874_11
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38302874_11> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38302874> ;
                                                                              gutprop:hasSentenceText "Our results revealed that PIPO patients exhibit a MAM with a different composition and with dysbiosis, i.e." ;
                                                                              rdfs:label "sentence_38302874_11" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38302874_12
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38302874_12> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38302874> ;
                                                                              gutprop:hasSentenceText "with a lower biodiversity and fewer less connected species with a greater number of non-synergistic relationships, compared to controls." ;
                                                                              rdfs:label "sentence_38302874_12" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38302874_13
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38302874_13> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38302874> ;
                                                                              gutprop:hasSentenceText "qPCR results revealed modifications in the expression of serotonin-related intestinal genes in PIPO patients, when compared to controls." ;
                                                                              rdfs:label "sentence_38302874_13" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38302874_14
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38302874_14> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38302874> ;
                                                                              gutprop:hasSentenceText "Correlation analysis do not reveal any kind of connection." ;
                                                                              rdfs:label "sentence_38302874_14" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38302874_15
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38302874_15> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38302874> ;
                                                                              gutprop:hasSentenceText "For the first time, we report in PIPO patients a specific MAM associated to underlying pathology and an altered intestinal serotonin pathway." ;
                                                                              rdfs:label "sentence_38302874_15" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38302874_16
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38302874_16> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38302874> ;
                                                                              gutprop:hasSentenceText "A possible dysfunction of the serotonin pathway, possibly related to or triggered by an altered microbiota, may contribute to dysmotility in PIPO patients." ;
                                                                              rdfs:label "sentence_38302874_16" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38302874_17
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38302874_17> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38302874> ;
                                                                              gutprop:hasSentenceText "The results of our pilot study provide the basis for new biomarkers and innovative therapies targeting the microbiota or serotonin pathways in PIPO patients." ;
                                                                              rdfs:label "sentence_38302874_17" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38302874_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38302874_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38302874> ;
                                                                             gutprop:hasSentenceText "It results from an extremely severe impairment of propulsive motility." ;
                                                                             rdfs:label "sentence_38302874_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38302874_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38302874_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38302874> ;
                                                                             gutprop:hasSentenceText "The intestinal endocrine system (IES) jointly with the enteric nervous system (ENS) regulates secreto-motor functions via different hormones and bioactive messengers/neurotransmitters." ;
                                                                             rdfs:label "sentence_38302874_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38302874_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38302874_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38302874> ;
                                                                             gutprop:hasSentenceText "The neurotransmitter 5-hydroxytryptamine (5-HT) (or serotonin) is linked to intestinal peristalsis and secretory reflexes." ;
                                                                             rdfs:label "sentence_38302874_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38302874_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38302874_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38302874> ;
                                                                             gutprop:hasSentenceText "Gut microbiota and its interplay with ENS affect 5-HT synthesis, release, and the subsequent serotonin receptor activation." ;
                                                                             rdfs:label "sentence_38302874_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38302874_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38302874_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38302874> ;
                                                                             gutprop:hasSentenceText "To date, the interplay between 5-HT and gut microbiota in PIPO remains largely unclear." ;
                                                                             rdfs:label "sentence_38302874_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38302874_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38302874_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38302874> ;
                                                                             gutprop:hasSentenceText "This study aimed to assess correlations between mucosa associated microbiota (MAM), intestinal serotonin-related genes expression in PIPO." ;
                                                                             rdfs:label "sentence_38302874_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38302874_8
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38302874_8> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38302874> ;
                                                                             gutprop:hasSentenceText "To this purpose, biopsies of the colon, ileum and duodenum have been collected from 7 PIPO patients, and 7 age-/sex-matched healthy controls." ;
                                                                             rdfs:label "sentence_38302874_8" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38302874_9
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38302874_9> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38302874> ;
                                                                             gutprop:hasSentenceText "After DNA extraction, the MAM was assessed by next generation sequencing (NGS) of the V3-V4 region of the bacterial RNA 16 S, on an Illumina Miseq platform." ;
                                                                             rdfs:label "sentence_38302874_9" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38318337_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38318337_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/38318337> ;
                                                                             gutprop:hasSentenceText "Exploring the interplay between running exercises, microbial diversity, and tryptophan metabolism along the microbiota-gut-brain axis." ;
                                                                             rdfs:label "sentence_38318337_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38318337_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38318337_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38318337> ;
                                                                             gutprop:hasSentenceText "The emergent recognition of the gut-brain axis connection has shed light on the role of the microbiota in modulating the gut-brain axis's functions." ;
                                                                             rdfs:label "sentence_38318337_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38318337_10
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38318337_10> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38318337> ;
                                                                              gutprop:hasSentenceText "A. muciniphila</i> indicated their potential contribution to modifying the gut microenvironment and influencing tryptophan transport to the hippocampus and brainstem." ;
                                                                              rdfs:label "sentence_38318337_10" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38318337_11
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38318337_11> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38318337> ;
                                                                              gutprop:hasSentenceText "These findings have potential applications for developing microbiota-based approaches in the context of exercise for neurological diseases, especially on mental health and overall well-being." ;
                                                                              rdfs:label "sentence_38318337_11" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38318337_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38318337_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38318337> ;
                                                                             gutprop:hasSentenceText "Several microbial metabolites, such as serotonin, kynurenine, tryptamine, indole, and their derivatives originating from tryptophan metabolism have been implicated in influencing this axis." ;
                                                                             rdfs:label "sentence_38318337_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38318337_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38318337_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38318337> ;
                                                                             gutprop:hasSentenceText "In our study, we aimed to investigate the impact of running exercises on microbial tryptophan metabolism using a mouse model." ;
                                                                             rdfs:label "sentence_38318337_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38318337_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38318337_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38318337> ;
                                                                             gutprop:hasSentenceText "We conducted a multi-omics analysis to obtain a comprehensive insight into the changes in tryptophan metabolism along the microbiota-gut-brain axis induced by running exercises." ;
                                                                             rdfs:label "sentence_38318337_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38318337_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38318337_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38318337> ;
                                                                             gutprop:hasSentenceText "The analyses integrated multiple components, such as tryptophan changes and metabolite levels in the gut, blood, hippocampus, and brainstem." ;
                                                                             rdfs:label "sentence_38318337_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38318337_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38318337_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38318337> ;
                                                                             gutprop:hasSentenceText "Fecal microbiota analysis aimed to examine the composition and diversity of the gut microbiota, and taxon-function analysis explored the associations between specific microbial taxa and functional activities in tryptophan metabolism." ;
                                                                             rdfs:label "sentence_38318337_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38318337_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38318337_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38318337> ;
                                                                             gutprop:hasSentenceText "Our findings revealed significant alterations in tryptophan metabolism across multiple sites, including the gut, blood, hippocampus, and brainstem." ;
                                                                             rdfs:label "sentence_38318337_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38318337_8
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38318337_8> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38318337> ;
                                                                             gutprop:hasSentenceText "The outcomes indicate a shift in microbiota diversity and tryptophan metabolizing capabilities within the running group, linked to increased tryptophan transportation to the hippocampus and brainstem through circulation." ;
                                                                             rdfs:label "sentence_38318337_8" .


