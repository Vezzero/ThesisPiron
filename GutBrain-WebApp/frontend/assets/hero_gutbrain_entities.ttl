                                                          "The process of growing old and showing the effects of time. [Definition Source: NCIT]" ;
                                             rdfs:label "Senescence" .


###  http://purl.obolibrary.org/obo/NCIT_C1751
<http://purl.obolibrary.org/obo/NCIT_C1751> rdf:type owl:NamedIndividual ,
                                                     skos:Concept ,
                                                     gutprop:Chemical ;
                                            skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/Chemical> ;
                                            gutprop:containedIn <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/866347a4056c6957> ;
                                            rdfs:comment "Any chemical compound, biological object, physical factor in a concentration or amount that adversely alters the physical, chemical, or biological properties of the environment. The term includes pathogens, toxic metals, carcinogens, oxygen-demanding materials, radiation, natural substances, synthetic industrial chemicals, biocides and all other harmful substances and factors. (NCI) [Definition Source: NCIT]" ,
                                                         "NCIT Match" ;
                                            rdfs:label "Pollutant" .


###  http://purl.obolibrary.org/obo/NCIT_C17557
<http://purl.obolibrary.org/obo/NCIT_C17557> rdf:type owl:NamedIndividual ,
                                                      skos:Concept ,
                                                      <https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding> ;
                                             skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/DiseaseDisorderOrFinding> ;
                                             gutprop:containedIn <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/a8d34d42aeff6037> ;
                                             rdfs:comment "A form of programmed cell death that begins when a cell receives internal or external signals, then proceeds through a series of characteristic stages typically including rounding-up of the cell, retraction of pseudopods, reduction of cellular volume (pyknosis), chromatin condensation, nuclear fragmentation (karyorrhexis), and plasma membrane blebbing, and ends with the death of the cell. [Definition Source: NCIT]" ,
                                                          "NCIT Match" ;
                                             rdfs:label "Apoptosis" .


###  http://purl.obolibrary.org/obo/NCIT_C175710
<http://purl.obolibrary.org/obo/NCIT_C175710> rdf:type owl:NamedIndividual ,
                                                       skos:Concept ,
                                                       <https://w3id.org/brainteaser/ontology/schema/Gene> ;
                                              skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/Gene> ;
                                              gutprop:containedIn <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/2c2d82697887f0bc> ;
                                              rdfs:comment "NCIT Match" ,
                                                           "This gene is involved in the innate immune response and caspase activation. [Definition Source: NCIT]" ;
                                              rdfs:label "NLRC4 Gene" .


###  http://purl.obolibrary.org/obo/NCIT_C176454
<http://purl.obolibrary.org/obo/NCIT_C176454> rdf:type owl:NamedIndividual ,
                                                       skos:Concept ,
                                                       <https://w3id.org/brainteaser/ontology/schema/Gene> ;
                                              skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/Gene> ;
                                              gutprop:containedIn <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/0d2ae233be764ad5> ;
                                              rdfs:comment "NCIT Match" ,
                                                           "This gene plays a role in the removal of linear polyubiquitin chains from protein substrates. [Definition Source: NCIT]" ;
                                              rdfs:label "OTULIN Gene" .


###  http://purl.obolibrary.org/obo/NCIT_C176595
<http://purl.obolibrary.org/obo/NCIT_C176595> rdf:type owl:NamedIndividual ,
                                                       skos:Concept ,
                                                       <https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding> ;
                                              skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/DiseaseDisorderOrFinding> ;
                                              gutprop:affect <http://purl.obolibrary.org/obo/MP_0002229> ;
                                              gutprop:containedIn <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/b1b39555dad3f8c6> ,
                                                                  <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/f52093b9b7ee4b9a> ,
                                                                  <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/04ad6aea0a04f268> ;
                                              rdfs:comment "A group of autoimmune disorders characterized by defects in self-tolerance (central or peripheral) resulting in autoimmune disease with or without recurrent infections, comprised by: Familial hemophagocytic lymphohistiocytosis (FHL) syndromes; FHL syndromes with hypopigmentation; Regulatory T cell (Treg) defects (eg, IPEX); Autoimmunity with or without lymphoproliferation (eg, autoimmune polyendocrinopathy with candidiasis and ectodermal dystrophy [APECED]); Autoimmune lymphoproliferative syndrome (ALPS); Immune dysregulation with colitis; and Susceptibility to Epstein-Barr virus (EBV) and lymphoproliferative conditions. [Definition Source: NCIT]" ,
                                                           "NCIT Match" ;
                                              rdfs:label "Immune Dysregulation Disorder" .


###  http://purl.obolibrary.org/obo/NCIT_C17741
<http://purl.obolibrary.org/obo/NCIT_C17741> rdf:type owl:NamedIndividual ,
                                                      skos:Concept ,
                                                      <https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding> ;
                                             skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/DiseaseDisorderOrFinding> ;
                                             gutprop:affect <http://purl.obolibrary.org/obo/NCIT_C2866> ;
                                             gutprop:containedIn <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/b6db063012866258> ,
                                                                 <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/cc1072fa4c4e2fe6> ,
                                                                 <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/230b5df35d447765> ;
                                             rdfs:comment "A disturbance in the prooxidant-antioxidant balance in favor of the former, leading to potential damage. Indicators of oxidative stress include damaged DNA bases, protein oxidation products, and lipid peroxidation products.  The damage to biological tissues is caused by superoxide and other free radicals generated by many factors, including exposure to alcohol, medications, trauma, cold, toxins, and radiation or by antimicrobial cellular immunity, metabolic abnormality, or \"normal\" aging; not synonymous with hypoxia or hyperoxia.  Oxidative stress promotes a range of degenerative disorders, including cancer, diabetes, premature aging, Alzheimer's, and many others. [Definition Source: NCIT]" ,
                                                          "NCIT Match" ;
                                             rdfs:label "Oxidative Stress" .


###  http://purl.obolibrary.org/obo/NCIT_C178184
<http://purl.obolibrary.org/obo/NCIT_C178184> rdf:type owl:NamedIndividual ,
                                                       skos:Concept ,
                                                       gutprop:Food ;
                                              skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/Food> ;
                                              gutprop:containedIn <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/0c05438bb217bc24> ;
                                              rdfs:comment "Milk for human consumption that is derived from cows milk. [Definition Source: NCIT]" ,
                                                           "NCIT Match" ;
                                              rdfs:label "Dairy Milk" .


###  http://purl.obolibrary.org/obo/NCIT_C178186
<http://purl.obolibrary.org/obo/NCIT_C178186> rdf:type owl:NamedIndividual ,
                                                       skos:Concept ,
                                                       gutprop:Food ;
                                              skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/Food> ;
                                              gutprop:containedIn <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/4e873b0d5012950f> ,
                                                                  <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/9af2c85dfd04b6e7> ;
                                              gutprop:influence <http://purl.obolibrary.org/obo/NCIT_C2878> ;
                                              rdfs:comment "Dairy milk where milk fat is 1 percent of the total weight of the milk. [Definition Source: NCIT]" ,
                                                           "NCIT Match" ;
                                              rdfs:label "Low-Fat Milk" .


###  http://purl.obolibrary.org/obo/NCIT_C178192
<http://purl.obolibrary.org/obo/NCIT_C178192> rdf:type owl:NamedIndividual ,
                                                       skos:Concept ,
