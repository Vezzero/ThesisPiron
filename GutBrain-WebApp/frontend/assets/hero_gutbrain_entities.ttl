                                                                <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/9089431ce8f4128f> ;
                                            gutprop:interact <http://purl.obolibrary.org/obo/CHEBI_24898> ,
                                                             <http://purl.obolibrary.org/obo/CHEBI_28044> ;
                                            gutprop:isA <http://purl.obolibrary.org/obo/NCIT_C26782> ,
                                                        <http://purl.obolibrary.org/obo/NCIT_C26835> ,
                                                        <http://purl.obolibrary.org/obo/NCIT_C39737> ,
                                                        <https://w3id.org/hereditary/ontology/gutbrain/resource/diseasedisorderorfinding/NeurodegenerativeDiseases> ;
                                            gutprop:target <https://uts.nlm.nih.gov/uts/umls/concept/C0027361> ,
