###  http://purl.obolibrary.org/obo/NCIT_C29886
<http://purl.obolibrary.org/obo/NCIT_C29886> rdf:type owl:NamedIndividual ,
                                                      skos:Concept ,
                                                      gutprop:Chemical ;
                                             skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/Chemical> ;
                                             gutprop:containedIn <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/b2577b3d685e67e1> ,
                                                                 <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/b763d14f52451b14> ,
                                                                 <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/378a9db43609e762> ,
                                                                 <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/96e16563870e3625> ,
                                                                 <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/96f2f0811df88d8f> ;
                                             gutprop:impact <http://purl.obolibrary.org/obo/NCBITaxon_747582> ,
                                                            <https://www.ncbi.nlm.nih.gov/mesh/D061306> ;
                                             gutprop:influence <http://purl.obolibrary.org/obo/NCIT_C3362> ;
                                             rdfs:comment "Airborne Particulate Matter is a broad class of materials and substances of minute size present in the air that originate from industrial manufacturing processes, automobile exhaust, forest fires, and fossil fuel combustion. Scientific studies have shown that airborne particles are associated with adverse health effects inducing respiratory diseases, heart ailments, and other problems. When inhaled, these particles are likely to reach deeply into the lungs. The Environmental Protection Agency (EPA) sets standards to control the emission of these particulates and to protect the public health. (NCI04) [Definition Source: NCIT]" ,
                                                          "NCIT Match" ;
                                             rdfs:label "Airborne Particulate Matter" .


###  http://purl.obolibrary.org/obo/NCIT_C2998
<http://purl.obolibrary.org/obo/NCIT_C2998> rdf:type owl:NamedIndividual ,
                                                     skos:Concept ,
                                                     <https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding> ;
