                                                                             gutprop:hasSentenceText "Clinical, epidemiological and therapeutic studies indicate that some human depression is associated with proinflammatory cytokines, chronic inflammatory disorders, and inflammation-inducing lifestyle factors." ;
                                                                             rdfs:label "sentence_21167931_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/21167931_10
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/21167931_10> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/21167931> ;
                                                                              gutprop:hasSentenceText "The data indicate that even in SPF models the effectors of beneficial effects are not the proinflammatory autoimmune cells themselves, but rather unidentified regulatory cells." ;
                                                                              rdfs:label "sentence_21167931_10" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/21167931_11
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/21167931_11> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/21167931> ;
                                                                              gutprop:hasSentenceText "This reinterpretation of findings relevant to \"protective autoimmunity\" suggests that ongoing, and planned, clinical trials of anti-inflammatory strategies to treat depressive disorders are justified." ;
                                                                              rdfs:label "sentence_21167931_11" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/21167931_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/21167931_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/21167931> ;
                                                                             gutprop:hasSentenceText "Moreover depression can be induced by administration of proinflammatory cytokines, including IL-2 or IFN-α." ;
                                                                             rdfs:label "sentence_21167931_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/21167931_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/21167931_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/21167931> ;
                                                                             gutprop:hasSentenceText "However, recent studies in specific pathogen-free (SPF) rodents suggest a different--and potentially contradictory--relationship between immune processes and mental health." ;
                                                                             rdfs:label "sentence_21167931_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/21167931_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/21167931_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/21167931> ;
                                                                             gutprop:hasSentenceText "These studies suggest that effector T cells specific for central nervous system (CNS) antigens can assist recovery from an array of environmental insults ranging from nerve injury to psychological stress, while in contrast, regulatory T cells (Treg) oppose such recovery." ;
                                                                             rdfs:label "sentence_21167931_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/21167931_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/21167931_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/21167931> ;
                                                                             gutprop:hasSentenceText "Indeed, some reported effects of this so-called \"protective autoimmunity\" seem of direct relevance to depressive disorders." ;
                                                                             rdfs:label "sentence_21167931_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/21167931_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/21167931_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/21167931> ;
                                                                             gutprop:hasSentenceText "These findings pose a dilemma for those intending to manipulate inflammatory pathways as a treatment for depression." ;
                                                                             rdfs:label "sentence_21167931_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/21167931_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/21167931_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/21167931> ;
                                                                             gutprop:hasSentenceText "Should we administer anti-inflammatory treatments, or should we induce self-reactive T cells?" ;
                                                                             rdfs:label "sentence_21167931_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/21167931_8
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/21167931_8> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/21167931> ;
                                                                             gutprop:hasSentenceText "We re-examine the rodent findings and outline immunological peculiarities of SPF rodents, the abnormal properties of their regulatory T cells, and the impact of gut microbiota." ;
                                                                             rdfs:label "sentence_21167931_8" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/21167931_9
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/21167931_9> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/21167931> ;
                                                                             gutprop:hasSentenceText "We find that \"protective autoimmunity\" is likely to be relevant only to very clean SPF animals that lack normal levels of activated T cells, CNS T cell traffic and mature Treg." ;
                                                                             rdfs:label "sentence_21167931_9" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/23981537_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/23981537_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/23981537> ;
                                                                             gutprop:hasSentenceText "Metabolic features of the cell danger response." ;
                                                                             rdfs:label "sentence_23981537_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/23981537_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/23981537_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/23981537> ;
                                                                             gutprop:hasSentenceText "The cell danger response (CDR) is the evolutionarily conserved metabolic response that protects cells and hosts from harm." ;
                                                                             rdfs:label "sentence_23981537_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/23981537_10
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/23981537_10> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/23981537> ;
                                                                              gutprop:hasSentenceText "An understanding of the CDR permits us to reframe old concepts of pathogenesis for a broad array of chronic, developmental, autoimmune, and degenerative disorders." ;
                                                                              rdfs:label "sentence_23981537_10" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/23981537_11
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/23981537_11> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/23981537> ;
                                                                              gutprop:hasSentenceText "These disorders include autism spectrum disorders (ASD), attention deficit hyperactivity disorder (ADHD), asthma, atopy, gluten and many other food and chemical sensitivity syndromes, emphysema, Tourette's syndrome, bipolar disorder, schizophrenia, post-traumatic stress disorder (PTSD), chronic traumatic encephalopathy (CTE), traumatic brain injury (TBI), epilepsy, suicidal ideation, organ transplant biology, diabetes, kidney, liver, and heart disease, cancer, Alzheimer and Parkinson disease, and autoimmune disorders like lupus, rheumatoid arthritis, multiple sclerosis, and primary sclerosing cholangitis." ;
                                                                              rdfs:label "sentence_23981537_11" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/23981537_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/23981537_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/23981537> ;
                                                                             gutprop:hasSentenceText "It is triggered by encounters with chemical, physical, or biological threats that exceed the cellular capacity for homeostasis." ;
                                                                             rdfs:label "sentence_23981537_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/23981537_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/23981537_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/23981537> ;
                                                                             gutprop:hasSentenceText "The resulting metabolic mismatch between available resources and functional capacity produces a cascade of changes in cellular electron flow, oxygen consumption, redox, membrane fluidity, lipid dynamics, bioenergetics, carbon and sulfur resource allocation, protein folding and aggregation, vitamin availability, metal homeostasis, indole, pterin, 1-carbon and polyamine metabolism, and polymer formation." ;
                                                                             rdfs:label "sentence_23981537_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/23981537_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/23981537_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/23981537> ;
                                                                             gutprop:hasSentenceText "The first wave of danger signals consists of the release of metabolic intermediates like ATP and ADP, Krebs cycle intermediates, oxygen, and reactive oxygen species (ROS), and is sustained by purinergic signaling." ;
                                                                             rdfs:label "sentence_23981537_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/23981537_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/23981537_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/23981537> ;
                                                                             gutprop:hasSentenceText "After the danger has been eliminated or neutralized, a choreographed sequence of anti-inflammatory and regenerative pathways is activated to reverse the CDR and to heal." ;
                                                                             rdfs:label "sentence_23981537_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/23981537_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/23981537_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/23981537> ;
                                                                             gutprop:hasSentenceText "When the CDR persists abnormally, whole body metabolism and the gut microbiome are disturbed, the collective performance of multiple organ systems is impaired, behavior is changed, and chronic disease results." ;
                                                                             rdfs:label "sentence_23981537_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/23981537_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/23981537_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/23981537> ;
                                                                             gutprop:hasSentenceText "Metabolic memory of past stress encounters is stored in the form of altered mitochondrial and cellular macromolecule content, resulting in an increase in functional reserve capacity through a process known as mitocellular hormesis." ;
                                                                             rdfs:label "sentence_23981537_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/23981537_8
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/23981537_8> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/23981537> ;
                                                                             gutprop:hasSentenceText "The systemic form of the CDR, and its magnified form, the purinergic life-threat response (PLTR), are under direct control by ancient pathways in the brain that are ultimately coordinated by centers in the brainstem." ;
                                                                             rdfs:label "sentence_23981537_8" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/23981537_9
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/23981537_9> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/23981537> ;
                                                                             gutprop:hasSentenceText "Chemosensory integration of whole body metabolism occurs in the brainstem and is a prerequisite for normal brain, motor, vestibular, sensory, social, and speech development." ;
                                                                             rdfs:label "sentence_23981537_9" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/24103493_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/24103493_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/24103493> ;
                                                                             gutprop:hasSentenceText "Excess body weight during pregnancy and offspring obesity: potential mechanisms." ;
                                                                             rdfs:label "sentence_24103493_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/24103493_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/24103493_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/24103493> ;
                                                                             gutprop:hasSentenceText "The rates of child and adult obesity have increased in most developed countries over the past several decades." ;
                                                                             rdfs:label "sentence_24103493_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/24103493_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/24103493_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/24103493> ;
                                                                             gutprop:hasSentenceText "The health consequences of obesity affect both physical and mental health, and the excess body weight can be linked to an elevated risk for developing type 2 diabetes, cardiovascular problems, and depression." ;
                                                                             rdfs:label "sentence_24103493_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/24103493_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/24103493_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/24103493> ;
                                                                             gutprop:hasSentenceText "Among the factors that can influence the development of obesity are higher infant weights and increased weight gain, which are associated with higher risk for excess body weight later in life." ;
                                                                             rdfs:label "sentence_24103493_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/24103493_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/24103493_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/24103493> ;
                                                                             gutprop:hasSentenceText "In turn, mother's excess body weight during and after pregnancy can be linked to the risk for offspring overweight and obesity through dietary habits, mode of delivery and feeding, breast milk composition, and through the influence on infant gut microbiota." ;
                                                                             rdfs:label "sentence_24103493_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/24103493_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/24103493_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/24103493> ;
                                                                             gutprop:hasSentenceText "This review considers current knowledge of these potential mechanisms that threaten to create an intergenerational cycle of obesity." ;
                                                                             rdfs:label "sentence_24103493_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/24798884_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/24798884_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/24798884> ;
                                                                             gutprop:hasSentenceText "Priming for health: gut microbiota acquired in early life regulates physiology, brain and behaviour." ;
                                                                             rdfs:label "sentence_24798884_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/24798884_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/24798884_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/24798884> ;
                                                                             gutprop:hasSentenceText "The infant gut microbiome is dynamic, and radical shifts in composition occur during the first 3 years of life." ;
                                                                             rdfs:label "sentence_24798884_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/24798884_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/24798884_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/24798884> ;
                                                                             gutprop:hasSentenceText "Disruption of these developmental patterns, and the impact of the microbial composition of our gut on brain and behaviour, has attracted much recent attention." ;
                                                                             rdfs:label "sentence_24798884_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/24798884_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/24798884_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/24798884> ;
                                                                             gutprop:hasSentenceText "Integrating these observations is an important new research frontier." ;
                                                                             rdfs:label "sentence_24798884_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/24798884_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/24798884_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/24798884> ;
                                                                             gutprop:hasSentenceText "Early-life perturbations of the developing gut microbiota can impact on the central nervous system and potentially lead to adverse mental health outcomes." ;
                                                                             rdfs:label "sentence_24798884_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/24956966_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/24956966_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/24956966> ;
                                                                             gutprop:hasSentenceText "Microbiota and neurodevelopmental windows: implications for brain disorders." ;
                                                                             rdfs:label "sentence_24956966_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/24956966_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/24956966_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/24956966> ;
                                                                             gutprop:hasSentenceText "Gut microbiota is essential to human health, playing a major role in the bidirectional communication between the gastrointestinal tract and the central nervous system." ;
                                                                             rdfs:label "sentence_24956966_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/24956966_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/24956966_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/24956966> ;
                                                                             gutprop:hasSentenceText "The microbiota undergoes a vigorous process of development throughout the lifespan and establishes its symbiotic rapport with the host early in life." ;
                                                                             rdfs:label "sentence_24956966_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/24956966_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/24956966_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/24956966> ;
                                                                             gutprop:hasSentenceText "Early life perturbations of the developing gut microbiota can impact neurodevelopment and potentially lead to adverse mental health outcomes later in life." ;
                                                                             rdfs:label "sentence_24956966_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/24956966_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/24956966_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/24956966> ;
                                                                             gutprop:hasSentenceText "This review compares the parallel early development of the intestinal microbiota and the nervous system." ;
                                                                             rdfs:label "sentence_24956966_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/24956966_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/24956966_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/24956966> ;
                                                                             gutprop:hasSentenceText "The concept of parallel and interacting microbial-neural critical windows opens new avenues for developing novel microbiota-modulating based therapeutic interventions in early life to combat neurodevelopmental deficits and brain disorders." ;
                                                                             rdfs:label "sentence_24956966_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/25034760_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/25034760_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/25034760> ;
                                                                             gutprop:hasSentenceText "Autoimmune diseases, gastrointestinal disorders and the microbiome in schizophrenia: more than a gut feeling." ;
                                                                             rdfs:label "sentence_25034760_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/25034760_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/25034760_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/25034760> ;
                                                                             gutprop:hasSentenceText "Autoimmunity, gastrointestinal (GI) disorders and schizophrenia have been associated with one another for a long time." ;
                                                                             rdfs:label "sentence_25034760_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/25034760_10
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/25034760_10> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/25034760> ;
                                                                              gutprop:hasSentenceText "Dietary modifications of core bacterial compositions may explain inefficient gluten digestion and how immigrant status in certain situations is a risk factor for schizophrenia." ;
                                                                              rdfs:label "sentence_25034760_10" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/25034760_11
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/25034760_11> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/25034760> ;
                                                                              gutprop:hasSentenceText "Gut microbiome research in schizophrenia is in its infancy, but data in related fields suggest disease-associated altered phylogenetic compositions." ;
                                                                              rdfs:label "sentence_25034760_11" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/25034760_12
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/25034760_12> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/25034760> ;
                                                                              gutprop:hasSentenceText "In summary, this review surveys associative and experimental data linking autoimmunity, GI activity and schizophrenia, and proposes that understanding of disrupted biological pathways outside of the brain can lend valuable information regarding pathogeneses of complex, polygenic brain disorders." ;
                                                                              rdfs:label "sentence_25034760_12" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/25034760_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/25034760_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/25034760> ;
                                                                             gutprop:hasSentenceText "This paper reviews these connections and provides a context by which multiple risk factors for schizophrenia may be related." ;
                                                                             rdfs:label "sentence_25034760_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/25034760_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/25034760_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/25034760> ;
                                                                             gutprop:hasSentenceText "Epidemiological studies strongly link schizophrenia with autoimmune disorders including enteropathic celiac disease." ;
                                                                             rdfs:label "sentence_25034760_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/25034760_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/25034760_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/25034760> ;
                                                                             gutprop:hasSentenceText "Exposure to wheat gluten and bovine milk casein also contribute to non-celiac food sensitivities in susceptible individuals." ;
                                                                             rdfs:label "sentence_25034760_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/25034760_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/25034760_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/25034760> ;
                                                                             gutprop:hasSentenceText "Co-morbid GI inflammation accompanies humoral immunity to food antigens, occurs early during the course of schizophrenia and appears to be independent from antipsychotic-generated motility effects." ;
                                                                             rdfs:label "sentence_25034760_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/25034760_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/25034760_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/25034760> ;
                                                                             gutprop:hasSentenceText "This inflammation impacts endothelial barrier permeability and can precipitate translocation of gut bacteria into systemic circulation." ;
                                                                             rdfs:label "sentence_25034760_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/25034760_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/25034760_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/25034760> ;
                                                                             gutprop:hasSentenceText "Infection by the neurotropic gut pathogen, Toxoplasma gondii, will elicit an inflammatory GI environment." ;
                                                                             rdfs:label "sentence_25034760_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/25034760_8
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/25034760_8> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/25034760> ;
                                                                             gutprop:hasSentenceText "Such processes trigger innate immunity, including activation of complement C1q, which also functions at synapses in the brain." ;
                                                                             rdfs:label "sentence_25034760_8" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/25034760_9
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/25034760_9> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/25034760> ;
                                                                             gutprop:hasSentenceText "The emerging field of microbiome research lies at the center of these interactions with evidence that the abundance and diversity of resident gut microbiota contribute to digestion, inflammation, gut permeability and behavior." ;
                                                                             rdfs:label "sentence_25034760_9" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/25173628_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/25173628_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/25173628> ;
                                                                             gutprop:hasSentenceText "Obese-type gut microbiota induce neurobehavioral changes in the absence of obesity." ;
                                                                             rdfs:label "sentence_25173628_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/25173628_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/25173628_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/25173628> ;
                                                                             gutprop:hasSentenceText "The prevalence of mental illness, particularly depression and dementia, is increased by obesity." ;
                                                                             rdfs:label "sentence_25173628_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/25173628_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/25173628_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/25173628> ;
                                                                             gutprop:hasSentenceText "Here, we test the hypothesis that obesity-associated changes in gut microbiota are intrinsically able to impair neurocognitive behavior in mice." ;
                                                                             rdfs:label "sentence_25173628_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/25173628_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/25173628_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/25173628> ;
                                                                             gutprop:hasSentenceText "Conventionally housed, nonobese, adult male C57BL/6 mice maintained on a normal chow diet were subjected to a microbiome depletion/transplantation paradigm using microbiota isolated from donors on either a high-fat diet (HFD) or control diet." ;
                                                                             rdfs:label "sentence_25173628_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/25173628_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/25173628_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/25173628> ;
                                                                             gutprop:hasSentenceText "Following re-colonization, mice were subjected to comprehensive behavioral and biochemical analyses." ;
                                                                             rdfs:label "sentence_25173628_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/25173628_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/25173628_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/25173628> ;
                                                                             gutprop:hasSentenceText "The mice given HFD microbiota had significant and selective disruptions in exploratory, cognitive, and stereotypical behavior compared with mice with control diet microbiota in the absence of significant differences in body weight." ;
                                                                             rdfs:label "sentence_25173628_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/25173628_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/25173628_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/25173628> ;
                                                                             gutprop:hasSentenceText "Sequencing-based phylogenetic analysis confirmed the presence of distinct core microbiota between groups, with alterations in α- and β-diversity, modulation in taxonomic distribution, and statistically significant alterations to metabolically active taxa." ;
                                                                             rdfs:label "sentence_25173628_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/25173628_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/25173628_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/25173628> ;
                                                                             gutprop:hasSentenceText "HFD microbiota also disrupted markers of intestinal barrier function, increased circulating endotoxin, and increased lymphocyte expression of ionized calcium-binding adapter molecule 1, toll-like receptor 2, and toll-like receptor 4." ;
                                                                             rdfs:label "sentence_25173628_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/25173628_8
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/25173628_8> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/25173628> ;
                                                                             gutprop:hasSentenceText "Finally, evaluation of brain homogenates revealed that HFD-shaped microbiota increased neuroinflammation and disrupted cerebrovascular homeostasis." ;
                                                                             rdfs:label "sentence_25173628_8" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/25173628_9
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/25173628_9> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/25173628> ;
                                                                             gutprop:hasSentenceText "Collectively, these data reinforce the link between gut dysbiosis and neurologic dysfunction and suggest that dietary and/or pharmacologic manipulation of gut microbiota could attenuate the neurologic complications of obesity." ;
                                                                             rdfs:label "sentence_25173628_9" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/25231862_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/25231862_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/25231862> ;
                                                                             gutprop:hasSentenceText "Artificial sweeteners induce glucose intolerance by altering the gut microbiota." ;
                                                                             rdfs:label "sentence_25231862_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/25231862_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/25231862_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/25231862> ;
                                                                             gutprop:hasSentenceText "Non-caloric artificial sweeteners (NAS) are among the most widely used food additives worldwide, regularly consumed by lean and obese individuals alike." ;
                                                                             rdfs:label "sentence_25231862_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/25231862_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/25231862_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/25231862> ;
                                                                             gutprop:hasSentenceText "NAS consumption is considered safe and beneficial owing to their low caloric content, yet supporting scientific data remain sparse and controversial." ;
                                                                             rdfs:label "sentence_25231862_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/25231862_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/25231862_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/25231862> ;
                                                                             gutprop:hasSentenceText "Here we demonstrate that consumption of commonly used NAS formulations drives the development of glucose intolerance through induction of compositional and functional alterations to the intestinal microbiota." ;
                                                                             rdfs:label "sentence_25231862_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/25231862_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/25231862_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/25231862> ;
                                                                             gutprop:hasSentenceText "These NAS-mediated deleterious metabolic effects are abrogated by antibiotic treatment, and are fully transferrable to germ-free mice upon faecal transplantation of microbiota configurations from NAS-consuming mice, or of microbiota anaerobically incubated in the presence of NAS." ;
                                                                             rdfs:label "sentence_25231862_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/25231862_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/25231862_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/25231862> ;
                                                                             gutprop:hasSentenceText "We identify NAS-altered microbial metabolic pathways that are linked to host susceptibility to metabolic disease, and demonstrate similar NAS-induced dysbiosis and glucose intolerance in healthy human subjects." ;
                                                                             rdfs:label "sentence_25231862_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/25231862_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/25231862_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/25231862> ;
                                                                             gutprop:hasSentenceText "Collectively, our results link NAS consumption, dysbiosis and metabolic abnormalities, thereby calling for a reassessment of massive NAS usage." ;
                                                                             rdfs:label "sentence_25231862_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/25869281_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/25869281_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/25869281> ;
                                                                             gutprop:hasSentenceText "Lactobacillus fermentum NS9 restores the antibiotic induced physiological and psychological abnormalities in rats." ;
                                                                             rdfs:label "sentence_25869281_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/25869281_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/25869281_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/25869281> ;
                                                                             gutprop:hasSentenceText "Gut microbiota play a vital role in maintaining the health of the host." ;
                                                                             rdfs:label "sentence_25869281_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/25869281_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/25869281_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/25869281> ;
                                                                             gutprop:hasSentenceText "Many factors affect gut microbiota; application of broad range antibiotics disturb microbiota, while probiotic application protects the microbiota." ;
                                                                             rdfs:label "sentence_25869281_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/25869281_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/25869281_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/25869281> ;
                                                                             gutprop:hasSentenceText "To investigate how probiotics alter the physiological and psychological changes induced by antibiotics, we tested the performance of ampicillin-treated rats in the presence or absence of Lactobacillus fermentum strain NS9, in elevated plus maze and Morris water maze." ;
                                                                             rdfs:label "sentence_25869281_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/25869281_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/25869281_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/25869281> ;
                                                                             gutprop:hasSentenceText "The results showed that NS9 normalised the composition of gut microbiota and alleviated the ampicillin-induced inflammation in the colon." ;
                                                                             rdfs:label "sentence_25869281_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/25869281_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/25869281_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/25869281> ;
                                                                             gutprop:hasSentenceText "The levels of the mineralocorticoid and N-methyl-D-aspartate receptors were also elevated in the hippocampus of the ampillicin+NS9 treated group." ;
                                                                             rdfs:label "sentence_25869281_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/25869281_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/25869281_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/25869281> ;
                                                                             gutprop:hasSentenceText "NS9 administration also reduced the anxiety-like behaviour and alleviated the ampicillin-induced impairment in memory retention." ;
                                                                             rdfs:label "sentence_25869281_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/25869281_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/25869281_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/25869281> ;
                                                                             gutprop:hasSentenceText "These findings suggest that NS9 is beneficial to the host, because it restores the physiological and psychological abnormalities induced by ampicillin." ;
                                                                             rdfs:label "sentence_25869281_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/25869281_8
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/25869281_8> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/25869281> ;
                                                                             gutprop:hasSentenceText "Our results highlight how gut contents regulate the brain, and shed light on the clinical applications of probiotics to treat the side effect of antibiotics and mental disorders." ;
                                                                             rdfs:label "sentence_25869281_8" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/25911232_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/25911232_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/25911232> ;
                                                                             gutprop:hasSentenceText "Microbiota regulation of the Mammalian gut-brain axis." ;
                                                                             rdfs:label "sentence_25911232_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/25911232_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/25911232_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/25911232> ;
                                                                             gutprop:hasSentenceText "The realization that the microbiota-gut-brain axis plays a critical role in health and disease has emerged over the past decade." ;
                                                                             rdfs:label "sentence_25911232_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/25911232_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/25911232_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/25911232> ;
                                                                             gutprop:hasSentenceText "The brain-gut axis is a bidirectional communication system between the central nervous system (CNS) and the gastrointestinal tract." ;
                                                                             rdfs:label "sentence_25911232_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/25911232_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/25911232_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/25911232> ;
                                                                             gutprop:hasSentenceText "Regulation of the microbiota-brain-gut axis is essential for maintaining homeostasis, including that of the CNS." ;
                                                                             rdfs:label "sentence_25911232_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/25911232_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/25911232_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/25911232> ;
                                                                             gutprop:hasSentenceText "The routes of this communication are not fully elucidated but include neural, humoral, immune, and metabolic pathways." ;
                                                                             rdfs:label "sentence_25911232_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/25911232_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/25911232_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/25911232> ;
                                                                             gutprop:hasSentenceText "A number of approaches have been used to interrogate this axis including the use of germ-free animals, probiotic agents, antibiotics, or animals exposed to pathogenic bacterial infections." ;
                                                                             rdfs:label "sentence_25911232_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/25911232_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/25911232_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/25911232> ;
                                                                             gutprop:hasSentenceText "Together, it is clear that the gut microbiota can be a key regulator of mood, cognition, pain, and obesity." ;
                                                                             rdfs:label "sentence_25911232_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/25911232_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/25911232_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/25911232> ;
                                                                             gutprop:hasSentenceText "Understanding microbiota-brain interactions is an exciting area of research which may contribute new insights into individual variations in cognition, personality, mood, sleep, and eating behavior, and how they contribute to a range of neuropsychiatric diseases ranging from affective disorders to autism and schizophrenia." ;
                                                                             rdfs:label "sentence_25911232_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/25911232_8
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/25911232_8> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/25911232> ;
                                                                             gutprop:hasSentenceText "Finally, the concept of psychobiotics, bacterial-based interventions with mental health benefit, is also emerging." ;
                                                                             rdfs:label "sentence_25911232_8" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/25940667_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/25940667_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/25940667> ;
                                                                             gutprop:hasSentenceText "The dormant blood microbiome in chronic, inflammatory diseases." ;
                                                                             rdfs:label "sentence_25940667_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/25940667_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/25940667_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/25940667> ;
                                                                             gutprop:hasSentenceText "Blood in healthy organisms is seen as a 'sterile' environment: it lacks proliferating microbes." ;
                                                                             rdfs:label "sentence_25940667_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/25940667_10
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/25940667_10> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/25940667> ;
                                                                              gutprop:hasSentenceText "To avoid ambiguity, we here use the term 'atopobiosis' for microbes that appear in places other than their normal location." ;
                                                                              rdfs:label "sentence_25940667_10" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/25940667_11
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/25940667_11> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/25940667> ;
                                                                              gutprop:hasSentenceText "Atopobiosis may contribute to the dynamics of a variety of inflammatory diseases." ;
                                                                              rdfs:label "sentence_25940667_11" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/25940667_12
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/25940667_12> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/25940667> ;
                                                                              gutprop:hasSentenceText "Overall, it seems that many more chronic, non-communicable, inflammatory diseases may have a microbial component than are presently considered, and may be treatable using bactericidal antibiotics or vaccines." ;
                                                                              rdfs:label "sentence_25940667_12" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/25940667_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/25940667_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/25940667> ;
                                                                             gutprop:hasSentenceText "Dormant or not-immediately-culturable forms are not absent, however, as intracellular dormancy is well established." ;
                                                                             rdfs:label "sentence_25940667_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/25940667_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/25940667_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/25940667> ;
                                                                             gutprop:hasSentenceText "We highlight here that a great many pathogens can survive in blood and inside erythrocytes." ;
                                                                             rdfs:label "sentence_25940667_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/25940667_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/25940667_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/25940667> ;
                                                                             gutprop:hasSentenceText "'Non-culturability', reflected by discrepancies between plate counts and total counts, is commonplace in environmental microbiology." ;
                                                                             rdfs:label "sentence_25940667_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/25940667_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/25940667_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/25940667> ;
                                                                             gutprop:hasSentenceText "It is overcome by improved culturing methods, and we asked how common this would be in blood." ;
                                                                             rdfs:label "sentence_25940667_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/25940667_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/25940667_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/25940667> ;
                                                                             gutprop:hasSentenceText "A number of recent, sequence-based and ultramicroscopic studies have uncovered an authentic blood microbiome in a number of non-communicable diseases." ;
                                                                             rdfs:label "sentence_25940667_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/25940667_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/25940667_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/25940667> ;
                                                                             gutprop:hasSentenceText "The chief origin of these microbes is the gut microbiome (especially when it shifts composition to a pathogenic state, known as 'dysbiosis')." ;
                                                                             rdfs:label "sentence_25940667_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/25940667_8
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/25940667_8> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/25940667> ;
                                                                             gutprop:hasSentenceText "Another source is microbes translocated from the oral cavity." ;
                                                                             rdfs:label "sentence_25940667_8" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/25940667_9
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/25940667_9> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/25940667> ;
                                                                             gutprop:hasSentenceText "'Dysbiosis' is also used to describe translocation of cells into blood or other tissues." ;
                                                                             rdfs:label "sentence_25940667_9" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/26129950_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/26129950_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/26129950> ;
                                                                             gutprop:hasSentenceText "Antibiotic-induced imbalances in gut microbiota aggravates cholesterol accumulation and liver injuries in rats fed a high-cholesterol diet." ;
                                                                             rdfs:label "sentence_26129950_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/26129950_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/26129950_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/26129950> ;
                                                                             gutprop:hasSentenceText "Increasing evidence suggests that maintenance of homeostasis between gut microbiota and host plays an important role in human health." ;
                                                                             rdfs:label "sentence_26129950_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/26129950_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/26129950_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/26129950> ;
                                                                             gutprop:hasSentenceText "Many diseases, such as those affecting the liver, have been linked to imbalances in gut microbial communities." ;
                                                                             rdfs:label "sentence_26129950_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/26129950_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/26129950_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/26129950> ;
                                                                             gutprop:hasSentenceText "However, it is not clear whether an imbalance in gut microbiota promotes the onset of liver injury or if the imbalance results from the pathological state." ;
                                                                             rdfs:label "sentence_26129950_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/26129950_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/26129950_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/26129950> ;
                                                                             gutprop:hasSentenceText "In the current study, antibiotics were used to disturb the gut microbiota of both rats fed a high-cholesterol diet and rats fed a normal diet (controls)." ;
                                                                             rdfs:label "sentence_26129950_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/26129950_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/26129950_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/26129950> ;
                                                                             gutprop:hasSentenceText "The prevalence of Bacteroidetes and Firmicutes were reduced, and Proteobacteria was greatly increased in the guts of rats after antibiotic treatment." ;
                                                                             rdfs:label "sentence_26129950_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/26129950_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/26129950_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/26129950> ;
                                                                             gutprop:hasSentenceText "The antibiotic-induced perturbation of gut microbiota aggravated cholesterol accumulation and liver injury in rats fed a high-cholesterol diet." ;
                                                                             rdfs:label "sentence_26129950_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/26129950_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/26129950_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/26129950> ;
                                                                             gutprop:hasSentenceText "This may have been due to an increase in intestinal permeability and plasma lipopolysaccharide (LPS), which lead to an increase in LPS absorption and activation of TLR4 signaling, resulting in the synthesis of pro-inflammatory cytokines and chemokines in liver tissues." ;
                                                                             rdfs:label "sentence_26129950_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/26129950_8
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/26129950_8> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/26129950> ;
                                                                             gutprop:hasSentenceText "This study suggests that imbalances in gut microbiota may be a predisposing factor for the onset of metabolic diseases and liver injuries related to cholesterol and high-cholesterol diets." ;
                                                                             rdfs:label "sentence_26129950_8" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/26129950_9
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/26129950_9> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/26129950> ;
                                                                             gutprop:hasSentenceText "Modulation of gut microbiota could be a novel target for preventing cholesterol-related metabolic disorders." ;
                                                                             rdfs:label "sentence_26129950_9" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/26190966_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/26190966_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/26190966> ;
                                                                             gutprop:hasSentenceText "Role of neuroinflammation in the emotional and cognitive alterations displayed by animal models of obesity." ;
                                                                             rdfs:label "sentence_26190966_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/26190966_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/26190966_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/26190966> ;
                                                                             gutprop:hasSentenceText "Obesity is associated with a high prevalence of mood disorders and cognitive dysfunctions in addition to being a significant risk factor for important health complications such as cardiovascular diseases and type 2 diabetes." ;
                                                                             rdfs:label "sentence_26190966_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/26190966_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/26190966_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/26190966> ;
                                                                             gutprop:hasSentenceText "Identifying the pathophysiological mechanisms underlying these health issues is a major public health challenge." ;
                                                                             rdfs:label "sentence_26190966_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/26190966_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/26190966_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/26190966> ;
                                                                             gutprop:hasSentenceText "Based on recent findings, from studies conducted on animal models of obesity, it has been proposed that inflammatory processes may participate in both the peripheral and brain disorders associated with the obesity condition including the development of emotional and cognitive alterations." ;
                                                                             rdfs:label "sentence_26190966_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/26190966_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/26190966_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/26190966> ;
                                                                             gutprop:hasSentenceText "This is supported by the fact that obesity is characterized by peripheral low-grade inflammation, originating from increased adipose tissue mass and/or dysbiosis (changes in gut microbiota environment), both of which contribute to increased susceptibility to immune-mediated diseases." ;
                                                                             rdfs:label "sentence_26190966_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/26190966_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/26190966_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/26190966> ;
                                                                             gutprop:hasSentenceText "In this review, we provide converging evidence showing that obesity is associated with exacerbated neuroinflammation leading to dysfunction in vulnerable brain regions associated with mood regulation, learning, and memory such as the hippocampus." ;
                                                                             rdfs:label "sentence_26190966_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/26190966_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/26190966_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/26190966> ;
                                                                             gutprop:hasSentenceText "These findings give new insights to the pathophysiological mechanisms contributing to the development of brain disorders in the context of obesity and provide valuable data for introducing new therapeutic strategies for the treatment of neuropsychiatric complications often reported in obese patients." ;
                                                                             rdfs:label "sentence_26190966_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/26408987_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/26408987_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/26408987> ;
                                                                             gutprop:hasSentenceText "Administration of Lactobacillus helveticus NS8 improves behavioral, cognitive, and biochemical aberrations caused by chronic restraint stress." ;
                                                                             rdfs:label "sentence_26408987_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/26408987_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/26408987_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/26408987> ;
                                                                             gutprop:hasSentenceText "Increasing numbers of studies have suggested that the gut microbiota is involved in the pathophysiology of stress-related disorders." ;
                                                                             rdfs:label "sentence_26408987_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/26408987_10
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/26408987_10> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/26408987> ;
                                                                              gutprop:hasSentenceText "Taken together, these results indicate an anti-depressant effect of L. helveticus NS8 in rats subjected to chronic restraint stress depression and that this effect could be due to the microbiota-gut-brain axis." ;
                                                                              rdfs:label "sentence_26408987_10" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/26408987_11
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/26408987_11> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/26408987> ;
                                                                              gutprop:hasSentenceText "They also suggest the therapeutic potential of L. helveticus NS8 in stress-related and possibly other kinds of depression." ;
                                                                              rdfs:label "sentence_26408987_11" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/26408987_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/26408987_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/26408987> ;
                                                                             gutprop:hasSentenceText "Chronic stress can cause behavioral, cognitive, biochemical, and gut microbiota aberrations." ;
                                                                             rdfs:label "sentence_26408987_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/26408987_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/26408987_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/26408987> ;
                                                                             gutprop:hasSentenceText "Gut bacteria can communicate with the host through the microbiota-gut-brain axis (which mainly includes the immune, neuroendocrine, and neural pathways) to influence brain and behavior." ;
                                                                             rdfs:label "sentence_26408987_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/26408987_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/26408987_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/26408987> ;
                                                                             gutprop:hasSentenceText "It is hypothesized that administration of probiotics can improve chronic-stress-induced depression." ;
                                                                             rdfs:label "sentence_26408987_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/26408987_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/26408987_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/26408987> ;
                                                                             gutprop:hasSentenceText "In order to examine this hypothesis, the chronic restraint stress depression model was established in this study." ;
                                                                             rdfs:label "sentence_26408987_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/26408987_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/26408987_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/26408987> ;
                                                                             gutprop:hasSentenceText "Adult specific pathogen free (SPF) Sprague-Dawley rats were subjected to 21 days of restraint stress followed by behavioral testing (including the sucrose preference test (SPT), elevated-plus maze test, open-field test (OFT), object recognition test (ORT), and object placement test (OPT)) and biochemical analysis." ;
                                                                             rdfs:label "sentence_26408987_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/26408987_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/26408987_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/26408987> ;
                                                                             gutprop:hasSentenceText "Supplemental Lactobacillus helveticus NS8 was provided every day during stress until the end of experiment, and selective serotonin reuptake inhibitor (SSRI) citalopram (CIT) served as a positive control." ;
                                                                             rdfs:label "sentence_26408987_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/26408987_8
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/26408987_8> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/26408987> ;
                                                                             gutprop:hasSentenceText "Results showed that L. helveticus NS8 improved chronic restraint stress-induced behavioral (anxiety and depression) and cognitive dysfunction, showing an effect similar to and better than that of CIT." ;
                                                                             rdfs:label "sentence_26408987_8" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/26408987_9
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/26408987_9> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/26408987> ;
                                                                             gutprop:hasSentenceText "L. helveticus NS8 also resulted in lower plasma corticosterone (CORT) and adrenocorticotropic hormone (ACTH) levels, higher plasma interleukin-10 (IL-10) levels, restored hippocampal serotonin (5-HT) and norepinephrine (NE) levels, and more hippocampal brain-derived neurotrophic factor (BDNF) mRNA expression than in chronic stress rats." ;
                                                                             rdfs:label "sentence_26408987_9" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/26426677_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/26426677_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/26426677> ;
                                                                             gutprop:hasSentenceText "Neuroimmune pharmacological approaches." ;
                                                                             rdfs:label "sentence_26426677_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/26426677_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/26426677_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/26426677> ;
                                                                             gutprop:hasSentenceText "Intestinal inflammation is a major health problem which impairs the quality of life, impacts mental health and is exacerbated by stress and psychiatric disturbances which, in turn, can affect disease prognosis and response to treatment." ;
                                                                             rdfs:label "sentence_26426677_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/26426677_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/26426677_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/26426677> ;
                                                                             gutprop:hasSentenceText "Accumulating evidence indicates that the immune system is an important interface between intestinal inflammation and the enteric, sensory, central and autonomic nervous systems." ;
                                                                             rdfs:label "sentence_26426677_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/26426677_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/26426677_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/26426677> ;
                                                                             gutprop:hasSentenceText "In addition, the neuroimmune interactions originating from the gastrointestinal tract are orchestrated by the gut microbiota." ;
                                                                             rdfs:label "sentence_26426677_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/26426677_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/26426677_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/26426677> ;
                                                                             gutprop:hasSentenceText "This article reviews some major insights into this complex homeostatic network that have been achieved during the past two years and attempts to put these advances into perspective with novel opportunities of pharmacological intervention." ;
                                                                             rdfs:label "sentence_26426677_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/26627987_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/26627987_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/26627987> ;
                                                                             gutprop:hasSentenceText "Gut microbiome in health and disease: Linking the microbiome-gut-brain axis and environmental factors in the pathogenesis of systemic and neurodegenerative diseases." ;
                                                                             rdfs:label "sentence_26627987_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/26627987_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/26627987_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/26627987> ;
                                                                             gutprop:hasSentenceText "The gut microbiome comprises the collective genome of the trillions of microorganisms residing in our gastrointestinal ecosystem." ;
                                                                             rdfs:label "sentence_26627987_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/26627987_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/26627987_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/26627987> ;
                                                                             gutprop:hasSentenceText "The interaction between the host and its gut microbiome is a complex relationship whose manipulation could prove critical to preventing or treating not only various gut disorders, like irritable bowel syndrome (IBS) and ulcerative colitis (UC), but also central nervous system (CNS) disorders, such as Alzheimer's and Parkinson's diseases." ;
                                                                             rdfs:label "sentence_26627987_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/26627987_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/26627987_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/26627987> ;
                                                                             gutprop:hasSentenceText "The purpose of this review is to summarize what is known about the gut microbiome, how it is connected to the development of disease and to identify the bacterial and biochemical targets that should be the focus of future research." ;
                                                                             rdfs:label "sentence_26627987_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/26627987_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/26627987_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/26627987> ;
                                                                             gutprop:hasSentenceText "Understanding the mechanisms behind the activity and proliferation of the gut microbiome will provide us new insights that may pave the way for novel therapeutic strategies." ;
                                                                             rdfs:label "sentence_26627987_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/26923630_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/26923630_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/26923630> ;
                                                                             gutprop:hasSentenceText "Cognitive impairment by antibiotic-induced gut dysbiosis: Analysis of gut microbiota-brain communication." ;
                                                                             rdfs:label "sentence_26923630_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/26923630_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/26923630_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/26923630> ;
                                                                             gutprop:hasSentenceText "Emerging evidence indicates that disruption of the gut microbial community (dysbiosis) impairs mental health." ;
                                                                             rdfs:label "sentence_26923630_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/26923630_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/26923630_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/26923630> ;
                                                                             gutprop:hasSentenceText "Germ-free mice and antibiotic-induced gut dysbiosis are two approaches to establish causality in gut microbiota-brain relationships." ;
                                                                             rdfs:label "sentence_26923630_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/26923630_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/26923630_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/26923630> ;
                                                                             gutprop:hasSentenceText "However, both models have limitations, as germ-free mice display alterations in blood-brain barrier and brain ultrastructure and antibiotics may act directly on the brain." ;
                                                                             rdfs:label "sentence_26923630_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/26923630_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/26923630_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/26923630> ;
                                                                             gutprop:hasSentenceText "We hypothesized that the concerns related to antibiotic-induced gut dysbiosis can only adequately be addressed if the effect of intragastric treatment of adult mice with multiple antibiotics on (i) gut microbial community, (ii) metabolite profile in the colon, (iii) circulating metabolites, (iv) expression of neuronal signaling molecules in distinct brain areas and (v) cognitive behavior is systematically investigated." ;
                                                                             rdfs:label "sentence_26923630_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/26923630_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/26923630_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/26923630> ;
                                                                             gutprop:hasSentenceText "Of the antibiotics used (ampicillin, bacitracin, meropenem, neomycin, vancomycin), ampicillin had some oral bioavailability but did not enter the brain." ;
                                                                             rdfs:label "sentence_26923630_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/26923630_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/26923630_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/26923630> ;
                                                                             gutprop:hasSentenceText "16S rDNA sequencing confirmed antibiotic-induced microbial community disruption, and metabolomics revealed that gut dysbiosis was associated with depletion of bacteria-derived metabolites in the colon and alterations of lipid species and converted microbe-derived molecules in the plasma." ;
                                                                             rdfs:label "sentence_26923630_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/26923630_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/26923630_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/26923630> ;
                                                                             gutprop:hasSentenceText "Importantly, novel object recognition, but not spatial, memory was impaired in antibiotic-treated mice." ;
                                                                             rdfs:label "sentence_26923630_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/26923630_8
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/26923630_8> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/26923630> ;
                                                                             gutprop:hasSentenceText "This cognitive deficit was associated with brain region-specific changes in the expression of cognition-relevant signaling molecules, notably brain-derived neurotrophic factor, N-methyl-d-aspartate receptor subunit 2B, serotonin transporter and neuropeptide Y system." ;
                                                                             rdfs:label "sentence_26923630_8" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/26923630_9
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/26923630_9> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/26923630> ;
                                                                             gutprop:hasSentenceText "We conclude that circulating metabolites and the cerebral neuropeptide Y system play an important role in the cognitive impairment and dysregulation of cerebral signaling molecules due to antibiotic-induced gut dysbiosis." ;
                                                                             rdfs:label "sentence_26923630_9" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/26927355_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/26927355_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/26927355> ;
                                                                             gutprop:hasSentenceText "Letter to the Editor: The Surge of Type 2 Diabetes Mellitus in China - an International Alert: Physical Exercise and Low-Caloric Diet May Reduce the Risks of Type 2 Diabetes Mellitus and Dementia." ;
                                                                             rdfs:label "sentence_26927355_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/26927355_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/26927355_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/26927355> ;
                                                                             gutprop:hasSentenceText "The prevalence of diabetes in China has surged from 0.67% before 1980 to 11.6% currently." ;
                                                                             rdfs:label "sentence_26927355_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/26927355_10
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/26927355_10> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/26927355> ;
                                                                              gutprop:hasSentenceText "In addition, a stool biobank of healthy persons was established at Mayo Clinic for future clinical applications." ;
                                                                              rdfs:label "sentence_26927355_10" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/26927355_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/26927355_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/26927355> ;
                                                                             gutprop:hasSentenceText "It is even higher than the prevalence in the United States." ;
                                                                             rdfs:label "sentence_26927355_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/26927355_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/26927355_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/26927355> ;
                                                                             gutprop:hasSentenceText "Certainly, China's economic open-ups, improving living standard, and modernization have propagated the surge." ;
                                                                             rdfs:label "sentence_26927355_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/26927355_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/26927355_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/26927355> ;
                                                                             gutprop:hasSentenceText "From a traditional public-health point of view, increased food intake and decreased exercise were the main contributors." ;
                                                                             rdfs:label "sentence_26927355_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/26927355_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/26927355_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/26927355> ;
                                                                             gutprop:hasSentenceText "A new knowledge of colon microbiota could be applied to provide a second harvest of food energy; for example, large molecules of carbohydrates, which are undigested by the stomach and small intestine, produce by-products that the body can absorb in the colon." ;
                                                                             rdfs:label "sentence_26927355_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/26927355_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/26927355_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/26927355> ;
                                                                             gutprop:hasSentenceText "Colon microbiota can ferment these carbohydrates to the short-chain fatty acid butyrate." ;
                                                                             rdfs:label "sentence_26927355_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/26927355_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/26927355_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/26927355> ;
                                                                             gutprop:hasSentenceText "This is an energy source that may even cause nonalcoholic fatty liver." ;
                                                                             rdfs:label "sentence_26927355_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/26927355_8
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/26927355_8> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/26927355> ;
                                                                             gutprop:hasSentenceText "How these colon microbiota contribute to the surge of diabetes and whether this new knowledge can be used to control diabetes and metabolic syndrome are questions for future scientific studies." ;
                                                                             rdfs:label "sentence_26927355_8" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/26927355_9
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/26927355_9> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/26927355> ;
                                                                             gutprop:hasSentenceText "Clinically, however, colon microbiota have had immediate applications; fecal microbiota have been transplanted from healthy persons to treat recurrent Clostridium difficile infection at Mayo Clinic." ;
                                                                             rdfs:label "sentence_26927355_9" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/27319972_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/27319972_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/27319972> ;
                                                                             gutprop:hasSentenceText "Microbes, Immunity, and Behavior: Psychoneuroimmunology Meets the Microbiome." ;
                                                                             rdfs:label "sentence_27319972_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/27319972_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/27319972_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/27319972> ;
                                                                             gutprop:hasSentenceText "There is now a large volume of evidence to support the view that the immune system is a key communication pathway between the gut and brain, which plays an important role in stress-related psychopathologies and thus provides a potentially fruitful target for psychotropic intervention." ;
                                                                             rdfs:label "sentence_27319972_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/27319972_10
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/27319972_10> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/27319972> ;
                                                                              gutprop:hasSentenceText "That early life stress can also impact adult psychopathology has long been appreciated in psychiatry." ;
                                                                              rdfs:label "sentence_27319972_10" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/27319972_11
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/27319972_11> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/27319972> ;
                                                                              gutprop:hasSentenceText "The challenge now is to fully decipher the molecular mechanisms that link the gut microbiota, immune, and central nervous systems in a network of communication that impacts behavior patterns and psychopathology, to eventually translate these findings to the human situation both in health and disease." ;
                                                                              rdfs:label "sentence_27319972_11" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/27319972_12
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/27319972_12> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/27319972> ;
                                                                              gutprop:hasSentenceText "Even at this juncture, there is evidence to pinpoint key sites of communication where gut microbial interventions either with drugs or diet or perhaps fecal microbiota transplantation may positively impact mental health." ;
                                                                              rdfs:label "sentence_27319972_12" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/27319972_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/27319972_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/27319972> ;
                                                                             gutprop:hasSentenceText "The gut microbiota is a complex ecosystem with a diverse range of organisms and a sophisticated genomic structure." ;
                                                                             rdfs:label "sentence_27319972_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/27319972_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/27319972_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/27319972> ;
                                                                             gutprop:hasSentenceText "Bacteria within the gut are estimated to weigh in excess of 1 kg in the adult human and the microbes within not only produce antimicrobial peptides, short chain fatty acids, and vitamins, but also most of the common neurotransmitters found in the human brain." ;
                                                                             rdfs:label "sentence_27319972_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/27319972_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/27319972_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/27319972> ;
                                                                             gutprop:hasSentenceText "That the microbial content of the gut plays a key role in immune development is now beyond doubt." ;
                                                                             rdfs:label "sentence_27319972_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/27319972_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/27319972_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/27319972> ;
                                                                             gutprop:hasSentenceText "Early disruption of the host-microbe interplay can have lifelong consequences, not just in terms of intestinal function but in distal organs including the brain." ;
                                                                             rdfs:label "sentence_27319972_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/27319972_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/27319972_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/27319972> ;
                                                                             gutprop:hasSentenceText "It is clear that the immune system and nervous system are in continuous communication in order to maintain a state of homeostasis." ;
                                                                             rdfs:label "sentence_27319972_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/27319972_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/27319972_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/27319972> ;
                                                                             gutprop:hasSentenceText "Significant gaps in knowledge remain about the effect of the gut microbiota in coordinating the immune-nervous systems dialogue." ;
                                                                             rdfs:label "sentence_27319972_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/27319972_8
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/27319972_8> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/27319972> ;
                                                                             gutprop:hasSentenceText "However, studies using germ-free animals, infective models, prebiotics, probiotics, and antibiotics have increased our understanding of the interplay." ;
                                                                             rdfs:label "sentence_27319972_8" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/27319972_9
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/27319972_9> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/27319972> ;
                                                                             gutprop:hasSentenceText "Early life stress can have a lifelong impact on the microbial content of the intestine and permanently alter immune functioning." ;
                                                                             rdfs:label "sentence_27319972_9" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/27566465_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/27566465_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/27566465> ;
                                                                             gutprop:hasSentenceText "Alzheimer's disease and gut microbiota." ;
                                                                             rdfs:label "sentence_27566465_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/27566465_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/27566465_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/27566465> ;
                                                                             gutprop:hasSentenceText "Alzheimer's disease (AD) is a most common neurodegenerative disorder, which associates with impaired cognition." ;
                                                                             rdfs:label "sentence_27566465_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/27566465_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/27566465_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/27566465> ;
                                                                             gutprop:hasSentenceText "Gut microbiota can modulate host brain function and behavior via microbiota-gut-brain axis, including cognitive behavior." ;
                                                                             rdfs:label "sentence_27566465_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/27566465_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/27566465_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/27566465> ;
                                                                             gutprop:hasSentenceText "Germ-free animals, antibiotics, probiotics intervention and diet can induce alterations of gut microbiota and gut physiology and also host cognitive behavior, increasing or decreasing risks of AD." ;
                                                                             rdfs:label "sentence_27566465_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/27566465_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/27566465_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/27566465> ;
                                                                             gutprop:hasSentenceText "The increased permeability of intestine and blood-brain barrier induced by gut microbiota disturbance will increase the incidence of neurodegeneration disorders." ;
                                                                             rdfs:label "sentence_27566465_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/27566465_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/27566465_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/27566465> ;
                                                                             gutprop:hasSentenceText "Gut microbial metabolites and their effects on host neurochemical changes may increase or decrease the risk of AD." ;
                                                                             rdfs:label "sentence_27566465_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/27566465_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/27566465_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/27566465> ;
                                                                             gutprop:hasSentenceText "Pathogenic microbes infection will also increase the risk of AD, and meanwhile, the onset of AD support the \"hygiene hypothesis\"." ;
                                                                             rdfs:label "sentence_27566465_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/27566465_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/27566465_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/27566465> ;
                                                                             gutprop:hasSentenceText "All the results suggest that AD may begin in the gut, and is closely related to the imbalance of gut microbiota." ;
                                                                             rdfs:label "sentence_27566465_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/27566465_8
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/27566465_8> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/27566465> ;
                                                                             gutprop:hasSentenceText "Modulation of gut microbiota through personalized diet or beneficial microbiota intervention will probably become a new treatment for AD." ;
                                                                             rdfs:label "sentence_27566465_8" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/27698624_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/27698624_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/27698624> ;
                                                                             gutprop:hasSentenceText "Integrative Therapies in Anxiety Treatment with Special Emphasis on the Gut Microbiome." ;
                                                                             rdfs:label "sentence_27698624_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/27698624_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/27698624_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/27698624> ;
                                                                             gutprop:hasSentenceText "Over the past decade, research has shown that diet and gut health affects symptoms expressed in stress related disorders, depression, and anxiety through changes in the gut microbiota." ;
                                                                             rdfs:label "sentence_27698624_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/27698624_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/27698624_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/27698624> ;
                                                                             gutprop:hasSentenceText "Psycho-behavioral function and somatic health interaction have often been ignored in health care with resulting deficits in treatment quality and outcomes." ;
                                                                             rdfs:label "sentence_27698624_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/27698624_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/27698624_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/27698624> ;
                                                                             gutprop:hasSentenceText "While mental health care requires the professional training in counseling, psychotherapy and psychiatry, complimentary therapeutic strategies, such as attention to a nutritional and diverse diet and supplementation of probiotic foods, may be integrated alongside psychotherapy treatment models." ;
                                                                             rdfs:label "sentence_27698624_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/27698624_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/27698624_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/27698624> ;
                                                                             gutprop:hasSentenceText "Development of these alternative strategies is predicated on experimental evidence and diligent research on the biology of stress, fear, anxiety-related behaviors, and the gut-brain connection." ;
                                                                             rdfs:label "sentence_27698624_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/27698624_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/27698624_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/27698624> ;
                                                                             gutprop:hasSentenceText "This article provides a brief overview on biological markers of anxiety and the expanding nutritional literature relating to brain health and mental disorders." ;
                                                                             rdfs:label "sentence_27698624_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/27698624_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/27698624_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/27698624> ;
                                                                             gutprop:hasSentenceText "A case study demonstrates an example of a biopsychosocial approach integrating cognitive psychotherapy, dietary changes, and mindfulness activities, in treating symptoms of anxiety." ;
                                                                             rdfs:label "sentence_27698624_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/27698624_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/27698624_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/27698624> ;
                                                                             gutprop:hasSentenceText "This case study shows a possible treatment protocol to explore the efficacy of targeting the gut-brain-axis that may be used as an impetus for future controlled studies." ;
                                                                             rdfs:label "sentence_27698624_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/27763700_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/27763700_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/27763700> ;
                                                                             gutprop:hasSentenceText "Early life diets with prebiotics and bioactive milk fractions attenuate the impact of stress on learned helplessness behaviours and alter gene expression within neural circuits important for stress resistance." ;
                                                                             rdfs:label "sentence_27763700_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/27763700_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/27763700_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/27763700> ;
                                                                             gutprop:hasSentenceText "Manipulating gut microbes may improve mental health." ;
                                                                             rdfs:label "sentence_27763700_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/27763700_10
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/27763700_10> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/27763700> ;
                                                                              gutprop:hasSentenceText "These data suggest early life diets containing prebiotics and/or LAC promote behavioural stress resistance and uniquely modulate gene expression in corresponding circuits." ;
                                                                              rdfs:label "sentence_27763700_10" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/27763700_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/27763700_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/27763700> ;
                                                                             gutprop:hasSentenceText "Prebiotics are indigestible compounds that increase the growth and activity of health-promoting microorganisms, yet few studies have examined how prebiotics affect CNS function." ;
                                                                             rdfs:label "sentence_27763700_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/27763700_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/27763700_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/27763700> ;
                                                                             gutprop:hasSentenceText "Using an acute inescapable stressor known to produce learned helplessness behaviours such as failure to escape and exaggerated fear, we tested whether early life supplementation of a blend of two prebiotics, galactooligosaccharide (GOS) and polydextrose (PDX), and the glycoprotein lactoferrin (LAC) would attenuate behavioural and biological responses to stress later in life." ;
                                                                             rdfs:label "sentence_27763700_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/27763700_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/27763700_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/27763700> ;
                                                                             gutprop:hasSentenceText "Juvenile, male F344 rats were fed diets containing either GOS and PDX alone, LAC alone, or GOS, PDX and LAC." ;
                                                                             rdfs:label "sentence_27763700_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/27763700_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/27763700_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/27763700> ;
                                                                             gutprop:hasSentenceText "All diets altered gut bacteria, while diets containing GOS and PDX increased Lactobacillus spp." ;
                                                                             rdfs:label "sentence_27763700_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/27763700_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/27763700_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/27763700> ;
                                                                             gutprop:hasSentenceText "After 4 weeks, rats were exposed to inescapable stress, and either immediately killed for blood and tissues, or assessed for learned helplessness 24 h later." ;
                                                                             rdfs:label "sentence_27763700_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/27763700_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/27763700_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/27763700> ;
                                                                             gutprop:hasSentenceText "Diets did not attenuate stress effects on spleen weight, corticosterone and blood glucose; however, all diets differentially attenuated stress-induced learned helplessness." ;
                                                                             rdfs:label "sentence_27763700_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/27763700_8
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/27763700_8> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/27763700> ;
                                                                             gutprop:hasSentenceText "Notably, in situ hybridization revealed that all diets reduced stress-evoked cfos mRNA in the dorsal raphe nucleus (DRN), a structure important for learned helplessness behaviours." ;
                                                                             rdfs:label "sentence_27763700_8" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/27763700_9
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/27763700_9> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/27763700> ;
                                                                             gutprop:hasSentenceText "In addition, GOS, PDX and LAC diet attenuated stress-evoked decreases in mRNA for the 5-HT<sub>1A</sub> autoreceptor in the DRN and increased basal BDNF mRNA within the prefrontal cortex." ;
                                                                             rdfs:label "sentence_27763700_9" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/27793225_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/27793225_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/27793225> ;
                                                                             gutprop:hasSentenceText "The Importance of Diet and Gut Health to the Treatment and Prevention of Mental Disorders." ;
                                                                             rdfs:label "sentence_27793225_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/27793225_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/27793225_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/27793225> ;
                                                                             gutprop:hasSentenceText "The departure from traditional lifestyles and the rising disease burden of mental disorders are increasing global health concerns." ;
                                                                             rdfs:label "sentence_27793225_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/27793225_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/27793225_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/27793225> ;
                                                                             gutprop:hasSentenceText "Changes in diet around the world mean that populations are now increasingly reliant on highly processed, poor quality foods, which have been linked to increased risk for mental disorder." ;
                                                                             rdfs:label "sentence_27793225_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/27793225_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/27793225_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/27793225> ;
                                                                             gutprop:hasSentenceText "Conversely, a nutrient-rich diet is understood to be protective of mental health, and researchers are now aiming to understand the biological underpinnings of this relationship." ;
                                                                             rdfs:label "sentence_27793225_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/27793225_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/27793225_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/27793225> ;
                                                                             gutprop:hasSentenceText "The gut microbiota has been proposed as a key mediator of this link, given its association with both diet and mental health." ;
                                                                             rdfs:label "sentence_27793225_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/27793225_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/27793225_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/27793225> ;
                                                                             gutprop:hasSentenceText "Importantly, several critical \"windows of opportunity\" for prevention and intervention have been identified, particularly early life and adolescence; these are periods of rapid development and transition that provide a foundation for future health." ;
                                                                             rdfs:label "sentence_27793225_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/27793225_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/27793225_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/27793225> ;
                                                                             gutprop:hasSentenceText "Strategies that promote overall diet quality, high in fiber and nutrients, have been linked to increased microbial diversity and gut health." ;
                                                                             rdfs:label "sentence_27793225_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/27793225_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/27793225_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/27793225> ;
                                                                             gutprop:hasSentenceText "Improving diet quality and subsequent gut health may have benefits for individuals' mental health, as well as the mental health of future generations." ;
                                                                             rdfs:label "sentence_27793225_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/27793225_8
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/27793225_8> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/27793225> ;
                                                                             gutprop:hasSentenceText "Here we discuss specific, targeted dietary and gut focused strategies for the prevention and treatment of mental disorder." ;
                                                                             rdfs:label "sentence_27793225_8" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/27900676_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/27900676_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/27900676> ;
                                                                             gutprop:hasSentenceText "Functional Implications of the IL-23/IL-17 Immune Axis in Schizophrenia." ;
                                                                             rdfs:label "sentence_27900676_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/27900676_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/27900676_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/27900676> ;
                                                                             gutprop:hasSentenceText "The aetiology of schizophrenia seems to stem from complex interactions amongst environmental, genetic, metabolic, immunologic and oxidative components." ;
                                                                             rdfs:label "sentence_27900676_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/27900676_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/27900676_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/27900676> ;
                                                                             gutprop:hasSentenceText "Chronic low-grade inflammation has been persistently linked to schizophrenia, and this has primarily been based on the findings derived from Th1/Th2 cytokine balance." ;
                                                                             rdfs:label "sentence_27900676_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/27900676_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/27900676_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/27900676> ;
                                                                             gutprop:hasSentenceText "While the IL-23/IL-17 axis plays crucial role in the pathogenesis of several immune-mediated disorders, it has remained relatively unexplored in neuropsychiatric disorders." ;
                                                                             rdfs:label "sentence_27900676_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/27900676_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/27900676_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/27900676> ;
                                                                             gutprop:hasSentenceText "Altered levels of cytokines related to IL-23/IL-17 axis have been observed in schizophrenia patients in a few studies." ;
                                                                             rdfs:label "sentence_27900676_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/27900676_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/27900676_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/27900676> ;
                                                                             gutprop:hasSentenceText "In addition, other indirect factors known to confer schizophrenia risk like complement activation and altered gut microbiota are shown to modulate the IL-23/IL-17 axis." ;
                                                                             rdfs:label "sentence_27900676_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/27900676_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/27900676_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/27900676> ;
                                                                             gutprop:hasSentenceText "These preliminary observations provide crucial clues about the functional implications of IL-23/IL-17 axis in schizophrenia." ;
                                                                             rdfs:label "sentence_27900676_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/27900676_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/27900676_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/27900676> ;
                                                                             gutprop:hasSentenceText "In this review, an attempt has been made to highlight the biology of IL-23/IL-17 axis and its relevance to schizophrenia risk and pathogenesis." ;
                                                                             rdfs:label "sentence_27900676_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/27900676_8
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/27900676_8> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/27900676> ;
                                                                             gutprop:hasSentenceText "Given the pathogenic potential of the IL-23/IL-17 axis, therapeutic targeting of this axis may be a promising approach to benefit patients suffering from this devastating disorder." ;
                                                                             rdfs:label "sentence_27900676_8" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/27930574_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/27930574_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/27930574> ;
                                                                             gutprop:hasSentenceText "A MeSH-based text mining method for identifying novel prebiotics." ;
                                                                             rdfs:label "sentence_27930574_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/27930574_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/27930574_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/27930574> ;
                                                                             gutprop:hasSentenceText "Prebiotics contribute to the well-being of their host by altering the composition of the gut microbiota." ;
                                                                             rdfs:label "sentence_27930574_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/27930574_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/27930574_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/27930574> ;
                                                                             gutprop:hasSentenceText "Discovering new prebiotics is a challenging and arduous task due to strict inclusion criteria; thus, highly limited numbers of prebiotic candidates have been identified." ;
                                                                             rdfs:label "sentence_27930574_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/27930574_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/27930574_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/27930574> ;
                                                                             gutprop:hasSentenceText "Notably, the large numbers of published studies may contain substantial information attached to various features of known prebiotics that can be used to predict new candidates." ;
                                                                             rdfs:label "sentence_27930574_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/27930574_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/27930574_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/27930574> ;
                                                                             gutprop:hasSentenceText "In this paper, we propose a medical subject headings (MeSH)-based text mining method for identifying new prebiotics with structured texts obtained from PubMed." ;
                                                                             rdfs:label "sentence_27930574_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/27930574_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/27930574_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/27930574> ;
                                                                             gutprop:hasSentenceText "We defined an optimal feature set for prebiotics prediction using a systematic feature-ranking algorithm with which a variety of carbohydrates can be accurately classified into different clusters in accordance with their chemical and biological attributes." ;
                                                                             rdfs:label "sentence_27930574_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/27930574_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/27930574_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/27930574> ;
                                                                             gutprop:hasSentenceText "The optimal feature set was used to separate positive prebiotics from other carbohydrates, and a cross-validation procedure was employed to assess the prediction accuracy of the model." ;
                                                                             rdfs:label "sentence_27930574_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/27930574_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/27930574_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/27930574> ;
                                                                             gutprop:hasSentenceText "Our method achieved a specificity of 0.876 and a sensitivity of 0.838." ;
                                                                             rdfs:label "sentence_27930574_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/27930574_8
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/27930574_8> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/27930574> ;
                                                                             gutprop:hasSentenceText "Finally, we identified a high-confidence list of candidates of prebiotics that are strongly supported by the literature." ;
                                                                             rdfs:label "sentence_27930574_8" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/27930574_9
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/27930574_9> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/27930574> ;
                                                                             gutprop:hasSentenceText "Our study demonstrates that text mining from high-volume biomedical literature is a promising approach in searching for new prebiotics." ;
                                                                             rdfs:label "sentence_27930574_9" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28073356_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28073356_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/28073356> ;
                                                                             gutprop:hasSentenceText "Gut microbiota disturbance during helminth infection: can it affect cognition and behaviour of children?" ;
                                                                             rdfs:label "sentence_28073356_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28073356_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28073356_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/28073356> ;
                                                                             gutprop:hasSentenceText "Bidirectional signalling between the brain and the gastrointestinal tract is regulated at neural, hormonal, and immunological levels." ;
                                                                             rdfs:label "sentence_28073356_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28073356_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28073356_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/28073356> ;
                                                                             gutprop:hasSentenceText "Recent studies have shown that helminth infections can alter the normal gut microbiota." ;
                                                                             rdfs:label "sentence_28073356_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28073356_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28073356_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/28073356> ;
                                                                             gutprop:hasSentenceText "Studies have also shown that the gut microbiota is instrumental in the normal development, maturation and function of the brain." ;
                                                                             rdfs:label "sentence_28073356_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28073356_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28073356_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/28073356> ;
                                                                             gutprop:hasSentenceText "The pathophysiological pathways by which helminth infections contribute to altered cognitive function remain poorly understood." ;
                                                                             rdfs:label "sentence_28073356_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28073356_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28073356_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/28073356> ;
                                                                             gutprop:hasSentenceText "We put forward the hypothesis that gastrointestinal infections with parasitic worms, such as helminths, induce an imbalance of the gut-brain axis, which, in turn, can detrimentally manifest in brain development." ;
                                                                             rdfs:label "sentence_28073356_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28073356_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28073356_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/28073356> ;
                                                                             gutprop:hasSentenceText "Factors supporting this hypothesis are: 1) research focusing on intelligence and school performance in school-aged children has shown helminth infections to be associated with cognitive impairment, 2) disturbances in gut microbiota have been shown to be associated with important cognitive developmental effects, and 3) helminth infections have been shown to alter the gut microbiota structure." ;
                                                                             rdfs:label "sentence_28073356_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28073356_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28073356_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/28073356> ;
                                                                             gutprop:hasSentenceText "Evidence on the complex interactions between extrinsic (parasite) and intrinsic (host-derived) factors has been synthesised and discussed." ;
                                                                             rdfs:label "sentence_28073356_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28073356_8
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28073356_8> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/28073356> ;
                                                                             gutprop:hasSentenceText "While evidence in favour of the helminth-gut microbiota-central nervous system hypothesis is circumstantial, it would be unwise to rule it out as a possible mechanism by which gastrointestinal helminth infections induce childhood cognitive morbidity." ;
                                                                             rdfs:label "sentence_28073356_8" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28073356_9
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28073356_9> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/28073356> ;
                                                                             gutprop:hasSentenceText "Further empirical studies are necessary to test an indirect effect of helminth infections on the modulation of mood and behaviour through its effects on the gut microbiota." ;
                                                                             rdfs:label "sentence_28073356_9" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28158162_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28158162_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/28158162> ;
                                                                             gutprop:hasSentenceText "Potential Beneficial Effects of Probiotics on Human Migraine Headache: A Literature Review." ;
                                                                             rdfs:label "sentence_28158162_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28158162_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28158162_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/28158162> ;
                                                                             gutprop:hasSentenceText "Recent studies have shown that migraine headache is often associated with concomitant gastrointestinal diseases." ;
                                                                             rdfs:label "sentence_28158162_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28158162_10
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28158162_10> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/28158162> ;
                                                                              gutprop:hasSentenceText "The potential effects of probiotics supplement on migraine headache were also included." ;
                                                                              rdfs:label "sentence_28158162_10" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28158162_11
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28158162_11> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/28158162> ;
                                                                              gutprop:hasSentenceText "There is limited evidence from clinical studies of the positive effects of probiotics in patients with migraine headache." ;
                                                                              rdfs:label "sentence_28158162_11" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28158162_12
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28158162_12> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/28158162> ;
                                                                              gutprop:hasSentenceText "Large-scale randomized, placebo-controlled clinical trials are warranted to evaluate the clinical efficacy and safety of probiotics in patients with migraine headache." ;
                                                                              rdfs:label "sentence_28158162_12" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28158162_13
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28158162_13> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/28158162> ;
                                                                              gutprop:hasSentenceText "Similar to migraine headache, disorders of the brain involving depression and anxiety have been demonstrated to be associated with increased gut permeability." ;
                                                                              rdfs:label "sentence_28158162_13" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28158162_14
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28158162_14> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/28158162> ;
                                                                              gutprop:hasSentenceText "An improvement in gut microbiota and reduction of inflammation can have positive effects on strengthening gut and brain function." ;
                                                                              rdfs:label "sentence_28158162_14" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28158162_15
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28158162_15> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/28158162> ;
                                                                              gutprop:hasSentenceText "Moreover, it can be inferred that probiotics may have a beneficial effect on the frequency and severity of migraine headache attacks." ;
                                                                              rdfs:label "sentence_28158162_15" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28158162_16
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28158162_16> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/28158162> ;
                                                                              gutprop:hasSentenceText "Large-scale randomized, placebo-controlled studies are warranted in the future to evaluate the clinical efficacy and safety of probiotics in patients with migraine headache.Key words: Migraine headache, gut microbiota, brain function, probiotics." ;
                                                                              rdfs:label "sentence_28158162_16" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28158162_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28158162_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/28158162> ;
                                                                             gutprop:hasSentenceText "There is a higher prevalence of headaches in patients with gastrointestinal disorders." ;
                                                                             rdfs:label "sentence_28158162_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28158162_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28158162_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/28158162> ;
                                                                             gutprop:hasSentenceText "These associations between migraine and gastrointestinal disorders suggest a potential link to a bidirectional modulation of gut microbiota and brain function." ;
                                                                             rdfs:label "sentence_28158162_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28158162_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28158162_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/28158162> ;
                                                                             gutprop:hasSentenceText "The underlying working mechanistic links between migraine and gastrointestinal diseases may include increased intestinal epithelial permeability and inflammation." ;
                                                                             rdfs:label "sentence_28158162_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28158162_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28158162_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/28158162> ;
                                                                             gutprop:hasSentenceText "This review presents an overview of the relationship between gut microbiota and brain function, especially with regard to migraine headache." ;
                                                                             rdfs:label "sentence_28158162_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28158162_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28158162_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/28158162> ;
                                                                             gutprop:hasSentenceText "Literature review." ;
                                                                             rdfs:label "sentence_28158162_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28158162_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28158162_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/28158162> ;
                                                                             gutprop:hasSentenceText "Anesthesia and Operation Center, Department of Anesthesiology, Chinese PLA General Hospital." ;
                                                                             rdfs:label "sentence_28158162_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28158162_8
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28158162_8> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/28158162> ;
                                                                             gutprop:hasSentenceText "The present investigation included a PubMed search using the following terms: migraine headache, gut microbiota, brain function, and probiotics." ;
                                                                             rdfs:label "sentence_28158162_8" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28158162_9
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28158162_9> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/28158162> ;
                                                                             gutprop:hasSentenceText "In this literature review, we mainly discussed the relationship between gut microbiota and brain function, especially with regard to migraine headache." ;
                                                                             rdfs:label "sentence_28158162_9" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28399458_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28399458_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/28399458> ;
                                                                             gutprop:hasSentenceText "The role of maternal anxiety and depressive disorders prior to and during pregnancy and perinatal psychopathological symptoms for early infant diseases and drug administration." ;
                                                                             rdfs:label "sentence_28399458_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28399458_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28399458_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/28399458> ;
                                                                             gutprop:hasSentenceText "Maternal mental health prior to and during pregnancy has been shown to be associated with inflammatory diseases and gastrointestinal complaints in the offspring." ;
                                                                             rdfs:label "sentence_28399458_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28399458_10
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28399458_10> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/28399458> ;
                                                                              gutprop:hasSentenceText "fetal programming)." ;
                                                                              rdfs:label "sentence_28399458_10" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28399458_11
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28399458_11> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/28399458> ;
                                                                              gutprop:hasSentenceText "Moreover, the association between maternal anxiety and depressive disorders and infant gastrointestinal complaints may be explained by an anxious misinterpretation of 'normal' infant signals or a transmission of adverse gut microbiota, respectively." ;
                                                                              rdfs:label "sentence_28399458_11" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28399458_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28399458_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/28399458> ;
                                                                             gutprop:hasSentenceText "Unfortunately, many studies merely focused on perinatal distress without consideration of lifetime anxiety and depressive disorders." ;
                                                                             rdfs:label "sentence_28399458_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28399458_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28399458_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/28399458> ;
                                                                             gutprop:hasSentenceText "To prospectively investigate associations of anxiety and depressive disorders prior to and during pregnancy as well as perinatal distress with infants' inflammatory diseases, gastrointestinal complaints and corresponding drug administration." ;
                                                                             rdfs:label "sentence_28399458_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28399458_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28399458_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/28399458> ;
                                                                             gutprop:hasSentenceText "Prospective-longitudinal study initiated in 2009/2010." ;
                                                                             rdfs:label "sentence_28399458_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28399458_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28399458_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/28399458> ;
                                                                             gutprop:hasSentenceText "N=306 (expectant) mothers with and without DSM-IV lifetime anxiety and depressive disorders (Composite International Diagnostic Interview for Women) and low vs. high severity of psychopathological symptoms during pregnancy (Brief Symptom Inventory) enrolled in early pregnancy and repeatedly assessed during peripartum period." ;
                                                                             rdfs:label "sentence_28399458_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28399458_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28399458_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/28399458> ;
                                                                             gutprop:hasSentenceText "Infant inflammatory diseases, gastrointestinal complaints and drug administration assessed via questionnaire (maternal report) at four months postpartum (n=279)." ;
                                                                             rdfs:label "sentence_28399458_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28399458_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28399458_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/28399458> ;
                                                                             gutprop:hasSentenceText "Severe psychopathological symptoms during pregnancy were associated with inflammatory diseases and anti-infective medication, whereas anxiety and depressive disorders prior to and during pregnancy were related to gastrointestinal complaints (diarrhea, colic complaints) and corresponding medication." ;
                                                                             rdfs:label "sentence_28399458_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28399458_8
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28399458_8> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/28399458> ;
                                                                             gutprop:hasSentenceText "These results have to be discussed with caution, because information on infants' diseases were based exclusively on maternal self-reports." ;
                                                                             rdfs:label "sentence_28399458_8" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28399458_9
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28399458_9> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/28399458> ;
                                                                             gutprop:hasSentenceText "However, they suggest promising directions regarding our current knowledge about the relevance of maternal perinatal distress for infant inflammatory diseases (e.g." ;
                                                                             rdfs:label "sentence_28399458_9" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28442250_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28442250_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/28442250> ;
                                                                             gutprop:hasSentenceText "Analysis of microbiota in first episode psychosis identifies preliminary associations with symptom severity and treatment response." ;
                                                                             rdfs:label "sentence_28442250_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28442250_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28442250_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/28442250> ;
                                                                             gutprop:hasSentenceText "The effects of gut microbiota on the central nervous system, along its possible role in mental disorders, have received increasing attention." ;
                                                                             rdfs:label "sentence_28442250_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28442250_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28442250_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/28442250> ;
                                                                             gutprop:hasSentenceText "Here we investigated differences in fecal microbiota between 28 patients with first-episode psychosis (FEP) and 16 healthy matched controls and explored whether such differences were associated with response after up to 12months of treatment." ;
                                                                             rdfs:label "sentence_28442250_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28442250_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28442250_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/28442250> ;
                                                                             gutprop:hasSentenceText "Numbers of Lactobacillus group bacteria were elevated in FEP-patients and significantly correlated with severity along different symptom domains." ;
                                                                             rdfs:label "sentence_28442250_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28442250_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28442250_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/28442250> ;
                                                                             gutprop:hasSentenceText "A subgroup of FEP patients with the strongest microbiota differences also showed poorer response after up to 12months of treatment." ;
                                                                             rdfs:label "sentence_28442250_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28442250_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28442250_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/28442250> ;
                                                                             gutprop:hasSentenceText "The present findings support the involvement of microbiota alterations in psychotic illness and may provide the basis for exploring the benefit of their modulation on treatment response and remission." ;
                                                                             rdfs:label "sentence_28442250_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28556833_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28556833_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/28556833> ;
                                                                             gutprop:hasSentenceText "Blockade of interleukin-6 receptor in the periphery promotes rapid and sustained antidepressant actions: a possible role of gut-microbiota-brain axis." ;
                                                                             rdfs:label "sentence_28556833_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28556833_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28556833_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/28556833> ;
                                                                             gutprop:hasSentenceText "Depression is a common, severe and chronic psychiatric disease." ;
                                                                             rdfs:label "sentence_28556833_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28556833_10
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28556833_10> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/28556833> ;
                                                                              gutprop:hasSentenceText "These findings suggest that peripheral IL-6 has a key role in the pathogenesis of depression and that the blockade of IL-6 receptor in the periphery might have rapid-onset and long-lasting antidepressant effects by normalizing the altered composition of gut microbiota in susceptible mice after social defeat stress." ;
                                                                              rdfs:label "sentence_28556833_10" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28556833_11
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28556833_11> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/28556833> ;
                                                                              gutprop:hasSentenceText "Therefore, the blockade of IL-6 receptor in the periphery shows promise as a novel therapeutic approach for depressed patients with higher IL-6 blood levels." ;
                                                                              rdfs:label "sentence_28556833_11" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28556833_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28556833_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/28556833> ;
                                                                             gutprop:hasSentenceText "Although the currently available antidepressants have been used in the treatment of depression, their beneficial effects are limited." ;
                                                                             rdfs:label "sentence_28556833_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28556833_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28556833_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/28556833> ;
                                                                             gutprop:hasSentenceText "Accumulating evidence suggests that pro-inflammatory cytokines such as interleukin-6 (IL-6) have an important role in the pathogenesis of depression." ;
                                                                             rdfs:label "sentence_28556833_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28556833_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28556833_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/28556833> ;
                                                                             gutprop:hasSentenceText "This study was undertaken to examine whether anti-mouse IL-6 receptor antibody (MR16-1) induces antidepressant effects in a social defeat stress model." ;
                                                                             rdfs:label "sentence_28556833_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28556833_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28556833_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/28556833> ;
                                                                             gutprop:hasSentenceText "Intravenous injection of MR16-1 induced rapid-onset and long-lasting antidepressant effects in susceptible mice after social defeat stress through its anti-inflammatory actions." ;
                                                                             rdfs:label "sentence_28556833_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28556833_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28556833_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/28556833> ;
                                                                             gutprop:hasSentenceText "In contrast, intracerebroventricular injection of MR16-1 induced no antidepressant effects in susceptible mice." ;
                                                                             rdfs:label "sentence_28556833_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28556833_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28556833_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/28556833> ;
                                                                             gutprop:hasSentenceText "Furthermore, treatment with MR16-1 could significantly normalize alterations in the expression of synaptic proteins (postsynaptic density protein 95 and α-amino-3-hydroxy-5-methyl-4-isoxazolepropionic acid receptor 1) and dendritic spine density in the brain regions of susceptible mice." ;
                                                                             rdfs:label "sentence_28556833_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28556833_8
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28556833_8> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/28556833> ;
                                                                             gutprop:hasSentenceText "Gut microbiota analysis using 16S ribosomal RNA gene sequencing showed that MR16-1 significantly improved decreased Firmicutes/Bacteroidetes ratio in susceptible mice." ;
                                                                             rdfs:label "sentence_28556833_8" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28556833_9
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28556833_9> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/28556833> ;
                                                                             gutprop:hasSentenceText "It also significantly improved decreased levels of Oscillospira in susceptible mice." ;
                                                                             rdfs:label "sentence_28556833_9" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28572752_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28572752_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/28572752> ;
                                                                             gutprop:hasSentenceText "Chronic alcohol overconsumption may alter gut microbial metabolism: a retrospective study of 719 <sup>13</sup>C-D-xylose breath test results." ;
                                                                             rdfs:label "sentence_28572752_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28572752_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28572752_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/28572752> ;
                                                                             gutprop:hasSentenceText "<b>Objective</b>: Alterations of gut microbiota composition or function may participate in the pathophysiology of several diseases." ;
                                                                             rdfs:label "sentence_28572752_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28572752_10
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28572752_10> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/28572752> ;
                                                                              gutprop:hasSentenceText "<b>Conclusion</b>: The results suggest that patients with a history of alcohol overconsumption suffer from both small intestinal malabsorption and impaired colonic microbial metabolism." ;
                                                                              rdfs:label "sentence_28572752_10" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28572752_11
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28572752_11> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/28572752> ;
                                                                              gutprop:hasSentenceText "The role of gut microbiota in chronic alcohol overconsumption should be investigated further." ;
                                                                              rdfs:label "sentence_28572752_11" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28572752_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28572752_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/28572752> ;
                                                                             gutprop:hasSentenceText "We aimed to explore the effect of chronic alcohol overconsumption on gut microbial metabolism, as assessed by evaluating <sup>13</sup>C-D-xylose breath test results." ;
                                                                             rdfs:label "sentence_28572752_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28572752_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28572752_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/28572752> ;
                                                                             gutprop:hasSentenceText "<b>Materials and methods</b>: We investigated all <sup>13</sup>C-D-xylose breath tests performed at Lovisenberg Diaconal Hospital during the years 2005 to 2011, using patient files for diagnosing the patients into one of three patient categories: alcohol overconsumption, coeliac disease and functional bowel disorder." ;
                                                                             rdfs:label "sentence_28572752_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28572752_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28572752_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/28572752> ;
                                                                             gutprop:hasSentenceText "In addition, a group of healthy controls was included." ;
                                                                             rdfs:label "sentence_28572752_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28572752_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28572752_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/28572752> ;
                                                                             gutprop:hasSentenceText "The time curves of <sup>13</sup>CO<sub>2</sub> excretion in breath samples were divided into two phases, evaluating small intestinal absorption (0-60 min) and colonic microbial metabolism (90-240 min), respectively." ;
                                                                             rdfs:label "sentence_28572752_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28572752_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28572752_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/28572752> ;
                                                                             gutprop:hasSentenceText "<b>Results</b>: A total of 719 patients underwent <sup>13</sup>C-D-xylose breath testing during the inclusion period." ;
                                                                             rdfs:label "sentence_28572752_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28572752_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28572752_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/28572752> ;
                                                                             gutprop:hasSentenceText "Thirty-five had a history of alcohol overconsumption, 66 had coeliac disease, and 216 had a functional bowel disorder, while 44 healthy controls were included for comparison." ;
                                                                             rdfs:label "sentence_28572752_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28572752_8
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28572752_8> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/28572752> ;
                                                                             gutprop:hasSentenceText "The alcohol overconsumption group had similar small intestinal phase results as the group of patients with untreated coeliac disease." ;
                                                                             rdfs:label "sentence_28572752_8" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28572752_9
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28572752_9> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/28572752> ;
                                                                             gutprop:hasSentenceText "During the colonic phase, the group of patients with alcohol overconsumption differed from all the other groups in terms of <sup>13</sup>C-xylose recovery, with significantly less <sup>13</sup>CO<sub>2</sub> excretion compared to the other groups." ;
                                                                             rdfs:label "sentence_28572752_9" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28629758_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28629758_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/28629758> ;
                                                                             gutprop:hasSentenceText "Implications of the gut microbiota in vulnerability to the social avoidance effects of chronic social defeat in male mice." ;
                                                                             rdfs:label "sentence_28629758_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28629758_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28629758_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/28629758> ;
                                                                             gutprop:hasSentenceText "Appreciable evidence suggests that perturbations within the gut microbiome and the immune system may play a key role in the pathogenesis of depression stemming from earlier stressful experiences." ;
                                                                             rdfs:label "sentence_28629758_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28629758_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28629758_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/28629758> ;
                                                                             gutprop:hasSentenceText "In the present investigation we examined whether microbial changes in cecum contents were associated with social avoidance behaviors, a feature of depression, and pro-inflammatory variations among socially stressed mice." ;
                                                                             rdfs:label "sentence_28629758_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28629758_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28629758_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/28629758> ;
                                                                             gutprop:hasSentenceText "Male C57BL/6 mice experienced social defeat or a control condition once a day for 10 consecutive days." ;
                                                                             rdfs:label "sentence_28629758_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28629758_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28629758_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/28629758> ;
                                                                             gutprop:hasSentenceText "Social avoidance behaviors were examined three weeks after the last defeat or control episode and blood, brain, and cecum contents were collected 24h afterward for the determination of corticosterone, pro-inflammatory cytokines, and microbial populations." ;
                                                                             rdfs:label "sentence_28629758_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28629758_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28629758_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/28629758> ;
                                                                             gutprop:hasSentenceText "Mice that were most susceptible to the behavioral effects of chronic social defeat (reflected by severe social avoidance behaviors) displayed the greatest changes within particular sets of bacteria at the phylum and genus taxonomic ranks." ;
                                                                             rdfs:label "sentence_28629758_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28629758_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28629758_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/28629758> ;
                                                                             gutprop:hasSentenceText "Although plasma and brain cytokines were not significantly altered in socially defeated mice, changes in the mRNA expression of interleukin (IL)-1β and IL-6 within the prefrontal cortex were associated with elevated abundance of Flavobacterium spp." ;
                                                                             rdfs:label "sentence_28629758_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28629758_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28629758_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/28629758> ;
                                                                             gutprop:hasSentenceText "and reduced abundance of Turicibacter spp., which were also strongly correlated to social avoidance severity." ;
                                                                             rdfs:label "sentence_28629758_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28629758_8
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28629758_8> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/28629758> ;
                                                                             gutprop:hasSentenceText "Although at this time a causal connection cannot be inferred, these results point to the possibility that specific clusters of bacterial communities in cecum contents may be linked to vulnerability to social deficits stemming from prolonged social stressor experiences." ;
                                                                             rdfs:label "sentence_28629758_8" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28716445_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28716445_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/28716445> ;
                                                                             gutprop:hasSentenceText "Feeding Systems and the Gut Microbiome: Gut-Brain Interactions With Relevance to Psychiatric Conditions." ;
                                                                             rdfs:label "sentence_28716445_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28716445_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28716445_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/28716445> ;
                                                                             gutprop:hasSentenceText "Physical and mental health is dependent on the environment, and feeding is a prime example of this environmental exchange." ;
                                                                             rdfs:label "sentence_28716445_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28716445_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28716445_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/28716445> ;
                                                                             gutprop:hasSentenceText "While the hypothalamus controls both feeding behavior and the stress response, the integration of the neural control centers and the peripheral gut allows for disruption in the gastrointestinal systems and dysfunctional communication to the brain." ;
                                                                             rdfs:label "sentence_28716445_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28716445_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28716445_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/28716445> ;
                                                                             gutprop:hasSentenceText "The purpose of this review is to familiarize clinicians with the physiology controlling feeding behavior and its implications for psychiatric conditions, such as anorexia nervosa and depression." ;
                                                                             rdfs:label "sentence_28716445_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28716445_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28716445_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/28716445> ;
                                                                             gutprop:hasSentenceText "Growing understanding of how integrated bacterial life is in the body has shown that gut bacteria regulate basic physiologic processes and are implicated in various disease states and contribute to regulation of mood." ;
                                                                             rdfs:label "sentence_28716445_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28716445_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28716445_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/28716445> ;
                                                                             gutprop:hasSentenceText "Responses to stress have effects on feeding behavior and mood and the regulation of the stress response by the gut microbiota could contribute to the dysfunction seen in patients with psychiatric illnesses." ;
                                                                             rdfs:label "sentence_28716445_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28716445_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28716445_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/28716445> ;
                                                                             gutprop:hasSentenceText "Gut microbiota may contribute to dysfunction in psychiatric illnesses." ;
                                                                             rdfs:label "sentence_28716445_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28716445_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28716445_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/28716445> ;
                                                                             gutprop:hasSentenceText "New opportunities to modulate existing gut microbiota using probiotics could be novel targets for clinical interventions." ;
                                                                             rdfs:label "sentence_28716445_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28816544_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28816544_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/28816544> ;
                                                                             gutprop:hasSentenceText "Animal inflammation-based models of depression and their application to drug discovery." ;
                                                                             rdfs:label "sentence_28816544_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28816544_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28816544_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/28816544> ;
                                                                             gutprop:hasSentenceText "Depression, anxiety and other affective disorders are globally widespread and severely debilitating human brain diseases." ;
                                                                             rdfs:label "sentence_28816544_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28816544_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28816544_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/28816544> ;
                                                                             gutprop:hasSentenceText "Despite their high prevalence and mental health impact, affective pathogenesis is poorly understood, and often remains recurrent and resistant to treatment." ;
                                                                             rdfs:label "sentence_28816544_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28816544_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28816544_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/28816544> ;
                                                                             gutprop:hasSentenceText "The lack of efficient antidepressants and presently limited conceptual innovation necessitate novel approaches and new drug targets in the field of antidepressant therapy." ;
                                                                             rdfs:label "sentence_28816544_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28816544_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28816544_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/28816544> ;
                                                                             gutprop:hasSentenceText "Areas covered: Herein, the authors discuss the emerging role of neuro-immune interactions in affective pathogenesis, which can become useful targets for CNS drug discovery, including modulating neuroinflammatory pathways to alleviate affective pathogenesis." ;
                                                                             rdfs:label "sentence_28816544_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28816544_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28816544_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/28816544> ;
                                                                             gutprop:hasSentenceText "Expert opinion: Mounting evidence implicates microglia, polyunsaturated fatty acids (PUFAs), glucocorticoids and gut microbiota in both inflammation and depression." ;
                                                                             rdfs:label "sentence_28816544_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28816544_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28816544_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/28816544> ;
                                                                             gutprop:hasSentenceText "It is suggested that novel antidepressants can be developed based on targeting microglia-, PUFAs-, glucocorticoid- and gut microbiota-mediated cellular pathways." ;
                                                                             rdfs:label "sentence_28816544_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28816544_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28816544_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/28816544> ;
                                                                             gutprop:hasSentenceText "In addition, the authors call for a wider application of novel model organisms, such as zebrafish, in studying shared, evolutionarily conserved (and therefore, core) neuro-immune mechanisms of depression." ;
                                                                             rdfs:label "sentence_28816544_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28843021_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28843021_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/28843021> ;
                                                                             gutprop:hasSentenceText "The nasal and gut microbiome in Parkinson's disease and idiopathic rapid eye movement sleep behavior disorder." ;
                                                                             rdfs:label "sentence_28843021_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28843021_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28843021_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/28843021> ;
                                                                             gutprop:hasSentenceText "Increasing evidence connects the gut microbiota and the onset and/or phenotype of Parkinson's disease (PD)." ;
                                                                             rdfs:label "sentence_28843021_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28843021_10
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28843021_10> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/28843021> ;
                                                                              gutprop:hasSentenceText "Our study reveals differential abundances of gut microbial taxa in PD and its prodrome idiopathic rapid eye movement sleep behavior disorder in comparison to the healthy controls, and highlights the potential of metagenomics to identify and characterize microbial taxa, which are enriched or depleted in PD and/or idiopathic rapid eye movement sleep behavior disorder." ;
                                                                              rdfs:label "sentence_28843021_10" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28843021_11
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28843021_11> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/28843021> ;
                                                                              gutprop:hasSentenceText "© 2017 The Authors." ;
                                                                              rdfs:label "sentence_28843021_11" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28843021_12
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28843021_12> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/28843021> ;
                                                                              gutprop:hasSentenceText "Movement Disorders published by Wiley Periodicals, Inc. on behalf of International Parkinson and Movement Disorder Society." ;
                                                                              rdfs:label "sentence_28843021_12" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28843021_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28843021_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/28843021> ;
                                                                             gutprop:hasSentenceText "Differences in the abundances of specific bacterial taxa have been reported in PD patients." ;
                                                                             rdfs:label "sentence_28843021_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28843021_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28843021_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/28843021> ;
                                                                             gutprop:hasSentenceText "It is, however, unknown whether these differences can be observed in individuals at high risk, for example, with idiopathic rapid eye movement sleep behavior disorder, a prodromal condition of α-synuclein aggregation disorders including PD." ;
                                                                             rdfs:label "sentence_28843021_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28843021_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28843021_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/28843021> ;
                                                                             gutprop:hasSentenceText "To compare microbiota in carefully preserved nasal wash and stool samples of subjects with idiopathic rapid eye movement sleep behavior disorder, manifest PD, and healthy individuals." ;
                                                                             rdfs:label "sentence_28843021_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28843021_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28843021_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/28843021> ;
                                                                             gutprop:hasSentenceText "Microbiota of flash-frozen stool and nasal wash samples from 76 PD patients, 21 idiopathic rapid eye movement sleep behavior disorder patients, and 78 healthy controls were assessed by 16S and 18S ribosomal RNA amplicon sequencing." ;
                                                                             rdfs:label "sentence_28843021_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28843021_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28843021_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/28843021> ;
                                                                             gutprop:hasSentenceText "Seventy variables, related to demographics, clinical parameters including nonmotor symptoms, and sample processing, were analyzed in relation to microbiome variability and controlled differential analyses were performed." ;
                                                                             rdfs:label "sentence_28843021_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28843021_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28843021_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/28843021> ;
                                                                             gutprop:hasSentenceText "Differentially abundant gut microbes, such as Akkermansia, were observed in PD, but no strong differences in nasal microbiota." ;
                                                                             rdfs:label "sentence_28843021_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28843021_8
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28843021_8> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/28843021> ;
                                                                             gutprop:hasSentenceText "Eighty percent of the differential gut microbes in PD versus healthy controls showed similar trends in idiopathic rapid eye movement sleep behavior disorder, for example, Anaerotruncus and several Bacteroides spp., and correlated with nonmotor symptoms." ;
                                                                             rdfs:label "sentence_28843021_8" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28843021_9
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28843021_9> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/28843021> ;
                                                                             gutprop:hasSentenceText "Metagenomic sequencing of select samples enabled the reconstruction of genomes of so far uncharacterized differentially abundant organisms." ;
                                                                             rdfs:label "sentence_28843021_9" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28852308_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28852308_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/28852308> ;
                                                                             gutprop:hasSentenceText "Influence of gut microbiota on neuropsychiatric disorders." ;
                                                                             rdfs:label "sentence_28852308_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28852308_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28852308_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/28852308> ;
                                                                             gutprop:hasSentenceText "The last decade has witnessed a growing appreciation of the fundamental role played by an early assembly of a diverse and balanced gut microbiota and its subsequent maintenance for future health of the host." ;
                                                                             rdfs:label "sentence_28852308_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28852308_10
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28852308_10> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/28852308> ;
                                                                              gutprop:hasSentenceText "Here, we review the evidence supporting a role of the gut microbiota in neuropsychiatric disorders and the state of the art regarding the mechanisms underlying its contribution to mental illness and health." ;
                                                                              rdfs:label "sentence_28852308_10" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28852308_11
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28852308_11> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/28852308> ;
                                                                              gutprop:hasSentenceText "We also consider the stages of life where the gut microbiota is more susceptible to the effects of environmental stressors, and the possible microbiota-targeted intervention strategies that could improve health status and prevent psychiatric disorders in the near future." ;
                                                                              rdfs:label "sentence_28852308_11" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28852308_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28852308_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/28852308> ;
                                                                             gutprop:hasSentenceText "Gut microbiota is currently viewed as a key regulator of a fluent bidirectional dialogue between the gut and the brain (gut-brain axis)." ;
                                                                             rdfs:label "sentence_28852308_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28852308_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28852308_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/28852308> ;
                                                                             gutprop:hasSentenceText "A number of preclinical studies have suggested that the microbiota and its genome (microbiome) may play a key role in neurodevelopmental and neurodegenerative disorders." ;
                                                                             rdfs:label "sentence_28852308_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28852308_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28852308_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/28852308> ;
                                                                             gutprop:hasSentenceText "Furthermore, alterations in the gut microbiota composition in humans have also been linked to a variety of neuropsychiatric conditions, including depression, autism and Parkinson's disease." ;
                                                                             rdfs:label "sentence_28852308_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28852308_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28852308_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/28852308> ;
                                                                             gutprop:hasSentenceText "However, it is not yet clear whether these changes in the microbiome are causally related to such diseases or are secondary effects thereof." ;
                                                                             rdfs:label "sentence_28852308_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28852308_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28852308_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/28852308> ;
                                                                             gutprop:hasSentenceText "In this respect, recent studies in animals have indicated that gut microbiota transplantation can transfer a behavioral phenotype, suggesting that the gut microbiota may be a modifiable factor modulating the development or pathogenesis of neuropsychiatric conditions." ;
                                                                             rdfs:label "sentence_28852308_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28852308_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28852308_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/28852308> ;
                                                                             gutprop:hasSentenceText "Further studies are warranted to establish whether or not the findings of preclinical animal experiments can be generalized to humans." ;
                                                                             rdfs:label "sentence_28852308_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28852308_8
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28852308_8> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/28852308> ;
                                                                             gutprop:hasSentenceText "Moreover, although different communication routes between the microbiota and brain have been identified, further studies must elucidate all the underlying mechanisms involved." ;
                                                                             rdfs:label "sentence_28852308_8" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28852308_9
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28852308_9> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/28852308> ;
                                                                             gutprop:hasSentenceText "Such research is expected to contribute to the design of strategies to modulate the gut microbiota and its functions with a view to improving mental health, and thus provide opportunities to improve the management of psychiatric diseases." ;
                                                                             rdfs:label "sentence_28852308_9" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28976454_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28976454_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/28976454> ;
                                                                             gutprop:hasSentenceText "The Gut and Its Microbiome as Related to Central Nervous System Functioning and Psychological Well-being: Introduction to the Special Issue of Psychosomatic Medicine." ;
                                                                             rdfs:label "sentence_28976454_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28976454_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28976454_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/28976454> ;
                                                                             gutprop:hasSentenceText "Accumulating evidence indicates bidirectional associations between the brain and the gut microbiome with both top-down and bottom-up processes." ;
                                                                             rdfs:label "sentence_28976454_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28976454_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28976454_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/28976454> ;
                                                                             gutprop:hasSentenceText "This article describes new developments in brain-gut interactions as an introduction to a special issue of Psychosomatic Medicine, based on a joint symposium of the American Psychosomatic Society and the American Gastroenterological Association." ;
                                                                             rdfs:label "sentence_28976454_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28976454_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28976454_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/28976454> ;
                                                                             gutprop:hasSentenceText "Literature review articles indicate that several psychiatric disorders are associated with altered gut microbiota, whereas evidence linking functional gastrointestinal disorders and dysbiosis has not been firmly established." ;
                                                                             rdfs:label "sentence_28976454_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28976454_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28976454_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/28976454> ;
                                                                             gutprop:hasSentenceText "The association between dysbiosis with obesity, metabolic syndrome, and Type 2 diabetes mellitus is still inconclusive, but evidence suggests that bariatric surgery may favorably alter the gut microbial community structure." ;
                                                                             rdfs:label "sentence_28976454_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28976454_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28976454_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/28976454> ;
                                                                             gutprop:hasSentenceText "Consistent with the literature linking psychiatric disorders with dysbiosis is that life adversity during childhood and certain temperaments that develop early in life are associated with altered gut microbiota, particularly the Prevotella species." ;
                                                                             rdfs:label "sentence_28976454_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28976454_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28976454_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/28976454> ;
                                                                             gutprop:hasSentenceText "Some studies reported in this issue support the hypothesis that brain-gut interactions are adversely influenced by reduced functional activation of the hippocampus and autonomic nervous system dysregulation." ;
                                                                             rdfs:label "sentence_28976454_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28976454_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28976454_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/28976454> ;
                                                                             gutprop:hasSentenceText "The evidence for the effects of probiotics in the treatment of Clostridium difficile colitis is relatively well established, but effects on mental health and psychophysiological stress reactivity are either inconclusive or still in progress." ;
                                                                             rdfs:label "sentence_28976454_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28976454_8
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28976454_8> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/28976454> ;
                                                                             gutprop:hasSentenceText "To conceptualize brain-gut interactions, a holistic, systems-based perspective on health and disease is needed, integrating gut microbial with environmental ecology." ;
                                                                             rdfs:label "sentence_28976454_8" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28976454_9
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28976454_9> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/28976454> ;
                                                                             gutprop:hasSentenceText "More translational research is needed to examine the mental and physical health effects of prebiotics and probiotics, in well-phenotyped human populations with sufficiently large sample sizes." ;
                                                                             rdfs:label "sentence_28976454_9" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/29022384_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/29022384_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/29022384> ;
                                                                             gutprop:hasSentenceText "Does the maternal vaginal microbiota play a role in seeding the microbiota of neonatal gut and nose?" ;
                                                                             rdfs:label "sentence_29022384_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/29022384_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/29022384_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/29022384> ;
                                                                             gutprop:hasSentenceText "The acquisition and early maturation of infant microbiota is not well understood despite its likely influence on later health." ;
                                                                             rdfs:label "sentence_29022384_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/29022384_10
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/29022384_10> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/29022384> ;
                                                                              gutprop:hasSentenceText "Only vaginally delivered, fully breastfed infants had gut microbiota dominated by Bifidobacteria." ;
                                                                              rdfs:label "sentence_29022384_10" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/29022384_11
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/29022384_11> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/29022384> ;
                                                                              gutprop:hasSentenceText "Our data suggest that reduced transfer of maternal vaginal microbial is not the main mechanism underlying the differential infant microbiota composition associated with Caesarean delivery." ;
                                                                              rdfs:label "sentence_29022384_11" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/29022384_12
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/29022384_12> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/29022384> ;
                                                                              gutprop:hasSentenceText "The sources of a large proportion of infant microbiota could not be identified in maternal microbiota, and the sources of seeding of infant gut and nasal microbiota remain to be elucidated." ;
                                                                              rdfs:label "sentence_29022384_12" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/29022384_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/29022384_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/29022384> ;
                                                                             gutprop:hasSentenceText "We investigated the contribution of the maternal microbiota to the microbiota of infant gut and nose in the context of mode of delivery and feeding." ;
                                                                             rdfs:label "sentence_29022384_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/29022384_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/29022384_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/29022384> ;
                                                                             gutprop:hasSentenceText "Using 16S rRNA sequencing and specific qPCR, we profiled microbiota of 42 mother-infant pairs from the GUSTO birth cohort, at body sites including maternal vagina, rectum and skin; and infant stool and nose." ;
                                                                             rdfs:label "sentence_29022384_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/29022384_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/29022384_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/29022384> ;
                                                                             gutprop:hasSentenceText "In our study, overlap between maternal vaginal microbiota and infant faecal microbiota was minimal, while the similarity between maternal rectal microbiota and infant microbiota was more pronounced." ;
                                                                             rdfs:label "sentence_29022384_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/29022384_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/29022384_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/29022384> ;
                                                                             gutprop:hasSentenceText "However, an infant's nasal and gut microbiota were no more similar to that of its own mother, than to that of unrelated mothers." ;
                                                                             rdfs:label "sentence_29022384_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/29022384_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/29022384_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/29022384> ;
                                                                             gutprop:hasSentenceText "These findings were independent of delivery mode." ;
                                                                             rdfs:label "sentence_29022384_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/29022384_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/29022384_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/29022384> ;
                                                                             gutprop:hasSentenceText "We conclude that the transfer of maternal vaginal microbes play a minor role in seeding infant stool microbiota." ;
                                                                             rdfs:label "sentence_29022384_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/29022384_8
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/29022384_8> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/29022384> ;
                                                                             gutprop:hasSentenceText "Transfer of maternal rectal microbiota could play a larger role in seeding infant stool microbiota, but approaches other than the generally used analyses of community similarity measures are likely to be needed to quantify bacterial transmission." ;
                                                                             rdfs:label "sentence_29022384_8" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/29022384_9
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/29022384_9> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/29022384> ;
                                                                             gutprop:hasSentenceText "We confirmed the clear difference between microbiota of infants born by Caesarean section compared to vaginally delivered infants and the impact of feeding mode on infant gut microbiota." ;
                                                                             rdfs:label "sentence_29022384_9" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/29023380_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/29023380_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/29023380> ;
                                                                             gutprop:hasSentenceText "The Gut Microbiome Feelings of the Brain: A Perspective for Non-Microbiologists." ;
                                                                             rdfs:label "sentence_29023380_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/29023380_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/29023380_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/29023380> ;
                                                                             gutprop:hasSentenceText "<b>Objectives:</b> To comprehensively review the scientific knowledge on the gut-brain axis." ;
                                                                             rdfs:label "sentence_29023380_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/29023380_10
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/29023380_10> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/29023380> ;
                                                                              gutprop:hasSentenceText "The limited availability of information on the mechanisms, pathways and cause-and-effect relationships hinders us from translating and implementing the knowledge from the bench to the clinic." ;
                                                                              rdfs:label "sentence_29023380_10" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/29023380_11
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/29023380_11> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/29023380> ;
                                                                              gutprop:hasSentenceText "<b>Implications:</b> Further understanding of this intricate field might potentially shed light on novel preventive and therapeutic strategies to combat these disorders." ;
                                                                              rdfs:label "sentence_29023380_11" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/29023380_12
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/29023380_12> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/29023380> ;
                                                                              gutprop:hasSentenceText "Nutritional approaches, microbiome manipulations, enteric and brain barrier reinforcement and sensing and trafficking modulation might improve physical and mental health outcomes." ;
                                                                              rdfs:label "sentence_29023380_12" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/29023380_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/29023380_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/29023380> ;
                                                                             gutprop:hasSentenceText "<b>Methods:</b> Various publications on the gut-brain axis, until 31 July 2017, were screened using the Medline, Google, and Cochrane Library databases." ;
                                                                             rdfs:label "sentence_29023380_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/29023380_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/29023380_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/29023380> ;
                                                                             gutprop:hasSentenceText "The search was performed using the following keywords: \"gut-brain axis\", \"gut-microbiota-brain axis\", \"nutrition microbiome/microbiota\", \"enteric nervous system\", \"enteric glial cells/network\", \"gut-brain pathways\", \"microbiome immune system\", \"microbiome neuroendocrine system\" and \"intestinal/gut/enteric neuropeptides\"." ;
                                                                             rdfs:label "sentence_29023380_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/29023380_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/29023380_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/29023380> ;
                                                                             gutprop:hasSentenceText "Relevant articles were selected and reviewed." ;
                                                                             rdfs:label "sentence_29023380_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/29023380_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/29023380_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/29023380> ;
                                                                             gutprop:hasSentenceText "<b>Results:</b> Tremendous progress has been made in exploring the interactions between nutrients, the microbiome, and the intestinal, epithelium-enteric nervous, endocrine and immune systems and the brain." ;
                                                                             rdfs:label "sentence_29023380_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/29023380_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/29023380_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/29023380> ;
                                                                             gutprop:hasSentenceText "The basis of the gut-brain axis comprises of an array of multichannel sensing and trafficking pathways that are suggested to convey the enteric signals to the brain." ;
                                                                             rdfs:label "sentence_29023380_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/29023380_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/29023380_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/29023380> ;
                                                                             gutprop:hasSentenceText "These are mediated by neuroanatomy (represented by the vagal and spinal afferent neurons), the neuroendocrine-hypothalamic-pituitary-adrenal (HPA) axis (represented by the gut hormones), immune routes (represented by multiple cytokines), microbially-derived neurotransmitters, and finally the gate keepers of the intestinal and brain barriers." ;
                                                                             rdfs:label "sentence_29023380_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/29023380_8
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/29023380_8> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/29023380> ;
                                                                             gutprop:hasSentenceText "Their mutual and harmonious but intricate interaction is essential for human life and brain performance." ;
                                                                             rdfs:label "sentence_29023380_8" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/29023380_9
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/29023380_9> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/29023380> ;
                                                                             gutprop:hasSentenceText "However, a failure in the interaction leads to a number of inflammatory-, autoimmune-, neurodegenerative-, metabolic-, mood-, behavioral-, cognitive-, autism-spectrum-, stress- and pain-related disorders." ;
                                                                             rdfs:label "sentence_29023380_9" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/29249803_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/29249803_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/29249803> ;
                                                                             gutprop:hasSentenceText "Possible role of the gut microbiota-brain axis in the antidepressant effects of (R)-ketamine in a social defeat stress model." ;
                                                                             rdfs:label "sentence_29249803_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/29249803_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/29249803_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/29249803> ;
                                                                             gutprop:hasSentenceText "Accumulating evidence suggests that the gut microbiota-brain axis plays a role in the pathogenesis of depression, thereby contributing to the antidepressant actions of certain compounds." ;
                                                                             rdfs:label "sentence_29249803_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/29249803_10
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/29249803_10> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/29249803> ;
                                                                              gutprop:hasSentenceText "In conclusion, this study suggests that the antidepressant effects of two enantiomers of ketamine in CSDS model may be partly mediated by the restoration of the gut microbiota." ;
                                                                              rdfs:label "sentence_29249803_10" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/29249803_11
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/29249803_11> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/29249803> ;
                                                                              gutprop:hasSentenceText "Furthermore, the specific effect of (R)-ketamine on the levels of Mollicutes and Butyricimonas may explain its robust antidepressant action." ;
                                                                              rdfs:label "sentence_29249803_11" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/29249803_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/29249803_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/29249803> ;
                                                                             gutprop:hasSentenceText "(R)-ketamine has a greater potency and longer-lasting antidepressant effects than (S)-ketamine." ;
                                                                             rdfs:label "sentence_29249803_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/29249803_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/29249803_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/29249803> ;
                                                                             gutprop:hasSentenceText "Here, we investigated whether the gut microbiota plays a role in the antidepressant effects of these two ketamine enantiomers." ;
                                                                             rdfs:label "sentence_29249803_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/29249803_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/29249803_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/29249803> ;
                                                                             gutprop:hasSentenceText "The role of the gut microbiota in the antidepressant effects of ketamine enantiomers in a chronic social defeat stress (CSDS) model of depression was examined using 16S ribosomal RNA gene sequencing of fecal samples." ;
                                                                             rdfs:label "sentence_29249803_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/29249803_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/29249803_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/29249803> ;
                                                                             gutprop:hasSentenceText "At the phylum level, CSDS-susceptible mice showed alterations in the levels of Tenericutes and Actinobacteria; however, neither ketamine enantiomers influenced these alterations." ;
                                                                             rdfs:label "sentence_29249803_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/29249803_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/29249803_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/29249803> ;
                                                                             gutprop:hasSentenceText "At the class level, both ketamine enantiomers significantly attenuated the increase in the levels of Deltaproteobacteria in the susceptible mice after CSDS." ;
                                                                             rdfs:label "sentence_29249803_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/29249803_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/29249803_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/29249803> ;
                                                                             gutprop:hasSentenceText "Furthermore, (R)-ketamine, but not (S)-ketamine, significantly attenuated the reduction in the levels of Mollicutes in the susceptible mice." ;
                                                                             rdfs:label "sentence_29249803_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/29249803_8
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/29249803_8> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/29249803> ;
                                                                             gutprop:hasSentenceText "At the genus level, both ketamine enantiomers significantly attenuated the decrease in the levels of Butyricimonas in the susceptible mice." ;
                                                                             rdfs:label "sentence_29249803_8" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/29249803_9
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/29249803_9> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/29249803> ;
                                                                             gutprop:hasSentenceText "Notably, (R)-ketamine was more potent than (S)-ketamine at reducing the levels of Butyricimonas in the susceptible mice." ;
                                                                             rdfs:label "sentence_29249803_9" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/29352709_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/29352709_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/29352709> ;
                                                                             gutprop:hasSentenceText "Analysis of gut microbiota diversity and auxiliary diagnosis as a biomarker in patients with schizophrenia: A cross-sectional study." ;
                                                                             rdfs:label "sentence_29352709_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/29352709_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/29352709_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/29352709> ;
                                                                             gutprop:hasSentenceText "With the advent of sequencing technology, characterization of schizophrenia with underlying probing of gut microbiome can provide abundant clues for diagnosis and prognosis of schizophrenia." ;
                                                                             rdfs:label "sentence_29352709_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/29352709_10
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/29352709_10> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/29352709> ;
                                                                              gutprop:hasSentenceText "In conclusion, there are some difference of gut microbiota between schizophrenia patients and healthy controls and the insights from this study could be used to develop microbiota-based diagnosis for schizophrenia." ;
                                                                              rdfs:label "sentence_29352709_10" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/29352709_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/29352709_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/29352709> ;
                                                                             gutprop:hasSentenceText "In this study, we first compared the difference of gut microbiota between schizophrenia patients and healthy controls by 16S rRNA sequencing." ;
                                                                             rdfs:label "sentence_29352709_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/29352709_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/29352709_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/29352709> ;
                                                                             gutprop:hasSentenceText "We further explored whether gut microbiota can be used as a biomarker to assist in the diagnosis of schizophrenia." ;
                                                                             rdfs:label "sentence_29352709_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/29352709_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/29352709_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/29352709> ;
                                                                             gutprop:hasSentenceText "We restricted inclusion criteria strictly to control confounding bias." ;
                                                                             rdfs:label "sentence_29352709_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/29352709_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/29352709_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/29352709> ;
                                                                             gutprop:hasSentenceText "Finally, we investigated differences in fecal microbiota between 64 schizophrenia patients and 53 healthy controls." ;
                                                                             rdfs:label "sentence_29352709_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/29352709_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/29352709_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/29352709> ;
                                                                             gutprop:hasSentenceText "At the phylum level, we found that the abundance of Proteobacteria in the schizophrenia patients was significantly increased." ;
                                                                             rdfs:label "sentence_29352709_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/29352709_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/29352709_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/29352709> ;
                                                                             gutprop:hasSentenceText "At the genus level, the relative abundance of Succinivibrio, Megasphaera, Collinsella, Clostridium, Klebsiella and Methanobrevibacter was significantly higher whereas the abundance of Blautia, Coprococcus, Roseburia was decreased compared to health controls." ;
                                                                             rdfs:label "sentence_29352709_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/29352709_8
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/29352709_8> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/29352709> ;
                                                                             gutprop:hasSentenceText "The receiver operating characteristic curve analysis demonstrated that 12 significant microbiota biomarkers were capable of being used as diagnostic factors for distinguishing the schizophrenia cohort from those in the control cohort (AUC = 0.837)." ;
                                                                             rdfs:label "sentence_29352709_8" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/29352709_9
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/29352709_9> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/29352709> ;
                                                                             gutprop:hasSentenceText "We performed PICRUSt analysis and found that several metabolic pathways differed significantly between healthy controls and schizophrenia patients, including vitamin B6 and fatty acid." ;
                                                                             rdfs:label "sentence_29352709_9" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/29843470_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/29843470_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/29843470> ;
                                                                             gutprop:hasSentenceText "Recognizing Depression from the Microbiota⁻Gut⁻Brain Axis." ;
                                                                             rdfs:label "sentence_29843470_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/29843470_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/29843470_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/29843470> ;
                                                                             gutprop:hasSentenceText "Major depression is one of the leading causes of disability, morbidity, and mortality worldwide." ;
                                                                             rdfs:label "sentence_29843470_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/29843470_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/29843470_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/29843470> ;
                                                                             gutprop:hasSentenceText "The brain⁻gut axis functions are disturbed, revealed by a dysfunction of the brain, immune system, endocrine system, and gut." ;
                                                                             rdfs:label "sentence_29843470_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/29843470_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/29843470_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/29843470> ;
                                                                             gutprop:hasSentenceText "Traditional depression treatments all target the brain, with different drugs and/or psychotherapy." ;
                                                                             rdfs:label "sentence_29843470_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/29843470_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/29843470_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/29843470> ;
                                                                             gutprop:hasSentenceText "Unfortunately, most of the patients have never received any treatment." ;
                                                                             rdfs:label "sentence_29843470_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/29843470_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/29843470_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/29843470> ;
                                                                             gutprop:hasSentenceText "Studies indicate that gut microbiota could be a direct cause for the disorder." ;
                                                                             rdfs:label "sentence_29843470_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/29843470_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/29843470_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/29843470> ;
                                                                             gutprop:hasSentenceText "Abnormal microbiota and the microbiota⁻gut⁻brain dysfunction may cause mental disorders, while correcting these disturbance could alleviate depression." ;
                                                                             rdfs:label "sentence_29843470_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/29843470_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/29843470_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/29843470> ;
                                                                             gutprop:hasSentenceText "Nowadays, the gut microbiota modulation has become a hot topic in treatment research of mental disorders." ;
                                                                             rdfs:label "sentence_29843470_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/29843470_8
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/29843470_8> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/29843470> ;
                                                                             gutprop:hasSentenceText "Depression is closely related with the health condition of the brain⁻gut axis, and maintaining/restoring the normal condition of gut microbiota helps in the prevention/therapy of mental disorders." ;
                                                                             rdfs:label "sentence_29843470_8" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/29857583_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/29857583_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/29857583> ;
                                                                             gutprop:hasSentenceText "Changes of Colonic Bacterial Composition in Parkinson's Disease and Other Neurodegenerative Diseases." ;
                                                                             rdfs:label "sentence_29857583_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/29857583_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/29857583_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/29857583> ;
                                                                             gutprop:hasSentenceText "In recent years evidence has emerged that neurodegenerative diseases (NDs) are strongly associated with the microbiome composition in the gut." ;
                                                                             rdfs:label "sentence_29857583_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/29857583_10
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/29857583_10> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/29857583> ;
                                                                              gutprop:hasSentenceText "We show that standardization of sample collection and analysis is necessary for ensuring the reproducibility and comparability of data." ;
                                                                              rdfs:label "sentence_29857583_10" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/29857583_11
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/29857583_11> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/29857583> ;
                                                                              gutprop:hasSentenceText "We also provide evidence that assessing the microbiota composition at high taxonomic resolution reveals changes in relative abundance that may be specific to or characteristic of one disease or disease group, and might evolve discriminative power." ;
                                                                              rdfs:label "sentence_29857583_11" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/29857583_12
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/29857583_12> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/29857583> ;
                                                                              gutprop:hasSentenceText "The interactions between bacterial species and strains and the co-abundances must be investigated before assumptions about the effects of specific bacteria on the host can be made with certainty." ;
                                                                              rdfs:label "sentence_29857583_12" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/29857583_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/29857583_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/29857583> ;
                                                                             gutprop:hasSentenceText "Parkinson's disease (PD) is the most intensively studied neurodegenerative disease in this context." ;
                                                                             rdfs:label "sentence_29857583_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/29857583_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/29857583_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/29857583> ;
                                                                             gutprop:hasSentenceText "In this review, we performed a systematic evaluation of the published literature comparing changes in colonic microbiome in PD to the ones observed in other NDs including Alzheimer's disease (AD), multiple system atrophy (MSA), multiple sclerosis (MS), neuromyelitis optica (NMO) and amyotrophic lateral sclerosis (ALS)." ;
                                                                             rdfs:label "sentence_29857583_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/29857583_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/29857583_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/29857583> ;
                                                                             gutprop:hasSentenceText "To enhance the comparability of different studies, only human case-control studies were included." ;
                                                                             rdfs:label "sentence_29857583_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/29857583_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/29857583_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/29857583> ;
                                                                             gutprop:hasSentenceText "Several studies showed an increase of <i>Lactobacillus</i>, <i>Bifidobacterium</i>, Verrucomicrobiaceae and <i>Akkermansia</i> in PD." ;
                                                                             rdfs:label "sentence_29857583_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/29857583_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/29857583_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/29857583> ;
                                                                             gutprop:hasSentenceText "A decrease of <i>Faecalibacterium</i> spp., <i>Coprococcus</i> spp., <i>Blautia</i> spp., <i>Prevotella</i> spp." ;
                                                                             rdfs:label "sentence_29857583_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/29857583_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/29857583_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/29857583> ;
                                                                             gutprop:hasSentenceText "and Prevotellaceae was observed in PD." ;
                                                                             rdfs:label "sentence_29857583_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/29857583_8
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/29857583_8> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/29857583> ;
                                                                             gutprop:hasSentenceText "On a low taxonomic resolution, like the phylum level, the changes are not disease-specific and are inconsistent." ;
                                                                             rdfs:label "sentence_29857583_8" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/29857583_9
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/29857583_9> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/29857583> ;
                                                                             gutprop:hasSentenceText "However, on a higher taxonomic resolution like genus or species level, a minor overlap was observed between PD and MSA, both alpha synucleinopathies." ;
                                                                             rdfs:label "sentence_29857583_9" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/29955222_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/29955222_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/29955222> ;
                                                                             gutprop:hasSentenceText "Ancient <i>Thali</i> Diet: Gut Microbiota, Immunity, and Health." ;
                                                                             rdfs:label "sentence_29955222_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/29955222_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/29955222_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/29955222> ;
                                                                             gutprop:hasSentenceText "Diet provides macronutrients (carbohydrates, proteins, and fats), micronutrients (vitamins and minerals), and phytochemicals (non-nutrient bioactive compounds)." ;
                                                                             rdfs:label "sentence_29955222_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/29955222_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/29955222_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/29955222> ;
                                                                             gutprop:hasSentenceText "Emerging evidence suggests that above dietary components can directly impact the composition and metabolic activity of the mammalian gut microbiota and in turn, affect both physical and mental health." ;
                                                                             rdfs:label "sentence_29955222_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/29955222_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/29955222_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/29955222> ;
                                                                             gutprop:hasSentenceText "There is a growing recognition that rise in chronic disease burden in Western countries may due to progressive loss of beneficial bacteria and microbial diversity." ;
                                                                             rdfs:label "sentence_29955222_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/29955222_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/29955222_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/29955222> ;
                                                                             gutprop:hasSentenceText "This perspective explores the possibility of using Indian <i>thali</i>, an ancient approach to diet that provides both fiber and different phytochemicals by incorporating a variety of plant foods in different colors." ;
                                                                             rdfs:label "sentence_29955222_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/29955222_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/29955222_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/29955222> ;
                                                                             gutprop:hasSentenceText "This variety helps to restore diversity in the gut bacteria and may potentially prevent or reverse chronic disease, such as colon cancer or type 2 diabetes." ;
                                                                             rdfs:label "sentence_29955222_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30033172_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30033172_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/30033172> ;
                                                                             gutprop:hasSentenceText "Towards microbiome-informed dietary recommendations for promoting metabolic and mental health: Opinion papers of the MyNewGut project." ;
                                                                             rdfs:label "sentence_30033172_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30033172_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30033172_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30033172> ;
                                                                             gutprop:hasSentenceText "The gut microbiota coexists in partnership with the human host through adaptations to environmental and physiological changes that help maintain dynamic homeostatic healthy states." ;
                                                                             rdfs:label "sentence_30033172_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30033172_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30033172_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30033172> ;
                                                                             gutprop:hasSentenceText "Break-down of this delicate balance under sustained exposure to stressors (e.g." ;
                                                                             rdfs:label "sentence_30033172_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30033172_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30033172_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30033172> ;
                                                                             gutprop:hasSentenceText "unhealthy diets) can, however, contribute to the onset of disease." ;
                                                                             rdfs:label "sentence_30033172_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30033172_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30033172_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30033172> ;
                                                                             gutprop:hasSentenceText "Diet is a key modifiable environmental factor that modulates the gut microbiota and its metabolic capacities that, in turn, could impact human physiology." ;
                                                                             rdfs:label "sentence_30033172_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30033172_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30033172_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30033172> ;
                                                                             gutprop:hasSentenceText "On this basis, the diet and the gut microbiota could act as synergistic forces that provide resilience against disease or that speed the progress from health to disease states." ;
                                                                             rdfs:label "sentence_30033172_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30033172_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30033172_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30033172> ;
                                                                             gutprop:hasSentenceText "Associations between unhealthy dietary patterns, non-communicable diseases and intestinal dysbiosis can be explained by this hypothesis." ;
                                                                             rdfs:label "sentence_30033172_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30033172_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30033172_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30033172> ;
                                                                             gutprop:hasSentenceText "Translational studies showing that dietary-induced alterations in microbial communities recapitulate some of the pathological features of the original host further support this notion." ;
                                                                             rdfs:label "sentence_30033172_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30033172_8
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30033172_8> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30033172> ;
                                                                             gutprop:hasSentenceText "In this introductory paper by the European project MyNewGut, we briefly summarize the investigations conducted to better understand the role of dietary patterns and food components in metabolic and mental health and the specificities of the microbiome-mediating mechanisms." ;
                                                                             rdfs:label "sentence_30033172_8" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30033172_9
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30033172_9> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30033172> ;
                                                                             gutprop:hasSentenceText "We also discuss how advances in the understanding of the microbiome's role in dietary health effects can help to provide acceptable scientific grounds on which to base dietary advice for promoting healthy living." ;
                                                                             rdfs:label "sentence_30033172_9" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30072879_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30072879_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/30072879> ;
                                                                             gutprop:hasSentenceText "Effects of Sub-Chronic MPTP Exposure on Behavioral and Cognitive Performance and the Microbiome of Wild-Type and mGlu8 Knockout Female and Male Mice." ;
                                                                             rdfs:label "sentence_30072879_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30072879_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30072879_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30072879> ;
                                                                             gutprop:hasSentenceText "Motor dysfunction is a hallmark of Parkinson's disease (PD); however, non-motor symptoms such as gastrointestinal dysfunction often arise prior to motor symptoms." ;
                                                                             rdfs:label "sentence_30072879_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30072879_10
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30072879_10> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30072879> ;
                                                                              gutprop:hasSentenceText "MPTP also showed genotype- and sex-dependent effects." ;
                                                                              rdfs:label "sentence_30072879_10" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30072879_11
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30072879_11> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30072879> ;
                                                                              gutprop:hasSentenceText "MPTP increased the time WT, but not KO, females and males spent exploring objects." ;
                                                                              rdfs:label "sentence_30072879_11" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30072879_12
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30072879_12> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30072879> ;
                                                                              gutprop:hasSentenceText "In WT mice, MPTP improved sensorimotor function in males but impaired it in females." ;
                                                                              rdfs:label "sentence_30072879_12" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30072879_13
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30072879_13> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30072879> ;
                                                                              gutprop:hasSentenceText "Further, MPTP impaired cued fear memory in WT, but not KO, male mice." ;
                                                                              rdfs:label "sentence_30072879_13" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30072879_14
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30072879_14> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30072879> ;
                                                                              gutprop:hasSentenceText "MPTP reduced striatal TH levels in WT and KO mice but these effects were only pronounced in males." ;
                                                                              rdfs:label "sentence_30072879_14" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30072879_15
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30072879_15> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30072879> ;
                                                                              gutprop:hasSentenceText "MPTP treatment and genotype affected the diversity of the gut microbiome." ;
                                                                              rdfs:label "sentence_30072879_15" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30072879_16
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30072879_16> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30072879> ;
                                                                              gutprop:hasSentenceText "In addition, there were significant associations between microbiome α-diversity and sensorimotor performance, as well as microbiome composition and fear learning." ;
                                                                              rdfs:label "sentence_30072879_16" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30072879_17
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30072879_17> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30072879> ;
                                                                              gutprop:hasSentenceText "These results indicate that specific taxa may directly affect motor and fear learning or that the same physiological effects that enhance both forms of learning also alter diversity of the gut microbiome." ;
                                                                              rdfs:label "sentence_30072879_17" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30072879_18
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30072879_18> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30072879> ;
                                                                              gutprop:hasSentenceText "MPTP's effect on motor and cognitive performance may then be, at least in part, be mediated by the gut microbiome." ;
                                                                              rdfs:label "sentence_30072879_18" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30072879_19
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30072879_19> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30072879> ;
                                                                              gutprop:hasSentenceText "These data also support mGlu8 as a novel therapeutic target for PD and highlight the importance of including both sexes in preclinical studies." ;
                                                                              rdfs:label "sentence_30072879_19" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30072879_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30072879_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30072879> ;
                                                                             gutprop:hasSentenceText "Alterations in the gut microbiome have been proposed as the earliest event in PD pathogenesis." ;
                                                                             rdfs:label "sentence_30072879_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30072879_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30072879_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30072879> ;
                                                                             gutprop:hasSentenceText "PD symptoms often demonstrate sex differences." ;
                                                                             rdfs:label "sentence_30072879_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30072879_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30072879_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30072879> ;
                                                                             gutprop:hasSentenceText "Glutamatergic neurotransmission has long been linked to PD pathology." ;
                                                                             rdfs:label "sentence_30072879_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30072879_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30072879_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30072879> ;
                                                                             gutprop:hasSentenceText "Metabotropic glutamate receptors (mGlu), a family of G protein-coupled receptors, are divided into three groups, with group III mGlu receptors mainly localized presynaptically where they can inhibit glutamate release in the CNS as well as in the gut." ;
                                                                             rdfs:label "sentence_30072879_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30072879_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30072879_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30072879> ;
                                                                             gutprop:hasSentenceText "Additionally, the gut microbiome can communicate with the CNS via the gut-brain axis." ;
                                                                             rdfs:label "sentence_30072879_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30072879_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30072879_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30072879> ;
                                                                             gutprop:hasSentenceText "Here, we assessed whether deficiency of metabotropic glutamate receptor 8 (mGlu8), group III mGlu, modulates the effects of the neurotoxin, 1-methyl-4-phenyl-1,2,3,6-tetrahydropyridine (MPTP), on behavioral and cognitive performance in female and male mice." ;
                                                                             rdfs:label "sentence_30072879_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30072879_8
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30072879_8> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30072879> ;
                                                                             gutprop:hasSentenceText "We studied whether these effects are associated with changes in striatal tyrosine hydroxylase (TH) levels and the gut microbiome." ;
                                                                             rdfs:label "sentence_30072879_8" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30072879_9
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30072879_9> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30072879> ;
                                                                             gutprop:hasSentenceText "Two-week sub-chronic MPTP increased activity of female and male wild-type (WT) and mGlu8 knockout (KO) mice in the open field." ;
                                                                             rdfs:label "sentence_30072879_9" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30258234_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30258234_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/30258234> ;
                                                                             gutprop:hasSentenceText "Microglia in neurodegeneration." ;
                                                                             rdfs:label "sentence_30258234_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30258234_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30258234_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30258234> ;
                                                                             gutprop:hasSentenceText "The neuroimmune system is involved in development, normal functioning, aging, and injury of the central nervous system." ;
                                                                             rdfs:label "sentence_30258234_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30258234_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30258234_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30258234> ;
                                                                             gutprop:hasSentenceText "Microglia, first described a century ago, are the main neuroimmune cells and have three essential functions: a sentinel function involved in constant sensing of changes in their environment, a housekeeping function that promotes neuronal well-being and normal operation, and a defense function necessary for responding to such changes and providing neuroprotection." ;
                                                                             rdfs:label "sentence_30258234_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30258234_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30258234_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30258234> ;
                                                                             gutprop:hasSentenceText "Microglia use a defined armamentarium of genes to perform these tasks." ;
                                                                             rdfs:label "sentence_30258234_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30258234_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30258234_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30258234> ;
                                                                             gutprop:hasSentenceText "In response to specific stimuli, or with neuroinflammation, microglia also have the capacity to damage and kill neurons." ;
                                                                             rdfs:label "sentence_30258234_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30258234_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30258234_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30258234> ;
                                                                             gutprop:hasSentenceText "Injury to neurons in Alzheimer's, Parkinson's, Huntington's, and prion diseases, as well as in amyotrophic lateral sclerosis, frontotemporal dementia, and chronic traumatic encephalopathy, results from disruption of the sentinel or housekeeping functions and dysregulation of the defense function and neuroinflammation." ;
                                                                             rdfs:label "sentence_30258234_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30258234_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30258234_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30258234> ;
                                                                             gutprop:hasSentenceText "Pathways associated with such injury include several sensing and housekeeping pathways, such as the Trem2, Cx3cr1 and progranulin pathways, which act as immune checkpoints to keep the microglial inflammatory response under control, and the scavenger receptor pathways, which promote clearance of injurious stimuli." ;
                                                                             rdfs:label "sentence_30258234_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30258234_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30258234_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30258234> ;
                                                                             gutprop:hasSentenceText "Peripheral interference from systemic inflammation or the gut microbiome can also alter progression of such injury." ;
                                                                             rdfs:label "sentence_30258234_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30258234_8
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30258234_8> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30258234> ;
                                                                             gutprop:hasSentenceText "Initiation or exacerbation of neurodegeneration results from an imbalance between these microglial functions; correcting such imbalance may be a potential mode for therapy." ;
                                                                             rdfs:label "sentence_30258234_8" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30309367_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30309367_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/30309367> ;
                                                                             gutprop:hasSentenceText "Visceral pain: gut microbiota, a new hope?" ;
                                                                             rdfs:label "sentence_30309367_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30309367_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30309367_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30309367> ;
                                                                             gutprop:hasSentenceText "Visceral pain is a complex and heterogeneous disorder, which can range from the mild discomfort of indigestion to the agonizing pain of renal colic." ;
                                                                             rdfs:label "sentence_30309367_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30309367_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30309367_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30309367> ;
                                                                             gutprop:hasSentenceText "Regulation of visceral pain involves the spinal cord as well as higher order brain structures." ;
                                                                             rdfs:label "sentence_30309367_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30309367_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30309367_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30309367> ;
                                                                             gutprop:hasSentenceText "Recent findings have linked the microbiota to gastrointestinal disorders characterized by abdominal pain suggesting the ability of microbes to modulate visceral hypersensitivity and nociception to pain." ;
                                                                             rdfs:label "sentence_30309367_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30309367_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30309367_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30309367> ;
                                                                             gutprop:hasSentenceText "In this review we describe the neuroanatomical basis of visceral pain signaling and the existing evidence of its manipulation exerted by the gut microbiota." ;
                                                                             rdfs:label "sentence_30309367_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30309367_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30309367_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30309367> ;
                                                                             gutprop:hasSentenceText "We included an updated overview of the potential therapeutic effects of dietary intervention, specifically probiotics and prebiotics, in alleviating hypersensitivity to visceral pain stimuli." ;
                                                                             rdfs:label "sentence_30309367_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30309367_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30309367_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30309367> ;
                                                                             gutprop:hasSentenceText "The gut microbiota dramatically impacts normal visceral pain sensation and affects the mechanisms mediating visceral nociception." ;
                                                                             rdfs:label "sentence_30309367_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30309367_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30309367_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30309367> ;
                                                                             gutprop:hasSentenceText "Furthermore, manipulation of the gut microbiota using prebiotics and probiotics plays a potential role in the regulation of visceral pain disorders." ;
                                                                             rdfs:label "sentence_30309367_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30317530_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30317530_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/30317530> ;
                                                                             gutprop:hasSentenceText "An insight into gut microbiota and its functionalities." ;
                                                                             rdfs:label "sentence_30317530_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30317530_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30317530_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30317530> ;
                                                                             gutprop:hasSentenceText "Gut microbiota has evolved along with their hosts and is an integral part of the human body." ;
                                                                             rdfs:label "sentence_30317530_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30317530_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30317530_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30317530> ;
                                                                             gutprop:hasSentenceText "Microbiota acquired at birth develops in parallel as the host develops and maintains its temporal stability and diversity through adulthood until death." ;
                                                                             rdfs:label "sentence_30317530_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30317530_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30317530_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30317530> ;
                                                                             gutprop:hasSentenceText "Recent developments in genome sequencing technologies, bioinformatics and culturomics have enabled researchers to explore the microbiota and in particular their functions at more detailed level than before." ;
                                                                             rdfs:label "sentence_30317530_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30317530_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30317530_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30317530> ;
                                                                             gutprop:hasSentenceText "The accumulated evidences suggest that though a part of the microbiota is conserved, the dynamic members vary along the gastrointestinal tract, from infants to elderly, primitive tribes to modern societies and in different health conditions." ;
                                                                             rdfs:label "sentence_30317530_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30317530_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30317530_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30317530> ;
                                                                             gutprop:hasSentenceText "Though the gut microbiota is dynamic, it performs some basic functions in the immunological, metabolic, structural and neurological landscapes of the human body." ;
                                                                             rdfs:label "sentence_30317530_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30317530_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30317530_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30317530> ;
                                                                             gutprop:hasSentenceText "Gut microbiota also exerts significant influence on both physical and mental health of an individual." ;
                                                                             rdfs:label "sentence_30317530_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30317530_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30317530_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30317530> ;
                                                                             gutprop:hasSentenceText "An in-depth understanding of the functioning of gut microbiota has led to some very exciting developments in therapeutics, such as prebiotics, probiotics, drugs and faecal transplantation leading to improved health." ;
                                                                             rdfs:label "sentence_30317530_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30394313_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30394313_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/30394313> ;
                                                                             gutprop:hasSentenceText "Alteration of gut microbiota-associated epitopes in children with autism spectrum disorders." ;
                                                                             rdfs:label "sentence_30394313_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30394313_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30394313_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30394313> ;
                                                                             gutprop:hasSentenceText "Autism spectrum disorder (ASD) affects 1% of children and has no cure." ;
                                                                             rdfs:label "sentence_30394313_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30394313_10
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30394313_10> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30394313> ;
                                                                              gutprop:hasSentenceText "We identified 34 MEs that were significantly more or less abundant in ASD children than TD children, most (29/34) of the differences in MEs were reduced in ASD and associated with abnormal gut IgA level and altered gut microbiota composition, these MEs were limited effected by clinical factors such as age, gender, and GI problems, of which eleven MEs were pathogenic microorganisms peptides with strong T or B cell response, nine MEs showed high homology to peptides from human self proteins associated with autoimmune disease occurrence, eliciting immune attack against hematopoietic stem cells and inhibition antigen binding." ;
                                                                              rdfs:label "sentence_30394313_10" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30394313_11
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30394313_11> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30394313> ;
                                                                              gutprop:hasSentenceText "We also found that the abundance of five MEs were increased in ASD, including three human self proteins, gap junction alpha-1 (GJA1), paired box protein Pax-3 (PAX3) and eyes absent homolog 1 isoform 4 (EYA1) which associated with cancer, and a ME with homology to a Listeriolysin O peptide from the pathogenic bacterium Listeria monocytogenes was significantly increased in ASD children compared with TD children." ;
                                                                              rdfs:label "sentence_30394313_11" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30394313_12
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30394313_12> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30394313> ;
                                                                              gutprop:hasSentenceText "Our findings demonstrate the abnormal of MEs composition in the gut of children with ASD, moreover, the abnormality in MEs composition was associated with abnormal gut IgA levels and altered gut microbiota composition, this abnormality also suggests that there may be abnormalities in intestinal immunity in children with ASD; In all, thirty-four MEs identified were potential biomarker of ASD, and alterations in MEs may contribute to abnormalities in gut immunity and/or homeostasis in ASD children." ;
                                                                              rdfs:label "sentence_30394313_12" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30394313_13
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30394313_13> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30394313> ;
                                                                              gutprop:hasSentenceText "Further study of the MEs identified here may advance our understanding of the pathogenesis of ASD." ;
                                                                              rdfs:label "sentence_30394313_13" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30394313_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30394313_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30394313> ;
                                                                             gutprop:hasSentenceText "Gastrointestinal (GI) problems are common in children with ASD, and although gut microbiota is known to play an important role in ASD through the gut-brain axis, the specific mechanism is unknown." ;
                                                                             rdfs:label "sentence_30394313_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30394313_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30394313_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30394313> ;
                                                                             gutprop:hasSentenceText "Recent evidence suggests that gut microbiota may participate in the pathogenesis of ASD through immune- and inflammation-mediated pathways." ;
                                                                             rdfs:label "sentence_30394313_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30394313_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30394313_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30394313> ;
                                                                             gutprop:hasSentenceText "Here, we identified potentially immunogenic epitopes derived from gut microbiota in stool samples from ASD children with and without GI problems and typically developing (TD) children." ;
                                                                             rdfs:label "sentence_30394313_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30394313_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30394313_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30394313> ;
                                                                             gutprop:hasSentenceText "Candidate gut microbiota-associated epitopes (MEs) were identified by blast shotgun metagenomic sequencing of fecal samples from 43 ASD children (19 with and 24 without GI involvement) and 31 sex- and age-matched typically developing (TD) children." ;
                                                                             rdfs:label "sentence_30394313_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30394313_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30394313_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30394313> ;
                                                                             gutprop:hasSentenceText "Potentially immunogenic epitopes were screened against a predictive human Immune Epitope Database." ;
                                                                             rdfs:label "sentence_30394313_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30394313_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30394313_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30394313> ;
                                                                             gutprop:hasSentenceText "The composition and abundance of candidate MEs were compared between the three groups of children." ;
                                                                             rdfs:label "sentence_30394313_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30394313_8
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30394313_8> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30394313> ;
                                                                             gutprop:hasSentenceText "MEs identified in ASD children with GI problems were significantly more diverse than those in TD children." ;
                                                                             rdfs:label "sentence_30394313_8" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30394313_9
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30394313_9> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30394313> ;
                                                                             gutprop:hasSentenceText "ME composition could discriminate between the three groups of children." ;
                                                                             rdfs:label "sentence_30394313_9" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30405455_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30405455_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/30405455> ;
                                                                             gutprop:hasSentenceText "Metabolic and Microbiota Measures as Peripheral Biomarkers in Major Depressive Disorder." ;
                                                                             rdfs:label "sentence_30405455_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30405455_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30405455_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30405455> ;
                                                                             gutprop:hasSentenceText "Advances in understanding the role of the microbiome in physical and mental health are at the forefront of medical research and hold potential to have a direct impact on precision medicine approaches." ;
                                                                             rdfs:label "sentence_30405455_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30405455_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30405455_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30405455> ;
                                                                             gutprop:hasSentenceText "In the past 7 years, we have studied the role of microbiota-brain communication on behavior in mouse models using germ-free mice, mice exposed to antibiotics, and healthy specific pathogen free mice." ;
                                                                             rdfs:label "sentence_30405455_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30405455_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30405455_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30405455> ;
                                                                             gutprop:hasSentenceText "Through our work and that of others, we have seen an amazing increase in our knowledge of how bacteria signal to the brain and the implications this has for psychiatry." ;
                                                                             rdfs:label "sentence_30405455_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30405455_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30405455_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30405455> ;
                                                                             gutprop:hasSentenceText "Gut microbiota composition and function are influenced both by genetics, age, sex, diet, life experiences, and many other factors of psychiatric and bodily disorders and thus may act as potential biomarkers of the gut-brain axis that could be used in psychiatry and co-morbid conditions." ;
                                                                             rdfs:label "sentence_30405455_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30405455_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30405455_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30405455> ;
                                                                             gutprop:hasSentenceText "There is a particular need in major depressive disorder and other mental illness to identify biomarkers that can stratify patients into more homogeneous groups to provide better treatment and for development of new therapeutic approaches." ;
                                                                             rdfs:label "sentence_30405455_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30405455_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30405455_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30405455> ;
                                                                             gutprop:hasSentenceText "Peripheral outcome measures of host-microbe bidirectional communication have significant translational value as biomarkers." ;
                                                                             rdfs:label "sentence_30405455_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30405455_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30405455_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30405455> ;
                                                                             gutprop:hasSentenceText "Enabling stratification of clinical populations, based on individual biological differences, to predict treatment response to pharmacological and non-pharmacological interventions." ;
                                                                             rdfs:label "sentence_30405455_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30405455_8
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30405455_8> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30405455> ;
                                                                             gutprop:hasSentenceText "Here we consider the links between co-morbid metabolic syndrome and depression, focusing on biomarkers including leptin and ghrelin in combination with assessing gut microbiota composition, as a potential tool to help identify individual differences in depressed population." ;
                                                                             rdfs:label "sentence_30405455_8" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30459574_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30459574_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/30459574> ;
                                                                             gutprop:hasSentenceText "Oral Probiotics Ameliorate the Behavioral Deficits Induced by Chronic Mild Stress in Mice via the Gut Microbiota-Inflammation Axis." ;
                                                                             rdfs:label "sentence_30459574_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30459574_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30459574_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30459574> ;
                                                                             gutprop:hasSentenceText "In recent years, a burgeoning body of research has revealed links between depression and the gut microbiota, leading to the therapeutic use of probiotics for stress-related disorders." ;
                                                                             rdfs:label "sentence_30459574_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30459574_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30459574_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30459574> ;
                                                                             gutprop:hasSentenceText "In this study, we explored the potential antidepressant efficacy of a multi-strain probiotics treatment (<i>Lactobacillus helveticus R0052</i>, <i>Lactobacillus plantarum R1012</i>, and <i>Bifidobacterium longum R0175</i>) in a chronic mild stress (CMS) mouse model of depression and determined its probable mechanism of action." ;
                                                                             rdfs:label "sentence_30459574_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30459574_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30459574_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30459574> ;
                                                                             gutprop:hasSentenceText "Our findings revealed that mice subjected to CMS exhibited anxiety- and depressive-like behaviors in the sucrose preference test, elevated plus maze, and forced swim test, along with increased interferon-γ, tumor necrosis factor-α, and indoleamine 2,3-dioxygenase-1 levels in the hippocampus." ;
                                                                             rdfs:label "sentence_30459574_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30459574_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30459574_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30459574> ;
                                                                             gutprop:hasSentenceText "Moreover, the microbiota distinctly changed from the non-stress group and was characterized by highly diverse bacterial communities associated with significant reductions in <i>Lactobacillus</i> species." ;
                                                                             rdfs:label "sentence_30459574_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30459574_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30459574_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30459574> ;
                                                                             gutprop:hasSentenceText "Probiotics attenuated CMS-induced anxiety- and depressive-like behaviors, significantly increased <i>Lactobacillus</i> abundance, and reversed the CMS-induced immune changes in the hippocampus." ;
                                                                             rdfs:label "sentence_30459574_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30459574_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30459574_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30459574> ;
                                                                             gutprop:hasSentenceText "Thus, the possible mechanism involved in the antidepressant-like activity of probiotics is correlated with <i>Lactobacillus</i> species via the gut microbiota-inflammation-brain axis." ;
                                                                             rdfs:label "sentence_30459574_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30518033_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30518033_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/30518033> ;
                                                                             gutprop:hasSentenceText "Differences in Anxiety Levels of Various Murine Models in Relation to the Gut Microbiota Composition." ;
                                                                             rdfs:label "sentence_30518033_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30518033_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30518033_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30518033> ;
                                                                             gutprop:hasSentenceText "Psychobiotics are probiotic strains that confer mental health benefits to the host through the modulation of the gut microbial population." ;
                                                                             rdfs:label "sentence_30518033_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30518033_10
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30518033_10> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30518033> ;
                                                                              gutprop:hasSentenceText "Our results suggest that the microbiota, host genetics, and psychological symptoms are strongly related, yet the deeper mechanistic links need further exploration." ;
                                                                              rdfs:label "sentence_30518033_10" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30518033_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30518033_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30518033> ;
                                                                             gutprop:hasSentenceText "Mounting evidence shows that the gut microbiota play an important role in communication within the gut⁻brain axis." ;
                                                                             rdfs:label "sentence_30518033_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30518033_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30518033_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30518033> ;
                                                                             gutprop:hasSentenceText "However, the relationship between the host genetics and the gut microbiota and their influence on anxiety are still not fully understood." ;
                                                                             rdfs:label "sentence_30518033_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30518033_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30518033_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30518033> ;
                                                                             gutprop:hasSentenceText "Hence, in our research, we attempted to draw a connection between host genetics, microbiota composition, and anxiety by performing an elevated plus maze (EPM) test on four genetically different mice." ;
                                                                             rdfs:label "sentence_30518033_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30518033_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30518033_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30518033> ;
                                                                             gutprop:hasSentenceText "Four different breeds of 5-week-old mice were used in this experiment: Balb/c, Orient C57BL/6N, Taconic C57BL/6N, and Taconic C57BL/6J." ;
                                                                             rdfs:label "sentence_30518033_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30518033_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30518033_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30518033> ;
                                                                             gutprop:hasSentenceText "After 1 week of adaptation, their initial anxiety level was monitored using the EPM test via an EthoVision XT, a standardized software used for behavorial testing." ;
                                                                             rdfs:label "sentence_30518033_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30518033_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30518033_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30518033> ;
                                                                             gutprop:hasSentenceText "Significant differences in the initial anxiety level and microbial composition were detected." ;
                                                                             rdfs:label "sentence_30518033_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30518033_8
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30518033_8> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30518033> ;
                                                                             gutprop:hasSentenceText "Subsequently, the microbiota of each group was modulated by the administration of either a probiotic, fecal microbiota transplantation, or antibiotics." ;
                                                                             rdfs:label "sentence_30518033_8" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30518033_9
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30518033_9> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30518033> ;
                                                                             gutprop:hasSentenceText "Changes were observed in host anxiety levels in correlation to the shift of the gut microbiota." ;
                                                                             rdfs:label "sentence_30518033_9" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30528936_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30528936_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/30528936> ;
                                                                             gutprop:hasSentenceText "Role of Actinobacteria and Coriobacteriia in the antidepressant effects of ketamine in an inflammation model of depression." ;
                                                                             rdfs:label "sentence_30528936_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30528936_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30528936_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30528936> ;
                                                                             gutprop:hasSentenceText "Ketamine, an N-methyl-d-aspartic acid receptor (NMDAR) antagonist, elicits rapid-acting and sustained antidepressant effects in treatment-resistant depressed patients." ;
                                                                             rdfs:label "sentence_30528936_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30528936_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30528936_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30528936> ;
                                                                             gutprop:hasSentenceText "Accumulating evidence suggests that gut microbiota via the gut-brain axis play a role in the pathogenesis of depression, thereby contributing to the antidepressant actions of certain compounds." ;
                                                                             rdfs:label "sentence_30528936_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30528936_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30528936_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30528936> ;
                                                                             gutprop:hasSentenceText "Here we investigated the role of gut microbiota in the antidepressant effects of ketamine in lipopolysaccharide (LPS)-induced inflammation model of depression." ;
                                                                             rdfs:label "sentence_30528936_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30528936_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30528936_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30528936> ;
                                                                             gutprop:hasSentenceText "Ketamine (10 mg/kg) significantly attenuated the increased immobility time in forced swimming test (FST), which was associated with the improvements in α-diversity, consisting of Shannon, Simpson and Chao 1 indices." ;
                                                                             rdfs:label "sentence_30528936_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30528936_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30528936_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30528936> ;
                                                                             gutprop:hasSentenceText "In addition to α-diversity, β-diversity, such as principal coordinates analysis (PCoA), and linear discriminant analysis (LDA) coupled with effect size measurements (LEfSe), showed a differential profile after ketamine treatment." ;
                                                                             rdfs:label "sentence_30528936_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30528936_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30528936_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30528936> ;
                                                                             gutprop:hasSentenceText "Furthermore, a total of 30 bacteria were significantly altered in the LPS + saline treated mice and LPS + ketamine treated mice." ;
                                                                             rdfs:label "sentence_30528936_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30528936_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30528936_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30528936> ;
                                                                             gutprop:hasSentenceText "Interestingly, two bacteria, including the phylum Actinobacteria and the class Coriobacteriia were significantly correlated with the immobility time of FST." ;
                                                                             rdfs:label "sentence_30528936_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30528936_8
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30528936_8> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30528936> ;
                                                                             gutprop:hasSentenceText "Importantly, the receiver operating characteristic (ROC) curves demonstrated that the phylum Actinobacteria and the class Coriobacteriia were potential biomarker for the antidepressant effects of ketamine in an inflammation model." ;
                                                                             rdfs:label "sentence_30528936_8" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30528936_9
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30528936_9> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30528936> ;
                                                                             gutprop:hasSentenceText "These findings suggest that antidepressant effects of ketamine might be related to the regulation of abnormal composition of gut microbiota, and that the phylum Actinobacteria and the class Coriobacteriia might be potential biomarkers for ketamine's antidepressant efficacy." ;
                                                                             rdfs:label "sentence_30528936_9" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30584306_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30584306_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/30584306> ;
                                                                             gutprop:hasSentenceText "Possible association of Firmicutes in the gut microbiota of patients with major depressive disorder." ;
                                                                             rdfs:label "sentence_30584306_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30584306_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30584306_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30584306> ;
                                                                             gutprop:hasSentenceText "Gut microbiota can affect human behavior and mood in many ways." ;
                                                                             rdfs:label "sentence_30584306_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30584306_10
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30584306_10> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30584306> ;
                                                                              gutprop:hasSentenceText "This study found that there is a significant disorder of gut microbiota in the patients with depression, in which the Firmicutes decreased significantly." ;
                                                                              rdfs:label "sentence_30584306_10" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30584306_11
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30584306_11> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30584306> ;
                                                                              gutprop:hasSentenceText "Defects of the Firmicutes may lead to the depression in short-chain fatty acids, which could account for the physiological basis of low-level inflammation of depression." ;
                                                                              rdfs:label "sentence_30584306_11" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30584306_12
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30584306_12> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30584306> ;
                                                                              gutprop:hasSentenceText "This is a cross-sectional study and the sample size is comparatively small." ;
                                                                              rdfs:label "sentence_30584306_12" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30584306_13
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30584306_13> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30584306> ;
                                                                              gutprop:hasSentenceText "Though several diet-related factors were controlled in the study, there is no quantified assessment of it." ;
                                                                              rdfs:label "sentence_30584306_13" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30584306_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30584306_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30584306> ;
                                                                             gutprop:hasSentenceText "Several studies have shown that patients with depression were also accompanied with gut microbiota disorder, in which Firmicutes are related to the protective function of intestinal barrier." ;
                                                                             rdfs:label "sentence_30584306_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30584306_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30584306_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30584306> ;
                                                                             gutprop:hasSentenceText "In this study, we explore the changes and effects of Firmicutes in the patients with major depressive disorder (MDD)." ;
                                                                             rdfs:label "sentence_30584306_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30584306_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30584306_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30584306> ;
                                                                             gutprop:hasSentenceText "We recruited 54 subjects, including 27 patients with MDD." ;
                                                                             rdfs:label "sentence_30584306_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30584306_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30584306_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30584306> ;
                                                                             gutprop:hasSentenceText "Fecal samples were collected for identification by 16S rRNA sequencing and bioinformatics analysis." ;
                                                                             rdfs:label "sentence_30584306_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30584306_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30584306_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30584306> ;
                                                                             gutprop:hasSentenceText "The study shows that the alpha diversity indices of MDD patients are lower than those of the healthy controls." ;
                                                                             rdfs:label "sentence_30584306_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30584306_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30584306_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30584306> ;
                                                                             gutprop:hasSentenceText "Firmicutes is the most significantly decreased phylum in the MDD samples." ;
                                                                             rdfs:label "sentence_30584306_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30584306_8
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30584306_8> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30584306> ;
                                                                             gutprop:hasSentenceText "There are totally 13 taxonomic biomarkers with <i>P</i>-value <0.01 from Firmicutes." ;
                                                                             rdfs:label "sentence_30584306_8" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30584306_9
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30584306_9> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30584306> ;
                                                                             gutprop:hasSentenceText "There are differences in 17 KEGG pathways between the two groups." ;
                                                                             rdfs:label "sentence_30584306_9" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30659564_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30659564_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/30659564> ;
                                                                             gutprop:hasSentenceText "Can microbiology affect psychiatry?" ;
                                                                             rdfs:label "sentence_30659564_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30659564_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30659564_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30659564> ;
                                                                             gutprop:hasSentenceText "A link between gut microbiota and psychiatric disorders." ;
                                                                             rdfs:label "sentence_30659564_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30659564_10
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30659564_10> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30659564> ;
                                                                              gutprop:hasSentenceText "This subject requires further examination, especially taking into consideration potential therapeutic options." ;
                                                                              rdfs:label "sentence_30659564_10" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30659564_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30659564_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30659564> ;
                                                                             gutprop:hasSentenceText "Every single human consists of thousands of genes, billions of neurons and trillions of bacteria." ;
                                                                             rdfs:label "sentence_30659564_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30659564_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30659564_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30659564> ;
                                                                             gutprop:hasSentenceText "There is a rapidly growing number of data that links the gut microbiome to the development and functioning of the central nervous system, which is a currently proposed paradigm shift in neuroscience." ;
                                                                             rdfs:label "sentence_30659564_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30659564_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30659564_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30659564> ;
                                                                             gutprop:hasSentenceText "Knowledge on the relationship between gut microbiota and mental disorders is constantly increasing." ;
                                                                             rdfs:label "sentence_30659564_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30659564_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30659564_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30659564> ;
                                                                             gutprop:hasSentenceText "This phenomenon is known as \"gut-brain axis\"." ;
                                                                             rdfs:label "sentence_30659564_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30659564_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30659564_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30659564> ;
                                                                             gutprop:hasSentenceText "The strongest evidence for the role of microbes in the gut-brain axis comes from animal studies." ;
                                                                             rdfs:label "sentence_30659564_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30659564_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30659564_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30659564> ;
                                                                             gutprop:hasSentenceText "Nevertheless, the gutbrain crosstalk is a bidirectional communication system that not only provides gastrointestinal homeostasis, but can also affect motivation as well as higher cognitive functions." ;
                                                                             rdfs:label "sentence_30659564_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30659564_8
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30659564_8> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30659564> ;
                                                                             gutprop:hasSentenceText "Moreover, gut microbiome can be associated with obesity and inflammatory gastrointestinal disorders." ;
                                                                             rdfs:label "sentence_30659564_8" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30659564_9
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30659564_9> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30659564> ;
                                                                             gutprop:hasSentenceText "According to the recent studies, there is a link between the composition of gut microbiota and mental disorders in animals (response to depression and chronic stress)." ;
                                                                             rdfs:label "sentence_30659564_9" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30701194_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30701194_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/30701194> ;
                                                                             gutprop:hasSentenceText "Alterations in Gut Glutamate Metabolism Associated with Changes in Gut Microbiota Composition in Children with Autism Spectrum Disorder." ;
                                                                             rdfs:label "sentence_30701194_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30701194_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30701194_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30701194> ;
                                                                             gutprop:hasSentenceText "Changes in the gut microenvironment may influence the pathogenesis of autism spectrum disorders (ASD)." ;
                                                                             rdfs:label "sentence_30701194_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30701194_10
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30701194_10> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30701194> ;
                                                                              gutprop:hasSentenceText "Finally, gut 2-keto-glutaramic acid was validated as a potential biomarker for ASD." ;
                                                                              rdfs:label "sentence_30701194_10" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30701194_11
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30701194_11> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30701194> ;
                                                                              gutprop:hasSentenceText "The significant changes in the gut microenvironment in children with ASD may provide new insight into the cause of ASD and aid in the search for diagnostic and therapeutic approaches." ;
                                                                              rdfs:label "sentence_30701194_11" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30701194_12
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30701194_12> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30701194> ;
                                                                              gutprop:hasSentenceText "<b>IMPORTANCE</b> Multiple lines of evidence suggest that the gut microbiota may play an important role in the pathogenesis of ASD, but the specific mechanism is still unclear." ;
                                                                              rdfs:label "sentence_30701194_12" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30701194_13
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30701194_13> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30701194> ;
                                                                              gutprop:hasSentenceText "Through a comprehensive gut metagenomic and metabolome study of children with ASD, alterations in gut metabolite composition were found in children with ASD, and these alterations were linked to changes in gut microbiota composition." ;
                                                                              rdfs:label "sentence_30701194_13" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30701194_14
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30701194_14> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30701194> ;
                                                                              gutprop:hasSentenceText "This may give us a deeper understanding of the role of gut microbiota in the pathogenesis of ASD." ;
                                                                              rdfs:label "sentence_30701194_14" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30701194_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30701194_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30701194> ;
                                                                             gutprop:hasSentenceText "Here, we investigated the composition of the gut microbiota and metabolites in children with ASD." ;
                                                                             rdfs:label "sentence_30701194_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30701194_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30701194_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30701194> ;
                                                                             gutprop:hasSentenceText "Ninety-two children with ASD and 42 age-matched children exhibiting typical development (TD) were enrolled in the two-stage study." ;
                                                                             rdfs:label "sentence_30701194_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30701194_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30701194_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30701194> ;
                                                                             gutprop:hasSentenceText "In the discovery stage, shotgun metagenomic sequencing and liquid chromatography-mass spectrometry (LC-MS) were performed simultaneously on fecal samples obtained from 43 children in the ASD group and 31 children in the TD group." ;
                                                                             rdfs:label "sentence_30701194_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30701194_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30701194_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30701194> ;
                                                                             gutprop:hasSentenceText "Systematic bioinformatic analyses were performed to identify gut metabolites associated with altered gut microbiota composition." ;
                                                                             rdfs:label "sentence_30701194_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30701194_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30701194_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30701194> ;
                                                                             gutprop:hasSentenceText "At the validation stage, differential metabolites were tested using LC-MS with an additional 49 and 11 children in the ASD and TD groups, respectively." ;
                                                                             rdfs:label "sentence_30701194_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30701194_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30701194_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30701194> ;
                                                                             gutprop:hasSentenceText "Altered glutamate metabolites were found in the ASD group, along with a decline in 2-keto-glutaramic acid and an abundance of microbiota associated with glutamate metabolism." ;
                                                                             rdfs:label "sentence_30701194_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30701194_8
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30701194_8> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30701194> ;
                                                                             gutprop:hasSentenceText "These changes in glutamate metabolism were correlated with lower levels of the highly abundant bacteria Bacteroides vulgatus and higher levels of the potentially harmful Eggerthella lenta and Clostridium botulinum." ;
                                                                             rdfs:label "sentence_30701194_8" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30701194_9
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30701194_9> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30701194> ;
                                                                             gutprop:hasSentenceText "Lower gut cortisol levels have also been identified in the ASD group and associated with changes in gut microbiota glutamate metabolism." ;
                                                                             rdfs:label "sentence_30701194_9" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30707176_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30707176_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/30707176> ;
                                                                             gutprop:hasSentenceText "Gut microbiota analysis and its significance in vasovagal syncope in children." ;
                                                                             rdfs:label "sentence_30707176_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30707176_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30707176_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30707176> ;
                                                                             gutprop:hasSentenceText "Vasovagal syncope (VVS) is common in children and greatly affect both physical and mental health." ;
                                                                             rdfs:label "sentence_30707176_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30707176_10
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30707176_10> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30707176> ;
                                                                              gutprop:hasSentenceText "In terms of its correlation with hemodynamics, we showed that relative abundance of Ruminococcaceae was negatively correlated with the systolic and diastolic pressure reduction at the positive response in head-up tilt test (HUTT; r = -0.489 and -0.448, all P < 0.05), but was positively correlated with the mean pressure drop and decline rate (r = 0.489 and 0.467, all P < 0.05) as well as diastolic pressure drop and decline rate at the HUTT positive response (r = 0.579 and 0.589, all P < 0.01) in VVS patients." ;
                                                                              rdfs:label "sentence_30707176_10" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30707176_11
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30707176_11> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30707176> ;
                                                                              gutprop:hasSentenceText "Ruminococcaceae was the predominant gut bacteria and was associated with the clinical symptoms and hemodynamics of VVS, suggesting that gut microbiota might be involved in the development of VVS." ;
                                                                              rdfs:label "sentence_30707176_11" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30707176_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30707176_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30707176> ;
                                                                             gutprop:hasSentenceText "But the mechanisms have not been completely explained." ;
                                                                             rdfs:label "sentence_30707176_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30707176_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30707176_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30707176> ;
                                                                             gutprop:hasSentenceText "This study was designed to analyze the gut microbiota in children with VVS and explore its clinical significance." ;
                                                                             rdfs:label "sentence_30707176_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30707176_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30707176_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30707176> ;
                                                                             gutprop:hasSentenceText "Fecal samples from 20 VVS children and 20 matched controls were collected, and the microbiota were analyzed by 16S rRNA gene sequencing." ;
                                                                             rdfs:label "sentence_30707176_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30707176_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30707176_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30707176> ;
                                                                             gutprop:hasSentenceText "The diversity and microbiota compositions of the VVS cases and controls were compared with the independent sample t test or Mann-Whitney U test." ;
                                                                             rdfs:label "sentence_30707176_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30707176_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30707176_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30707176> ;
                                                                             gutprop:hasSentenceText "The correlation between the predominant bacteria and clinical symptoms was analyzed using Pearson or Spearman correlation test." ;
                                                                             rdfs:label "sentence_30707176_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30707176_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30707176_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30707176> ;
                                                                             gutprop:hasSentenceText "No significant differences in diversity were evident between VVS and controls (P > 0.05)." ;
                                                                             rdfs:label "sentence_30707176_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30707176_8
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30707176_8> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30707176> ;
                                                                             gutprop:hasSentenceText "At the family level, the relative abundance of Ruminococcaceae was significantly higher in VVS children than in controls (median [Q1, Q3]: 22.10% [16.89%, 27.36%] vs. 13.92% [10.31%, 20.18%], Z = -2.40, P < 0.05), and LEfSe analysis revealed Ruminococcaceae as a discriminative feature (linear discriminant analysis [LDA] score > 4, P < 0.05)." ;
                                                                             rdfs:label "sentence_30707176_8" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30707176_9
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30707176_9> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30707176> ;
                                                                             gutprop:hasSentenceText "The relative abundance of Ruminococcaceae in VVS patients was positively correlated with the frequency of syncope (r = 0.616, P < 0.01)." ;
                                                                             rdfs:label "sentence_30707176_9" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30717162_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30717162_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/30717162> ;
                                                                             gutprop:hasSentenceText "Fecal Microbiota Analysis in Patients Going through a Depressive Episode during Treatment in a Psychiatric Hospital Setting." ;
                                                                             rdfs:label "sentence_30717162_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30717162_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30717162_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30717162> ;
                                                                             gutprop:hasSentenceText "There is a worldwide prevalence of generalized anxiety and major depressive disorders (MDD)." ;
                                                                             rdfs:label "sentence_30717162_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30717162_10
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30717162_10> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30717162> ;
                                                                              gutprop:hasSentenceText "No significant differences between taxa levels, at the studied time points, were observed when adjusted for multiple hypotheses testing procedures." ;
                                                                              rdfs:label "sentence_30717162_10" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30717162_11
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30717162_11> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30717162> ;
                                                                              gutprop:hasSentenceText "We conclude that a six-week treatment in a psychiatric hospital setting resulted in increased alpha biodiversity in fecal microbiota, however its causal relationship with patients' mental health was not proved." ;
                                                                              rdfs:label "sentence_30717162_11" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30717162_12
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30717162_12> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30717162> ;
                                                                              gutprop:hasSentenceText "We have also found that individual microbiome stability was not affected by hospitalization." ;
                                                                              rdfs:label "sentence_30717162_12" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30717162_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30717162_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30717162> ;
                                                                             gutprop:hasSentenceText "Gut⁻brain axis dysfunction, antibacterial activity, and modulatory effects of antidepressants toward intestinal bacteria have been shown both in vitro and in vivo." ;
                                                                             rdfs:label "sentence_30717162_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30717162_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30717162_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30717162> ;
                                                                             gutprop:hasSentenceText "In this study, we aimed to investigate the effects of hospital stay, including escitalopram administration, on gut microbiota in patients with depressive episodes." ;
                                                                             rdfs:label "sentence_30717162_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30717162_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30717162_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30717162> ;
                                                                             gutprop:hasSentenceText "After admission to the hospital and 7-days washout from all medications the composition of fecal microbiota samples was evaluated at baseline (W0) and after 6 weeks (W6), using 16S rRNA sequencing." ;
                                                                             rdfs:label "sentence_30717162_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30717162_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30717162_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30717162> ;
                                                                             gutprop:hasSentenceText "The study was conducted on 17 inpatients (52.9% females), who followed the same daily hospital routine, including a standard diet and received 5⁻20 mg daily doses of escitalopram." ;
                                                                             rdfs:label "sentence_30717162_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30717162_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30717162_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30717162> ;
                                                                             gutprop:hasSentenceText "At the end of treatment (W6), no change was observed in the Chao1 index." ;
                                                                             rdfs:label "sentence_30717162_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30717162_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30717162_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30717162> ;
                                                                             gutprop:hasSentenceText "However, Shannon (median (Q1⁻Q3): W0 2.78 (2.67⁻3.02) vs. W6 3.11 (2.80⁻3.30)), and inverse Simpson (median (Q1⁻Q3): W0 9.26 (7.26⁻13.76) vs. W6 12.13 (9.17⁻15.73)) indices increased significantly compared to baseline values (False Discovery Rate <i>p</i> (<i>q</i>) = 0.031 and <i>q</i> = 0.011, respectively)." ;
                                                                             rdfs:label "sentence_30717162_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30717162_8
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30717162_8> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30717162> ;
                                                                             gutprop:hasSentenceText "We also found that between-subject W0 Bray⁻Curtis dissimilarities were significantly higher than W0⁻W6 within-subject dissimilarities (median (Q1⁻Q3): 0.68 (0.56⁻0.77) vs. 0.38 (0.35⁻0.52), two sided Mann⁻Whitney test <i>p</i> < 0.00001." ;
                                                                             rdfs:label "sentence_30717162_8" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30717162_9
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30717162_9> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30717162> ;
                                                                             gutprop:hasSentenceText "The within-subject dissimilarities did not depend on sex, age, BMI, illness duration and a daily dose of escitalopram." ;
                                                                             rdfs:label "sentence_30717162_9" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30818031_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30818031_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/30818031> ;
                                                                             gutprop:hasSentenceText "Impact of chemotherapy on the association between fear of cancer recurrence and the gut microbiota in breast cancer survivors." ;
                                                                             rdfs:label "sentence_30818031_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30818031_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30818031_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30818031> ;
                                                                             gutprop:hasSentenceText "Dysfunctional processing of fear memory may be involved in the pathophysiology of fear of cancer recurrence (FCR), which is cited as the major unmet psychological need of cancer survivors." ;
                                                                             rdfs:label "sentence_30818031_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30818031_10
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30818031_10> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30818031> ;
                                                                              gutprop:hasSentenceText "Our findings provide the first evidence of an association between the gut microbiota and FCR and suggest that chemotherapy-induced changes in gut microbiota can influence FCR." ;
                                                                              rdfs:label "sentence_30818031_10" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30818031_11
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30818031_11> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30818031> ;
                                                                              gutprop:hasSentenceText "Further studies should examine the effects of the gut microbiota on FCR using a prospective design." ;
                                                                              rdfs:label "sentence_30818031_11" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30818031_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30818031_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30818031> ;
                                                                             gutprop:hasSentenceText "Emerging evidence has shown that the microbiota-gut-brain (MGB) axis affects depressive and anxiety disorders, and chemotherapy-associated psychological distress." ;
                                                                             rdfs:label "sentence_30818031_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30818031_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30818031_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30818031> ;
                                                                             gutprop:hasSentenceText "We therefore hypothesized that the gut microbiota is associated with FCR in cancer survivors." ;
                                                                             rdfs:label "sentence_30818031_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30818031_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30818031_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30818031> ;
                                                                             gutprop:hasSentenceText "This cross-sectional study enrolled women diagnosed with invasive breast cancer who were not currently undergoing chemotherapy." ;
                                                                             rdfs:label "sentence_30818031_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30818031_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30818031_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30818031> ;
                                                                             gutprop:hasSentenceText "Fecal samples were obtained to assess the gut microbiota." ;
                                                                             rdfs:label "sentence_30818031_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30818031_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30818031_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30818031> ;
                                                                             gutprop:hasSentenceText "FCR grade was assessed using the Concerns About Recurrence Scale (CARS)." ;
                                                                             rdfs:label "sentence_30818031_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30818031_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30818031_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30818031> ;
                                                                             gutprop:hasSentenceText "Mean age of the participants (n = 126) was 58 years; 47% had stage I disease." ;
                                                                             rdfs:label "sentence_30818031_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30818031_8
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30818031_8> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30818031> ;
                                                                             gutprop:hasSentenceText "Multiple regression analysis with adjustment for possible confounders showed that the relative abundance of the Bacteroides genus (beta = 0.180, p = 0.03) was significantly and directly associated with FCR." ;
                                                                             rdfs:label "sentence_30818031_8" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30818031_9
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30818031_9> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30818031> ;
                                                                             gutprop:hasSentenceText "In the 57 participants with a history of chemotherapy, higher FCR was associated with lower microbial diversity (p = 0.04), lower relative abundance of Firmicutes (p = 0.03) and higher relative abundance of Bacteroidetes (p = 0.04) at the phylum level, and higher relative abundance of Bacteroides (p < 0.01) and lower relative abundance of Lachnospiraceae.g (p = 0.03) and Ruminococcus (p = 0.02) at the genus level." ;
                                                                             rdfs:label "sentence_30818031_9" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30826885_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30826885_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/30826885> ;
                                                                             gutprop:hasSentenceText "The Relationship Between Perinatal Mental Health and Stress: a Review of the Microbiome." ;
                                                                             rdfs:label "sentence_30826885_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30826885_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30826885_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30826885> ;
                                                                             gutprop:hasSentenceText "Our current understanding of the underlying mechanisms and etiologies of perinatal mood and anxiety disorders (PMADs) is not clearly identified." ;
                                                                             rdfs:label "sentence_30826885_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30826885_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30826885_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30826885> ;
                                                                             gutprop:hasSentenceText "The relationship of stress-induced adaptations (i.e., the hypothalamic-pituitary-adrenal (HPA) axis, the autonomic nervous system (ANS), the immune system) and the microbiota are potential contributors to psychopathology exhibited in women during pregnancy and postpartum and should be investigated." ;
                                                                             rdfs:label "sentence_30826885_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30826885_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30826885_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30826885> ;
                                                                             gutprop:hasSentenceText "The stress response activates the HPA axis and dysregulates the ANS, leading to the inhibition of the parasympathetic system." ;
                                                                             rdfs:label "sentence_30826885_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30826885_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30826885_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30826885> ;
                                                                             gutprop:hasSentenceText "Sustained high levels of cortisol, reduced heart variability, and modulated immune responses increase the vulnerability to PMAD." ;
                                                                             rdfs:label "sentence_30826885_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30826885_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30826885_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30826885> ;
                                                                             gutprop:hasSentenceText "Bidirectional communication between the nervous system and the microbiota is an important factor to alter host homeostasis and development of PMAD." ;
                                                                             rdfs:label "sentence_30826885_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30826885_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30826885_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30826885> ;
                                                                             gutprop:hasSentenceText "Future research in the relationship between the psychoneuroimmune system, the gut microbiota, and PMAD has the potential to be integrated in clinical practice to improve screening, diagnosis, and treatment." ;
                                                                             rdfs:label "sentence_30826885_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30828318_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30828318_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/30828318> ;
                                                                             gutprop:hasSentenceText "Disentangling What We Know About Microbes and Mental Health." ;
                                                                             rdfs:label "sentence_30828318_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30828318_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30828318_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30828318> ;
                                                                             gutprop:hasSentenceText "Much has been written in recent years about the gut-brain axis." ;
                                                                             rdfs:label "sentence_30828318_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30828318_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30828318_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30828318> ;
                                                                             gutprop:hasSentenceText "Exciting pilot studies suggest probiotic applications to the gut can reduce anxiety and depression via the vagus nerve." ;
                                                                             rdfs:label "sentence_30828318_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30828318_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30828318_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30828318> ;
                                                                             gutprop:hasSentenceText "But not to diminish such findings, much still needs to be considered, including the fact that the vagus nerve links to many other body sites that also host a microbiome." ;
                                                                             rdfs:label "sentence_30828318_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30828318_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30828318_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30828318> ;
                                                                             gutprop:hasSentenceText "Questions remain that touch the core of being human: (i) Do our microbes influence happiness and to what extent?" ;
                                                                             rdfs:label "sentence_30828318_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30828318_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30828318_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30828318> ;
                                                                             gutprop:hasSentenceText "(ii) What components of the gut microbiota and their function, including as it relates to mental health, are critical and how do they differ between agile, fit hunter gatherers and obese westerners or Danes described as the happiest people on the planet?" ;
                                                                             rdfs:label "sentence_30828318_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30828318_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30828318_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30828318> ;
                                                                             gutprop:hasSentenceText "(iii) What role do environmental pollutants play in this microbes-host ecosystem?" ;
                                                                             rdfs:label "sentence_30828318_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30828318_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30828318_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30828318> ;
                                                                             gutprop:hasSentenceText "While approaching life from a reductionist perspective has a long history in science, we need to try to interrogate these health and disease issues from a wider perspective." ;
                                                                             rdfs:label "sentence_30828318_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30828318_8
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30828318_8> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30828318> ;
                                                                             gutprop:hasSentenceText "For verification of a link between the gut microbiota and brain, and to test new therapies, human studies are needed, and are long overdue." ;
                                                                             rdfs:label "sentence_30828318_8" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30900006_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30900006_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/30900006> ;
                                                                             gutprop:hasSentenceText "Microbe and host interaction in gastrointestinal homeostasis." ;
                                                                             rdfs:label "sentence_30900006_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30900006_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30900006_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30900006> ;
                                                                             gutprop:hasSentenceText "Researchers in psychiatry and neuroscience are increasingly recognizing the importance of gut-brain communication in mental health." ;
                                                                             rdfs:label "sentence_30900006_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30900006_10
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30900006_10> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30900006> ;
                                                                              gutprop:hasSentenceText "The results of this study provide insight into how specific taxa influence gut barrier integrity and function." ;
                                                                              rdfs:label "sentence_30900006_10" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30900006_11
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30900006_11> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30900006> ;
                                                                              gutprop:hasSentenceText "More generally, these data in the context of recent published studies makes a significant contribution to our understanding of host-microbe interactions providing new knowledge that can be harnessed by us and others in future mechanistic studies." ;
                                                                              rdfs:label "sentence_30900006_11" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30900006_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30900006_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30900006> ;
                                                                             gutprop:hasSentenceText "Both genetics and environmental factors influence gut microbiota composition and function." ;
                                                                             rdfs:label "sentence_30900006_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30900006_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30900006_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30900006> ;
                                                                             gutprop:hasSentenceText "This study examines host-microbe signaling at the gastrointestinal barrier to identify bottom-up mechanisms of microbiota-brain communication." ;
                                                                             rdfs:label "sentence_30900006_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30900006_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30900006_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30900006> ;
                                                                             gutprop:hasSentenceText "We examined differences in gut microbiota composition and fecal miRNA profiles in BALB/c and C57BL/6 mice, in relation to gastrointestinal homeostasis and evaluated the response to perturbation of the gut microbiota by broad-spectrum antibiotic treatment." ;
                                                                             rdfs:label "sentence_30900006_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30900006_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30900006_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30900006> ;
                                                                             gutprop:hasSentenceText "Differences in the gut microbiota composition between BALB/c and C57BL/6 mice, evaluated by fecal 16S rRNA gene sequencing, included significant differences in genera Prevotella, Alistipes, Akkermansia, and Ruminococcus." ;
                                                                             rdfs:label "sentence_30900006_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30900006_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30900006_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30900006> ;
                                                                             gutprop:hasSentenceText "Significant differences in fecal miRNA profiles were determined using the nCounter NanoString platform." ;
                                                                             rdfs:label "sentence_30900006_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30900006_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30900006_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30900006> ;
                                                                             gutprop:hasSentenceText "A BLASTn analysis identified conserved fecal miRNA target regions in bacterial metagenomes with 14 significant correlations found between fecal miRNA and predicted taxa relative abundance in our dataset." ;
                                                                             rdfs:label "sentence_30900006_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30900006_8
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30900006_8> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30900006> ;
                                                                             gutprop:hasSentenceText "Treatment with broad-spectrum antibiotics for 2 weeks resulted in a host-specific physiological response at the gastrointestinal barrier including a decrease in barrier permeability in BALB/c mice and alterations in the expression of barrier regulating genes in both strains." ;
                                                                             rdfs:label "sentence_30900006_8" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30900006_9
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30900006_9> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30900006> ;
                                                                             gutprop:hasSentenceText "Genera Parabacteroides and Bacteroides were associated with changes in barrier function." ;
                                                                             rdfs:label "sentence_30900006_9" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31053995_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31053995_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/31053995> ;
                                                                             gutprop:hasSentenceText "Gender specific decrease of a set of circulating N-acylphosphatidyl ethanolamines (NAPEs) in the plasma of Parkinson's disease patients." ;
                                                                             rdfs:label "sentence_31053995_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31053995_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31053995_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31053995> ;
                                                                             gutprop:hasSentenceText "Current markers of Parkinson's disease (PD) fail to detect the early progression of disease state." ;
                                                                             rdfs:label "sentence_31053995_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31053995_10
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31053995_10> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31053995> ;
                                                                              gutprop:hasSentenceText "We also suggest a molecular mechanism, explaining our findings, which involves gut microbiota." ;
                                                                              rdfs:label "sentence_31053995_10" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31053995_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31053995_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31053995> ;
                                                                             gutprop:hasSentenceText "Conversely, current omics techniques allow the investigation of hundreds of molecules potentially altered by disease conditions." ;
                                                                             rdfs:label "sentence_31053995_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31053995_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31053995_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31053995> ;
                                                                             gutprop:hasSentenceText "Based on evidence previously collected by our group in a mouse model of PD, we speculated that a particular set of circulating lipids might be significantly altered by the pathology." ;
                                                                             rdfs:label "sentence_31053995_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31053995_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31053995_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31053995> ;
                                                                             gutprop:hasSentenceText "The aim of current study was to evaluate the potential of a particular set of N-acyl-phosphatidylethanolamines (NAPEs) as potential non-invasive plasma markers of ongoing neurodegeneration from Parkinson's disease in human subjects." ;
                                                                             rdfs:label "sentence_31053995_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31053995_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31053995_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31053995> ;
                                                                             gutprop:hasSentenceText "A panel of seven NAPEs were quantified by LC-MS/MS in the plasma of 587 individuals (healthy controls, n = 319; Parkinson's disease, n = 268); Random Forest classification and statistical modeling was applied to compare Parkinson's disease versus controls." ;
                                                                             rdfs:label "sentence_31053995_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31053995_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31053995_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31053995> ;
                                                                             gutprop:hasSentenceText "All p-values obtained in different tests were corrected for multiplicity by controlling the false discovery rate (FDR)." ;
                                                                             rdfs:label "sentence_31053995_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31053995_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31053995_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31053995> ;
                                                                             gutprop:hasSentenceText "The results indicate that this panel of NAPEs is able to distinguish female PD patients from the corresponding healthy controls." ;
                                                                             rdfs:label "sentence_31053995_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31053995_8
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31053995_8> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31053995> ;
                                                                             gutprop:hasSentenceText "Further to this, the observed downregulation of these NAPEs is in line with the results in plasma of a mouse model of Parkinson's (6-OHDA)." ;
                                                                             rdfs:label "sentence_31053995_8" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31053995_9
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31053995_9> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31053995> ;
                                                                             gutprop:hasSentenceText "In the current study we have shown the downregulation of NAPEs in plasma of PD patients and we thus speculate that these lipids might serve as candidate biomarkers for PD." ;
                                                                             rdfs:label "sentence_31053995_9" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31083360_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31083360_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/31083360> ;
                                                                             gutprop:hasSentenceText "A Systematic Review of the Role of Prebiotics and Probiotics in Autism Spectrum Disorders." ;
                                                                             rdfs:label "sentence_31083360_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31083360_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31083360_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31083360> ;
                                                                             gutprop:hasSentenceText "<i>Background</i>: Autism spectrum disorder (ASD) is a complex developmental condition typically characterized by deficits in social and communicative behaviors as well as repetitive patterns of behaviors." ;
                                                                             rdfs:label "sentence_31083360_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31083360_10
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31083360_10> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31083360> ;
                                                                              gutprop:hasSentenceText "Most of these were prospective, open-label studies." ;
                                                                              rdfs:label "sentence_31083360_10" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31083360_11
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31083360_11> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31083360> ;
                                                                              gutprop:hasSentenceText "Prebiotics only improved certain GI symptoms; however, when combined with an exclusion diet (gluten and casein free) showed a significant reduction in anti-sociability scores." ;
                                                                              rdfs:label "sentence_31083360_11" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31083360_12
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31083360_12> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31083360> ;
                                                                              gutprop:hasSentenceText "As for probiotics, there is limited evidence to support the role of probiotics in alleviating the GI or behavioral symptoms in children with ASD." ;
                                                                              rdfs:label "sentence_31083360_12" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31083360_13
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31083360_13> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31083360> ;
                                                                              gutprop:hasSentenceText "The two available double-blind, randomized, placebo-controlled trials found no significant difference in GI symptoms and behavior." ;
                                                                              rdfs:label "sentence_31083360_13" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31083360_14
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31083360_14> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31083360> ;
                                                                              gutprop:hasSentenceText "<i>Conclusion</i>: Despite promising preclinical findings, prebiotics and probiotics have demonstrated an overall limited efficacy in the management of GI or behavioral symptoms in children with ASD." ;
                                                                              rdfs:label "sentence_31083360_14" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31083360_15
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31083360_15> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31083360> ;
                                                                              gutprop:hasSentenceText "In addition, there was no standardized probiotics regimen, with multiple different strains and concentrations of probiotics, and variable duration of treatments." ;
                                                                              rdfs:label "sentence_31083360_15" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31083360_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31083360_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31083360> ;
                                                                             gutprop:hasSentenceText "Despite its prevalence (affecting 0.1% to 1.8% of the global population), the pathogenesis of ASD remains incompletely understood." ;
                                                                             rdfs:label "sentence_31083360_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31083360_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31083360_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31083360> ;
                                                                             gutprop:hasSentenceText "Patients with ASD are reported to have more frequent gastrointestinal (GI) complaints." ;
                                                                             rdfs:label "sentence_31083360_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31083360_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31083360_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31083360> ;
                                                                             gutprop:hasSentenceText "There is some anecdotal evidence that probiotics are able to alleviate GI symptoms as well as improve behavioral issues in children with ASD." ;
                                                                             rdfs:label "sentence_31083360_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31083360_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31083360_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31083360> ;
                                                                             gutprop:hasSentenceText "However, systematic reviews of the effect of prebiotics/probiotics on ASD and its associated symptoms are lacking." ;
                                                                             rdfs:label "sentence_31083360_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31083360_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31083360_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31083360> ;
                                                                             gutprop:hasSentenceText "<i>Methods</i>: Using the keywords (prebiotics OR probiotics OR microbiota OR gut) AND (autism OR social OR ASD), a systematic literature search was conducted on PubMed, EMBASE, Medline, Clinicaltrials.gov and Google Scholar databases." ;
                                                                             rdfs:label "sentence_31083360_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31083360_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31083360_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31083360> ;
                                                                             gutprop:hasSentenceText "The inclusion criteria were original clinical trials, published in English between the period 1st January 1988 and 1st February 2019." ;
                                                                             rdfs:label "sentence_31083360_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31083360_8
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31083360_8> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31083360> ;
                                                                             gutprop:hasSentenceText "<i>Results</i>: A total of eight clinical trials were systematically reviewed." ;
                                                                             rdfs:label "sentence_31083360_8" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31083360_9
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31083360_9> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31083360> ;
                                                                             gutprop:hasSentenceText "Two clinical trials examined the use of prebiotic and/or diet exclusion while six involved the use of probiotic supplementation in children with ASD." ;
                                                                             rdfs:label "sentence_31083360_9" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31132457_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31132457_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/31132457> ;
                                                                             gutprop:hasSentenceText "Gut microbiota composition is associated with temperament traits in infants." ;
                                                                             rdfs:label "sentence_31132457_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31132457_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31132457_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31132457> ;
                                                                             gutprop:hasSentenceText "One of the key behavioral phenotypes in infancy are different temperament traits, and certain early life temperament traits have been shown to precede later mental health problems." ;
                                                                             rdfs:label "sentence_31132457_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31132457_10
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31132457_10> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31132457> ;
                                                                              gutprop:hasSentenceText "The IBQ-R main dimension surgency (positive emotionality) was associated positively both with genus Bifidobacterium and Streptococcus." ;
                                                                              rdfs:label "sentence_31132457_10" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31132457_11
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31132457_11> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31132457> ;
                                                                              gutprop:hasSentenceText "Alpha diversity had a negative association with negative emotionality and fear reactivity." ;
                                                                              rdfs:label "sentence_31132457_11" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31132457_12
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31132457_12> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31132457> ;
                                                                              gutprop:hasSentenceText "This is the first study demonstrating associations, but not causal connections, between GMC and temperament in young infants in a prospective design." ;
                                                                              rdfs:label "sentence_31132457_12" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31132457_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31132457_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31132457> ;
                                                                             gutprop:hasSentenceText "Differences in the gut microbiota composition (GMC) have been suggested to link with neurodevelopment." ;
                                                                             rdfs:label "sentence_31132457_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31132457_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31132457_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31132457> ;
                                                                             gutprop:hasSentenceText "For example, toddler temperament traits have been found to associate with differences in GMC; however, studies in infants are lacking although infancy is a rapid period of neurodevelopment as well as GM development." ;
                                                                             rdfs:label "sentence_31132457_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31132457_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31132457_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31132457> ;
                                                                             gutprop:hasSentenceText "Thus, we aimed to investigate association between infant GMC and temperament." ;
                                                                             rdfs:label "sentence_31132457_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31132457_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31132457_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31132457> ;
                                                                             gutprop:hasSentenceText "The study population (n = 301, 53% boys) was drawn from the FinnBrain Birth Cohort Study." ;
                                                                             rdfs:label "sentence_31132457_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31132457_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31132457_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31132457> ;
                                                                             gutprop:hasSentenceText "Stool samples were collected from the 2.5-month-old infants and sequenced with 16S Illumina MiSeq platform." ;
                                                                             rdfs:label "sentence_31132457_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31132457_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31132457_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31132457> ;
                                                                             gutprop:hasSentenceText "GMC taxonomic composition (at Genus and OTU level), observed sample clusters, diversity and richness were investigated in relation to the maternal reports of Infant Behavior Questionnaire -Revised (IBQ-R) at the age of 6 months." ;
                                                                             rdfs:label "sentence_31132457_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31132457_8
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31132457_8> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31132457> ;
                                                                             gutprop:hasSentenceText "Three sample clusters (Bifidobacterium/Enterobacteriaceae, Bacteroides, V. Dispar) based on GMC were identified, of which Bifidobacterium/Enterobacteriaceae-cluster presented with higher scores on the IBQ-R main dimension regulation and its subscale duration of orienting compared to Bacteroides-cluster." ;
                                                                             rdfs:label "sentence_31132457_8" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31132457_9
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31132457_9> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31132457> ;
                                                                             gutprop:hasSentenceText "The clusters associated with temperament in a sex-dependent manner." ;
                                                                             rdfs:label "sentence_31132457_9" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31148353_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31148353_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/31148353> ;
                                                                             gutprop:hasSentenceText "Gutting the brain of inflammation: A key role of gut microbiome in human umbilical cord blood plasma therapy in Parkinson's disease model." ;
                                                                             rdfs:label "sentence_31148353_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31148353_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31148353_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31148353> ;
                                                                             gutprop:hasSentenceText "Current therapies for Parkinson's disease (PD), including L-3,4-dihydroxyphenylalanine (L-DOPA), and clinical trials investigating dopaminergic cell transplants, have generated mixed results with the eventual induction of dyskinetic side effects." ;
                                                                             rdfs:label "sentence_31148353_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31148353_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31148353_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31148353> ;
                                                                             gutprop:hasSentenceText "Although human umbilical cord blood (hUCB) stem/progenitor cells present with no or minimal capacity of differentiation into mature dopaminergic neurons, their transplantation significantly attenuates parkinsonian symptoms likely via bystander effects, specifically stem cell graft-mediated secretion of growth factors, anti-inflammatory cytokines, or synaptic function altogether promoting brain repair." ;
                                                                             rdfs:label "sentence_31148353_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31148353_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31148353_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31148353> ;
                                                                             gutprop:hasSentenceText "Recognizing this non-cell replacement mechanism, we examined here the effects of intravenously transplanted combination of hUCB-derived plasma into the 1-methyl-4-phenyl-1,2,3,6-tetrahydropyridine (MPTP)-induced rat model of PD." ;
                                                                             rdfs:label "sentence_31148353_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31148353_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31148353_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31148353> ;
                                                                             gutprop:hasSentenceText "Animals received repeated dosing of either hUCB-derived plasma or vehicle at 3, 5 and 10 days after induction into MPTP lesion, then behaviourally and immunohistochemically evaluated over 56 days post-lesion." ;
                                                                             rdfs:label "sentence_31148353_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31148353_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31148353_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31148353> ;
                                                                             gutprop:hasSentenceText "Compared to vehicle treatment, transplantation with hUCB-derived plasma significantly improved motor function, gut motility and dopaminergic neuronal survival in the substantia nigra pars compacta (SNpc), which coincided with reduced pro-inflammatory cytokines in both the SNpc and the intestinal mucosa and dampened inflammation-associated gut microbiota." ;
                                                                             rdfs:label "sentence_31148353_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31148353_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31148353_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31148353> ;
                                                                             gutprop:hasSentenceText "These novel data directly implicate a key pathological crosstalk between gut and brain ushering a new avenue of therapeutically targeting the gut microbiome with hUCB-derived stem cells and plasma for PD." ;
                                                                             rdfs:label "sentence_31148353_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31154909_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31154909_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/31154909> ;
                                                                             gutprop:hasSentenceText "Unravelled facets of milk derived opioid peptides: a focus on gut physiology, fractures and obesity." ;
                                                                             rdfs:label "sentence_31154909_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31154909_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31154909_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31154909> ;
                                                                             gutprop:hasSentenceText "Beyond being a source of key nutrients, bovine milk influences physiological functions by synthesising bioactive peptides during the process of digestion." ;
                                                                             rdfs:label "sentence_31154909_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31154909_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31154909_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31154909> ;
                                                                             gutprop:hasSentenceText "Some of the claimed negative health outcomes associated with milk consumption, such as cardiovascular diseases and type 1 diabetes may be attributed to an opioid peptide, beta-casomorphin-7 (BCM-7), derived from A1 beta-casein." ;
                                                                             rdfs:label "sentence_31154909_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31154909_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31154909_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31154909> ;
                                                                             gutprop:hasSentenceText "BCM-7 exerts its function by binding to the μ-opioid receptors in the body." ;
                                                                             rdfs:label "sentence_31154909_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31154909_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31154909_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31154909> ;
                                                                             gutprop:hasSentenceText "It is hypothesised that activation of the μ-opioid receptors in the gut can alter gut microbial composition, impair gut barrier integrity and bile acid metabolism, in addition to increasing gastrointestinal transit time and gut inflammation." ;
                                                                             rdfs:label "sentence_31154909_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31154909_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31154909_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31154909> ;
                                                                             gutprop:hasSentenceText "Further, it is hypothesised that BCM-7 may influence fractures and obesity via μ-opioid receptor pathways." ;
                                                                             rdfs:label "sentence_31154909_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31154909_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31154909_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31154909> ;
                                                                             gutprop:hasSentenceText "In conclusion, it appears that BCM-7 might have multiple functions pertinent to human health; however, the evidence is limited and warrants further pre-clinical and clinical studies for hypothesis confirmation." ;
                                                                             rdfs:label "sentence_31154909_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31179435_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31179435_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/31179435> ;
                                                                             gutprop:hasSentenceText "Effects of regulating intestinal microbiota on anxiety symptoms: A systematic review." ;
                                                                             rdfs:label "sentence_31179435_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31179435_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31179435_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31179435> ;
                                                                             gutprop:hasSentenceText "Anxiety symptoms are common in mental diseases and a variety of physical disorders, especially in disorders related to stress." ;
                                                                             rdfs:label "sentence_31179435_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31179435_10
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31179435_10> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31179435> ;
                                                                              gutprop:hasSentenceText "In the 21 studies, 15 chose probiotics as interventions to regulate intestinal microbiota and six chose non-probiotic ways such as adjusting daily diets." ;
                                                                              rdfs:label "sentence_31179435_10" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31179435_11
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31179435_11> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31179435> ;
                                                                              gutprop:hasSentenceText "Probiotic supplements in seven studies contained only one kind of probiotic, two studies used a product that contained two kinds of probiotics and the supplements used in the other five studies included at least three kinds of probiotics." ;
                                                                              rdfs:label "sentence_31179435_11" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31179435_12
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31179435_12> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31179435> ;
                                                                              gutprop:hasSentenceText "In the studies that used treatment as usual plus interventions regulating intestinal flora (IRIF) as interventions (five studies), only non-probiotic ways were effective (two studies), which means 40% of studies were effective; in the studies that used IRIF alone (16 studies, 11 studies used probiotic ways and 5 studies used non-probiotic ways), 56% of studies could improve anxiety symptoms, and 80% of studies that conducted the non-probiotic interventions were effective, while 45% of studies that used probiotic supplementations had positive effects on anxiety symptoms." ;
                                                                              rdfs:label "sentence_31179435_12" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31179435_13
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31179435_13> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31179435> ;
                                                                              gutprop:hasSentenceText "Overall, 11 studies showed a positive effect on anxiety symptoms by regulating intestinal microbiota, which indicated 52% of the 21 studies were effective, and there were five studies that used probiotic supplements as interventions and six used non-probiotic interventions." ;
                                                                              rdfs:label "sentence_31179435_13" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31179435_14
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31179435_14> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31179435> ;
                                                                              gutprop:hasSentenceText "In addition, it should be noted that six of seven studies showed that regulation of intestinal microbiota could treat anxiety symptoms, the rate of efficacy was 86%." ;
                                                                              rdfs:label "sentence_31179435_14" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31179435_15
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31179435_15> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31179435> ;
                                                                              gutprop:hasSentenceText "We find that more than half of the studies included showed it was positive to treat anxiety symptoms by regulation of intestinal microbiota." ;
                                                                              rdfs:label "sentence_31179435_15" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31179435_16
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31179435_16> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31179435> ;
                                                                              gutprop:hasSentenceText "There are two kinds of interventions (probiotic and non-probiotic interventions) to regulate intestinal microbiota, and it should be highlighted that the non-probiotic interventions were more effective than the probiotic interventions." ;
                                                                              rdfs:label "sentence_31179435_16" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31179435_17
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31179435_17> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31179435> ;
                                                                              gutprop:hasSentenceText "More studies are needed to clarify this conclusion since we still cannot run meta-analysis so far." ;
                                                                              rdfs:label "sentence_31179435_17" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31179435_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31179435_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31179435> ;
                                                                             gutprop:hasSentenceText "More and more basic studies have indicated that gut microbiota can regulate brain function through the gut-brain axis, and dysbiosis of intestinal microbiota was related to anxiety." ;
                                                                             rdfs:label "sentence_31179435_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31179435_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31179435_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31179435> ;
                                                                             gutprop:hasSentenceText "However, there is no specific evidence to support treatment of anxiety by regulating intestinal microbiota." ;
                                                                             rdfs:label "sentence_31179435_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31179435_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31179435_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31179435> ;
                                                                             gutprop:hasSentenceText "To find evidence supporting improvement of anxiety symptoms by regulation of intestinal microbiota." ;
                                                                             rdfs:label "sentence_31179435_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31179435_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31179435_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31179435> ;
                                                                             gutprop:hasSentenceText "This systematic review of randomised controlled trials was searched based on the following databases: PubMed, EMBASE, the Cochrane Library, OVID, Web of Knowledge, China National Knowledge Infrastructure (CNKI), Wanfang Data, VIP databases and SinoMed." ;
                                                                             rdfs:label "sentence_31179435_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31179435_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31179435_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31179435> ;
                                                                             gutprop:hasSentenceText "The retrieval time dated back to 25 July 2018." ;
                                                                             rdfs:label "sentence_31179435_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31179435_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31179435_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31179435> ;
                                                                             gutprop:hasSentenceText "Then we screened research literatures based on established inclusion and exclusion criteria." ;
                                                                             rdfs:label "sentence_31179435_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31179435_8
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31179435_8> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31179435> ;
                                                                             gutprop:hasSentenceText "Quality evaluation for each included study was done using the Cochrane risk of bias and the Jadad scale." ;
                                                                             rdfs:label "sentence_31179435_8" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31179435_9
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31179435_9> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31179435> ;
                                                                             gutprop:hasSentenceText "A total of 3334 articles were retrieved and 21 studies were included which contained 1503 subjects." ;
                                                                             rdfs:label "sentence_31179435_9" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31218116_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31218116_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/31218116> ;
                                                                             gutprop:hasSentenceText "A 12-Week Pilot Exercise Program for Inactive Adults With Celiac Disease: Study Protocol." ;
                                                                             rdfs:label "sentence_31218116_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31218116_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31218116_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31218116> ;
                                                                             gutprop:hasSentenceText "Individuals with celiac disease must follow a strict gluten-free diet (GFD) in order to avoid negative short- and long-term health consequences." ;
                                                                             rdfs:label "sentence_31218116_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31218116_10
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31218116_10> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31218116> ;
                                                                              gutprop:hasSentenceText "The secondary outcomes are markers of metabolic syndrome (waist circumference, fasting glucose, serum lipids, blood pressure, and body composition), gastrointestinal symptoms, sleep quality, adherence to a GFD, exercise behavior, self-regulatory efficacy, and self-compassion." ;
                                                                              rdfs:label "sentence_31218116_10" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31218116_11
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31218116_11> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31218116> ;
                                                                              gutprop:hasSentenceText "It is hypothesized that participants in the HIIT+ will experience improvements in all outcomes when compared to those in the WLC." ;
                                                                              rdfs:label "sentence_31218116_11" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31218116_12
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31218116_12> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31218116> ;
                                                                              gutprop:hasSentenceText "These improvements are expected to be maintained at the 3-month follow-up." ;
                                                                              rdfs:label "sentence_31218116_12" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31218116_13
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31218116_13> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31218116> ;
                                                                              gutprop:hasSentenceText "The findings from this study will advance the knowledge regarding the effects of HIIT and lifestyle education on key outcomes for an at-risk chronic disease population." ;
                                                                              rdfs:label "sentence_31218116_13" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31218116_14
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31218116_14> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31218116> ;
                                                                              gutprop:hasSentenceText "Furthermore, the findings can be used to inform future programs to improve fitness and physical and mental health outcomes for people with celiac disease." ;
                                                                              rdfs:label "sentence_31218116_14" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31218116_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31218116_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31218116> ;
                                                                             gutprop:hasSentenceText "Unfortunately, many people with celiac disease report poor quality of life (QoL) despite following a strict GFD, and up to 30% still report negative symptoms (eg, gastrointestinal upset)." ;
                                                                             rdfs:label "sentence_31218116_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31218116_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31218116_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31218116> ;
                                                                             gutprop:hasSentenceText "The purpose of the MOVE-C (understanding the relationship between the <i>M</i>icrobi<i>O</i>me, <i>V</i>itality, and <i>E</i>xercise in <i>C</i>eliac disease) pilot study is to explore the effects of a 12-week supervised progressive high-intensity interval training (HIIT) and lifestyle intervention on physiological, behavioral, and psychosocial outcomes among inactive adults with celiac disease.<b>Methods/Design:</b> Sixty inactive adults diagnosed with celiac disease will be randomized to HIIT+ or waitlist control (WLC)." ;
                                                                             rdfs:label "sentence_31218116_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31218116_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31218116_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31218116> ;
                                                                             gutprop:hasSentenceText "Participants in the HIIT+ will engage in a 12-week HIIT + lifestyle education program." ;
                                                                             rdfs:label "sentence_31218116_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31218116_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31218116_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31218116> ;
                                                                             gutprop:hasSentenceText "HIIT sessions will be comprised of 2 workouts per week, working up to 14 × 30-second intervals at 90% maximal heart rate (HRmax) followed by 2 minutes recovery at 50% HRmax." ;
                                                                             rdfs:label "sentence_31218116_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31218116_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31218116_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31218116> ;
                                                                             gutprop:hasSentenceText "The 6 biweekly lifestyle sessions will involve education on the promotion of a whole foods GFD, sleep hygiene, psychosocial coping skills (eg, self-compassion), and self-regulatory skills to master changes in behaviors." ;
                                                                             rdfs:label "sentence_31218116_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31218116_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31218116_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31218116> ;
                                                                             gutprop:hasSentenceText "Assessments will occur at pre and post 12-week intervention and 3-month follow-up." ;
                                                                             rdfs:label "sentence_31218116_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31218116_8
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31218116_8> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31218116> ;
                                                                             gutprop:hasSentenceText "WLC participants will be offered a 12-week HIIT program + online lifestyle education sessions after completing the final assessment." ;
                                                                             rdfs:label "sentence_31218116_8" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31218116_9
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31218116_9> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31218116> ;
                                                                             gutprop:hasSentenceText "The primary outcomes are QoL and gut microbiota composition assessed with 16S rRNA sequencing." ;
                                                                             rdfs:label "sentence_31218116_9" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31248424_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31248424_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/31248424> ;
                                                                             gutprop:hasSentenceText "Altered gut microbiota and inflammatory cytokine responses in patients with Parkinson's disease." ;
                                                                             rdfs:label "sentence_31248424_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31248424_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31248424_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31248424> ;
                                                                             gutprop:hasSentenceText "Emerging evidence suggests that gut microbiome composition alterations affect neurodegeneration through neuroinflammation in the pathogenesis of Parkinson's disease (PD)." ;
                                                                             rdfs:label "sentence_31248424_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31248424_10
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31248424_10> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31248424> ;
                                                                              gutprop:hasSentenceText "Bacteroides abundance was correlated with motor symptom severity defined by UPDRS part III motor scores (rho = 0.637 [95% confidence interval 0.474 to 0.758], P < 0.01)." ;
                                                                              rdfs:label "sentence_31248424_10" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31248424_11
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31248424_11> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31248424> ;
                                                                              gutprop:hasSentenceText "Altered microbiota was correlated with plasma concentrations of IFNγ and TNFα." ;
                                                                              rdfs:label "sentence_31248424_11" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31248424_12
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31248424_12> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31248424> ;
                                                                              gutprop:hasSentenceText "There was a correlation between Bacteroides and plasma level of TNFα (rho = 0.638 [95% CI: 0.102-0.887], P = 0.02); and a correlation between Verrucomicrobia abundance and plasma concentrations of IFNγ (rho = 0.545 [95% CI - 0.043-0.852], P = 0.05)." ;
                                                                              rdfs:label "sentence_31248424_12" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31248424_13
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31248424_13> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31248424> ;
                                                                              gutprop:hasSentenceText "The elevated plasma cytokine responses were confirmed in an additional independent 120 patients with PD and 120 controls (TNFα: PD vs. control 8.51 ± 4.63 pg/ml vs. 4.82 ± 2.23 pg/ml, P < 0.01; and IFNγ: PD vs. control: 38.45 ± 7.12 pg/ml vs. 32.79 ± 8.03 pg/ml, P = 0.03)." ;
                                                                              rdfs:label "sentence_31248424_13" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31248424_14
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31248424_14> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31248424> ;
                                                                              gutprop:hasSentenceText "This study reveals altered gut microbiota in PD and its correlation with clinical phenotypes and severity in our population." ;
                                                                              rdfs:label "sentence_31248424_14" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31248424_15
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31248424_15> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31248424> ;
                                                                              gutprop:hasSentenceText "The altered plasma cytokine profiles associated with gut microbiome composition alterations suggest aberrant immune responses may contribute to inflammatory processes in PD." ;
                                                                              rdfs:label "sentence_31248424_15" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31248424_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31248424_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31248424> ;
                                                                             gutprop:hasSentenceText "Here, we evaluate gut microbiota alterations and host cytokine responses in a population of Taiwanese patients with PD." ;
                                                                             rdfs:label "sentence_31248424_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31248424_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31248424_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31248424> ;
                                                                             gutprop:hasSentenceText "Fecal microbiota communities from 80 patients with PD and 77 age and gender-matched controls were assessed by sequencing the V3-V4 region of the 16S ribosomal RNA gene." ;
                                                                             rdfs:label "sentence_31248424_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31248424_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31248424_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31248424> ;
                                                                             gutprop:hasSentenceText "Diet and comorbidities were controlled in the analyses." ;
                                                                             rdfs:label "sentence_31248424_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31248424_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31248424_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31248424> ;
                                                                             gutprop:hasSentenceText "Plasma concentrations of IL-1β, IL-2, IL-4, IL-6, IL-13, IL-18, GM-CSF, IFNγ, and TNFα were measured by a multiplex immunoassay and relationships between microbiota, clinical characteristics, and cytokine levels were analyzed in the PD group." ;
                                                                             rdfs:label "sentence_31248424_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31248424_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31248424_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31248424> ;
                                                                             gutprop:hasSentenceText "We further examined the cytokine changes associated with the altered gut microbiota seen in patients with PD in another independent cohort of 120 PD patients and 120 controls." ;
                                                                             rdfs:label "sentence_31248424_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31248424_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31248424_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31248424> ;
                                                                             gutprop:hasSentenceText "Microbiota from patients with PD was altered relative to controls and dominated by Verrucomicrobia, Mucispirillum, Porphyromonas, Lactobacillus, and Parabacteroides." ;
                                                                             rdfs:label "sentence_31248424_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31248424_8
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31248424_8> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31248424> ;
                                                                             gutprop:hasSentenceText "In contrast, Prevotella was more abundant in controls." ;
                                                                             rdfs:label "sentence_31248424_8" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31248424_9
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31248424_9> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31248424> ;
                                                                             gutprop:hasSentenceText "The abundances of Bacteroides were more increased in patients with non-tremor PD subtype than patients with tremor subtype." ;
                                                                             rdfs:label "sentence_31248424_9" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31255682_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31255682_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/31255682> ;
                                                                             gutprop:hasSentenceText "Altered gut microbiota and mucosal immunity in patients with schizophrenia." ;
                                                                             rdfs:label "sentence_31255682_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31255682_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31255682_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31255682> ;
                                                                             gutprop:hasSentenceText "Evidence shows that gut microbiota may play important roles in schizophrenia pathogenesis via the \"gut-brain\" axis, but the mechanisms remain unclear." ;
                                                                             rdfs:label "sentence_31255682_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31255682_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31255682_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31255682> ;
                                                                             gutprop:hasSentenceText "Here, eighty-four patients with schizophrenia and 84 sex- and age-matched healthy controls were enrolled." ;
                                                                             rdfs:label "sentence_31255682_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31255682_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31255682_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31255682> ;
                                                                             gutprop:hasSentenceText "Shotgun metagenomic sequencing and 16S rRNA sequencing were performed, and the gut microbiota-associated epitopes (MEs) were predicted, which, together with IgA content, were used to determine the gut microbiota composition associated with gut immune status." ;
                                                                             rdfs:label "sentence_31255682_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31255682_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31255682_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31255682> ;
                                                                             gutprop:hasSentenceText "Patients with schizophrenia had significantly reduced gut microbiota richnesses compared with those of the healthy controls, and the gut microbiota compositions clearly distinguished the patients with schizophrenia from the healthy controls." ;
                                                                             rdfs:label "sentence_31255682_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31255682_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31255682_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31255682> ;
                                                                             gutprop:hasSentenceText "Based on two-stage metagenomic-wide association studies, nineteen gut microbiota taxonomies were associated with schizophrenia, and the microbial dysbiosis (MD) index was calculated based on the abundance of differential taxonomies." ;
                                                                             rdfs:label "sentence_31255682_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31255682_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31255682_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31255682> ;
                                                                             gutprop:hasSentenceText "We found that MD index was positively correlated with MEs diversity and gut IgA levels, and negatively correlated with gut microbiota richness." ;
                                                                             rdfs:label "sentence_31255682_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31255682_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31255682_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31255682> ;
                                                                             gutprop:hasSentenceText "Glutamate synthase (GOGAT) was more active in the guts of patients with schizophrenia than in those of healthy controls, and high GOGAT activity was associated with altered gut microbiota taxonomies associated with gut IgA levels." ;
                                                                             rdfs:label "sentence_31255682_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31255682_8
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31255682_8> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31255682> ;
                                                                             gutprop:hasSentenceText "Our results may imply a role of the microbiome in the etiology of schizophrenia and contribute to the development of microbiome targeted interventions for schizophrenia." ;
                                                                             rdfs:label "sentence_31255682_8" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31260640_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31260640_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/31260640> ;
                                                                             gutprop:hasSentenceText "Microbiota-gut brain axis involvement in neuropsychiatric disorders." ;
                                                                             rdfs:label "sentence_31260640_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31260640_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31260640_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31260640> ;
                                                                             gutprop:hasSentenceText "<b>Introduction</b>: The microbiota-gut brain (MGB) axis is the bidirectional communication between the intestinal microbiota and the brain." ;
                                                                             rdfs:label "sentence_31260640_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31260640_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31260640_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31260640> ;
                                                                             gutprop:hasSentenceText "An increasing body of preclinical and clinical evidence has revealed that the gut microbial ecosystem can affect neuropsychiatric health." ;
                                                                             rdfs:label "sentence_31260640_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31260640_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31260640_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31260640> ;
                                                                             gutprop:hasSentenceText "However, there is still a need of further studies to elucidate the complex gene-environment interactions and the role of the MGB axis in neuropsychiatric diseases, with the aim of identifying biomarkers and new therapeutic targets, to allow early diagnosis and improving treatments." ;
                                                                             rdfs:label "sentence_31260640_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31260640_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31260640_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31260640> ;
                                                                             gutprop:hasSentenceText "<b>Areas covered</b>: To review the role of MGB axis in neuropsychiatric disorders, prediction and prevention of disease through exploitation, integration, and combination of data from existing gut microbiome/microbiota projects and appropriate other International '-Omics' studies." ;
                                                                             rdfs:label "sentence_31260640_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31260640_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31260640_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31260640> ;
                                                                             gutprop:hasSentenceText "The authors also evaluated the new technological advances to investigate and modulate, through nutritional and other interventions, the gut microbiota." ;
                                                                             rdfs:label "sentence_31260640_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31260640_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31260640_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31260640> ;
                                                                             gutprop:hasSentenceText "<b>Expert opinion</b>: The clinical studies have documented an association between alterations in gut microbiota composition and/or function, whereas the preclinical studies support a role for the gut microbiota in impacting behaviors which are of relevance to psychiatry and other central nervous system (CNS) disorders." ;
                                                                             rdfs:label "sentence_31260640_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31260640_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31260640_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31260640> ;
                                                                             gutprop:hasSentenceText "Targeting MGB axis could be an additional approach for treating CNS disorders and all conditions in which alterations of the gut microbiota are involved." ;
                                                                             rdfs:label "sentence_31260640_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31302116_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31302116_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/31302116> ;
                                                                             gutprop:hasSentenceText "Stress-induced disturbances along the gut microbiota-immune-brain axis and implications for mental health: Does sex matter?" ;
                                                                             rdfs:label "sentence_31302116_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31302116_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31302116_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31302116> ;
                                                                             gutprop:hasSentenceText "Women are roughly twice as likely as men to suffer from stress-related disorders, especially major depression and generalized anxiety." ;
                                                                             rdfs:label "sentence_31302116_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31302116_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31302116_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31302116> ;
                                                                             gutprop:hasSentenceText "Accumulating evidence suggest that microbes inhabiting the gastrointestinal tract (the gut microbiota) interact with the host brain and may play a key role in the pathogenesis of mental illnesses." ;
                                                                             rdfs:label "sentence_31302116_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31302116_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31302116_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31302116> ;
                                                                             gutprop:hasSentenceText "Here, the possibility that sexually dimorphic alterations along the gut microbiota-immune-brain axis could play a role in promoting this female bias of mood and anxiety disorders will be discussed." ;
                                                                             rdfs:label "sentence_31302116_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31302116_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31302116_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31302116> ;
                                                                             gutprop:hasSentenceText "This review will also analyze the idea that gut microbes and sex hormones influence each other, and that this reciprocal crosstalk may come to modulate inflammatory players along the gut microbiota-immune-brain axis and influence behavior in a sex-dependent way." ;
                                                                             rdfs:label "sentence_31302116_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31330299_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31330299_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/31330299> ;
                                                                             gutprop:hasSentenceText "Monocyte mobilisation, microbiota & mental illness." ;
                                                                             rdfs:label "sentence_31330299_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31330299_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31330299_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31330299> ;
                                                                             gutprop:hasSentenceText "The gastrointestinal microbiome has emerged as a key player in regulating brain and behaviour." ;
                                                                             rdfs:label "sentence_31330299_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31330299_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31330299_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31330299> ;
                                                                             gutprop:hasSentenceText "This has led to the strategy of targeting the gut microbiota to ameliorate disorders of the central nervous system." ;
                                                                             rdfs:label "sentence_31330299_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31330299_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31330299_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31330299> ;
                                                                             gutprop:hasSentenceText "Understanding the underlying signalling pathways in which the microbiota impacts these disorders is crucial for the development of future therapeutics for improving CNS functionality." ;
                                                                             rdfs:label "sentence_31330299_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31330299_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31330299_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31330299> ;
                                                                             gutprop:hasSentenceText "One of the major pathways through which the microbiota influences the brain is the immune system, where there is an increasing appreciation for the role of monocyte trafficking in regulating brain homeostasis." ;
                                                                             rdfs:label "sentence_31330299_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31330299_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31330299_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31330299> ;
                                                                             gutprop:hasSentenceText "In this review, we will shed light on the role of monocyte trafficking as a relay of microbiota signals in conditions where the central nervous system is in disorder, such as stress, peripheral inflammation, ageing, traumatic brain injury, stroke, multiple sclerosis, Alzheimer's disease and Parkinson's disease." ;
                                                                             rdfs:label "sentence_31330299_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31330299_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31330299_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31330299> ;
                                                                             gutprop:hasSentenceText "We also cover how the gastrointestinal microbiota is implicated in these mental illnesses." ;
                                                                             rdfs:label "sentence_31330299_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31330299_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31330299_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31330299> ;
                                                                             gutprop:hasSentenceText "In addition, we aim to discuss how the monocyte system can be modulated by the gut microbiota to mitigate disorders of the central nervous system, which will lead to novel microbiota-targeted strategies." ;
                                                                             rdfs:label "sentence_31330299_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31377712_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31377712_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/31377712> ;
                                                                             gutprop:hasSentenceText "Biopsychosocial model of resilience in young adults with multiple sclerosis (BPS-ARMS): an observational study protocol exploring psychological reactions early after diagnosis." ;
                                                                             rdfs:label "sentence_31377712_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31377712_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31377712_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31377712> ;
                                                                             gutprop:hasSentenceText "Multiple sclerosis (MS), the most common neurological disease causing disability in young adults, is widely recognised as a major stress factor." ;
                                                                             rdfs:label "sentence_31377712_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31377712_10
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31377712_10> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31377712> ;
                                                                              gutprop:hasSentenceText "The findings will be disseminated through scientific publications in peer-reviewed journals, conference presentations, social media and specific websites." ;
                                                                              rdfs:label "sentence_31377712_10" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31377712_11
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31377712_11> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31377712> ;
                                                                              gutprop:hasSentenceText "ClinicalTrials.gov (NCT03825055)." ;
                                                                              rdfs:label "sentence_31377712_11" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31377712_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31377712_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31377712> ;
                                                                             gutprop:hasSentenceText "Studies have shown that the first years after the diagnosis are distressing in terms of adjustment to the disease and that MS negatively affects patients' psychological well-being, quality of life (QoL) and social functioning." ;
                                                                             rdfs:label "sentence_31377712_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31377712_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31377712_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31377712> ;
                                                                             gutprop:hasSentenceText "However, the links between disease-specific variables at diagnosis, resilience and psychological adjustment of patients with MS remain largely unexplored, especially in adolescents and young adults." ;
                                                                             rdfs:label "sentence_31377712_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31377712_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31377712_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31377712> ;
                                                                             gutprop:hasSentenceText "This observational study aims to fill the gap of knowledge on <u>b</u>io<u>p</u>sycho<u>s</u>ocial characteristics and <u>r</u>esilience of young <u>a</u>dults with MS to evaluate the relationship among these variables and to develop a biopsychosocial model of resilience." ;
                                                                             rdfs:label "sentence_31377712_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31377712_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31377712_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31377712> ;
                                                                             gutprop:hasSentenceText "Biological and clinical characteristics of young adults newly diagnosed with MS will be investigated by collecting clinical information, performing neurological examinations, MRI and analysing cerebrospinal fluid and blood biomarkers (eg, measures of inflammation), body composition, gut microbiota and movement/perceptual markers." ;
                                                                             rdfs:label "sentence_31377712_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31377712_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31377712_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31377712> ;
                                                                             gutprop:hasSentenceText "Psychosocial characteristics (eg, psychological distress, coping strategies), QoL, psychological well-being and resilience will be assessed by self-report questionnaires." ;
                                                                             rdfs:label "sentence_31377712_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31377712_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31377712_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31377712> ;
                                                                             gutprop:hasSentenceText "Comparative statistics (ie, analysis of variance or unpaired samples t-test, correlation and regression analyses) will be applied to evaluate the relationship among biological, psychological and social factors." ;
                                                                             rdfs:label "sentence_31377712_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31377712_8
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31377712_8> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31377712> ;
                                                                             gutprop:hasSentenceText "The results are expected to allow a comprehensive understanding of the determinants of resilience in young patients with MS and to inform resilience interventions, tailored to young patients' specific needs, aiming to reduce the risk of maladaptive reactions to the disease and to improve psychological well-being and QoL." ;
                                                                             rdfs:label "sentence_31377712_8" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31377712_9
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31377712_9> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31377712> ;
                                                                             gutprop:hasSentenceText "The study has been approved by the Verona University Hospital Ethics Committee (approval number: 2029CESC)." ;
                                                                             rdfs:label "sentence_31377712_9" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31383280_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31383280_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/31383280> ;
                                                                             gutprop:hasSentenceText "Improving Mental Health for the Mother-Infant Dyad by Nutrition and the Maternal Gut Microbiome." ;
                                                                             rdfs:label "sentence_31383280_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31383280_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31383280_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31383280> ;
                                                                             gutprop:hasSentenceText "Perinatal mood and anxiety disorders (PMAD) have significant negative impacts on mother and child, yet treatments are limited." ;
                                                                             rdfs:label "sentence_31383280_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31383280_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31383280_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31383280> ;
                                                                             gutprop:hasSentenceText "Adequate nutrition during the perinatal period is essential to maternal and infant health, including maternal mental health and the child's neurologic and neuropsychiatric development." ;
                                                                             rdfs:label "sentence_31383280_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31383280_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31383280_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31383280> ;
                                                                             gutprop:hasSentenceText "Nutrition holds promise to improve prevention and treatment of PMAD." ;
                                                                             rdfs:label "sentence_31383280_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31383280_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31383280_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31383280> ;
                                                                             gutprop:hasSentenceText "The ability to manipulate the gut microbiota composition and structure through host nutrition and to harness the gut microbes for improved individualized nutrition may be an important new direction for prevention and treatment of PMAD, thus improving the mental health of mother and child." ;
                                                                             rdfs:label "sentence_31383280_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31488882_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31488882_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/31488882> ;
                                                                             gutprop:hasSentenceText "Sodium oligomannate therapeutically remodels gut microbiota and suppresses gut bacterial amino acids-shaped neuroinflammation to inhibit Alzheimer's disease progression." ;
                                                                             rdfs:label "sentence_31488882_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31488882_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31488882_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31488882> ;
                                                                             gutprop:hasSentenceText "Recently, increasing evidence has suggested the association between gut dysbiosis and Alzheimer's disease (AD) progression, yet the role of gut microbiota in AD pathogenesis remains obscure." ;
                                                                             rdfs:label "sentence_31488882_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31488882_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31488882_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31488882> ;
                                                                             gutprop:hasSentenceText "Herein, we provide a potential mechanistic link between gut microbiota dysbiosis and neuroinflammation in AD progression." ;
                                                                             rdfs:label "sentence_31488882_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31488882_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31488882_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31488882> ;
                                                                             gutprop:hasSentenceText "Using AD mouse models, we discovered that, during AD progression, the alteration of gut microbiota composition leads to the peripheral accumulation of phenylalanine and isoleucine, which stimulates the differentiation and proliferation of pro-inflammatory T helper 1 (Th1) cells." ;
                                                                             rdfs:label "sentence_31488882_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31488882_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31488882_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31488882> ;
                                                                             gutprop:hasSentenceText "The brain-infiltrated peripheral Th1 immune cells are associated with the M1 microglia activation, contributing to AD-associated neuroinflammation." ;
                                                                             rdfs:label "sentence_31488882_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31488882_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31488882_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31488882> ;
                                                                             gutprop:hasSentenceText "Importantly, the elevation of phenylalanine and isoleucine concentrations and the increase of Th1 cell frequency in the blood were also observed in two small independent cohorts of patients with mild cognitive impairment (MCI) due to AD." ;
                                                                             rdfs:label "sentence_31488882_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31488882_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31488882_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31488882> ;
                                                                             gutprop:hasSentenceText "Furthermore, GV-971, a sodium oligomannate that has demonstrated solid and consistent cognition improvement in a phase 3 clinical trial in China, suppresses gut dysbiosis and the associated phenylalanine/isoleucine accumulation, harnesses neuroinflammation and reverses the cognition impairment." ;
                                                                             rdfs:label "sentence_31488882_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31488882_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31488882_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31488882> ;
                                                                             gutprop:hasSentenceText "Together, our findings highlight the role of gut dysbiosis-promoted neuroinflammation in AD progression and suggest a novel strategy for AD therapy by remodelling the gut microbiota." ;
                                                                             rdfs:label "sentence_31488882_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31493127_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31493127_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/31493127> ;
                                                                             gutprop:hasSentenceText "Probiotics and Psychobiotics: the Role of Microbial Neurochemicals." ;
                                                                             rdfs:label "sentence_31493127_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31493127_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31493127_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31493127> ;
                                                                             gutprop:hasSentenceText "In light of recent data, microorganisms should be construed as organisms that are capable of communication and collective behaviors." ;
                                                                             rdfs:label "sentence_31493127_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31493127_10
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31493127_10> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31493127> ;
                                                                              gutprop:hasSentenceText "Some of the publications focus on the involvement of neurochemicals in the bidirectional communication within the host-microbiota system." ;
                                                                              rdfs:label "sentence_31493127_10" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31493127_11
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31493127_11> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31493127> ;
                                                                              gutprop:hasSentenceText "However, this work concentrates on the impact of bacterial cell components, metabolites, and signal molecules as promising alternatives to the currently widespread probiotics that have both advantages and disadvantages." ;
                                                                              rdfs:label "sentence_31493127_11" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31493127_12
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31493127_12> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31493127> ;
                                                                              gutprop:hasSentenceText "Such biologically active agents of microbial origin are referred to as postbiotics or, alternatively, metabiotics (the term preferred in this work)." ;
                                                                              rdfs:label "sentence_31493127_12" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31493127_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31493127_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31493127> ;
                                                                             gutprop:hasSentenceText "Microbial communication signals are involved both in interactions among microbial cells within microbial social systems, including the human body-inhabiting microconsortium, and the dialog between the microbiota and the host organism." ;
                                                                             rdfs:label "sentence_31493127_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31493127_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31493127_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31493127> ;
                                                                             gutprop:hasSentenceText "The microbiota inhabits various niches of the host organism, especially the gastrointestinal (GI) tract." ;
                                                                             rdfs:label "sentence_31493127_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31493127_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31493127_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31493127> ;
                                                                             gutprop:hasSentenceText "Microorganisms release diverse signal molecules and, in addition, specifically respond to host signals." ;
                                                                             rdfs:label "sentence_31493127_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31493127_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31493127_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31493127> ;
                                                                             gutprop:hasSentenceText "This enables them to constantly interact with the nervous system including the brain and the immune system of the host organism." ;
                                                                             rdfs:label "sentence_31493127_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31493127_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31493127_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31493127> ;
                                                                             gutprop:hasSentenceText "Evolutionarily conserved signals that are involved in the communication between microbiota and the host include neuroactive substances (neurochemicals) such as peptides, amino acids, biogenic amines, short-chain fatty acids, and gaseous substances." ;
                                                                             rdfs:label "sentence_31493127_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31493127_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31493127_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31493127> ;
                                                                             gutprop:hasSentenceText "This ongoing dialog may either stabilize the host's physical and mental health state or, alternatively, cause serious health problems." ;
                                                                             rdfs:label "sentence_31493127_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31493127_8
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31493127_8> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31493127> ;
                                                                             gutprop:hasSentenceText "Attempts are made to correct imbalances in the brain-gut-microbiota axis with probiotics including their subgroup called psychobiotics that release neuroactive substances directly influencing the human brain, psyche, and behavior." ;
                                                                             rdfs:label "sentence_31493127_8" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31493127_9
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31493127_9> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31493127> ;
                                                                             gutprop:hasSentenceText "A number of recent review works address the microbiota-host system and its communication signals." ;
                                                                             rdfs:label "sentence_31493127_9" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31498131_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31498131_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/31498131> ;
                                                                             gutprop:hasSentenceText "Increasing Comparability and Utility of Gut Microbiome Studies in Parkinson's Disease: A Systematic Review." ;
                                                                             rdfs:label "sentence_31498131_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31498131_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31498131_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31498131> ;
                                                                             gutprop:hasSentenceText "Gut microbiota have been studied in relation to the pathophysiology of Parkinson's disease (PD) due to the early gastrointestinal symptomatology and presence of alpha-synuclein pathology in the enteric nervous system, hypothesized to ascend via the vagal nerve to the central nervous system." ;
                                                                             rdfs:label "sentence_31498131_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31498131_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31498131_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31498131> ;
                                                                             gutprop:hasSentenceText "Accordingly, sixteen human case-control studies have published gut microbiome composition changes in PD and reported over 100 differentially abundant taxa covering all taxonomic levels from phylum to genus or species, depending on methodology." ;
                                                                             rdfs:label "sentence_31498131_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31498131_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31498131_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31498131> ;
                                                                             gutprop:hasSentenceText "While certain findings were replicated across several studies, various contradictory findings were reported." ;
                                                                             rdfs:label "sentence_31498131_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31498131_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31498131_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31498131> ;
                                                                             gutprop:hasSentenceText "Here, differences in methodologies and the presence of possible confounders in the study populations are assessed for their potential to confound the results of gut microbiome studies in PD." ;
                                                                             rdfs:label "sentence_31498131_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31498131_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31498131_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31498131> ;
                                                                             gutprop:hasSentenceText "Gut microbiome studies in PD exhibited considerable variability with respect to the study population, sample transport conditions, laboratory protocols and sequencing, bioinformatics pipelines, and biostatistical methods." ;
                                                                             rdfs:label "sentence_31498131_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31498131_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31498131_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31498131> ;
                                                                             gutprop:hasSentenceText "To move from the current heterogeneous dataset towards clinically relevant biomarkers and the identification of putative therapeutic targets, recommendations are derived from the limitations of the available studies to increase the future comparability of microbiome studies in PD." ;
                                                                             rdfs:label "sentence_31498131_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31498131_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31498131_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31498131> ;
                                                                             gutprop:hasSentenceText "In addition, integration of currently available data on the gut microbiome in PD is proposed to identify robust gut microbiome profiles in PD." ;
                                                                             rdfs:label "sentence_31498131_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31498131_8
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31498131_8> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31498131> ;
                                                                             gutprop:hasSentenceText "Furthermore, expansion of the current dataset with atypical parkinsonism cohorts, prodromal and treatment-naïve de novo PD subjects, measurements of fecal microbial concentrations and multi-omics assessments are required to provide clinically relevant biomarkers and reveal therapeutic targets within the gut microbiome of PD." ;
                                                                             rdfs:label "sentence_31498131_8" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31530799_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31530799_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/31530799> ;
                                                                             gutprop:hasSentenceText "Abnormal composition of gut microbiota is associated with resilience versus susceptibility to inescapable electric stress." ;
                                                                             rdfs:label "sentence_31530799_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31530799_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31530799_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31530799> ;
                                                                             gutprop:hasSentenceText "Increasing evidence indicates that abnormalities in the composition of gut microbiota might play a role in stress-related disorders." ;
                                                                             rdfs:label "sentence_31530799_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31530799_10
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31530799_10> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31530799> ;
                                                                              gutprop:hasSentenceText "There was a positive correlation between lactic acid and Lactobacillus levels among these three groups." ;
                                                                              rdfs:label "sentence_31530799_10" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31530799_11
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31530799_11> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31530799> ;
                                                                              gutprop:hasSentenceText "These findings suggest that abnormal composition of the gut microbiota, including organisms such as Lactobacillus, contributes to susceptibility versus resilience to LH in rats subjected to inescapable electric foot shock." ;
                                                                              rdfs:label "sentence_31530799_11" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31530799_12
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31530799_12> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31530799> ;
                                                                              gutprop:hasSentenceText "Therefore, it appears likely that brain-gut axis plays a role in stress susceptibility in the LH paradigm." ;
                                                                              rdfs:label "sentence_31530799_12" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31530799_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31530799_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31530799> ;
                                                                             gutprop:hasSentenceText "In the learned helplessness (LH) paradigm, ~60-70% rats are susceptible to LH in the face of inescapable electric stress." ;
                                                                             rdfs:label "sentence_31530799_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31530799_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31530799_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31530799> ;
                                                                             gutprop:hasSentenceText "The role of gut microbiota in susceptibility in the LH paradigm is unknown." ;
                                                                             rdfs:label "sentence_31530799_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31530799_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31530799_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31530799> ;
                                                                             gutprop:hasSentenceText "In this study, male rats were exposed to inescapable electric stress under the LH paradigm." ;
                                                                             rdfs:label "sentence_31530799_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31530799_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31530799_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31530799> ;
                                                                             gutprop:hasSentenceText "The compositions of gut microbiota and short-chain fatty acids were assessed in fecal samples from control rats, non-LH (resilient) rats, and LH (susceptible) rats." ;
                                                                             rdfs:label "sentence_31530799_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31530799_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31530799_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31530799> ;
                                                                             gutprop:hasSentenceText "Members of the order Lactobacillales were present at significantly higher levels in the susceptible rats than in control and resilient rats." ;
                                                                             rdfs:label "sentence_31530799_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31530799_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31530799_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31530799> ;
                                                                             gutprop:hasSentenceText "At the family level, the number of Lactobacillaceae in the susceptible rats was significantly higher than in control and resilient rats." ;
                                                                             rdfs:label "sentence_31530799_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31530799_8
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31530799_8> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31530799> ;
                                                                             gutprop:hasSentenceText "At the genus level, the numbers of Lactobacillus, Clostridium cluster III, and Anaerofustis in susceptible rats were significantly higher than in control and resilient rats." ;
                                                                             rdfs:label "sentence_31530799_8" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31530799_9
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31530799_9> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31530799> ;
                                                                             gutprop:hasSentenceText "Levels of acetic acid and propionic acid in the feces of susceptible rats were lower than in those of control and resilient rats; however, the levels of lactic acid in the susceptible rats were higher than those of control and resilient rats." ;
                                                                             rdfs:label "sentence_31530799_9" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31539679_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31539679_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/31539679> ;
                                                                             gutprop:hasSentenceText "Antibiotic-induced microbiome depletion is associated with resilience in mice after chronic social defeat stress." ;
                                                                             rdfs:label "sentence_31539679_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31539679_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31539679_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31539679> ;
                                                                             gutprop:hasSentenceText "The brain-gut axis plays a role in the pathogenesis of stress-related disorders such as depression." ;
                                                                             rdfs:label "sentence_31539679_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31539679_10
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31539679_10> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31539679> ;
                                                                              gutprop:hasSentenceText "CSDS treatment did not alter the plasma levels of interleukin-6 or the expression of synaptic proteins, such as PSD-95 and GluA1, in the prefrontal cortex of antibiotic-treated mice." ;
                                                                              rdfs:label "sentence_31539679_10" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31539679_11
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31539679_11> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31539679> ;
                                                                              gutprop:hasSentenceText "Specific microbiome were not determined." ;
                                                                              rdfs:label "sentence_31539679_11" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31539679_12
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31539679_12> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31539679> ;
                                                                              gutprop:hasSentenceText "These findings suggest that antibiotic-induced microbiome depletion contributed to resilience to anhedonia in mice subjected to CSDS." ;
                                                                              rdfs:label "sentence_31539679_12" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31539679_13
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31539679_13> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31539679> ;
                                                                              gutprop:hasSentenceText "Therefore, it is likely that the brain-gut axis plays a role in resilience versus susceptibility to stress." ;
                                                                              rdfs:label "sentence_31539679_13" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31539679_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31539679_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31539679> ;
                                                                             gutprop:hasSentenceText "However, the role of brain-gut axis in the resilience versus susceptibility after stress remains unclear." ;
                                                                             rdfs:label "sentence_31539679_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31539679_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31539679_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31539679> ;
                                                                             gutprop:hasSentenceText "Here, we examined the effects of antibiotic-induced microbiome depletion on an anhedonia-like phenotype in adult mice subjected to chronic social defeat stress (CSDS)." ;
                                                                             rdfs:label "sentence_31539679_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31539679_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31539679_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31539679> ;
                                                                             gutprop:hasSentenceText "Using CSDS paradigm, we investigated the effects of antibiotic-induced microbiome depletion on the resilience versus susceptibility in mice." ;
                                                                             rdfs:label "sentence_31539679_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31539679_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31539679_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31539679> ;
                                                                             gutprop:hasSentenceText "Treatment with an antibiotic cocktail for 14 days significantly decreased the diversity and composition of the microbiota in the host gut." ;
                                                                             rdfs:label "sentence_31539679_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31539679_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31539679_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31539679> ;
                                                                             gutprop:hasSentenceText "Proteobacteria were markedly increased after treatment with the antibiotic cocktail." ;
                                                                             rdfs:label "sentence_31539679_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31539679_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31539679_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31539679> ;
                                                                             gutprop:hasSentenceText "At the genus and species levels, the antibiotic-treated group exhibited marked alterations in the microbiota compared with a control group." ;
                                                                             rdfs:label "sentence_31539679_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31539679_8
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31539679_8> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31539679> ;
                                                                             gutprop:hasSentenceText "CSDS was shown to significantly improve the abnormal composition of gut microbiota in the antibiotic-treated group." ;
                                                                             rdfs:label "sentence_31539679_8" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31539679_9
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31539679_9> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31539679> ;
                                                                             gutprop:hasSentenceText "CSDS did not produce an anhedonia-like phenotype in the antibiotic-treated mice, but did induce an anhedonia-like phenotype in control mice, suggesting that gut bacteria are essential for the development of CSDS-induced anhedonia." ;
                                                                             rdfs:label "sentence_31539679_9" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31568686_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31568686_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/31568686> ;
                                                                             gutprop:hasSentenceText "The role of the brain-gut-microbiota axis in psychology: The importance of considering gut microbiota in the development, perpetuation, and treatment of psychological disorders." ;
                                                                             rdfs:label "sentence_31568686_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31568686_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31568686_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31568686> ;
                                                                             gutprop:hasSentenceText "The prevalence of psychological disorders remains stable despite steady increases in pharmacological treatments suggesting the need for auxiliary treatment options." ;
                                                                             rdfs:label "sentence_31568686_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31568686_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31568686_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31568686> ;
                                                                             gutprop:hasSentenceText "Consideration of the brain-gut-microbiota axis (BGMA) has made inroads into reconceptualizing psychological illness from a more holistic perspective." ;
                                                                             rdfs:label "sentence_31568686_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31568686_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31568686_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31568686> ;
                                                                             gutprop:hasSentenceText "While our understanding of the precise role of gut microbiota (GM) in psychological illness is in its infancy, it represents an attractive target for novel interventions." ;
                                                                             rdfs:label "sentence_31568686_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31568686_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31568686_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31568686> ;
                                                                             gutprop:hasSentenceText "An extensive review of relevant literature was undertaken." ;
                                                                             rdfs:label "sentence_31568686_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31568686_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31568686_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31568686> ;
                                                                             gutprop:hasSentenceText "Gut microbiota are proposed to directly and indirectly influence mood, cognition, and behavior which are key components of mental health." ;
                                                                             rdfs:label "sentence_31568686_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31568686_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31568686_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31568686> ;
                                                                             gutprop:hasSentenceText "This paper outlines how GM may be implicated in psychological disorders from etiology through to treatment and prevention using the Four P model of case formulation." ;
                                                                             rdfs:label "sentence_31568686_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31568686_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31568686_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31568686> ;
                                                                             gutprop:hasSentenceText "Moving forward, integration of GM into the conceptualization and treatment of psychological illness will require the discipline of psychology to undergo a significant paradigm shift." ;
                                                                             rdfs:label "sentence_31568686_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31568686_8
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31568686_8> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31568686> ;
                                                                             gutprop:hasSentenceText "While the importance of the GM in psychological well-being must be respected, it is not proposed to be a panacea, but instead, an additional arm to a multidisciplinary approach to treatment and prevention." ;
                                                                             rdfs:label "sentence_31568686_8" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31596658_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31596658_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/31596658> ;
                                                                             gutprop:hasSentenceText "\"Photobiomics\": Can Light, Including Photobiomodulation, Alter the Microbiome?" ;
                                                                             rdfs:label "sentence_31596658_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31596658_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31596658_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31596658> ;
                                                                             gutprop:hasSentenceText "<b><i>Objective</i>:</b> The objective of this review is to consider the dual effects of microbiome and photobiomodulation (PBM) on human health and to suggest a relationship between these two as a novel mechanism." ;
                                                                             rdfs:label "sentence_31596658_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31596658_10
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31596658_10> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31596658> ;
                                                                              gutprop:hasSentenceText "Some mechanisms by which this phenomenon might occur are considered." ;
                                                                              rdfs:label "sentence_31596658_10" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31596658_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31596658_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31596658> ;
                                                                             gutprop:hasSentenceText "<b><i>Background</i>:</b> PBM describes the use of low levels of visible or near-infrared (NIR) light to heal and stimulate tissue, and to relieve pain and inflammation." ;
                                                                             rdfs:label "sentence_31596658_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31596658_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31596658_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31596658> ;
                                                                             gutprop:hasSentenceText "In recent years, PBM has been applied to the head as an investigative approach to treat diverse brain diseases such as stroke, traumatic brain injury (TBI), Alzheimer's and Parkinson's diseases, and psychiatric disorders." ;
                                                                             rdfs:label "sentence_31596658_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31596658_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31596658_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31596658> ;
                                                                             gutprop:hasSentenceText "Also, in recent years, increasing attention has been paid to the total microbial population that colonizes the human body, chiefly in the gut and the mouth, called the microbiome." ;
                                                                             rdfs:label "sentence_31596658_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31596658_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31596658_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31596658> ;
                                                                             gutprop:hasSentenceText "It is known that the composition and health of the gut microbiome affects many diseases related to metabolism, obesity, cardiovascular disorders, autoimmunity, and even brain disorders." ;
                                                                             rdfs:label "sentence_31596658_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31596658_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31596658_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31596658> ;
                                                                             gutprop:hasSentenceText "<b><i>Materials and methods</i>:</b> A literature search was conducted for published reports on the effect of light on the microbiome." ;
                                                                             rdfs:label "sentence_31596658_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31596658_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31596658_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31596658> ;
                                                                             gutprop:hasSentenceText "<b><i>Results</i>:</b> Recent work by our research group has demonstrated that PBM (red and NIR light) delivered to the abdomen in mice, can alter the gut microbiome in a potentially beneficial way." ;
                                                                             rdfs:label "sentence_31596658_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31596658_8
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31596658_8> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31596658> ;
                                                                             gutprop:hasSentenceText "This has also now been demonstrated in human subjects." ;
                                                                             rdfs:label "sentence_31596658_8" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31596658_9
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31596658_9> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31596658> ;
                                                                             gutprop:hasSentenceText "<b><i>Conclusions</i>:</b> In consideration of the known effects of PBM on metabolomics, and the now demonstrated effects of PBM on the microbiome, as well as other effects of light on the microbiome, including modulating circadian rhythms, the present perspective introduces a new term \"photobiomics\" and looks forward to the application of PBM to influence the microbiome in humans." ;
                                                                             rdfs:label "sentence_31596658_9" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31610228_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31610228_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/31610228> ;
                                                                             gutprop:hasSentenceText "Plasma cytokine levels in patients with chronic alcohol overconsumption: Relations to gut microbiota markers and clinical correlates." ;
                                                                             rdfs:label "sentence_31610228_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31610228_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31610228_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31610228> ;
                                                                             gutprop:hasSentenceText "Alcohol-related morbidity may involve changes in the gut microbiota and immune dysregulation." ;
                                                                             rdfs:label "sentence_31610228_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31610228_10
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31610228_10> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31610228> ;
                                                                              gutprop:hasSentenceText "Patients with alcohol overconsumption reported more psychiatric symptoms, and these symptoms were inversely correlated with IL-10 levels." ;
                                                                              rdfs:label "sentence_31610228_10" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31610228_11
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31610228_11> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31610228> ;
                                                                              gutprop:hasSentenceText "There were positive correlations between several of the assessed cytokines and biochemical liver variables, and negative correlations between cytokine levels and albumin." ;
                                                                              rdfs:label "sentence_31610228_11" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31610228_12
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31610228_12> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31610228> ;
                                                                              gutprop:hasSentenceText "Patients with alcohol overconsumption had a cytokine profile suggestive of increased systemic inflammatory activity, with higher levels of pro-inflammatory cytokines (IL-6, IFN-γ, and MCP-1) and lower levels of anti-inflammatory cytokines (TGF-β1)." ;
                                                                              rdfs:label "sentence_31610228_12" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31610228_13
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31610228_13> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31610228> ;
                                                                              gutprop:hasSentenceText "The findings may represent a link between alcohol use and alcohol-related morbidity." ;
                                                                              rdfs:label "sentence_31610228_13" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31610228_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31610228_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31610228> ;
                                                                             gutprop:hasSentenceText "We have previously demonstrated alterations in gut microbiota composition and functions in patients with alcohol overconsumption, and now aimed to investigate possible associations between cytokine levels, gut microbiota, and clinical symptoms." ;
                                                                             rdfs:label "sentence_31610228_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31610228_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31610228_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31610228> ;
                                                                             gutprop:hasSentenceText "We included hospital inpatients with a history of chronic alcohol overconsumption." ;
                                                                             rdfs:label "sentence_31610228_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31610228_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31610228_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31610228> ;
                                                                             gutprop:hasSentenceText "For comparison, we included control patients with a low alcohol intake." ;
                                                                             rdfs:label "sentence_31610228_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31610228_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31610228_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31610228> ;
                                                                             gutprop:hasSentenceText "Cytokine levels (TGF-β1, TNF-α, IL-10, IL-8, IL-6, IFN-γ, MCP-1, IL-1RA, IL-1β, and IL-17) were determined using a customized V-plex assay." ;
                                                                             rdfs:label "sentence_31610228_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31610228_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31610228_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31610228> ;
                                                                             gutprop:hasSentenceText "We then examined associations of cytokine levels with the abundance of Proteobacteria and Faecalibacterium, percentage of the short-chain fatty acid butyrate, psychiatric symptoms (Hospital Anxiety and Depression Scale), and biochemical liver variables." ;
                                                                             rdfs:label "sentence_31610228_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31610228_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31610228_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31610228> ;
                                                                             gutprop:hasSentenceText "We included 28 patients with alcohol overconsumption (79% men), and 25 control patients (72% men)." ;
                                                                             rdfs:label "sentence_31610228_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31610228_8
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31610228_8> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31610228> ;
                                                                             gutprop:hasSentenceText "Patients with alcohol overconsumption had higher levels of IL-6 (p = 0.002), IFN-γ (p = 0.018), and MCP-1 (p = 0.006), and lower levels of TGF-β1 (p = 0.017) compared with control patients." ;
                                                                             rdfs:label "sentence_31610228_8" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31610228_9
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31610228_9> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31610228> ;
                                                                             gutprop:hasSentenceText "Inverse correlations were found between Proteobacteria abundance and TNF-α (R<sub>s</sub> = -0.55, p = 0.02) and IL-8 (R<sub>s</sub> = -0.58, p = 0.014), and between Faecalibacterium and MCP-1 levels (R<sub>s</sub> = -0.56, p = 0.02) in the control patients, but not in patients with alcohol overconsumption." ;
                                                                             rdfs:label "sentence_31610228_9" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31646148_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31646148_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/31646148> ;
                                                                             gutprop:hasSentenceText "Gut microbial metabolites in depression: understanding the biochemical mechanisms." ;
                                                                             rdfs:label "sentence_31646148_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31646148_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31646148_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31646148> ;
                                                                             gutprop:hasSentenceText "Gastrointestinal and central function are intrinsically connected by the gut microbiota, an ecosystem that has co-evolved with the host to expand its biotransformational capabilities and interact with host physiological processes by means of its metabolic products." ;
                                                                             rdfs:label "sentence_31646148_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31646148_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31646148_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31646148> ;
                                                                             gutprop:hasSentenceText "Abnormalities in this microbiota-gut-brain axis have emerged as a key component in the pathophysiology of depression, leading to more research attempting to understand the neuroactive potential of the products of gut microbial metabolism." ;
                                                                             rdfs:label "sentence_31646148_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31646148_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31646148_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31646148> ;
                                                                             gutprop:hasSentenceText "This review explores the potential for the gut microbiota to contribute to depression and focuses on the role that microbially-derived molecules - neurotransmitters, short-chain fatty acids, indoles, bile acids, choline metabolites, lactate and vitamins - play in the context of emotional behavior." ;
                                                                             rdfs:label "sentence_31646148_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31646148_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31646148_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31646148> ;
                                                                             gutprop:hasSentenceText "The future of gut-brain axis research lies is moving away from association, towards the mechanisms underlying the relationship between the gut bacteria and depressive behavior." ;
                                                                             rdfs:label "sentence_31646148_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31646148_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31646148_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31646148> ;
                                                                             gutprop:hasSentenceText "We propose that direct and indirect mechanisms exist through which gut microbial metabolites affect depressive behavior: these include (i) direct stimulation of central receptors, (ii) peripheral stimulation of neural, endocrine, and immune mediators, and (iii) epigenetic regulation of histone acetylation and DNA methylation." ;
                                                                             rdfs:label "sentence_31646148_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31646148_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31646148_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31646148> ;
                                                                             gutprop:hasSentenceText "Elucidating these mechanisms is essential to expand our understanding of the etiology of depression, and to develop new strategies to harness the beneficial psychotropic effects of these molecules." ;
                                                                             rdfs:label "sentence_31646148_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31646148_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31646148_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31646148> ;
                                                                             gutprop:hasSentenceText "Overall, the review highlights the potential for dietary interventions to represent such novel therapeutic strategies for major depressive disorder." ;
                                                                             rdfs:label "sentence_31646148_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31662903_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31662903_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/31662903> ;
                                                                             gutprop:hasSentenceText "Are Nonnutritive Sweeteners Obesogenic?" ;
                                                                             rdfs:label "sentence_31662903_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31662903_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31662903_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31662903> ;
                                                                             gutprop:hasSentenceText "Associations between Diet, Faecal Microbiota, and Short-Chain Fatty Acids in Morbidly Obese Subjects." ;
                                                                             rdfs:label "sentence_31662903_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31662903_10
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31662903_10> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31662903> ;
                                                                              gutprop:hasSentenceText "Butyric acid has antiobesogenic effects, reduces insulin resistance, and improves dyslipidaemia." ;
                                                                              rdfs:label "sentence_31662903_10" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31662903_11
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31662903_11> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31662903> ;
                                                                              gutprop:hasSentenceText "Since the weight-reducing effect of NNSs on obese adults trying to lose weight is dubious, it seems imprudent to use NNSs that might counteract the favourable effects of butyric acid." ;
                                                                              rdfs:label "sentence_31662903_11" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31662903_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31662903_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31662903> ;
                                                                             gutprop:hasSentenceText "Obesity has been associated with changes in the gut microbiota and its metabolites." ;
                                                                             rdfs:label "sentence_31662903_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31662903_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31662903_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31662903> ;
                                                                             gutprop:hasSentenceText "The study explored changes in the faecal microbiota and short-chain fatty acids (SCFA) associated with the diet (including nonnutritive sweeteners (NNSs)) and evaluated metabolic consequences in subjects with morbid obesity." ;
                                                                             rdfs:label "sentence_31662903_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31662903_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31662903_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31662903> ;
                                                                             gutprop:hasSentenceText "The diet was assessed with a validated food frequency questionnaire." ;
                                                                             rdfs:label "sentence_31662903_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31662903_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31662903_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31662903> ;
                                                                             gutprop:hasSentenceText "One unit of NNSs was 100 mL beverage with NNSs or 2 tablets/teaspoons of NNSs." ;
                                                                             rdfs:label "sentence_31662903_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31662903_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31662903_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31662903> ;
                                                                             gutprop:hasSentenceText "The faecal microbiota was assessed with GA-map® dysbiosis test and SCFA with gas chromatography and flame ionisation detection." ;
                                                                             rdfs:label "sentence_31662903_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31662903_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31662903_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31662903> ;
                                                                             gutprop:hasSentenceText "Fourteen men and 75 women with a mean age of 44.6 (SD 8.7) years, BMI 41.8 (SD 3.6) kg/m<sup>2</sup>, and intake of NNSs 7.5 units/day (SD 3.2; range 0-43) were included." ;
                                                                             rdfs:label "sentence_31662903_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31662903_8
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31662903_8> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31662903> ;
                                                                             gutprop:hasSentenceText "Faecal butyric acid was positively and negatively associated with the intake of starch (partial correlation = 0.264; <i>p</i>=0.015) and NNSs (partial correlation = -0.274; <i>p</i>=0.011), respectively." ;
                                                                             rdfs:label "sentence_31662903_8" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31662903_9
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31662903_9> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31662903> ;
                                                                             gutprop:hasSentenceText "NNSs were associated with changes in four out of 39 bacterial groups." ;
                                                                             rdfs:label "sentence_31662903_9" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31685046_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31685046_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/31685046> ;
                                                                             gutprop:hasSentenceText "Shotgun metagenomics reveals both taxonomic and tryptophan pathway differences of gut microbiota in major depressive disorder patients." ;
                                                                             rdfs:label "sentence_31685046_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31685046_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31685046_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31685046> ;
                                                                             gutprop:hasSentenceText "The microbiota-gut-brain axis, especially the microbial tryptophan (Trp) biosynthesis and metabolism pathway (MiTBamp), may play a critical role in the pathogenesis of major depressive disorder (MDD)." ;
                                                                             rdfs:label "sentence_31685046_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31685046_10
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31685046_10> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31685046> ;
                                                                              gutprop:hasSentenceText "Finally, RF classification at the genus level can achieve an area under the receiver operating characteristic curve of 0.890." ;
                                                                              rdfs:label "sentence_31685046_10" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31685046_11
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31685046_11> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31685046> ;
                                                                              gutprop:hasSentenceText "The present findings enabled a better understanding of the changes in gut microbiota and the related Trp pathway in MDD." ;
                                                                              rdfs:label "sentence_31685046_11" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31685046_12
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31685046_12> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31685046> ;
                                                                              gutprop:hasSentenceText "Alterations of the gut microbiota may have the potential as biomarkers for distinguishing MDD patients form HCs." ;
                                                                              rdfs:label "sentence_31685046_12" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31685046_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31685046_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31685046> ;
                                                                             gutprop:hasSentenceText "However, studies on the MiTBamp in MDD are lacking." ;
                                                                             rdfs:label "sentence_31685046_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31685046_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31685046_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31685046> ;
                                                                             gutprop:hasSentenceText "The aim of the present study was to analyze the gut microbiota composition and the MiTBamp in MDD patients." ;
                                                                             rdfs:label "sentence_31685046_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31685046_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31685046_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31685046> ;
                                                                             gutprop:hasSentenceText "We performed shotgun metagenomic sequencing of stool samples from 26 MDD patients and 29 healthy controls (HCs)." ;
                                                                             rdfs:label "sentence_31685046_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31685046_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31685046_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31685046> ;
                                                                             gutprop:hasSentenceText "In addition to the microbiota community and the MiTBamp analyses, we also built a classification based on the Random Forests (RF) and Boruta algorithm to identify the gut microbiota as biomarkers for MDD." ;
                                                                             rdfs:label "sentence_31685046_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31685046_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31685046_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31685046> ;
                                                                             gutprop:hasSentenceText "The Bacteroidetes abundance was strongly reduced whereas that of Actinobacteria was significantly increased in the MDD patients compared with the abundance in the HCs." ;
                                                                             rdfs:label "sentence_31685046_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31685046_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31685046_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31685046> ;
                                                                             gutprop:hasSentenceText "Most noteworthy, the MDD patients had increased levels of Bifidobacterium, which is commonly used as a probiotic." ;
                                                                             rdfs:label "sentence_31685046_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31685046_8
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31685046_8> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31685046> ;
                                                                             gutprop:hasSentenceText "Four Kyoto Encyclopedia of Genes and Genomes (KEGG) orthologies (KOs) (K01817, K11358, K01626, K01667) abundances in the MiTBamp were significantly lower in the MDD group." ;
                                                                             rdfs:label "sentence_31685046_8" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31685046_9
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31685046_9> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31685046> ;
                                                                             gutprop:hasSentenceText "Furthermore, we found a negative correlation between the K01626 abundance and the HAMD scores in the MDD group." ;
                                                                             rdfs:label "sentence_31685046_9" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31704402_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31704402_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/31704402> ;
                                                                             gutprop:hasSentenceText "Naturally-diverse airborne environmental microbial exposures modulate the gut microbiome and may provide anxiolytic benefits in mice." ;
                                                                             rdfs:label "sentence_31704402_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31704402_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31704402_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31704402> ;
                                                                             gutprop:hasSentenceText "Growing epidemiological evidence links natural green space exposure with a range of health benefits, including for mental health." ;
                                                                             rdfs:label "sentence_31704402_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31704402_10
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31704402_10> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31704402> ;
                                                                              gutprop:hasSentenceText "Our findings have potential to inform cost-effective population health interventions through microbiome-conscious green space design and, ultimately, the mainstreaming of biodiversity into health care." ;
                                                                              rdfs:label "sentence_31704402_10" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31704402_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31704402_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31704402> ;
                                                                             gutprop:hasSentenceText "Conversely, greater urbanisation associates with increased risk of mental health disorders." ;
                                                                             rdfs:label "sentence_31704402_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31704402_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31704402_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31704402> ;
                                                                             gutprop:hasSentenceText "Microbiomes are proposed as an important but understudied link that may help explain many green space-human health associations." ;
                                                                             rdfs:label "sentence_31704402_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31704402_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31704402_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31704402> ;
                                                                             gutprop:hasSentenceText "However, there remains a lack of controlled experimental evidence testing possible beneficial effects from passive exposure to natural biodiversity via airborne microbiota." ;
                                                                             rdfs:label "sentence_31704402_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31704402_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31704402_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31704402> ;
                                                                             gutprop:hasSentenceText "Previous mouse model studies have used unrealistic environmental microbial exposures-including excessive soil and organic matter contact, feed supplements and injections-to demonstrate host microbiota, immune biomarker, and behavioural changes." ;
                                                                             rdfs:label "sentence_31704402_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31704402_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31704402_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31704402> ;
                                                                             gutprop:hasSentenceText "Here, in a randomised controlled experiment, we demonstrate that realistic exposures to trace-level dust from a high biodiversity soil can change mouse gut microbiota, in comparison to dust from low biodiversity soil or no soil (control) (n = 54 total mice, comprising 3 treatments × 18 mice, with 9 females + 9 males per group)." ;
                                                                             rdfs:label "sentence_31704402_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31704402_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31704402_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31704402> ;
                                                                             gutprop:hasSentenceText "Furthermore, we found a nominal soil-derived anaerobic spore-forming butyrate-producer, Kineothrix alysoides, was supplemented to a greater extent in the gut microbiomes of high biodiversity treatment mice." ;
                                                                             rdfs:label "sentence_31704402_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31704402_8
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31704402_8> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31704402> ;
                                                                             gutprop:hasSentenceText "Also, increasing relative abundance of this rare organism correlated with reduced anxiety-like behaviour in the most anxious mice." ;
                                                                             rdfs:label "sentence_31704402_8" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31704402_9
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31704402_9> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31704402> ;
                                                                             gutprop:hasSentenceText "Our results point to an intriguing new hypothesis: that biodiverse soils may represent an important supplementary source of butyrate-producing bacteria capable of resupplying the mammalian gut microbiome, with potential for gut health and mental health benefits." ;
                                                                             rdfs:label "sentence_31704402_9" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31722343_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31722343_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/31722343> ;
                                                                             gutprop:hasSentenceText "The Gut Microbiome in Bipolar Disorder and Pharmacotherapy Management." ;
                                                                             rdfs:label "sentence_31722343_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31722343_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31722343_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31722343> ;
                                                                             gutprop:hasSentenceText "The gut microbiome is a complex and dynamic community of commensal, symbiotic, and pathogenic microorganisms that exist in a bidirectional relationship with the host." ;
                                                                             rdfs:label "sentence_31722343_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31722343_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31722343_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31722343> ;
                                                                             gutprop:hasSentenceText "Bacterial functions in the gut play a critical role in healthy host functioning, and its disruption can contribute to many medical conditions." ;
                                                                             rdfs:label "sentence_31722343_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31722343_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31722343_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31722343> ;
                                                                             gutprop:hasSentenceText "The relationship between gut microbiota and the brain has gained attention in mental health due to the mounting evidence supporting the association of gut bacteria with mood and behavior." ;
                                                                             rdfs:label "sentence_31722343_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31722343_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31722343_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31722343> ;
                                                                             gutprop:hasSentenceText "Patients with bipolar disorder exhibit an increased frequency of gastrointestinal illnesses such as inflammatory bowel disease, which mechanistically has been linked to microbial community function." ;
                                                                             rdfs:label "sentence_31722343_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31722343_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31722343_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31722343> ;
                                                                             gutprop:hasSentenceText "While the heterogeneity in microbial communities between individuals might be associated with disease risk, it may also moderate the efficacy or adverse effects associated with the use of medication." ;
                                                                             rdfs:label "sentence_31722343_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31722343_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31722343_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31722343> ;
                                                                             gutprop:hasSentenceText "The following review highlights published evidence linking the function of gut microbiota both to bipolar disorder risk and to the effect of medications that influence microbiota, inflammation, and mood symptoms." ;
                                                                             rdfs:label "sentence_31722343_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31726457_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31726457_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/31726457> ;
                                                                             gutprop:hasSentenceText "Gut Microbiota: A Perspective for Psychiatrists." ;
                                                                             rdfs:label "sentence_31726457_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31726457_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31726457_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31726457> ;
                                                                             gutprop:hasSentenceText "There is mounting evidence that the trillions of microbes that inhabit our gut are a substantial contributing factor to mental health and, equally, to the progression of neuropsychiatric disorders." ;
                                                                             rdfs:label "sentence_31726457_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31726457_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31726457_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31726457> ;
                                                                             gutprop:hasSentenceText "The extraordinary complexity of the gut ecosystem, and how it interacts with the intestinal epithelium to manifest physiological changes in the brain to influence mood and behaviour, has been the subject of intense scientific scrutiny over the last 2 decades." ;
                                                                             rdfs:label "sentence_31726457_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31726457_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31726457_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31726457> ;
                                                                             gutprop:hasSentenceText "To further complicate matters, we each harbour a unique microbiota community that is subject to change by a number of factors including diet, exercise, stress, health status, genetics, medication, and age, amongst others." ;
                                                                             rdfs:label "sentence_31726457_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31726457_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31726457_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31726457> ;
                                                                             gutprop:hasSentenceText "The microbiota-gut-brain axis is a dynamic matrix of tissues and organs including the gastrointestinal (GI) microbiota, immune cells, gut tissue, glands, the autonomic nervous system (ANS), and the brain that communicate in a complex multidirectional manner through a number of anatomically and physiologically distinct systems." ;
                                                                             rdfs:label "sentence_31726457_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31726457_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31726457_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31726457> ;
                                                                             gutprop:hasSentenceText "Long-term perturbations to this homeostatic environment may contribute to the progression of a number of disorders by altering physiological processes including hypothalamic-pituitary-adrenal axis activation, neurotransmitter systems, immune function, and the inflammatory response." ;
                                                                             rdfs:label "sentence_31726457_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31726457_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31726457_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31726457> ;
                                                                             gutprop:hasSentenceText "While an appropriate, co-ordinated physiological response, such as an immune or stress response, is necessary for survival, a dysfunctional response can be detrimental to the host, contributing to the development of a number of central nervous system disorders." ;
                                                                             rdfs:label "sentence_31726457_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31750916_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31750916_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/31750916> ;
                                                                             gutprop:hasSentenceText "Dietary fiber and its associations with depression and inflammation." ;
                                                                             rdfs:label "sentence_31750916_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31750916_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31750916_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31750916> ;
                                                                             gutprop:hasSentenceText "Dietary fiber is a crucial component of a healthy diet, with benefits that can be attributed to processes in the gut microbiota and the resulting by-products." ;
                                                                             rdfs:label "sentence_31750916_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31750916_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31750916_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31750916> ;
                                                                             gutprop:hasSentenceText "Observational studies support associations between dietary fiber intake and depression and inflammation, but the potential mechanisms are poorly understood." ;
                                                                             rdfs:label "sentence_31750916_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31750916_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31750916_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31750916> ;
                                                                             gutprop:hasSentenceText "This review examines evidence of the effects of dietary fiber on depression and inflammation and considers plausible mechanisms linking dietary fiber and depression, including microbiota-driven modification of gene expression and increased production of neurotransmitters." ;
                                                                             rdfs:label "sentence_31750916_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31750916_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31750916_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31750916> ;
                                                                             gutprop:hasSentenceText "Additionally, inflammation may mediate the relationship between dietary fiber intake and depression." ;
                                                                             rdfs:label "sentence_31750916_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31750916_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31750916_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31750916> ;
                                                                             gutprop:hasSentenceText "A high-fiber diet potentially lowers inflammation by modifying both the pH and the permeability of the gut." ;
                                                                             rdfs:label "sentence_31750916_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31750916_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31750916_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31750916> ;
                                                                             gutprop:hasSentenceText "The resultant reduction in inflammatory compounds may alter neurotransmitter concentrations to reduce symptoms of depression." ;
                                                                             rdfs:label "sentence_31750916_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31750916_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31750916_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31750916> ;
                                                                             gutprop:hasSentenceText "Further research into the link between dietary fiber intake and inflammation and depression is essential, as findings could potentially provide guidance for improvement in or prevention of inflammatory and depressive disorders." ;
                                                                             rdfs:label "sentence_31750916_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31769847_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31769847_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/31769847> ;
                                                                             gutprop:hasSentenceText "Probiotics and prebiotics: focus on psychiatric disorders - a systematic review." ;
                                                                             rdfs:label "sentence_31769847_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31769847_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31769847_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31769847> ;
                                                                             gutprop:hasSentenceText "The gut-brain axis and microbial dysbiosis may play a role in psychiatric diseases." ;
                                                                             rdfs:label "sentence_31769847_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31769847_10
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31769847_10> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31769847> ;
                                                                              gutprop:hasSentenceText "No benefits were found for patients with schizophrenia." ;
                                                                              rdfs:label "sentence_31769847_10" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31769847_11
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31769847_11> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31769847> ;
                                                                              gutprop:hasSentenceText "In most studies, no major adverse effects were reported." ;
                                                                              rdfs:label "sentence_31769847_11" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31769847_12
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31769847_12> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31769847> ;
                                                                              gutprop:hasSentenceText "Although recent findings in specific psychiatric disorders are encouraging, the use of prebiotics and probiotics in clinical practice stills lacks sufficiently robust evidence." ;
                                                                              rdfs:label "sentence_31769847_12" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31769847_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31769847_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31769847> ;
                                                                             gutprop:hasSentenceText "In this view, the gut microbiota has been considered a potential therapeutic target using probiotics and prebiotics." ;
                                                                             rdfs:label "sentence_31769847_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31769847_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31769847_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31769847> ;
                                                                             gutprop:hasSentenceText "This systematic review aims to find the existing clinical evidence that may justify the use of probiotics or prebiotics in psychiatric patients." ;
                                                                             rdfs:label "sentence_31769847_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31769847_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31769847_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31769847> ;
                                                                             gutprop:hasSentenceText "PRISMA guidelines were followed for a systematic literature review of randomized controlled trials that assessed the effect of prebiotics or probiotics in patients diagnosed with a classified psychiatric disorder." ;
                                                                             rdfs:label "sentence_31769847_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31769847_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31769847_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31769847> ;
                                                                             gutprop:hasSentenceText "From a total of 212 studies screened, 11 were included in the final systematic review." ;
                                                                             rdfs:label "sentence_31769847_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31769847_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31769847_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31769847> ;
                                                                             gutprop:hasSentenceText "Quality assessment of the included trials was assessed by the Jadad scale." ;
                                                                             rdfs:label "sentence_31769847_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31769847_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31769847_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31769847> ;
                                                                             gutprop:hasSentenceText "Probiotics seem to offer some benefit in major depressive disorder and Alzheimer's disease." ;
                                                                             rdfs:label "sentence_31769847_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31769847_8
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31769847_8> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31769847> ;
                                                                             gutprop:hasSentenceText "One study showed that probiotics reduced rehospitalization in patients with acute mania." ;
                                                                             rdfs:label "sentence_31769847_8" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31769847_9
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31769847_9> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31769847> ;
                                                                             gutprop:hasSentenceText "In autism spectrum disorders, the results were controversial; however a single study found that early administration of probiotics showed a preventive role." ;
                                                                             rdfs:label "sentence_31769847_9" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31821833_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31821833_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/31821833> ;
                                                                             gutprop:hasSentenceText "The connection between microbiome and schizophrenia." ;
                                                                             rdfs:label "sentence_31821833_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31821833_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31821833_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31821833> ;
                                                                             gutprop:hasSentenceText "There has been an accumulation of knowledge about the human microbiome, some detailed investigations of the gastrointestinal microbiota and its functions, and the highlighting of complex interactions between the gut, the gut microbiota, and the central nervous system." ;
                                                                             rdfs:label "sentence_31821833_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31821833_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31821833_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31821833> ;
                                                                             gutprop:hasSentenceText "That assumes the involvement of the microbiome in the pathogenesis of various CNS diseases, including schizophrenia." ;
                                                                             rdfs:label "sentence_31821833_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31821833_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31821833_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31821833> ;
                                                                             gutprop:hasSentenceText "Given this information and the fact, that the gut microbiota is sensitive to internal and environmental influences, we have speculated that among the factors that influence the formation and composition of gut microbiota during life, possible key elements in the schizophrenia development chain are hidden where gut microbiota is a linking component." ;
                                                                             rdfs:label "sentence_31821833_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31821833_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31821833_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31821833> ;
                                                                             gutprop:hasSentenceText "This article aims to describe and understand the developmental relationships between intestinal microbiota and the risk of developing schizophrenia." ;
                                                                             rdfs:label "sentence_31821833_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31917834_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31917834_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/31917834> ;
                                                                             gutprop:hasSentenceText "Adolescence and Aging: Impact of Adolescence Inflammatory Stress and Microbiota Alterations on Brain Development, Aging, and Neurodegeneration." ;
                                                                             rdfs:label "sentence_31917834_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31917834_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31917834_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31917834> ;
                                                                             gutprop:hasSentenceText "Puberty/adolescence is a critical phase during neurodevelopment with numerous structural, neurochemical, and molecular changes occurring in response to genetic and environmental signals." ;
                                                                             rdfs:label "sentence_31917834_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31917834_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31917834_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31917834> ;
                                                                             gutprop:hasSentenceText "A consequence of this major neuronal reorganizing and remodeling is a heightened level of vulnerability to stressors and immune challenges." ;
                                                                             rdfs:label "sentence_31917834_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31917834_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31917834_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31917834> ;
                                                                             gutprop:hasSentenceText "The gut microbiota is a fundamental modulator of stress and immune responses and has been found to play a role in mental health conditions and neurodegenerative disorders." ;
                                                                             rdfs:label "sentence_31917834_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31917834_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31917834_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31917834> ;
                                                                             gutprop:hasSentenceText "Environmental insults (stress, infection, neuroinflammation, and use of antibiotics) during adolescence can result in dysbiosis subsidizing the development of brain disorders later in life." ;
                                                                             rdfs:label "sentence_31917834_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31917834_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31917834_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31917834> ;
                                                                             gutprop:hasSentenceText "Also, pubertal neuroinflammatory insults can alter neurodevelopment, impact brain functioning in an enduring manner, and contribute to neurological disorders related to brain aging, such as Alzheimer's disease, Parkinson's disease, and depression." ;
                                                                             rdfs:label "sentence_31917834_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31917834_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31917834_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31917834> ;
                                                                             gutprop:hasSentenceText "Exposure to probiotics during puberty can mitigate inflammation, reverse dysbiosis, and decrease vulnerabilities to brain disorders later in life." ;
                                                                             rdfs:label "sentence_31917834_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31917834_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31917834_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31917834> ;
                                                                             gutprop:hasSentenceText "The goal of this review is to reveal the consequences of pubertal exposure to stress and immune challenges on the gut microbiota, immune reactivity within the brain, and the risk or resilience to stress-induced mental illnesses and neurodegenerative disorders." ;
                                                                             rdfs:label "sentence_31917834_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31917834_8
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31917834_8> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31917834> ;
                                                                             gutprop:hasSentenceText "We propose that the consumption of probiotics during adolescence contribute to the prevention of brain pathologies in adulthood." ;
                                                                             rdfs:label "sentence_31917834_8" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31940482_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31940482_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/31940482> ;
                                                                             gutprop:hasSentenceText "Probiotic Bacillus subtilis Protects against α-Synuclein Aggregation in C. elegans." ;
                                                                             rdfs:label "sentence_31940482_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31940482_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31940482_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31940482> ;
                                                                             gutprop:hasSentenceText "Recent discoveries have implicated the gut microbiome in the progression and severity of Parkinson's disease; however, how gut bacteria affect such neurodegenerative disorders remains unclear." ;
                                                                             rdfs:label "sentence_31940482_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31940482_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31940482_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31940482> ;
                                                                             gutprop:hasSentenceText "Here, we report that the Bacillus subtilis probiotic strain PXN21 inhibits α-synuclein aggregation and clears preformed aggregates in an established Caenorhabditis elegans model of synucleinopathy." ;
                                                                             rdfs:label "sentence_31940482_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31940482_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31940482_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31940482> ;
                                                                             gutprop:hasSentenceText "This protection is seen in young and aging animals and is partly mediated by DAF-16." ;
                                                                             rdfs:label "sentence_31940482_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31940482_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31940482_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31940482> ;
                                                                             gutprop:hasSentenceText "Multiple B. subtilis strains trigger the protective effect via both spores and vegetative cells, partly due to a biofilm formation in the gut of the worms and the release of bacterial metabolites." ;
                                                                             rdfs:label "sentence_31940482_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31940482_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31940482_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31940482> ;
                                                                             gutprop:hasSentenceText "We identify several host metabolic pathways differentially regulated in response to probiotic exposure, including sphingolipid metabolism." ;
                                                                             rdfs:label "sentence_31940482_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31940482_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31940482_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31940482> ;
                                                                             gutprop:hasSentenceText "We further demonstrate functional roles of the sphingolipid metabolism genes lagr-1, asm-3, and sptl-3 in the anti-aggregation effect." ;
                                                                             rdfs:label "sentence_31940482_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31940482_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31940482_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31940482> ;
                                                                             gutprop:hasSentenceText "Our findings provide a basis for exploring the disease-modifying potential of B. subtilis as a dietary supplement." ;
                                                                             rdfs:label "sentence_31940482_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31952911_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31952911_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/31952911> ;
                                                                             gutprop:hasSentenceText "Gut microbial changes of patients with psychotic and affective disorders: A systematic review." ;
                                                                             rdfs:label "sentence_31952911_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31952911_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31952911_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31952911> ;
                                                                             gutprop:hasSentenceText "Many diverse inflammatory pathophysiologic mechanisms have been linked to mental disorders, and through the past decade an increasing interest in the gut microbiota and its relation to mental health has been arising." ;
                                                                             rdfs:label "sentence_31952911_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31952911_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31952911_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31952911> ;
                                                                             gutprop:hasSentenceText "We aimed to systematically review studies of alterations in gut microbiota of patients suffering from psychotic disorders, bipolar disorder or depression compared to healthy controls." ;
                                                                             rdfs:label "sentence_31952911_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31952911_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31952911_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31952911> ;
                                                                             gutprop:hasSentenceText "We systematically searched the databases CENTRAL, PubMed, EMBASE, PsycINFO and LILACS." ;
                                                                             rdfs:label "sentence_31952911_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31952911_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31952911_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31952911> ;
                                                                             gutprop:hasSentenceText "Primary outcome was to compare the gut microbiota of patients suffering from psychotic disorders, bipolar disorder or depression with healthy controls." ;
                                                                             rdfs:label "sentence_31952911_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31952911_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31952911_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31952911> ;
                                                                             gutprop:hasSentenceText "We identified 17 studies, covering 744 patients and 620 healthy controls." ;
                                                                             rdfs:label "sentence_31952911_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31952911_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31952911_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31952911> ;
                                                                             gutprop:hasSentenceText "The most consistent microbiota changes were a tendency towards higher abundance of Actinobacteria and lower abundance of Firmicutes at the phylum level, lower abundance of Lachnospiraceae at family level and lower abundance of Faecalibacterium at genus level for the mental disorders overall." ;
                                                                             rdfs:label "sentence_31952911_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31952911_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31952911_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31952911> ;
                                                                             gutprop:hasSentenceText "However, we found that all studies had risk of bias and that the included studies displayed great variability in methods of storage, analysis of the fecal samples, reporting of results and statistics used." ;
                                                                             rdfs:label "sentence_31952911_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31952911_8
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31952911_8> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31952911> ;
                                                                             gutprop:hasSentenceText "Due to the many limitations of the included studies the findings should be interpreted with caution." ;
                                                                             rdfs:label "sentence_31952911_8" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31952911_9
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31952911_9> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31952911> ;
                                                                             gutprop:hasSentenceText "Larger studies (especially of schizophrenia and major depressive disorder) are needed, but it is also of great importance to gather information of and control for factors that influence the result of a microbiota analysis including body mass index (BMI), smoking, alcohol consumption, diet habits, antibiotics, sample handling, wet laboratory methods and statistics." ;
                                                                             rdfs:label "sentence_31952911_9" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31955786_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31955786_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/31955786> ;
                                                                             gutprop:hasSentenceText "Neuroactive compounds in foods: Occurrence, mechanism and potential health effects." ;
                                                                             rdfs:label "sentence_31955786_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31955786_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31955786_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31955786> ;
                                                                             gutprop:hasSentenceText "Neuroactive compounds are synthesized by certain plants and microorganisms by undertaking different tasks, especially as a stress response." ;
                                                                             rdfs:label "sentence_31955786_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31955786_10
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31955786_10> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31955786> ;
                                                                              gutprop:hasSentenceText "Furthermore, the importance of gut-brain axis, probiotics and prebiotics are discussed." ;
                                                                              rdfs:label "sentence_31955786_10" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31955786_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31955786_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31955786> ;
                                                                             gutprop:hasSentenceText "Most common neuroactive compounds in foods are gamma-aminobutyric acid (GABA), serotonin, melatonin, kynurenine, kynurenic acid, dopamine, norepinephrine, histamine, tryptamine, tyramine and β-phenylethylamine." ;
                                                                             rdfs:label "sentence_31955786_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31955786_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31955786_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31955786> ;
                                                                             gutprop:hasSentenceText "Fermented foods contain some of these compounds, which can affect human health and mood." ;
                                                                             rdfs:label "sentence_31955786_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31955786_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31955786_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31955786> ;
                                                                             gutprop:hasSentenceText "Moreover, food processing such as roasting and malting alter amount and profile of neuroactive compounds in foods." ;
                                                                             rdfs:label "sentence_31955786_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31955786_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31955786_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31955786> ;
                                                                             gutprop:hasSentenceText "In addition to plant-origin and microbially-formed neuroactive compounds in foods, these substances are also formed by gut microbiota, which is the most attractive subject to assess the interaction between gut microbiota and mental health." ;
                                                                             rdfs:label "sentence_31955786_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31955786_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31955786_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31955786> ;
                                                                             gutprop:hasSentenceText "The discovery of microbiota-gut-brain axis calls for the investigation of the effects of diet on the formation of neuroactive compounds in the gut." ;
                                                                             rdfs:label "sentence_31955786_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31955786_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31955786_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31955786> ;
                                                                             gutprop:hasSentenceText "Furthermore, probiotics and prebiotics are indispensable elements for the understanding of the food-mood relationship." ;
                                                                             rdfs:label "sentence_31955786_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31955786_8
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31955786_8> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31955786> ;
                                                                             gutprop:hasSentenceText "The focus of this comprehensive review is to investigate the neuroactive compounds found naturally in foods or formed during fermentation." ;
                                                                             rdfs:label "sentence_31955786_8" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31955786_9
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31955786_9> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31955786> ;
                                                                             gutprop:hasSentenceText "Their formation pathways in humans, plants and microorganisms, potential health effects, effects of diet on the formation of microbial metabolites including neuroactive compounds in the gut are discussed throughout this review." ;
                                                                             rdfs:label "sentence_31955786_9" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32041265_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32041265_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/32041265> ;
                                                                             gutprop:hasSentenceText "Interventional Influence of the Intestinal Microbiome Through Dietary Intervention and Bowel Cleansing Might Improve Motor Symptoms in Parkinson's Disease." ;
                                                                             rdfs:label "sentence_32041265_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32041265_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32041265_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32041265> ;
                                                                             gutprop:hasSentenceText "The impact of the gut microbiome is being increasingly appreciated in health and in various chronic diseases, among them neurodegenerative disorders such as Parkinson's disease (PD)." ;
                                                                             rdfs:label "sentence_32041265_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32041265_10
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32041265_10> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32041265> ;
                                                                              gutprop:hasSentenceText "The UDPRS III significantly improved and the levodopa-equivalent daily dose decreased after vegetarian diet and fecal enema in a one-year follow-up." ;
                                                                              rdfs:label "sentence_32041265_10" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32041265_11
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32041265_11> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32041265> ;
                                                                              gutprop:hasSentenceText "Additionally, we observed a significant association between the gut microbiome diversity and the UPDRS III and the abundance of <i>Ruminococcaceae</i>." ;
                                                                              rdfs:label "sentence_32041265_11" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32041265_12
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32041265_12> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32041265> ;
                                                                              gutprop:hasSentenceText "Additionally, the abundance of <i>Clostridiaceae</i> was significantly reduced after enema." ;
                                                                              rdfs:label "sentence_32041265_12" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32041265_13
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32041265_13> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32041265> ;
                                                                              gutprop:hasSentenceText "Dietary intervention and bowel cleansing may provide an additional non-pharmacologic therapeutic option for PD patients." ;
                                                                              rdfs:label "sentence_32041265_13" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32041265_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32041265_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32041265> ;
                                                                             gutprop:hasSentenceText "In the pathogenesis of PD, the role of the gut has been previously established." ;
                                                                             rdfs:label "sentence_32041265_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32041265_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32041265_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32041265> ;
                                                                             gutprop:hasSentenceText "In conjunction with a better understanding of the intestinal microbiome, a link to the misfolding and spread of alpha-synuclein via inflammatory processes within the gut is discussed." ;
                                                                             rdfs:label "sentence_32041265_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32041265_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32041265_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32041265> ;
                                                                             gutprop:hasSentenceText "In a case-control study, we assessed the gut microbiome of 54 PD patients and 32 healthy controls (HC)." ;
                                                                             rdfs:label "sentence_32041265_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32041265_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32041265_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32041265> ;
                                                                             gutprop:hasSentenceText "Additionally, we tested in this proof-of-concept study whether dietary intervention alone or additional physical colon cleaning may lead to changes of the gut microbiome in PD." ;
                                                                             rdfs:label "sentence_32041265_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32041265_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32041265_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32041265> ;
                                                                             gutprop:hasSentenceText "16 PD patients underwent a well-controlled balanced, ovo-lacto vegetarian diet intervention including short fatty acids for 14 days." ;
                                                                             rdfs:label "sentence_32041265_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32041265_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32041265_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32041265> ;
                                                                             gutprop:hasSentenceText "10 of those patients received additional treatment with daily fecal enema over 8 days." ;
                                                                             rdfs:label "sentence_32041265_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32041265_8
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32041265_8> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32041265> ;
                                                                             gutprop:hasSentenceText "Stool samples were collected before and after 14 days of intervention." ;
                                                                             rdfs:label "sentence_32041265_8" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32041265_9
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32041265_9> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32041265> ;
                                                                             gutprop:hasSentenceText "In comparison to HC, we could confirm previously reported PD associated microbiome changes." ;
                                                                             rdfs:label "sentence_32041265_9" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32056910_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32056910_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/32056910> ;
                                                                             gutprop:hasSentenceText "Feeling down?" ;
                                                                             rdfs:label "sentence_32056910_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32056910_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32056910_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32056910> ;
                                                                             gutprop:hasSentenceText "A systematic review of the gut microbiota in anxiety/depression and irritable bowel syndrome." ;
                                                                             rdfs:label "sentence_32056910_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32056910_10
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32056910_10> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32056910> ;
                                                                              gutprop:hasSentenceText "Comorbid IBS and anxiety/depression also had higher abundance of Proteobacteria, Prevotella/Prevotellaceae, Bacteroides and lower Lachnospiraceae relative to controls." ;
                                                                              rdfs:label "sentence_32056910_10" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32056910_11
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32056910_11> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32056910> ;
                                                                              gutprop:hasSentenceText "Limitations A large number of gut microbiota estimation methods and statistical techniques were utilized; therefore, meta-analysis was not possible." ;
                                                                              rdfs:label "sentence_32056910_11" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32056910_12
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32056910_12> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32056910> ;
                                                                              gutprop:hasSentenceText "Conclusions Well-designed case-control and longitudinal studies are required to disentangle whether the gut microbiota is predicted as a continuum of gastrointestinal and anxiety/depression symptom severity, or whether reported dysbiosis is unique to IBS and anxiety/depression comorbidity." ;
                                                                              rdfs:label "sentence_32056910_12" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32056910_13
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32056910_13> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32056910> ;
                                                                              gutprop:hasSentenceText "These findings may inform the development of targeted treatment through the gut microbiota for individuals with both anxiety/depression and IBS." ;
                                                                              rdfs:label "sentence_32056910_13" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32056910_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32056910_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32056910> ;
                                                                             gutprop:hasSentenceText "Background Anxiety/depression and irritable bowel syndrome (IBS) are highly prevalent and burdensome conditions, whose co-occurrence is estimated between 44 and 84%." ;
                                                                             rdfs:label "sentence_32056910_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32056910_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32056910_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32056910> ;
                                                                             gutprop:hasSentenceText "Shared gut microbiota alterations have been identified in these separate disorders relative to controls; however, studies have not adequately considered their comorbidity." ;
                                                                             rdfs:label "sentence_32056910_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32056910_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32056910_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32056910> ;
                                                                             gutprop:hasSentenceText "This review set out to identify case-control studies comparing the gut microbiota in anxiety/depression, IBS, and both conditions comorbidly relative to each other and to controls, as well as gut microbiota investigations including measures of both IBS and anxiety/depression." ;
                                                                             rdfs:label "sentence_32056910_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32056910_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32056910_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32056910> ;
                                                                             gutprop:hasSentenceText "Methods Four databases were systematically searched using comprehensive search terms (OVID Medline, Embase, PsycINFO, and PubMed), following PRISMA guidelines." ;
                                                                             rdfs:label "sentence_32056910_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32056910_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32056910_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32056910> ;
                                                                             gutprop:hasSentenceText "Results Systematic review identified 17 studies (10 human, 7 animal)." ;
                                                                             rdfs:label "sentence_32056910_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32056910_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32056910_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32056910> ;
                                                                             gutprop:hasSentenceText "Most studies investigated the gut microbiota and anxiety/depression symptoms in IBS cohorts." ;
                                                                             rdfs:label "sentence_32056910_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32056910_8
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32056910_8> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32056910> ;
                                                                             gutprop:hasSentenceText "Participants with IBS and high anxiety/depression symptoms had lower alpha diversity compared to controls and IBS-only cohorts." ;
                                                                             rdfs:label "sentence_32056910_8" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32056910_9
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32056910_9> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32056910> ;
                                                                             gutprop:hasSentenceText "Machine learning and beta diversity distinguished between IBS participants with and without anxiety/depression by their gut microbiota." ;
                                                                             rdfs:label "sentence_32056910_9" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32155131_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32155131_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/32155131> ;
                                                                             gutprop:hasSentenceText "Effects of the probiotic formulation SLAB51 in <i>in vitro</i> and <i>in vivo</i> Parkinson's disease models." ;
                                                                             rdfs:label "sentence_32155131_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32155131_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32155131_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32155131> ;
                                                                             gutprop:hasSentenceText "Parkinson is a common neurodegenerative disorder, characterized by motor and non-motor symptoms, including abnormalities in the gut function, which may appear before the motor sign." ;
                                                                             rdfs:label "sentence_32155131_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32155131_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32155131_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32155131> ;
                                                                             gutprop:hasSentenceText "To date, there are treatments that can help relieve Parkinson' disease (PD)-associated symptoms, but there is no cure to control the onset and progression of this disorder." ;
                                                                             rdfs:label "sentence_32155131_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32155131_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32155131_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32155131> ;
                                                                             gutprop:hasSentenceText "Altered components of the gut could represent a key role in gut-brain axis, which is a bidirectional system between the central nervous system and the enteric nervous system." ;
                                                                             rdfs:label "sentence_32155131_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32155131_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32155131_4> rdf:type owl:NamedIndividual ,
