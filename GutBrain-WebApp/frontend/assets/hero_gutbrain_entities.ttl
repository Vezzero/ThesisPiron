                                                                             gutprop:hasSentenceText "Gut-brain axis: Synergistic approach." ;
                                                                             rdfs:label "sentence_34908715_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34908715_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34908715_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34908715> ;
                                                                             gutprop:hasSentenceText "Since decades, there is a change in concept of the gut-brain axis." ;
                                                                             rdfs:label "sentence_34908715_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34908715_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34908715_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34908715> ;
                                                                             gutprop:hasSentenceText "There is differential increase in evidences focusing on the bidirectional communication between the gut microbiome and the brain." ;
                                                                             rdfs:label "sentence_34908715_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34908715_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34908715_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34908715> ;
                                                                             gutprop:hasSentenceText "It supports existence of far-reaching model of \"gut-brain axis.\"" ;
                                                                             rdfs:label "sentence_34908715_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34908715_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34908715_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34908715> ;
                                                                             gutprop:hasSentenceText "This axis is attaining more adherence to fields investigating biological and physiological footing of psychiatric, neuro-developmental, age-related, and neurodegenerative disorders." ;
                                                                             rdfs:label "sentence_34908715_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34908715_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34908715_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34908715> ;
                                                                             gutprop:hasSentenceText "Many factors can change microbiota composition in early life as well as with the increasing age." ;
                                                                             rdfs:label "sentence_34908715_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34908715_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34908715_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34908715> ;
                                                                             gutprop:hasSentenceText "Stress can affect the microbiota-gut-brain axis at every stages of life." ;
                                                                             rdfs:label "sentence_34908715_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34908715_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34908715_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34908715> ;
                                                                             gutprop:hasSentenceText "Recent advances have involved the gut microbiota in many conditions including severe mental illness, autism, anxiety, obesity, Parkinson's disease, and Alzheimer's disease." ;
                                                                             rdfs:label "sentence_34908715_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34908715_8
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34908715_8> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34908715> ;
                                                                             gutprop:hasSentenceText "The current studies target on elaborating the underlying mechanisms of microbiota-gut-brain axis and attempt to exemplify intervention and therapeutic strategies for neuropsychiatric disorders." ;
                                                                             rdfs:label "sentence_34908715_8" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34961418_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34961418_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/34961418> ;
                                                                             gutprop:hasSentenceText "Effects of Berberine on Gut Microbiota in Patients with Mild Metabolic Disorders Induced by Olanzapine." ;
                                                                             rdfs:label "sentence_34961418_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34961418_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34961418_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34961418> ;
                                                                             gutprop:hasSentenceText "Secondary metabolic disturbances in patients with schizophrenia or bipolar disorder may be attributed to olanzapine." ;
                                                                             rdfs:label "sentence_34961418_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34961418_10
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34961418_10> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34961418> ;
                                                                              gutprop:hasSentenceText "In conclusions, berberine may regulate intestinal flora and metabolism in patients with schizophrenia or bipolar disorder and mild metabolic disturbances induced by olanzapine." ;
                                                                              rdfs:label "sentence_34961418_10" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34961418_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34961418_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34961418> ;
                                                                             gutprop:hasSentenceText "It is important to prevent mild metabolic disorders progressing to metabolic syndrome." ;
                                                                             rdfs:label "sentence_34961418_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34961418_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34961418_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34961418> ;
                                                                             gutprop:hasSentenceText "This study aims to investigate the effects of berberine on intestinal flora in patients with mild metabolic disorders induced by olanzapine." ;
                                                                             rdfs:label "sentence_34961418_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34961418_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34961418_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34961418> ;
                                                                             gutprop:hasSentenceText "A total of 132 patients with schizophrenia, bipolar disorder, or schizoaffective psychosis that had been treated with olanzapine for at least 9 months were randomly assigned ([Formula: see text] = 66 each) to receive berberine or placebo tablets for 12 weeks." ;
                                                                             rdfs:label "sentence_34961418_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34961418_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34961418_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34961418> ;
                                                                             gutprop:hasSentenceText "Metabolic assessments and intestinal flora were quantified at baseline and after 4, 8, and 12 weeks of treatment." ;
                                                                             rdfs:label "sentence_34961418_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34961418_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34961418_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34961418> ;
                                                                             gutprop:hasSentenceText "Incidence rates of adverse reactions were recorded." ;
                                                                             rdfs:label "sentence_34961418_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34961418_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34961418_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34961418> ;
                                                                             gutprop:hasSentenceText "FPG, FPI, HOMA-IR, HbA1, TG, BMI, and WC were significantly lower in patients who received berberine compared to placebo after 12 weeks of treatment ([Formula: see text]< 0.05)." ;
                                                                             rdfs:label "sentence_34961418_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34961418_8
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34961418_8> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34961418> ;
                                                                             gutprop:hasSentenceText "The abundance of firmicutes and coliform were significantly lower and the abundance of bacteroides significantly higher in patients who received berberine compared to placebo after 12 weeks of treatment ([Formula: see text]< 0.05)." ;
                                                                             rdfs:label "sentence_34961418_8" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34961418_9
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34961418_9> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34961418> ;
                                                                             gutprop:hasSentenceText "In patients who received berberine, the abundance of firmicutes was significantly decreased, and the abundance of bacteroides was significantly increased, and in patients who received placebo, the abundance of firmicutes was significantly increased post-treatment, compared to baseline (both [Formula: see text]< 0.05)." ;
                                                                             rdfs:label "sentence_34961418_9" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34970638_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34970638_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/34970638> ;
                                                                             gutprop:hasSentenceText "CUMS and dexamethasone induce depression-like phenotypes in mice by differentially altering gut microbiota and triggering macroglia activation." ;
                                                                             rdfs:label "sentence_34970638_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34970638_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34970638_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34970638> ;
                                                                             gutprop:hasSentenceText "Although the link between gut microbiota and depression has been suggested, changes of gut microbiota vary largely among individuals with depression." ;
                                                                             rdfs:label "sentence_34970638_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34970638_10
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34970638_10> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34970638> ;
                                                                              gutprop:hasSentenceText "Compared with CON mice, CUMS-exposed mice showed a significant increase in both α and β diversity." ;
                                                                              rdfs:label "sentence_34970638_10" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34970638_11
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34970638_11> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34970638> ;
                                                                              gutprop:hasSentenceText "Prevotellaceae and Desulfovibrio were enriched, whereas Bacilli were decreased in the faeces of mice in the CUMS group." ;
                                                                              rdfs:label "sentence_34970638_11" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34970638_12
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34970638_12> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34970638> ;
                                                                              gutprop:hasSentenceText "DEX-treated mice had a decrease in the abundance of <i>Clostridium XVIII</i>." ;
                                                                              rdfs:label "sentence_34970638_12" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34970638_13
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34970638_13> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34970638> ;
                                                                              gutprop:hasSentenceText "Levels of occludin in colon tissue of DEX-treated mice were reduced." ;
                                                                              rdfs:label "sentence_34970638_13" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34970638_14
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34970638_14> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34970638> ;
                                                                              gutprop:hasSentenceText "Relative to mice in the CON and CUMS groups, DEX-treated mice contained higher serum levels of CORT and IL-1β." ;
                                                                              rdfs:label "sentence_34970638_14" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34970638_15
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34970638_15> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34970638> ;
                                                                              gutprop:hasSentenceText "Compared with CON mice, mice in the DEX and CUMS groups had higher levels of IL-1β in sera and lower levels of glial fibrillary acidic protein (GFAP), Nestin, Synapsin-1 and P2Y12 receptor in the hippocampus." ;
                                                                              rdfs:label "sentence_34970638_15" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34970638_16
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34970638_16> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34970638> ;
                                                                              gutprop:hasSentenceText "Changes of gut microbiota diversity, intestinal integrity and neuroinflammation in the brain contribute to CUMS-induced depression, whereas pathobionts and excessive immunosuppression with damaged neuronal synapses is a basis of the DEX-induced depression." ;
                                                                              rdfs:label "sentence_34970638_16" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34970638_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34970638_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34970638> ;
                                                                             gutprop:hasSentenceText "Explore the heterogeneity of microbiota-gut-brain axis and new pathogenic characteristics in murine models of depression." ;
                                                                             rdfs:label "sentence_34970638_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34970638_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34970638_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34970638> ;
                                                                             gutprop:hasSentenceText "Adolescent female mice were randomly divided into control (CON) group (n=10), chronic unexpected mild stress (CUMS) group (n=15) and dexamethasone (DEX) group (n=15)." ;
                                                                             rdfs:label "sentence_34970638_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34970638_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34970638_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34970638> ;
                                                                             gutprop:hasSentenceText "Mice in the DEX group were gavaged twice a day with 0.2 mg/kg of DEX for 5 weeks, whereas CON mice were given the same amount of solvent." ;
                                                                             rdfs:label "sentence_34970638_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34970638_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34970638_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34970638> ;
                                                                             gutprop:hasSentenceText "Mice in the CUMS group were exposed to stressors." ;
                                                                             rdfs:label "sentence_34970638_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34970638_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34970638_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34970638> ;
                                                                             gutprop:hasSentenceText "After behavioural evaluations, all mice were sacrificed for harvesting tissues and blood samples." ;
                                                                             rdfs:label "sentence_34970638_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34970638_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34970638_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34970638> ;
                                                                             gutprop:hasSentenceText "Enzyme-linked immunosorbent assay (ELISA) was conducted for measuring levels of corticosterone (CORT) and interleukin-1β (IL-1β) in sera, whereas levels of protein expression in colon and hippocampal tissues were examined by western blot." ;
                                                                             rdfs:label "sentence_34970638_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34970638_8
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34970638_8> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34970638> ;
                                                                             gutprop:hasSentenceText "Faecal microbial communities were analysed by sequencing 16S rDNAs." ;
                                                                             rdfs:label "sentence_34970638_8" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34970638_9
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34970638_9> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34970638> ;
                                                                             gutprop:hasSentenceText "Mice in CUMS and DEX groups exhibited severe depression-like behaviours." ;
                                                                             rdfs:label "sentence_34970638_9" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34985325_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34985325_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/34985325> ;
                                                                             gutprop:hasSentenceText "A Comprehensive Review on the Role of the Gut Microbiome in Human Neurological Disorders." ;
                                                                             rdfs:label "sentence_34985325_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34985325_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34985325_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34985325> ;
                                                                             gutprop:hasSentenceText "The human body is full of an extensive number of commensal microbes, consisting of bacteria, viruses, and fungi, collectively termed the human microbiome." ;
                                                                             rdfs:label "sentence_34985325_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34985325_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34985325_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34985325> ;
                                                                             gutprop:hasSentenceText "The initial acquisition of microbiota occurs from both the external and maternal environments, and the vast majority of them colonize the gastrointestinal tract (GIT)." ;
                                                                             rdfs:label "sentence_34985325_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34985325_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34985325_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34985325> ;
                                                                             gutprop:hasSentenceText "These microbial communities play a central role in the maturation and development of the immune system, the central nervous system, and the GIT system and are also responsible for essential metabolic pathways." ;
                                                                             rdfs:label "sentence_34985325_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34985325_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34985325_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34985325> ;
                                                                             gutprop:hasSentenceText "Various factors, including host genetic predisposition, environmental factors, lifestyle, diet, antibiotic or nonantibiotic drug use, etc., affect the composition of the gut microbiota." ;
                                                                             rdfs:label "sentence_34985325_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34985325_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34985325_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34985325> ;
                                                                             gutprop:hasSentenceText "Recent publications have highlighted that an imbalance in the gut microflora, known as dysbiosis, is associated with the onset and progression of neurological disorders." ;
                                                                             rdfs:label "sentence_34985325_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34985325_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34985325_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34985325> ;
                                                                             gutprop:hasSentenceText "Moreover, characterization of the microbiome-host cross talk pathways provides insight into novel therapeutic strategies." ;
                                                                             rdfs:label "sentence_34985325_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34985325_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34985325_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34985325> ;
                                                                             gutprop:hasSentenceText "Novel preclinical and clinical research on interventions related to the gut microbiome for treating neurological conditions, including autism spectrum disorders, Parkinson's disease, schizophrenia, multiple sclerosis, Alzheimer's disease, epilepsy, and stroke, hold significant promise." ;
                                                                             rdfs:label "sentence_34985325_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34985325_8
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34985325_8> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34985325> ;
                                                                             gutprop:hasSentenceText "This review aims to present a comprehensive overview of the potential involvement of the human gut microbiome in the pathogenesis of neurological disorders, with a particular emphasis on the potential of microbe-based therapies and/or diagnostic microbial biomarkers." ;
                                                                             rdfs:label "sentence_34985325_8" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34985325_9
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34985325_9> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34985325> ;
                                                                             gutprop:hasSentenceText "This review also discusses the potential health benefits of the administration of probiotics, prebiotics, postbiotics, and synbiotics and fecal microbiota transplantation in neurological disorders." ;
                                                                             rdfs:label "sentence_34985325_9" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34988495_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34988495_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/34988495> ;
                                                                             gutprop:hasSentenceText "Characterization of the gut microbiota among Veterans with unique military-related exposures and high prevalence of chronic health conditions: A United States-Veteran Microbiome Project (US-VMP) study." ;
                                                                             rdfs:label "sentence_34988495_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34988495_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34988495_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34988495> ;
                                                                             gutprop:hasSentenceText "The gut microbiome is impacted by environmental exposures and has been implicated in many physical and mental health conditions, including anxiety disorders, affective disorders, and trauma- and stressor-related disorders such as posttraumatic stress disorder (PTSD)." ;
                                                                             rdfs:label "sentence_34988495_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34988495_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34988495_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34988495> ;
                                                                             gutprop:hasSentenceText "United States (US) military Veterans are a unique population in that their military-related exposures can have consequences for both physical and mental health, but the gut microbiome of this population has been understudied." ;
                                                                             rdfs:label "sentence_34988495_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34988495_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34988495_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34988495> ;
                                                                             gutprop:hasSentenceText "In this publication, we describe exposures, health conditions, and medication use of Veterans in the US Veteran Microbiome Project (US-VMP) and examine the associations between these characteristics and the gut microbiota." ;
                                                                             rdfs:label "sentence_34988495_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34988495_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34988495_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34988495> ;
                                                                             gutprop:hasSentenceText "This cohort included 331 US Veterans seeking healthcare with the Veterans Health Administration who were 83% male with an average (±SD) age of 47.6 ​± ​13.4 years." ;
                                                                             rdfs:label "sentence_34988495_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34988495_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34988495_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34988495> ;
                                                                             gutprop:hasSentenceText "The cohort displayed a high prevalence of PTSD (49.8%) and history of traumatic brain injuries (76.1%), and high current use of prescription medications (74.9%) to treat various acute and chronic conditions." ;
                                                                             rdfs:label "sentence_34988495_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34988495_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34988495_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34988495> ;
                                                                             gutprop:hasSentenceText "We observed significant associations between the gut microbiota composition and gastroenteritis, peripheral vascular disease (PVD), bipolar disorders, symptoms of severe depression based on the Beck Depression Inventory, stimulant and opioid use disorders, beta-blockers, serotonin and norepinephrine reuptake inhibitor antidepressants, diabetes medications, and proton pump inhibitors." ;
                                                                             rdfs:label "sentence_34988495_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34988495_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34988495_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34988495> ;
                                                                             gutprop:hasSentenceText "Many of the Veteran characteristics examined were associated with altered relative abundances of specific taxa." ;
                                                                             rdfs:label "sentence_34988495_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34988495_8
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34988495_8> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34988495> ;
                                                                             gutprop:hasSentenceText "We found that PVD and cardiovascular disease were associated with lower microbiota diversity in the gut (i.e., α-diversity), while supplemental vitamin use was associated with higher α-diversity." ;
                                                                             rdfs:label "sentence_34988495_8" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34988495_9
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34988495_9> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34988495> ;
                                                                             gutprop:hasSentenceText "Our study contributes novel insights as to whether the unique exposures of Veterans in this cohort correlate with gut microbiota characteristics and, in line with previous findings with other population-level studies of the microbiome, confirms associations between numerous health conditions and medications with the gut microbiome." ;
                                                                             rdfs:label "sentence_34988495_9" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35069178_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35069178_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/35069178> ;
                                                                             gutprop:hasSentenceText "The Gut-Brain Axis and Its Relation to Parkinson's Disease: A Review." ;
                                                                             rdfs:label "sentence_35069178_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35069178_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35069178_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35069178> ;
                                                                             gutprop:hasSentenceText "Parkinson's disease is a chronic neurodegenerative disease characterized by the accumulation of misfolded alpha-synuclein protein (Lewy bodies) in dopaminergic neurons of the <i>substantia nigra</i> and other related circuitry, which contribute to the development of both motor (bradykinesia, tremors, stiffness, abnormal gait) and non-motor symptoms (gastrointestinal issues, urinogenital complications, olfaction dysfunction, cognitive impairment)." ;
                                                                             rdfs:label "sentence_35069178_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35069178_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35069178_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35069178> ;
                                                                             gutprop:hasSentenceText "Despite tremendous progress in the field, the exact pathways and mechanisms responsible for the initiation and progression of this disease remain unclear." ;
                                                                             rdfs:label "sentence_35069178_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35069178_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35069178_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35069178> ;
                                                                             gutprop:hasSentenceText "However, recent research suggests a potential relationship between the commensal gut bacteria and the brain capable of influencing neurodevelopment, brain function and health." ;
                                                                             rdfs:label "sentence_35069178_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35069178_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35069178_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35069178> ;
                                                                             gutprop:hasSentenceText "This bidirectional communication is often referred to as the microbiome-gut-brain axis." ;
                                                                             rdfs:label "sentence_35069178_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35069178_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35069178_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35069178> ;
                                                                             gutprop:hasSentenceText "Accumulating evidence suggests that the onset of non-motor symptoms, such as gastrointestinal manifestations, often precede the onset of motor symptoms and disease diagnosis, lending support to the potential role that the microbiome-gut-brain axis might play in the underlying pathological mechanisms of Parkinson's disease." ;
                                                                             rdfs:label "sentence_35069178_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35069178_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35069178_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35069178> ;
                                                                             gutprop:hasSentenceText "This review will provide an overview of and critically discuss the current knowledge of the relationship between the gut microbiota and Parkinson's disease." ;
                                                                             rdfs:label "sentence_35069178_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35069178_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35069178_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35069178> ;
                                                                             gutprop:hasSentenceText "We will discuss the role of α-synuclein in non-motor disease pathology, proposed pathways constituting the connection between the gut microbiome and the brain, existing evidence related to pre- and probiotic interventions." ;
                                                                             rdfs:label "sentence_35069178_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35069178_8
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35069178_8> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35069178> ;
                                                                             gutprop:hasSentenceText "Finally, we will highlight the potential opportunity for the development of novel preventative measures and therapeutic options that could target the microbiome-gut-brain axis in the context of Parkinson's disease." ;
                                                                             rdfs:label "sentence_35069178_8" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35083314_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35083314_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/35083314> ;
                                                                             gutprop:hasSentenceText "The small bowel microbiome changes significantly with age and aspects of the ageing process." ;
                                                                             rdfs:label "sentence_35083314_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35083314_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35083314_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35083314> ;
                                                                             gutprop:hasSentenceText "Gut microbiome changes have been associated with human ageing and implicated in age-related diseases including Alzheimer's disease and Parkinson's disease." ;
                                                                             rdfs:label "sentence_35083314_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35083314_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35083314_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35083314> ;
                                                                             gutprop:hasSentenceText "However, studies to date have used stool samples, which do not represent the entire gut." ;
                                                                             rdfs:label "sentence_35083314_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35083314_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35083314_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35083314> ;
                                                                             gutprop:hasSentenceText "Although more challenging to access, the small intestine plays critical roles in host metabolism and immune function." ;
                                                                             rdfs:label "sentence_35083314_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35083314_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35083314_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35083314> ;
                                                                             gutprop:hasSentenceText "In this paper (Leite <i>et al.</i> (2021), Cell Reports, doi: 10.1016/j.celrep.2021.109765), we demonstrate significant differences in the small intestinal microbiome in older subjects, using duodenal aspirates from 251 subjects aged 18-80 years." ;
                                                                             rdfs:label "sentence_35083314_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35083314_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35083314_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35083314> ;
                                                                             gutprop:hasSentenceText "Differences included significantly decreased microbial diversity in older subjects, driven by increased relative abundance of phylum Proteobacteria, particularly family Enterobacteriaceae and coliform genera <i>Escherichia</i> and <i>Klebsiella.</i> Moreover, while this decreased diversity was associated with the 'ageing process' (comprising chronologic age, number of medications, and number of concomitant diseases), changes in certain taxa were found to be associated with number of medications alone (<i>Klebsiella</i>), number of diseases alone (<i>Clostridium, Bilophila</i>), or chronologic age alone (<i>Escherichia</i>, <i>Lactobacillus, Enterococcus</i>)." ;
                                                                             rdfs:label "sentence_35083314_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35083314_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35083314_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35083314> ;
                                                                             gutprop:hasSentenceText "Lastly, many taxa associated with increasing chronologic age were anaerobes." ;
                                                                             rdfs:label "sentence_35083314_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35083314_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35083314_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35083314> ;
                                                                             gutprop:hasSentenceText "These changes may contribute to changes in human health that occur during the ageing process." ;
                                                                             rdfs:label "sentence_35083314_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35203906_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35203906_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/35203906> ;
                                                                             gutprop:hasSentenceText "Parkinson's Disease in Light of the COVID-19 Pandemic." ;
                                                                             rdfs:label "sentence_35203906_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35203906_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35203906_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35203906> ;
                                                                             gutprop:hasSentenceText "In this review we attempt to collate the existing scientific evidence regarding the possible role of severe acute respiratory syndrome coronavirus 2 (SARS-CoV-2) in the pathophysiology of Parkinson's disease (PD), as well as to investigate the impact of PD/parkinsonism on the clinical course of the viral infection itself." ;
                                                                             rdfs:label "sentence_35203906_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35203906_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35203906_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35203906> ;
                                                                             gutprop:hasSentenceText "Since etiology of PD is not completely understood, various studies suggest different potential links between coronavirus disease 2019 (COVID-19) and PD." ;
                                                                             rdfs:label "sentence_35203906_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35203906_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35203906_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35203906> ;
                                                                             gutprop:hasSentenceText "Suggested connections include, among others, similar prodromal symptoms, renin-angiotensin-aldosterone system involvement, or gut microbiome dysbiosis participation." ;
                                                                             rdfs:label "sentence_35203906_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35203906_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35203906_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35203906> ;
                                                                             gutprop:hasSentenceText "Despite the initial assumptions that, as a mainly elderly population suffering from rigidity of respiratory muscles, impairment of cough reflex, and dyspnea, PD patients would be more susceptible to viral infection, and would experience a more aggressive course of COVID-19, the published scientific reports contain mutually exclusive data that require further investigation and meta-analysis." ;
                                                                             rdfs:label "sentence_35203906_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35207632_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35207632_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/35207632> ;
                                                                             gutprop:hasSentenceText "Gastrointestinal Dysfunction in Parkinson's Disease: Current and Potential Therapeutics." ;
                                                                             rdfs:label "sentence_35207632_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35207632_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35207632_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35207632> ;
                                                                             gutprop:hasSentenceText "Abnormalities in the gastrointestinal (GI) tract of Parkinson's disease (PD) sufferers were first reported over 200 years ago; however, the extent and role of GI dysfunction in PD disease progression is still unknown." ;
                                                                             rdfs:label "sentence_35207632_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35207632_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35207632_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35207632> ;
                                                                             gutprop:hasSentenceText "GI dysfunctions, including dysphagia, gastroparesis, and constipation, are amongst the most prevalent non-motor symptoms in PD." ;
                                                                             rdfs:label "sentence_35207632_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35207632_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35207632_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35207632> ;
                                                                             gutprop:hasSentenceText "These symptoms not only impact patient quality of life, but also complicate disease management." ;
                                                                             rdfs:label "sentence_35207632_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35207632_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35207632_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35207632> ;
                                                                             gutprop:hasSentenceText "Conventional treatment pathways for GI dysfunctions (i.e., constipation), such as increasing fibre and fluid intake, and the use of over-the-counter laxatives, are generally ineffective in PD patients, and approved compounds such as guanylate cyclase C agonists and selective 5-hyroxytryptamine 4 receptor agonists have demonstrated limited efficacy." ;
                                                                             rdfs:label "sentence_35207632_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35207632_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35207632_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35207632> ;
                                                                             gutprop:hasSentenceText "Thus, identification of potential targets for novel therapies to alleviate PD-induced GI dysfunctions are essential to improve clinical outcomes and quality of life in people with PD." ;
                                                                             rdfs:label "sentence_35207632_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35207632_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35207632_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35207632> ;
                                                                             gutprop:hasSentenceText "Unlike the central nervous system (CNS), where PD pathology and the mechanisms involved in CNS damage are relatively well characterised, the effect of PD at the cellular and tissue level in the enteric nervous system (ENS) remains unclear, making it difficult to alleviate or reverse GI symptoms." ;
                                                                             rdfs:label "sentence_35207632_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35207632_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35207632_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35207632> ;
                                                                             gutprop:hasSentenceText "However, the resurgence of interest in understanding how the GI tract is involved in various disease states, such as PD, has resulted in the identification of novel therapeutic avenues." ;
                                                                             rdfs:label "sentence_35207632_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35207632_8
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35207632_8> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35207632> ;
                                                                             gutprop:hasSentenceText "This review focuses on common PD-related GI symptoms, and summarizes the current treatments available and their limitations." ;
                                                                             rdfs:label "sentence_35207632_8" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35207632_9
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35207632_9> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35207632> ;
                                                                             gutprop:hasSentenceText "We propose that by targeting the intestinal barrier, ENS, and/or the gut microbiome, may prove successful in alleviating PD-related GI symptoms, and discuss emerging therapies and potential drugs that could be repurposed to target these areas." ;
                                                                             rdfs:label "sentence_35207632_9" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35281490_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35281490_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/35281490> ;
                                                                             gutprop:hasSentenceText "Mechanistic Insights Into Gut Microbiome Dysbiosis-Mediated Neuroimmune Dysregulation and Protein Misfolding and Clearance in the Pathogenesis of Chronic Neurodegenerative Disorders." ;
                                                                             rdfs:label "sentence_35281490_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35281490_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35281490_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35281490> ;
                                                                             gutprop:hasSentenceText "The human gut microbiota is a complex, dynamic, and highly diverse community of microorganisms." ;
                                                                             rdfs:label "sentence_35281490_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35281490_10
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35281490_10> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35281490> ;
                                                                              gutprop:hasSentenceText "These can further disrupt intestinal barrier permeability, aggravate the systemic pro-inflammatory state, impair blood-brain barrier permeability and recruit immune mediators leading to neuroinflammation and neurodegeneration." ;
                                                                              rdfs:label "sentence_35281490_10" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35281490_11
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35281490_11> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35281490> ;
                                                                              gutprop:hasSentenceText "Continued biomedical advances in understanding the microbiota-gut-brain axis will extend the frontier of neurodegenerative disorders and enable the utilization of novel diagnostic and therapeutic strategies to mitigate the pathological burden of these diseases." ;
                                                                              rdfs:label "sentence_35281490_11" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35281490_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35281490_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35281490> ;
                                                                             gutprop:hasSentenceText "Beginning as early as <i>in utero</i> fetal development and continuing through birth to late-stage adulthood, the crosstalk between the gut microbiome and brain is essential for modulating various metabolic, neurodevelopmental, and immune-related pathways." ;
                                                                             rdfs:label "sentence_35281490_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35281490_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35281490_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35281490> ;
                                                                             gutprop:hasSentenceText "Conversely, microbial dysbiosis - defined as alterations in richness and relative abundances - of the gut is implicated in the pathogenesis of several chronic neurological and neurodegenerative disorders." ;
                                                                             rdfs:label "sentence_35281490_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35281490_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35281490_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35281490> ;
                                                                             gutprop:hasSentenceText "Evidence from large-population cohort studies suggests that individuals with neurodegenerative conditions have an altered gut microbial composition as well as microbial and serum metabolomic profiles distinct from those in the healthy population." ;
                                                                             rdfs:label "sentence_35281490_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35281490_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35281490_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35281490> ;
                                                                             gutprop:hasSentenceText "Dysbiosis is also linked to psychiatric and gastrointestinal complications - comorbidities often associated with the prodromal phase of Parkinson's disease (PD) and Alzheimer's disease (AD)." ;
                                                                             rdfs:label "sentence_35281490_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35281490_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35281490_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35281490> ;
                                                                             gutprop:hasSentenceText "Studies have identified potential mediators that link gut dysbiosis and neurological disorders." ;
                                                                             rdfs:label "sentence_35281490_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35281490_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35281490_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35281490> ;
                                                                             gutprop:hasSentenceText "Recent findings have also elucidated the potential mechanisms of disease pathology in the enteric nervous system prior to the onset of neurodegeneration." ;
                                                                             rdfs:label "sentence_35281490_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35281490_8
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35281490_8> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35281490> ;
                                                                             gutprop:hasSentenceText "This review highlights the functional pathways and mechanisms, particularly gut microbe-induced chronic inflammation, protein misfolding, propagation of disease-specific pathology, defective protein clearance, and autoimmune dysregulation, linking gut microbial dysbiosis and neurodegeneration." ;
                                                                             rdfs:label "sentence_35281490_8" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35281490_9
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35281490_9> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35281490> ;
                                                                             gutprop:hasSentenceText "In addition, we also discuss how pathogenic transformation of microbial composition leads to increased endotoxin production and fewer beneficial metabolites, both of which could trigger immune cell activation and enteric neuronal dysfunction." ;
                                                                             rdfs:label "sentence_35281490_9" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35317228_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35317228_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/35317228> ;
                                                                             gutprop:hasSentenceText "Analysis methods for the gut microbiome in neuropsychiatric and neurodegenerative disorders." ;
                                                                             rdfs:label "sentence_35317228_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35317228_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35317228_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35317228> ;
                                                                             gutprop:hasSentenceText "For a long time, the central nervous system was believed to be the only regulator of cognitive functions." ;
                                                                             rdfs:label "sentence_35317228_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35317228_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35317228_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35317228> ;
                                                                             gutprop:hasSentenceText "However, accumulating evidence suggests that the composition of the microbiome is strongly associated with brain functions and diseases." ;
                                                                             rdfs:label "sentence_35317228_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35317228_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35317228_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35317228> ;
                                                                             gutprop:hasSentenceText "Indeed, the gut microbiome is involved in neuropsychiatric diseases (e.g., depression, autism spectrum disorder, and anxiety) and neurodegenerative diseases (e.g., Parkinson's disease and Alzheimer's disease)." ;
                                                                             rdfs:label "sentence_35317228_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35317228_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35317228_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35317228> ;
                                                                             gutprop:hasSentenceText "In this review, we provide an overview of the link between the gut microbiome and neuropsychiatric or neurodegenerative disorders." ;
                                                                             rdfs:label "sentence_35317228_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35317228_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35317228_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35317228> ;
                                                                             gutprop:hasSentenceText "We also introduce analytical methods used to assess the connection between the gut microbiome and the brain." ;
                                                                             rdfs:label "sentence_35317228_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35317228_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35317228_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35317228> ;
                                                                             gutprop:hasSentenceText "The limitations of the methods used at present are also discussed." ;
                                                                             rdfs:label "sentence_35317228_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35317228_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35317228_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35317228> ;
                                                                             gutprop:hasSentenceText "The accurate translation of the microbiome information to brain disorder could promote better understanding of neuronal diseases and aid in finding alternative and novel therapies." ;
                                                                             rdfs:label "sentence_35317228_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35326429_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35326429_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/35326429> ;
                                                                             gutprop:hasSentenceText "Hydrogen Sulfide Produced by Gut Bacteria May Induce Parkinson's Disease." ;
                                                                             rdfs:label "sentence_35326429_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35326429_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35326429_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35326429> ;
                                                                             gutprop:hasSentenceText "Several bacterial species can generate hydrogen sulfide (H<sub>2</sub>S)." ;
                                                                             rdfs:label "sentence_35326429_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35326429_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35326429_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35326429> ;
                                                                             gutprop:hasSentenceText "Study evidence favors the view that the microbiome of the colon harbors increased amounts of H<sub>2</sub>S producing bacteria in Parkinson's disease." ;
                                                                             rdfs:label "sentence_35326429_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35326429_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35326429_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35326429> ;
                                                                             gutprop:hasSentenceText "Additionally, H<sub>2</sub>S can easily penetrate cell membranes and enter the cell interior." ;
                                                                             rdfs:label "sentence_35326429_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35326429_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35326429_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35326429> ;
                                                                             gutprop:hasSentenceText "In the cells, excessive amounts of H<sub>2</sub>S can potentially release cytochrome c protein from the mitochondria, increase the iron content of the cytosolic iron pool, and increase the amount of reactive oxygen species." ;
                                                                             rdfs:label "sentence_35326429_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35326429_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35326429_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35326429> ;
                                                                             gutprop:hasSentenceText "These events can lead to the formation of alpha-synuclein oligomers and fibrils in cells containing the alpha-synuclein protein." ;
                                                                             rdfs:label "sentence_35326429_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35326429_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35326429_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35326429> ;
                                                                             gutprop:hasSentenceText "In addition, bacterially produced H<sub>2</sub>S can interfere with the body urate metabolism and affect the blood erythrocytes and lymphocytes." ;
                                                                             rdfs:label "sentence_35326429_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35326429_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35326429_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35326429> ;
                                                                             gutprop:hasSentenceText "Gut bacteria responsible for increased H<sub>2</sub>S production, especially the mucus-associated species of the bacterial genera belonging to the Desulfovibrionaceae and Enterobacteriaceae families, are likely play a role in the pathogenesis of Parkinson's disease." ;
                                                                             rdfs:label "sentence_35326429_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35326429_8
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35326429_8> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35326429> ;
                                                                             gutprop:hasSentenceText "Special attention should be devoted to changes not only in the colonic but also in the duodenal microbiome composition with regard to the pathogenesis of Parkinson's disease." ;
                                                                             rdfs:label "sentence_35326429_8" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35326429_9
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35326429_9> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35326429> ;
                                                                             gutprop:hasSentenceText "Influenza infections may increase the risk of Parkinson's disease by causing the overgrowth of H<sub>2</sub>S-producing bacteria both in the colon and duodenum." ;
                                                                             rdfs:label "sentence_35326429_9" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35327401_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35327401_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/35327401> ;
                                                                             gutprop:hasSentenceText "<i>Drosophila</i> Model for Studying Gut Microbiota in Behaviors and Neurodegenerative Diseases." ;
                                                                             rdfs:label "sentence_35327401_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35327401_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35327401_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35327401> ;
                                                                             gutprop:hasSentenceText "Mounting evidence indicates that the gut microbiota is linked to several physiological processes and disease development in mammals; however, the underlying mechanisms remained unexplored mostly due to the complexity of the mammalian gut microbiome." ;
                                                                             rdfs:label "sentence_35327401_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35327401_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35327401_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35327401> ;
                                                                             gutprop:hasSentenceText "The fruit fly, <i>Drosophila melanogaster</i>, is a valuable animal model for studying host-gut microbiota interactions in translational aspects." ;
                                                                             rdfs:label "sentence_35327401_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35327401_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35327401_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35327401> ;
                                                                             gutprop:hasSentenceText "The availability of powerful genetic tools and resources in <i>Drosophila</i> allowed the scientists to unravel the mechanisms by which the gut microbes affect fitness, health, and behavior of their hosts." ;
                                                                             rdfs:label "sentence_35327401_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35327401_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35327401_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35327401> ;
                                                                             gutprop:hasSentenceText "<i>Drosophila</i> models have been extensively used not only to study animal behaviors (i.e., courtship, aggression, sleep, and learning & memory), but also some human related neurodegenerative diseases (i.e., Alzheimer's disease and Parkinson's disease) in the past." ;
                                                                             rdfs:label "sentence_35327401_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35327401_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35327401_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35327401> ;
                                                                             gutprop:hasSentenceText "This review comprehensively summarizes the current understanding of the gut microbiota of <i>Drosophila</i> and its impact on fly behavior, physiology, and neurodegenerative diseases." ;
                                                                             rdfs:label "sentence_35327401_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35432226_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35432226_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/35432226> ;
                                                                             gutprop:hasSentenceText "To the Gut Microbiome and Beyond: The Brain-First or Body-First Hypothesis in Parkinson's Disease." ;
                                                                             rdfs:label "sentence_35432226_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35432226_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35432226_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35432226> ;
                                                                             gutprop:hasSentenceText "There is continued debate regarding Parkinson's disease etiology and whether it originates in the brain or begins in the gut." ;
                                                                             rdfs:label "sentence_35432226_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35432226_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35432226_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35432226> ;
                                                                             gutprop:hasSentenceText "Recently, evidence has been provided for both, with Parkinson's disease onset presenting as either a \"body-first\" or \"brain-first\" progression." ;
                                                                             rdfs:label "sentence_35432226_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35432226_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35432226_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35432226> ;
                                                                             gutprop:hasSentenceText "Most research indicates those with Parkinson's disease have an altered gut microbiome compared to controls." ;
                                                                             rdfs:label "sentence_35432226_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35432226_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35432226_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35432226> ;
                                                                             gutprop:hasSentenceText "However, some studies do not report gut microbiome differences, potentially due to the brain or body-first progression type." ;
                                                                             rdfs:label "sentence_35432226_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35432226_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35432226_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35432226> ;
                                                                             gutprop:hasSentenceText "Based on the etiology of each proposed progression, individuals with the body-first progression may exhibit altered gut microbiomes, i.e., where short-chain fatty acid producing bacteria are reduced, while the brain-first progression may not." ;
                                                                             rdfs:label "sentence_35432226_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35432226_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35432226_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35432226> ;
                                                                             gutprop:hasSentenceText "Future microbiome research should consider this hypothesis and investigate whether gut microbiome differences exist between each type of progression." ;
                                                                             rdfs:label "sentence_35432226_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35432226_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35432226_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35432226> ;
                                                                             gutprop:hasSentenceText "This may further elucidate the impact of the gut microbiome in Parkinson's disease and show how it may not be homogenous across individuals with Parkinson's disease." ;
                                                                             rdfs:label "sentence_35432226_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35565918_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35565918_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/35565918> ;
                                                                             gutprop:hasSentenceText "The Therapeutic Role of Ketogenic Diet in Neurological Disorders." ;
                                                                             rdfs:label "sentence_35565918_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35565918_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35565918_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35565918> ;
                                                                             gutprop:hasSentenceText "The ketogenic diet (KD) is a high-fat, low-carbohydrate and adequate-protein diet that has gained popularity in recent years in the context of neurological diseases (NDs)." ;
                                                                             rdfs:label "sentence_35565918_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35565918_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35565918_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35565918> ;
                                                                             gutprop:hasSentenceText "The complexity of the pathogenesis of these diseases means that effective forms of treatment are still lacking." ;
                                                                             rdfs:label "sentence_35565918_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35565918_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35565918_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35565918> ;
                                                                             gutprop:hasSentenceText "Conventional therapy is often associated with increasing tolerance and/or drug resistance." ;
                                                                             rdfs:label "sentence_35565918_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35565918_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35565918_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35565918> ;
                                                                             gutprop:hasSentenceText "Consequently, more effective therapeutic strategies are being sought to increase the effectiveness of available forms of therapy and improve the quality of life of patients." ;
                                                                             rdfs:label "sentence_35565918_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35565918_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35565918_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35565918> ;
                                                                             gutprop:hasSentenceText "For the moment, it seems that KD can provide therapeutic benefits in patients with neurological problems by effectively controlling the balance between pro- and antioxidant processes and pro-excitatory and inhibitory neurotransmitters, and modulating inflammation or changing the composition of the gut microbiome." ;
                                                                             rdfs:label "sentence_35565918_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35565918_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35565918_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35565918> ;
                                                                             gutprop:hasSentenceText "In this review we evaluated the potential therapeutic efficacy of KD in epilepsy, depression, migraine, Alzheimer's disease and Parkinson's disease." ;
                                                                             rdfs:label "sentence_35565918_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35565918_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35565918_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35565918> ;
                                                                             gutprop:hasSentenceText "In our opinion, KD should be considered as an adjuvant therapeutic option for some neurological diseases." ;
                                                                             rdfs:label "sentence_35565918_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35571084_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35571084_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/35571084> ;
                                                                             gutprop:hasSentenceText "Using <i>Caenorhabditis elegans</i> to Model Therapeutic Interventions of Neurodegenerative Diseases Targeting Microbe-Host Interactions." ;
                                                                             rdfs:label "sentence_35571084_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35571084_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35571084_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35571084> ;
                                                                             gutprop:hasSentenceText "Emerging evidence from both clinical studies and animal models indicates the importance of the interaction between the gut microbiome and the brain in the pathogenesis of neurodegenerative diseases (NDs)." ;
                                                                             rdfs:label "sentence_35571084_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35571084_10
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35571084_10> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35571084> ;
                                                                              gutprop:hasSentenceText "elegans</i> and mouse ND models, we found that about half of them are known to inhibit bacterial growth or biofilm formation, suggesting a strong correlation between the neuroprotective and antibiofilm activities." ;
                                                                              rdfs:label "sentence_35571084_10" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35571084_11
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35571084_11> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35571084> ;
                                                                              gutprop:hasSentenceText "Whether these potential therapeutics indeed protect neurons from proteotoxicity by inhibiting the cross-seeding between bacterial and human amyloid proteins awaits further investigations." ;
                                                                              rdfs:label "sentence_35571084_11" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35571084_12
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35571084_12> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35571084> ;
                                                                              gutprop:hasSentenceText "Finally, we propose to screen the long list of antibiofilm agents, both FDA-approved drugs and novel compounds, for their neuroprotective effects and develop new pharmaceuticals that target the gut microbiome for the treatment of NDs." ;
                                                                              rdfs:label "sentence_35571084_12" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35571084_13
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35571084_13> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35571084> ;
                                                                              gutprop:hasSentenceText "To this end, the <i>C." ;
                                                                              rdfs:label "sentence_35571084_13" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35571084_14
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35571084_14> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35571084> ;
                                                                              gutprop:hasSentenceText "elegans</i> ND models can serve as a platform for fast, high-throughput, and low-cost drug screens that target the microbe-host interaction in NDs." ;
                                                                              rdfs:label "sentence_35571084_14" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35571084_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35571084_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35571084> ;
                                                                             gutprop:hasSentenceText "Although how microbes modulate neurodegeneration is still mostly unclear, recent studies have started to probe into the mechanisms for the communication between microbes and hosts in NDs." ;
                                                                             rdfs:label "sentence_35571084_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35571084_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35571084_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35571084> ;
                                                                             gutprop:hasSentenceText "In this review, we highlight the advantages of using <i>Caenorhabditis elegans</i> (C. elegans) to disentangle the microbe-host interaction that regulates neurodegeneration." ;
                                                                             rdfs:label "sentence_35571084_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35571084_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35571084_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35571084> ;
                                                                             gutprop:hasSentenceText "We summarize the microbial pro- and anti-neurodegenerative factors identified using the <i>C." ;
                                                                             rdfs:label "sentence_35571084_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35571084_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35571084_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35571084> ;
                                                                             gutprop:hasSentenceText "elegans</i> ND models and the effects of many are confirmed in mouse models." ;
                                                                             rdfs:label "sentence_35571084_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35571084_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35571084_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35571084> ;
                                                                             gutprop:hasSentenceText "Specifically, we focused on the role of bacterial amyloid proteins, such as curli, in promoting proteotoxicity and neurodegeneration by cross-seeding the aggregation of endogenous ND-related proteins, such as α-synuclein." ;
                                                                             rdfs:label "sentence_35571084_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35571084_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35571084_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35571084> ;
                                                                             gutprop:hasSentenceText "Targeting bacterial amyloid production may serve as a novel therapeutic strategy for treating NDs, and several compounds, such as epigallocatechin-3-gallate (EGCG), were shown to suppress neurodegeneration at least partly by inhibiting curli production." ;
                                                                             rdfs:label "sentence_35571084_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35571084_8
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35571084_8> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35571084> ;
                                                                             gutprop:hasSentenceText "Because bacterial amyloid fibrils contribute to biofilm formation, inhibition of amyloid production often leads to the disruption of biofilms." ;
                                                                             rdfs:label "sentence_35571084_8" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35571084_9
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35571084_9> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35571084> ;
                                                                             gutprop:hasSentenceText "Interestingly, from a list of 59 compounds that showed neuroprotective effects in <i>C." ;
                                                                             rdfs:label "sentence_35571084_9" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35654142_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35654142_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/35654142> ;
                                                                             gutprop:hasSentenceText "Mechanistic insights into accelerated α-synuclein aggregation mediated by human microbiome-associated functional amyloids." ;
                                                                             rdfs:label "sentence_35654142_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35654142_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35654142_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35654142> ;
                                                                             gutprop:hasSentenceText "The gut microbiome has been shown to have key implications in the pathogenesis of Parkinson's disease (PD)." ;
                                                                             rdfs:label "sentence_35654142_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35654142_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35654142_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35654142> ;
                                                                             gutprop:hasSentenceText "The Escherichia coli functional amyloid CsgA is known to accelerate α-synuclein aggregation in vitro and induce PD symptoms in mice." ;
                                                                             rdfs:label "sentence_35654142_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35654142_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35654142_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35654142> ;
                                                                             gutprop:hasSentenceText "However, the mechanism governing CsgA-mediated acceleration of α-synuclein aggregation is unclear." ;
                                                                             rdfs:label "sentence_35654142_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35654142_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35654142_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35654142> ;
                                                                             gutprop:hasSentenceText "Here, we show that CsgA can form stable homodimeric species that correlate with faster α-synuclein amyloid aggregation." ;
                                                                             rdfs:label "sentence_35654142_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35654142_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35654142_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35654142> ;
                                                                             gutprop:hasSentenceText "Furthermore, we identify and characterize new CsgA homologs encoded by bacteria present in the human microbiome." ;
                                                                             rdfs:label "sentence_35654142_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35654142_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35654142_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35654142> ;
                                                                             gutprop:hasSentenceText "These CsgA homologs display diverse aggregation kinetics, and they differ in their ability to modulate α-synuclein aggregation." ;
                                                                             rdfs:label "sentence_35654142_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35654142_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35654142_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35654142> ;
                                                                             gutprop:hasSentenceText "Remarkably, we demonstrate that slowing down CsgA aggregation leads to an increased acceleration of α-synuclein aggregation, suggesting that the intrinsic amyloidogenicity of gut bacterial CsgA homologs affects their ability to accelerate α-synuclein aggregation." ;
                                                                             rdfs:label "sentence_35654142_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35654142_8
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35654142_8> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35654142> ;
                                                                             gutprop:hasSentenceText "Finally, we identify a complex between CsgA and α-synuclein that functions as a platform to accelerate α-synuclein aggregation." ;
                                                                             rdfs:label "sentence_35654142_8" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35654142_9
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35654142_9> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35654142> ;
                                                                             gutprop:hasSentenceText "Taken together, our work reveals complex interplay between bacterial amyloids and α-synuclein that better informs our understanding of PD causation." ;
                                                                             rdfs:label "sentence_35654142_9" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35674870_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35674870_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/35674870> ;
                                                                             gutprop:hasSentenceText "Neurodegeneration and Neuroinflammation in Parkinson's Disease: a Self-Sustained Loop." ;
                                                                             rdfs:label "sentence_35674870_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35674870_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35674870_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35674870> ;
                                                                             gutprop:hasSentenceText "Neuroinflammation plays a significant role in Parkinson's disease (PD) etiology along with mitochondrial dysfunction and impaired proteostasis." ;
                                                                             rdfs:label "sentence_35674870_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35674870_10
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35674870_10> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35674870> ;
                                                                              gutprop:hasSentenceText "Finally, we will comment on the potential clinical translatability of immunobiomarkers identified in PD patient cohorts and provide an update on current therapeutic strategies aimed at overcoming or preventing inflammation in PD." ;
                                                                              rdfs:label "sentence_35674870_10" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35674870_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35674870_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35674870> ;
                                                                             gutprop:hasSentenceText "In this context, mechanisms related to immune response can act as modifiers at different steps of the neurodegenerative process and justify the growing interest in anti-inflammatory agents as potential disease-modifying treatments in PD." ;
                                                                             rdfs:label "sentence_35674870_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35674870_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35674870_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35674870> ;
                                                                             gutprop:hasSentenceText "The discovery of inherited gene mutations in PD has allowed researchers to develop cellular and animal models to study the mechanisms of the underlying biology, but the original cause of neuroinflammation in PD is still debated to date." ;
                                                                             rdfs:label "sentence_35674870_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35674870_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35674870_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35674870> ;
                                                                             gutprop:hasSentenceText "Cell autonomous alterations in neuronal cells, including mitochondrial damage and protein aggregation, could play a role, but recent findings also highlighted the importance of intercellular communication at both local and systemic level." ;
                                                                             rdfs:label "sentence_35674870_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35674870_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35674870_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35674870> ;
                                                                             gutprop:hasSentenceText "This has given rise to debate about the role of non-neuronal cells in PD and reignited intense research into the gut-brain axis and other non-neuronal interactions in the development of the disease." ;
                                                                             rdfs:label "sentence_35674870_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35674870_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35674870_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35674870> ;
                                                                             gutprop:hasSentenceText "Whatever the original trigger of neuroinflammation in PD, what appears quite clear is that the aberrant activation of glial cells and other components of the immune system creates a vicious circle in which neurodegeneration and neuroinflammation nourish each other." ;
                                                                             rdfs:label "sentence_35674870_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35674870_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35674870_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35674870> ;
                                                                             gutprop:hasSentenceText "In this review, we will provide an up-to-date summary of the main cellular alterations underlying neuroinflammation in PD, including those induced by environmental factors (e.g." ;
                                                                             rdfs:label "sentence_35674870_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35674870_8
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35674870_8> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35674870> ;
                                                                             gutprop:hasSentenceText "the gut microbiome) and those related to the genetic background of affected patients." ;
                                                                             rdfs:label "sentence_35674870_8" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35674870_9
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35674870_9> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35674870> ;
                                                                             gutprop:hasSentenceText "Starting from the lesson provided by familial forms of PD, we will discuss pathophysiological mechanisms linked to inflammation that could also play a role in idiopathic forms." ;
                                                                             rdfs:label "sentence_35674870_9" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35722294_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35722294_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/35722294> ;
                                                                             gutprop:hasSentenceText "Integrated Microbiome and Host Transcriptome Profiles Link Parkinson's Disease to <i>Blautia</i> Genus: Evidence From Feces, Blood, and Brain." ;
                                                                             rdfs:label "sentence_35722294_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35722294_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35722294_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35722294> ;
                                                                             gutprop:hasSentenceText "A link between the gut microbiome and Parkinson's disease (PD) has been intensively studied, and more than 100 differential genera were identified across the studies." ;
                                                                             rdfs:label "sentence_35722294_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35722294_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35722294_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35722294> ;
                                                                             gutprop:hasSentenceText "However, the predominant genera contributing to PD remain poorly understood." ;
                                                                             rdfs:label "sentence_35722294_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35722294_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35722294_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35722294> ;
                                                                             gutprop:hasSentenceText "Inspired by recent advances showing microbiota distribution in the blood and brain, we, here, comprehensively investigated currently available fecal microbiome data (1,914 samples) to identify significantly altered genera, which were further validated by comparison to the results from microbiome analysis of blood (85 samples) and brain (268 samples)." ;
                                                                             rdfs:label "sentence_35722294_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35722294_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35722294_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35722294> ;
                                                                             gutprop:hasSentenceText "Our data showed that the composition of fecal microbiota was different from that of blood and brain." ;
                                                                             rdfs:label "sentence_35722294_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35722294_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35722294_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35722294> ;
                                                                             gutprop:hasSentenceText "We found that <i>Blautia</i> was the unique genus consistently depleted across feces, blood, and brain samples of PD patients (<i>P</i> < 0.05), despite using rigorous criteria to remove contaminants." ;
                                                                             rdfs:label "sentence_35722294_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35722294_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35722294_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35722294> ;
                                                                             gutprop:hasSentenceText "Moreover, enrichment analyses revealed that host genes correlated with <i>Blautia</i> genus abundance were mainly involved in mitochondrial function and energy metabolism, and mapped to neurodegenerative diseases (NDDs) and metabolic diseases." ;
                                                                             rdfs:label "sentence_35722294_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35722294_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35722294_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35722294> ;
                                                                             gutprop:hasSentenceText "A random forest classifier constructed with fecal microbiota data demonstrated that <i>Blautia</i> genus was an important feature contributing to discriminating PD patients from controls [receiver operating characteristic (ROC)-area under curve (AUC) = 0.704, precision-recall curve (PRC)-AUC = 0.787]." ;
                                                                             rdfs:label "sentence_35722294_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35722294_8
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35722294_8> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35722294> ;
                                                                             gutprop:hasSentenceText "Through the integration of microbiome and transcriptome, our study depicted microbial profiles in the feces, blood, and brain of PD patients, and identified <i>Blautia</i> genus as a potential genus linked to PD." ;
                                                                             rdfs:label "sentence_35722294_8" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35722294_9
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35722294_9> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35722294> ;
                                                                             gutprop:hasSentenceText "Further studies are greatly encouraged to determine the role of <i>Blautia</i> genus in the pathogenesis of PD." ;
                                                                             rdfs:label "sentence_35722294_9" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35798742_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35798742_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/35798742> ;
                                                                             gutprop:hasSentenceText "Oral and gut dysbiosis leads to functional alterations in Parkinson's disease." ;
                                                                             rdfs:label "sentence_35798742_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35798742_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35798742_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35798742> ;
                                                                             gutprop:hasSentenceText "Although several studies have identified a distinct gut microbial composition in Parkinson's disease (PD), few studies have investigated the oral microbiome or functional alteration of the microbiome in PD." ;
                                                                             rdfs:label "sentence_35798742_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35798742_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35798742_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35798742> ;
                                                                             gutprop:hasSentenceText "We aimed to investigate the connection between the oral and gut microbiome and the functional changes in the PD-specific gut microbiome using shotgun metagenomic sequencing." ;
                                                                             rdfs:label "sentence_35798742_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35798742_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35798742_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35798742> ;
                                                                             gutprop:hasSentenceText "The taxonomic composition of the oral and gut microbiome was significantly different between PD patients and healthy controls (P = 0.003 and 0.001, respectively)." ;
                                                                             rdfs:label "sentence_35798742_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35798742_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35798742_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35798742> ;
                                                                             gutprop:hasSentenceText "Oral Lactobacillus was more abundant in PD patients and was associated with opportunistic pathogens in the gut (FDR-adjusted P < 0.038)." ;
                                                                             rdfs:label "sentence_35798742_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35798742_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35798742_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35798742> ;
                                                                             gutprop:hasSentenceText "Functional analysis revealed that microbial gene markers for glutamate and arginine biosynthesis were downregulated, while antimicrobial resistance gene markers were upregulated in PD patients than healthy controls (all P < 0.001)." ;
                                                                             rdfs:label "sentence_35798742_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35798742_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35798742_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35798742> ;
                                                                             gutprop:hasSentenceText "We identified a connection between the oral and gut microbiota in PD, which might lead to functional alteration of the microbiome in PD." ;
                                                                             rdfs:label "sentence_35798742_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35914559_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35914559_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/35914559> ;
                                                                             gutprop:hasSentenceText "Oral ingestion of the environmental toxicant trichloroethylene in rats induces alterations in the gut microbiome: Relevance to idiopathic Parkinson's disease." ;
                                                                             rdfs:label "sentence_35914559_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35914559_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35914559_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35914559> ;
                                                                             gutprop:hasSentenceText "Microbial alterations within the gut microbiome appear to be a common feature of individuals with Parkinson's disease (PD), providing further evidence for the role of the gut-brain axis in PD development." ;
                                                                             rdfs:label "sentence_35914559_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35914559_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35914559_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35914559> ;
                                                                             gutprop:hasSentenceText "As a major site of contact with the environment, questions have emerged surrounding the cause and effect of alterations to the gut microbiome by environmental contaminants associated with PD risk, such as pesticides, metals, and organic solvents." ;
                                                                             rdfs:label "sentence_35914559_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35914559_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35914559_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35914559> ;
                                                                             gutprop:hasSentenceText "Recent data from our lab shows that ingestion of the industrial byproduct and environmental pollutant trichloroethylene (TCE) induces key Parkinsonian pathology within aged rats, including the degeneration of dopaminergic neurons, α-synuclein accumulation, neuroinflammation, and endolysosomal deficits." ;
                                                                             rdfs:label "sentence_35914559_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35914559_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35914559_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35914559> ;
                                                                             gutprop:hasSentenceText "As TCE is the most common organic contaminant within drinking water, we postulated that ingestion of TCE associated with PD-related neurodegeneration may alter the gut microbiome to a similar extent as observed in persons with PD." ;
                                                                             rdfs:label "sentence_35914559_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35914559_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35914559_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35914559> ;
                                                                             gutprop:hasSentenceText "To assess this, we collected fecal samples from adult rats treated with 200 mg/kg TCE over 6 weeks via oral gavage - the dose that produced nigrostriatal neurodegeneration - and analyzed the gut microbiome via whole genome shotgun sequencing." ;
                                                                             rdfs:label "sentence_35914559_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35914559_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35914559_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35914559> ;
                                                                             gutprop:hasSentenceText "Our results showed changes in gut microorganisms reflective of the microbial signatures observed in individuals with idiopathic PD, such as decreased abundance of short-chain fatty acid producing Blautia and elevated lactic-acid producing Bifidobacteria, as well as genera who contain species previously reported as opportunistic pathogens such as Clostridium." ;
                                                                             rdfs:label "sentence_35914559_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35914559_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35914559_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35914559> ;
                                                                             gutprop:hasSentenceText "From these experimental data, we postulate that TCE exposure within contaminated drinking water could induce alterations of the gut microbiome that contributes to chronic disease risk, including idiopathic PD." ;
                                                                             rdfs:label "sentence_35914559_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35965349_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35965349_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/35965349> ;
                                                                             gutprop:hasSentenceText "Systematic profiling of the chicken gut microbiome reveals dietary supplementation with antibiotics alters expression of multiple microbial pathways with minimal impact on community structure." ;
                                                                             rdfs:label "sentence_35965349_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35965349_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35965349_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35965349> ;
                                                                             gutprop:hasSentenceText "The emergence of antimicrobial resistance is a major threat to global health and has placed pressure on the livestock industry to eliminate the use of antibiotic growth promotants (AGPs) as feed additives." ;
                                                                             rdfs:label "sentence_35965349_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35965349_10
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35965349_10> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35965349> ;
                                                                              gutprop:hasSentenceText "Although AGPs have a limited impact on taxonomic abundances, they do appear to redefine influential taxa that may promote the exclusion of other taxa." ;
                                                                              rdfs:label "sentence_35965349_10" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35965349_11
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35965349_11> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35965349> ;
                                                                              gutprop:hasSentenceText "Microbiome expression profiles further reveal a complex landscape in both the expression and taxonomic representation of multiple pathways including cell wall biogenesis, antimicrobial resistance, and several involved in energy, amino acid, and nucleotide metabolism." ;
                                                                              rdfs:label "sentence_35965349_11" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35965349_12
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35965349_12> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35965349> ;
                                                                              gutprop:hasSentenceText "Many AGP-induced changes in metabolic enzyme expression likely serve to redirect metabolic flux with the potential to regulate bacterial growth or produce metabolites that impact the host." ;
                                                                              rdfs:label "sentence_35965349_12" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35965349_13
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35965349_13> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35965349> ;
                                                                              gutprop:hasSentenceText "As alternative feed additives are developed to mimic the action of AGPs, our study highlights the need to ensure such alternatives result in functional changes that are consistent with site-, age-, and diet-associated taxa." ;
                                                                              rdfs:label "sentence_35965349_13" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35965349_14
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35965349_14> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35965349> ;
                                                                              gutprop:hasSentenceText "The genes and pathways identified in this study are therefore expected to drive future studies, applying tools such as community-based metabolic modeling, focusing on the mechanistic impact of different dietary regimes on the microbiome." ;
                                                                              rdfs:label "sentence_35965349_14" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35965349_15
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35965349_15> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35965349> ;
                                                                              gutprop:hasSentenceText "Consequently, the data generated in this study will be crucial for the development of next-generation feed additives targeting gut health and poultry production." ;
                                                                              rdfs:label "sentence_35965349_15" .


