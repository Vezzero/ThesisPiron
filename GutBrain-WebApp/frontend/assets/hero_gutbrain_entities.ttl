###  http://purl.obolibrary.org/obo/NCIT_C84442
<http://purl.obolibrary.org/obo/NCIT_C84442> rdf:type owl:NamedIndividual ,
                                                      skos:Concept ,
                                                      <https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding> ;
                                             skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/DiseaseDisorderOrFinding> ;
                                             gutprop:affect <http://purl.obolibrary.org/obo/NCIT_C124639> ;
                                             gutprop:containedIn <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/e60d6f26617c4a02> ,
                                                                 <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/03f046369462bb8f> ,
                                                                 <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/695cd23d95a04afe> ;
                                             rdfs:comment "A combination of medical conditions that when present, increase the risk of heart attack, stroke, and diabetes mellitus. It includes the following medical conditions: increased blood pressure, central obesity, dyslipidemia, impaired glucose tolerance, and insulin resistance. [Definition Source: NCIT]" ,
                                                          "NCIT Match" ;
                                             rdfs:label "Metabolic Syndrome" .


###  http://purl.obolibrary.org/obo/NCIT_C84444
<http://purl.obolibrary.org/obo/NCIT_C84444> rdf:type owl:NamedIndividual ,
                                                      skos:Concept ,
                                                      <https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding> ;
