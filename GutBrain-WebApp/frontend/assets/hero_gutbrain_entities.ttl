###  http://purl.obolibrary.org/obo/NCIT_C4828
<http://purl.obolibrary.org/obo/NCIT_C4828> rdf:type owl:NamedIndividual ,
                                                     skos:Concept ,
                                                     <https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding> ;
