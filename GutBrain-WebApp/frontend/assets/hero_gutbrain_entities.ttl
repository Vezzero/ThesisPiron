                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36191806> ;
                                                                             gutprop:hasSentenceText "SDV blocked depression-like behaviors and reduced expression of synaptic proteins in the medial prefrontal cortex (mPFC) of Chrna7 KO mice." ;
                                                                             rdfs:label "sentence_36191806_4" .


