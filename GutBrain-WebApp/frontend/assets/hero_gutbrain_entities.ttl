###  http://purl.obolibrary.org/obo/NCIT_C50625
<http://purl.obolibrary.org/obo/NCIT_C50625> rdf:type owl:NamedIndividual ,
                                                      skos:Concept ,
                                                      <https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding> ;
