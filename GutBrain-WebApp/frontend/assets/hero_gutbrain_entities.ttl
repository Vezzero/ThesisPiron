                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36191806> ;
                                                                             gutprop:hasSentenceText "We previously reported that Chrna7 knock-out (KO) mice show depression-like behaviors through abnormal composition of gut microbiota and systemic inflammation." ;
                                                                             rdfs:label "sentence_36191806_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36191806_3
