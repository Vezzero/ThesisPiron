                                             rdfs:label "Jejunum" .


###  http://purl.obolibrary.org/obo/NCIT_C12390
<http://purl.obolibrary.org/obo/NCIT_C12390> rdf:type owl:NamedIndividual ,
                                                      skos:Concept ,
                                                      <https://w3id.org/brainteaser/ontology/schema/AnatomicalSite> ;
