###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36216056_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36216056_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/36216056> ;
                                                                             gutprop:hasSentenceText "Effects of urban particulate matter on gut microbiome and partial schizophrenia-like symptoms in mice: Evidence from shotgun metagenomic and metabolomic profiling." ;
                                                                             rdfs:label "sentence_36216056_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36216056_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36216056_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36216056> ;
                                                                             gutprop:hasSentenceText "Epidemiological evidence reported that particulate matter (PM) was associated with increased schizophrenia (SCZ) risk." ;
                                                                             rdfs:label "sentence_36216056_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36216056_10
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36216056_10> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36216056> ;
                                                                              gutprop:hasSentenceText "The metabolism pathways of estrogen signaling (estriol, 16-glucuronide-estriol and 21-desoxycortisol) and choline metabolism (phosphocholine) were significantly altered by PM exposure." ;
                                                                              rdfs:label "sentence_36216056_10" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36216056_11
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36216056_11> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36216056> ;
                                                                              gutprop:hasSentenceText "Verrucomicrobia was negatively correlated with the level of estriol, which was correlated with decreased learning and spatial memory." ;
                                                                              rdfs:label "sentence_36216056_11" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36216056_12
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36216056_12> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36216056> ;
                                                                              gutprop:hasSentenceText "Fibrobacteres and Deinococcus-Thermus were positively correlated with the level of phosphocholine, which was correlated with increased spontaneous activity, excitability and anxiety." ;
                                                                              rdfs:label "sentence_36216056_12" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36216056_13
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36216056_13> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36216056> ;
                                                                              gutprop:hasSentenceText "Fecal microbiome transplantation from PM group mice reproduced excitability and anxiety symptoms." ;
                                                                              rdfs:label "sentence_36216056_13" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36216056_14
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36216056_14> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36216056> ;
                                                                              gutprop:hasSentenceText "Exposure to PM may affect composition of gut microbiome and alterations of estrogen signaling pathway and choline metabolism pathway, which were associated with partial SCZ-like behaviors." ;
                                                                              rdfs:label "sentence_36216056_14" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36216056_15
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36216056_15> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36216056> ;
                                                                              gutprop:hasSentenceText "But whether gut microbiome regulates these metabolic pathways and behaviors remains to be determined." ;
                                                                              rdfs:label "sentence_36216056_15" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36216056_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36216056_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36216056> ;
                                                                             gutprop:hasSentenceText "Disturbance of gut microbiome was involved in SCZ." ;
                                                                             rdfs:label "sentence_36216056_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36216056_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36216056_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36216056> ;
                                                                             gutprop:hasSentenceText "However, it remains unclear whether PM induces SCZ-like symptoms and how gut microbiome regulates them." ;
                                                                             rdfs:label "sentence_36216056_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36216056_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36216056_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36216056> ;
                                                                             gutprop:hasSentenceText "Therefore, a multi-omics animal experiment was conducted to verify how urban PM induces SCZ-like behavior and altered gut microbiota and metabolic pathways." ;
                                                                             rdfs:label "sentence_36216056_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36216056_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36216056_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36216056> ;
                                                                             gutprop:hasSentenceText "Using a completely random design, mice were divided into three groups: PM group, control group and MK801 group, which received daily tracheal instillation of PM solution, sterile PBS solution and intraperitoneal injection of MK801 (establish SCZ model), respectively." ;
                                                                             rdfs:label "sentence_36216056_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36216056_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36216056_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36216056> ;
                                                                             gutprop:hasSentenceText "After a 14-day intervention, feces were collected for multi-omics testing (shotgun metagenomic sequencing and untargeted metabolomic profiling), followed by open field test, tail suspension test, and passive avoidance test." ;
                                                                             rdfs:label "sentence_36216056_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36216056_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36216056_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36216056> ;
                                                                             gutprop:hasSentenceText "Besides, fecal microbiome of PM group and control group were transplanted into \"pseudo-sterile\" mice, then behavioral tests were conducted." ;
                                                                             rdfs:label "sentence_36216056_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36216056_8
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36216056_8> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36216056> ;
                                                                             gutprop:hasSentenceText "Similar to MK801 group, mice in PM group showed SCZ-like symptoms, including increased spontaneous activity, excitability, anxiety and decreased learning and spatial memory." ;
                                                                             rdfs:label "sentence_36216056_8" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36216056_9
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36216056_9> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36216056> ;
                                                                             gutprop:hasSentenceText "PM exposure significantly increased the relative abundance of Verrucomicrobia and decreased that of Fibrobacteres et al." ;
                                                                             rdfs:label "sentence_36216056_9" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36332796_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36332796_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/36332796> ;
                                                                             gutprop:hasSentenceText "Gut microbiome and Parkinson's disease: Perspective on pathogenesis and treatment." ;
                                                                             rdfs:label "sentence_36332796_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36332796_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36332796_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36332796> ;
                                                                             gutprop:hasSentenceText "Parkinson's disease (PD) is a disease of ⍺-synuclein aggregation-mediated dopaminergic neuronal loss in the substantia nigra pars compacta, which leads to motor and non-motor symptoms." ;
                                                                             rdfs:label "sentence_36332796_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36332796_10
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36332796_10> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36332796> ;
                                                                              gutprop:hasSentenceText "Key Scientific Concepts of Review: Alterations in the gut microbiome and associated metabolites may contribute to pathogenesis in PD." ;
                                                                              rdfs:label "sentence_36332796_10" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36332796_11
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36332796_11> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36332796> ;
                                                                              gutprop:hasSentenceText "In some studies, probiotics have been shown to exert anti-oxidative effects in PD via improved mitochondrial dynamics and homeostasis, thus reducing PD-related consequences." ;
                                                                              rdfs:label "sentence_36332796_11" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36332796_12
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36332796_12> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36332796> ;
                                                                              gutprop:hasSentenceText "However, there is a significant unmet need for randomized clinical trials to investigate the effectiveness of microbial products, probiotic-based supplementation, and dietary intervention in reversing gut microbial dysbiosis in PD." ;
                                                                              rdfs:label "sentence_36332796_12" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36332796_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36332796_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36332796> ;
                                                                             gutprop:hasSentenceText "Through the last two decades of research, there has been growing consensus that inflammation-mediated oxidative stress, mitochondrial dysfunction, and cytokine-induced toxicity are mainly involved in neuronal damage and loss associated with PD." ;
                                                                             rdfs:label "sentence_36332796_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36332796_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36332796_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36332796> ;
                                                                             gutprop:hasSentenceText "However, it remains unclear how these mechanisms relate to sporadic PD, a more common form of PD." ;
                                                                             rdfs:label "sentence_36332796_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36332796_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36332796_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36332796> ;
                                                                             gutprop:hasSentenceText "Both enteric and central nervous systems have been implicated in the pathogenesis of sporadic PD, thus highlighting the crosstalk between the gut and brain." ;
                                                                             rdfs:label "sentence_36332796_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36332796_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36332796_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36332796> ;
                                                                             gutprop:hasSentenceText "of Review: In this review, we summarize how alterations in the gut microbiome can affect PD pathogenesis." ;
                                                                             rdfs:label "sentence_36332796_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36332796_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36332796_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36332796> ;
                                                                             gutprop:hasSentenceText "We highlight various mechanisms increasing/decreasing the risk of PD development." ;
                                                                             rdfs:label "sentence_36332796_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36332796_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36332796_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36332796> ;
                                                                             gutprop:hasSentenceText "Based on the previous supporting evidence, we suggest how early interventions could protect against PD development and how controlling specific factors, including our diet, could modify our perspective on disease mechanisms and therapeutics." ;
                                                                             rdfs:label "sentence_36332796_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36332796_8
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36332796_8> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36332796> ;
                                                                             gutprop:hasSentenceText "We explain the strong relationship between the gut microbiota and the brain in PD subjects, by delineating the multiple mechanisms involved inneuroinflammation and oxidative stress." ;
                                                                             rdfs:label "sentence_36332796_8" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36332796_9
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36332796_9> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36332796> ;
                                                                             gutprop:hasSentenceText "We conclude that the neurodetrimental effects of western diet (WD) and the neuroprotective effects of Mediterranean diets should be further exploredin humans through clinical trials." ;
                                                                             rdfs:label "sentence_36332796_9" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36346385_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36346385_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/36346385> ;
                                                                             gutprop:hasSentenceText "A prebiotic diet modulates microglial states and motor deficits in α-synuclein overexpressing mice." ;
                                                                             rdfs:label "sentence_36346385_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36346385_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36346385_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36346385> ;
                                                                             gutprop:hasSentenceText "Parkinson's disease (PD) is a movement disorder characterized by neuroinflammation, α-synuclein pathology, and neurodegeneration." ;
                                                                             rdfs:label "sentence_36346385_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36346385_10
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36346385_10> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36346385> ;
                                                                              gutprop:hasSentenceText "However, prebiotic feeding reverses pathogenic microglial states in ASO mice and promotes expansion of protective disease-associated macrophage (DAM) subsets of microglia." ;
                                                                              rdfs:label "sentence_36346385_10" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36346385_11
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36346385_11> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36346385> ;
                                                                              gutprop:hasSentenceText "Notably, depletion of microglia using a CSF1R inhibitor eliminates the beneficial effects of prebiotics by restoring motor deficits to ASO mice despite feeding a prebiotic diet." ;
                                                                              rdfs:label "sentence_36346385_11" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36346385_12
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36346385_12> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36346385> ;
                                                                              gutprop:hasSentenceText "These studies uncover a novel microglia-dependent interaction between diet and motor symptoms in mice, findings that may have implications for neuroinflammation and PD." ;
                                                                              rdfs:label "sentence_36346385_12" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36346385_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36346385_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36346385> ;
                                                                             gutprop:hasSentenceText "Most cases of PD are non-hereditary, suggesting a strong role for environmental factors, and it has been speculated that disease may originate in peripheral tissues such as the gastrointestinal (GI) tract before affecting the brain." ;
                                                                             rdfs:label "sentence_36346385_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36346385_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36346385_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36346385> ;
                                                                             gutprop:hasSentenceText "The gut microbiome is altered in PD and may impact motor and GI symptoms as indicated by animal studies, although mechanisms of gut-brain interactions remain incompletely defined." ;
                                                                             rdfs:label "sentence_36346385_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36346385_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36346385_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36346385> ;
                                                                             gutprop:hasSentenceText "Intestinal bacteria ferment dietary fibers into short-chain fatty acids, with fecal levels of these molecules differing between PD and healthy controls and in mouse models." ;
                                                                             rdfs:label "sentence_36346385_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36346385_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36346385_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36346385> ;
                                                                             gutprop:hasSentenceText "Among other effects, dietary microbial metabolites can modulate activation of microglia, brain-resident immune cells implicated in PD." ;
                                                                             rdfs:label "sentence_36346385_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36346385_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36346385_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36346385> ;
                                                                             gutprop:hasSentenceText "We therefore investigated whether a fiber-rich diet influences microglial function in α-synuclein overexpressing (ASO) mice, a preclinical model with PD-like symptoms and pathology." ;
                                                                             rdfs:label "sentence_36346385_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36346385_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36346385_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36346385> ;
                                                                             gutprop:hasSentenceText "Feeding a prebiotic high-fiber diet attenuates motor deficits and reduces α-synuclein aggregation in the substantia nigra of mice." ;
                                                                             rdfs:label "sentence_36346385_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36346385_8
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36346385_8> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36346385> ;
                                                                             gutprop:hasSentenceText "Concomitantly, the gut microbiome of ASO mice adopts a profile correlated with health upon prebiotic treatment, which also reduces microglial activation." ;
                                                                             rdfs:label "sentence_36346385_8" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36346385_9
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36346385_9> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36346385> ;
                                                                             gutprop:hasSentenceText "Single-cell RNA-seq analysis of microglia from the substantia nigra and striatum uncovers increased pro-inflammatory signaling and reduced homeostatic responses in ASO mice compared to wild-type counterparts on standard diets." ;
                                                                             rdfs:label "sentence_36346385_9" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36411639_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36411639_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/36411639> ;
                                                                             gutprop:hasSentenceText "Deciphering the gut microbiome in neurodegenerative diseases and metagenomic approaches for characterization of gut microbes." ;
                                                                             rdfs:label "sentence_36411639_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36411639_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36411639_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36411639> ;
                                                                             gutprop:hasSentenceText "The central nervous system has essential role in the regulation of the physiological condition of the human body." ;
                                                                             rdfs:label "sentence_36411639_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36411639_10
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36411639_10> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36411639> ;
                                                                              gutprop:hasSentenceText "This study is also focused on major metagenomic approaches and their role in gut microbes characterization." ;
                                                                              rdfs:label "sentence_36411639_10" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36411639_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36411639_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36411639> ;
                                                                             gutprop:hasSentenceText "Gut microbes cause several types of gastrointestinal diseases like ulcer stomach and intestine and irritable bowel syndrome." ;
                                                                             rdfs:label "sentence_36411639_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36411639_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36411639_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36411639> ;
                                                                             gutprop:hasSentenceText "Microbes present in the human gut can affect brain function by the release of neuroactive metabolites such as neurotransmitters, hormones, and other compounds." ;
                                                                             rdfs:label "sentence_36411639_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36411639_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36411639_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36411639> ;
                                                                             gutprop:hasSentenceText "Gut microbial-derived metabolites also have an important role in neurological diseases such as Alzheimer's disease, Parkinson's disease, etc." ;
                                                                             rdfs:label "sentence_36411639_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36411639_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36411639_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36411639> ;
                                                                             gutprop:hasSentenceText "Vital communication between the gut microbes and the central nervous system is known as the microbiota-gut-brain axis." ;
                                                                             rdfs:label "sentence_36411639_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36411639_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36411639_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36411639> ;
                                                                             gutprop:hasSentenceText "It provides a communication pathway between the gut and brain which is made up of the vagus nerve, immune system components, and neuroendocrine." ;
                                                                             rdfs:label "sentence_36411639_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36411639_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36411639_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36411639> ;
                                                                             gutprop:hasSentenceText "Disturbance in gut microbiota composition can alter the central nervous system and enteric nervous system functions." ;
                                                                             rdfs:label "sentence_36411639_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36411639_8
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36411639_8> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36411639> ;
                                                                             gutprop:hasSentenceText "Metagenomics has been employed for the identification, and characterization of gut microbes and microbial-derived metabolites." ;
                                                                             rdfs:label "sentence_36411639_8" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36411639_9
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36411639_9> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36411639> ;
                                                                             gutprop:hasSentenceText "This review is focused on the gut microbes-brain relationship and the role of gut microbes in neurodegenerative diseases." ;
                                                                             rdfs:label "sentence_36411639_9" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36462169_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36462169_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/36462169> ;
                                                                             gutprop:hasSentenceText "Elevated Systemic Levels of Markers Reflecting Intestinal Barrier Dysfunction and Inflammasome Activation Are Correlated in Severe Mental Illness." ;
                                                                             rdfs:label "sentence_36462169_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36462169_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36462169_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36462169> ;
                                                                             gutprop:hasSentenceText "Gut microbiota alterations have been reported in severe mental illness (SMI) but fewer studies have probed for signs of gut barrier disruption and inflammation." ;
                                                                             rdfs:label "sentence_36462169_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36462169_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36462169_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36462169> ;
                                                                             gutprop:hasSentenceText "We hypothesized that gut leakage of microbial products due to intestinal inflammation could contribute to systemic inflammasome activation in SMI." ;
                                                                             rdfs:label "sentence_36462169_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36462169_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36462169_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36462169> ;
                                                                             gutprop:hasSentenceText "We measured plasma levels of the chemokine CCL25 and soluble mucosal vascular addressin cell adhesion molecule-1 (sMAdCAM-1) as markers of T cell homing, adhesion and inflammation in the gut, lipopolysaccharide binding protein (LBP) and intestinal fatty acid binding protein (I-FABP) as markers of bacterial translocation and gut barrier dysfunction, in a large SMI cohort (n = 567) including schizophrenia (SCZ, n = 389) and affective disorder (AFF, n = 178), relative to healthy controls (HC, n = 418)." ;
                                                                             rdfs:label "sentence_36462169_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36462169_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36462169_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36462169> ;
                                                                             gutprop:hasSentenceText "We assessed associations with plasma IL-18 and IL-18BPa and leukocyte mRNA expression of NLRP3 and NLRC4 as markers of inflammasome activation." ;
                                                                             rdfs:label "sentence_36462169_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36462169_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36462169_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36462169> ;
                                                                             gutprop:hasSentenceText "Our main findings were: (1) higher levels of sMAdCAM-1 (P = .002), I-FABP (P = 7.6E-11), CCL25 (P = 9.6E-05) and LBP (P = 2.6E-04) in SMI compared to HC in age, sex, BMI, CRP and freezer storage time adjusted analysis; (2) the highest levels of sMAdCAM-1 and CCL25 (both P = 2.6E-04) were observed in SCZ and I-FABP (P = 2.5E-10) and LBP (3) in AFF; and (3), I-FABP correlated with IL-18BPa levels and LBP correlated with NLRC4." ;
                                                                             rdfs:label "sentence_36462169_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36462169_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36462169_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36462169> ;
                                                                             gutprop:hasSentenceText "Our findings support that intestinal barrier inflammation and dysfunction in SMI could contribute to systemic inflammation through inflammasome activation." ;
                                                                             rdfs:label "sentence_36462169_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36493975_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36493975_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/36493975> ;
                                                                             gutprop:hasSentenceText "Key role of the gut-microbiota-brain axis via the subdiaphragmatic vagus nerve in demyelination of the cuprizone-treated mouse brain." ;
                                                                             rdfs:label "sentence_36493975_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36493975_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36493975_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36493975> ;
                                                                             gutprop:hasSentenceText "Multiple sclerosis (MS) is the most common demyelinating disease that attacks the central nervous system." ;
                                                                             rdfs:label "sentence_36493975_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36493975_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36493975_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36493975> ;
                                                                             gutprop:hasSentenceText "Dietary intake of cuprizone (CPZ) produces demyelination resembling that of patients with MS." ;
                                                                             rdfs:label "sentence_36493975_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36493975_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36493975_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36493975> ;
                                                                             gutprop:hasSentenceText "Given the role of the vagus nerve in gut-microbiota-brain axis in development of MS, we performed this study to investigate whether subdiaphragmatic vagotomy (SDV) affects demyelination in CPZ-treated mice." ;
                                                                             rdfs:label "sentence_36493975_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36493975_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36493975_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36493975> ;
                                                                             gutprop:hasSentenceText "SDV significantly ameliorated demyelination and microglial activation in the brain compared with sham-operated CPZ-treated mice." ;
                                                                             rdfs:label "sentence_36493975_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36493975_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36493975_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36493975> ;
                                                                             gutprop:hasSentenceText "Furthermore, 16S ribosomal RNA analysis revealed that SDV significantly improved the abnormal gut microbiota composition of CPZ-treated mice." ;
                                                                             rdfs:label "sentence_36493975_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36493975_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36493975_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36493975> ;
                                                                             gutprop:hasSentenceText "An untargeted metabolomic analysis demonstrated that SDV significantly improved abnormal blood levels of metabolites in CPZ-treated mice compared with sham-operated CPZ-treated mice." ;
                                                                             rdfs:label "sentence_36493975_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36493975_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36493975_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36493975> ;
                                                                             gutprop:hasSentenceText "Notably, there were correlations between demyelination or microglial activation in the brain and the relative abundance of several microbiome populations, suggesting a link between gut microbiota and the brain." ;
                                                                             rdfs:label "sentence_36493975_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36493975_8
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36493975_8> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36493975> ;
                                                                             gutprop:hasSentenceText "There were also correlations between demyelination or microglial activation in the brain and blood levels of metabolites." ;
                                                                             rdfs:label "sentence_36493975_8" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36493975_9
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36493975_9> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36493975> ;
                                                                             gutprop:hasSentenceText "Together, these data suggest that CPZ produces demyelination in the brain through the gut-microbiota-brain axis via the subdiaphragmatic vagus nerve." ;
                                                                             rdfs:label "sentence_36493975_9" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36517709_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36517709_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/36517709> ;
                                                                             gutprop:hasSentenceText "Porphyra haitanensis Polysaccharides Attenuates Blood Lipid via Gut-Liver Axis in Diet-Induced High-Fat Mesocricetus auratus through Multiple Integrated Omics." ;
                                                                             rdfs:label "sentence_36517709_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36517709_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36517709_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36517709> ;
                                                                             gutprop:hasSentenceText "Hyperlipidemia is currently a global public health problem severely affecting people's physical and mental health, as well as their quality of life." ;
                                                                             rdfs:label "sentence_36517709_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36517709_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36517709_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36517709> ;
                                                                             gutprop:hasSentenceText "The present study is aimed at revealing the mechanism of Porphyra haitanensis polysaccharide (PHP) in decreasing blood lipids by acting through gut-liver axis in Mesocricetus auratus fed a high-fat diet." ;
                                                                             rdfs:label "sentence_36517709_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36517709_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36517709_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36517709> ;
                                                                             gutprop:hasSentenceText "PHP significantly prevented increases in serum total cholesterol, triglycerides and low-density lipoprotein cholesterol, and alleviated damage to liver cells induced by a high-fat diet M. auratus, in a dose-dependent manner." ;
                                                                             rdfs:label "sentence_36517709_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36517709_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36517709_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36517709> ;
                                                                             gutprop:hasSentenceText "PHP promotes proliferation of Muribaculaceae and Faecalibaculum, thereby enhancing the production of butyric acid both in the colon and liver, particularly high-dose PHP (HPHP)." ;
                                                                             rdfs:label "sentence_36517709_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36517709_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36517709_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36517709> ;
                                                                             gutprop:hasSentenceText "Low-dose PHP (LPHP) promotes the expression of phosphatidylcholine metabolites and fatty acid transport genes, and inhibits the expression of genes involved in fat degradation (Abhd5), adipogenesis (Me1), fatty acid synthesis (Fasn and Pnpla3), and fatty acid chain elongation (Elovl6) in the liver." ;
                                                                             rdfs:label "sentence_36517709_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36517709_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36517709_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36517709> ;
                                                                             gutprop:hasSentenceText "However, HPHP inhibits the expression of triglyceride metabolites and promotes the expression of fatty acid transporter (CD36), fatty acid oxidation (Acacb), and peroxisome proliferator-activated receptor gamma (PPARg) genes in the liver." ;
                                                                             rdfs:label "sentence_36517709_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36517709_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36517709_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36517709> ;
                                                                             gutprop:hasSentenceText "PHP regulates lipid metabolism through the gut microbiota, and the gut-liver axis plays an important role in its hypolipidemic effects." ;
                                                                             rdfs:label "sentence_36517709_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36532064_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36532064_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/36532064> ;
                                                                             gutprop:hasSentenceText "Hypothesis of a potential BrainBiota and its relation to CNS autoimmune inflammation." ;
                                                                             rdfs:label "sentence_36532064_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36532064_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36532064_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36532064> ;
                                                                             gutprop:hasSentenceText "Infectious agents have been long considered to play a role in the pathogenesis of neurological diseases as part of the interaction between genetic susceptibility and the environment." ;
                                                                             rdfs:label "sentence_36532064_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36532064_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36532064_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36532064> ;
                                                                             gutprop:hasSentenceText "The role of bacteria in CNS autoimmunity has also been highlighted by changes in the diversity of gut microbiota in patients with neurological diseases such as Parkinson's disease, Alzheimer disease and multiple sclerosis, emphasizing the role of the gut-brain axis." ;
                                                                             rdfs:label "sentence_36532064_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36532064_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36532064_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36532064> ;
                                                                             gutprop:hasSentenceText "We discuss the hypothesis of a brain microbiota, the BrainBiota: bacteria living in symbiosis with brain cells." ;
                                                                             rdfs:label "sentence_36532064_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36532064_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36532064_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36532064> ;
                                                                             gutprop:hasSentenceText "Existence of various bacteria in the human brain is suggested by morphological evidence, presence of bacterial proteins, metabolites, transcripts and mucosal-associated invariant T cells." ;
                                                                             rdfs:label "sentence_36532064_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36532064_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36532064_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36532064> ;
                                                                             gutprop:hasSentenceText "Based on our data, we discuss the hypothesis that these bacteria are an integral part of brain development and immune tolerance as well as directly linked to the gut microbiome." ;
                                                                             rdfs:label "sentence_36532064_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36532064_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36532064_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36532064> ;
                                                                             gutprop:hasSentenceText "We further suggest that changes of the BrainBiota during brain diseases may be the consequence or cause of the chronic inflammation similarly to the gut microbiota." ;
                                                                             rdfs:label "sentence_36532064_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36550591_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36550591_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/36550591> ;
                                                                             gutprop:hasSentenceText "Antidepression of Xingpijieyu formula targets gut microbiota derived from depressive disorder." ;
                                                                             rdfs:label "sentence_36550591_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36550591_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36550591_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36550591> ;
                                                                             gutprop:hasSentenceText "This investigation aims to determine the antidepressant role of Xingpijieyu formula (XPJYF) mediated via gut microbiota (GM)-brain axis." ;
                                                                             rdfs:label "sentence_36550591_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36550591_10
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36550591_10> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36550591> ;
                                                                              gutprop:hasSentenceText "Microbiota composition during 8 mg/ml of XPJYF (H12-8) for 12 h showed the more consistency." ;
                                                                              rdfs:label "sentence_36550591_10" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36550591_11
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36550591_11> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36550591> ;
                                                                              gutprop:hasSentenceText "Lactococcus is enriched in DD-derived microbiota composition, and Biffdobacterium and Lactobacillus in H12-8 group." ;
                                                                              rdfs:label "sentence_36550591_11" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36550591_12
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36550591_12> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36550591> ;
                                                                              gutprop:hasSentenceText "GLUCOSE1PMETAB-PWY and PWY-7328 of which biofunctions were dominantly encoded by Biffdobacterium were the top two of altered pathways." ;
                                                                              rdfs:label "sentence_36550591_12" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36550591_13
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36550591_13> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36550591> ;
                                                                              gutprop:hasSentenceText "XPJYF improved behaviors and repressed astrocyte activation in depression rats." ;
                                                                              rdfs:label "sentence_36550591_13" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36550591_14
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36550591_14> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36550591> ;
                                                                              gutprop:hasSentenceText "XPJYF elevated 2-DG uptake, ATP, glucose-1-phosphate, and brain-derived neurotrophic factor (BDNF), and inhibited cytokines and oxidative stress in LPS-induced astrocyte." ;
                                                                              rdfs:label "sentence_36550591_14" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36550591_15
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36550591_15> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36550591> ;
                                                                              gutprop:hasSentenceText "XPJYF treatment targets inflammation, activation, and glycometabolim in astrocyte via gut microbiota modulation, thereby improve animal behaviors, HPA axis dysfunction, and neurotransmitter synthesis in depression rats." ;
                                                                              rdfs:label "sentence_36550591_15" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36550591_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36550591_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36550591> ;
                                                                             gutprop:hasSentenceText "We collected fecal microbiota from patients with depressive disorder (DD) and cultured microbiota in vitro." ;
                                                                             rdfs:label "sentence_36550591_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36550591_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36550591_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36550591> ;
                                                                             gutprop:hasSentenceText "Some of microbiota were transplanted into germ-free rats with the intragastric administration of XPJYF grain at the dose of 1.533 g/kg/day." ;
                                                                             rdfs:label "sentence_36550591_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36550591_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36550591_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36550591> ;
                                                                             gutprop:hasSentenceText "The behaviors were studied by forced swimming test, open field test, sucrose preference test, and body weight." ;
                                                                             rdfs:label "sentence_36550591_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36550591_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36550591_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36550591> ;
                                                                             gutprop:hasSentenceText "Products of hypothalamus-pituitary-adrenocortical (HPA) axis, neurotransmitter, and serum cytokines were investigated by enzyme linked immunosorbent assay." ;
                                                                             rdfs:label "sentence_36550591_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36550591_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36550591_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36550591> ;
                                                                             gutprop:hasSentenceText "Glial fibrillary acidic protein (GFAP), a biomarker of astrocyte, was quantified using immunofluorescence." ;
                                                                             rdfs:label "sentence_36550591_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36550591_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36550591_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36550591> ;
                                                                             gutprop:hasSentenceText "Microbiota culturing in vitro after XPJYF treatment was analyze by 16 s RNA sequencing technology." ;
                                                                             rdfs:label "sentence_36550591_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36550591_8
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36550591_8> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36550591> ;
                                                                             gutprop:hasSentenceText "We used lipopolysaccharide (LPS) to mimic activated rat primary astrocyte in vitro." ;
                                                                             rdfs:label "sentence_36550591_8" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36550591_9
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36550591_9> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36550591> ;
                                                                             gutprop:hasSentenceText "Brain-derived neurotrophic factor (BDNF), cytokines, and oxidative stress factors were determined by western blotting, and glycometabolism in astrocyte was investigated by 2-deoxy-D-glucose (2-DG) uptake, adenosine triphosphate (ATP), and glucose-1-phosphate (G1P) kits." ;
                                                                             rdfs:label "sentence_36550591_9" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36564391_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36564391_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/36564391> ;
                                                                             gutprop:hasSentenceText "Inflammatory microbes and genes as potential biomarkers of Parkinson's disease." ;
                                                                             rdfs:label "sentence_36564391_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36564391_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36564391_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36564391> ;
                                                                             gutprop:hasSentenceText "As the second-largest neurodegenerative disease in the world, Parkinson's disease (PD) has brought a severe economic and medical burden to our society." ;
                                                                             rdfs:label "sentence_36564391_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36564391_10
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36564391_10> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36564391> ;
                                                                              gutprop:hasSentenceText "Our results provided further insights into the prediction and treatment of PD based on inflammation." ;
                                                                              rdfs:label "sentence_36564391_10" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36564391_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36564391_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36564391> ;
                                                                             gutprop:hasSentenceText "Growing evidence in recent years suggests that the gut microbiome may influence PD, but the exact pathogenesis of PD remains unclear." ;
                                                                             rdfs:label "sentence_36564391_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36564391_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36564391_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36564391> ;
                                                                             gutprop:hasSentenceText "In addition, the current diagnosis of PD could be inaccurate and expensive." ;
                                                                             rdfs:label "sentence_36564391_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36564391_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36564391_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36564391> ;
                                                                             gutprop:hasSentenceText "In this study, the largest meta-analysis currently of the gut microbiome in PD was analyzed, including 2269 samples by 16S rRNA gene and 236 samples by shotgun metagenomics, aiming to reveal the connection between PD and gut microbiome and establish a model to predict PD." ;
                                                                             rdfs:label "sentence_36564391_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36564391_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36564391_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36564391> ;
                                                                             gutprop:hasSentenceText "The results showed that the relative abundances of potential pro-inflammatory bacteria, genes and pathways were significantly increased in PD, while potential anti-inflammatory bacteria, genes and pathways were significantly decreased." ;
                                                                             rdfs:label "sentence_36564391_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36564391_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36564391_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36564391> ;
                                                                             gutprop:hasSentenceText "These changes may lead to a decrease in potential anti-inflammatory substances (short-chain fatty acids) and an increase in potential pro-inflammatory substances (lipopolysaccharides, hydrogen sulfide and glutamate)." ;
                                                                             rdfs:label "sentence_36564391_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36564391_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36564391_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36564391> ;
                                                                             gutprop:hasSentenceText "Notably, the results of 16S rRNA gene and shotgun metagenomic analysis have consistently identified five decreased genera (Roseburia, Faecalibacterium, Blautia, Lachnospira, and Prevotella) and five increased genera (Streptococcus, Bifidobacterium, Lactobacillus, Akkermansia, and Desulfovibrio) in PD." ;
                                                                             rdfs:label "sentence_36564391_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36564391_8
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36564391_8> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36564391> ;
                                                                             gutprop:hasSentenceText "Furthermore, random forest models performed well for PD prediction based on 11 genera (accuracy > 80%) or 6 genes (accuracy > 90%) related to inflammation." ;
                                                                             rdfs:label "sentence_36564391_8" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36564391_9
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36564391_9> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36564391> ;
                                                                             gutprop:hasSentenceText "Finally, a possible mechanism was presented to explain the pathogenesis of inflammation leading to PD." ;
                                                                             rdfs:label "sentence_36564391_9" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36651663_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36651663_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/36651663> ;
                                                                             gutprop:hasSentenceText "The gut-microbiota-brain axis in a Spanish population in the aftermath of the COVID-19 pandemic: microbiota composition linked to anxiety, trauma, and depression profiles." ;
                                                                             rdfs:label "sentence_36651663_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36651663_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36651663_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36651663> ;
                                                                             gutprop:hasSentenceText "The prevalence of anxiety and depression soared following the COVID-19 pandemic." ;
                                                                             rdfs:label "sentence_36651663_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36651663_10
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36651663_10> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36651663> ;
                                                                              gutprop:hasSentenceText "The relative abundance of <i>Anaerostipes</i> was positively correlated with childhood trauma, and higher levels of <i>Turicibacter sanguinis</i> and lower levels of Lentisphaerae were found in individuals who experienced life-threatening traumas." ;
                                                                              rdfs:label "sentence_36651663_10" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36651663_11
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36651663_11> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36651663> ;
                                                                              gutprop:hasSentenceText "COVID-19 infection and vaccination influenced the overall microbial composition and were associated with distinct relative taxonomic abundance profiles." ;
                                                                              rdfs:label "sentence_36651663_11" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36651663_12
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36651663_12> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36651663> ;
                                                                              gutprop:hasSentenceText "These findings will help lay the foundation for future studies to identify microbial role players in symptoms of anxiety, depression, and PTSD and provide future therapeutic targets to improve mental health outcomes." ;
                                                                              rdfs:label "sentence_36651663_12" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36651663_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36651663_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36651663> ;
                                                                             gutprop:hasSentenceText "To effectively treat these conditions, a comprehensive understanding of all etiological factors is needed." ;
                                                                             rdfs:label "sentence_36651663_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36651663_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36651663_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36651663> ;
                                                                             gutprop:hasSentenceText "This study investigated fecal microbial features associated with mental health outcomes (symptoms of anxiety, depression, or posttraumatic stress disorder (PTSD)) in a Spanish cohort in the aftermath of the COVID-19 pandemic." ;
                                                                             rdfs:label "sentence_36651663_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36651663_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36651663_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36651663> ;
                                                                             gutprop:hasSentenceText "Microbial communities from stool samples were profiled in 198 individuals who completed validated, self-report questionnaires." ;
                                                                             rdfs:label "sentence_36651663_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36651663_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36651663_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36651663> ;
                                                                             gutprop:hasSentenceText "16S ribosomal RNA gene V3-4 amplicon sequencing was performed." ;
                                                                             rdfs:label "sentence_36651663_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36651663_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36651663_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36651663> ;
                                                                             gutprop:hasSentenceText "Microbial diversity and community structure were analyzed, together with relative taxonomic abundance." ;
                                                                             rdfs:label "sentence_36651663_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36651663_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36651663_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36651663> ;
                                                                             gutprop:hasSentenceText "In our cohort of N=198, 17.17% reported depressive symptoms, 37.37% state anxiety symptoms, 40.90% trait anxiety symptoms, and 8.08% PTSD symptoms, with high levels of comorbidity." ;
                                                                             rdfs:label "sentence_36651663_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36651663_8
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36651663_8> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36651663> ;
                                                                             gutprop:hasSentenceText "Individuals with trait anxiety had lower Simpson's diversity." ;
                                                                             rdfs:label "sentence_36651663_8" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36651663_9
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36651663_9> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36651663> ;
                                                                             gutprop:hasSentenceText "<i>Fusicatenibacter saccharivorans</i> was reduced in individuals with comorbid PTSD + depression + state and trait anxiety symptoms, whilst an expansion of Proteobacteria and depletion of Synergistetes phyla were noted in individuals with depressive symptoms." ;
                                                                             rdfs:label "sentence_36651663_9" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36698474_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36698474_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/36698474> ;
                                                                             gutprop:hasSentenceText "The different trends in the burden of neurological and mental disorders following dietary transition in China, the USA, and the world: An extension analysis for the Global Burden of Disease Study 2019." ;
                                                                             rdfs:label "sentence_36698474_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36698474_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36698474_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36698474> ;
                                                                             gutprop:hasSentenceText "The highly processed western diet is substituting the low-processed traditional diet in the last decades globally." ;
                                                                             rdfs:label "sentence_36698474_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36698474_10
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36698474_10> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36698474> ;
                                                                              gutprop:hasSentenceText "Then, following the rise of the ratios of meat to pulses, eggs to pulses, and pork to pulses, the usage of fertilizers, the farming density of pigs, and the burdens of the above disease except diabetes mellitus were also ever-increasing." ;
                                                                              rdfs:label "sentence_36698474_10" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36698474_11
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36698474_11> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36698474> ;
                                                                              gutprop:hasSentenceText "Even the usage of pesticides was positively correlated with the burdens of Parkinson's disease, schizophrenia, cardiovascular diseases, and neoplasms." ;
                                                                              rdfs:label "sentence_36698474_11" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36698474_12
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36698474_12> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36698474> ;
                                                                              gutprop:hasSentenceText "Contrary to China, the corresponding burdens of the USA trended to reduce with the improvements in diet quality and food production sustainability." ;
                                                                              rdfs:label "sentence_36698474_12" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36698474_13
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36698474_13> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36698474> ;
                                                                              gutprop:hasSentenceText "Our results suggest that improving diet quality and food production sustainability might be a promising way to stop the expanding burdens of neurological and mental disorders." ;
                                                                              rdfs:label "sentence_36698474_13" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36698474_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36698474_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36698474> ;
                                                                             gutprop:hasSentenceText "Increasing research found that a diet with poor quality such as western diet disrupts gut microbiota and increases the susceptibility to various neurological and mental disorders, while a balanced diet regulates gut microbiota and prevents and alleviates the neurological and mental disorders." ;
                                                                             rdfs:label "sentence_36698474_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36698474_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36698474_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36698474> ;
                                                                             gutprop:hasSentenceText "Yet, there is limited research on the association between the disease burden expanding of neurological and mental disorders with a dietary transition." ;
                                                                             rdfs:label "sentence_36698474_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36698474_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36698474_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36698474> ;
                                                                             gutprop:hasSentenceText "We compared the disability-adjusted life-years (DALYs) trend by age for neurological and mental disorders in China, in the United States of America (USA), and across the world from 1990 to 2019, evaluated the dietary transition in the past 60 years, and analyzed the association between the burden trend of the two disorders with the changes in diet composition and food production." ;
                                                                             rdfs:label "sentence_36698474_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36698474_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36698474_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36698474> ;
                                                                             gutprop:hasSentenceText "We identified an age-related upward pattern in disease burden in China." ;
                                                                             rdfs:label "sentence_36698474_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36698474_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36698474_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36698474> ;
                                                                             gutprop:hasSentenceText "Compared with the USA and the world, the Chinese neurological and mental disorders DALY percent was least in the generation over 75 but rapidly increased in younger generations and surpassed the USA and/or the world in the last decades." ;
                                                                             rdfs:label "sentence_36698474_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36698474_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36698474_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36698474> ;
                                                                             gutprop:hasSentenceText "The age-related upward pattern in Chinese disease burdens had not only shown in the presence of cardiovascular diseases, neoplasms, and diabetes mellitus but also appeared in the presence of depressive disorders, Parkinson's disease, Alzheimer's disease and other dementias, schizophrenia, headache disorders, anxiety disorders, conduct disorders, autism spectrum disorders, and eating disorders, successively." ;
                                                                             rdfs:label "sentence_36698474_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36698474_8
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36698474_8> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36698474> ;
                                                                             gutprop:hasSentenceText "Additionally, the upward trend was associated with the dramatic dietary transition including a reduction in dietary quality and food production sustainability, during which the younger generation is more affected than the older." ;
                                                                             rdfs:label "sentence_36698474_8" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36698474_9
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36698474_9> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36698474> ;
                                                                             gutprop:hasSentenceText "Following the increase in total calorie intake, alcohol intake, ratios of animal to vegetal foods, and poultry meat to pulses, the burdens of the above diseases continuously rose." ;
                                                                             rdfs:label "sentence_36698474_9" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36699448_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36699448_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/36699448> ;
                                                                             gutprop:hasSentenceText "The host genetics affects gut microbiome diversity in Chinese depressed patients." ;
                                                                             rdfs:label "sentence_36699448_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36699448_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36699448_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36699448> ;
                                                                             gutprop:hasSentenceText "The gut microbiome and host genetics are both associated with major depressive disorder (MDD); however, the molecular mechanisms among the associations are poorly understood, especially in the Asian, Chinese group." ;
                                                                             rdfs:label "sentence_36699448_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36699448_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36699448_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36699448> ;
                                                                             gutprop:hasSentenceText "Our study applied linear discriminant analysis (LDA) effect size (LEfSe) and genome-wide association analysis in the cohort with both gut sequencing data and genomics data." ;
                                                                             rdfs:label "sentence_36699448_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36699448_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36699448_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36699448> ;
                                                                             gutprop:hasSentenceText "We reported the different gut microbiota characteristics between MDD and control groups in the Chinese group and further constructed the association between host genetics and the gut microbiome." ;
                                                                             rdfs:label "sentence_36699448_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36699448_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36699448_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36699448> ;
                                                                             gutprop:hasSentenceText "<i>Actinobacteria</i> and <i>Pseudomonades</i> were found more in the MDD group." ;
                                                                             rdfs:label "sentence_36699448_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36699448_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36699448_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36699448> ;
                                                                             gutprop:hasSentenceText "We found significant differences in the ACE and Chao indexes of alpha diversity while no discrepancy in beta diversity." ;
                                                                             rdfs:label "sentence_36699448_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36699448_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36699448_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36699448> ;
                                                                             gutprop:hasSentenceText "We found three associations between host genetics with microbiome features: beta diversity and rs6108 (<i>p</i> = 8.65 × 10<sup>-9</sup>), <i>Actinobacteria</i> and rs77379751 (<i>p</i> = 8.56 × 10<sup>-9</sup>), and PWY-5913 and rs1775633082 (<i>p</i> = 4.54 × 10<sup>-8</sup>)." ;
                                                                             rdfs:label "sentence_36699448_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36699448_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36699448_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36699448> ;
                                                                             gutprop:hasSentenceText "A species of the <i>Romboutsia</i> genus was co-associated with the species of <i>Ruminococcus gnavus</i> in an internetwork through four genes: <i>METTL8</i>, <i>ITGB2</i>, <i>OTULIN</i>, and <i>PROSER3</i>, with a strict threshold (<i>p</i> < 5 × 10<sup>-4</sup>)." ;
                                                                             rdfs:label "sentence_36699448_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36699448_8
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36699448_8> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36699448> ;
                                                                             gutprop:hasSentenceText "Furthermore, our findings suggested that the gut microbiome diversity might affect microRNA expression in the brain and influenced <i>SERPINA5</i> and other spatially close genes afterward." ;
                                                                             rdfs:label "sentence_36699448_8" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36699448_9
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36699448_9> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36699448> ;
                                                                             gutprop:hasSentenceText "These findings suggest new linkages between depression and gut microbiome in Asian, Chinese people, which might be mediated by genes and microRNA regulation in space distance." ;
                                                                             rdfs:label "sentence_36699448_9" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36707651_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36707651_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/36707651> ;
                                                                             gutprop:hasSentenceText "Microbiota-gut-brain axis mechanisms in the complex network of bipolar disorders: potential clinical implications and translational opportunities." ;
                                                                             rdfs:label "sentence_36707651_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36707651_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36707651_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36707651> ;
                                                                             gutprop:hasSentenceText "Bipolar disorders (BD) represent a severe leading disabling mental condition worldwide characterized by episodic and often progressive mood fluctuations with manic and depressive stages." ;
                                                                             rdfs:label "sentence_36707651_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36707651_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36707651_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36707651> ;
                                                                             gutprop:hasSentenceText "The biological mechanisms underlying the pathophysiology of BD remain incompletely understood, but it seems that there is a complex picture of genetic and environmental factors implicated." ;
                                                                             rdfs:label "sentence_36707651_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36707651_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36707651_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36707651> ;
                                                                             gutprop:hasSentenceText "Nowadays, gut microbiota is in the spotlight of new research related to this kind of psychiatric disorder, as it can be consistently related to several pathophysiological events observed in BD." ;
                                                                             rdfs:label "sentence_36707651_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36707651_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36707651_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36707651> ;
                                                                             gutprop:hasSentenceText "In the context of the so-called microbiota-gut-brain (MGB) axis, it is shown to have a strong influence on host neuromodulation and endocrine functions (i.e., controlling the synthesis of neurotransmitters like serotonin or mediating the activation of the hypothalamic-pituitary-adrenal axis), as well as in modulation of host immune responses, critically regulating intestinal, systemic and brain inflammation (neuroinflammation)." ;
                                                                             rdfs:label "sentence_36707651_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36707651_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36707651_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36707651> ;
                                                                             gutprop:hasSentenceText "The present review aims to elucidate pathophysiological mechanisms derived from the MGB axis disruption and possible therapeutic approaches mainly focusing on gut microbiota in the complex network of BD." ;
                                                                             rdfs:label "sentence_36707651_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36707651_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36707651_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36707651> ;
                                                                             gutprop:hasSentenceText "Understanding the mechanisms of gut microbiota and its bidirectional communication with the immune and other systems can shed light on the discovery of new therapies for improving the clinical management of these patients." ;
                                                                             rdfs:label "sentence_36707651_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36707651_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36707651_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36707651> ;
                                                                             gutprop:hasSentenceText "Besides, the effect of psychiatric drugs on gut microbiota currently used in BD patients, together with new therapeutical approaches targeting this ecosystem (dietary patterns, probiotics, prebiotics, and other novelties) will also be contemplated." ;
                                                                             rdfs:label "sentence_36707651_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36738999_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36738999_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/36738999> ;
                                                                             gutprop:hasSentenceText "High-cholesterol diet promotes depression- and anxiety-like behaviors in mice by impact gut microbe and neuroinflammation." ;
                                                                             rdfs:label "sentence_36738999_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36738999_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36738999_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36738999> ;
                                                                             gutprop:hasSentenceText "Neuropsychiatric disorders, including anxiety and depression, are one of the most common mental illnesses worldwide." ;
                                                                             rdfs:label "sentence_36738999_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36738999_10
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36738999_10> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36738999> ;
                                                                              gutprop:hasSentenceText "HCD consumption resulted in significantly increased body weight, liver fat (LDL-C, TC, TG), peripheral inflammation (IL-1β, MCP-1, IL-17A) and neuroinflammation (MCP-1)." ;
                                                                              rdfs:label "sentence_36738999_10" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36738999_11
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36738999_11> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36738999> ;
                                                                              gutprop:hasSentenceText "The concentration of 5-HT increased in the hippocampus, meanwhile, the expression of 5-HT receptor HTR2A was distinct in different regions of the brain tissue." ;
                                                                              rdfs:label "sentence_36738999_11" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36738999_12
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36738999_12> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36738999> ;
                                                                              gutprop:hasSentenceText "More importantly, we found that compared with the CON diet, HCD induced the decrease of intestinal flora diversity, especially the decrease the relative abundance of Akkermansia_muciniphila, which was statistically significant." ;
                                                                              rdfs:label "sentence_36738999_12" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36738999_13
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36738999_13> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36738999> ;
                                                                              gutprop:hasSentenceText "Further, Pearson correlation analysis showed that Akkermansia_muciniphila was significantly negatively correlated with the concentration of MCP-1, IL-17A in serum and 5-HT in hippocampus." ;
                                                                              rdfs:label "sentence_36738999_13" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36738999_14
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36738999_14> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36738999> ;
                                                                              gutprop:hasSentenceText "Therefore, we speculated that the disorder of neuroinflammation induced by HCD consumption promotes depression- and anxiety-like behaviors in mice through the gut microbe." ;
                                                                              rdfs:label "sentence_36738999_14" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36738999_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36738999_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36738999> ;
                                                                             gutprop:hasSentenceText "A growing body of evidence shows that there is a complex relationship between dietary patterns and mental health." ;
                                                                             rdfs:label "sentence_36738999_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36738999_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36738999_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36738999> ;
                                                                             gutprop:hasSentenceText "In our study, C57BL/6J mice were divided into three groups: control diet group (CON, 10 % kcal fat), high-cholesterol diet model group (HCD, 42.0 % kcal fat + 1.25 % kcal Cholesterol), and chronic restraint stress group (CRS, 10 % kcal fat) which as a positive control group for the depression model." ;
                                                                             rdfs:label "sentence_36738999_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36738999_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36738999_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36738999> ;
                                                                             gutprop:hasSentenceText "Six weeks later, depressive- and anxiety-like behavior were evaluated for using the OFT, SPT and TST." ;
                                                                             rdfs:label "sentence_36738999_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36738999_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36738999_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36738999> ;
                                                                             gutprop:hasSentenceText "Glucose intolerance and liver fat were detected by IGTT and liver lipid kit." ;
                                                                             rdfs:label "sentence_36738999_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36738999_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36738999_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36738999> ;
                                                                             gutprop:hasSentenceText "The expression of peripheral and central inflammation was detected by LEGEND plex kits." ;
                                                                             rdfs:label "sentence_36738999_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36738999_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36738999_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36738999> ;
                                                                             gutprop:hasSentenceText "5-HT (also named 5-hydroxytryptamine, 5-HT) and related receptors expression were monitored by ELISA, RT-PCR and Western blot." ;
                                                                             rdfs:label "sentence_36738999_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36738999_8
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36738999_8> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36738999> ;
                                                                             gutprop:hasSentenceText "Meantime, gut microbe of stool samples was performed by 16S rRNA gene sequencing." ;
                                                                             rdfs:label "sentence_36738999_8" .


