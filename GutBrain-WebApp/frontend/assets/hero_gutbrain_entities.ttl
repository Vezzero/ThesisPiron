###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35965349_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35965349_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35965349> ;
                                                                             gutprop:hasSentenceText "To mitigate their removal, efficacious alternatives are required." ;
                                                                             rdfs:label "sentence_35965349_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35965349_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35965349_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35965349> ;
                                                                             gutprop:hasSentenceText "AGPs are thought to operate through modulating the gut microbiome to limit opportunities for colonization by pathogens, increase nutrient utilization, and reduce inflammation." ;
                                                                             rdfs:label "sentence_35965349_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35965349_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35965349_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35965349> ;
                                                                             gutprop:hasSentenceText "However, little is known concerning the underlying mechanisms." ;
                                                                             rdfs:label "sentence_35965349_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35965349_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35965349_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35965349> ;
                                                                             gutprop:hasSentenceText "Previous studies investigating the effects of AGPs on the poultry gut microbiome have largely focused on 16S rDNA surveys based on a single gastrointestinal (GI) site, diet, and/or timepoint, resulting in an inconsistent view of their impact on community composition." ;
                                                                             rdfs:label "sentence_35965349_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35965349_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35965349_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35965349> ;
                                                                             gutprop:hasSentenceText "In this study, we perform a systematic investigation of both the composition and function of the chicken gut microbiome, in response to AGPs." ;
                                                                             rdfs:label "sentence_35965349_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35965349_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35965349_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35965349> ;
                                                                             gutprop:hasSentenceText "Birds were raised under two different diets and AGP treatments, and 16S rDNA surveys applied to six GI sites sampled at three key timepoints of the poultry life cycle." ;
                                                                             rdfs:label "sentence_35965349_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35965349_8
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35965349_8> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35965349> ;
                                                                             gutprop:hasSentenceText "Functional investigations were performed through metatranscriptomics analyses and metabolomics." ;
                                                                             rdfs:label "sentence_35965349_8" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35965349_9
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35965349_9> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35965349> ;
                                                                             gutprop:hasSentenceText "Our study reveals a more nuanced view of the impact of AGPs, dependent on age of bird, diet, and intestinal site sampled." ;
                                                                             rdfs:label "sentence_35965349_9" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36056574_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36056574_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/36056574> ;
                                                                             gutprop:hasSentenceText "A Pilot Study of the Gut Microbiota Associated With Depressive Symptoms and Sleep Disturbance Among Chinese and Korean Immigrants in the United States." ;
                                                                             rdfs:label "sentence_36056574_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36056574_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36056574_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36056574> ;
                                                                             gutprop:hasSentenceText "Depression is prevalent among Asian Americans (AsA) during the COVID-19 pandemic, and depression often leads to sleep disturbance in this population." ;
                                                                             rdfs:label "sentence_36056574_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36056574_10
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36056574_10> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36056574> ;
                                                                              gutprop:hasSentenceText "Those with depressive symptoms showed a higher abundance of <i>Actinobacteria,</i> while those without depressive symptoms had a higher abundance of <i>Bacteroidetes</i>." ;
                                                                              rdfs:label "sentence_36056574_10" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36056574_11
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36056574_11> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36056574> ;
                                                                              gutprop:hasSentenceText "No significant taxa were identified for sleep disturbance." ;
                                                                              rdfs:label "sentence_36056574_11" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36056574_12
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36056574_12> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36056574> ;
                                                                              gutprop:hasSentenceText "Gut microbial diversity showed promising associations with depressive symptoms and sleep disturbance among Chinese and Korean immigrants." ;
                                                                              rdfs:label "sentence_36056574_12" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36056574_13
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36056574_13> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36056574> ;
                                                                              gutprop:hasSentenceText "Specific taxa were identified as associated with depressive symptoms." ;
                                                                              rdfs:label "sentence_36056574_13" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36056574_14
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36056574_14> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36056574> ;
                                                                              gutprop:hasSentenceText "Future studies with a larger sample size are warranted to confirm our findings." ;
                                                                              rdfs:label "sentence_36056574_14" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36056574_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36056574_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36056574> ;
                                                                             gutprop:hasSentenceText "The gut microbiota (GM) plays a critical role in mental health and sleep quality, and the composition of the GM is largely unknown among AsA." ;
                                                                             rdfs:label "sentence_36056574_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36056574_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36056574_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36056574> ;
                                                                             gutprop:hasSentenceText "Examine associations of the GM with depressive symptoms and sleep disturbance among Chinese and Korean American immigrants." ;
                                                                             rdfs:label "sentence_36056574_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36056574_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36056574_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36056574> ;
                                                                             gutprop:hasSentenceText "Depressive symptoms (PROMIS Short Form-Depression) and sleep quality (Pittsburgh Sleep Quality Index [PSQI]) were collected via surveys." ;
                                                                             rdfs:label "sentence_36056574_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36056574_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36056574_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36056574> ;
                                                                             gutprop:hasSentenceText "PROMIS measure T-score > 55 indicates positive depressive symptoms, and a total PSQI score > 5 indicates sleep disturbance." ;
                                                                             rdfs:label "sentence_36056574_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36056574_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36056574_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36056574> ;
                                                                             gutprop:hasSentenceText "16S rRNA V3-V4 gene regions were sequenced from fecal specimens to measure GM." ;
                                                                             rdfs:label "sentence_36056574_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36056574_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36056574_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36056574> ;
                                                                             gutprop:hasSentenceText "Permutational multivariate analysis of variance and linear discriminant analysis effect size were applied to examine associations of the GM with symptoms." ;
                                                                             rdfs:label "sentence_36056574_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36056574_8
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36056574_8> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36056574> ;
                                                                             gutprop:hasSentenceText "Among 20 participants, 55% (<i>n</i> = 11) reported depressive symptoms and 35% (<i>n</i> = 7) reported sleep disturbance." ;
                                                                             rdfs:label "sentence_36056574_8" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36056574_9
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36056574_9> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36056574> ;
                                                                             gutprop:hasSentenceText "A higher α-diversity was marginally associated with lower depressive symptoms: Chao1 (r = -0.39, <i>p</i> = 0.09) and Shannon index (r = -0.41, <i>p</i> = 0.08); β-diversity distinguished participants between categories of depressive symptoms (weighted UniFrac, <i>p</i>=0.04) or sleep disturbance (Jaccard, <i>p</i>=0.05)." ;
                                                                             rdfs:label "sentence_36056574_9" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36072564_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36072564_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/36072564> ;
                                                                             gutprop:hasSentenceText "Age-dependent effects of gut microbiota metabolites on brain resident macrophages." ;
                                                                             rdfs:label "sentence_36072564_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36072564_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36072564_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36072564> ;
                                                                             gutprop:hasSentenceText "In recent years, development of age-related diseases, such as Alzheimer's and Parkinson's disease, as well as other brain disorders, including anxiety, depression, and schizophrenia have been shown to be associated with changes in the gut microbiome." ;
                                                                             rdfs:label "sentence_36072564_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36072564_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36072564_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36072564> ;
                                                                             gutprop:hasSentenceText "Several factors can induce an alteration in the bacterial composition of the host's gastrointestinal tract." ;
                                                                             rdfs:label "sentence_36072564_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36072564_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36072564_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36072564> ;
                                                                             gutprop:hasSentenceText "Besides dietary changes and frequent use of antibiotics, the microbiome is also profoundly affected by aging." ;
                                                                             rdfs:label "sentence_36072564_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36072564_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36072564_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36072564> ;
                                                                             gutprop:hasSentenceText "Levels of microbiota-derived metabolites are elevated in older individuals with age-associated diseases and cognitive defects compared to younger, healthy age groups." ;
                                                                             rdfs:label "sentence_36072564_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36072564_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36072564_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36072564> ;
                                                                             gutprop:hasSentenceText "The identified metabolites with higher concentration in aged hosts, which include choline and trimethylamine, are known risk factors for age-related diseases." ;
                                                                             rdfs:label "sentence_36072564_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36072564_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36072564_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36072564> ;
                                                                             gutprop:hasSentenceText "While the underlying mechanisms and pathways remain elusive for the most part, it has been shown, that these metabolites are able to trigger the innate immunity in the central nervous system by influencing development and activation status of brain-resident macrophages." ;
                                                                             rdfs:label "sentence_36072564_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36072564_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36072564_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36072564> ;
                                                                             gutprop:hasSentenceText "The macrophages residing in the brain comprise parenchymal microglia and non-parenchymal macrophages located in the perivascular spaces, meninges, and the choroid plexus." ;
                                                                             rdfs:label "sentence_36072564_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36072564_8
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36072564_8> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36072564> ;
                                                                             gutprop:hasSentenceText "In this review, we highlight the impact of age on the composition of the microbiome and microbiota-derived metabolites and their influence on age-associated diseases caused by dysfunctional brain-resident macrophages." ;
                                                                             rdfs:label "sentence_36072564_8" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36072680_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36072680_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/36072680> ;
                                                                             gutprop:hasSentenceText "Dietary Modification for the Restoration of Gut Microbiome and Management of Symptoms in Irritable Bowel Syndrome." ;
                                                                             rdfs:label "sentence_36072680_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36072680_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36072680_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36072680> ;
                                                                             gutprop:hasSentenceText "Irritable bowel syndrome (IBS) is a functional gastrointestinal disorder leading to chronic debilitating issues." ;
                                                                             rdfs:label "sentence_36072680_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36072680_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36072680_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36072680> ;
                                                                             gutprop:hasSentenceText "A healthy diet plays an integral role in maintaining the gut microbiota equilibrium, thus promoting digestive health." ;
                                                                             rdfs:label "sentence_36072680_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36072680_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36072680_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36072680> ;
                                                                             gutprop:hasSentenceText "The structure and function of gut microbiota are affected by genetics and environmental factors, such as altered dietary habits, gastroenteritis, stress, increased use of alcohol and drugs, and medication use." ;
                                                                             rdfs:label "sentence_36072680_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36072680_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36072680_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36072680> ;
                                                                             gutprop:hasSentenceText "Whereas there are various management approaches cited in the literature to manage symptoms of IBS, the purpose of this article is to focus on dietary options that will restore the gut microbiome and help in managing IBS symptoms." ;
                                                                             rdfs:label "sentence_36072680_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36072680_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36072680_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36072680> ;
                                                                             gutprop:hasSentenceText "Some of the diets that are discussed in this article include a low-FODMAP (fermentable oligosaccharides, disaccharides, monosaccharides, and polyols) diet, gluten-free/wheat-free diet, high-fiber diet, dietary and herbal supplements (psyllium, peppermint oil), and probiotics/prebiotics/synbiotics." ;
                                                                             rdfs:label "sentence_36072680_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36072680_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36072680_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36072680> ;
                                                                             gutprop:hasSentenceText "The clinical practice guidelines recommended by the American College of Gastroenterology outlines evidence-based dietary recommendations for patients with IBS to manage symptoms." ;
                                                                             rdfs:label "sentence_36072680_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36072680_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36072680_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36072680> ;
                                                                             gutprop:hasSentenceText "Recent advancements in the dietary management of IBS highlighting the use of a patient-centered, personalized nutrition approach along with lifestyle changes, pharmacological therapies, and psychosocial and behavioral interventions are also reviewed and discussed." ;
                                                                             rdfs:label "sentence_36072680_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36191806_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36191806_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/36191806> ;
                                                                             gutprop:hasSentenceText "A role of gut-microbiota-brain axis via subdiaphragmatic vagus nerve in depression-like phenotypes in Chrna7 knock-out mice." ;
                                                                             rdfs:label "sentence_36191806_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36191806_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36191806_1> rdf:type owl:NamedIndividual ,
