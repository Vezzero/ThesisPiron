###  http://purl.obolibrary.org/obo/NCIT_C28397
<http://purl.obolibrary.org/obo/NCIT_C28397> rdf:type owl:NamedIndividual ,
                                                      skos:Concept ,
                                                      <https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding> ;
                                             skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/DiseaseDisorderOrFinding> ;
                                             gutprop:containedIn <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/695b2ea90ecaa863> ;
                                             rdfs:comment "A chronic respiratory disease manifested as difficulty breathing due to the narrowing of bronchial passageways. [Definition Source: NCIT]" ,
                                                          "NCIT Match" ;
                                             rdfs:label "Asthma" .


###  http://purl.obolibrary.org/obo/NCIT_C28401
<http://purl.obolibrary.org/obo/NCIT_C28401> rdf:type owl:NamedIndividual ,
                                                      skos:Concept ,
                                                      <https://w3id.org/brainteaser/ontology/schema/AnatomicalSite> ;
                                             skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/AnatomicSite> ;
                                             gutprop:containedIn <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/c58982b4942de73e> ;
                                             gutprop:locatedIn <http://purl.obolibrary.org/obo/NCIT_C45247> ;
                                             rdfs:comment "Anatomical structure located in the vertebral forebrain that receives neural input regarding odors that have been detected by cells within the nasal cavity. The axons of olfactory receptor cells extend into the olfactory bulb. [Definition Source: NCIT]" ,
                                                          "NCIT Match" ;
                                             rdfs:label "Olfactory Bulb" .


###  http://purl.obolibrary.org/obo/NCIT_C2855
<http://purl.obolibrary.org/obo/NCIT_C2855> rdf:type owl:NamedIndividual ,
                                                     skos:Concept ,
                                                     <https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding> ;
                                            skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/DiseaseDisorderOrFinding> ;
                                            gutprop:containedIn <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/6c538a6bc62363d1> ;
                                            rdfs:comment "A neoplasm arising from the epithelium.  It may be encapsulated or non-encapsulated but non-invasive.  The neoplastic epithelial cells may or may not display cellular atypia or dysplasia.  In the gastrointestinal tract, when dysplasia becomes severe it is sometimes called carcinoma in situ.  Representative examples are pituitary gland adenoma, follicular adenoma of the thyroid gland, and adenomas (or adenomatous polyps) of the gastrointestinal tract. [Definition Source: NCIT]" ,
                                                         "NCIT Match" ;
                                            rdfs:label "Adenoma" .


