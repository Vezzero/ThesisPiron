###  http://purl.obolibrary.org/obo/NCIT_C1175
<http://purl.obolibrary.org/obo/NCIT_C1175> rdf:type owl:NamedIndividual ,
                                                     skos:Concept ,
                                                     gutprop:Food ;
                                            skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/Food> ;
                                            gutprop:containedIn <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/37c0f5483c191fbe> ;
                                            rdfs:comment "NCIT Match" ,
                                                         "Produced by pressing olives, Olive Oil has a high content of monounsaturated fats, thought beneficial for health. Major components of the phenolic fraction of olive oil, lignans and pinoresinols are potent antioxidants present in extra virgin (first pressed) oils. Containing vitamins E and F, other antioxidant compounds, foods containing high amounts of lignan precursors may be protective against breast, colon, and prostate cancer, as well as heart diseases. Used mainly in cooking today, olive oil has been used for medicines and in cosmetics. (NCI04) [Definition Source: NCIT]" ;
                                            rdfs:label "Olive Oil" .


###  http://purl.obolibrary.org/obo/NCIT_C118457
<http://purl.obolibrary.org/obo/NCIT_C118457> rdf:type owl:NamedIndividual ,
                                                       skos:Concept ,
                                                       gutprop:Chemical ;
                                              skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/Chemical> ;
                                              gutprop:containedIn <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/bd0cf7e68f6bfd15> ,
