                                                    rdfs:comment "Genes which regulate or circumscribe the activity of other genes; specifically, genes which code for PROTEINS or RNAs which have GENE EXPRESSION REGULATION functions. [Definition Source: UMLS]" ,
                                                                 "UMLS Match" ;
                                                    rdfs:label "Genes, Regulator" .


###  https://uts.nlm.nih.gov/uts/umls/concept/C0017741
<https://uts.nlm.nih.gov/uts/umls/concept/C0017741> rdf:type owl:NamedIndividual ,
                                                             skos:Concept ,
                                                             gutprop:BiomedicalTechnique ;
                                                    skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/BiomedicalTechnique> ;
                                                    gutprop:containedIn <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/2b31e2e798b71744> ;
                                                    rdfs:comment "A test to determine the ability of an individual to maintain HOMEOSTASIS of BLOOD GLUCOSE. It includes measuring blood glucose levels in a fasting state, and at prescribed intervals before and after oral glucose intake (75 or 100 g) or intravenous infusion (0.5 g/kg). [Definition Source: UMLS]" ,
                                                                 "UMLS Match" ;
                                                    rdfs:label "Glucose Tolerance Test" .


###  https://uts.nlm.nih.gov/uts/umls/concept/C0017787
<https://uts.nlm.nih.gov/uts/umls/concept/C0017787> rdf:type owl:NamedIndividual ,
                                                             skos:Concept ,
                                                             <https://w3id.org/brainteaser/ontology/schema/Gene> ;
                                                    skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/Gene> ;
                                                    gutprop:containedIn <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/a9c23d3527fde02b> ,
                                                                        <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/60ea4f71a9124fa1> ;
                                                    rdfs:comment "An enzyme that catalyzes the formation of 2 molecules of glutamate from glutamine plus alpha-ketoglutarate in the presence of NADPH. EC 1.4.1.13. [Definition Source: UMLS]" ,
                                                                 "UMLS Match" ;
                                                    rdfs:label "Glutamate Synthase" .


###  https://uts.nlm.nih.gov/uts/umls/concept/C0018893
<https://uts.nlm.nih.gov/uts/umls/concept/C0018893> rdf:type owl:NamedIndividual ,
                                                             skos:Concept ,
                                                             gutprop:Animal ;
                                                    skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/Animal> ;
                                                    gutprop:containedIn <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/bd959e654c4fcfd2> ,
                                                                        <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/7ca77877c4451d17> ,
                                                                        <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/99823d25de6165ba> ;
                                                    rdfs:comment "Commonly known as parasitic worms, this group includes the ACANTHOCEPHALA; NEMATODA; and PLATYHELMINTHS. Some authors consider certain species of LEECHES that can become temporarily parasitic as helminths. [Definition Source: UMLS]" ,
                                                                 "UMLS Match" ;
                                                    rdfs:label "Helminths" .


###  https://uts.nlm.nih.gov/uts/umls/concept/C0019643
<https://uts.nlm.nih.gov/uts/umls/concept/C0019643> rdf:type owl:NamedIndividual ,
                                                             skos:Concept ,
                                                             gutprop:Chemical ;
                                                    skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/Chemical> ;
                                                    gutprop:containedIn <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/fd790cb86e4eaea9> ,
                                                                        <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/01259b2ab89b252b> ,
                                                                        <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/94e834c5769eb408> ;
                                                    rdfs:comment "Deacetylases that remove N-acetyl groups from amino side chains of the amino acids of HISTONES. The enzyme family can be divided into at least three structurally-defined subclasses. Class I and class II deacetylases utilize a zinc-dependent mechanism. The sirtuin histone deacetylases belong to class III and are NAD-dependent enzymes. [Definition Source: UMLS]" ,
                                                                 "UMLS Match" ;
                                                    rdfs:label "Histone Deacetylase" .


###  https://uts.nlm.nih.gov/uts/umls/concept/C0020456
<https://uts.nlm.nih.gov/uts/umls/concept/C0020456> rdf:type owl:NamedIndividual ,
                                                             skos:Concept ,
                                                             <https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding> ;
                                                    skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/DiseaseDisorderOrFinding> ;
                                                    gutprop:containedIn <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/979fcbe957d1e5b1> ;
                                                    rdfs:comment "Hyperglycemia is a medical condition characterized by elevated blood glucose levels above normal range, typically above 200 mg/dL, often caused by insulin resistance, impaired insulin secretion, or other factors. [Definition Source: llama3-8b-8192]" ,
                                                                 "UMLS Match" ;
                                                    rdfs:label "Hyperglycemia" .


###  https://uts.nlm.nih.gov/uts/umls/concept/C0020663
<https://uts.nlm.nih.gov/uts/umls/concept/C0020663> rdf:type owl:NamedIndividual ,
                                                             skos:Concept ,
