                                                    gutprop:target <https://uts.nlm.nih.gov/uts/umls/concept/C0043210> ;
                                                    rdfs:comment "Influenza is a highly contagious respiratory illness caused by the influenza virus, characterized by symptoms such as fever, cough, and fatigue. [Definition Source: llama3-8b-8192]" ,
                                                                 "UMLS Match" ;
