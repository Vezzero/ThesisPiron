                                                                             gutprop:hasSentenceText "Diet can alter the microbiota composition, affecting gut-brain axis function." ;
                                                                             rdfs:label "sentence_32155131_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32155131_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32155131_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32155131> ;
                                                                             gutprop:hasSentenceText "Gut microbiome restoration through selected probiotics' administration has been reported." ;
                                                                             rdfs:label "sentence_32155131_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32155131_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32155131_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32155131> ;
                                                                             gutprop:hasSentenceText "In this study, we investigated the effects of the novel formulation SLAB51 in PD." ;
                                                                             rdfs:label "sentence_32155131_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32155131_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32155131_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32155131> ;
                                                                             gutprop:hasSentenceText "Our findings indicate that this probiotic formulation can counteract the detrimental effect of 6-OHDA <i>in vitro</i> and <i>in vivo</i> models of PD." ;
                                                                             rdfs:label "sentence_32155131_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32155131_8
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32155131_8> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32155131> ;
                                                                             gutprop:hasSentenceText "The results suggest that SLAB51 can be a promising candidate for the prevention or as coadjuvant treatment of PD." ;
                                                                             rdfs:label "sentence_32155131_8" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32163822_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32163822_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/32163822> ;
                                                                             gutprop:hasSentenceText "The gut microbiota and mental health in adults." ;
                                                                             rdfs:label "sentence_32163822_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32163822_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32163822_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32163822> ;
                                                                             gutprop:hasSentenceText "A growing body of evidence point toward the bidirectional gut microbiota-brain axis playing a role in mental health." ;
                                                                             rdfs:label "sentence_32163822_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32163822_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32163822_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32163822> ;
                                                                             gutprop:hasSentenceText "Most of this research is conducted on animals why we in this review summarize and comment upon recent studies evaluating the gut microbiome in mental health in humans." ;
                                                                             rdfs:label "sentence_32163822_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32163822_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32163822_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32163822> ;
                                                                             gutprop:hasSentenceText "Further support for the relevance of the bidirectional gut microbiota-brain communication in mood disorders has been presented, such as the effect of probiotics on brain connectivity and mental health outcomes and pregnancy related stress on gut microbiota in the newborn child." ;
                                                                             rdfs:label "sentence_32163822_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32163822_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32163822_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32163822> ;
                                                                             gutprop:hasSentenceText "However, the heterogeneity between studies precludes conclusions regarding differences in microbiota composition in mental disease and health and many of the studies are limited by a cross-sectional design, small sample sizes and multiple comparisons." ;
                                                                             rdfs:label "sentence_32163822_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32163822_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32163822_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32163822> ;
                                                                             gutprop:hasSentenceText "Thus, well-designed longitudinal studies with larger sample size, accounting for confounders are needed." ;
                                                                             rdfs:label "sentence_32163822_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32188376_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32188376_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/32188376> ;
                                                                             gutprop:hasSentenceText "Diet and Neurocognition in Mood Disorders - An Overview of the Overlooked." ;
                                                                             rdfs:label "sentence_32188376_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32188376_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32188376_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32188376> ;
                                                                             gutprop:hasSentenceText "Bipolar disorder and major depression are associated with significant disability, morbidity, and reduced life expectancy." ;
                                                                             rdfs:label "sentence_32188376_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32188376_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32188376_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32188376> ;
                                                                             gutprop:hasSentenceText "People with mood disorders have shown higher ratios of unhealthy lifestyle choices, including poor diet quality and suboptimal nutrition." ;
                                                                             rdfs:label "sentence_32188376_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32188376_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32188376_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32188376> ;
                                                                             gutprop:hasSentenceText "Diet and nutrition impact on brain /mental health, but cognitive outcomes have been less researched in psychiatric disorders." ;
                                                                             rdfs:label "sentence_32188376_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32188376_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32188376_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32188376> ;
                                                                             gutprop:hasSentenceText "Neurocognitive dysfunction is a major driver of social dysfunction and a therapeutic target in mood disorders, although effective cognitive-enhancers are currently lacking." ;
                                                                             rdfs:label "sentence_32188376_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32188376_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32188376_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32188376> ;
                                                                             gutprop:hasSentenceText "This narrative review aimed to assess the potential cognitive benefits of dietary and nutritional interventions in subjects diagnosed with mood disorders." ;
                                                                             rdfs:label "sentence_32188376_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32188376_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32188376_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32188376> ;
                                                                             gutprop:hasSentenceText "Eight clinical trials with nutrients were identified, whereas none involved dietary interventions." ;
                                                                             rdfs:label "sentence_32188376_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32188376_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32188376_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32188376> ;
                                                                             gutprop:hasSentenceText "Efficacy to improve select cognitive deficits has been reported, but results are either preliminary or inconsistent." ;
                                                                             rdfs:label "sentence_32188376_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32188376_8
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32188376_8> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32188376> ;
                                                                             gutprop:hasSentenceText "Methodological recommendations for future cognition trials in the field are advanced." ;
                                                                             rdfs:label "sentence_32188376_8" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32188376_9
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32188376_9> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32188376> ;
                                                                             gutprop:hasSentenceText "Current evidence and future views are discussed from the perspectives of precision medicine, clinical staging, nutritional psychiatry, and the brain-gut-microbiota axis." ;
                                                                             rdfs:label "sentence_32188376_9" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32379622_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32379622_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/32379622> ;
                                                                             gutprop:hasSentenceText "Betaine supplementation is associated with the resilience in mice after chronic social defeat stress: a role of brain-gut-microbiota axis." ;
                                                                             rdfs:label "sentence_32379622_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32379622_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32379622_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32379622> ;
                                                                             gutprop:hasSentenceText "The brain-gut-microbiota axis plays a role in the pathogenesis of stress-related psychiatric disorders; however, its role in the resilience versus susceptibility after stress remains unclear." ;
                                                                             rdfs:label "sentence_32379622_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32379622_10
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32379622_10> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32379622> ;
                                                                              gutprop:hasSentenceText "CSDS increased levels of short-chain fatty acids (i.e., succinic acid and acetic acid) in feces from water-treated mice, but not betaine-treated mice." ;
                                                                              rdfs:label "sentence_32379622_10" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32379622_11
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32379622_11> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32379622> ;
                                                                              gutprop:hasSentenceText "Interestingly, there are positive correlations between short-chain fatty acids (i.e., succinic acid, acetic acid, butyric acid) and several bacteria among the groups." ;
                                                                              rdfs:label "sentence_32379622_11" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32379622_12
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32379622_12> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32379622> ;
                                                                              gutprop:hasSentenceText "Specific microbiome were not determined." ;
                                                                              rdfs:label "sentence_32379622_12" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32379622_13
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32379622_13> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32379622> ;
                                                                              gutprop:hasSentenceText "These findings suggest that betaine supplementation contributed to resilience to anhedonia in mice subjected to CSDS through anti-inflammation action." ;
                                                                              rdfs:label "sentence_32379622_13" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32379622_14
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32379622_14> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32379622> ;
                                                                              gutprop:hasSentenceText "Therefore, it is likely that betaine could be a prophylactic nutrient to prevent stress-related psychiatric disorders." ;
                                                                              rdfs:label "sentence_32379622_14" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32379622_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32379622_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32379622> ;
                                                                             gutprop:hasSentenceText "Dietary nutrient betaine is suggested to affect the gut microbiome." ;
                                                                             rdfs:label "sentence_32379622_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32379622_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32379622_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32379622> ;
                                                                             gutprop:hasSentenceText "Here, we examined whether betaine supplementation can affect anhedonia-like phenotype in mice subjected to chronic social defeat stress (CSDS)." ;
                                                                             rdfs:label "sentence_32379622_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32379622_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32379622_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32379622> ;
                                                                             gutprop:hasSentenceText "CSDS was performed during betaine supplementation." ;
                                                                             rdfs:label "sentence_32379622_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32379622_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32379622_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32379622> ;
                                                                             gutprop:hasSentenceText "Sucrose preference test and 16S rRNA analysis of fecal samples were performed." ;
                                                                             rdfs:label "sentence_32379622_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32379622_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32379622_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32379622> ;
                                                                             gutprop:hasSentenceText "CSDS did not produce an anhedonia-like phenotype in the betaine-treated mice, but did induce an anhedonia-like phenotype in water-treated mice." ;
                                                                             rdfs:label "sentence_32379622_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32379622_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32379622_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32379622> ;
                                                                             gutprop:hasSentenceText "Furthermore, CSDS treatment did not alter the plasma levels of interleukin-6 (IL-6) of betaine-treated mice whereas CSDS caused higher plasma levels of IL-6 in water-treated mice." ;
                                                                             rdfs:label "sentence_32379622_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32379622_8
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32379622_8> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32379622> ;
                                                                             gutprop:hasSentenceText "Betaine supplementation ameliorated the abnormal diversity and composition of the microbiota in the host gut after CSDS." ;
                                                                             rdfs:label "sentence_32379622_8" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32379622_9
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32379622_9> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32379622> ;
                                                                             gutprop:hasSentenceText "At the genus level, CSDS caused marked increases in the several bacteria of water-treated mice, but not betaine-treated mice." ;
                                                                             rdfs:label "sentence_32379622_9" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32389857_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32389857_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/32389857> ;
                                                                             gutprop:hasSentenceText "Targeting the microbiota in pharmacology of psychiatric disorders." ;
                                                                             rdfs:label "sentence_32389857_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32389857_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32389857_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32389857> ;
                                                                             gutprop:hasSentenceText "There is increasing interest in the role of the gut microbiota in health and disease." ;
                                                                             rdfs:label "sentence_32389857_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32389857_10
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32389857_10> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32389857> ;
                                                                              gutprop:hasSentenceText "On the other hand, drugs are able to shape the human gut microbiota itself, where these changes may contribute to their pharmacologic profile." ;
                                                                              rdfs:label "sentence_32389857_10" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32389857_11
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32389857_11> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32389857> ;
                                                                              gutprop:hasSentenceText "Therefore, the emerging picture on the complex drug-microbiota bidirectional interplay will have considerable implications in the future not only in terms of clinical practice but also, upstream, on drug development." ;
                                                                              rdfs:label "sentence_32389857_11" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32389857_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32389857_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32389857> ;
                                                                             gutprop:hasSentenceText "In particular, gut microbiota influences the Central Nervous System (CNS) development and homeostasis through neural pathways or routes involving the immune and circulatory systems." ;
                                                                             rdfs:label "sentence_32389857_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32389857_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32389857_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32389857> ;
                                                                             gutprop:hasSentenceText "The CNS, in turn, shapes the intestinal flora through endocrine or stress-mediated responses." ;
                                                                             rdfs:label "sentence_32389857_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32389857_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32389857_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32389857> ;
                                                                             gutprop:hasSentenceText "These overall bidirectional interactions, known as gut microbiota-brain axis, profoundly affect some brain functions, such as neurogenesis and the production of neurotransmitters, up to influence behavioral aspects of healthy subjects." ;
                                                                             rdfs:label "sentence_32389857_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32389857_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32389857_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32389857> ;
                                                                             gutprop:hasSentenceText "Consequently, a dysfunction within this axis, as observed in case of dysbiosis, can have an impact on the behavior of a given individual (e.g." ;
                                                                             rdfs:label "sentence_32389857_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32389857_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32389857_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32389857> ;
                                                                             gutprop:hasSentenceText "anxiety and depression) or on the development of pathologies affecting the CNS, such as autism spectrum disorders and neurodegenerative diseases (e.g." ;
                                                                             rdfs:label "sentence_32389857_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32389857_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32389857_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32389857> ;
                                                                             gutprop:hasSentenceText "Alzheimer's disease and Parkinson's disease)." ;
                                                                             rdfs:label "sentence_32389857_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32389857_8
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32389857_8> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32389857> ;
                                                                             gutprop:hasSentenceText "It should be considered that the whole microbiota has a significant role not only on aspects concerning human physiology, such as harvesting of nutrients and energy from the ingested food or production of a wide range of bioactive compounds, but also has positive effects on the gastrointestinal barrier function and actively contributes to the pharmacokinetics of several compounds including neuropsychiatric drugs." ;
                                                                             rdfs:label "sentence_32389857_8" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32389857_9
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32389857_9> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32389857> ;
                                                                             gutprop:hasSentenceText "Indeed, the microbiota is able to affect drug absorption and metabolism up to have an impact on drug activity and/or toxicity." ;
                                                                             rdfs:label "sentence_32389857_9" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32431588_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32431588_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/32431588> ;
                                                                             gutprop:hasSentenceText "Gut Microbiome-Modified Polyphenolic Compounds Inhibit α-Synuclein Seeding and Spreading in α-Synucleinopathies." ;
                                                                             rdfs:label "sentence_32431588_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32431588_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32431588_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32431588> ;
                                                                             gutprop:hasSentenceText "Misfolding, aggregation and deposition of α-synuclein (α-syn) are major pathologic characteristics of Parkinson's disease (PD) and the related synucleinopathy, multiple system atrophy (MSA)." ;
                                                                             rdfs:label "sentence_32431588_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32431588_10
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32431588_10> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32431588> ;
                                                                              gutprop:hasSentenceText "Outcomes from our studies suggest interactions between gut microbiome and certain dietary factors may form the basis for effective therapies that modulate pathologic α-syn propagation." ;
                                                                              rdfs:label "sentence_32431588_10" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32431588_11
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32431588_11> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32431588> ;
                                                                              gutprop:hasSentenceText "Collectively, our findings provide the basis for future developments of probiotic, prebiotic, or synbiotic approaches for modulating the onset and/or progression of α-synucleinopathies." ;
                                                                              rdfs:label "sentence_32431588_11" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32431588_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32431588_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32431588> ;
                                                                             gutprop:hasSentenceText "The spread of α-syn pathology across brain regions is thought to play a key role in the onset and progression of clinical phenotypes." ;
                                                                             rdfs:label "sentence_32431588_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32431588_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32431588_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32431588> ;
                                                                             gutprop:hasSentenceText "Thus, there is increasing interest in developing strategies that target and attenuate α-syn aggregation and spread." ;
                                                                             rdfs:label "sentence_32431588_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32431588_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32431588_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32431588> ;
                                                                             gutprop:hasSentenceText "Recent studies of brain-penetrating polyphenolic acids, namely, 3-hydroxybenzoic acid (3-HBA), 3,4-dihydroxybenzoic acid (3,4-diHBA), and 3-(3-hydroxyphenyl)propionic acid (3-HPPA) that are derived from gut microbiota metabolism of dietary polyphenols, show <i>in vitro</i> ability to effectively modulate α-syn misfolding, oligomerization, and mediate aggregated α-syn neurotoxicity." ;
                                                                             rdfs:label "sentence_32431588_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32431588_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32431588_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32431588> ;
                                                                             gutprop:hasSentenceText "Here we investigate whether 3-HBA, 4-hydroxybenzoic acid (4-HBA), 3,4-diHBA, or 3-HPPA interfere with α-syn spreading in a cell-based system." ;
                                                                             rdfs:label "sentence_32431588_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32431588_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32431588_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32431588> ;
                                                                             gutprop:hasSentenceText "Using HEK293 cells overexpressing α-syn-A53T-CFP/YFP, we assessed α-syn seeding activity using Fluorescence Resonance Energy Transfer (FRET) to detect and quantify α-syn aggregation." ;
                                                                             rdfs:label "sentence_32431588_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32431588_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32431588_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32431588> ;
                                                                             gutprop:hasSentenceText "We demonstrated that 3-HPPA, 3,4-diHBA, 3-HBA, and 4-HBA significantly attenuated intracellular α-syn seeding aggregation." ;
                                                                             rdfs:label "sentence_32431588_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32431588_8
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32431588_8> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32431588> ;
                                                                             gutprop:hasSentenceText "To determine whether our compounds could inhibit brain-derived seeding activity, we utilized insoluble α-syn extracted from post-mortem MSA or PD brain specimens." ;
                                                                             rdfs:label "sentence_32431588_8" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32431588_9
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32431588_9> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32431588> ;
                                                                             gutprop:hasSentenceText "We found that 3-HPPA effectively attenuated MSA-induced aggregation of monomer into high molecular weight aggregates capable of inducing intracellular aggregation." ;
                                                                             rdfs:label "sentence_32431588_9" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32438623_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32438623_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/32438623> ;
                                                                             gutprop:hasSentenceText "Recipe for a Healthy Gut: Intake of Unpasteurised Milk Is Associated with Increased <i>Lactobacillus</i> Abundance in the Human Gut Microbiome." ;
                                                                             rdfs:label "sentence_32438623_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32438623_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32438623_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32438623> ;
                                                                             gutprop:hasSentenceText "The gut microbiota plays a role in gut-brain communication and can influence psychological functioning." ;
                                                                             rdfs:label "sentence_32438623_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32438623_10
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32438623_10> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32438623> ;
                                                                              gutprop:hasSentenceText "Additionally, faecal short chain fatty acids (SCFAs) were measured." ;
                                                                              rdfs:label "sentence_32438623_10" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32438623_11
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32438623_11> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32438623> ;
                                                                              gutprop:hasSentenceText "Relative abundance of the genus <i>Lactobacillus</i> increased significantly between pre- and post-course time points." ;
                                                                              rdfs:label "sentence_32438623_11" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32438623_12
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32438623_12> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32438623> ;
                                                                              gutprop:hasSentenceText "This increase was associated with participants intake of unpasteurised milk and dairy products." ;
                                                                              rdfs:label "sentence_32438623_12" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32438623_13
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32438623_13> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32438623> ;
                                                                              gutprop:hasSentenceText "An increase in the faecal SCFA, valerate, was observed along with an increase in the functional richness of the microbiome profile, as determined by measuring the predictive neuroactive potential using a gut-brain module approach." ;
                                                                              rdfs:label "sentence_32438623_13" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32438623_14
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32438623_14> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32438623> ;
                                                                              gutprop:hasSentenceText "While concerns in relation to safety need to be considered, intake of unpasteurised milk and dairy products appear to be associated with the growth of the probiotic bacterial genus, <i>Lactobacillus</i>, in the human gut." ;
                                                                              rdfs:label "sentence_32438623_14" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32438623_15
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32438623_15> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32438623> ;
                                                                              gutprop:hasSentenceText "More research is needed on the effect of dietary changes on gut microbiome composition, in particular in relation to the promotion of bacterial genera, such as <i>Lactobacillus</i>, which are recognised as being beneficial for a range of physical and mental health outcomes." ;
                                                                              rdfs:label "sentence_32438623_15" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32438623_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32438623_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32438623> ;
                                                                             gutprop:hasSentenceText "Diet is one of the major determinants of gut microbiota composition." ;
                                                                             rdfs:label "sentence_32438623_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32438623_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32438623_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32438623> ;
                                                                             gutprop:hasSentenceText "The impact of unpasteurised dairy products on the microbiota is unknown." ;
                                                                             rdfs:label "sentence_32438623_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32438623_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32438623_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32438623> ;
                                                                             gutprop:hasSentenceText "In this observational study, we investigated the effect of a dietary change involving intake of unpasteurised dairy on gut microbiome composition and psychological status in participants undertaking a residential 12-week cookery course on an organic farm." ;
                                                                             rdfs:label "sentence_32438623_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32438623_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32438623_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32438623> ;
                                                                             gutprop:hasSentenceText "Twenty-four participants completed the study." ;
                                                                             rdfs:label "sentence_32438623_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32438623_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32438623_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32438623> ;
                                                                             gutprop:hasSentenceText "The majority of food consumed during their stay originated from the organic farm itself and included unpasteurised milk and dairy products." ;
                                                                             rdfs:label "sentence_32438623_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32438623_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32438623_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32438623> ;
                                                                             gutprop:hasSentenceText "At the beginning and end of the course, participants provided faecal samples and completed self-report questionnaires on a variety of parameters including mood, anxiety and sleep." ;
                                                                             rdfs:label "sentence_32438623_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32438623_8
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32438623_8> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32438623> ;
                                                                             gutprop:hasSentenceText "Nutrient intake was monitored with a food frequency questionnaire." ;
                                                                             rdfs:label "sentence_32438623_8" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32438623_9
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32438623_9> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32438623> ;
                                                                             gutprop:hasSentenceText "Gut microbiota analysis was performed with 16S rRNA gene sequencing." ;
                                                                             rdfs:label "sentence_32438623_9" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32459708_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32459708_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/32459708> ;
                                                                             gutprop:hasSentenceText "The role of the gut microbiota in the pathophysiology of mental and neurological disorders." ;
                                                                             rdfs:label "sentence_32459708_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32459708_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32459708_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32459708> ;
                                                                             gutprop:hasSentenceText "In recent decades, the concept of the gut microbiota as a potential novel therapeutic strategy for mental health has emerged." ;
                                                                             rdfs:label "sentence_32459708_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32459708_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32459708_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32459708> ;
                                                                             gutprop:hasSentenceText "The tiny microbes inhabiting our gut communicate through a bidirectional communication signaling with the brain that influences gut physiology, brain function and behavior." ;
                                                                             rdfs:label "sentence_32459708_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32459708_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32459708_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32459708> ;
                                                                             gutprop:hasSentenceText "Accumulating evidence suggests that perturbation of the gut microbiota contributes to the pathophysiology of mental illnesses including autism, depression and anxiety as well as neurodegenerative disorders such as Alzheimer's and Parkinson's diseases." ;
                                                                             rdfs:label "sentence_32459708_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32459708_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32459708_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32459708> ;
                                                                             gutprop:hasSentenceText "This review will highlight recent findings in both human and animal studies indicating how changes in the gut microbiota can impact the pathophysiology of such diseases." ;
                                                                             rdfs:label "sentence_32459708_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32459708_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32459708_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32459708> ;
                                                                             gutprop:hasSentenceText "The current work will also provide an understanding of the efficacy of microbiota-targeted therapies on psychiatric disorders." ;
                                                                             rdfs:label "sentence_32459708_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32469834_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32469834_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/32469834> ;
                                                                             gutprop:hasSentenceText "The human gut microbiota and depression: widely reviewed, yet poorly understood." ;
                                                                             rdfs:label "sentence_32469834_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32469834_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32469834_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32469834> ;
                                                                             gutprop:hasSentenceText "A large number of existing reviews have discussed the role of the gut microbiota in affective disorders, though syntheses have been overwhelmingly narrative in their focus." ;
                                                                             rdfs:label "sentence_32469834_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32469834_10
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32469834_10> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32469834> ;
                                                                              gutprop:hasSentenceText "Research investigating the microbiota-gut-brain axis in affective disorders has been met with great enthusiasm, offering promising direction for novel therapeutics in conditions such as depression." ;
                                                                              rdfs:label "sentence_32469834_10" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32469834_11
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32469834_11> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32469834> ;
                                                                              gutprop:hasSentenceText "We encourage further systematic reviews in this space, particularly which consider research quality and incorporate comprehensive meta-analyses." ;
                                                                              rdfs:label "sentence_32469834_11" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32469834_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32469834_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32469834> ;
                                                                             gutprop:hasSentenceText "In this correspondence, we compliment Sanada et al." ;
                                                                             rdfs:label "sentence_32469834_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32469834_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32469834_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32469834> ;
                                                                             gutprop:hasSentenceText "(2020) on their recent systematic review of the gut microbiota in Major Depressive Disorder (MDD), the first to incorporate a meta-analysis." ;
                                                                             rdfs:label "sentence_32469834_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32469834_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32469834_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32469834> ;
                                                                             gutprop:hasSentenceText "We also comment on how this synthesis should be extended in future research." ;
                                                                             rdfs:label "sentence_32469834_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32469834_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32469834_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32469834> ;
                                                                             gutprop:hasSentenceText "Sanada et al." ;
                                                                             rdfs:label "sentence_32469834_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32469834_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32469834_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32469834> ;
                                                                             gutprop:hasSentenceText "(2020) conducted a meta-analysis of alpha diversity in participants with MDD compared to controls, whereby they unexpectedly observed no significant difference between groups." ;
                                                                             rdfs:label "sentence_32469834_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32469834_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32469834_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32469834> ;
                                                                             gutprop:hasSentenceText "A meta-analysis was only able to be performed on alpha diversity indices." ;
                                                                             rdfs:label "sentence_32469834_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32469834_8
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32469834_8> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32469834> ;
                                                                             gutprop:hasSentenceText "Future research should consider research quality, other forms of depression, incorporate comprehensive meta-analyses, where possible, as well as investigate associations between anxiety/depression symptom measures and the gut microbiota." ;
                                                                             rdfs:label "sentence_32469834_8" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32469834_9
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32469834_9> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32469834> ;
                                                                             gutprop:hasSentenceText "Further consideration of papers which incorporate functional analyses (e.g., metabolomics) is required to integrate this body of literature." ;
                                                                             rdfs:label "sentence_32469834_9" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32517799_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32517799_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/32517799> ;
                                                                             gutprop:hasSentenceText "Parkinson's disease-associated alterations of the gut microbiome predict disease-relevant changes in metabolic functions." ;
                                                                             rdfs:label "sentence_32517799_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32517799_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32517799_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32517799> ;
                                                                             gutprop:hasSentenceText "Parkinson's disease (PD) is a systemic disease clinically defined by the degeneration of dopaminergic neurons in the brain." ;
                                                                             rdfs:label "sentence_32517799_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32517799_10
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32517799_10> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32517799> ;
                                                                              gutprop:hasSentenceText "Particularly, the relative abundances of Bilophila and Paraprevotella were significantly associated with the Hoehn and Yahr staging after controlling for the disease duration." ;
                                                                              rdfs:label "sentence_32517799_10" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32517799_11
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32517799_11> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32517799> ;
                                                                              gutprop:hasSentenceText "Furthermore, personalised metabolic modelling of the gut microbiomes revealed PD-associated metabolic patterns in the predicted secretion potential of nine microbial metabolites in PD, including increased methionine and cysteinylglycine." ;
                                                                              rdfs:label "sentence_32517799_11" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32517799_12
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32517799_12> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32517799> ;
                                                                              gutprop:hasSentenceText "The predicted microbial pantothenic acid production potential was linked to the presence of specific non-motor symptoms." ;
                                                                              rdfs:label "sentence_32517799_12" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32517799_13
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32517799_13> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32517799> ;
                                                                              gutprop:hasSentenceText "Our results suggest that PD-associated alterations of the gut microbiome can translate into substantial functional differences affecting host metabolism and disease phenotype." ;
                                                                              rdfs:label "sentence_32517799_13" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32517799_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32517799_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32517799> ;
                                                                             gutprop:hasSentenceText "While alterations in the gut microbiome composition have been reported in PD, their functional consequences remain unclear." ;
                                                                             rdfs:label "sentence_32517799_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32517799_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32517799_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32517799> ;
                                                                             gutprop:hasSentenceText "Herein, we addressed this question by an analysis of stool samples from the Luxembourg Parkinson's Study (n = 147 typical PD cases, n = 162 controls)." ;
                                                                             rdfs:label "sentence_32517799_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32517799_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32517799_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32517799> ;
                                                                             gutprop:hasSentenceText "All individuals underwent detailed clinical assessment, including neurological examinations and neuropsychological tests followed by self-reporting questionnaires." ;
                                                                             rdfs:label "sentence_32517799_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32517799_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32517799_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32517799> ;
                                                                             gutprop:hasSentenceText "Stool samples from these individuals were first analysed by 16S rRNA gene sequencing." ;
                                                                             rdfs:label "sentence_32517799_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32517799_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32517799_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32517799> ;
                                                                             gutprop:hasSentenceText "Second, we predicted the potential secretion for 129 microbial metabolites through personalised metabolic modelling using the microbiome data and genome-scale metabolic reconstructions of human gut microbes." ;
                                                                             rdfs:label "sentence_32517799_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32517799_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32517799_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32517799> ;
                                                                             gutprop:hasSentenceText "Our key results include the following." ;
                                                                             rdfs:label "sentence_32517799_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32517799_8
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32517799_8> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32517799> ;
                                                                             gutprop:hasSentenceText "Eight genera and seven species changed significantly in their relative abundances between PD patients and healthy controls." ;
                                                                             rdfs:label "sentence_32517799_8" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32517799_9
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32517799_9> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32517799> ;
                                                                             gutprop:hasSentenceText "PD-associated microbial patterns statistically depended on sex, age, BMI, and constipation." ;
                                                                             rdfs:label "sentence_32517799_9" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32518376_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32518376_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/32518376> ;
                                                                             gutprop:hasSentenceText "A key role of the subdiaphragmatic vagus nerve in the depression-like phenotype and abnormal composition of gut microbiota in mice after lipopolysaccharide administration." ;
                                                                             rdfs:label "sentence_32518376_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32518376_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32518376_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32518376> ;
                                                                             gutprop:hasSentenceText "The vagus nerve plays a role in the cross talk between the brain and gut microbiota, which could be involved in depression." ;
                                                                             rdfs:label "sentence_32518376_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32518376_10
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32518376_10> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32518376> ;
                                                                              gutprop:hasSentenceText "Our results suggest that LPS produces a depression-like phenotype, increases spleen weight, triggers inflammation, downregulates synaptic proteins in the mPFC, and leads to abnormal composition of gut microbiota via the subdiaphragmatic vagus nerve." ;
                                                                              rdfs:label "sentence_32518376_10" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32518376_11
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32518376_11> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32518376> ;
                                                                              gutprop:hasSentenceText "It is likely that the vagus nerve plays a crucial role in the brain-gut-microbiota axis." ;
                                                                              rdfs:label "sentence_32518376_11" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32518376_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32518376_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32518376> ;
                                                                             gutprop:hasSentenceText "The subdiaphragmatic vagus nerve serves as a major modulatory pathway between the brain and gut microbiota." ;
                                                                             rdfs:label "sentence_32518376_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32518376_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32518376_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32518376> ;
                                                                             gutprop:hasSentenceText "Here, we investigated the effects of subdiaphragmatic vagotomy (SDV) on the depression-like phenotype and the abnormal composition of gut microbiota in mice after lipopolysaccharide (LPS) administration." ;
                                                                             rdfs:label "sentence_32518376_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32518376_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32518376_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32518376> ;
                                                                             gutprop:hasSentenceText "LPS caused a depression-like phenotype, inflammation, increase in spleen weight, and downregulation of synaptic proteins in the medial prefrontal cortex (mPFC) in the sham-operated mice." ;
                                                                             rdfs:label "sentence_32518376_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32518376_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32518376_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32518376> ;
                                                                             gutprop:hasSentenceText "In contrast, LPS did not produce a depression-like phenotype and downregulated synaptic proteins in the mPFC after SDV." ;
                                                                             rdfs:label "sentence_32518376_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32518376_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32518376_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32518376> ;
                                                                             gutprop:hasSentenceText "The spleen weight and plasma levels of pro-inflammatory cytokines in the SDV + LPS group were lower than those of the sham + LPS group." ;
                                                                             rdfs:label "sentence_32518376_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32518376_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32518376_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32518376> ;
                                                                             gutprop:hasSentenceText "Interestingly, there were positive correlations between the plasma levels of pro-inflammatory cytokines and spleen weight, suggesting a relationship between inflammatory events and spleen weight." ;
                                                                             rdfs:label "sentence_32518376_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32518376_8
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32518376_8> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32518376> ;
                                                                             gutprop:hasSentenceText "Furthermore, LPS led to significant alterations in gut microbiota diversity in sham-operated mice, but not SDV-operated mice." ;
                                                                             rdfs:label "sentence_32518376_8" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32518376_9
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32518376_9> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32518376> ;
                                                                             gutprop:hasSentenceText "In an unweighted UniFrac PCoA, the dots representing the sham + LPS group were located far away from the dots representing the other three groups." ;
                                                                             rdfs:label "sentence_32518376_9" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32538869_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32538869_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/32538869> ;
                                                                             gutprop:hasSentenceText "Crosstalk Between Alpha-Synuclein and Other Human and Non-Human Amyloidogenic Proteins: Consequences for Amyloid Formation in Parkinson's Disease." ;
                                                                             rdfs:label "sentence_32538869_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32538869_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32538869_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32538869> ;
                                                                             gutprop:hasSentenceText "It was recently shown (Sampson et al., Elife9, 2020) that an amyloidogenic protein, CsgA, present in E. coli biofilms in the gut can trigger Parkinson's disease in mice." ;
                                                                             rdfs:label "sentence_32538869_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32538869_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32538869_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32538869> ;
                                                                             gutprop:hasSentenceText "This study emphasizes the possible role of the gut microbiome in modulation (and even initiation) of human neurodegenerative disorders, such as Parkinson's disease." ;
                                                                             rdfs:label "sentence_32538869_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32538869_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32538869_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32538869> ;
                                                                             gutprop:hasSentenceText "As the CsgA protein was found to accelerate alpha-synuclein (the key amyloidogenic protein in Parkinson's disease) amyloid formation in vitro, this result suggests that also other amyloidogenic proteins from gut bacteria, and even from the diet (such as stable allergenic proteins), may be able to affect human protein conformations and thereby modulate amyloid-related diseases." ;
                                                                             rdfs:label "sentence_32538869_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32538869_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32538869_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32538869> ;
                                                                             gutprop:hasSentenceText "In this review, we summarize what has been reported in terms of in vitro cross-reactivity studies between alpha-synuclein and other amyloidogenic human and non-human proteins." ;
                                                                             rdfs:label "sentence_32538869_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32538869_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32538869_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32538869> ;
                                                                             gutprop:hasSentenceText "It becomes clear from the limited data that exist that there is a fine line between acceleration and inhibition, but that cross-reactivity is widespread, and it is more common for other proteins (among the studied cases) to accelerate alpha-synuclein amyloid formation than to block it." ;
                                                                             rdfs:label "sentence_32538869_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32538869_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32538869_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32538869> ;
                                                                             gutprop:hasSentenceText "It is of high importance to expand investigations of cross-reactivity between amyloidogenic proteins to both reveal underlying mechanisms and links between human diseases, as well as to develop new treatments that may be based on an altered gut microbiome." ;
                                                                             rdfs:label "sentence_32538869_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32545788_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32545788_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/32545788> ;
                                                                             gutprop:hasSentenceText "Focus on the Role of NLRP3 Inflammasome in Diseases." ;
                                                                             rdfs:label "sentence_32545788_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32545788_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32545788_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32545788> ;
                                                                             gutprop:hasSentenceText "Inflammation is a protective reaction activated in response to detrimental stimuli, such as dead cells, irritants or pathogens, by the evolutionarily conserved immune system and is regulated by the host." ;
                                                                             rdfs:label "sentence_32545788_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32545788_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32545788_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32545788> ;
                                                                             gutprop:hasSentenceText "The inflammasomes are recognized as innate immune system sensors and receptors that manage the activation of caspase-1 and stimulate inflammation response." ;
                                                                             rdfs:label "sentence_32545788_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32545788_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32545788_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32545788> ;
                                                                             gutprop:hasSentenceText "They have been associated with several inflammatory disorders." ;
                                                                             rdfs:label "sentence_32545788_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32545788_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32545788_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32545788> ;
                                                                             gutprop:hasSentenceText "The NLRP3 inflammasome is the most well characterized." ;
                                                                             rdfs:label "sentence_32545788_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32545788_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32545788_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32545788> ;
                                                                             gutprop:hasSentenceText "It is so called because NLRP3 belongs to the family of nucleotide-binding and oligomerization domain-like receptors (NLRs)." ;
                                                                             rdfs:label "sentence_32545788_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32545788_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32545788_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32545788> ;
                                                                             gutprop:hasSentenceText "Recent evidence has greatly improved our understanding of the mechanisms by which the NLRP3 inflammasome is activated." ;
                                                                             rdfs:label "sentence_32545788_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32545788_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32545788_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32545788> ;
                                                                             gutprop:hasSentenceText "Additionally, increasing data in animal models, supported by human studies, strongly implicate the involvement of the inflammasome in the initiation or progression of disorders with a high impact on public health, such as metabolic pathologies (obesity, type 2 diabetes, atherosclerosis), cardiovascular diseases (ischemic and non-ischemic heart disease), inflammatory issues (liver diseases, inflammatory bowel diseases, gut microbiome, rheumatoid arthritis) and neurologic disorders (Parkinson's disease, Alzheimer's disease, multiple sclerosis, amyotrophic lateral sclerosis and other neurological disorders), compared to other molecular platforms." ;
                                                                             rdfs:label "sentence_32545788_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32545788_8
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32545788_8> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32545788> ;
                                                                             gutprop:hasSentenceText "This review will provide a focus on the available knowledge about the NLRP3 inflammasome role in these pathologies and describe the balance between the activation of the harmful and beneficial inflammasome so that new therapies can be created for patients with these diseases." ;
                                                                             rdfs:label "sentence_32545788_8" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32572814_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32572814_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/32572814> ;
                                                                             gutprop:hasSentenceText "Butyrate Protects Against Salsolinol-Induced Toxicity in SH-SY5Y Cells: Implication for Parkinson's Disease." ;
                                                                             rdfs:label "sentence_32572814_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32572814_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32572814_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32572814> ;
                                                                             gutprop:hasSentenceText "Parkinson's disease (PD), a progressive neurodegenerative disorder, is associated with the destruction of dopamine neurons in the substantia nigra (SN) and the formation of Lewy bodies in basal ganglia." ;
                                                                             rdfs:label "sentence_32572814_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32572814_10
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32572814_10> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32572814> ;
                                                                              gutprop:hasSentenceText "Exposure of SH-SY5Y cells for 24 h to 400 μM SALS resulted in approximately 60% cell death, which was concentration-dependently prevented by butyrate." ;
                                                                              rdfs:label "sentence_32572814_10" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32572814_11
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32572814_11> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32572814> ;
                                                                              gutprop:hasSentenceText "The effects of butyrate in turn were significantly attenuated by beta-hydroxy butyrate (BHB), a selective FA3R antagonist." ;
                                                                              rdfs:label "sentence_32572814_11" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32572814_12
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32572814_12> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32572814> ;
                                                                              gutprop:hasSentenceText "Moreover, a selective FA3R agonist (AR 420626) also provided protective effects against SALS, which was totally blocked by BHB." ;
                                                                              rdfs:label "sentence_32572814_12" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32572814_13
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32572814_13> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32572814> ;
                                                                              gutprop:hasSentenceText "These findings provide further support that butyrate or an agonist of FA3R may be of therapeutic potential in PD." ;
                                                                              rdfs:label "sentence_32572814_13" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32572814_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32572814_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32572814> ;
                                                                             gutprop:hasSentenceText "Risk factors for PD include aging, as well as environmental and genetic factors." ;
                                                                             rdfs:label "sentence_32572814_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32572814_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32572814_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32572814> ;
                                                                             gutprop:hasSentenceText "Recent converging reports suggest a role for the gut microbiome and epigenetic factors in the onset and/or progression of PD." ;
                                                                             rdfs:label "sentence_32572814_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32572814_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32572814_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32572814> ;
                                                                             gutprop:hasSentenceText "Of particular relevance and potential therapeutic targets in this regard are histone deacetylases (HDACs), enzymes that are involved in chromatin remodeling." ;
                                                                             rdfs:label "sentence_32572814_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32572814_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32572814_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32572814> ;
                                                                             gutprop:hasSentenceText "Butyrate, a short-chain fatty acid (FA) produced in the gut and presumably acting via several G protein-coupled receptors (GPCRs) including FA3 receptors (FA3Rs), is a well-known HDAC inhibitor that plays an important role in maintaining homeostasis of the gut-brain axis." ;
                                                                             rdfs:label "sentence_32572814_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32572814_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32572814_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32572814> ;
                                                                             gutprop:hasSentenceText "Recently, its significance in regulation of some critical brain functions and usefulness in neurodegenerative diseases such as PD has been suggested." ;
                                                                             rdfs:label "sentence_32572814_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32572814_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32572814_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32572814> ;
                                                                             gutprop:hasSentenceText "In this study we sought to determine whether butyrate may have protective effects against salsolionl (SALS)-induced toxicity in SH-SY5Y cells." ;
                                                                             rdfs:label "sentence_32572814_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32572814_8
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32572814_8> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32572814> ;
                                                                             gutprop:hasSentenceText "SALS, an endogenous product of aldehyde and dopamine condensation, may be selectively toxic to dopaminergic neurons." ;
                                                                             rdfs:label "sentence_32572814_8" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32572814_9
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32572814_9> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32572814> ;
                                                                             gutprop:hasSentenceText "SH-SY5Y cells, derived from human neuroblastoma cells, are used as a model of these neurons." ;
                                                                             rdfs:label "sentence_32572814_9" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32600151_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32600151_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/32600151> ;
                                                                             gutprop:hasSentenceText "Rapid improvement in Alzheimer's disease symptoms following fecal microbiota transplantation: a case report." ;
                                                                             rdfs:label "sentence_32600151_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32600151_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32600151_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32600151> ;
                                                                             gutprop:hasSentenceText "Alzheimer's disease (AD), the most common form of dementia, is a leading cause of death and a major cause of morbidity in older people." ;
                                                                             rdfs:label "sentence_32600151_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32600151_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32600151_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32600151> ;
                                                                             gutprop:hasSentenceText "The disease is characterized by progressive memory loss, cognitive impairment, and the cerebral accumulation of amyloid-β peptide." ;
                                                                             rdfs:label "sentence_32600151_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32600151_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32600151_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32600151> ;
                                                                             gutprop:hasSentenceText "Given the health and economic impacts of AD, treatments that target the underlying etiology of AD or modify the course of the disease are of significant interest." ;
                                                                             rdfs:label "sentence_32600151_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32600151_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32600151_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32600151> ;
                                                                             gutprop:hasSentenceText "The gut microbiome has been increasingly implicated in the pathogenesis of several neurological diseases, including multiple sclerosis and Parkinson's disease." ;
                                                                             rdfs:label "sentence_32600151_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32600151_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32600151_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32600151> ;
                                                                             gutprop:hasSentenceText "Furthermore, emerging evidence has demonstrated that there are alterations in gut microbiome composition in patients with AD, suggesting involvement of the microbiome-gut-brain axis." ;
                                                                             rdfs:label "sentence_32600151_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32600151_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32600151_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32600151> ;
                                                                             gutprop:hasSentenceText "We present symptom improvement in a patient with AD following fecal microbiota transplantation for a <i>Clostridioides difficile</i> infection." ;
                                                                             rdfs:label "sentence_32600151_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32605552_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32605552_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/32605552> ;
                                                                             gutprop:hasSentenceText "The study protocol for a pseudo-randomised pre-post designed controlled intervention trial to study the effects of a 7-week cooking program on self-efficacy and biomarkers of health: the ECU lifestyle and biomarkers get connected study (ECULABJMOF) including the Jamie's Ministry of Food WA participant experience." ;
                                                                             rdfs:label "sentence_32605552_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32605552_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32605552_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32605552> ;
                                                                             gutprop:hasSentenceText "Australia, like other nations, has experienced a shift in dietary patterns away from home cooking of nutritious foods, towards a reliance on pre-prepared convenience meals." ;
                                                                             rdfs:label "sentence_32605552_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32605552_10
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32605552_10> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32605552> ;
                                                                              gutprop:hasSentenceText "Primary endpoints were participants' cooking confidence as a proxy for self-efficacy." ;
                                                                              rdfs:label "sentence_32605552_10" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32605552_11
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32605552_11> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32605552> ;
                                                                              gutprop:hasSentenceText "Secondary endpoints were dietary intake, physical activity levels, body composition, anthropometry, blood, urine and faecal biomarkers of systemic, physical and mental health." ;
                                                                              rdfs:label "sentence_32605552_11" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32605552_12
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32605552_12> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32605552> ;
                                                                              gutprop:hasSentenceText "The community cooking program provided participants with information and advice on food sourcing, preparation and nutrition to improve home cooking skills." ;
                                                                              rdfs:label "sentence_32605552_12" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32605552_13
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32605552_13> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32605552> ;
                                                                              gutprop:hasSentenceText "The study was designed to explore whether food literacy programs are efficacious in improving participant physical health and well-being in order to combat the rise in obesity and diet-related disease." ;
                                                                              rdfs:label "sentence_32605552_13" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32605552_14
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32605552_14> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32605552> ;
                                                                              gutprop:hasSentenceText "It will support future use of public health cooking program initiatives aimed at improving food literacy, self-efficacy and physical and mental health." ;
                                                                              rdfs:label "sentence_32605552_14" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32605552_15
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32605552_15> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32605552> ;
                                                                              gutprop:hasSentenceText "The extensive data collected will inform future research into the relationship between diet, the gut-microbiota and human health." ;
                                                                              rdfs:label "sentence_32605552_15" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32605552_16
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32605552_16> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32605552> ;
                                                                              gutprop:hasSentenceText "Retrospectively registered on 16.08.2019 with the Australian New Zealand Clinical Trials Registry (ANZCTR)." ;
                                                                              rdfs:label "sentence_32605552_16" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32605552_17
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32605552_17> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32605552> ;
                                                                              gutprop:hasSentenceText "ACTRN12619001144101 ." ;
                                                                              rdfs:label "sentence_32605552_17" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32605552_18
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32605552_18> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32605552> ;
                                                                              gutprop:hasSentenceText "Protocol version 4." ;
                                                                              rdfs:label "sentence_32605552_18" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32605552_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32605552_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32605552> ;
                                                                             gutprop:hasSentenceText "These are typically energy-dense, nutrient-poor and contribute to the rising prevalence of obesity and chronic disease burden." ;
                                                                             rdfs:label "sentence_32605552_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32605552_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32605552_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32605552> ;
                                                                             gutprop:hasSentenceText "The aims of this study were to evaluate whether a community-based cooking program instigated a change to participants' skills, attitudes, knowledge, enjoyment and satisfaction of cooking and cooking confidence (self-efficacy)." ;
                                                                             rdfs:label "sentence_32605552_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32605552_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32605552_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32605552> ;
                                                                             gutprop:hasSentenceText "The pseudo-random, pre-post study design consisted of an intervention and a control group." ;
                                                                             rdfs:label "sentence_32605552_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32605552_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32605552_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32605552> ;
                                                                             gutprop:hasSentenceText "Participant recruitment and group allocation was based on their program start dates." ;
                                                                             rdfs:label "sentence_32605552_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32605552_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32605552_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32605552> ;
                                                                             gutprop:hasSentenceText "Intervention participants were surveyed three times (baseline, 7 weeks and 6 months) and the control group were surveyed at baseline and 5 weeks." ;
                                                                             rdfs:label "sentence_32605552_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32605552_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32605552_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32605552> ;
                                                                             gutprop:hasSentenceText "All participants were registered via an online website and were 18 years or over." ;
                                                                             rdfs:label "sentence_32605552_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32605552_8
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32605552_8> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32605552> ;
                                                                             gutprop:hasSentenceText "Upon consent, participants were offered four levels of commitment, defined by different assessments." ;
                                                                             rdfs:label "sentence_32605552_8" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32605552_9
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32605552_9> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32605552> ;
                                                                             gutprop:hasSentenceText "The minimum participation level included an online survey and levels 2, 3 and 4 involved attendance at a clinic with increasing functional, anthropometric and biomarker measurements." ;
                                                                             rdfs:label "sentence_32605552_9" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32667590_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32667590_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/32667590> ;
                                                                             gutprop:hasSentenceText "The role of the microbiota-gut-brain axis in neuropsychiatric disorders." ;
                                                                             rdfs:label "sentence_32667590_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32667590_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32667590_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32667590> ;
                                                                             gutprop:hasSentenceText "The microbiota-gut-brain axis is a bidirectional signaling mechanism between the gastrointestinal tract and the central nervous system." ;
                                                                             rdfs:label "sentence_32667590_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32667590_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32667590_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32667590> ;
                                                                             gutprop:hasSentenceText "The complexity of the intestinal ecosystem is extraordinary; it comprises more than 100 trillion microbial cells that inhabit the small and large intestine, and this interaction between microbiota and intestinal epithelium can cause physiological changes in the brain and influence mood and behavior." ;
                                                                             rdfs:label "sentence_32667590_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32667590_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32667590_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32667590> ;
                                                                             gutprop:hasSentenceText "Currently, there has been an emphasis on how such interactions affect mental health." ;
                                                                             rdfs:label "sentence_32667590_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32667590_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32667590_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32667590> ;
                                                                             gutprop:hasSentenceText "Evidence indicates that intestinal microbiota are involved in neurological and psychiatric disorders." ;
                                                                             rdfs:label "sentence_32667590_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32667590_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32667590_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32667590> ;
                                                                             gutprop:hasSentenceText "This review covers evidence for the influence of gut microbiota on the brain and behavior in Alzheimer disease, dementia, anxiety, autism spectrum disorder, bipolar disorder, major depressive disorder, Parkinson's disease, and schizophrenia." ;
                                                                             rdfs:label "sentence_32667590_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32667590_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32667590_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32667590> ;
                                                                             gutprop:hasSentenceText "The primary focus is on the pathways involved in intestinal metabolites of microbial origin, including short-chain fatty acids, tryptophan metabolites, and bacterial components that can activate the host's immune system." ;
                                                                             rdfs:label "sentence_32667590_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32667590_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32667590_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32667590> ;
                                                                             gutprop:hasSentenceText "We also list clinical evidence regarding prebiotics, probiotics, and fecal microbiota transplantation as adjuvant therapies for neuropsychiatric disorders." ;
                                                                             rdfs:label "sentence_32667590_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32739746_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32739746_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/32739746> ;
                                                                             gutprop:hasSentenceText "Colonization with the commensal fungus Candida albicans perturbs the gut-brain axis through dysregulation of endocannabinoid signaling." ;
                                                                             rdfs:label "sentence_32739746_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32739746_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32739746_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32739746> ;
                                                                             gutprop:hasSentenceText "Anxiety disorders are the most prevalent mental health disorder worldwide, with a lifetime prevalence of 5-7 % of the human population." ;
                                                                             rdfs:label "sentence_32739746_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32739746_10
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32739746_10> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32739746> ;
                                                                              gutprop:hasSentenceText "Thus, a commensal fungus that is a common colonizer of humans had widespread effects on the physiology of its host." ;
                                                                              rdfs:label "sentence_32739746_10" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32739746_11
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32739746_11> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32739746> ;
                                                                              gutprop:hasSentenceText "To our knowledge, this is the first report of microbial manipulation of the endocannabinoid (eCB) system that resulted in neuroendocrine changes contributing to anxiety-like behavior." ;
                                                                              rdfs:label "sentence_32739746_11" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32739746_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32739746_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32739746> ;
                                                                             gutprop:hasSentenceText "Although the etiology of anxiety disorders is incompletely understood, one aspect of host health that affects anxiety disorders is the gut-brain axis." ;
                                                                             rdfs:label "sentence_32739746_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32739746_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32739746_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32739746> ;
                                                                             gutprop:hasSentenceText "Adolescence is a key developmental window in which stress and anxiety disorders are a major health concern." ;
                                                                             rdfs:label "sentence_32739746_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32739746_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32739746_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32739746> ;
                                                                             gutprop:hasSentenceText "We used adolescent female mice in a gastrointestinal (GI) colonization model to demonstrate that the commensal fungus Candida albicans affects host health via the gut-brain axis." ;
                                                                             rdfs:label "sentence_32739746_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32739746_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32739746_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32739746> ;
                                                                             gutprop:hasSentenceText "In mice, bacterial members of the gut microbiota can influence the host gut-brain axis, affecting anxiety-like behavior and the hypothalamus-pituitary-adrenal (HPA) axis which produces the stress hormone corticosterone (CORT)." ;
                                                                             rdfs:label "sentence_32739746_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32739746_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32739746_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32739746> ;
                                                                             gutprop:hasSentenceText "Here we showed that mice colonized with C. albicans demonstrated increased anxiety-like behavior and increased basal production of CORT as well as dysregulation of CORT production following acute stress." ;
                                                                             rdfs:label "sentence_32739746_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32739746_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32739746_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32739746> ;
                                                                             gutprop:hasSentenceText "The HPA axis and anxiety-like behavior are negatively regulated by the endocannabinoid N-arachidonoylethanolamide (AEA)." ;
                                                                             rdfs:label "sentence_32739746_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32739746_8
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32739746_8> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32739746> ;
                                                                             gutprop:hasSentenceText "We demonstrated that C. albicans-colonized mice exhibited changes in the endocannabinoidome." ;
                                                                             rdfs:label "sentence_32739746_8" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32739746_9
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32739746_9> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32739746> ;
                                                                             gutprop:hasSentenceText "Further, increasing AEA levels using the well-characterized fatty acid amide hydrolase (FAAH) inhibitor URB597 was sufficient to reverse both neuroendocrine phenotypes in C. albicans-colonized mice." ;
                                                                             rdfs:label "sentence_32739746_9" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32772900_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32772900_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/32772900> ;
                                                                             gutprop:hasSentenceText "Gut microbes in neurocognitive and mental health disorders." ;
                                                                             rdfs:label "sentence_32772900_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32772900_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32772900_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32772900> ;
                                                                             gutprop:hasSentenceText "As individuals age, the prevalence of neurocognitive and mental health disorders increases." ;
                                                                             rdfs:label "sentence_32772900_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32772900_10
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32772900_10> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32772900> ;
                                                                              gutprop:hasSentenceText "Various psychotropic medications can have an influence on the gut microbiota by their antimicrobial effect." ;
                                                                              rdfs:label "sentence_32772900_10" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32772900_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32772900_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32772900> ;
                                                                             gutprop:hasSentenceText "Current biomedical treatments do not completely address the management of these conditions." ;
                                                                             rdfs:label "sentence_32772900_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32772900_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32772900_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32772900> ;
                                                                             gutprop:hasSentenceText "Despite new pharmacological therapy the challenges of managing these diseases remain.There is increasing evidence that the Gut Microbiome (GM) and microbial dysbiosis contribute to some of the more prevalent mental health and neurocognitive disorders, such as depression, anxiety, obsessive-compulsive disorder (OCD), post-traumatic stress disorder (PTSD), schizophrenia, bipolar disorder (BP), and dementia as well as the behavioural and psychological symptoms of dementia (BPSD) through the microbiota-gut-brain axis." ;
                                                                             rdfs:label "sentence_32772900_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32772900_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32772900_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32772900> ;
                                                                             gutprop:hasSentenceText "<b>Methodology:</b> Scoping review about the effect of gut microbiota on neurocognitive and mental health disorders." ;
                                                                             rdfs:label "sentence_32772900_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32772900_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32772900_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32772900> ;
                                                                             gutprop:hasSentenceText "This scoping review found there is an evolving evidence of the involvement of the gut microbiota in the pathophysiology of neurocognitive and mental health disorders." ;
                                                                             rdfs:label "sentence_32772900_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32772900_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32772900_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32772900> ;
                                                                             gutprop:hasSentenceText "This manuscript also discusses how the psychotropics used to treat these conditions may have an antimicrobial effect on GM, and the potential for new strategies of management with probiotics and faecal transplantation." ;
                                                                             rdfs:label "sentence_32772900_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32772900_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32772900_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32772900> ;
                                                                             gutprop:hasSentenceText "This understanding can open up the need for a gut related approach in these disorders as well as unlock the door for the role of gut related microbiota management." ;
                                                                             rdfs:label "sentence_32772900_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32772900_8
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32772900_8> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32772900> ;
                                                                             gutprop:hasSentenceText "KEY MESSAGES Challenges of managing mental health conditions remain in spite of new pharmacological therapy." ;
                                                                             rdfs:label "sentence_32772900_8" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32772900_9
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32772900_9> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32772900> ;
                                                                             gutprop:hasSentenceText "Gut dysbiosis is seen in various mental health conditions." ;
                                                                             rdfs:label "sentence_32772900_9" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32816830_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32816830_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/32816830> ;
                                                                             gutprop:hasSentenceText "Does Fibre-fix provided to people with irritable bowel syndrome who are consuming a low FODMAP diet improve their gut health, gut microbiome, sleep and mental health?" ;
                                                                             rdfs:label "sentence_32816830_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32816830_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32816830_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32816830> ;
                                                                             gutprop:hasSentenceText "A double-blinded, randomised controlled trial." ;
                                                                             rdfs:label "sentence_32816830_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32816830_10
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32816830_10> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32816830> ;
                                                                              gutprop:hasSentenceText "Multivariate analysis will be used to examine the gut microbiome and repeated measures Analysis of variance (ANOVA) will be used for dependent variables from questionnaires related to bowel symptoms, stool type, sleep, mental health and QOL to assess the differences between intervention and control groups after adjustment for confounding variables." ;
                                                                              rdfs:label "sentence_32816830_10" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32816830_11
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32816830_11> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32816830> ;
                                                                              gutprop:hasSentenceText "Ethics approval was obtained from the Human Research Ethics Committee of Edith Cowan University (2019-00619-YAN)." ;
                                                                              rdfs:label "sentence_32816830_11" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32816830_12
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32816830_12> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32816830> ;
                                                                              gutprop:hasSentenceText "Results will be disseminated in peer-review journal publications, and conference presentations." ;
                                                                              rdfs:label "sentence_32816830_12" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32816830_13
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32816830_13> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32816830> ;
                                                                              gutprop:hasSentenceText "Participants will be provided with a summary of findings once the study is completed." ;
                                                                              rdfs:label "sentence_32816830_13" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32816830_14
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32816830_14> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32816830> ;
                                                                              gutprop:hasSentenceText "If Fibre-fix is shown to result in favourable changes in gut microbial composition, SCFA production, sleep and mental well-being without exacerbating symptoms, this will provide additional dietary management options for those with IBS following an LFD." ;
                                                                              rdfs:label "sentence_32816830_14" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32816830_15
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32816830_15> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32816830> ;
                                                                              gutprop:hasSentenceText "ACTRN12620000032954." ;
                                                                              rdfs:label "sentence_32816830_15" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32816830_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32816830_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32816830> ;
                                                                             gutprop:hasSentenceText "A diet low in fermentable oligosaccharides, disaccharides, monosaccharides and polyols (FODMAP) is an effective way to reduce gut symptoms in people with irritable bowel syndrome (IBS)." ;
                                                                             rdfs:label "sentence_32816830_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32816830_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32816830_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32816830> ;
                                                                             gutprop:hasSentenceText "This diet reduces the intake of fermentable fibres, leading to changes of the gut microbiota and insufficient fermentation in the large bowel, resulting in reduced production of short-chain fatty acids (SCFAs), such as butyrate, which has unfavourable implications for gut health, sleep and mental health." ;
                                                                             rdfs:label "sentence_32816830_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32816830_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32816830_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32816830> ;
                                                                             gutprop:hasSentenceText "This study will examine the effect of Fibre-fix, a supplement containing a mix of dietary fibres, on the human gut microbiome composition, fermentative capacity, sleep, quality of life (QOL) and mental health of people with IBS who consume a low FODMAP diet (LFD)." ;
                                                                             rdfs:label "sentence_32816830_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32816830_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32816830_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32816830> ;
                                                                             gutprop:hasSentenceText "A randomised, double-blind, placebo-controlled, study design is proposed to examine whether Fibre-fix added to an existing LFD may help modulate gastrointestinal function, improve markers of sleep, mental health and promote QOL in patients with IBS." ;
                                                                             rdfs:label "sentence_32816830_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32816830_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32816830_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32816830> ;
                                                                             gutprop:hasSentenceText "Participants will provide stool and blood samples, daily bowel symptoms diaries and 3-day diet records." ;
                                                                             rdfs:label "sentence_32816830_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32816830_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32816830_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32816830> ;
                                                                             gutprop:hasSentenceText "Additionally, they will complete validated questionnaires relating to FODMAP intake, sleep, mental health and QOL before and after a 3-week intervention." ;
                                                                             rdfs:label "sentence_32816830_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32816830_8
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32816830_8> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32816830> ;
                                                                             gutprop:hasSentenceText "Gut health will be assessed via faecal microbiome composition, faecal pH and SCFA levels." ;
                                                                             rdfs:label "sentence_32816830_8" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32816830_9
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32816830_9> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32816830> ;
                                                                             gutprop:hasSentenceText "Alteration of sleep will be recorded using an actigraphy device worn by all participants over the whole study." ;
                                                                             rdfs:label "sentence_32816830_9" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32819434_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32819434_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/32819434> ;
                                                                             gutprop:hasSentenceText "The gut microbiota regulates autism-like behavior by mediating vitamin B<sub>6</sub> homeostasis in EphB6-deficient mice." ;
                                                                             rdfs:label "sentence_32819434_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32819434_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32819434_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32819434> ;
                                                                             gutprop:hasSentenceText "Autism spectrum disorder (ASD) is a developmental disorder, and the effective pharmacological treatments for the core autistic symptoms are currently limited." ;
                                                                             rdfs:label "sentence_32819434_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32819434_10
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32819434_10> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32819434> ;
                                                                              gutprop:hasSentenceText "Our study uncovers a key role for the gut microbiota in the regulation of autism-like social behavior by vitamin B<sub>6</sub>, dopamine, and the E/I balance in EphB6-deficient mice, and these findings suggest new strategies for understanding and treating ASD." ;
                                                                              rdfs:label "sentence_32819434_10" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32819434_11
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32819434_11> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32819434> ;
                                                                              gutprop:hasSentenceText "Video abstract." ;
                                                                              rdfs:label "sentence_32819434_11" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32819434_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32819434_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32819434> ;
                                                                             gutprop:hasSentenceText "Increasing evidence, particularly that from clinical studies on ASD patients, suggests a functional link between the gut microbiota and the development of ASD." ;
                                                                             rdfs:label "sentence_32819434_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32819434_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32819434_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32819434> ;
                                                                             gutprop:hasSentenceText "However, the mechanisms linking the gut microbiota with brain dysfunctions (gut-brain axis) in ASD have not yet been full elucidated." ;
                                                                             rdfs:label "sentence_32819434_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32819434_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32819434_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32819434> ;
                                                                             gutprop:hasSentenceText "Due to its genetic mutations and downregulated expression in patients with ASD, EPHB6, which also plays important roles in gut homeostasis, is generally considered a candidate gene for ASD." ;
                                                                             rdfs:label "sentence_32819434_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32819434_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32819434_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32819434> ;
                                                                             gutprop:hasSentenceText "Nonetheless, the role and mechanism of EPHB6 in regulating the gut microbiota and the development of ASD are unclear." ;
                                                                             rdfs:label "sentence_32819434_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32819434_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32819434_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32819434> ;
                                                                             gutprop:hasSentenceText "Here, we found that the deletion of EphB6 induced autism-like behavior and disturbed the gut microbiota in mice." ;
                                                                             rdfs:label "sentence_32819434_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32819434_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32819434_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32819434> ;
                                                                             gutprop:hasSentenceText "More importantly, transplantation of the fecal microbiota from EphB6-deficient mice resulted in autism-like behavior in antibiotic-treated C57BL/6J mice, and transplantation of the fecal microbiota from wild-type mice ameliorated the autism-like behavior in EphB6-deficient mice." ;
                                                                             rdfs:label "sentence_32819434_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32819434_8
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32819434_8> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32819434> ;
                                                                             gutprop:hasSentenceText "At the metabolic level, the disturbed gut microbiota in EphB6-deficient mice led to vitamin B<sub>6</sub> and dopamine defects." ;
                                                                             rdfs:label "sentence_32819434_8" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32819434_9
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32819434_9> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32819434> ;
                                                                             gutprop:hasSentenceText "At the cellular level, the excitation/inhibition (E/I) balance in the medial prefrontal cortex was regulated by gut microbiota-mediated vitamin B<sub>6</sub> in EphB6-deficient mice." ;
                                                                             rdfs:label "sentence_32819434_9" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32834004_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32834004_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/32834004> ;
                                                                             gutprop:hasSentenceText "Predictive analysis methods for human microbiome data with application to Parkinson's disease." ;
                                                                             rdfs:label "sentence_32834004_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32834004_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32834004_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32834004> ;
                                                                             gutprop:hasSentenceText "Microbiome data consists of operational taxonomic unit (OTU) counts characterized by zero-inflation, over-dispersion, and grouping structure among samples." ;
                                                                             rdfs:label "sentence_32834004_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32834004_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32834004_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32834004> ;
                                                                             gutprop:hasSentenceText "Currently, statistical testing methods are commonly performed to identify OTUs that are associated with a phenotype." ;
                                                                             rdfs:label "sentence_32834004_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32834004_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32834004_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32834004> ;
                                                                             gutprop:hasSentenceText "The limitations of statistical testing methods include that the validity of p-values/q-values depend sensitively on the correctness of models and that the statistical significance does not necessarily imply predictivity." ;
                                                                             rdfs:label "sentence_32834004_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32834004_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32834004_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32834004> ;
                                                                             gutprop:hasSentenceText "Predictive analysis using methods such as LASSO is an alternative approach for identifying associated OTUs and for measuring the predictability of the phenotype variable with OTUs and other covariate variables." ;
                                                                             rdfs:label "sentence_32834004_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32834004_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32834004_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32834004> ;
                                                                             gutprop:hasSentenceText "We investigate three strategies of performing predictive analysis: (1) LASSO: fitting a LASSO multinomial logistic regression model to all OTU counts with specific transformation; (2) screening+GLM: screening OTUs with q-values returned by fitting a GLMM to each OTU, then fitting a GLM model using a subset of selected OTUs; (3) screening+LASSO: fitting a LASSO to a subset of OTUs selected with GLMM." ;
                                                                             rdfs:label "sentence_32834004_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32834004_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32834004_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32834004> ;
                                                                             gutprop:hasSentenceText "We have conducted empirical studies using three simulation datasets generated using Dirichlet-multinomial models and a real gut microbiome data related to Parkinson's disease to investigate the performance of the three strategies for predictive analysis." ;
                                                                             rdfs:label "sentence_32834004_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32834004_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32834004_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32834004> ;
                                                                             gutprop:hasSentenceText "Our simulation studies show that the predictive performance of LASSO with appropriate variable transformation works remarkably well on zero-inflated data." ;
                                                                             rdfs:label "sentence_32834004_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32834004_8
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32834004_8> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32834004> ;
                                                                             gutprop:hasSentenceText "Our results of real data analysis show that Parkinson's disease can be predicted based on selected OTUs after the binary transformation, age, and sex with high accuracy (Error Rate = 0.199, AUC = 0.872, AUPRC = 0.912)." ;
                                                                             rdfs:label "sentence_32834004_8" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32834004_9
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32834004_9> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32834004> ;
                                                                             gutprop:hasSentenceText "These results provide strong evidences of the relationship between Parkinson's disease and the gut microbiome." ;
                                                                             rdfs:label "sentence_32834004_9" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32890382_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32890382_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/32890382> ;
                                                                             gutprop:hasSentenceText "From Family Surroundings to Intestinal Flora, A Literature Review Concerning Epigenetic Processes in Psychiatric Disorders." ;
                                                                             rdfs:label "sentence_32890382_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32890382_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32890382_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32890382> ;
                                                                             gutprop:hasSentenceText "Some behaviors or psychiatric conditions seem to be inherited from parents or explain by family environment." ;
                                                                             rdfs:label "sentence_32890382_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32890382_10
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32890382_10> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32890382> ;
                                                                              gutprop:hasSentenceText "Several environmental characteristics such as traumatic life events, family adversity, psychological stress or internal environment such as gut microbiota diversity and diet showed an impact on epigenetic." ;
                                                                              rdfs:label "sentence_32890382_10" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32890382_11
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32890382_11> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32890382> ;
                                                                              gutprop:hasSentenceText "These epigenetic modifications are also correlated with neurophysiological, inflammatory or hypothalamic-pituitary-adrenal axis dysregulations." ;
                                                                              rdfs:label "sentence_32890382_11" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32890382_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32890382_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32890382> ;
                                                                             gutprop:hasSentenceText "We hypothesized interactions between epigenetic processes, inflammatory response and gut microbiota with family surroundings or environmental characteristics." ;
                                                                             rdfs:label "sentence_32890382_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32890382_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32890382_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32890382> ;
                                                                             gutprop:hasSentenceText "We searched in literature interactions between epigenetic processes and psychiatric disorders with a special interest for environmental factors such as traumatic or stress events, family relationships and also gut microbiota." ;
                                                                             rdfs:label "sentence_32890382_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32890382_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32890382_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32890382> ;
                                                                             gutprop:hasSentenceText "We searched on Pubmed, PsycINFO, PsycARTICLES and Sciencedirect articles with the keywords psychiatric disorders, epigenome, microbiome and family relationships." ;
                                                                             rdfs:label "sentence_32890382_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32890382_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32890382_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32890382> ;
                                                                             gutprop:hasSentenceText "Some gene polymorphisms interact with negative environment and lead to psychiatric disorders." ;
                                                                             rdfs:label "sentence_32890382_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32890382_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32890382_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32890382> ;
                                                                             gutprop:hasSentenceText "Negative environment is correlated with different epigenetic modifications in genes implicated in mental health." ;
                                                                             rdfs:label "sentence_32890382_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32890382_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32890382_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32890382> ;
                                                                             gutprop:hasSentenceText "Gut microbiota diversity affect host epigenetic." ;
                                                                             rdfs:label "sentence_32890382_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32890382_8
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32890382_8> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32890382> ;
                                                                             gutprop:hasSentenceText "Animal studies showed evidences for a transgenerational transmission of epigenetic characteristics." ;
                                                                             rdfs:label "sentence_32890382_8" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32890382_9
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32890382_9> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32890382> ;
                                                                             gutprop:hasSentenceText "Our findings support the hypothesis that epigenetic mediate gene-environment interactions and psychiatric disorders." ;
                                                                             rdfs:label "sentence_32890382_9" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32979562_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32979562_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/32979562> ;
                                                                             gutprop:hasSentenceText "Shotgun metagenomics reveals both taxonomic and tryptophan pathway differences of gut microbiota in bipolar disorder with current major depressive episode patients." ;
                                                                             rdfs:label "sentence_32979562_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32979562_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32979562_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32979562> ;
                                                                             gutprop:hasSentenceText "The microbiome-gut-brain axis, especially the microbial tryptophan biosynthesis and metabolism pathway (MiTBamp), is closely connected to bipolar disorder with current major depressive episode (BPD)." ;
                                                                             rdfs:label "sentence_32979562_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32979562_10
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32979562_10> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32979562> ;
                                                                              gutprop:hasSentenceText "The present findings enable a better understanding of changes in gastrointestinal microbiome and MiTBamp in BPD." ;
                                                                              rdfs:label "sentence_32979562_10" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32979562_11
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32979562_11> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32979562> ;
                                                                              gutprop:hasSentenceText "Alterations of microbes may have potential as biomarkers for distinguishing the BPD patients form HCs." ;
                                                                              rdfs:label "sentence_32979562_11" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32979562_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32979562_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32979562> ;
                                                                             gutprop:hasSentenceText "We performed shotgun metagenomics sequencing (SMS) of faecal samples from 25 BPD patients and 28 healthy controls (HCs)." ;
                                                                             rdfs:label "sentence_32979562_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32979562_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32979562_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32979562> ;
                                                                             gutprop:hasSentenceText "Except for the microbiota taxa and MiTBamp analyses, we also built a classification model using the Random Forests (RF) and Boruta algorithm to find the microbial biomarkers for BPD." ;
                                                                             rdfs:label "sentence_32979562_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32979562_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32979562_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32979562> ;
                                                                             gutprop:hasSentenceText "Compared to HCs, the phylum Bacteroidetes abundance was significantly reduced, whereas that of the Actinobacteria and Firmicutes were significantly increased in BPD patients." ;
                                                                             rdfs:label "sentence_32979562_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32979562_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32979562_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32979562> ;
                                                                             gutprop:hasSentenceText "We also identified 38 species increased and 6 species decreased significantly in the BPD group." ;
                                                                             rdfs:label "sentence_32979562_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32979562_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32979562_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32979562> ;
                                                                             gutprop:hasSentenceText "In the MiTBamp, we identified that two Kyoto Encyclopedia of Genes and Genomes (KEGG) orthologies (KOs) (K00658 and K00837) were significantly lower in the BPD, and five KOs (K01696, K00382, K00626, K01667, and K03781) were significantly higher in the BPD group." ;
                                                                             rdfs:label "sentence_32979562_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32979562_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32979562_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32979562> ;
                                                                             gutprop:hasSentenceText "We also identified significant genera and species which were closely related to these KOs." ;
                                                                             rdfs:label "sentence_32979562_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32979562_8
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32979562_8> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32979562> ;
                                                                             gutprop:hasSentenceText "Finally, RF classification based on gut microbiota at the genus level can achieve an area under the receiver operating characteristic curve of 0.997." ;
                                                                             rdfs:label "sentence_32979562_8" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32979562_9
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32979562_9> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32979562> ;
                                                                             gutprop:hasSentenceText "The features of cross-sectional design, limited sample size, the heterogeneity of bipolar disorders, and a lack of serum/plasma tryptophan concentration measurements." ;
                                                                             rdfs:label "sentence_32979562_9" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32983561_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32983561_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/32983561> ;
                                                                             gutprop:hasSentenceText "Retracted: Exploring the microbiome and mindfulness connection." ;
                                                                             rdfs:label "sentence_32983561_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32983561_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32983561_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32983561> ;
                                                                             gutprop:hasSentenceText "Mental health and its impact on overall well-being is a topic that is at the forefront of consideration in most industrialized countries." ;
                                                                             rdfs:label "sentence_32983561_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32983561_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32983561_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32983561> ;
                                                                             gutprop:hasSentenceText "Ironically in the expansive world of the microbiome, gut microbes are most affected by modern, fast paced, westernized lifestyles, indicating a significant correlation based on geography, and physical and mental habits." ;
                                                                             rdfs:label "sentence_32983561_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32983561_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32983561_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32983561> ;
                                                                             gutprop:hasSentenceText "The gut–brain axis is an established axis demonstrating the effect of the gut microbiota on the biochemical processes in the brain." ;
                                                                             rdfs:label "sentence_32983561_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32983561_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32983561_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32983561> ;
                                                                             gutprop:hasSentenceText "With the existence of mindfulness initiatives such as adoption of a ‘yogic lifestyle’ aimed at creating a sense of harmony and balance within the individual, this special report considers the available evidence base, asking whether the harmony created by adopting this lifestyle can be related to establishing harmony in the gut–brain axis." ;
                                                                             rdfs:label "sentence_32983561_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32987656_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32987656_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/32987656> ;
                                                                             gutprop:hasSentenceText "The Pathology of Parkinson's Disease and Potential Benefit of Dietary Polyphenols." ;
                                                                             rdfs:label "sentence_32987656_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32987656_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32987656_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32987656> ;
                                                                             gutprop:hasSentenceText "Parkinson's disease (PD) is a progressive neurodegenerative disorder that is characterized by a loss of dopaminergic neurons, leading to bradykinesia, rigidity, tremor at rest, and postural instability, as well as non-motor symptoms such as olfactory impairment, pain, autonomic dysfunction, impaired sleep, fatigue, and behavioral changes." ;
                                                                             rdfs:label "sentence_32987656_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32987656_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32987656_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32987656> ;
                                                                             gutprop:hasSentenceText "The pathogenesis of PD is believed to involve oxidative stress, disruption to mitochondria, alterations to the protein α-synuclein, and neuroinflammatory processes." ;
                                                                             rdfs:label "sentence_32987656_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32987656_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32987656_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32987656> ;
                                                                             gutprop:hasSentenceText "There is currently no cure for the disease." ;
                                                                             rdfs:label "sentence_32987656_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32987656_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32987656_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32987656> ;
                                                                             gutprop:hasSentenceText "Polyphenols are secondary metabolites of plants, which have shown benefit in several experimental models of PD." ;
                                                                             rdfs:label "sentence_32987656_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32987656_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32987656_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32987656> ;
                                                                             gutprop:hasSentenceText "Intake of polyphenols through diet is also associated with lower PD risk in humans." ;
                                                                             rdfs:label "sentence_32987656_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32987656_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32987656_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32987656> ;
                                                                             gutprop:hasSentenceText "In this review, we provide an overview of the pathology of PD and the data supporting the potential neuroprotective capacity of increased polyphenols in the diet." ;
                                                                             rdfs:label "sentence_32987656_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32987656_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32987656_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32987656> ;
                                                                             gutprop:hasSentenceText "Evidence suggests that the intake of dietary polyphenols may inhibit neurodegeneration and the progression of PD." ;
                                                                             rdfs:label "sentence_32987656_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32987656_8
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32987656_8> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32987656> ;
                                                                             gutprop:hasSentenceText "Polyphenols appear to have a positive effect on the gut microbiome, which may decrease inflammation that contributes to the disease." ;
                                                                             rdfs:label "sentence_32987656_8" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32987656_9
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32987656_9> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32987656> ;
                                                                             gutprop:hasSentenceText "Therefore, a diet rich in polyphenols may decrease the symptoms and increase quality of life in PD patients." ;
                                                                             rdfs:label "sentence_32987656_9" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32999308_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32999308_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/32999308> ;
                                                                             gutprop:hasSentenceText "DJ-1 (Park7) affects the gut microbiome, metabolites and the development of innate lymphoid cells (ILCs)." ;
                                                                             rdfs:label "sentence_32999308_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32999308_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32999308_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32999308> ;
                                                                             gutprop:hasSentenceText "The proper communication between gut and brain is pivotal for the maintenance of health and, dysregulation of the gut-brain axis can lead to several clinical disorders." ;
                                                                             rdfs:label "sentence_32999308_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32999308_10
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32999308_10> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32999308> ;
                                                                              gutprop:hasSentenceText "DJ-1 appeared also to be involved in ILCs development." ;
                                                                              rdfs:label "sentence_32999308_10" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32999308_11
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32999308_11> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32999308> ;
                                                                              gutprop:hasSentenceText "Further, inflammatory genes related to PD were augmented in the midbrain of DJ-1<sup>-/-</sup> mice." ;
                                                                              rdfs:label "sentence_32999308_11" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32999308_12
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32999308_12> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32999308> ;
                                                                              gutprop:hasSentenceText "Our data suggest that metabolites and inflammation produced in the gut could be used as biomarkers for PD detection." ;
                                                                              rdfs:label "sentence_32999308_12" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32999308_13
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32999308_13> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32999308> ;
                                                                              gutprop:hasSentenceText "Perhaps, these metabolites and inflammatory mediators could be involved in triggering inflammation resulting in PD pathology." ;
                                                                              rdfs:label "sentence_32999308_13" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32999308_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32999308_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32999308> ;
                                                                             gutprop:hasSentenceText "In Parkinson's disease (PD) 85% of all patients experienced constipation many years before showing any signs of motor phenotypes." ;
                                                                             rdfs:label "sentence_32999308_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32999308_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32999308_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32999308> ;
                                                                             gutprop:hasSentenceText "For differential diagnosis and preventive treatment, there is an urgent need for the identification of biomarkers indicating early disease stages long before the disease phenotype manifests." ;
                                                                             rdfs:label "sentence_32999308_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32999308_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32999308_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32999308> ;
                                                                             gutprop:hasSentenceText "DJ-1 is a chaperone protein involved in the protection against PD and genetic mutations in this protein have been shown to cause familial PD." ;
                                                                             rdfs:label "sentence_32999308_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32999308_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32999308_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32999308> ;
                                                                             gutprop:hasSentenceText "However, how the deficiency of DJ-1 influences the risk of PD remains incompletely understood." ;
                                                                             rdfs:label "sentence_32999308_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32999308_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32999308_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32999308> ;
                                                                             gutprop:hasSentenceText "In the present study, we provide evidence that DJ-1 is implicated in shaping the gut microbiome including; their metabolite production, inflammation and innate immune cells (ILCs) development." ;
                                                                             rdfs:label "sentence_32999308_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32999308_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32999308_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32999308> ;
                                                                             gutprop:hasSentenceText "We revealed that deficiency of DJ-1 leads to a significant increase in two specific genera/species, namely Alistipes and Rikenella." ;
                                                                             rdfs:label "sentence_32999308_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32999308_8
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32999308_8> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32999308> ;
                                                                             gutprop:hasSentenceText "In DJ-1 knock-out (DJ-1<sup>-/-</sup>) mice the production of fecal calprotectin and MCP-1 inflammatory proteins were elevated." ;
                                                                             rdfs:label "sentence_32999308_8" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32999308_9
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32999308_9> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32999308> ;
                                                                             gutprop:hasSentenceText "Fecal and serum metabolic profile showed that malonate which influences the immune system was significantly more abundant in DJ-1<sup>-/-</sup> mice." ;
                                                                             rdfs:label "sentence_32999308_9" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33046051_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33046051_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/33046051> ;
                                                                             gutprop:hasSentenceText "Using data science for medical decision making case: role of gut microbiome in multiple sclerosis." ;
                                                                             rdfs:label "sentence_33046051_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33046051_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33046051_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33046051> ;
                                                                             gutprop:hasSentenceText "A decade ago, the advancements in the microbiome data sequencing techniques initiated the development of research of the microbiome and its relationship with the host organism." ;
                                                                             rdfs:label "sentence_33046051_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33046051_10
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33046051_10> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33046051> ;
                                                                              gutprop:hasSentenceText "These include using taxa abundances at different taxonomy levels as well as predictive function analysis at different hierarchical levels of KEGG pathways." ;
                                                                              rdfs:label "sentence_33046051_10" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33046051_11
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33046051_11> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33046051> ;
                                                                              gutprop:hasSentenceText "The highest accuracy of the classification model was obtained at the genus level of taxonomy (76.82%) and the third hierarchical level of KEGG pathways (70.95%)." ;
                                                                              rdfs:label "sentence_33046051_11" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33046051_12
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33046051_12> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33046051> ;
                                                                              gutprop:hasSentenceText "The second dataset's 18 MS samples (Miyake et al, PLoS ONE 10:0137429, 2015) and 18 self-reported healthy samples from the (McDonald et al, Msystems 3:00031-18, 2018) dataset were used to validate the developed classification model." ;
                                                                              rdfs:label "sentence_33046051_12" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33046051_13
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33046051_13> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33046051> ;
                                                                              gutprop:hasSentenceText "The significance of this step is to show that the model is not overtrained for a specific dataset but can also be used on other independent datasets." ;
                                                                              rdfs:label "sentence_33046051_13" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33046051_14
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33046051_14> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33046051> ;
                                                                              gutprop:hasSentenceText "Again, the highest classification model accuracy for both validating datasets combined was obtained at the genus level of taxonomy (70.98%) and third hierarchical level of KEGG pathways (67.24%)." ;
                                                                              rdfs:label "sentence_33046051_14" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33046051_15
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33046051_15> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33046051> ;
                                                                              gutprop:hasSentenceText "The accuracy of the independent set remained very relevant." ;
                                                                              rdfs:label "sentence_33046051_15" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33046051_16
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33046051_16> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33046051> ;
                                                                              gutprop:hasSentenceText "Our results demonstrate that the developed classification model provides a good tool that can be used to suggest the presence or absence of MS condition by collecting and analyzing gut microbiome samples." ;
                                                                              rdfs:label "sentence_33046051_16" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33046051_17
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33046051_17> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33046051> ;
                                                                              gutprop:hasSentenceText "The accuracy of the model can be further increased by using sequencing methods that allow higher taxa resolution (i.e." ;
                                                                              rdfs:label "sentence_33046051_17" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33046051_18
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33046051_18> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33046051> ;
                                                                              gutprop:hasSentenceText "shotgun metagenomic sequencing)." ;
                                                                              rdfs:label "sentence_33046051_18" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33046051_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33046051_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33046051> ;
                                                                             gutprop:hasSentenceText "The development of sophisticated bioinformatics and data science tools for the analysis of large amounts of data followed." ;
                                                                             rdfs:label "sentence_33046051_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33046051_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33046051_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33046051> ;
                                                                             gutprop:hasSentenceText "Since then, the analyzed gut microbiome data, where microbiome is defined as a network of microorganisms inhabiting the human intestinal system, has been associated with several conditions such as irritable bowel syndrome - IBS, colorectal cancer, diabetes, obesity, and metabolic syndrome, and lately in the study of Parkinson's and Alzheimer's diseases as well." ;
                                                                             rdfs:label "sentence_33046051_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33046051_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33046051_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33046051> ;
                                                                             gutprop:hasSentenceText "This paper aims to provide an understanding of differences between microbial data of individuals who have been diagnosed with multiple sclerosis and those who were not by exploiting data science techniques on publicly available data." ;
                                                                             rdfs:label "sentence_33046051_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33046051_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33046051_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33046051> ;
                                                                             gutprop:hasSentenceText "This study examines the relationship between multiple sclerosis (MS), an autoimmune central nervous system disease, and gut microbial community composition, using the samples acquired by 16s rRNA sequencing technique." ;
                                                                             rdfs:label "sentence_33046051_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33046051_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33046051_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33046051> ;
                                                                             gutprop:hasSentenceText "We have used three different sets of MS samples sequenced during three independent studies (Jangi et al, Nat Commun 7:1-11, 2016), (Miyake et al, PLoS ONE 10:0137429, 2015), (McDonald et al, Msystems 3:00031-18, 2018) and this approach strengthens our results." ;
                                                                             rdfs:label "sentence_33046051_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33046051_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33046051_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33046051> ;
                                                                             gutprop:hasSentenceText "Analyzed sequences were from healthy control and MS groups of sequences." ;
                                                                             rdfs:label "sentence_33046051_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33046051_8
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33046051_8> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33046051> ;
                                                                             gutprop:hasSentenceText "The extracted set of statistically significant bacteria from the (Jangi et al, Nat Commun 7:1-11, 2016) dataset samples and their statistically significant predictive functions were used to develop a Random Forest classifier." ;
                                                                             rdfs:label "sentence_33046051_8" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33046051_9
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33046051_9> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33046051> ;
                                                                             gutprop:hasSentenceText "In total, 8 models based on two criteria: bacteria abundance (at six taxonomic levels) and predictive functions (at two levels), were constructed and evaluated." ;
                                                                             rdfs:label "sentence_33046051_9" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33063712_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33063712_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/33063712> ;
                                                                             gutprop:hasSentenceText "The emerging role of probiotics in neurodegenerative diseases: new hope for Parkinson's disease?" ;
                                                                             rdfs:label "sentence_33063712_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33063712_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33063712_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33063712> ;
                                                                             gutprop:hasSentenceText "Neurodegenerative disease etiology is still unclear, but different contributing factors, such as lifestyle and genetic factors are involved." ;
                                                                             rdfs:label "sentence_33063712_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33063712_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33063712_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33063712> ;
                                                                             gutprop:hasSentenceText "Altered components of the gut could play a key role in the gut-brain axis, which is a bidirectional system between the central nervous system and the enteric nervous system." ;
                                                                             rdfs:label "sentence_33063712_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33063712_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33063712_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33063712> ;
                                                                             gutprop:hasSentenceText "Variations in the composition of the gut microbiota and its function between healthy people and patients have been reported for a variety of human disorders comprising metabolic, autoimmune, cancer, and, notably, neurodegenerative disorders." ;
                                                                             rdfs:label "sentence_33063712_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33063712_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33063712_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33063712> ;
                                                                             gutprop:hasSentenceText "Diet can alter the microbiota composition, affecting the gut-brain axis function." ;
                                                                             rdfs:label "sentence_33063712_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33063712_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33063712_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33063712> ;
                                                                             gutprop:hasSentenceText "Different nutraceutical interventions have been devoted to normalizing gut microbiome dysbiosis and to improving biological outcomes in neurological conditions, including the use of probiotics." ;
                                                                             rdfs:label "sentence_33063712_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33063712_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33063712_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33063712> ;
                                                                             gutprop:hasSentenceText "Preclinical and clinical investigations discussed in this review strengthen the correlation between intestinal microbiota and brain and the concept that modifying the microbiome composition may improve brain neurochemistry, modulating different pathways." ;
                                                                             rdfs:label "sentence_33063712_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33063712_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33063712_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33063712> ;
                                                                             gutprop:hasSentenceText "This review will discuss the potential use of probiotics for Parkinson's disease prevention or treatment or as adjuvant therapy, confirming that gut microbiota modulation influences different pro-survival pathways." ;
                                                                             rdfs:label "sentence_33063712_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33063712_8
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33063712_8> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33063712> ;
                                                                             gutprop:hasSentenceText "Future investigations in Parkinson's disease should consider the role of the gut-brain axis and additional comprehension of the underlying mechanisms is extremely necessary." ;
                                                                             rdfs:label "sentence_33063712_8" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33067915_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33067915_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/33067915> ;
                                                                             gutprop:hasSentenceText "Interaction between Maternal Immune Activation and Antibiotic Use during Pregnancy and Child Risk of Autism Spectrum Disorder." ;
                                                                             rdfs:label "sentence_33067915_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33067915_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33067915_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33067915> ;
                                                                             gutprop:hasSentenceText "Prenatal exposure to maternal immune activation (MIA) has been implicated as a risk factor for the development of autism spectrum disorder (ASD), though the conditions under which this elevated risk occurs are unclear." ;
                                                                             rdfs:label "sentence_33067915_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33067915_10
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33067915_10> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33067915> ;
                                                                              gutprop:hasSentenceText "We examined 116 children with ASD and 860 without ASD and found that flu in second trimester was associated with increased ASD, but only among women who did not take an antibiotic during pregnancy." ;
                                                                              rdfs:label "sentence_33067915_10" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33067915_11
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33067915_11> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33067915> ;
                                                                              gutprop:hasSentenceText "No other immune activation exposures seemed to interact with antibiotic use." ;
                                                                              rdfs:label "sentence_33067915_11" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33067915_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33067915_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33067915> ;
                                                                             gutprop:hasSentenceText "Animal literature demonstrates that antibiotic use, which affects the composition of the maternal gut microbiota, modifies the effect of MIA on neurodevelopmental outcomes in the offspring." ;
                                                                             rdfs:label "sentence_33067915_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33067915_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33067915_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33067915> ;
                                                                             gutprop:hasSentenceText "The aim of this study was to assess whether antibiotic use during pregnancy modifies the association between MIA and subsequent risk of ASD, in a prospective birth cohort with 116 ASD cases and 860 typically developing (TD) child controls." ;
                                                                             rdfs:label "sentence_33067915_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33067915_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33067915_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33067915> ;
                                                                             gutprop:hasSentenceText "There was no evidence of interaction between fever or genitourinary infection and antibiotic use on the odds of ASD in unadjusted or adjusted analyzes." ;
                                                                             rdfs:label "sentence_33067915_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33067915_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33067915_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33067915> ;
                                                                             gutprop:hasSentenceText "However, we found evidence of an interaction between flu, specifically in second trimester, and antibiotic use at any point during pregnancy on the odds of ASD in the child." ;
                                                                             rdfs:label "sentence_33067915_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33067915_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33067915_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33067915> ;
                                                                             gutprop:hasSentenceText "Among women who received an antibiotic during pregnancy, flu in trimester two was not associated with ASD (adjusted odds ratio [aOR] = 0.99 [0.43-2.28])." ;
                                                                             rdfs:label "sentence_33067915_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33067915_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33067915_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33067915> ;
                                                                             gutprop:hasSentenceText "Among women who were not exposed to an antibiotic at any point during pregnancy, flu in second trimester was significantly associated with increased odds of ASD (aOR = 4.05 [1.14-14.38], P = .03), after adjustment for child sex, child birth year, maternal age, gestational age, C-section delivery, and low birthweight." ;
                                                                             rdfs:label "sentence_33067915_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33067915_8
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33067915_8> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33067915> ;
                                                                             gutprop:hasSentenceText "These findings should be treated as hypothesis-generating and suggest that antibiotic use may modify the influence that MIA has on autism risk in the child." ;
                                                                             rdfs:label "sentence_33067915_8" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33067915_9
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33067915_9> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33067915> ;
                                                                             gutprop:hasSentenceText "LAY SUMMARY: We looked at whether the association between activation of the immune system during pregnancy and risk of the child developing autism spectrum disorder (ASD) differed among women who did or did not take an antibiotic at any point during pregnancy." ;
                                                                             rdfs:label "sentence_33067915_9" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33076930_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33076930_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/33076930> ;
                                                                             gutprop:hasSentenceText "Gut bacterial deamination of residual levodopa medication for Parkinson's disease." ;
                                                                             rdfs:label "sentence_33076930_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33076930_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33076930_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33076930> ;
                                                                             gutprop:hasSentenceText "Parkinson's disease (PD) is a progressive neurodegenerative disorder characterized by both motor and non-motor symptoms." ;
                                                                             rdfs:label "sentence_33076930_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33076930_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33076930_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33076930> ;
                                                                             gutprop:hasSentenceText "Gastrointestinal tract dysfunction is one of the non-motor features, where constipation is reported as the most common gastrointestinal symptom." ;
                                                                             rdfs:label "sentence_33076930_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33076930_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33076930_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33076930> ;
                                                                             gutprop:hasSentenceText "Aromatic bacterial metabolites are attracting considerable attention due to their impact on gut homeostasis and host's physiology." ;
                                                                             rdfs:label "sentence_33076930_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33076930_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33076930_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33076930> ;
                                                                             gutprop:hasSentenceText "In particular, Clostridium sporogenes is a key contributor to the production of these bioactive metabolites in the human gut." ;
                                                                             rdfs:label "sentence_33076930_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33076930_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33076930_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33076930> ;
                                                                             gutprop:hasSentenceText "Here, we show that C. sporogenes deaminates levodopa, the main treatment in Parkinson's disease, and identify the aromatic aminotransferase responsible for the initiation of the deamination pathway." ;
                                                                             rdfs:label "sentence_33076930_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33076930_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33076930_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33076930> ;
                                                                             gutprop:hasSentenceText "The deaminated metabolite from levodopa, 3-(3,4-dihydroxyphenyl)propionic acid, elicits an inhibitory effect on ileal motility in an ex vivo model." ;
                                                                             rdfs:label "sentence_33076930_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33076930_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33076930_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33076930> ;
                                                                             gutprop:hasSentenceText "We detected 3-(3,4-dihydroxyphenyl)propionic acid in fecal samples of Parkinson's disease patients on levodopa medication and found that this metabolite is actively produced by the gut microbiota in those stool samples." ;
                                                                             rdfs:label "sentence_33076930_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33076930_8
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33076930_8> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33076930> ;
                                                                             gutprop:hasSentenceText "Levodopa is deaminated by the gut bacterium C. sporogenes producing a metabolite that inhibits ileal motility ex vivo." ;
                                                                             rdfs:label "sentence_33076930_8" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33076930_9
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33076930_9> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33076930> ;
                                                                             gutprop:hasSentenceText "Overall, this study underpins the importance of the metabolic pathways of the gut microbiome involved in drug metabolism not only to preserve drug effectiveness, but also to avoid potential side effects of bacterial breakdown products of the unabsorbed residue of medication." ;
                                                                             rdfs:label "sentence_33076930_9" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33092203_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33092203_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/33092203> ;
                                                                             gutprop:hasSentenceText "Clustering on Human Microbiome Sequencing Data: A Distance-Based Unsupervised Learning Model." ;
                                                                             rdfs:label "sentence_33092203_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33092203_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33092203_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33092203> ;
                                                                             gutprop:hasSentenceText "Modeling and analyzing human microbiome allows the assessment of the microbial community and its impacts on human health." ;
                                                                             rdfs:label "sentence_33092203_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33092203_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33092203_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33092203> ;
                                                                             gutprop:hasSentenceText "Microbiome composition can be quantified using 16S rRNA technology into sequencing data, which are usually skewed and heavy-tailed with excess zeros." ;
                                                                             rdfs:label "sentence_33092203_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33092203_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33092203_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33092203> ;
                                                                             gutprop:hasSentenceText "Clustering methods are useful in personalized medicine by identifying subgroups for patients stratification." ;
                                                                             rdfs:label "sentence_33092203_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33092203_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33092203_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33092203> ;
                                                                             gutprop:hasSentenceText "However, there is currently a lack of standardized clustering method for the complex microbiome sequencing data." ;
                                                                             rdfs:label "sentence_33092203_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33092203_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33092203_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33092203> ;
                                                                             gutprop:hasSentenceText "We propose a clustering algorithm with a specific beta diversity measure that can address the presence-absence bias encountered for sparse count data and effectively measure the sample distances for sample stratification." ;
                                                                             rdfs:label "sentence_33092203_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33092203_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33092203_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33092203> ;
                                                                             gutprop:hasSentenceText "Our distance measure used for clustering is derived from a parametric based mixture model producing sample-specific distributions conditional on the observed operational taxonomic unit (OTU) counts and estimated mixture weights." ;
                                                                             rdfs:label "sentence_33092203_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33092203_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33092203_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33092203> ;
                                                                             gutprop:hasSentenceText "The method can provide accurate estimates of the true zero proportions and thus construct a precise beta diversity measure." ;
                                                                             rdfs:label "sentence_33092203_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33092203_8
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33092203_8> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33092203> ;
                                                                             gutprop:hasSentenceText "Extensive simulation studies have been conducted and suggest that the proposed method achieves substantial clustering improvement compared with some widely used distance measures when a large proportion of zeros is presented." ;
                                                                             rdfs:label "sentence_33092203_8" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33092203_9
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33092203_9> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33092203> ;
                                                                             gutprop:hasSentenceText "The proposed algorithm was implemented to a human gut microbiome study on Parkinson's diseases to identify distinct microbiome states with biological interpretations." ;
                                                                             rdfs:label "sentence_33092203_9" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33105830_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33105830_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/33105830> ;
                                                                             gutprop:hasSentenceText "Probiotics in Treatment of Viral Respiratory Infections and Neuroinflammatory Disorders." ;
                                                                             rdfs:label "sentence_33105830_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33105830_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33105830_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33105830> ;
                                                                             gutprop:hasSentenceText "Inflammation is a biological response to the activation of the immune system by various infectious or non-infectious agents, which may lead to tissue damage and various diseases." ;
                                                                             rdfs:label "sentence_33105830_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33105830_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33105830_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33105830> ;
                                                                             gutprop:hasSentenceText "Gut commensal bacteria maintain a symbiotic relationship with the host and display a critical function in the homeostasis of the host immune system." ;
                                                                             rdfs:label "sentence_33105830_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33105830_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33105830_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33105830> ;
                                                                             gutprop:hasSentenceText "Disturbance to the gut microbiota leads to immune dysfunction both locally and at distant sites, which causes inflammatory conditions not only in the intestine but also in the other organs such as lungs and brain, and may induce a disease state." ;
                                                                             rdfs:label "sentence_33105830_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33105830_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33105830_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33105830> ;
                                                                             gutprop:hasSentenceText "Probiotics are well known to reinforce immunity and counteract inflammation by restoring symbiosis within the gut microbiota." ;
                                                                             rdfs:label "sentence_33105830_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33105830_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33105830_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33105830> ;
                                                                             gutprop:hasSentenceText "As a result, probiotics protect against various diseases, including respiratory infections and neuroinflammatory disorders." ;
                                                                             rdfs:label "sentence_33105830_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33105830_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33105830_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33105830> ;
                                                                             gutprop:hasSentenceText "A growing body of research supports the beneficial role of probiotics in lung and mental health through modulating the gut-lung and gut-brain axes." ;
                                                                             rdfs:label "sentence_33105830_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33105830_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33105830_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33105830> ;
                                                                             gutprop:hasSentenceText "In the current paper, we discuss the potential role of probiotics in the treatment of viral respiratory infections, including the COVID-19 disease, as major public health crisis in 2020, and influenza virus infection, as well as treatment of neurological disorders like multiple sclerosis and other mental illnesses." ;
                                                                             rdfs:label "sentence_33105830_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33144709_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33144709_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/33144709> ;
                                                                             gutprop:hasSentenceText "Diet and depression: exploring the biological mechanisms of action." ;
                                                                             rdfs:label "sentence_33144709_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33144709_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33144709_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33144709> ;
                                                                             gutprop:hasSentenceText "The field of nutritional psychiatry has generated observational and efficacy data supporting a role for healthy dietary patterns in depression onset and symptom management." ;
                                                                             rdfs:label "sentence_33144709_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33144709_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33144709_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33144709> ;
                                                                             gutprop:hasSentenceText "To guide future clinical trials and targeted dietary therapies, this review provides an overview of what is currently known regarding underlying mechanisms of action by which diet may influence mental and brain health." ;
                                                                             rdfs:label "sentence_33144709_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33144709_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33144709_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33144709> ;
                                                                             gutprop:hasSentenceText "The mechanisms of action associating diet with health outcomes are complex, multifaceted, interacting, and not restricted to any one biological pathway." ;
                                                                             rdfs:label "sentence_33144709_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33144709_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33144709_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33144709> ;
                                                                             gutprop:hasSentenceText "Numerous pathways were identified through which diet could plausibly affect mental health." ;
                                                                             rdfs:label "sentence_33144709_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33144709_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33144709_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33144709> ;
                                                                             gutprop:hasSentenceText "These include modulation of pathways involved in inflammation, oxidative stress, epigenetics, mitochondrial dysfunction, the gut microbiota, tryptophan-kynurenine metabolism, the HPA axis, neurogenesis and BDNF, epigenetics, and obesity." ;
                                                                             rdfs:label "sentence_33144709_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33144709_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33144709_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33144709> ;
                                                                             gutprop:hasSentenceText "However, the nascent nature of the nutritional psychiatry field to date means that the existing literature identified in this review is largely comprised of preclinical animal studies." ;
                                                                             rdfs:label "sentence_33144709_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33144709_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33144709_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33144709> ;
                                                                             gutprop:hasSentenceText "To fully identify and elucidate complex mechanisms of action, intervention studies that assess markers related to these pathways within clinically diagnosed human populations are needed." ;
                                                                             rdfs:label "sentence_33144709_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33177907_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33177907_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/33177907> ;
                                                                             gutprop:hasSentenceText "Gut Microbiota Changes and Their Relationship with Inflammation in Patients with Acute and Chronic Insomnia." ;
                                                                             rdfs:label "sentence_33177907_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33177907_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33177907_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33177907> ;
                                                                             gutprop:hasSentenceText "The major purpose of this study was to detect the changes in gut microbiota composition and inflammatory cytokines production associated with acute and chronic insomnia." ;
                                                                             rdfs:label "sentence_33177907_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33177907_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33177907_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33177907> ;
                                                                             gutprop:hasSentenceText "This study also evaluated the relationship between gut microbiota changes and increased inflammatory cytokines in insomnia patients." ;
                                                                             rdfs:label "sentence_33177907_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33177907_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33177907_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33177907> ;
                                                                             gutprop:hasSentenceText "Outpatients with acute and chronic insomnia (aged 26-55 years; n=20 and 38, respectively) and age/gender-matched healthy controls (n=38) were recruited from a southern China region." ;
                                                                             rdfs:label "sentence_33177907_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33177907_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33177907_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33177907> ;
                                                                             gutprop:hasSentenceText "Participants' gut microbiome, plasma cytokines, and self-reported sleep quality and psychopathological symptoms were measured." ;
                                                                             rdfs:label "sentence_33177907_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33177907_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33177907_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33177907> ;
                                                                             gutprop:hasSentenceText "The gut microbiomes of insomnia patients compared with healthy controls were characterized by lower microbial richness and diversity, depletion of anaerobes, and short-chain fatty acid (SCFA)-producing bacteria, and an expansion of potential pathobionts." ;
                                                                             rdfs:label "sentence_33177907_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33177907_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33177907_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33177907> ;
                                                                             gutprop:hasSentenceText "<i>Lachnospira</i> and <i>Bacteroides</i> were signature bacteria for distinguishing acute insomnia patients from healthy controls, while <i>Faecalibacterium</i> and <i>Blautia</i> were signature bacteria for distinguishing chronic insomnia patients from healthy controls." ;
                                                                             rdfs:label "sentence_33177907_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33177907_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33177907_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33177907> ;
                                                                             gutprop:hasSentenceText "Acute/chronic insomnia-related signature bacteria also showed correlations with these patients' self-reported sleep quality and plasma IL-1β." ;
                                                                             rdfs:label "sentence_33177907_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33177907_8
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33177907_8> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33177907> ;
                                                                             gutprop:hasSentenceText "These ﬁndings suggest that insomnia symptomology, gut microbiota, and inflammation may be interrelated in complex ways." ;
                                                                             rdfs:label "sentence_33177907_8" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33177907_9
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33177907_9> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33177907> ;
                                                                             gutprop:hasSentenceText "Gut microbiota may serve as an important indicator for auxiliary diagnosis of insomnia and provide possible new therapeutic targets in the ﬁeld of sleep disorders." ;
                                                                             rdfs:label "sentence_33177907_9" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33194817_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33194817_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/33194817> ;
                                                                             gutprop:hasSentenceText "Multiomics Study of Gut Bacteria and Host Metabolism in Irritable Bowel Syndrome and Depression Patients." ;
                                                                             rdfs:label "sentence_33194817_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33194817_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33194817_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33194817> ;
                                                                             gutprop:hasSentenceText "Irritable bowel syndrome (IBS) and depression have high tendencies of comorbidity." ;
                                                                             rdfs:label "sentence_33194817_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33194817_10
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33194817_10> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33194817> ;
                                                                              gutprop:hasSentenceText "These changes led us to propose a connection between genomic signatures and clinical differences observed in IBS-D and depression." ;
                                                                              rdfs:label "sentence_33194817_10" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33194817_11
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33194817_11> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33194817> ;
                                                                              gutprop:hasSentenceText "Our findings provide further insights into the involvement of gut microbiota in diseases related to brain-gut disorder." ;
                                                                              rdfs:label "sentence_33194817_11" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33194817_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33194817_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33194817> ;
                                                                             gutprop:hasSentenceText "In particular, diarrhea-predominant IBS (IBS-D) and depression exhibit similar fecal microbiota signatures, yet little is known about their pathogenic mechanism." ;
                                                                             rdfs:label "sentence_33194817_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33194817_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33194817_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33194817> ;
                                                                             gutprop:hasSentenceText "Here, we propose that the differences in structure and composition of IBS-D and depression gut microbiota give rise to different downstream functions, which lead to distinct clinical phenotypes <i>via</i> host metabolism and further influence the interaction of brain-gut axis." ;
                                                                             rdfs:label "sentence_33194817_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33194817_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33194817_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33194817> ;
                                                                             gutprop:hasSentenceText "We performed multiomics study, including fecal metagenome-wide sequencing and serum metabolomics profiling in 65 individuals with IBS-D (n=22), depression (n=15), comorbid patients (n=13), and healthy controls (n=15)." ;
                                                                             rdfs:label "sentence_33194817_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33194817_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33194817_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33194817> ;
                                                                             gutprop:hasSentenceText "We analyzed functional genes contributed by the primary genus and evaluated their correlations with clinical indices and host metabolites." ;
                                                                             rdfs:label "sentence_33194817_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33194817_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33194817_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33194817> ;
                                                                             gutprop:hasSentenceText "Metagenomic analysis revealed 26 clusters of orthologous groups of protein (COG) categories consisting of a total of 4,631 functional genes." ;
                                                                             rdfs:label "sentence_33194817_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33194817_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33194817_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33194817> ;
                                                                             gutprop:hasSentenceText "Trehalose and maltose hydrolase (COG1554) and fucose permease (COG0738) were the most relevant and enriched functional genes in the IBS-D patients; urease accessory proteins UreE (COG2371) was that in the depression patients." ;
                                                                             rdfs:label "sentence_33194817_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33194817_8
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33194817_8> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33194817> ;
                                                                             gutprop:hasSentenceText "Context based genome annotation suggest that an alteration of <i>Escherichia coli</i> and <i>Enterobacter cloacae</i> in IBS-D and depression respectively may be responsible for the enrichment described above." ;
                                                                             rdfs:label "sentence_33194817_8" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33194817_9
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33194817_9> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33194817> ;
                                                                             gutprop:hasSentenceText "Correlation with host metabolites, such as maltotriose and isomaltose in carbohydrate metabolism and anandamide in neuroactive metabolism, drew further connections between these findings." ;
                                                                             rdfs:label "sentence_33194817_9" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33195226_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33195226_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/33195226> ;
                                                                             gutprop:hasSentenceText "Microbiome Profiling Reveals Gut Dysbiosis in the Metabotropic Glutamate Receptor 5 Knockout Mouse Model of Schizophrenia." ;
                                                                             rdfs:label "sentence_33195226_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33195226_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33195226_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33195226> ;
                                                                             gutprop:hasSentenceText "Schizophrenia (SZ) is a psychiatric disorder that constitutes one of the top 10 global causes of disability." ;
                                                                             rdfs:label "sentence_33195226_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33195226_10
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33195226_10> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33195226> ;
                                                                              gutprop:hasSentenceText "Our discovery opens up new avenues to explore gut dysbiosis and its proposed links to brain dysfunction in SZ, as well as novel therapeutic approaches to this devastating disorder." ;
                                                                              rdfs:label "sentence_33195226_10" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33195226_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33195226_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33195226> ;
                                                                             gutprop:hasSentenceText "More recently, a potential pathogenic role for the gut microbial community (microbiota) has been highlighted, with numerous studies describing dysregulated microbial profiles in SZ patients when compared to healthy controls." ;
                                                                             rdfs:label "sentence_33195226_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33195226_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33195226_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33195226> ;
                                                                             gutprop:hasSentenceText "However, no animal model of SZ has previously recapitulated the gut dysbiosis observed clinically." ;
                                                                             rdfs:label "sentence_33195226_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33195226_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33195226_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33195226> ;
                                                                             gutprop:hasSentenceText "Since the metabotropic glutamate receptor 5 (mGlu5) knockout mice provide a preclinical model of SZ with strong face and predictive validity, in the present study we performed gut microbiome profiling of mGlu5 knockout (KO) and wild-type (WT) mice by 16S rRNA sequencing of bacterial genomic DNA from fecal samples, analyzing bacterial diversity and taxonomic composition, as well as gastrointestinal parameters as indicators of gut function." ;
                                                                             rdfs:label "sentence_33195226_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33195226_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33195226_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33195226> ;
                                                                             gutprop:hasSentenceText "We found a significant genotype difference in microbial beta diversity." ;
                                                                             rdfs:label "sentence_33195226_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33195226_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33195226_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33195226> ;
                                                                             gutprop:hasSentenceText "Analysis of composition of microbiomes (ANCOM) models were performed to evaluate microbiota compositions, which identified a decreased relative abundance of the <i>Erysipelotrichaceae</i> family and <i>Allobaculum</i> genus in this mouse model of SZ." ;
                                                                             rdfs:label "sentence_33195226_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33195226_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33195226_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33195226> ;
                                                                             gutprop:hasSentenceText "We also identified a signature of bacteria discriminating between the genotypes (KO and WT), consisting of the Erysipelotrichales, Bacteroidales, and Clostridiales orders and macroscopic gut differences." ;
                                                                             rdfs:label "sentence_33195226_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33195226_8
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33195226_8> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33195226> ;
                                                                             gutprop:hasSentenceText "We thus uncovered global differential community composition in the gut microbiota profile between mGlu5 KO and WT mice, outlining the first evidence for gut dysbiosis in a genetic animal model of SZ." ;
                                                                             rdfs:label "sentence_33195226_8" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33195226_9
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33195226_9> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33195226> ;
                                                                             gutprop:hasSentenceText "Our findings suggest that this widely used preclinical model of SZ also has substantial utility for investigations of gut dysbiosis and associated signaling via the microbiota-gut-brain axis, as potential modulators of SZ pathogenesis." ;
                                                                             rdfs:label "sentence_33195226_9" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33212907_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33212907_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/33212907> ;
                                                                             gutprop:hasSentenceText "PROFAST: A Randomized Trial Assessing the Effects of Intermittent Fasting and <i>Lacticaseibacillus rhamnosus</i> Probiotic among People with Prediabetes." ;
                                                                             rdfs:label "sentence_33212907_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33212907_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33212907_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33212907> ;
                                                                             gutprop:hasSentenceText "Both intermittent fasting and specific probiotics have shown promise in improving glucose tolerance with a potential for synergistic effects through alterations to gut microbiota." ;
                                                                             rdfs:label "sentence_33212907_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33212907_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33212907_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33212907> ;
                                                                             gutprop:hasSentenceText "In this randomized, double-blinded, two-arm feasibility study, we investigated whether intermittent fasting, supplemented with <i>Lacticaseibacillus rhamnosus</i> HN001 probiotic, reduces HbA1c in individuals with prediabetes." ;
                                                                             rdfs:label "sentence_33212907_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33212907_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33212907_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33212907> ;
                                                                             gutprop:hasSentenceText "All participants with HbA1c 40-50 mmol/mol commenced intermittent fasting (2 days per week of calorie restriction to 600-650 kcal/day) and were randomized 1:1 to either daily probiotic (<i>Lacticaseibacillus rhamnosus</i> HN001) or placebo for 12 weeks." ;
                                                                             rdfs:label "sentence_33212907_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33212907_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33212907_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33212907> ;
                                                                             gutprop:hasSentenceText "The primary outcome was a change in HbA1c." ;
                                                                             rdfs:label "sentence_33212907_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33212907_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33212907_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33212907> ;
                                                                             gutprop:hasSentenceText "Secondary outcomes included changes in anthropometry, body composition, glucoregulatory markers, lipids, hunger hormones, liver enzymes, inflammatory markers, gut hormones, calorie and macronutrient intake, quality of life, hunger, mood and eating behavior." ;
                                                                             rdfs:label "sentence_33212907_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33212907_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33212907_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33212907> ;
                                                                             gutprop:hasSentenceText "Of 33 participants who commenced the trial, 26 participants (mean age 52 years, body mass index (BMI) 34.7 kg/m<sup>2</sup>) completed the intervention (<i>n</i> = 11 placebo, <i>n</i> = 15 probiotic)." ;
                                                                             rdfs:label "sentence_33212907_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33212907_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33212907_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33212907> ;
                                                                             gutprop:hasSentenceText "HbA1c decreased from 43 ± 2.7 mmol/mol to 41 ± 2.3 mmol/mol, <i>p</i> < 0.001, with average of 5% weight loss." ;
                                                                             rdfs:label "sentence_33212907_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33212907_8
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33212907_8> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33212907> ;
                                                                             gutprop:hasSentenceText "No significant between-group differences were seen in primary or secondary outcomes except for social functioning (<i>p</i> = 0.050) and mental health (<i>p</i> = 0.007) scores as improvements were seen in the probiotic group, but not in the placebo group." ;
                                                                             rdfs:label "sentence_33212907_8" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33212907_9
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33212907_9> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33212907> ;
                                                                             gutprop:hasSentenceText "This study shows additional psychological benefits of probiotic supplementation during intermittent fasting to achieve weight loss and glycemic improvement in prediabetes." ;
                                                                             rdfs:label "sentence_33212907_9" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33240722_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33240722_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/33240722> ;
                                                                             gutprop:hasSentenceText "Gut-Brain Axis and its Neuro-Psychiatric Effects: A Narrative Review." ;
                                                                             rdfs:label "sentence_33240722_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33240722_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33240722_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33240722> ;
                                                                             gutprop:hasSentenceText "The gut microbiota regulates the function and health of the human gut." ;
                                                                             rdfs:label "sentence_33240722_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33240722_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33240722_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33240722> ;
                                                                             gutprop:hasSentenceText "Preliminary evidence suggests its impact on multiple human systems including the nervous and immune systems." ;
                                                                             rdfs:label "sentence_33240722_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33240722_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33240722_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33240722> ;
                                                                             gutprop:hasSentenceText "A major area of research has been the directional relationship between intestinal microbiota and the central nervous system (CNS), called the microbiota-gut-brain axis." ;
                                                                             rdfs:label "sentence_33240722_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33240722_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33240722_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33240722> ;
                                                                             gutprop:hasSentenceText "It is hypothesized that the intestinal microbiota affects brain activity and behavior via endocrine, neural, and immune pathways." ;
                                                                             rdfs:label "sentence_33240722_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33240722_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33240722_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33240722> ;
                                                                             gutprop:hasSentenceText "An alteration in the composition of the gut microbiome has been linked to a variety of neurodevelopmental and neurodegenerative disorders." ;
                                                                             rdfs:label "sentence_33240722_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33240722_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33240722_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33240722> ;
                                                                             gutprop:hasSentenceText "The connection between gut microbiome and several CNS disorders indicates that the focus of research in the future should be on the bacterial and biochemical targets." ;
                                                                             rdfs:label "sentence_33240722_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33240722_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33240722_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33240722> ;
                                                                             gutprop:hasSentenceText "Through this review, we outline the established knowledge regarding the gut microbiome and gut-brain axis." ;
                                                                             rdfs:label "sentence_33240722_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33240722_8
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33240722_8> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33240722> ;
                                                                             gutprop:hasSentenceText "In addition to gut microbiome in neurological and psychiatry diseases, we have briefly discussed microbial metabolites affecting the blood-brain barrier (BBB), immune dysregulation, modification of autonomic sensorimotor connections, and hypothalamus-pituitary-adrenal axis." ;
                                                                             rdfs:label "sentence_33240722_8" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33244049_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33244049_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/33244049> ;
                                                                             gutprop:hasSentenceText "Emotional well-being and gut microbiome profiles by enterotype." ;
                                                                             rdfs:label "sentence_33244049_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33244049_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33244049_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33244049> ;
                                                                             gutprop:hasSentenceText "With increasing attention being paid to improving emotional well-being, recent evidence points to gut microbiota as a key player in regulating mental and physical health via bidirectional communication between the brain and gut." ;
                                                                             rdfs:label "sentence_33244049_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33244049_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33244049_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33244049> ;
                                                                             gutprop:hasSentenceText "Here, we examine the association between emotional well-being and gut microbiome profiles (i.e., gut microbiome composition, diversity, and the moderating role of the enterotypes) among healthy Korean adults (n = 83, mean age = 48.9, SD = 13.2)." ;
                                                                             rdfs:label "sentence_33244049_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33244049_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33244049_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33244049> ;
                                                                             gutprop:hasSentenceText "The research was performed using high-throughput 16S rRNA gene sequencing to obtain gut microbiome profiles, as well as a self-report survey that included the Positive Affect Negative Affect Schedule (PANAS)." ;
                                                                             rdfs:label "sentence_33244049_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33244049_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33244049_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33244049> ;
                                                                             gutprop:hasSentenceText "The cluster-based analysis identified two enterotypes dominated by the genera Bacteroides (n = 49) and Prevotella (n = 34)." ;
                                                                             rdfs:label "sentence_33244049_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33244049_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33244049_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33244049> ;
                                                                             gutprop:hasSentenceText "Generalized linear regression analysis reveals significant associations between positive emotion and gut microbiome diversity (Shannon Index) among participants in the Prevotella dominant group, whereas no such relationship emerged among participants in the Bacteroides group." ;
                                                                             rdfs:label "sentence_33244049_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33244049_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33244049_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33244049> ;
                                                                             gutprop:hasSentenceText "Moreover, a novel genus from the family Lachnospiraceae is associated with emotional well-being scores, both positive and negative." ;
                                                                             rdfs:label "sentence_33244049_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33244049_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33244049_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33244049> ;
                                                                             gutprop:hasSentenceText "Together, the current findings highlight the enterotype-specific links between the gut microbiota community and emotion in healthy adults and suggest the possible roles of the gut microbiome in promoting mental health." ;
                                                                             rdfs:label "sentence_33244049_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33271210_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33271210_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/33271210> ;
                                                                             gutprop:hasSentenceText "A systematic review of microbiome changes and impact of probiotic supplementation in children and adolescents with neuropsychiatric disorders." ;
                                                                             rdfs:label "sentence_33271210_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33271210_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33271210_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33271210> ;
                                                                             gutprop:hasSentenceText "In recent decades, the diagnostic and therapeutic implications of the microbiome changes and the impact of probiotic supplementation have increased rapidly." ;
                                                                             rdfs:label "sentence_33271210_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33271210_10
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33271210_10> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33271210> ;
                                                                              gutprop:hasSentenceText "One study did not find significant differences in microbiome composition after micronutrient treatment." ;
                                                                              rdfs:label "sentence_33271210_10" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33271210_11
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33271210_11> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33271210> ;
                                                                              gutprop:hasSentenceText "The main goal of this systematic review was to comprehensively examine and summarize the current evidence focused on the potential effect of the relationship between microbiota gut composition as well as the effects of probiotic supplementation on psychiatric disorders in children and adolescents." ;
                                                                              rdfs:label "sentence_33271210_11" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33271210_12
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33271210_12> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33271210> ;
                                                                              gutprop:hasSentenceText "This is a relatively new area of research and the number of included studies is limited." ;
                                                                              rdfs:label "sentence_33271210_12" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33271210_13
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33271210_13> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33271210> ;
                                                                              gutprop:hasSentenceText "More studies are needed to determine whether gut dysbiosis leads to the development and/or contributes to the severity of mental disorders or whether gut dysbiosis is a result of other processes that accompany mental disorders." ;
                                                                              rdfs:label "sentence_33271210_13" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33271210_14
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33271210_14> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33271210> ;
                                                                              gutprop:hasSentenceText "A better understanding of the specific bacteria contributions, gut-brain pathways, and role in pathophysiological mechanisms in neuropsychiatric disorders in the child and adolescent populations can possibly provide alternative tools for a clinical psychiatrist." ;
                                                                              rdfs:label "sentence_33271210_14" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33271210_15
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33271210_15> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33271210> ;
                                                                              gutprop:hasSentenceText "Moreover, it may ultimately aid the clinician with intervention strategies, or detect populations at risk for developing neuropsychiatric disorders." ;
                                                                              rdfs:label "sentence_33271210_15" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33271210_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33271210_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33271210> ;
                                                                             gutprop:hasSentenceText "However, the potential for clinical translation of microbiome research for children and adolescents with psychiatric disorders is unclear." ;
                                                                             rdfs:label "sentence_33271210_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33271210_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33271210_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33271210> ;
                                                                             gutprop:hasSentenceText "This review examined available evidence related to gut microbiota as well as the impact of probiotic supplementation on psychiatric disorders in the pediatric population reported to date." ;
                                                                             rdfs:label "sentence_33271210_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33271210_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33271210_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33271210> ;
                                                                             gutprop:hasSentenceText "We performed a literature search for the gut microbiota in child and adolescent population (0-18 years old) with mental health disorders from July 1999 through July 2019 in several databases: ClinicalTrials.gov, Ovid EBM Reviews, Ovid Embase, Ovid Medline, Ovid PsycINFO, Scopus, and Web of Science." ;
                                                                             rdfs:label "sentence_33271210_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33271210_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33271210_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33271210> ;
                                                                             gutprop:hasSentenceText "A total of 7 studies met inclusion criteria consisting of randomized controlled trials and cohort studies that examined various associations between psychiatric disorders and gut microbiota in youth." ;
                                                                             rdfs:label "sentence_33271210_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33271210_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33271210_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33271210> ;
                                                                             gutprop:hasSentenceText "Six studies examined the effects of various treatment interventions such as probiotic supplementation on microbiota composition and behaviors." ;
                                                                             rdfs:label "sentence_33271210_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33271210_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33271210_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33271210> ;
                                                                             gutprop:hasSentenceText "One study showed an increase in prosocial behavior in children with Autism Spectrum Disorder (ASD) and an increase in the Lachnospiraceae family following prebiotic supplementation." ;
                                                                             rdfs:label "sentence_33271210_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33271210_8
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33271210_8> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33271210> ;
                                                                             gutprop:hasSentenceText "Another study suggested that prebiotic supplementation increased bifidobacterial populations for ASD and healthy controls." ;
                                                                             rdfs:label "sentence_33271210_8" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33271210_9
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33271210_9> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33271210> ;
                                                                             gutprop:hasSentenceText "A study evaluating infant supplementation of prebiotics showed both a decreased likelihood of developing Attention Deficit Hyperactivity Disorder (ADHD) or ASD and decreased gut Bifidobacterium." ;
                                                                             rdfs:label "sentence_33271210_9" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33271426_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33271426_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/33271426> ;
                                                                             gutprop:hasSentenceText "The gut microbiota in anxiety and depression - A systematic review." ;
                                                                             rdfs:label "sentence_33271426_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33271426_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33271426_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33271426> ;
                                                                             gutprop:hasSentenceText "Growing evidence indicates the community of microorganisms throughout the gastrointestinal tract, (i.e., gut microbiota), is associated with anxiety and depressive disorders." ;
                                                                             rdfs:label "sentence_33271426_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33271426_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33271426_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33271426> ;
                                                                             gutprop:hasSentenceText "We present the first systematic review of the gut microbiota in anxiety disorders, along with an update in depression." ;
                                                                             rdfs:label "sentence_33271426_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33271426_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33271426_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33271426> ;
                                                                             gutprop:hasSentenceText "Consideration of shared underlying features is essential due to the high rates of comorbidity." ;
                                                                             rdfs:label "sentence_33271426_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33271426_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33271426_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33271426> ;
                                                                             gutprop:hasSentenceText "Systematic searches, following PRISMA guidelines, identified 26 studies (two case-control comparisons of the gut microbiota in generalised anxiety disorder, 18 in depression, one incorporating both anxiety/depression, and five including symptom-only measures)." ;
                                                                             rdfs:label "sentence_33271426_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33271426_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33271426_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33271426> ;
                                                                             gutprop:hasSentenceText "Alpha and beta diversity findings were inconsistent; however, differences in bacterial taxa indicated disorders may be characterised by a higher abundance of proinflammatory species (e.g., Enterobacteriaceae and Desulfovibrio), and lower short-chain fatty acid producing-bacteria (e.g., Faecalibacterium)." ;
                                                                             rdfs:label "sentence_33271426_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33271426_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33271426_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33271426> ;
                                                                             gutprop:hasSentenceText "Several taxa, and their mechanisms of action, may relate to anxiety and depression pathophysiology via communication of peripheral inflammation to the brain." ;
                                                                             rdfs:label "sentence_33271426_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33271426_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33271426_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33271426> ;
                                                                             gutprop:hasSentenceText "Although the gut microbiota remains a promising target for prevention and therapy, future research should assess confounders, particularly diet and psychotropic medications, and should examine microorganism function." ;
                                                                             rdfs:label "sentence_33271426_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33287442_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33287442_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/33287442> ;
                                                                             gutprop:hasSentenceText "The Gut Microbiota: A Potential Gateway to Improved Health Outcomes in Breast Cancer Treatment and Survivorship." ;
                                                                             rdfs:label "sentence_33287442_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33287442_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33287442_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33287442> ;
                                                                             gutprop:hasSentenceText "Breast cancer is the most frequently diagnosed cancer in women worldwide." ;
                                                                             rdfs:label "sentence_33287442_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33287442_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33287442_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33287442> ;
                                                                             gutprop:hasSentenceText "The disease and its treatments exert profound effects on an individual's physical and mental health." ;
                                                                             rdfs:label "sentence_33287442_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33287442_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33287442_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33287442> ;
                                                                             gutprop:hasSentenceText "There are many factors that impact an individual's risk of developing breast cancer, their response to treatments, and their risk of recurrence." ;
                                                                             rdfs:label "sentence_33287442_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33287442_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33287442_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33287442> ;
                                                                             gutprop:hasSentenceText "The community of microorganisms inhabiting the gastrointestinal tract, the gut microbiota, affects human health through metabolic, neural, and endocrine signaling, and immune activity." ;
                                                                             rdfs:label "sentence_33287442_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33287442_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33287442_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33287442> ;
                                                                             gutprop:hasSentenceText "It is through these mechanisms that the gut microbiota appears to influence breast cancer risk, response to treatment, and recurrence." ;
                                                                             rdfs:label "sentence_33287442_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33287442_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33287442_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33287442> ;
                                                                             gutprop:hasSentenceText "A disrupted gut microbiota or state of 'dysbiosis' can contribute to a biological environment associated with higher risk for cancer development as well as contribute to negative treatment side-effects." ;
                                                                             rdfs:label "sentence_33287442_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33287442_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33287442_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33287442> ;
                                                                             gutprop:hasSentenceText "Many cancer treatments have been shown to shift the gut microbiota toward dysbiosis; however, the microbiota can also be positively manipulated through diet, prebiotic and probiotic supplementation, and exercise." ;
                                                                             rdfs:label "sentence_33287442_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33287442_8
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33287442_8> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33287442> ;
                                                                             gutprop:hasSentenceText "The objective of this review is to provide an overview of the current understanding of the relationship between the gut microbiota and breast cancer and to highlight potential strategies for modulation of the gut microbiota that could lead to improved clinical outcomes and overall health in this population." ;
                                                                             rdfs:label "sentence_33287442_8" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33301807_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33301807_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/33301807> ;
                                                                             gutprop:hasSentenceText "Spinal cord injury and gut microbiota: A review." ;
                                                                             rdfs:label "sentence_33301807_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33301807_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33301807_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33301807> ;
                                                                             gutprop:hasSentenceText "After spinal cord injury (SCI), intestinal dysfunction has a serious impact on physical and mental health, quality of life, and social participation." ;
                                                                             rdfs:label "sentence_33301807_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33301807_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33301807_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33301807> ;
                                                                             gutprop:hasSentenceText "Recent data from rodent and human studies indicated that SCI causes gut dysbiosis." ;
                                                                             rdfs:label "sentence_33301807_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33301807_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33301807_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33301807> ;
                                                                             gutprop:hasSentenceText "Remodeling gut microbiota could be beneficial for the recovery of intestinal function and motor function after SCI." ;
                                                                             rdfs:label "sentence_33301807_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33301807_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33301807_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33301807> ;
                                                                             gutprop:hasSentenceText "However, few studies have explored SCI with focus on the gut microbiota and \"microbiota-gut-brain\" axis." ;
                                                                             rdfs:label "sentence_33301807_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33301807_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33301807_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33301807> ;
                                                                             gutprop:hasSentenceText "In this review, the complications following SCI, including intestinal dysfunction, anxiety and depression, metabolic disorders, and neuropathic pain, are directly or indirectly related to gut dysbiosis, which may be mediated by \"gut-brain\" interactions." ;
                                                                             rdfs:label "sentence_33301807_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33301807_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33301807_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33301807> ;
                                                                             gutprop:hasSentenceText "Furthermore, we discuss the research strategies that can be beneficial in this regard, including germ-free animals, fecal microbiota transplantation, probiotics, phages, and brain imaging techniques." ;
                                                                             rdfs:label "sentence_33301807_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33301807_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33301807_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33301807> ;
                                                                             gutprop:hasSentenceText "The current microbial research has shifted from descriptive to mechanismal perspective, and future research using new technologies may further demonstrate the pathophysiological mechanism of association of SCI with gut microbiota, elucidate the mode of interaction of gut microbiota and hosts, and help develop personalized microbiota-targeted therapies and drugs based on microbiota or corresponding metabolites." ;
                                                                             rdfs:label "sentence_33301807_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33318317_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33318317_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/33318317> ;
                                                                             gutprop:hasSentenceText "Mental awareness improved mild cognitive impairment and modulated gut microbiome." ;
                                                                             rdfs:label "sentence_33318317_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33318317_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33318317_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33318317> ;
                                                                             gutprop:hasSentenceText "There is ample scientific and clinical evidence of the effects of gut microbiota on the brain but no definitive evidence that the brain can affect changes in gut microbiota under the bi-directional gut-brain axis concept." ;
                                                                             rdfs:label "sentence_33318317_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33318317_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33318317_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33318317> ;
                                                                             gutprop:hasSentenceText "As there is no pharmacotherapeutic intervention for the early stages of cognitive decline, research has focused on cognitive stimulation in reversing or slowing the impairment." ;
                                                                             rdfs:label "sentence_33318317_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33318317_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33318317_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33318317> ;
                                                                             gutprop:hasSentenceText "Elderly patients diagnosed with mild cognitive impairment underwent a randomized-control trial of mindful awareness practice." ;
                                                                             rdfs:label "sentence_33318317_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33318317_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33318317_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33318317> ;
                                                                             gutprop:hasSentenceText "Neuropsychological assessments, inflammatory markers, and gut microbiota profiles were tested." ;
                                                                             rdfs:label "sentence_33318317_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33318317_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33318317_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33318317> ;
                                                                             gutprop:hasSentenceText "Here, we report that their cognitive impairment was improved and associated with changes in gut bacterial profile." ;
                                                                             rdfs:label "sentence_33318317_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33318317_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33318317_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33318317> ;
                                                                             gutprop:hasSentenceText "A cognition-score-dependent-abundance was observed in <i>Ruminococcus</i> vs Recognition Trials (RT), Digit Span Backward (DSB), Semantic Fluency Span (SFS) and Memory Domain (MD); <i>Coprococcus</i> vs DSB, Color Trails Test 2 (CTT2) and Block Design (BD); <i>Parabacteroides</i> vs DSB and SFS; <i>Fusobacterium</i> vs DSB and CTT2; <i>Enterobacteriaceae</i> vs BD and SFS; <i>Ruminococcaceae</i> vs DSB; <i>Phascolarctobacterium</i> vs MD." ;
                                                                             rdfs:label "sentence_33318317_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33318317_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33318317_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33318317> ;
                                                                             gutprop:hasSentenceText "The study showed for the first-time, alteration in the cognitive capacity leading to the corresponding changes in microbiota profiles." ;
                                                                             rdfs:label "sentence_33318317_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33318317_8
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33318317_8> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33318317> ;
                                                                             gutprop:hasSentenceText "This strongly suggests that signals from the different segments of brain could dictate directly or indirectly the abundances of specific gut microbes." ;
                                                                             rdfs:label "sentence_33318317_8" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33327540_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33327540_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/33327540> ;
                                                                             gutprop:hasSentenceText "Ketogenic Diet: A Dietary Modification as an Anxiolytic Approach?" ;
                                                                             rdfs:label "sentence_33327540_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33327540_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33327540_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33327540> ;
                                                                             gutprop:hasSentenceText "Anxiety disorders comprise persistent, disabling conditions that are distributed across the globe, and are associated with the high medical and socioeconomic burden of the disease." ;
                                                                             rdfs:label "sentence_33327540_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33327540_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33327540_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33327540> ;
                                                                             gutprop:hasSentenceText "Within the array of biopsychosocial treatment modalities-including monoaminergic antidepressants, benzodiazepines, and CBT-there is an unmet need for the effective treatment of anxiety disorders resulting in full remission and recovery." ;
                                                                             rdfs:label "sentence_33327540_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33327540_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33327540_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33327540> ;
                                                                             gutprop:hasSentenceText "Nutritional intervention may be hypothesized as a promising treatment strategy; in particular, it facilitates relapse prevention." ;
                                                                             rdfs:label "sentence_33327540_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33327540_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33327540_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33327540> ;
                                                                             gutprop:hasSentenceText "Low-carbohydrate high-fat diets (LCHF) may provide a rewarding outcome for some anxiety disorders; more research is needed before this regimen can be recommended to patients on a daily basis, but the evidence mentioned in this paper should encourage researchers and clinicians to consider LCHF as a piece of advice somewhere between psychotherapy and pharmacology, or as an add-on to those two." ;
                                                                             rdfs:label "sentence_33327540_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33406628_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33406628_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/33406628> ;
                                                                             gutprop:hasSentenceText "Gut Microbiota Dysbiosis Is Associated with Elevated Bile Acids in Parkinson's Disease." ;
                                                                             rdfs:label "sentence_33406628_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33406628_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33406628_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33406628> ;
                                                                             gutprop:hasSentenceText "The gut microbiome can impact brain health and is altered in Parkinson's disease (PD)." ;
                                                                             rdfs:label "sentence_33406628_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33406628_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33406628_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33406628> ;
                                                                             gutprop:hasSentenceText "The vermiform appendix is a lymphoid tissue in the cecum implicated in the storage and regulation of the gut microbiota." ;
                                                                             rdfs:label "sentence_33406628_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33406628_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33406628_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33406628> ;
                                                                             gutprop:hasSentenceText "We sought to determine whether the appendix microbiome is altered in PD and to analyze the biological consequences of the microbial alterations." ;
                                                                             rdfs:label "sentence_33406628_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33406628_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33406628_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33406628> ;
                                                                             gutprop:hasSentenceText "We investigated the changes in the functional microbiota in the appendix of PD patients relative to controls (<i>n</i> = 12 PD, 16 C) by metatranscriptomic analysis." ;
                                                                             rdfs:label "sentence_33406628_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33406628_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33406628_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33406628> ;
                                                                             gutprop:hasSentenceText "We found microbial dysbiosis affecting lipid metabolism, including an upregulation of bacteria responsible for secondary bile acid synthesis." ;
                                                                             rdfs:label "sentence_33406628_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33406628_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33406628_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33406628> ;
                                                                             gutprop:hasSentenceText "We then quantitatively measure changes in bile acid abundance in PD relative to the controls in the appendix (<i>n</i> = 15 PD, 12 C) and ileum (<i>n</i> = 20 PD, 20 C)." ;
                                                                             rdfs:label "sentence_33406628_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33406628_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33406628_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33406628> ;
                                                                             gutprop:hasSentenceText "Bile acid analysis in the PD appendix reveals an increase in hydrophobic and secondary bile acids, deoxycholic acid (DCA) and lithocholic acid (LCA)." ;
                                                                             rdfs:label "sentence_33406628_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33406628_8
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33406628_8> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33406628> ;
                                                                             gutprop:hasSentenceText "Further proteomic and transcriptomic analysis in the appendix and ileum corroborated these findings, highlighting changes in the PD gut that are consistent with a disruption in bile acid control, including alterations in mediators of cholesterol homeostasis and lipid metabolism." ;
                                                                             rdfs:label "sentence_33406628_8" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33406628_9
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33406628_9> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33406628> ;
                                                                             gutprop:hasSentenceText "Microbially derived toxic bile acids are heightened in PD, which suggests biliary abnormalities may play a role in PD pathogenesis." ;
                                                                             rdfs:label "sentence_33406628_9" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33416892_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33416892_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/33416892> ;
                                                                             gutprop:hasSentenceText "Effects of dietary restriction on neuroinflammation in neurodegenerative diseases." ;
                                                                             rdfs:label "sentence_33416892_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33416892_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33416892_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33416892> ;
                                                                             gutprop:hasSentenceText "Recent and accumulating work in experimental animal models and humans shows that diet has a much more pervasive and prominent role than previously thought in modulating neuroinflammatory and neurodegenerative mechanisms leading to some of the most common chronic central nervous system (CNS) diseases." ;
                                                                             rdfs:label "sentence_33416892_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33416892_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33416892_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33416892> ;
                                                                             gutprop:hasSentenceText "Chronic or intermittent food restriction has profound effects in shaping brain and peripheral metabolism, immunity, and gut microbiome biology." ;
                                                                             rdfs:label "sentence_33416892_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33416892_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33416892_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33416892> ;
                                                                             gutprop:hasSentenceText "Interactions among calorie intake, meal frequency, diet quality, and the gut microbiome modulate specific metabolic and molecular pathways that regulate cellular, tissue, and organ homeostasis as well as inflammation during normal brain aging and CNS neurodegenerative diseases, including Alzheimer's disease, Parkinson's disease, amyotrophic lateral sclerosis, and multiple sclerosis, among others." ;
                                                                             rdfs:label "sentence_33416892_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33416892_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33416892_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33416892> ;
                                                                             gutprop:hasSentenceText "This review discusses these findings and their potential application to the prevention and treatment of CNS neuroinflammatory diseases and the promotion of healthy brain aging." ;
                                                                             rdfs:label "sentence_33416892_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33422110_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33422110_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/33422110> ;
                                                                             gutprop:hasSentenceText "The impact of dextran sodium sulphate and probiotic pre-treatment in a murine model of Parkinson's disease." ;
                                                                             rdfs:label "sentence_33422110_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33422110_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33422110_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33422110> ;
                                                                             gutprop:hasSentenceText "Recent work has established that Parkinson's disease (PD) patients have an altered gut microbiome, along with signs of intestinal inflammation." ;
                                                                             rdfs:label "sentence_33422110_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33422110_10
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33422110_10> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33422110> ;
                                                                              gutprop:hasSentenceText "Yet, neither DSS nor VSL#3 influenced the loss of substantia nigra dopamine neurons or the astrocytic and cytoskeleton remodeling protein changes that were provoked by the LPS followed by paraquat treatment." ;
                                                                              rdfs:label "sentence_33422110_10" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33422110_11
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33422110_11> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33422110> ;
                                                                              gutprop:hasSentenceText "These data suggest that disruption of the intestinal integrity and the associated microbiome can interact with systemic inflammatory events to promote widespread brain-gut changes that could be relevant for PD and at the very least, suggestive of novel neuro-immune communication." ;
                                                                              rdfs:label "sentence_33422110_11" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33422110_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33422110_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33422110> ;
                                                                             gutprop:hasSentenceText "This could help explain the high degree of gastric disturbances in PD patients, as well as potentially be linked to the migration of peripheral inflammatory factors into the brain." ;
                                                                             rdfs:label "sentence_33422110_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33422110_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33422110_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33422110> ;
                                                                             gutprop:hasSentenceText "To our knowledge, this is the first study to examine microbiome alteration prior to the induction of a PD murine model." ;
                                                                             rdfs:label "sentence_33422110_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33422110_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33422110_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33422110> ;
                                                                             gutprop:hasSentenceText "We presently assessed whether pre-treatment with the probiotic, VSL #3, or the inflammatory inducer, dextran sodium sulphate (DSS), would influence the PD-like pathology provoked by a dual hit toxin model using lipopolysaccharide (LPS) and paraquat exposure." ;
                                                                             rdfs:label "sentence_33422110_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33422110_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33422110_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33422110> ;
                                                                             gutprop:hasSentenceText "While VSL #3 has been reported to have anti-inflammatory effects, DSS is often used as a model of colitis because of the gut inflammation and the breach of the intestinal barrier that it induces." ;
                                                                             rdfs:label "sentence_33422110_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33422110_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33422110_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33422110> ;
                                                                             gutprop:hasSentenceText "We found that VSL#3 did not have any significant effects (beyond a blunting of LPS paraquat-induced weight loss)." ;
                                                                             rdfs:label "sentence_33422110_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33422110_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33422110_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33422110> ;
                                                                             gutprop:hasSentenceText "However, the DSS treatment caused marked changes in the gut microbiome and was also associated with augmented behavioral and inflammatory outcomes." ;
                                                                             rdfs:label "sentence_33422110_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33422110_8
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33422110_8> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33422110> ;
                                                                             gutprop:hasSentenceText "In fact, DSS markedly increased taxa belonging to the Bacteroidaceae and Porphyromonadaceae families but reduced those from Rikencellaceae and S24-7, as well as provoking colonic pro-inflammatory cytokine expression, consistent with an inflamed gut." ;
                                                                             rdfs:label "sentence_33422110_8" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33422110_9
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33422110_9> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33422110> ;
                                                                             gutprop:hasSentenceText "The DSS also increased the impact of LPS plus paraquat upon microglial morphology, along with circulating lipocalin-2 (neutrophil marker) and IL-6." ;
                                                                             rdfs:label "sentence_33422110_9" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33454868_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33454868_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/33454868> ;
                                                                             gutprop:hasSentenceText "Gut microbiota homeostasis restoration may become a novel therapy for breast cancer." ;
                                                                             rdfs:label "sentence_33454868_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33454868_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33454868_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33454868> ;
                                                                             gutprop:hasSentenceText "Breast cancer is the most diagnosed cancer in women." ;
                                                                             rdfs:label "sentence_33454868_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33454868_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33454868_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33454868> ;
                                                                             gutprop:hasSentenceText "It significantly impairs a patient's physical and mental health." ;
                                                                             rdfs:label "sentence_33454868_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33454868_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33454868_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33454868> ;
                                                                             gutprop:hasSentenceText "Gut microbiota comprise the bacteria residing in a host's gastrointestinal tract." ;
                                                                             rdfs:label "sentence_33454868_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33454868_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33454868_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33454868> ;
                                                                             gutprop:hasSentenceText "Through studies over the last decade, we now know that alterations in the composition of the gut microbiome are associated with protection against colonization by pathogens and other diseases, such as diabetes and cancer." ;
                                                                             rdfs:label "sentence_33454868_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33454868_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33454868_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33454868> ;
                                                                             gutprop:hasSentenceText "This review focuses on how gut microbiota can affect breast cancer development through estrogen activity and discusses the types of bacteria that may be involved in the onset and the progression of breast cancer." ;
                                                                             rdfs:label "sentence_33454868_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33454868_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33454868_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33454868> ;
                                                                             gutprop:hasSentenceText "We also describe potential therapies to curtail the risk of breast cancer by restoring gut microbiota homeostasis and reducing systemic estrogen levels." ;
                                                                             rdfs:label "sentence_33454868_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33454868_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33454868_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33454868> ;
                                                                             gutprop:hasSentenceText "This review will further explore the relationship between intestinal microbes and breast cancer and propose a method to treat breast cancer by improving intestinal microbes." ;
                                                                             rdfs:label "sentence_33454868_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33454868_8
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33454868_8> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33454868> ;
                                                                             gutprop:hasSentenceText "We aimed at discovering new methods to prevent or treat BC by changing intestinal microorganisms." ;
                                                                             rdfs:label "sentence_33454868_8" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33467657_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33467657_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/33467657> ;
                                                                             gutprop:hasSentenceText "Mechanisms Underlying the Cognitive and Behavioural Effects of Maternal Obesity." ;
                                                                             rdfs:label "sentence_33467657_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33467657_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33467657_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33467657> ;
                                                                             gutprop:hasSentenceText "The widespread consumption of 'western'-style diets along with sedentary lifestyles has led to a global epidemic of obesity." ;
                                                                             rdfs:label "sentence_33467657_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33467657_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33467657_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33467657> ;
                                                                             gutprop:hasSentenceText "Epidemiological, clinical and preclinical evidence suggests that maternal obesity, overnutrition and unhealthy dietary patterns programs have lasting adverse effects on the physical and mental health of offspring." ;
                                                                             rdfs:label "sentence_33467657_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33467657_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33467657_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33467657> ;
                                                                             gutprop:hasSentenceText "We review currently available preclinical and clinical evidence and summarise possible underlying neurobiological mechanisms by which maternal overnutrition may perturb offspring cognitive function, affective state and psychosocial behaviour, with a focus on (1) neuroinflammation; (2) disrupted neuronal circuities and connectivity; and (3) dysregulated brain hormones." ;
                                                                             rdfs:label "sentence_33467657_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33467657_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33467657_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33467657> ;
                                                                             gutprop:hasSentenceText "We briefly summarise research implicating the gut microbiota in maternal obesity-induced changes to offspring behaviour." ;
                                                                             rdfs:label "sentence_33467657_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33467657_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33467657_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33467657> ;
                                                                             gutprop:hasSentenceText "In animal models, maternal obesogenic diet consumption disrupts CNS homeostasis in offspring, which is critical for healthy neurodevelopment, by altering hypothalamic and hippocampal development and recruitment of glial cells, which subsequently dysregulates dopaminergic and serotonergic systems." ;
                                                                             rdfs:label "sentence_33467657_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33467657_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33467657_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33467657> ;
                                                                             gutprop:hasSentenceText "The adverse effects of maternal obesogenic diets are also conferred through changes to hormones including leptin, insulin and oxytocin which interact with these brain regions and neuronal circuits." ;
                                                                             rdfs:label "sentence_33467657_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33467657_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33467657_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33467657> ;
                                                                             gutprop:hasSentenceText "Furthermore, accumulating evidence suggests that the gut microbiome may directly and indirectly contribute to these maternal diet effects in both human and animal studies." ;
                                                                             rdfs:label "sentence_33467657_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33467657_8
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33467657_8> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33467657> ;
                                                                             gutprop:hasSentenceText "As the specific pathways shaping abnormal behaviour in offspring in the context of maternal obesogenic diet exposure remain unknown, further investigations are needed to address this knowledge gap." ;
                                                                             rdfs:label "sentence_33467657_8" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33467657_9
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33467657_9> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33467657> ;
                                                                             gutprop:hasSentenceText "Use of animal models permits investigation of changes in neuroinflammation, neurotransmitter activity and hormones across global brain network and sex differences, which could be directly and indirectly modulated by the gut microbiome." ;
                                                                             rdfs:label "sentence_33467657_9" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33505487_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33505487_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/33505487> ;
                                                                             gutprop:hasSentenceText "Acupoint Massage Therapy Alters the Composition of Gut Microbiome in Functional Constipation Patients." ;
                                                                             rdfs:label "sentence_33505487_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33505487_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33505487_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33505487> ;
                                                                             gutprop:hasSentenceText "Results showed the overall structure of gut microbiome has no significant difference between experimental and control groups." ;
                                                                             rdfs:label "sentence_33505487_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33505487_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33505487_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33505487> ;
                                                                             gutprop:hasSentenceText "In the genus level, the abundance of <i>Pseudobutyrivibrio</i> and <i>Ruminiclostridium</i> is higher in the experiment group than in the control, whereas that of <i>Fusicatenibacter</i> is less." ;
                                                                             rdfs:label "sentence_33505487_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33505487_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33505487_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33505487> ;
                                                                             gutprop:hasSentenceText "The 16S KEGG function prediction suggested that Parkinson disease, retinol metabolism, and arachidonic acid metabolism could explain the biological function of different gut microbiome." ;
                                                                             rdfs:label "sentence_33505487_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33505487_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33505487_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33505487> ;
                                                                             gutprop:hasSentenceText "Furthermore, cytokines in the serum showed a correlation with the abundance of <i>Pseudobutyrivibrio</i> in CFC." ;
                                                                             rdfs:label "sentence_33505487_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33505487_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33505487_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33505487> ;
                                                                             gutprop:hasSentenceText "AMT could change the composition of gut microbiome which is associated with cytokines in CFC patients." ;
                                                                             rdfs:label "sentence_33505487_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33511258_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33511258_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/33511258> ;
                                                                             gutprop:hasSentenceText "Probiotic consumption relieved human stress and anxiety symptoms possibly via modulating the neuroactive potential of the gut microbiota." ;
                                                                             rdfs:label "sentence_33511258_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33511258_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33511258_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33511258> ;
                                                                             gutprop:hasSentenceText "Stress has been shown to disturb the balance of human intestinal microbiota and subsequently causes mental health problems like anxiety and depression." ;
                                                                             rdfs:label "sentence_33511258_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33511258_10
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33511258_10> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33511258> ;
                                                                              gutprop:hasSentenceText "Our results showed a potential link between probiotic-induced gut microbiota modulation and stress/anxiety alleviation in stressed adults, supporting that the gut-brain axis was involved in relieving stress-related symptoms." ;
                                                                              rdfs:label "sentence_33511258_10" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33511258_11
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33511258_11> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33511258> ;
                                                                              gutprop:hasSentenceText "The beneficial effect relied not only on microbial diversity changes but more importantly gut metagenome modulations at the SGB and functional gene levels." ;
                                                                              rdfs:label "sentence_33511258_11" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33511258_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33511258_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33511258> ;
                                                                             gutprop:hasSentenceText "Our previous study showed that ingesting the probiotic strain, <i>Lactobacillus</i> (<i>L</i>.)" ;
                                                                             rdfs:label "sentence_33511258_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33511258_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33511258_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33511258> ;
                                                                             gutprop:hasSentenceText "<i>plantarum</i> P-8, for 12 weeks could alleviate stress and anxiety of stressed adults." ;
                                                                             rdfs:label "sentence_33511258_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33511258_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33511258_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33511258> ;
                                                                             gutprop:hasSentenceText "The current study was a follow-up work aiming to investigate the functional role of the gut metagenomes in the observed beneficial effects." ;
                                                                             rdfs:label "sentence_33511258_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33511258_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33511258_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33511258> ;
                                                                             gutprop:hasSentenceText "The fecal metagenomes of the probiotic (n = 43) and placebo (n = 36) receivers were analyzed in depth." ;
                                                                             rdfs:label "sentence_33511258_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33511258_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33511258_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33511258> ;
                                                                             gutprop:hasSentenceText "The gut microbiomes of the placebo group at weeks 0 and 12 showed a significantly greater Aitchison distance (<i>P</i> < 0.001) compared with the probiotic group." ;
                                                                             rdfs:label "sentence_33511258_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33511258_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33511258_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33511258> ;
                                                                             gutprop:hasSentenceText "Meanwhile, the Shannon diversity index of the placebo group (<i>P</i> < 0.05) but not the probiotic group decreased significantly at week 12." ;
                                                                             rdfs:label "sentence_33511258_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33511258_8
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33511258_8> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33511258> ;
                                                                             gutprop:hasSentenceText "Additionally, significantly more species-level genome bins (SGBs) of <i>Bifidobacterium adolescentis</i>, <i>Bifidobacterium longum</i>, and <i>Fecalibacterium prausnitzii</i> (<i>P</i> < 0.01) were identified in the fecal metagenomes of the probiotic group, while the abundances of SGBs representing the species <i>Roseburia faecis</i> and <i>Fusicatenibacter saccharivorans</i> decreased significantly (<i>P</i> < 0.05)." ;
                                                                             rdfs:label "sentence_33511258_8" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33511258_9
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33511258_9> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33511258> ;
                                                                             gutprop:hasSentenceText "Furthermore, the 12-week probiotic supplementation enhanced the diversity of neurotransmitter-synthesizing/consuming SGBs and the levels of some predicted microbial neuroactive metabolites (e.g., short-chain fatty acids, gamma-aminobutyric acid, arachidonic acid, and sphingomyelin)." ;
                                                                             rdfs:label "sentence_33511258_9" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33514545_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33514545_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/33514545> ;
                                                                             gutprop:hasSentenceText "Human physiomimetic model integrating microphysiological systems of the gut, liver, and brain for studies of neurodegenerative diseases." ;
                                                                             rdfs:label "sentence_33514545_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33514545_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33514545_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33514545> ;
                                                                             gutprop:hasSentenceText "Slow progress in the fight against neurodegenerative diseases (NDs) motivates an urgent need for highly controlled in vitro systems to investigate organ-organ- and organ-immune-specific interactions relevant for disease pathophysiology." ;
                                                                             rdfs:label "sentence_33514545_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33514545_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33514545_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33514545> ;
                                                                             gutprop:hasSentenceText "Of particular interest is the gut/microbiome-liver-brain axis for parsing out how genetic and environmental factors contribute to NDs." ;
                                                                             rdfs:label "sentence_33514545_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33514545_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33514545_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33514545> ;
                                                                             gutprop:hasSentenceText "We have developed a mesofluidic platform technology to study gut-liver-cerebral interactions in the context of Parkinson's disease (PD)." ;
                                                                             rdfs:label "sentence_33514545_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33514545_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33514545_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33514545> ;
                                                                             gutprop:hasSentenceText "It connects microphysiological systems (MPSs) of the primary human gut and liver with a human induced pluripotent stem cell-derived cerebral MPS in a systemically circulated common culture medium containing CD4<sup>+</sup> regulatory T and T helper 17 cells." ;
                                                                             rdfs:label "sentence_33514545_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33514545_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33514545_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33514545> ;
                                                                             gutprop:hasSentenceText "We demonstrate this approach using a patient-derived cerebral MPS carrying the PD-causing A53T mutation, gaining two important findings: (i) that systemic interaction enhances features of in vivo-like behavior of cerebral MPSs, and (ii) that microbiome-associated short-chain fatty acids increase expression of pathology-associated pathways in PD." ;
                                                                             rdfs:label "sentence_33514545_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33651324_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33651324_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/33651324> ;
                                                                             gutprop:hasSentenceText "Gut microbiota dysbiosis is associated with worse emotional states in HIV infection." ;
                                                                             rdfs:label "sentence_33651324_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33651324_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33651324_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33651324> ;
                                                                             gutprop:hasSentenceText "The biological mechanisms underlying emotional distress in HIV infection are likely to be complex but remain understudied." ;
                                                                             rdfs:label "sentence_33651324_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33651324_10
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33651324_10> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33651324> ;
                                                                              gutprop:hasSentenceText "Higher levels of aerotolerant bacteria were associated with worse psychological well-being (rho = -0.35, p = 0.02), less social satisfaction (r = - 0.42, p < 0.01), and more negative affect (rho = 0.46, p < 0.01)." ;
                                                                              rdfs:label "sentence_33651324_10" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33651324_11
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33651324_11> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33651324> ;
                                                                              gutprop:hasSentenceText "The association of aerotolerant bacteria with social satisfaction and negative affect was independent of HIV status (p < 0.05, for both)." ;
                                                                              rdfs:label "sentence_33651324_11" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33651324_12
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33651324_12> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33651324> ;
                                                                              gutprop:hasSentenceText "The over-representation of aerotolerant bacteria in the gut may reflect worse oxidative stress and barrier defects and may contribute to emotional distress during HIV infection." ;
                                                                              rdfs:label "sentence_33651324_12" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33651324_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33651324_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33651324> ;
                                                                             gutprop:hasSentenceText "We investigated whether dysbiotic signatures in the gut microbiome of persons living with HIV (PLWH) are associated with their emotional status." ;
                                                                             rdfs:label "sentence_33651324_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33651324_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33651324_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33651324> ;
                                                                             gutprop:hasSentenceText "We retrospectively examined the gut microbiome and clinical evaluation of 129 adults (94 PLWH and 35 HIV-) enrolled at UC San Diego's HIV Neurobehavioral Research Program." ;
                                                                             rdfs:label "sentence_33651324_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33651324_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33651324_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33651324> ;
                                                                             gutprop:hasSentenceText "A subset of participants (32 PLWH vs. 13 HIV-) underwent an emotional assessment using the NIH Toolbox Emotion Battery summarized by three composite scores (negative affect, social satisfaction, and psychological well-being)." ;
                                                                             rdfs:label "sentence_33651324_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33651324_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33651324_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33651324> ;
                                                                             gutprop:hasSentenceText "We then sequenced the 16S rDNA V3-V4 regions from stool and performed taxonomic assignment using CLC Microbial Genomics Module." ;
                                                                             rdfs:label "sentence_33651324_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33651324_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33651324_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33651324> ;
                                                                             gutprop:hasSentenceText "The gut microbiota profiles were evaluated in relation to participants' emotional assessment." ;
                                                                             rdfs:label "sentence_33651324_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33651324_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33651324_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33651324> ;
                                                                             gutprop:hasSentenceText "All analyses were done in R statistical software." ;
                                                                             rdfs:label "sentence_33651324_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33651324_8
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33651324_8> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33651324> ;
                                                                             gutprop:hasSentenceText "We found that the relative abundance of aerotolerant bacteria was significantly higher in PLWH (p < 0.01) and was associated with a lifetime major depression diagnosis independently of HIV status (p = 0.05)." ;
                                                                             rdfs:label "sentence_33651324_8" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33651324_9
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33651324_9> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33651324> ;
                                                                             gutprop:hasSentenceText "Moreover, PLWH experienced significantly worse psychological well-being (p = 0.02), less social satisfaction (p = 0.03), and more negative affect (p = 0.02)." ;
                                                                             rdfs:label "sentence_33651324_9" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33664475_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33664475_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/33664475> ;
                                                                             gutprop:hasSentenceText "Sialylated human milk oligosaccharides program cognitive development through a non-genomic transmission mode." ;
                                                                             rdfs:label "sentence_33664475_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33664475_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33664475_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33664475> ;
                                                                             gutprop:hasSentenceText "Breastmilk contains bioactive molecules essential for brain and cognitive development." ;
                                                                             rdfs:label "sentence_33664475_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33664475_10
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33664475_10> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33664475> ;
                                                                              gutprop:hasSentenceText "Compared to control mice, WT offspring deprived of 6'SL during lactation exhibited consistent alterations in all cognitive functions addressed, hippocampal electrophysiology, and in pathways regulating the serotonergic system (identified through gut microbiota and plasma metabolomics)." ;
                                                                              rdfs:label "sentence_33664475_10" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33664475_11
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33664475_11> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33664475> ;
                                                                              gutprop:hasSentenceText "These were associated with a site- (PFC) and time-specific (eye-opening) reduced expression of genes involved in central nervous system development." ;
                                                                              rdfs:label "sentence_33664475_11" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33664475_12
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33664475_12> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33664475> ;
                                                                              gutprop:hasSentenceText "Our data suggest that 6'SL in maternal milk adjusts cognitive development through a short-term upregulation of genes modulating neuronal patterning in the PFC." ;
                                                                              rdfs:label "sentence_33664475_12" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33664475_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33664475_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33664475> ;
                                                                             gutprop:hasSentenceText "While sialylated human milk oligosaccharides (HMOs) have been implicated in phenotypic programming, their selective role and underlying mechanisms remained elusive." ;
                                                                             rdfs:label "sentence_33664475_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33664475_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33664475_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33664475> ;
                                                                             gutprop:hasSentenceText "Here, we investigated the long-term consequences of a selective lactational deprivation of a specific sialylated HMO in mice." ;
                                                                             rdfs:label "sentence_33664475_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33664475_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33664475_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33664475> ;
                                                                             gutprop:hasSentenceText "We capitalized on a knock-out (KO) mouse model (B6.129-St6gal1<sup>tm2Jxm</sup>/J) lacking the gene responsible for the synthesis of sialyl(alpha2,6)lactose (6'SL), one of the two sources of sialic acid (Neu5Ac) to the lactating offspring." ;
                                                                             rdfs:label "sentence_33664475_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33664475_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33664475_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33664475> ;
                                                                             gutprop:hasSentenceText "Neu5Ac is involved in the formation of brain structures sustaining cognition." ;
                                                                             rdfs:label "sentence_33664475_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33664475_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33664475_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33664475> ;
                                                                             gutprop:hasSentenceText "To deprive lactating offspring of 6'SL, we cross-fostered newborn wild-type (WT) pups to KO dams, which provide 6'SL-deficient milk." ;
                                                                             rdfs:label "sentence_33664475_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33664475_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33664475_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33664475> ;
                                                                             gutprop:hasSentenceText "To test whether lactational 6'SL deprivation affects cognitive capabilities in adulthood, we assessed attention, perseveration, and memory." ;
                                                                             rdfs:label "sentence_33664475_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33664475_8
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33664475_8> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33664475> ;
                                                                             gutprop:hasSentenceText "To detail the associated endophenotypes, we investigated hippocampal electrophysiology, plasma metabolomics, and gut microbiota composition." ;
                                                                             rdfs:label "sentence_33664475_8" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33664475_9
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33664475_9> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33664475> ;
                                                                             gutprop:hasSentenceText "To investigate the underlying molecular mechanisms, we assessed gene expression (at eye-opening and in adulthood) in two brain regions mediating executive functions and memory (hippocampus and prefrontal cortex, PFC)." ;
                                                                             rdfs:label "sentence_33664475_9" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33677218_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33677218_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/33677218> ;
                                                                             gutprop:hasSentenceText "Fecal microbiota transplantation ameliorates stress-induced depression-like behaviors associated with the inhibition of glial and NLRP3 inflammasome in rat brain." ;
                                                                             rdfs:label "sentence_33677218_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33677218_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33677218_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33677218> ;
                                                                             gutprop:hasSentenceText "Evidence from previous studies has demonstrated that the gut-microbiota-brain axis is vital in regulating of behavior and neuroinflammation in the central nervous system." ;
                                                                             rdfs:label "sentence_33677218_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33677218_10
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33677218_10> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33677218> ;
                                                                              gutprop:hasSentenceText "The anti-depression effects of fecal microbiota transplantation were associated with the suppressed activation of glial cells and NLRP3 inflammasome in the brain." ;
                                                                              rdfs:label "sentence_33677218_10" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33677218_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33677218_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33677218> ;
                                                                             gutprop:hasSentenceText "Considering the putative connection among gut microbiota, neural function, and behavior, the present study investigated the potential signaling of gut microbiota to modulate depression-like behaviors and neuroinflammation." ;
                                                                             rdfs:label "sentence_33677218_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33677218_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33677218_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33677218> ;
                                                                             gutprop:hasSentenceText "Rats showing depression-like behaviors induced by chronic unpredictable mild stress received fecal microbiota treatment or vehicle for 14 days, and alterations in behavior and neuroinflammation were assessed." ;
                                                                             rdfs:label "sentence_33677218_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33677218_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33677218_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33677218> ;
                                                                             gutprop:hasSentenceText "ELISA, immunofluorescence staining and Western blot were used to analysis the activation of glial cells and NLRP3 inflammasome." ;
                                                                             rdfs:label "sentence_33677218_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33677218_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33677218_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33677218> ;
                                                                             gutprop:hasSentenceText "Treatment with fecal microbiota transplantation ameliorated depression-like behaviors." ;
                                                                             rdfs:label "sentence_33677218_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33677218_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33677218_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33677218> ;
                                                                             gutprop:hasSentenceText "5-Hydroxytryptamine decreased in the chronic unpredictable mild stress rat model but significantly increased after fecal microbiota transplantation." ;
                                                                             rdfs:label "sentence_33677218_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33677218_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33677218_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33677218> ;
                                                                             gutprop:hasSentenceText "The treatment with fecal microbiota transplantation decreased the production of IL-1β and TNF-α." ;
                                                                             rdfs:label "sentence_33677218_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33677218_8
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33677218_8> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33677218> ;
                                                                             gutprop:hasSentenceText "Moreover, fecal microbiota transplantation administration suppressed the activation of Iba1 positive microglia cells and GFAP positive astrocytes cells and reduced the expression of NLRP3, ASC, Caspase-1, and IL-1β pathway in the prefrontal cortex and hippocampus." ;
                                                                             rdfs:label "sentence_33677218_8" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33677218_9
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33677218_9> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33677218> ;
                                                                             gutprop:hasSentenceText "Fecal microbiota transplantation can improve depression-like behaviors induced by chronic unpredictable mild stress." ;
                                                                             rdfs:label "sentence_33677218_9" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33692356_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33692356_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/33692356> ;
                                                                             gutprop:hasSentenceText "Meta-analysis of the Parkinson's disease gut microbiome suggests alterations linked to intestinal inflammation." ;
                                                                             rdfs:label "sentence_33692356_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33692356_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33692356_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33692356> ;
                                                                             gutprop:hasSentenceText "The gut microbiota is emerging as an important modulator of neurodegenerative diseases, and accumulating evidence has linked gut microbes to Parkinson's disease (PD) symptomatology and pathophysiology." ;
                                                                             rdfs:label "sentence_33692356_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33692356_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33692356_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33692356> ;
                                                                             gutprop:hasSentenceText "PD is often preceded by gastrointestinal symptoms and alterations of the enteric nervous system accompany the disease." ;
                                                                             rdfs:label "sentence_33692356_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33692356_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33692356_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33692356> ;
                                                                             gutprop:hasSentenceText "Several studies have analyzed the gut microbiome in PD, but a consensus on the features of the PD-specific microbiota is missing." ;
                                                                             rdfs:label "sentence_33692356_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33692356_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33692356_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33692356> ;
                                                                             gutprop:hasSentenceText "Here, we conduct a meta-analysis re-analyzing the ten currently available 16S microbiome datasets to investigate whether common alterations in the gut microbiota of PD patients exist across cohorts." ;
                                                                             rdfs:label "sentence_33692356_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33692356_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33692356_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33692356> ;
                                                                             gutprop:hasSentenceText "We found significant alterations in the PD-associated microbiome, which are robust to study-specific technical heterogeneities, although differences in microbiome structure between PD and controls are small." ;
                                                                             rdfs:label "sentence_33692356_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33692356_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33692356_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33692356> ;
                                                                             gutprop:hasSentenceText "Enrichment of the genera Lactobacillus, Akkermansia, and Bifidobacterium and depletion of bacteria belonging to the Lachnospiraceae family and the Faecalibacterium genus, both important short-chain fatty acids producers, emerged as the most consistent PD gut microbiome alterations." ;
                                                                             rdfs:label "sentence_33692356_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33692356_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33692356_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33692356> ;
                                                                             gutprop:hasSentenceText "This dysbiosis might result in a pro-inflammatory status which could be linked to the recurrent gastrointestinal symptoms affecting PD patients." ;
                                                                             rdfs:label "sentence_33692356_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33693453_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33693453_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/33693453> ;
                                                                             gutprop:hasSentenceText "Diet and the Microbiota-Gut-Brain Axis: Sowing the Seeds of Good Mental Health." ;
                                                                             rdfs:label "sentence_33693453_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33693453_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33693453_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33693453> ;
                                                                             gutprop:hasSentenceText "Over the past decade, the gut microbiota has emerged as a key component in regulating brain processes and behavior." ;
                                                                             rdfs:label "sentence_33693453_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33693453_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33693453_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33693453> ;
                                                                             gutprop:hasSentenceText "Diet is one of the major factors involved in shaping the gut microbiota composition across the lifespan." ;
                                                                             rdfs:label "sentence_33693453_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33693453_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33693453_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33693453> ;
                                                                             gutprop:hasSentenceText "However, whether and how diet can affect the brain via its effects on the microbiota is only now beginning to receive attention." ;
                                                                             rdfs:label "sentence_33693453_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33693453_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33693453_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33693453> ;
                                                                             gutprop:hasSentenceText "Several mechanisms for gut-to-brain communication have been identified, including microbial metabolites, immune, neuronal, and metabolic pathways, some of which could be prone to dietary modulation." ;
                                                                             rdfs:label "sentence_33693453_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33693453_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33693453_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33693453> ;
                                                                             gutprop:hasSentenceText "Animal studies investigating the potential of nutritional interventions on the microbiota-gut-brain axis have led to advancements in our understanding of the role of diet in this bidirectional communication." ;
                                                                             rdfs:label "sentence_33693453_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33693453_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33693453_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33693453> ;
                                                                             gutprop:hasSentenceText "In this review, we summarize the current state of the literature triangulating diet, microbiota, and host behavior/brain processes and discuss potential underlying mechanisms." ;
                                                                             rdfs:label "sentence_33693453_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33693453_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33693453_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33693453> ;
                                                                             gutprop:hasSentenceText "Additionally, determinants of the responsiveness to a dietary intervention and evidence for the microbiota as an underlying modulator of the effect of diet on brain health are outlined." ;
                                                                             rdfs:label "sentence_33693453_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33693453_8
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33693453_8> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33693453> ;
                                                                             gutprop:hasSentenceText "In particular, we emphasize the understudied use of whole-dietary approaches in this endeavor and the need for greater evidence from clinical populations." ;
                                                                             rdfs:label "sentence_33693453_8" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33693453_9
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33693453_9> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33693453> ;
                                                                             gutprop:hasSentenceText "While promising results are reported, additional data, specifically from clinical cohorts, are required to provide evidence-based recommendations for the development of microbiota-targeted, whole-dietary strategies to improve brain and mental health." ;
                                                                             rdfs:label "sentence_33693453_9" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33713734_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33713734_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/33713734> ;
                                                                             gutprop:hasSentenceText "Affective disorders impact prevalence of Flavonifractor and abundance of Christensenellaceae in gut microbiota." ;
                                                                             rdfs:label "sentence_33713734_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33713734_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33713734_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33713734> ;
                                                                             gutprop:hasSentenceText "Background Affective disorders (AD) have been associated with a higher prevalence of the gut Flavonifractor genus and a lower abundance of the gut Christensenellaceae family." ;
                                                                             rdfs:label "sentence_33713734_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33713734_10
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33713734_10> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33713734> ;
                                                                              gutprop:hasSentenceText "Conclusion Compared with findings in healthy controls, AD was associated with a significantly lower CLR abundance of the health-linked Christensenellaceae and a significantly higher prevalence of Flavonifractor; findings that are associated with enhanced oxidative stress and systemic low-grade inflammation." ;
                                                                              rdfs:label "sentence_33713734_10" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33713734_11
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33713734_11> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33713734> ;
                                                                              gutprop:hasSentenceText "If our observations are validated in future independent studies, they support the notion that parts of aberrant gut microbiota are shared by AD and states of dysmetabolism." ;
                                                                              rdfs:label "sentence_33713734_11" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33713734_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33713734_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33713734> ;
                                                                             gutprop:hasSentenceText "Objective and methods By pooling two independent study samples of patients with AD (n = 176), their unaffected first-degree relatives (n = 70) and healthy controls (n = 101) we aimed to replicate and extend our prior findings of differential Flavonifractor prevalence and Christensenellaceae abundance when comparing patients with AD and healthy controls." ;
                                                                             rdfs:label "sentence_33713734_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33713734_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33713734_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33713734> ;
                                                                             gutprop:hasSentenceText "The gut microbiota was profiled using 16S rRNA gene amplicon sequencing." ;
                                                                             rdfs:label "sentence_33713734_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33713734_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33713734_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33713734> ;
                                                                             gutprop:hasSentenceText "Results The pattern of higher prevalence of Flavonifractor and lower Centered Log-Ratio (CLR) abundance of Christensenellaceae was associated with AD." ;
                                                                             rdfs:label "sentence_33713734_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33713734_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33713734_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33713734> ;
                                                                             gutprop:hasSentenceText "In generalized linear models the CLR abundance of Christensenellaceae was lower in patients with AD (p = 0.024), and in smokers (p = 1.9*10<sup>-4</sup>), and inversely associated with increasing waist circumference (p = 0.031)." ;
                                                                             rdfs:label "sentence_33713734_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33713734_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33713734_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33713734> ;
                                                                             gutprop:hasSentenceText "The prevalence of Flavonifractor was higher in patients with AD (p = 0.033) and in smokers (p = 0.036)." ;
                                                                             rdfs:label "sentence_33713734_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33713734_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33713734_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33713734> ;
                                                                             gutprop:hasSentenceText "No impact of psychotropic medication was found." ;
                                                                             rdfs:label "sentence_33713734_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33713734_8
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33713734_8> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33713734> ;
                                                                             gutprop:hasSentenceText "The CLR abundance of Christensenellaceae (p = 0.041), but not the prevalence of Flavonifractor (p = 0.20) could distinguish non-smoking patients with AD from non-smoking healthy controls, whereas no such associations were found in smokers." ;
                                                                             rdfs:label "sentence_33713734_8" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33713734_9
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33713734_9> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33713734> ;
                                                                             gutprop:hasSentenceText "Unaffected relatives neither differed from patients with AD nor from healthy controls." ;
                                                                             rdfs:label "sentence_33713734_9" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33722869_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33722869_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/33722869> ;
                                                                             gutprop:hasSentenceText "Bugs and Brains, the Gut and Mental Health Study: a mixed-methods study investigating microbiota composition and function in anxiety, depression and irritable bowel syndrome." ;
                                                                             rdfs:label "sentence_33722869_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33722869_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33722869_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33722869> ;
                                                                             gutprop:hasSentenceText "Research has highlighted relationships between the micro-organisms that inhabit our gastrointestinal tract (oral and gut microbiota) with host mood and gastrointestinal functioning." ;
                                                                             rdfs:label "sentence_33722869_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33722869_10
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33722869_10> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33722869> ;
                                                                              gutprop:hasSentenceText "Approval was granted by the University of Melbourne Human Research Ethics Committee (#1749221)." ;
                                                                              rdfs:label "sentence_33722869_10" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33722869_11
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33722869_11> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33722869> ;
                                                                              gutprop:hasSentenceText "All participants voluntarily provided informed consent." ;
                                                                              rdfs:label "sentence_33722869_11" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33722869_12
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33722869_12> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33722869> ;
                                                                              gutprop:hasSentenceText "Results will be published in peer-reviewed journals and presented at scientific conferences." ;
                                                                              rdfs:label "sentence_33722869_12" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33722869_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33722869_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33722869> ;
                                                                             gutprop:hasSentenceText "Mental health disorders and functional gastrointestinal disorders co-occur at high rates, although the mechanisms underlying these associations remain unclear." ;
                                                                             rdfs:label "sentence_33722869_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33722869_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33722869_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33722869> ;
                                                                             gutprop:hasSentenceText "The Bugs and Brains Study aims to investigate complex relationships between anxiety/depression and irritable bowel syndrome (IBS) in two ways." ;
                                                                             rdfs:label "sentence_33722869_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33722869_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33722869_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33722869> ;
                                                                             gutprop:hasSentenceText "First, its primary component will compare the gut and oral microbiota in females with anxiety/depression and/or IBS relative to controls, and investigate underlying physiological, endocrine and immune factors, as well as associations with diet and psychosocial factors." ;
                                                                             rdfs:label "sentence_33722869_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33722869_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33722869_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33722869> ;
                                                                             gutprop:hasSentenceText "In an ancillary component, the study will also investigate gastrointestinal and mental health symptoms in a larger sample, and explore relationships with diet, exercise, oral health, substance use, medical history, early life adversity and psychosocial factors." ;
                                                                             rdfs:label "sentence_33722869_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33722869_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33722869_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33722869> ;
                                                                             gutprop:hasSentenceText "The Bugs and Brains Study aims to recruit 160 females to the primary component: (1) 40 controls; (2) 40 participants with a depressive/anxiety disorder, but no IBS; (3) 40 participants with IBS, but no depressive/anxiety disorder and (4) 40 participants with both depressive/anxiety disorder and IBS." ;
                                                                             rdfs:label "sentence_33722869_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33722869_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33722869_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33722869> ;
                                                                             gutprop:hasSentenceText "Participation is completed within 1 month, and involves comprehensive questionnaires, anthropometrics, a diagnostic clinical interview, collection of two saliva samples, and stool, urine and hair samples." ;
                                                                             rdfs:label "sentence_33722869_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33722869_8
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33722869_8> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33722869> ;
                                                                             gutprop:hasSentenceText "This study aims to use a systems biology approach to characterise oral and gut microbial composition <u>and</u> function using 16S rRNA gene sequencing and nuclear MR spectroscopy." ;
                                                                             rdfs:label "sentence_33722869_8" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33722869_9
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33722869_9> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33722869> ;
                                                                             gutprop:hasSentenceText "As part of the ancillary component, it will collect questionnaire data from 1000 participants aged 18-40 years, capturing mental health, gastrointestinal health, oral health, diet and psychosocial factors." ;
                                                                             rdfs:label "sentence_33722869_9" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33777957_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33777957_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/33777957> ;
                                                                             gutprop:hasSentenceText "Brain Neurotransmitter Modulation by Gut Microbiota in Anxiety and Depression." ;
                                                                             rdfs:label "sentence_33777957_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33777957_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33777957_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33777957> ;
                                                                             gutprop:hasSentenceText "Anxiety and depression are highly prevalent mental illnesses worldwide and have long been thought to be closely associated to neurotransmitter modulation." ;
                                                                             rdfs:label "sentence_33777957_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33777957_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33777957_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33777957> ;
                                                                             gutprop:hasSentenceText "There is growing evidence indicating that changes in the composition of the gut microbiota are related to mental health including anxiety and depression." ;
                                                                             rdfs:label "sentence_33777957_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33777957_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33777957_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33777957> ;
                                                                             gutprop:hasSentenceText "In this review, we focus on combining the intestinal microbiota with serotonergic, dopaminergic, and noradrenergic neurotransmission in brain, with special emphasis on the anxiety- and depression-like behaviors in stress-related rodent models." ;
                                                                             rdfs:label "sentence_33777957_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33777957_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33777957_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33777957> ;
                                                                             gutprop:hasSentenceText "Therefore, we reviewed studies conducted on germ-free rodents, or in animals subjected to microbiota absence using antibiotics, as well as via the usage of probiotics." ;
                                                                             rdfs:label "sentence_33777957_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33777957_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33777957_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33777957> ;
                                                                             gutprop:hasSentenceText "All the results strongly support that the brain neurotransmitter modulation by gut microbiota is indispensable to the physiopathology of anxiety and depression." ;
                                                                             rdfs:label "sentence_33777957_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33777957_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33777957_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33777957> ;
                                                                             gutprop:hasSentenceText "However, a lot of work is needed to determine how gut microbiota mediated neurotransmission in human brain has any physiological significance and, if any, how it can be used in therapy." ;
                                                                             rdfs:label "sentence_33777957_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33777957_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33777957_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33777957> ;
                                                                             gutprop:hasSentenceText "Overall, the gut microbiota provides a novel way to alter neurotransmitter modulation in the brain and treat gut-brain axis diseases, such as anxiety and depression." ;
                                                                             rdfs:label "sentence_33777957_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33782648_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33782648_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/33782648> ;
                                                                             gutprop:hasSentenceText "Preventing and Treating Neurological Disorders with the Flavonol Fisetin." ;
                                                                             rdfs:label "sentence_33782648_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33782648_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33782648_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33782648> ;
                                                                             gutprop:hasSentenceText "Neurological disorders, including neurodegenerative diseases, have a significant negative impact on both patients and society at large." ;
                                                                             rdfs:label "sentence_33782648_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33782648_10
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33782648_10> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33782648> ;
                                                                              gutprop:hasSentenceText "Therefore, the growing body of pre-clinical data, along with fisetin's ability to modulate a large number of pathways associated with brain dysfunction, strongly suggest that it would be worthwhile to pursue its therapeutic effects in humans." ;
                                                                              rdfs:label "sentence_33782648_10" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33782648_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33782648_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33782648> ;
                                                                             gutprop:hasSentenceText "Since the prevalence of most of these disorders increases with age, the consequences for our aging population are only going to grow." ;
                                                                             rdfs:label "sentence_33782648_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33782648_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33782648_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33782648> ;
                                                                             gutprop:hasSentenceText "It is now acknowledged that neurological disorders are multi-factorial involving disruptions in multiple cellular systems." ;
                                                                             rdfs:label "sentence_33782648_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33782648_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33782648_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33782648> ;
                                                                             gutprop:hasSentenceText "While each disorder has specific initiating mechanisms and pathologies, certain common pathways appear to be involved in most, if not all, neurological disorders." ;
                                                                             rdfs:label "sentence_33782648_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33782648_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33782648_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33782648> ;
                                                                             gutprop:hasSentenceText "Thus, it is becoming increasingly important to identify compounds that can modulate the multiple pathways that contribute to disease development or progression." ;
                                                                             rdfs:label "sentence_33782648_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33782648_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33782648_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33782648> ;
                                                                             gutprop:hasSentenceText "One of these compounds is the flavonol fisetin." ;
                                                                             rdfs:label "sentence_33782648_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33782648_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33782648_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33782648> ;
                                                                             gutprop:hasSentenceText "Fisetin has now been shown in preclinical models to be effective at preventing the development and/or progression of multiple neurological disorders including Alzheimer's disease, Parkinson's disease, Huntington's disease, amyotrophic lateral sclerosis, stroke (both ischemic and hemorrhagic) and traumatic brain injury as well as to reduce age-associated changes in the brain." ;
                                                                             rdfs:label "sentence_33782648_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33782648_8
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33782648_8> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33782648> ;
                                                                             gutprop:hasSentenceText "These beneficial effects stem from its actions on multiple pathways associated with the different neurological disorders." ;
                                                                             rdfs:label "sentence_33782648_8" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33782648_9
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33782648_9> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33782648> ;
                                                                             gutprop:hasSentenceText "These actions include its well characterized anti-inflammatory and anti-oxidant effects as well as more recently described effects on the regulated cell death oxytosis/ferroptosis pathway, the gut microbiome and its senolytic activity." ;
                                                                             rdfs:label "sentence_33782648_9" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33807447_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33807447_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/33807447> ;
                                                                             gutprop:hasSentenceText "Changes in Gut Microbiota after a Four-Week Intervention with Vegan vs. Meat-Rich Diets in Healthy Participants: A Randomized Controlled Trial." ;
                                                                             rdfs:label "sentence_33807447_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33807447_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33807447_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33807447> ;
                                                                             gutprop:hasSentenceText "An essential role of the gut microbiota in health and disease is strongly suggested by recent research." ;
                                                                             rdfs:label "sentence_33807447_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33807447_10
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33807447_10> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33807447> ;
                                                                              gutprop:hasSentenceText "Importantly, changes in genera <i>Coprococcus, Roseburia</i> and <i>Faecalibacterium</i> should be subjected to intense investigation as markers for physical and mental health." ;
                                                                              rdfs:label "sentence_33807447_10" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33807447_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33807447_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33807447> ;
                                                                             gutprop:hasSentenceText "The composition of the gut microbiota is modified by multiple internal and external factors, such as diet." ;
                                                                             rdfs:label "sentence_33807447_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33807447_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33807447_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33807447> ;
                                                                             gutprop:hasSentenceText "A vegan diet is known to show beneficial health effects, yet the role of the gut microbiota is unclear." ;
                                                                             rdfs:label "sentence_33807447_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33807447_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33807447_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33807447> ;
                                                                             gutprop:hasSentenceText "Within a 4-week, monocentric, randomized, controlled trial with a parallel group design (vegan (VD) vs. meat-rich (MD)) with 53 healthy, omnivore, normal-weight participants (62% female, mean 31 years of age), fecal samples were collected at the beginning and at the end of the trial and were analyzed using 16S rRNA gene amplicon sequencing (Clinical Trial register: DRKS00011963)." ;
                                                                             rdfs:label "sentence_33807447_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33807447_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33807447_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33807447> ;
                                                                             gutprop:hasSentenceText "Alpha diversity as well as beta diversity did not differ significantly between MD and VD." ;
                                                                             rdfs:label "sentence_33807447_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33807447_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33807447_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33807447> ;
                                                                             gutprop:hasSentenceText "Plotting of baseline and end samples emphasized a highly intra-individual microbial composition." ;
                                                                             rdfs:label "sentence_33807447_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33807447_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33807447_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33807447> ;
                                                                             gutprop:hasSentenceText "Overall, the gut microbiota was not remarkably altered between VD and MD after the trial." ;
                                                                             rdfs:label "sentence_33807447_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33807447_8
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33807447_8> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33807447> ;
                                                                             gutprop:hasSentenceText "<i>Coprococcus</i> was found to be increased in VD while being decreased in MD." ;
                                                                             rdfs:label "sentence_33807447_8" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33807447_9
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33807447_9> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33807447> ;
                                                                             gutprop:hasSentenceText "<i>Roseburia</i> and <i>Faecalibacterium</i> were increased in MD while being decreased in VD." ;
                                                                             rdfs:label "sentence_33807447_9" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33819374_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33819374_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/33819374> ;
                                                                             gutprop:hasSentenceText "Trimethylamine modulates dauer formation, neurodegeneration, and lifespan through tyra-3/daf-11 signaling in Caenorhabditis elegans." ;
                                                                             rdfs:label "sentence_33819374_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33819374_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33819374_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33819374> ;
                                                                             gutprop:hasSentenceText "In the nematode Caenorhabditis elegans, signals derived from bacteria in the diet, the animal's major nutrient source, can modulate both behavior and healthspan." ;
                                                                             rdfs:label "sentence_33819374_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33819374_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33819374_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33819374> ;
                                                                             gutprop:hasSentenceText "Here we describe a dual role for trimethylamine (TMA), a human gut flora metabolite, which acts as a nutrient signal and a neurotoxin." ;
                                                                             rdfs:label "sentence_33819374_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33819374_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33819374_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33819374> ;
                                                                             gutprop:hasSentenceText "TMA and its associated metabolites are produced by the human gut microbiome and have been suggested to serve as risk biomarkers for diabetes and cardiovascular diseases." ;
                                                                             rdfs:label "sentence_33819374_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33819374_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33819374_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33819374> ;
                                                                             gutprop:hasSentenceText "We demonstrate that the tyramine receptor TYRA-3, a conserved G protein-coupled receptor (GPCR), is required to sense TMA and mediate its responses." ;
                                                                             rdfs:label "sentence_33819374_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33819374_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33819374_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33819374> ;
                                                                             gutprop:hasSentenceText "TMA activates guanylyl cyclase DAF-11 signaling through TYRA-3 in amphid neurons (ASK) and ciliated neurons (BAG) to mediate food-sensing behavior." ;
                                                                             rdfs:label "sentence_33819374_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33819374_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33819374_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33819374> ;
                                                                             gutprop:hasSentenceText "Bacterial mutants deficient in TMA production enhance dauer formation, extend lifespan, and are less preferred as a food source." ;
                                                                             rdfs:label "sentence_33819374_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33819374_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33819374_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33819374> ;
                                                                             gutprop:hasSentenceText "Increased levels of TMA lead to neural damage in models of Parkinson's disease and shorten lifespan." ;
                                                                             rdfs:label "sentence_33819374_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33819374_8
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33819374_8> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33819374> ;
                                                                             gutprop:hasSentenceText "Our results reveal conserved signaling pathways modulated by TMA in C. elegans that are likely to be relevant for its effects in mammalian systems." ;
                                                                             rdfs:label "sentence_33819374_8" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33825149_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33825149_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/33825149> ;
                                                                             gutprop:hasSentenceText "Gut Microbial Metabolites in Parkinson's Disease: Implications of Mitochondrial Dysfunction in the Pathogenesis and Treatment." ;
                                                                             rdfs:label "sentence_33825149_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33825149_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33825149_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33825149> ;
                                                                             gutprop:hasSentenceText "The search for therapeutic targets for Parkinson's disease (PD) is hindered by the incomplete understanding of the pathophysiology of the disease." ;
                                                                             rdfs:label "sentence_33825149_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33825149_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33825149_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33825149> ;
                                                                             gutprop:hasSentenceText "Mitochondrial dysfunction is an area with high potential." ;
                                                                             rdfs:label "sentence_33825149_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33825149_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33825149_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33825149> ;
                                                                             gutprop:hasSentenceText "The neurobiological signaling connections between the gut microbiome and the central nervous system are incompletely understood." ;
                                                                             rdfs:label "sentence_33825149_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33825149_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33825149_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33825149> ;
                                                                             gutprop:hasSentenceText "Multiple lines of evidence suggest that the gut microbiota participates in the pathogenesis of PD." ;
                                                                             rdfs:label "sentence_33825149_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33825149_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33825149_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33825149> ;
                                                                             gutprop:hasSentenceText "Gut microbial dysbiosis may contribute to the loss of dopaminergic neurons through mitochondrial dysfunction." ;
                                                                             rdfs:label "sentence_33825149_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33825149_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33825149_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33825149> ;
                                                                             gutprop:hasSentenceText "The intervention of gut microbial metabolites via the microbiota-gut-brain axis may serve as a promising therapeutic strategy for PD." ;
                                                                             rdfs:label "sentence_33825149_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33825149_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33825149_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33825149> ;
                                                                             gutprop:hasSentenceText "In this narrative review, we summarize the potential roles of gut microbial dysbiosis in PD, with emphasis on microbial metabolites and mitochondrial function." ;
                                                                             rdfs:label "sentence_33825149_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33825149_8
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33825149_8> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33825149> ;
                                                                             gutprop:hasSentenceText "We then review the possible ways in which microbial metabolites affect the central nervous system, as well as the impact of microbial metabolites on mitochondrial dysfunction." ;
                                                                             rdfs:label "sentence_33825149_8" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33825149_9
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33825149_9> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33825149> ;
                                                                             gutprop:hasSentenceText "We finally discuss the possibility of gut microbiota as a therapeutic target for PD." ;
                                                                             rdfs:label "sentence_33825149_9" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33860090_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33860090_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/33860090> ;
                                                                             gutprop:hasSentenceText "Probiotics for Parkinson's disease: Current evidence and future directions." ;
                                                                             rdfs:label "sentence_33860090_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33860090_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33860090_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33860090> ;
                                                                             gutprop:hasSentenceText "The gut-brain axis is a hot topic in Parkinson's disease (PD)." ;
                                                                             rdfs:label "sentence_33860090_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33860090_10
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33860090_10> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33860090> ;
                                                                              gutprop:hasSentenceText "Further targeted animal and human studies are also warranted to understand the mechanisms of actions of probiotics in PD and to tailor probiotic therapy based on individual host profiles to improve patient outcomes in this disabling disorder." ;
                                                                              rdfs:label "sentence_33860090_10" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33860090_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33860090_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33860090> ;
                                                                             gutprop:hasSentenceText "It has been postulated that gut pathogens and dysbiosis can contribute to peripheral inflammatory states or trigger downstream metabolic effects that exacerbate the neurodegenerative process in PD." ;
                                                                             rdfs:label "sentence_33860090_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33860090_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33860090_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33860090> ;
                                                                             gutprop:hasSentenceText "Several preclinical and clinical studies have demonstrated disrupted intestinal permeability, intestinal inflammation, altered gut microbiome, and reduced fecal short-chain fatty acids in PD." ;
                                                                             rdfs:label "sentence_33860090_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33860090_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33860090_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33860090> ;
                                                                             gutprop:hasSentenceText "In this regard, microbial-directed therapies such as probiotics are emerging as potential therapeutic options." ;
                                                                             rdfs:label "sentence_33860090_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33860090_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33860090_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33860090> ;
                                                                             gutprop:hasSentenceText "Probiotic supplementation is postulated to confer a variety of health benefits due to the diverse functions of these live microorganisms, including inhibition of pathogen colonization, modulation/\"normalization\" of the microbiome and/or its function, immunomodulatory effects (e.g." ;
                                                                             rdfs:label "sentence_33860090_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33860090_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33860090_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33860090> ;
                                                                             gutprop:hasSentenceText "reducing inflammation), and improved host epithelial barrier function." ;
                                                                             rdfs:label "sentence_33860090_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33860090_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33860090_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33860090> ;
                                                                             gutprop:hasSentenceText "Interestingly, several PD animal model studies have demonstrated the potential neuroprotective effects of probiotics in reducing dopaminergic neuronal degeneration." ;
                                                                             rdfs:label "sentence_33860090_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33860090_8
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33860090_8> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33860090> ;
                                                                             gutprop:hasSentenceText "Notably, two randomized placebo-controlled trials have provided class I evidence for probiotics as a treatment for constipation in PD." ;
                                                                             rdfs:label "sentence_33860090_8" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33860090_9
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33860090_9> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33860090> ;
                                                                             gutprop:hasSentenceText "However, the effects of probiotics on other PD aspects, such as motor disability and cognitive function, and its long-term efficacy (including effects on PD drug absorption in the gut) have not been investigated adequately." ;
                                                                             rdfs:label "sentence_33860090_9" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33895287_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33895287_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/33895287> ;
                                                                             gutprop:hasSentenceText "Manipulations of the gut microbiome alter chemotherapy-induced inflammation and behavioral side effects in female mice." ;
                                                                             rdfs:label "sentence_33895287_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33895287_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33895287_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33895287> ;
                                                                             gutprop:hasSentenceText "Chemotherapy treatment is associated with acute behavioral side effects (fatigue, anorexia) that significantly reduce patient quality of life and are dose-limiting, thereby increasing mortality (Kidwell et al., 2014)." ;
                                                                             rdfs:label "sentence_33895287_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33895287_10
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33895287_10> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33895287> ;
                                                                              gutprop:hasSentenceText "A gut microbiota transplant from chemotherapy-treated mice decreased central locomotion in open field testing, increased circulating CXCL1, and increased hippocampal Il6 and Tnfa in germ-free mice compared to germ-free mice that received a transplant from vehicle-treated mice." ;
                                                                              rdfs:label "sentence_33895287_10" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33895287_11
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33895287_11> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33895287> ;
                                                                              gutprop:hasSentenceText "Taken together, these data provide further evidence that the gut microbiota likely contributes to the development of chemotherapy-associated side effects." ;
                                                                              rdfs:label "sentence_33895287_11" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33895287_12
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33895287_12> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33895287> ;
                                                                              gutprop:hasSentenceText "This work has significant implications in the future treatment of anxiety in patients, and warrants future studies using microbe-based treatment options." ;
                                                                              rdfs:label "sentence_33895287_12" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33895287_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33895287_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33895287> ;
                                                                             gutprop:hasSentenceText "Disruptions to gut homeostasis (diarrhea, constipation, microbial dysbiosis) are also observed in patients receiving chemotherapy." ;
                                                                             rdfs:label "sentence_33895287_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33895287_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33895287_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33895287> ;
                                                                             gutprop:hasSentenceText "In non-oncological patients, facets of mental health (fatigue, anxiety, depression) correlate with alterations in the gut microbiome, suggestive of a contribution of the gut in CNS disease etiology." ;
                                                                             rdfs:label "sentence_33895287_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33895287_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33895287_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33895287> ;
                                                                             gutprop:hasSentenceText "The potential gut-to-brain pathway is poorly understood in patients receiving chemotherapy." ;
                                                                             rdfs:label "sentence_33895287_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33895287_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33895287_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33895287> ;
                                                                             gutprop:hasSentenceText "Our prior studies have demonstrated a correlation between chemotherapy treatment, gut changes, peripheral and central inflammation, and behavioral symptoms in mice." ;
                                                                             rdfs:label "sentence_33895287_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33895287_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33895287_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33895287> ;
                                                                             gutprop:hasSentenceText "Here we aimed to determine the extent to which chemotherapy-associated gut manipulations modulate the behavioral and biological consequences of chemotherapy." ;
                                                                             rdfs:label "sentence_33895287_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33895287_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33895287_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33895287> ;
                                                                             gutprop:hasSentenceText "We measured sickness behaviors, peripheral and central inflammatory mediators, and anxiety in conventional or germ-free female mice: 1) cohabitating with mice of the opposite treatment group, 2) pre-treated with broad-spectrum antibiotics, or 3) given an intra-gastric gavage of gut content from chemotherapy-treated mice." ;
                                                                             rdfs:label "sentence_33895287_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33895287_8
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33895287_8> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33895287> ;
                                                                             gutprop:hasSentenceText "In cohabitation studies, presumed coprophagia promoted body mass recovery, however strong associations with inflammation and behavior were not observed." ;
                                                                             rdfs:label "sentence_33895287_8" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33895287_9
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33895287_9> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33895287> ;
                                                                             gutprop:hasSentenceText "Reduction of gut microbial alpha diversity via antibiotics did not prevent chemotherapy-associated side effects, however the relative abundances of the genera Tyzzerella, Romboutsia, and Turicibacter correlated with circulating inflammatory (IL-1β) and behavioral outcomes (lethargy, anxiety-like behavior)." ;
                                                                             rdfs:label "sentence_33895287_9" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33899052_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33899052_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/33899052> ;
                                                                             gutprop:hasSentenceText "Gut Microbiome Changes with Osteopathic Treatment of Constipation in Parkinson's Disease: A Pilot Study." ;
                                                                             rdfs:label "sentence_33899052_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33899052_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33899052_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33899052> ;
                                                                             gutprop:hasSentenceText "The gut microbiome appears to be predictive of Parkinson's disease (PD) with constipation." ;
                                                                             rdfs:label "sentence_33899052_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33899052_10
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33899052_10> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33899052> ;
                                                                              gutprop:hasSentenceText "Mean quality of life significantly improved (p = .041; d = 1.072) Post-OMM." ;
                                                                              rdfs:label "sentence_33899052_10" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33899052_11
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33899052_11> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33899052> ;
                                                                              gutprop:hasSentenceText "The Pre-OMM mean number of families within the phylum Firmicutes decreased by 3 (p = .043; d = 1.177) Post-OMM." ;
                                                                              rdfs:label "sentence_33899052_11" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33899052_12
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33899052_12> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33899052> ;
                                                                              gutprop:hasSentenceText "There were significant changes in the normalized abundance of phyla Actinobacteria (p = .040; d = 0.845) and Verrucomicrobia (p = .024; d = 0.675) as well as in genus Roseburia (p = .033; d = 1.109), Intestinimonas (p = .035; d = 0.627) and Anaerotruncus (p = .004) Post-OMM." ;
                                                                              rdfs:label "sentence_33899052_12" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33899052_13
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33899052_13> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33899052> ;
                                                                              gutprop:hasSentenceText "The gut microbiome shifted among individuals with constipation and PD after four weekly treatments with the OMM-sequence." ;
                                                                              rdfs:label "sentence_33899052_13" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33899052_14
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33899052_14> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33899052> ;
                                                                              gutprop:hasSentenceText "Changes in the gut microbiome Post-OMM were associated with UPDRS results and constipation measures." ;
                                                                              rdfs:label "sentence_33899052_14" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33899052_15
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33899052_15> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33899052> ;
                                                                              gutprop:hasSentenceText "Clinical trials and studies to develop the gut microbiome into a validated biomarker for PD are necessary to understand the impact of OMM in patients with PD and constipation." ;
                                                                              rdfs:label "sentence_33899052_15" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33899052_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33899052_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33899052> ;
                                                                             gutprop:hasSentenceText "Chronic constipation frequently manifests prior to motor symptoms and impairs quality of life." ;
                                                                             rdfs:label "sentence_33899052_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33899052_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33899052_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33899052> ;
                                                                             gutprop:hasSentenceText "An osteopathic manipulative medicine (OMM) sequence used physical exam assessment and manual treatment of neuromusculoskeletal dysfunctions pertinent to constipation in PD for this prospective ABA-design study, IRB-NYITBHS1065." ;
                                                                             rdfs:label "sentence_33899052_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33899052_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33899052_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33899052> ;
                                                                             gutprop:hasSentenceText "The effects of 4 weekly treatments on the gut microbiome among men and women over 40 years old with chronic constipation and PD were investigated." ;
                                                                             rdfs:label "sentence_33899052_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33899052_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33899052_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33899052> ;
                                                                             gutprop:hasSentenceText "Severity of PD was rated with the Movement Disorders Society-Unified PD rating scale (UPDRS) in six subjects with constipation." ;
                                                                             rdfs:label "sentence_33899052_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33899052_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33899052_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33899052> ;
                                                                             gutprop:hasSentenceText "Also, the Bristol stool scale and questionnaires validated for constipation were administered for diagnosis, symptom severity, and quality of life during a 4-week control-period (A), 4-weekly OMM-treatments (B), and 2-weeks no-intervention (A)." ;
                                                                             rdfs:label "sentence_33899052_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33899052_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33899052_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33899052> ;
                                                                             gutprop:hasSentenceText "Biweekly stool samples were assessed for normalized microbiota abundance." ;
                                                                             rdfs:label "sentence_33899052_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33899052_8
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33899052_8> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33899052> ;
                                                                             gutprop:hasSentenceText "The mean Bristol rating improved from type 2 (± 1) Pre-OMM to 3 (± 1; p = .167; d = 0.677) Post-OMM." ;
                                                                             rdfs:label "sentence_33899052_8" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33899052_9
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33899052_9> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33899052> ;
                                                                             gutprop:hasSentenceText "Mean constipation severity significantly decreased (p = .010; d = 1.508) Post-OMM." ;
                                                                             rdfs:label "sentence_33899052_9" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33936013_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33936013_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/33936013> ;
                                                                             gutprop:hasSentenceText "GABA Production by Human Intestinal <i>Bacteroides</i> spp." ;
                                                                             rdfs:label "sentence_33936013_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33936013_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33936013_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33936013> ;
                                                                             gutprop:hasSentenceText ": Prevalence, Regulation, and Role in Acid Stress Tolerance." ;
                                                                             rdfs:label "sentence_33936013_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33936013_10
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33936013_10> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33936013> ;
                                                                              gutprop:hasSentenceText "Our data also indicate that the GAD-system might represent the only amino acid-dependent acid tolerance system in <i>Bacteroides</i>." ;
                                                                              rdfs:label "sentence_33936013_10" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33936013_11
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33936013_11> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33936013> ;
                                                                              gutprop:hasSentenceText "Altogether, our results suggest an important contribution of <i>Bacteroides</i> in the regulation of the GABAergic system in the human gut." ;
                                                                              rdfs:label "sentence_33936013_11" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33936013_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33936013_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33936013> ;
                                                                             gutprop:hasSentenceText "The high neuroactive potential of metabolites produced by gut microbes has gained traction over the last few years, with metagenomic-based studies suggesting an important role of microbiota-derived γ-aminobutyric acid (GABA) in modulating mental health." ;
                                                                             rdfs:label "sentence_33936013_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33936013_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33936013_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33936013> ;
                                                                             gutprop:hasSentenceText "Emerging evidence has revealed the presence of the glutamate decarboxylase (GAD)-encoding gene, a key enzyme to produce GABA, in the prominent human intestinal genus <i>Bacteroides</i>." ;
                                                                             rdfs:label "sentence_33936013_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33936013_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33936013_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33936013> ;
                                                                             gutprop:hasSentenceText "Here, we investigated GABA production by <i>Bacteroides</i> in culture and metabolic assays combined with comparative genomics and phylogenetics." ;
                                                                             rdfs:label "sentence_33936013_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33936013_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33936013_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33936013> ;
                                                                             gutprop:hasSentenceText "A total of 961 <i>Bacteroides</i> genomes were analyzed <i>in silico</i> and 17 metabolically and genetically diverse human intestinal isolates representing 11 species were screened <i>in vitro</i>." ;
                                                                             rdfs:label "sentence_33936013_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33936013_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33936013_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33936013> ;
                                                                             gutprop:hasSentenceText "Using the model organism <i>Bacteroides thetaiotaomicron</i> DSM 2079, we determined GABA production kinetics, its impact on milieu pH, and we assessed its role in mitigating acid-induced cellular damage." ;
                                                                             rdfs:label "sentence_33936013_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33936013_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33936013_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33936013> ;
                                                                             gutprop:hasSentenceText "We showed that the GAD-system consists of at least four highly conserved genes encoding a GAD, a glutaminase, a glutamate/GABA antiporter, and a potassium channel." ;
                                                                             rdfs:label "sentence_33936013_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33936013_8
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33936013_8> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33936013> ;
                                                                             gutprop:hasSentenceText "We demonstrated a high prevalence of the GAD-system among <i>Bacteroides</i> with 90% of all <i>Bacteroides</i> genomes (96% in human gut isolates only) harboring all genes of the GAD-system and 16 intestinal <i>Bacteroides</i> strains producing GABA <i>in vitro</i> (ranging from 0.09 to 60.84 mM)." ;
                                                                             rdfs:label "sentence_33936013_8" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33936013_9
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33936013_9> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33936013> ;
                                                                             gutprop:hasSentenceText "We identified glutamate and glutamine as precursors of GABA production, showed that the production is regulated by pH, and that the GAD-system acts as a protective mechanism against acid stress in <i>Bacteroides</i>, mitigating cell death and preserving metabolic activity." ;
                                                                             rdfs:label "sentence_33936013_9" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33938181_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33938181_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/33938181> ;
                                                                             gutprop:hasSentenceText "Human glucose-dependent insulinotropic polypeptide (GIP) is an antimicrobial adjuvant re-sensitising multidrug-resistant Gram-negative bacteria." ;
                                                                             rdfs:label "sentence_33938181_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33938181_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33938181_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33938181> ;
                                                                             gutprop:hasSentenceText "Increasing antibiotic resistance in Gram-negative bacteria has mandated the development of both novel antibiotics and alternative therapeutic strategies." ;
                                                                             rdfs:label "sentence_33938181_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33938181_10
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33938181_10> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33938181> ;
                                                                              gutprop:hasSentenceText "GIP can thus be regarded as an antimicrobial adjuvant with potential for augmenting the available antibiotic arsenal." ;
                                                                              rdfs:label "sentence_33938181_10" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33938181_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33938181_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33938181> ;
                                                                             gutprop:hasSentenceText "Evidence of interplay between several gastrointestinal peptides and the gut microbiota led us to investigate potential and broad-spectrum roles for the incretin hormone, human glucose-dependent insulinotropic polypeptide (GIP) against the <i>Enterobacteriaceae</i> bacteria, <i>Escherichia coli</i> and <i>Erwinia amylovora</i>." ;
                                                                             rdfs:label "sentence_33938181_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33938181_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33938181_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33938181> ;
                                                                             gutprop:hasSentenceText "GIP had a potent disruptive action on drug efflux pumps of the multidrug resistant bacteria" ;
                                                                             rdfs:label "sentence_33938181_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33938181_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33938181_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33938181> ;
                                                                             gutprop:hasSentenceText "<i>E. coli TG1</i> and" ;
                                                                             rdfs:label "sentence_33938181_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33938181_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33938181_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33938181> ;
                                                                             gutprop:hasSentenceText "<i>E. amylovora 1189</i> strains." ;
                                                                             rdfs:label "sentence_33938181_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33938181_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33938181_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33938181> ;
                                                                             gutprop:hasSentenceText "The effect was comparable to bacterial mutants lacking the inner and outer membrane efflux pump factor proteins AcrB and TolC." ;
                                                                             rdfs:label "sentence_33938181_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33938181_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33938181_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33938181> ;
                                                                             gutprop:hasSentenceText "While GIP was devoid of direct antimicrobial activity, it has a potent membrane depolarizing effect, and at low concentrations, it significantly potentiated the activity of eight antibiotics and bile salt by reducing MICs by 4-8-fold" ;
                                                                             rdfs:label "sentence_33938181_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33938181_8
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33938181_8> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33938181> ;
                                                                             gutprop:hasSentenceText "in <i>E. coli TG1</i> and 4-20-fold in" ;
                                                                             rdfs:label "sentence_33938181_8" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33938181_9
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33938181_9> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33938181> ;
                                                                             gutprop:hasSentenceText "<i>E. amylovora 1189</i>." ;
                                                                             rdfs:label "sentence_33938181_9" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33963281_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33963281_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/33963281> ;
                                                                             gutprop:hasSentenceText "Gut microbiota modulates the inflammatory response and cognitive impairment induced by sleep deprivation." ;
                                                                             rdfs:label "sentence_33963281_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33963281_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33963281_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33963281> ;
                                                                             gutprop:hasSentenceText "Sleep deprivation (SD) is increasingly common in modern society, which can lead to the dysregulation of inflammatory responses and cognitive impairment, but the mechanisms remain unclear." ;
                                                                             rdfs:label "sentence_33963281_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33963281_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33963281_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33963281> ;
                                                                             gutprop:hasSentenceText "Emerging evidence suggests that gut microbiota plays a critical role in the pathogenesis and development of inflammatory and psychiatric diseases, possibly via gut microbiota-brain interactions and neuroinflammation." ;
                                                                             rdfs:label "sentence_33963281_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33963281_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33963281_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33963281> ;
                                                                             gutprop:hasSentenceText "The present study investigated the impact of SD on gut microbiota composition and explored whether alterations of the gut microbiota play a causal role in chronic inflammatory states and cognitive impairment that are induced by SD." ;
                                                                             rdfs:label "sentence_33963281_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33963281_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33963281_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33963281> ;
                                                                             gutprop:hasSentenceText "We found that SD-induced gut dysbiosis, inflammatory responses, and cognitive impairment in humans." ;
                                                                             rdfs:label "sentence_33963281_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33963281_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33963281_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33963281> ;
                                                                             gutprop:hasSentenceText "Moreover, the absence of the gut microbiota suppressed inflammatory response and cognitive impairment induced by SD in germ-free (GF) mice." ;
                                                                             rdfs:label "sentence_33963281_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33963281_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33963281_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33963281> ;
                                                                             gutprop:hasSentenceText "Transplantation of the \"SD microbiota\" into GF mice activated the Toll-like receptor 4/nuclear factor-κB signaling pathway and impaired cognitive function in the recipient mice." ;
                                                                             rdfs:label "sentence_33963281_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33963281_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33963281_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33963281> ;
                                                                             gutprop:hasSentenceText "Mice that harbored \"SD microbiota\" also exhibited increases in neuroinflammation and microglial activity in the hippocampus and medial prefrontal cortex." ;
                                                                             rdfs:label "sentence_33963281_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33963281_8
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33963281_8> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33963281> ;
                                                                             gutprop:hasSentenceText "These findings indicate that gut dysbiosis contributes to both peripheral and central inflammatory processes and cognitive deficits that are induced by SD, which may open avenues for potential interventions that can relieve the detrimental consequences of sleep loss." ;
                                                                             rdfs:label "sentence_33963281_8" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33963284_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33963284_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/33963284> ;
                                                                             gutprop:hasSentenceText "Molecular mechanisms underlying the antidepressant actions of arketamine: beyond the NMDA receptor." ;
                                                                             rdfs:label "sentence_33963284_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33963284_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33963284_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33963284> ;
                                                                             gutprop:hasSentenceText "The discovery of robust antidepressant actions exerted by the N-methyl-D-aspartate receptor (NMDAR) antagonist (R,S)-ketamine has been a crucial breakthrough in mood disorder research." ;
                                                                             rdfs:label "sentence_33963284_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33963284_10
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33963284_10> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33963284> ;
                                                                              gutprop:hasSentenceText "Finally, we discuss the potential of arketamine as a treatment for cognitive impairment in psychiatric disorders, Parkinson's disease, osteoporosis, inflammatory bowel diseases, and stroke." ;
                                                                              rdfs:label "sentence_33963284_10" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33963284_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33963284_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33963284> ;
                                                                             gutprop:hasSentenceText "(R,S)-ketamine is a racemic mixture of equal amounts of (R)-ketamine (arketamine) and (S)-ketamine (esketamine)." ;
                                                                             rdfs:label "sentence_33963284_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33963284_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33963284_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33963284> ;
                                                                             gutprop:hasSentenceText "In 2019, an esketamine nasal spray from Johnson & Johnson was approved in the United States of America and Europe for treatment-resistant depression." ;
                                                                             rdfs:label "sentence_33963284_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33963284_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33963284_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33963284> ;
                                                                             gutprop:hasSentenceText "However, an increasing number of preclinical studies show that arketamine has greater potency and longer-lasting antidepressant-like effects than esketamine in rodents, despite the lower binding affinity of arketamine for the NMDAR." ;
                                                                             rdfs:label "sentence_33963284_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33963284_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33963284_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33963284> ;
                                                                             gutprop:hasSentenceText "In clinical trials, non-ketamine NMDAR-related compounds did not exhibit ketamine-like robust antidepressant actions in patients with depression, despite these compounds showing antidepressant-like effects in rodents." ;
                                                                             rdfs:label "sentence_33963284_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33963284_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33963284_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33963284> ;
                                                                             gutprop:hasSentenceText "Thus, the rodent data do not necessarily translate to humans due to the complexity of human psychiatric disorders." ;
                                                                             rdfs:label "sentence_33963284_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33963284_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33963284_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33963284> ;
                                                                             gutprop:hasSentenceText "Collectively, the available studies indicate that it is unlikely that NMDAR plays a major role in the antidepressant action of (R,S)-ketamine and its enantiomers, although the precise molecular mechanisms underlying antidepressant actions of (R,S)-ketamine and its enantiomers remain unclear." ;
                                                                             rdfs:label "sentence_33963284_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33963284_8
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33963284_8> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33963284> ;
                                                                             gutprop:hasSentenceText "In this paper, we review recent findings on the molecular mechanisms underlying the antidepressant actions of (R,S)-ketamine and its potent enantiomer arketamine." ;
                                                                             rdfs:label "sentence_33963284_8" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33963284_9
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33963284_9> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33963284> ;
                                                                             gutprop:hasSentenceText "Furthermore, we discuss the possible role of the brain-gut-microbiota axis and brain-spleen axis in stress-related psychiatric disorders and in the antidepressant-like action of arketamine." ;
                                                                             rdfs:label "sentence_33963284_9" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33967849_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33967849_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/33967849> ;
                                                                             gutprop:hasSentenceText "Effectiveness of Probiotic, Prebiotic, and Synbiotic Supplementation to Improve Perinatal Mental Health in Mothers: A Systematic Review and Meta-Analysis." ;
                                                                             rdfs:label "sentence_33967849_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33967849_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33967849_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33967849> ;
                                                                             gutprop:hasSentenceText "<b>Introduction:</b> There is an emerging interest in modulating the gut microbiota to target the gut-brain axis and improve maternal mental health in the perinatal period." ;
                                                                             rdfs:label "sentence_33967849_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33967849_10
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33967849_10> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33967849> ;
                                                                              gutprop:hasSentenceText "There were no differences between probiotics and control groups in global mental health scores at end of follow-up (MD 1.09; 95% CI -2.04, 4.22)." ;
                                                                              rdfs:label "sentence_33967849_10" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33967849_11
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33967849_11> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33967849> ;
                                                                              gutprop:hasSentenceText "<b>Conclusion:</b> There is limited but promising evidence about the effectiveness of probiotics during pregnancy to reduce anxiety symptoms and reduce the proportion of women scoring ABOVE a cut-off depression score." ;
                                                                              rdfs:label "sentence_33967849_11" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33967849_12
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33967849_12> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33967849> ;
                                                                              gutprop:hasSentenceText "There is a lack of RCT evidence supporting prebiotics and synbiotics supplementation for similar purposes in the perinatal period." ;
                                                                              rdfs:label "sentence_33967849_12" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33967849_13
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33967849_13> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33967849> ;
                                                                              gutprop:hasSentenceText "More research is needed before prebiotics, probiotics, and synbiotics are recommended to support maternal mental health and well-being in the perinatal period." ;
                                                                              rdfs:label "sentence_33967849_13" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33967849_14
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33967849_14> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33967849> ;
                                                                              gutprop:hasSentenceText "<b>Systematic Review Registration:</b> PROSPERO, CRD42019137158." ;
                                                                              rdfs:label "sentence_33967849_14" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33967849_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33967849_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33967849> ;
                                                                             gutprop:hasSentenceText "This systematic review evaluated the effectiveness of prebiotics, probiotics, and synbiotics supplementation during pregnancy to reduce the risk of maternal mental health problems in the perinatal period." ;
                                                                             rdfs:label "sentence_33967849_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33967849_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33967849_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33967849> ;
                                                                             gutprop:hasSentenceText "<b>Methods:</b> Electronic biomedical databases and clinical trial registries were searched from database inception through August 2020 to identify randomized controlled clinical trials (RCTs) evaluating the effect of probiotic, prebiotic, or synbiotic supplements administered to women during pregnancy on measures of perinatal depression, anxiety, and other mental health outcomes." ;
                                                                             rdfs:label "sentence_33967849_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33967849_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33967849_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33967849> ;
                                                                             gutprop:hasSentenceText "Study selection, risk of bias appraisal, and data extraction were independently performed by two reviewers." ;
                                                                             rdfs:label "sentence_33967849_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33967849_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33967849_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33967849> ;
                                                                             gutprop:hasSentenceText "Pooled mean differences (MD) and odds ratios (pOR) with 95% confidence intervals (CI) were calculated in random-effects meta-analyses for the outcomes of interest in the review." ;
                                                                             rdfs:label "sentence_33967849_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33967849_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33967849_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33967849> ;
                                                                             gutprop:hasSentenceText "<b>Results:</b> From 3,868 studies identified through the search strategy, three RCTs of low risk of bias involving 713 participants were included, all three testing probiotics." ;
                                                                             rdfs:label "sentence_33967849_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33967849_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33967849_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33967849> ;
                                                                             gutprop:hasSentenceText "There were no differences between probiotics and control groups in the mean depression scores (MD -0.46; 95% CI -2.16, 1.25) at end of follow-up." ;
                                                                             rdfs:label "sentence_33967849_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33967849_8
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33967849_8> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33967849> ;
                                                                             gutprop:hasSentenceText "Although statistical significance was not achieved, probiotics showed an advantage in the proportion of participants scoring below an established cut-off for depression (pOR 0.68; 95% CI 0.43, 1.07)." ;
                                                                             rdfs:label "sentence_33967849_8" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33967849_9
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33967849_9> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33967849> ;
                                                                             gutprop:hasSentenceText "Compared to placebo, probiotics in pregnancy reduced anxiety symptoms (MD -0.99; 95% CI -1.80, -0.18); however, this advantage was not translated in a reduction in the proportion of participants scoring above an established cut-off for anxiety (pOR 0.65; 95% CI 0.23, 1.85)." ;
                                                                             rdfs:label "sentence_33967849_9" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33968794_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33968794_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/33968794> ;
                                                                             gutprop:hasSentenceText "Review: The Role of Intestinal Dysbiosis in Parkinson's Disease." ;
                                                                             rdfs:label "sentence_33968794_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33968794_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33968794_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33968794> ;
                                                                             gutprop:hasSentenceText "Several studies have highlighted the roles played by the gut microbiome in central nervous system diseases." ;
                                                                             rdfs:label "sentence_33968794_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33968794_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33968794_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33968794> ;
                                                                             gutprop:hasSentenceText "Clinical symptoms and neuropathology have suggested that Parkinson's disease may originate in the gut, which is home to approximately 100 trillion microbes." ;
                                                                             rdfs:label "sentence_33968794_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33968794_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33968794_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33968794> ;
                                                                             gutprop:hasSentenceText "Alterations in the gastrointestinal microbiota populations may promote the development and progression of Parkinson's disease." ;
                                                                             rdfs:label "sentence_33968794_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33968794_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33968794_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33968794> ;
                                                                             gutprop:hasSentenceText "Here, we reviewed existing studies that have explored the role of intestinal dysbiosis in Parkinson's disease, focusing on the roles of microbiota, their metabolites, and components in inflammation, barrier failure, microglial activation, and α-synuclein pathology." ;
                                                                             rdfs:label "sentence_33968794_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33968794_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33968794_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33968794> ;
                                                                             gutprop:hasSentenceText "We conclude that there are intestinal dysbiosis in Parkinson's disease." ;
                                                                             rdfs:label "sentence_33968794_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33968794_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33968794_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33968794> ;
                                                                             gutprop:hasSentenceText "Intestinal dysbiosis is likely involved in the pathogenesis of Parkinson's disease through mechanisms that include barrier destruction, inflammation and oxidative stress, decreased dopamine production, and molecular mimicry." ;
                                                                             rdfs:label "sentence_33968794_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33968794_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33968794_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33968794> ;
                                                                             gutprop:hasSentenceText "Additional studies remain necessary to explore and verify the mechanisms through which dysbiosis may cause or promote Parkinson's disease." ;
                                                                             rdfs:label "sentence_33968794_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33968794_8
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33968794_8> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33968794> ;
                                                                             gutprop:hasSentenceText "Preclinical studies have shown that gastrointestinal microbial therapy may represent an effective and novel treatment for Parkinson's disease; however, more studies, especially clinical studies, are necessary to explore the curative effects of microbial therapy in Parkinson's disease." ;
                                                                             rdfs:label "sentence_33968794_8" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34002020_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34002020_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/34002020> ;
                                                                             gutprop:hasSentenceText "Endocannabinoid system mediates the association between gut-microbial diversity and anhedonia/amotivation in a general population cohort." ;
                                                                             rdfs:label "sentence_34002020_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34002020_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34002020_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34002020> ;
                                                                             gutprop:hasSentenceText "Anhedonia and amotivation are debilitating symptoms and represent unmet therapeutic needs in a range of clinical conditions." ;
                                                                             rdfs:label "sentence_34002020_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34002020_10
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34002020_10> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34002020> ;
                                                                              gutprop:hasSentenceText "Data were imputed using multiple imputation by chained equations." ;
                                                                              rdfs:label "sentence_34002020_10" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34002020_11
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34002020_11> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34002020> ;
                                                                              gutprop:hasSentenceText "Mean age was 65.2 ± 7.6; 93% of the sample were females." ;
                                                                              rdfs:label "sentence_34002020_11" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34002020_12
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34002020_12> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34002020> ;
                                                                              gutprop:hasSentenceText "We found a direct, significant, association between alpha diversity and anhedonia/amotivation (β = -0.37; 95%CI: -0.71 to -0.03; P = 0.03)." ;
                                                                              rdfs:label "sentence_34002020_12" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34002020_13
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34002020_13> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34002020> ;
                                                                              gutprop:hasSentenceText "Faecal, but not serum, levels of the endocannabinoid palmitoylethanolamide (PEA) mediated this association: the indirect effect was significant (β = -0.13; 95%CI: -0.24 to -0.01; P = 0.03), as was the total effect (β = -0.38; 95%CI: -0.72 to -0.04; P = 0.03), whereas the direct effect of alpha diversity on anhedonia/amotivation was attenuated fully (β = -0.25; 95%CI: -0.60 to 0.09; P = 0.16)." ;
                                                                              rdfs:label "sentence_34002020_13" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34002020_14
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34002020_14> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34002020> ;
                                                                              gutprop:hasSentenceText "Our results suggest that gut-microbial diversity might contribute to anhedonia/amotivation via the endocannabinoid system." ;
                                                                              rdfs:label "sentence_34002020_14" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34002020_15
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34002020_15> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34002020> ;
                                                                              gutprop:hasSentenceText "These findings shed light on the biological underpinnings of anhedonia/amotivation and suggest the gut microbiota-endocannabinoid axis as a promising therapeutic target in an area of unmet clinical need." ;
                                                                              rdfs:label "sentence_34002020_15" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34002020_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34002020_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34002020> ;
                                                                             gutprop:hasSentenceText "The gut-microbiome-endocannabinoid axis might represent a potential modifiable target for interventions." ;
                                                                             rdfs:label "sentence_34002020_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34002020_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34002020_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34002020> ;
                                                                             gutprop:hasSentenceText "Based on results obtained from animal models, we tested the hypothesis that the endocannabinoid system mediates the association between gut-microbiome diversity and anhedonia/amotivation in a general population cohort." ;
                                                                             rdfs:label "sentence_34002020_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34002020_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34002020_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34002020> ;
                                                                             gutprop:hasSentenceText "We used longitudinal data collected from 786 volunteer twins recruited as part the TwinsUK register." ;
                                                                             rdfs:label "sentence_34002020_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34002020_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34002020_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34002020> ;
                                                                             gutprop:hasSentenceText "Our hypothesis was tested with a multilevel mediation model using family structure as random intercept." ;
                                                                             rdfs:label "sentence_34002020_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34002020_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34002020_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34002020> ;
                                                                             gutprop:hasSentenceText "The model was set using alpha diversity (within-individual gut-microbial diversity) as predictor, serum and faecal levels of the endocannabinoid palmitoylethanolamide (PEA) as mediator, and anhedonia/amotivation as outcome." ;
                                                                             rdfs:label "sentence_34002020_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34002020_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34002020_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34002020> ;
                                                                             gutprop:hasSentenceText "PEA is considered the endogenous equivalent of cannabidiol, with increased serum levels believed to have anti-depressive effects, while increased stool PEA levels, reflecting increased excretion, are believed to have opposite, detrimental, effects on mental health." ;
                                                                             rdfs:label "sentence_34002020_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34002020_8
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34002020_8> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34002020> ;
                                                                             gutprop:hasSentenceText "We therefore expected that either reduced serum PEA or increased stool PEA would mediate the association between microbial diversity and anhedonia amotivation." ;
                                                                             rdfs:label "sentence_34002020_8" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34002020_9
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34002020_9> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34002020> ;
                                                                             gutprop:hasSentenceText "Analyses were adjusted for obesity, diet, antidepressant use, sociodemographic and technical covariates." ;
                                                                             rdfs:label "sentence_34002020_9" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34004259_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34004259_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/34004259> ;
                                                                             gutprop:hasSentenceText "Abnormalities in the composition of the gut microbiota in mice after repeated administration of DREADD ligands." ;
                                                                             rdfs:label "sentence_34004259_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34004259_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34004259_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34004259> ;
                                                                             gutprop:hasSentenceText "Designer Receptors Exclusively Activated by Designer Drugs (DREADDs) are known as genetically modified G-protein-coupled receptors (GPCRs), which can be activated by synthetic ligands such as clozapine N-oxide (CNO) and DREADD agonist 21 (compound 21: C21)." ;
                                                                             rdfs:label "sentence_34004259_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34004259_10
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34004259_10> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34004259> ;
                                                                              gutprop:hasSentenceText "Therefore, abnormalities in the composition of gut microbiota by repeated dosing of DREADD ligands should be taken into consideration for behavioral and biological functions in rodents treated with DREADD ligands." ;
                                                                              rdfs:label "sentence_34004259_10" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34004259_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34004259_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34004259> ;
                                                                             gutprop:hasSentenceText "The brain-gut-microbiota axis has a crucial role in bidirectional interactions between the brain and the gastrointestinal microbiota." ;
                                                                             rdfs:label "sentence_34004259_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34004259_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34004259_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34004259> ;
                                                                             gutprop:hasSentenceText "In this study, we investigated whether repeated administration of CNO or C21 could influence the gut microbiota and short-chain fatty acids (SCFAs) in feces of adult mice." ;
                                                                             rdfs:label "sentence_34004259_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34004259_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34004259_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34004259> ;
                                                                             gutprop:hasSentenceText "Repeated administration of CNO or C21 as drinking water did not alter the α- and β-diversity of gut microbiota in mice compared with control mice." ;
                                                                             rdfs:label "sentence_34004259_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34004259_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34004259_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34004259> ;
                                                                             gutprop:hasSentenceText "However, we found significant changes in relative abundance for several bacteria in the CNO (or C21) group at the taxonomic level compared to the control group." ;
                                                                             rdfs:label "sentence_34004259_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34004259_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34004259_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34004259> ;
                                                                             gutprop:hasSentenceText "The linear discriminant analysis effect size (LEfSe) algorithm distinguished the family Prevotellaceae, the genus Anaerocolumna, the genus Prevotella, and the genus Frisingicoccus, these four specific microbial markers for the CNO group relative to the control group." ;
                                                                             rdfs:label "sentence_34004259_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34004259_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34004259_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34004259> ;
                                                                             gutprop:hasSentenceText "In addition, the LEfSe algorithm identified the family Clostridiaceae, the genus Faecalicatena and the genus Marinisporobacter, these three bacteria of different taxonomic as potential microbial markers for the C21 group relative to the control group." ;
                                                                             rdfs:label "sentence_34004259_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34004259_8
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34004259_8> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34004259> ;
                                                                             gutprop:hasSentenceText "In contrast, repeated administration of CNO (or C21) did not alter SCFAs in feces samples of adult mice." ;
                                                                             rdfs:label "sentence_34004259_8" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34004259_9
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34004259_9> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34004259> ;
                                                                             gutprop:hasSentenceText "The data suggest that repeated administration of CNO or C21 contributes to an unusual organization of the gut microbiota in adult mice." ;
                                                                             rdfs:label "sentence_34004259_9" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34014031_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34014031_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/34014031> ;
                                                                             gutprop:hasSentenceText "Impaired blood-brain barrier in the microbiota-gut-brain axis: Potential role of bipolar susceptibility gene TRANK1." ;
                                                                             rdfs:label "sentence_34014031_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34014031_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34014031_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34014031> ;
                                                                             gutprop:hasSentenceText "Bipolar disorder (BD) is a common psychiatric illness with high prevalence and disease burden." ;
                                                                             rdfs:label "sentence_34014031_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34014031_10
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34014031_10> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34014031> ;
                                                                              gutprop:hasSentenceText "In this review, we focus on the influence of intestine microbiota on the expression of bipolar gene TRANK1 and propose that intestine microbiota-dependent type 1 interferon signalling is sufficient to induce the over-expression of TRANK1, consequently causing the compromise of BBB integrity and facilitating the entrance of inflammatory mediators into the brain." ;
                                                                              rdfs:label "sentence_34014031_10" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34014031_11
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34014031_11> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34014031> ;
                                                                              gutprop:hasSentenceText "Activated neuroinflammation eventually contributes to the occurrence and development of BD." ;
                                                                              rdfs:label "sentence_34014031_11" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34014031_12
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34014031_12> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34014031> ;
                                                                              gutprop:hasSentenceText "This review provides a new perspective on how gut microbiota participate in the pathogenesis of BD." ;
                                                                              rdfs:label "sentence_34014031_12" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34014031_13
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34014031_13> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34014031> ;
                                                                              gutprop:hasSentenceText "Future studies are needed to validate these assumptions and develop new treatment targets for BD." ;
                                                                              rdfs:label "sentence_34014031_13" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34014031_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34014031_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34014031> ;
                                                                             gutprop:hasSentenceText "Accumulating susceptibility genes for BD have been identified in recent years." ;
                                                                             rdfs:label "sentence_34014031_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34014031_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34014031_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34014031> ;
                                                                             gutprop:hasSentenceText "However, the exact functions of these genes remain largely unknown." ;
                                                                             rdfs:label "sentence_34014031_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34014031_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34014031_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34014031> ;
                                                                             gutprop:hasSentenceText "Despite its high heritability, gene and environment interaction is commonly accepted as the major contributing factor to BD pathogenesis." ;
                                                                             rdfs:label "sentence_34014031_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34014031_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34014031_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34014031> ;
                                                                             gutprop:hasSentenceText "Intestine microbiota is increasingly recognized as a critical environmental factor for human health and diseases via the microbiota-gut-brain axis." ;
                                                                             rdfs:label "sentence_34014031_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34014031_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34014031_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34014031> ;
                                                                             gutprop:hasSentenceText "BD individuals showed altered diversity and compositions in the commensal microbiota." ;
                                                                             rdfs:label "sentence_34014031_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34014031_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34014031_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34014031> ;
                                                                             gutprop:hasSentenceText "In addition to pro-inflammatory factors, such as interleukin-6 and tumour necrosis factor-α, type 1 interferon signalling pathway is also modulated by specific intestinal bacterial strains." ;
                                                                             rdfs:label "sentence_34014031_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34014031_8
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34014031_8> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34014031> ;
                                                                             gutprop:hasSentenceText "Disruption of the microbiota-gut-brain axis contributes to peripheral and central nervous system inflammation, which accounts for the BD aetiology." ;
                                                                             rdfs:label "sentence_34014031_8" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34014031_9
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34014031_9> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34014031> ;
                                                                             gutprop:hasSentenceText "Administration of type 1 interferon can induce the expression of TRANK1, which is associated with elevated circulating biomarkers of the impaired blood-brain barrier in BD patients." ;
                                                                             rdfs:label "sentence_34014031_9" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34032650_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34032650_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/34032650> ;
                                                                             gutprop:hasSentenceText "Psychobiotics: Evolution of Novel Antidepressants." ;
                                                                             rdfs:label "sentence_34032650_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34032650_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34032650_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34032650> ;
                                                                             gutprop:hasSentenceText "The gut-brain axis is a bidirectional communication system which allows the central nervous system and gastrointestinal tract to interact with and respond to each other rapidly and effectively." ;
                                                                             rdfs:label "sentence_34032650_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34032650_10
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34032650_10> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34032650> ;
                                                                              gutprop:hasSentenceText "EU-funded guidelines recommend that patients with depression or vulnerability to depression should be encouraged to enhance a plant-based diet with a high content of grains/fibres, fermented foods, and fish." ;
                                                                              rdfs:label "sentence_34032650_10" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34032650_11
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34032650_11> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34032650> ;
                                                                              gutprop:hasSentenceText "A significant impact of such a diet is likely mediated through the gut microbiota." ;
                                                                              rdfs:label "sentence_34032650_11" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34032650_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34032650_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34032650> ;
                                                                             gutprop:hasSentenceText "It is becoming increasingly clear that major players in this complex system are gut bacteria." ;
                                                                             rdfs:label "sentence_34032650_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34032650_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34032650_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34032650> ;
                                                                             gutprop:hasSentenceText "The mechanisms of signal transmission from bacteria to the brain are complex and not fully elucidated, but include neural, endocrine, immune, and metabolic pathways." ;
                                                                             rdfs:label "sentence_34032650_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34032650_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34032650_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34032650> ;
                                                                             gutprop:hasSentenceText "It was initially demonstrated in a rodent model of depression that the gut microbiota was altered." ;
                                                                             rdfs:label "sentence_34032650_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34032650_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34032650_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34032650> ;
                                                                             gutprop:hasSentenceText "This observation has been replicated in patients with major depression who show decreased microbial diversity." ;
                                                                             rdfs:label "sentence_34032650_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34032650_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34032650_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34032650> ;
                                                                             gutprop:hasSentenceText "Furthermore, when rodents receive a microbiota transplant from a depressed patient their behaviour alters, as does their tryptophan metabolism and immune status." ;
                                                                             rdfs:label "sentence_34032650_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34032650_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34032650_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34032650> ;
                                                                             gutprop:hasSentenceText "Several studies of psychobiotics (bacteria with a potential mental health benefit) have been conducted in healthy populations and in patients with depression." ;
                                                                             rdfs:label "sentence_34032650_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34032650_8
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34032650_8> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34032650> ;
                                                                             gutprop:hasSentenceText "While some psychobiotics have shown efficacy in treating depression, other bacteria have yielded negative findings." ;
                                                                             rdfs:label "sentence_34032650_8" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34032650_9
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34032650_9> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34032650> ;
                                                                             gutprop:hasSentenceText "Larger-scale, well-designed studies are required." ;
                                                                             rdfs:label "sentence_34032650_9" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34074025_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34074025_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/34074025> ;
                                                                             gutprop:hasSentenceText "MAIT Cells and Microbiota in Multiple Sclerosis and Other Autoimmune Diseases." ;
                                                                             rdfs:label "sentence_34074025_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34074025_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34074025_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34074025> ;
                                                                             gutprop:hasSentenceText "The functions of mucosal-associated invariant T (MAIT) cells in homeostatic conditions include the interaction with the microbiota and its products, the protection of body barriers, and the mounting of a tissue-repair response to injuries or infections." ;
                                                                             rdfs:label "sentence_34074025_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34074025_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34074025_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34074025> ;
                                                                             gutprop:hasSentenceText "Dysfunction of MAIT cells and dysbiosis occur in common chronic diseases of inflammatory, metabolic, and tumor nature." ;
                                                                             rdfs:label "sentence_34074025_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34074025_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34074025_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34074025> ;
                                                                             gutprop:hasSentenceText "This review is aimed at analyzing the changes of MAIT cells, as well as of the microbiota, in multiple sclerosis and other autoimmune disorders." ;
                                                                             rdfs:label "sentence_34074025_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34074025_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34074025_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34074025> ;
                                                                             gutprop:hasSentenceText "Common features of dysbiosis in these conditions are the reduced richness of microbial species and the unbalance between pro-inflammatory and immune regulatory components of the gut microbiota." ;
                                                                             rdfs:label "sentence_34074025_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34074025_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34074025_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34074025> ;
                                                                             gutprop:hasSentenceText "The literature concerning MAIT cells in these disorders is rather complex, and sometimes not consistent." ;
                                                                             rdfs:label "sentence_34074025_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34074025_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34074025_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34074025> ;
                                                                             gutprop:hasSentenceText "In multiple sclerosis and other autoimmune conditions, several studies have been done, or are in progress, to find correlations between intestinal permeability, dysbiosis, MAIT cell responses, and clinical biomarkers in treated and treatment-naïve patients." ;
                                                                             rdfs:label "sentence_34074025_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34074025_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34074025_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34074025> ;
                                                                             gutprop:hasSentenceText "The final aims are to explain what activates MAIT cells in diseases not primarily infective, which interactions with the microbiota are potentially pathogenic, and their dynamics related to disease course and disease-modifying treatments." ;
                                                                             rdfs:label "sentence_34074025_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34092293_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34092293_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/34092293> ;
                                                                             gutprop:hasSentenceText "Studies on blood enrichment and anti-tumor effects of combined Danggui Buxue Decoction, Fe and rhEPO based on colon cancer-related anemia model and gut microbiota modulation." ;
                                                                             rdfs:label "sentence_34092293_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34092293_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34092293_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34092293> ;
                                                                             gutprop:hasSentenceText "Colon cancer-related anemia (CCRA) is mainly caused by systemic inflammation, intestinal bleeding, iron deficiency and chemotherapy-induced myelosuppression in colon cancer." ;
                                                                             rdfs:label "sentence_34092293_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34092293_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34092293_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34092293> ;
                                                                             gutprop:hasSentenceText "However, the best therapeutic schedule and related mechanism on CCRA were still uncertain." ;
                                                                             rdfs:label "sentence_34092293_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34092293_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34092293_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34092293> ;
                                                                             gutprop:hasSentenceText "Studies on blood enrichment and anti-tumor effects of combined Danggui Buxue Decoction (DBD), Fe and rhEPO based on CCRA and gut microbiota modulation were conducted in this paper." ;
                                                                             rdfs:label "sentence_34092293_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34092293_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34092293_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34092293> ;
                                                                             gutprop:hasSentenceText "Here, CCRA model was successfully induced by subcutaneous inoculation of CT-26 and i.p." ;
                                                                             rdfs:label "sentence_34092293_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34092293_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34092293_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34092293> ;
                                                                             gutprop:hasSentenceText "oxaliplatin, rhEPO + DBD high dosage + Fe (EDF) and rhEPO + DBD high dosage (ED) groups had the best blood enrichment effect." ;
                                                                             rdfs:label "sentence_34092293_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34092293_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34092293_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34092293> ;
                                                                             gutprop:hasSentenceText "Attractively, EDF group also showed antitumor activity." ;
                                                                             rdfs:label "sentence_34092293_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34092293_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34092293_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34092293> ;
                                                                             gutprop:hasSentenceText "The sequencing results of gut microbiota showed that compared to P group, the relative abundances of Lachnospiraceae and opportunistic pathogen (Odoribacter) in ED and EDF groups were decreased." ;
                                                                             rdfs:label "sentence_34092293_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34092293_8
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34092293_8> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34092293> ;
                                                                             gutprop:hasSentenceText "Interestingly, EDF also decreased the relative abundances of cancer-related bacteria (Helicobacter, Lactococcus, Alloprevotella) and imbalance-inducing bacteria (Escherichia-Shigella and Parabacteroides) and increased the relative abundances of butyrate-producing bacteria (Ruminococcaceae_UCG-014), however, ED showed the opposite effects to EDF, this might be the reason of the smaller tumor volume in EDF group." ;
                                                                             rdfs:label "sentence_34092293_8" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34092293_9
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34092293_9> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34092293> ;
                                                                             gutprop:hasSentenceText "Our findings proposed the best treatment combination of DBD, rhEPO and Fe in CCRA and provided theoretical basis and literature reference for CCRA-induced intestinal flora disorder and the regulatory mechanism of EDF." ;
                                                                             rdfs:label "sentence_34092293_9" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34098340_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34098340_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/34098340> ;
                                                                             gutprop:hasSentenceText "Maternal prenatal gut microbiota composition predicts child behaviour." ;
                                                                             rdfs:label "sentence_34098340_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34098340_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34098340_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34098340> ;
                                                                             gutprop:hasSentenceText "Murine studies demonstrate that maternal prenatal gut microbiota influences brain development and behaviour of offspring." ;
                                                                             rdfs:label "sentence_34098340_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34098340_10
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34098340_10> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34098340> ;
                                                                              gutprop:hasSentenceText "A healthy prenatal diet indirectly related to decreased child internalising behaviours via higher alpha diversity of maternal faecal microbiota." ;
                                                                              rdfs:label "sentence_34098340_10" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34098340_11
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34098340_11> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34098340> ;
                                                                              gutprop:hasSentenceText "These findings support animal studies showing that the composition of maternal prenatal gut microbiota is related to offspring brain development and behaviour." ;
                                                                              rdfs:label "sentence_34098340_11" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34098340_12
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34098340_12> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34098340> ;
                                                                              gutprop:hasSentenceText "Our findings highlight the need to evaluate potential impacts of the prenatal gut microbiota on early life brain development." ;
                                                                              rdfs:label "sentence_34098340_12" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34098340_13
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34098340_13> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34098340> ;
                                                                              gutprop:hasSentenceText "This study was funded by the National Health and Medical Research Council of Australia (1082307, 1147980), Murdoch Children's Research Institute, Barwon Health and Deakin University." ;
                                                                              rdfs:label "sentence_34098340_13" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34098340_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34098340_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34098340> ;
                                                                             gutprop:hasSentenceText "No human study has related maternal gut microbiota to behavioural outcomes during early life." ;
                                                                             rdfs:label "sentence_34098340_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34098340_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34098340_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34098340> ;
                                                                             gutprop:hasSentenceText "This study aimed to evaluate relationships between the prenatal faecal microbiota, prenatal diet and childhood behaviour." ;
                                                                             rdfs:label "sentence_34098340_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34098340_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34098340_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34098340> ;
                                                                             gutprop:hasSentenceText "A sub-cohort of 213 mothers and 215 children were selected from a longitudinal pre-birth cohort." ;
                                                                             rdfs:label "sentence_34098340_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34098340_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34098340_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34098340> ;
                                                                             gutprop:hasSentenceText "Maternal prenatal exposure measures collected during the third trimester included the faecal microbiota (generated using 16S rRNA amplicon sequencing), and dietary intake." ;
                                                                             rdfs:label "sentence_34098340_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34098340_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34098340_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34098340> ;
                                                                             gutprop:hasSentenceText "The behavioural outcome used the Childhood Behaviour Checklist at age two." ;
                                                                             rdfs:label "sentence_34098340_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34098340_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34098340_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34098340> ;
                                                                             gutprop:hasSentenceText "Models were adjusted for prenatal diet, smoking, perceived stress, maternal age and sample batch." ;
                                                                             rdfs:label "sentence_34098340_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34098340_8
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34098340_8> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34098340> ;
                                                                             gutprop:hasSentenceText "We found evidence that the alpha diversity of the maternal faecal microbiota during the third trimester of pregnancy predicts child internalising behaviour at two years of age (-2·74, (-4·71, -0·78), p = 0·01 (Wald test), R<sup>2</sup>=0·07)." ;
                                                                             rdfs:label "sentence_34098340_8" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34098340_9
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34098340_9> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34098340> ;
                                                                             gutprop:hasSentenceText "Taxa from butyrate-producing families, Lachnospiraceae and Ruminococcaceae, were more abundant in mothers of children with normative behaviour." ;
                                                                             rdfs:label "sentence_34098340_9" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34147969_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34147969_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/34147969> ;
                                                                             gutprop:hasSentenceText "Ingestion of Faecalibaculum rodentium causes depression-like phenotypes in resilient Ephx2 knock-out mice: A role of brain-gut-microbiota axis via the subdiaphragmatic vagus nerve." ;
                                                                             rdfs:label "sentence_34147969_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34147969_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34147969_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34147969> ;
                                                                             gutprop:hasSentenceText "The brain-gut-microbiota axis plays a crucial role in the bidirectional interactions between the brain and the gut." ;
                                                                             rdfs:label "sentence_34147969_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34147969_10
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34147969_10> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34147969> ;
                                                                              gutprop:hasSentenceText "Furthermore, subdiaphragmatic vagotomy blocked the development of these behavioral abnormalities after ingestion of F. rodentium." ;
                                                                              rdfs:label "sentence_34147969_10" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34147969_11
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34147969_11> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34147969> ;
                                                                              gutprop:hasSentenceText "Detailed mechanisms are unclear." ;
                                                                              rdfs:label "sentence_34147969_11" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34147969_12
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34147969_12> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34147969> ;
                                                                              gutprop:hasSentenceText "These findings suggest that F. rodentium might contribute to the conversion of resilient Ephx2 KO mice into KO mice with depression-like phenotypes." ;
                                                                              rdfs:label "sentence_34147969_12" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34147969_13
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34147969_13> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34147969> ;
                                                                              gutprop:hasSentenceText "The brain-gut-microbiota axis via the subdiaphragmatic vagus nerve plays a crucial role in susceptibility and resilience to stress." ;
                                                                              rdfs:label "sentence_34147969_13" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34147969_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34147969_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34147969> ;
                                                                             gutprop:hasSentenceText "Soluble epoxide hydrolase (coded by the Ephx2 gene) plays an important role in inflammation, which has been implicated in stress-related depression." ;
                                                                             rdfs:label "sentence_34147969_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34147969_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34147969_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34147969> ;
                                                                             gutprop:hasSentenceText "Ephx2 knock-out (KO) mice exposed to chronic social defeat stress (CSDS) did not show depression-like behaviors, indicating stress resilience." ;
                                                                             rdfs:label "sentence_34147969_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34147969_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34147969_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34147969> ;
                                                                             gutprop:hasSentenceText "Here we examined whether the brain-gut-microbiota axis influences the resilience in Ephx2 KO mice." ;
                                                                             rdfs:label "sentence_34147969_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34147969_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34147969_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34147969> ;
                                                                             gutprop:hasSentenceText "Effects of fecal microbiota transplantation (FMT) from CSDS-susceptible (or control) mice in wild-type (WT) mice and Ephx2 KO mice treated with an antibiotic cocktail (ABX) were investigated." ;
                                                                             rdfs:label "sentence_34147969_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34147969_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34147969_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34147969> ;
                                                                             gutprop:hasSentenceText "Behavioral, biochemical tests and 16S ribosome RNA analysis were performed." ;
                                                                             rdfs:label "sentence_34147969_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34147969_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34147969_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34147969> ;
                                                                             gutprop:hasSentenceText "FMT from CSDS-susceptible mice produced anhedonia-like behavior in ABX-treated WT and Ephx2 KO mice." ;
                                                                             rdfs:label "sentence_34147969_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34147969_8
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34147969_8> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34147969> ;
                                                                             gutprop:hasSentenceText "The 16S ribosome RNA analysis showed that Faecalibaculum rodentium (F. rodentium) may be responsible for the observed anhedonia-like behavior following FMT from CSDS-susceptible mice." ;
                                                                             rdfs:label "sentence_34147969_8" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34147969_9
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34147969_9> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34147969> ;
                                                                             gutprop:hasSentenceText "Ingestion of F. rodentium for 14 days produced depression- and anhedonia-like behaviors, higher blood levels of interleukin-6, and reduced expression of synaptic proteins in the prefrontal cortex of ABX-treated Ephx2 KO mice." ;
                                                                             rdfs:label "sentence_34147969_9" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34172092_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34172092_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/34172092> ;
                                                                             gutprop:hasSentenceText "Depletion of acetate-producing bacteria from the gut microbiota facilitates cognitive impairment through the gut-brain neural mechanism in diabetic mice." ;
                                                                             rdfs:label "sentence_34172092_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34172092_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34172092_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34172092> ;
                                                                             gutprop:hasSentenceText "Modification of the gut microbiota has been reported to reduce the incidence of type 1 diabetes mellitus (T1D)." ;
                                                                             rdfs:label "sentence_34172092_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34172092_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34172092_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34172092> ;
                                                                             gutprop:hasSentenceText "We hypothesized that the gut microbiota shifts might also have an effect on cognitive functions in T1D." ;
                                                                             rdfs:label "sentence_34172092_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34172092_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34172092_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34172092> ;
                                                                             gutprop:hasSentenceText "Herein we used a non-absorbable antibiotic vancomycin to modify the gut microbiota in streptozotocin (STZ)-induced T1D mice and studied the impact of microbial changes on cognitive performances in T1D mice and its potential gut-brain neural mechanism." ;
                                                                             rdfs:label "sentence_34172092_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34172092_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34172092_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34172092> ;
                                                                             gutprop:hasSentenceText "We found that vancomycin exposure disrupted the gut microbiome, altered host metabolic phenotypes, and facilitated cognitive impairment in T1D mice." ;
                                                                             rdfs:label "sentence_34172092_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34172092_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34172092_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34172092> ;
                                                                             gutprop:hasSentenceText "Long-term acetate deficiency due to depletion of acetate-producing bacteria resulted in the reduction of synaptophysin (SYP) in the hippocampus as well as learning and memory impairments." ;
                                                                             rdfs:label "sentence_34172092_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34172092_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34172092_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34172092> ;
                                                                             gutprop:hasSentenceText "Exogenous acetate supplement or fecal microbiota transplant recovered hippocampal SYP level in vancomycin-treated T1D mice, and this effect was attenuated by vagal inhibition or vagotomy." ;
                                                                             rdfs:label "sentence_34172092_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34172092_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34172092_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34172092> ;
                                                                             gutprop:hasSentenceText "Our results demonstrate the protective role of microbiota metabolite acetate in cognitive functions and suggest long-term acetate deficiency as a risk factor of cognitive decline." ;
                                                                             rdfs:label "sentence_34172092_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34172092_8
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34172092_8> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34172092> ;
                                                                             gutprop:hasSentenceText "Video Abstract." ;
                                                                             rdfs:label "sentence_34172092_8" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34174901_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34174901_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/34174901> ;
                                                                             gutprop:hasSentenceText "Beyond the lesion site: minocycline augments inflammation and anxiety-like behavior following SCI in rats through action on the gut microbiota." ;
                                                                             rdfs:label "sentence_34174901_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34174901_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34174901_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34174901> ;
                                                                             gutprop:hasSentenceText "Minocycline is a clinically available synthetic tetracycline derivative with anti-inflammatory and antibiotic properties." ;
                                                                             rdfs:label "sentence_34174901_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34174901_10
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34174901_10> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34174901> ;
                                                                              gutprop:hasSentenceText "Furthermore, although minocycline attenuated spinal cord injury-induced microglial activation, it did not affect the lesion size or promote measurable motor recovery." ;
                                                                              rdfs:label "sentence_34174901_10" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34174901_11
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34174901_11> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34174901> ;
                                                                              gutprop:hasSentenceText "We show that minocycline's microbiota effects precede its long-term effects on systemic cytokines and chemokines following spinal cord injury." ;
                                                                              rdfs:label "sentence_34174901_11" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34174901_12
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34174901_12> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34174901> ;
                                                                              gutprop:hasSentenceText "These results provide an exciting new target of minocycline as a therapeutic for central nervous system diseases and injuries." ;
                                                                              rdfs:label "sentence_34174901_12" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34174901_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34174901_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34174901> ;
                                                                             gutprop:hasSentenceText "The majority of studies show that minocycline can reduce tissue damage and improve functional recovery following central nervous system injuries, mainly attributed to the drug's direct anti-inflammatory, anti-oxidative, and neuroprotective properties." ;
                                                                             rdfs:label "sentence_34174901_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34174901_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34174901_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34174901> ;
                                                                             gutprop:hasSentenceText "Surprisingly the consequences of minocycline's antibiotic (i.e., antibacterial) effects on the gut microbiota and systemic immune response after spinal cord injury have largely been ignored despite their links to changes in mental health and immune suppression." ;
                                                                             rdfs:label "sentence_34174901_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34174901_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34174901_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34174901> ;
                                                                             gutprop:hasSentenceText "Here, we sought to determine minocycline's effect on spinal cord injury-induced changes in the microbiota-immune axis using a cervical contusion injury in female Lewis rats." ;
                                                                             rdfs:label "sentence_34174901_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34174901_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34174901_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34174901> ;
                                                                             gutprop:hasSentenceText "We investigated a group that received minocycline following spinal cord injury (immediately after injury for 7 days), an untreated spinal cord injury group, an untreated uninjured group, and an uninjured group that received minocycline." ;
                                                                             rdfs:label "sentence_34174901_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34174901_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34174901_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34174901> ;
                                                                             gutprop:hasSentenceText "Plasma levels of cytokines/chemokines and fecal microbiota composition (using 16s rRNA sequencing) were monitored for 4 weeks following spinal cord injury as measures of the microbiota-immune axis." ;
                                                                             rdfs:label "sentence_34174901_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34174901_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34174901_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34174901> ;
                                                                             gutprop:hasSentenceText "Additionally, motor recovery and anxiety-like behavior were assessed throughout the study, and microglial activation was analyzed immediately rostral to, caudal to, and at the lesion epicenter." ;
                                                                             rdfs:label "sentence_34174901_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34174901_8
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34174901_8> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34174901> ;
                                                                             gutprop:hasSentenceText "We found that minocycline had a profound acute effect on the microbiota diversity and composition, which was paralleled by the subsequent normalization of spinal cord injury-induced suppression of cytokines/chemokines." ;
                                                                             rdfs:label "sentence_34174901_8" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34174901_9
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34174901_9> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34174901> ;
                                                                             gutprop:hasSentenceText "Importantly, gut dysbiosis following spinal cord injury has been linked to the development of anxiety-like behavior, which was also decreased by minocycline." ;
                                                                             rdfs:label "sentence_34174901_9" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34204057_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34204057_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/34204057> ;
                                                                             gutprop:hasSentenceText "Mediterranean Diet as an Antioxidant: The Impact on Metabolic Health and Overall Wellbeing." ;
                                                                             rdfs:label "sentence_34204057_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34204057_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34204057_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34204057> ;
                                                                             gutprop:hasSentenceText "It has been established, worldwide, that non-communicable diseases such as obesity, diabetes, metabolic syndrome, and cardiovascular events account for a high percentage of morbidity and mortality in contemporary societies." ;
                                                                             rdfs:label "sentence_34204057_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34204057_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34204057_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34204057> ;
                                                                             gutprop:hasSentenceText "Several modifiable risk factors, such as sedentary activities, sleep deprivation, smoking, and unhealthy dietary habits have contributed to this increase." ;
                                                                             rdfs:label "sentence_34204057_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34204057_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34204057_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34204057> ;
                                                                             gutprop:hasSentenceText "Healthy nutrition in terms of adherence to the Mediterranean diet (MD), rich in fruits, legumes, vegetables, olive oil, herbs, spices, and high fiber intake may contribute to the decrease in this pandemic." ;
                                                                             rdfs:label "sentence_34204057_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34204057_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34204057_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34204057> ;
                                                                             gutprop:hasSentenceText "The beneficial effects of the MD can be mainly attributed to its numerous components rich in anti-inflammatory and antioxidant properties." ;
                                                                             rdfs:label "sentence_34204057_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34204057_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34204057_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34204057> ;
                                                                             gutprop:hasSentenceText "Moreover, the MD may further contribute to the improvement of reproductive health, modify the risk for neurodegenerative diseases, and protect against depression and psychosocial maladjustment." ;
                                                                             rdfs:label "sentence_34204057_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34204057_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34204057_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34204057> ;
                                                                             gutprop:hasSentenceText "There is also evidence highlighting the impact of healthy nutrition in female people on the composition of the gut microbiota and future metabolic and overall health of their offspring." ;
                                                                             rdfs:label "sentence_34204057_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34204057_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34204057_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34204057> ;
                                                                             gutprop:hasSentenceText "It is therefore important to highlight the beneficial effects of the MD on metabolic, reproductive, and mental health, while shaping the overall health of future generations." ;
                                                                             rdfs:label "sentence_34204057_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34204057_8
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34204057_8> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34204057> ;
                                                                             gutprop:hasSentenceText "The beneficial effects of MD can be further enhanced by increased physical activity in the context of a well-balanced healthy lifestyle." ;
                                                                             rdfs:label "sentence_34204057_8" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34205336_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34205336_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/34205336> ;
                                                                             gutprop:hasSentenceText "Regulation of Neurotransmitters by the Gut Microbiota and Effects on Cognition in Neurological Disorders." ;
                                                                             rdfs:label "sentence_34205336_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34205336_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34205336_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34205336> ;
                                                                             gutprop:hasSentenceText "Emerging evidence indicates that gut microbiota is important in the regulation of brain activity and cognitive functions." ;
                                                                             rdfs:label "sentence_34205336_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34205336_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34205336_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34205336> ;
                                                                             gutprop:hasSentenceText "Microbes mediate communication among the metabolic, peripheral immune, and central nervous systems via the microbiota-gut-brain axis." ;
                                                                             rdfs:label "sentence_34205336_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34205336_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34205336_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34205336> ;
                                                                             gutprop:hasSentenceText "However, it is not well understood how the gut microbiome and neurons in the brain mutually interact or how these interactions affect normal brain functioning and cognition." ;
                                                                             rdfs:label "sentence_34205336_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34205336_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34205336_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34205336> ;
                                                                             gutprop:hasSentenceText "We summarize the mechanisms whereby the gut microbiota regulate the production, transportation, and functioning of neurotransmitters." ;
                                                                             rdfs:label "sentence_34205336_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34205336_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34205336_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34205336> ;
                                                                             gutprop:hasSentenceText "We also discuss how microbiome dysbiosis affects cognitive function, especially in neurodegenerative diseases such as Alzheimer's disease and Parkinson's disease." ;
                                                                             rdfs:label "sentence_34205336_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34216356_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34216356_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/34216356> ;
                                                                             gutprop:hasSentenceText "The Relationship Between the Gut Microbiome and Neurodegenerative Diseases." ;
                                                                             rdfs:label "sentence_34216356_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34216356_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34216356_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34216356> ;
                                                                             gutprop:hasSentenceText "Many recent studies have shown that the gut microbiome plays important roles in human physiology and pathology." ;
                                                                             rdfs:label "sentence_34216356_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34216356_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34216356_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34216356> ;
                                                                             gutprop:hasSentenceText "Also, microbiome-based therapies have been used to improve health status and treat diseases." ;
                                                                             rdfs:label "sentence_34216356_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34216356_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34216356_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34216356> ;
                                                                             gutprop:hasSentenceText "In addition, aging and neurodegenerative diseases, including Alzheimer's disease and Parkinson's disease, have become topics of intense interest in biomedical research." ;
                                                                             rdfs:label "sentence_34216356_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34216356_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34216356_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34216356> ;
                                                                             gutprop:hasSentenceText "Several researchers have explored the links between these topics to study the potential pathogenic or therapeutic effects of intestinal microbiota in disease." ;
                                                                             rdfs:label "sentence_34216356_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34216356_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34216356_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34216356> ;
                                                                             gutprop:hasSentenceText "But the exact relationship between neurodegenerative diseases and gut microbiota remains unclear." ;
                                                                             rdfs:label "sentence_34216356_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34216356_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34216356_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34216356> ;
                                                                             gutprop:hasSentenceText "As technology advances, new techniques for studying the microbiome will be developed and refined, and the relationship between diseases and gut microbiota will be revealed." ;
                                                                             rdfs:label "sentence_34216356_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34216356_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34216356_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34216356> ;
                                                                             gutprop:hasSentenceText "This article summarizes the known interactions between the gut microbiome and neurodegenerative diseases, highlighting assay techniques for the gut microbiome, and we also discuss the potential therapeutic role of microbiome-based therapies in diseases." ;
                                                                             rdfs:label "sentence_34216356_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34250955_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34250955_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/34250955> ;
                                                                             gutprop:hasSentenceText "Parkinson's Disease and the Gut: Symptoms, Nutrition, and Microbiota." ;
                                                                             rdfs:label "sentence_34250955_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34250955_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34250955_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34250955> ;
                                                                             gutprop:hasSentenceText "Parkinson's disease (PD) is the second most common neurodegenerative disease worldwide, characterized by symptoms of bradykinesia, rigidity, postural instability, and tremor." ;
                                                                             rdfs:label "sentence_34250955_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34250955_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34250955_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34250955> ;
                                                                             gutprop:hasSentenceText "Recently, there has been a growing focus on the relationship between the gut and the development of PD." ;
                                                                             rdfs:label "sentence_34250955_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34250955_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34250955_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34250955> ;
                                                                             gutprop:hasSentenceText "Emerging to the forefront, an interesting concept has developed suggesting that the initial pathophysiological changes occur in the gastrointestinal tract before changes are seen within the brain." ;
                                                                             rdfs:label "sentence_34250955_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34250955_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34250955_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34250955> ;
                                                                             gutprop:hasSentenceText "This review is aimed at highlighting the relationship between PD and the gastrointestinal tract, along with the supporting evidence for this." ;
                                                                             rdfs:label "sentence_34250955_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34250955_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34250955_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34250955> ;
                                                                             gutprop:hasSentenceText "Firstly, we will focus on the gastrointestinal conditions and symptoms which commonly affects patients, including both upper and lower gastrointestinal issues." ;
                                                                             rdfs:label "sentence_34250955_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34250955_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34250955_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34250955> ;
                                                                             gutprop:hasSentenceText "Secondly, the impact of nutrition and diet on neurological health and PD physiology, with particular emphasis on commonly consumed items including macronutrients and micronutrients." ;
                                                                             rdfs:label "sentence_34250955_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34250955_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34250955_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34250955> ;
                                                                             gutprop:hasSentenceText "Finally, variability of the gut microbiome will also be discussed and its link with both the symptoms and signs of PD." ;
                                                                             rdfs:label "sentence_34250955_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34250955_8
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34250955_8> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34250955> ;
                                                                             gutprop:hasSentenceText "The evidence presented in this review highly suggests that the initial pathogenesis in the gut may proceed the development of prodromal PD subtypes, and therefore building on this further could be imperative and lead to earlier diagnosis with new and improved therapeutics." ;
                                                                             rdfs:label "sentence_34250955_8" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34277527_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34277527_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/34277527> ;
                                                                             gutprop:hasSentenceText "Towards Tailored Gut Microbiome-Based and Dietary Interventions for Promoting the Development and Maintenance of a Healthy Brain." ;
                                                                             rdfs:label "sentence_34277527_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34277527_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34277527_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34277527> ;
                                                                             gutprop:hasSentenceText "Mental health is determined by a complex interplay between the Neurological Exposome and the Human Genome." ;
                                                                             rdfs:label "sentence_34277527_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34277527_10
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34277527_10> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34277527> ;
                                                                              gutprop:hasSentenceText "Finally, we emphasize the need for further research to gain greater insight into the complex interplay between diet, gut microbiome and brain development." ;
                                                                              rdfs:label "sentence_34277527_10" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34277527_11
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34277527_11> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34277527> ;
                                                                              gutprop:hasSentenceText "Such knowledge would help towards achieving tailored integrative treatments, including personalized nutrition." ;
                                                                              rdfs:label "sentence_34277527_11" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34277527_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34277527_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34277527> ;
                                                                             gutprop:hasSentenceText "Multiple genetic and non-genetic (exposome) factors interact early in life, modulating the risk of developing the most common complex neurodevelopmental disorders (NDDs), with potential long-term consequences on health." ;
                                                                             rdfs:label "sentence_34277527_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34277527_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34277527_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34277527> ;
                                                                             gutprop:hasSentenceText "To date, the understating of the precise etiology underpinning these neurological alterations, and their clinical management pose a challenge." ;
                                                                             rdfs:label "sentence_34277527_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34277527_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34277527_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34277527> ;
                                                                             gutprop:hasSentenceText "The crucial role played by diet and gut microbiota in brain development and functioning would indicate that modulating the gut-brain axis may help protect against the onset and progression of mental-health disorders." ;
                                                                             rdfs:label "sentence_34277527_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34277527_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34277527_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34277527> ;
                                                                             gutprop:hasSentenceText "Some nutritional deficiencies and gut microbiota alterations have been linked to NDDs, suggesting their potential pathogenic implications." ;
                                                                             rdfs:label "sentence_34277527_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34277527_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34277527_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34277527> ;
                                                                             gutprop:hasSentenceText "In addition, certain dietary interventions have emerged as promising alternatives or adjuvant strategies for improving the management of particular NDDs, at least in particular subsets of subjects." ;
                                                                             rdfs:label "sentence_34277527_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34277527_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34277527_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34277527> ;
                                                                             gutprop:hasSentenceText "The gut microbiota can be a key to mediating the effects of other exposome factors such as diet on mental health, and ongoing research in Psychiatry and Neuropediatrics is developing Precision Nutrition Models to classify subjects according to a diet response prediction based on specific individual features, including microbiome signatures." ;
                                                                             rdfs:label "sentence_34277527_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34277527_8
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34277527_8> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34277527> ;
                                                                             gutprop:hasSentenceText "Here, we review current scientific evidence for the impact of early life environmental factors, including diet, on gut microbiota and neuro-development, emphasizing the potential long-term consequences on health; and also summarize the state of the art regarding the mechanisms underlying diet and gut microbiota influence on the brain-gut axis." ;
                                                                             rdfs:label "sentence_34277527_8" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34277527_9
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34277527_9> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34277527> ;
                                                                             gutprop:hasSentenceText "Furthermore, we describe the evidence supporting the key role played by gut microbiota, diet and nutrition in neurodevelopment, as well as the effectiveness of certain dietary and microbiome-based interventions aimed at preventing or treating NDDs." ;
                                                                             rdfs:label "sentence_34277527_9" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34290352_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34290352_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/34290352> ;
                                                                             gutprop:hasSentenceText "The change of gut microbiota in MDD patients under SSRIs treatment." ;
                                                                             rdfs:label "sentence_34290352_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34290352_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34290352_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34290352> ;
                                                                             gutprop:hasSentenceText "The alterations in the gut microbiota have been reported to be correlated with the development of depression." ;
                                                                             rdfs:label "sentence_34290352_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34290352_10
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34290352_10> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34290352> ;
                                                                              gutprop:hasSentenceText "The metabolic function of gut microbiota after treatment was still different from that of the control group." ;
                                                                              rdfs:label "sentence_34290352_10" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34290352_11
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34290352_11> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34290352> ;
                                                                              gutprop:hasSentenceText "This study suggests that the intestinal flora of depressed patients has a tendency to return to normal under escitalopram treatment." ;
                                                                              rdfs:label "sentence_34290352_11" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34290352_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34290352_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34290352> ;
                                                                             gutprop:hasSentenceText "The purpose of this study was to investigate the changes of intestinal microbiota in depressed patients after antidepressant treatment." ;
                                                                             rdfs:label "sentence_34290352_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34290352_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34290352_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34290352> ;
                                                                             gutprop:hasSentenceText "We recruited 30 MDD patients (MDD group) and 30 healthy controls (control group)." ;
                                                                             rdfs:label "sentence_34290352_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34290352_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34290352_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34290352> ;
                                                                             gutprop:hasSentenceText "The MDD group received individualized treatment with escitalopram at a maximum dose of 20 mg/day." ;
                                                                             rdfs:label "sentence_34290352_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34290352_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34290352_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34290352> ;
                                                                             gutprop:hasSentenceText "After depressive symptoms improved to a HAMD scale score > 50%, a fecal sample was collected again and used as the follow-up group." ;
                                                                             rdfs:label "sentence_34290352_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34290352_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34290352_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34290352> ;
                                                                             gutprop:hasSentenceText "The differences of gut microbiota between patients and controls, the characteristics of gut microbiota under treatment and the potential differences in metabolic functions were thus investigated." ;
                                                                             rdfs:label "sentence_34290352_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34290352_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34290352_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34290352> ;
                                                                             gutprop:hasSentenceText "The Firmicutes/Bacteroidetes ratio was significantly different within three groups, and the ratio of follow-up group was significantly lower than those of the other two groups." ;
                                                                             rdfs:label "sentence_34290352_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34290352_8
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34290352_8> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34290352> ;
                                                                             gutprop:hasSentenceText "Alpha diversity was significantly higher in MDD group than those of the other groups, and the alpha diversity was not significantly different between control and follow-up groups." ;
                                                                             rdfs:label "sentence_34290352_8" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34290352_9
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34290352_9> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34290352> ;
                                                                             gutprop:hasSentenceText "The beta diversity of some patients resembled participants in the control group." ;
                                                                             rdfs:label "sentence_34290352_9" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34311029_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34311029_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/34311029> ;
                                                                             gutprop:hasSentenceText "Fatty acids and beyond: Age and Alzheimer's disease related changes in lipids reveal the neuro-nutraceutical potential of lipids in cognition." ;
                                                                             rdfs:label "sentence_34311029_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34311029_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34311029_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34311029> ;
                                                                             gutprop:hasSentenceText "Lipids are essential in maintaining brain function, and lipid profiles have been reported to be altered in aged and Alzheimer's disease (AD) brains as compared to healthy mature brains." ;
                                                                             rdfs:label "sentence_34311029_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34311029_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34311029_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34311029> ;
                                                                             gutprop:hasSentenceText "Both age and AD share common metabolic hallmarks such as increased oxidative stress and perturbed metabolic function, and age remains the most strongly correlated risk factor for AD, a neurodegenerative disease." ;
                                                                             rdfs:label "sentence_34311029_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34311029_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34311029_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34311029> ;
                                                                             gutprop:hasSentenceText "A major accompanying pathological symptom of these conditions is cognitive impairment, which is linked with changes in lipid metabolism." ;
                                                                             rdfs:label "sentence_34311029_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34311029_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34311029_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34311029> ;
                                                                             gutprop:hasSentenceText "Thus, nutraceuticals that affect brain lipid metabolism or lipid levels as a whole have the potential to ameliorate cognitive decline." ;
                                                                             rdfs:label "sentence_34311029_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34311029_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34311029_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34311029> ;
                                                                             gutprop:hasSentenceText "Lipid analyses and lipidomic studies reveal changes in specific lipid types with aging and AD, which can identify potential lipid-based nutraceuticals to restore the brain to a healthy lipid phenotype." ;
                                                                             rdfs:label "sentence_34311029_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34311029_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34311029_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34311029> ;
                                                                             gutprop:hasSentenceText "The brain lipid profile can be influenced directly with dietary administration of lipids themselves, although because of synergistic effects of nutrients it may be more useful to consider a multi-component diet rather than single nutrient supplementation." ;
                                                                             rdfs:label "sentence_34311029_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34311029_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34311029_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34311029> ;
                                                                             gutprop:hasSentenceText "Gut microbiota also serve as a source of beneficial lipids, and the value of treatments that manipulate the composition of gut microbiome should not be ignored." ;
                                                                             rdfs:label "sentence_34311029_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34311029_8
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34311029_8> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34311029> ;
                                                                             gutprop:hasSentenceText "Lastly, instead of direct supplementation, compounds that affect pathways involved with lipid metabolism should also be considered as a way of manipulating lipid levels to improve cognition." ;
                                                                             rdfs:label "sentence_34311029_8" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34311029_9
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34311029_9> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34311029> ;
                                                                             gutprop:hasSentenceText "In this review, we briefly discuss the role of lipids in the brain, the changing lipid profile in AD, current research on lipid-based nutraceuticals and their therapeutic potential to combat cognitive impairment." ;
                                                                             rdfs:label "sentence_34311029_9" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34357134_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34357134_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/34357134> ;
                                                                             gutprop:hasSentenceText "Study Protocol: The Evaluation Study for Social Cognition Measures in Japan (ESCoM)." ;
                                                                             rdfs:label "sentence_34357134_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34357134_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34357134_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34357134> ;
                                                                             gutprop:hasSentenceText "In schizophrenia, social cognitive impairment is considered one of the greatest obstacles to social participation." ;
                                                                             rdfs:label "sentence_34357134_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34357134_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34357134_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34357134> ;
                                                                             gutprop:hasSentenceText "Although numerous measures have been developed to assess social cognition, only a limited number of them have become available in Japan." ;
                                                                             rdfs:label "sentence_34357134_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34357134_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34357134_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34357134> ;
                                                                             gutprop:hasSentenceText "We are therefore planning this evaluation study for social cognition measures in Japan (ESCoM) to confirm their psychometric characteristics and to promote research focused on social cognition." ;
                                                                             rdfs:label "sentence_34357134_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34357134_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34357134_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34357134> ;
                                                                             gutprop:hasSentenceText "Participants in the cross-sectional observational study will be 140 patients with schizophrenia recruited from three Japanese facilities and 70 healthy individuals." ;
                                                                             rdfs:label "sentence_34357134_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34357134_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34357134_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34357134> ;
                                                                             gutprop:hasSentenceText "In our primary analysis, we will calculate several psychometric indicators with a focus on whether they can independently predict social functioning." ;
                                                                             rdfs:label "sentence_34357134_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34357134_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34357134_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34357134> ;
                                                                             gutprop:hasSentenceText "In secondary analyses, we will assess the reliability and validity of the Japanese translations of each measure and conduct an exploratory investigation of patient background, psychiatric symptoms, defeatist performance belief, and gut microbiota as determinants of social cognition." ;
                                                                             rdfs:label "sentence_34357134_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34357134_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34357134_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34357134> ;
                                                                             gutprop:hasSentenceText "The protocol for this study is registered in UMIN-CTR, unique ID UMIN000043777." ;
                                                                             rdfs:label "sentence_34357134_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34357554_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34357554_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/34357554> ;
                                                                             gutprop:hasSentenceText "Immune-microbiome interplay and its implications in neurodegenerative disorders." ;
                                                                             rdfs:label "sentence_34357554_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34357554_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34357554_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34357554> ;
                                                                             gutprop:hasSentenceText "The neurodegeneration and its related CNS pathologies need an urgent toolbox to minimize the global mental health burden." ;
                                                                             rdfs:label "sentence_34357554_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34357554_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34357554_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34357554> ;
                                                                             gutprop:hasSentenceText "The neuroimmune system critically regulates the brain maturation and survival of neurons across the nervous system." ;
                                                                             rdfs:label "sentence_34357554_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34357554_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34357554_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34357554> ;
                                                                             gutprop:hasSentenceText "The chronic manipulated immunological drive can accelerate the neuronal pathology hence promoting the burden of neurodegenerative disorders." ;
                                                                             rdfs:label "sentence_34357554_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34357554_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34357554_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34357554> ;
                                                                             gutprop:hasSentenceText "The gut is home for trillions of microorganisms having a mutual relationship with the host system." ;
                                                                             rdfs:label "sentence_34357554_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34357554_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34357554_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34357554> ;
                                                                             gutprop:hasSentenceText "The gut-brain axis is a unique biochemical pathway through which the gut residing microbes connects with the brain cells and regulates various physiological and pathological cascades." ;
                                                                             rdfs:label "sentence_34357554_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34357554_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34357554_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34357554> ;
                                                                             gutprop:hasSentenceText "The gut microbiota and CNS communicate using a common language that synchronizes the tuning of immune cells." ;
                                                                             rdfs:label "sentence_34357554_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34357554_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34357554_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34357554> ;
                                                                             gutprop:hasSentenceText "The intestinal gut microbial community has a profound role in the maturation of the immune system as well as the development of the nervous system." ;
                                                                             rdfs:label "sentence_34357554_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34357554_8
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34357554_8> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34357554> ;
                                                                             gutprop:hasSentenceText "We have critically summarised the clinical and preclinical reports from the past a decade emphasising that the significant changes in gut microbiota can enhance the host susceptibility towards neurodegenerative disorders." ;
                                                                             rdfs:label "sentence_34357554_8" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34357554_9
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34357554_9> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34357554> ;
                                                                             gutprop:hasSentenceText "In this review, we have discussed how the gut microbiota-mediated immune response inclines the host physiology towards neurodegeneration and indicated the gut microbiota as a potential future candidate for the management of neurodegenerative disorders." ;
                                                                             rdfs:label "sentence_34357554_9" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34393849_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34393849_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/34393849> ;
                                                                             gutprop:hasSentenceText "Association Between Abundance of <i>Haemophilus</i> in the Gut Microbiota and Negative Symptoms of Schizophrenia." ;
                                                                             rdfs:label "sentence_34393849_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34393849_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34393849_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34393849> ;
                                                                             gutprop:hasSentenceText "Increasing evidence indicates an interaction between dysbiosis of the microbiota and the pathogenesis of schizophrenia." ;
                                                                             rdfs:label "sentence_34393849_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34393849_10
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34393849_10> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34393849> ;
                                                                              gutprop:hasSentenceText "Moreover, abundance of <i>Haemophilus</i> was positively correlated with cognition (<i>r</i> = 0.428, <i>P</i> = 0.009), excitement (<i>r</i> = 0.266, <i>P</i> = 0.037), and depression (<i>r</i> = 0.295, <i>P</i> = 0.020)." ;
                                                                              rdfs:label "sentence_34393849_10" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34393849_11
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34393849_11> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34393849> ;
                                                                              gutprop:hasSentenceText "The study findings suggest that alterations in certain gut microbiota may interfere with psychological symptoms in schizophrenia." ;
                                                                              rdfs:label "sentence_34393849_11" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34393849_12
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34393849_12> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34393849> ;
                                                                              gutprop:hasSentenceText "Our results provide evidence that may help in the development of therapeutic strategies using microbial-based targets." ;
                                                                              rdfs:label "sentence_34393849_12" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34393849_13
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34393849_13> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34393849> ;
                                                                              gutprop:hasSentenceText "The data that support the findings of this study have been deposited in the NCBI (https://submit.ncbi.nlm.nih.gov/) with accession number SUB9453991." ;
                                                                              rdfs:label "sentence_34393849_13" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34393849_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34393849_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34393849> ;
                                                                             gutprop:hasSentenceText "However, limited information is available on the specific microbial communities associated with symptoms of schizophrenia." ;
                                                                             rdfs:label "sentence_34393849_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34393849_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34393849_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34393849> ;
                                                                             gutprop:hasSentenceText "Therefore, this study aimed to investigate gut microbiota dysbiosis and its relationship with psychopathologies in schizophrenia." ;
                                                                             rdfs:label "sentence_34393849_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34393849_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34393849_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34393849> ;
                                                                             gutprop:hasSentenceText "We recruited 126 participants and divided them into three groups according to the Diagnostic and Statistical Manual of Mental Disorders, Fifth Edition, criteria-acute group (patients with acute schizophrenia), remission group (patients with schizophrenia in remission), and control group (healthy controls)." ;
                                                                             rdfs:label "sentence_34393849_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34393849_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34393849_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34393849> ;
                                                                             gutprop:hasSentenceText "Psychotic symptoms were evaluated using the Positive and Negative Syndrome Scale." ;
                                                                             rdfs:label "sentence_34393849_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34393849_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34393849_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34393849> ;
                                                                             gutprop:hasSentenceText "Microbiota compositions, diversity and community structure were evaluated using 16S rRNA sequencing." ;
                                                                             rdfs:label "sentence_34393849_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34393849_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34393849_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34393849> ;
                                                                             gutprop:hasSentenceText "Pearson's correlation analysis was used to evaluate the association between bacterial taxa and psychotic symptoms." ;
                                                                             rdfs:label "sentence_34393849_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34393849_8
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34393849_8> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34393849> ;
                                                                             gutprop:hasSentenceText "The beta-diversity of microbiota composition in the acute group was distinct from that in the remission and control groups (PC1 = 21.11% vs. PC2 = 12.86%, <i>P</i> = 0.021)." ;
                                                                             rdfs:label "sentence_34393849_8" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34393849_9
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34393849_9> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34393849> ;
                                                                             gutprop:hasSentenceText "Furthermore, Pearson's correlation analysis revealed that abundance of <i>Haemophilu</i>s was positively correlated with negative psychiatric symptoms (<i>r</i> = 0.303, <i>P</i> = 0.021), while abundance of <i>Coprococcus</i> was negatively correlated with negative psychiatric symptoms (<i>r</i> = -<i>0.285, P</i> = <i>0.025</i>)." ;
                                                                             rdfs:label "sentence_34393849_9" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34399524_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34399524_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/34399524> ;
                                                                             gutprop:hasSentenceText "Dietary advanced glycation endproducts (AGEs) increase their concentration in plasma and tissues, result in inflammation and modulate gut microbial composition in mice; evidence for reversibility." ;
                                                                             rdfs:label "sentence_34399524_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34399524_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34399524_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34399524> ;
                                                                             gutprop:hasSentenceText "Dietary advanced glycation endproducts (AGEs) are associated with negative biological effects, possibly due to accumulation in plasma and tissues and through modulation of inflammation and gut microbiota." ;
                                                                             rdfs:label "sentence_34399524_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34399524_10
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34399524_10> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34399524> ;
                                                                              gutprop:hasSentenceText "A high AGE-diet led to an increase of AGEs in plasma, kidney, and liver and to more inflammation and modification of the gut microbiota." ;
                                                                              rdfs:label "sentence_34399524_10" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34399524_11
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34399524_11> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34399524> ;
                                                                              gutprop:hasSentenceText "These effects were reversed or discontinued by a diet lower in AGEs." ;
                                                                              rdfs:label "sentence_34399524_11" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34399524_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34399524_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34399524> ;
                                                                             gutprop:hasSentenceText "Whether these biological consequences are reversible by limiting dietary AGE intake is unknown." ;
                                                                             rdfs:label "sentence_34399524_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34399524_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34399524_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34399524> ;
                                                                             gutprop:hasSentenceText "Young healthy C57BL/6 mice were fed a standard chow (n = 10) or a baked chow high AGE-diet (n = 10) (~1.8-6.9 fold increased protein-bound Nε-(carboxymethyl)lysine (CML), Nε-(1-carboxyethyl)lysine (CEL), and Nδ-(5-hydro-5-methyl-4-imidazolon-2-yl)-ornithine (MG-H1)) for 10 weeks or a switch diet with baked chow for 5 weeks followed by 5 weeks of standard chow (n = 10)." ;
                                                                             rdfs:label "sentence_34399524_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34399524_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34399524_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34399524> ;
                                                                             gutprop:hasSentenceText "We assessed accumulation of AGEs in plasma, kidney, and liver and measured inflammatory markers and gut microbial composition." ;
                                                                             rdfs:label "sentence_34399524_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34399524_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34399524_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34399524> ;
                                                                             gutprop:hasSentenceText "After 10 weeks of baked chow, a substantial panel of AGEs were increased in plasma, liver, and kidney." ;
                                                                             rdfs:label "sentence_34399524_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34399524_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34399524_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34399524> ;
                                                                             gutprop:hasSentenceText "These increases were normalized after the switch diet." ;
                                                                             rdfs:label "sentence_34399524_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34399524_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34399524_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34399524> ;
                                                                             gutprop:hasSentenceText "The inflammatory z-score increased after the baked chow diet." ;
                                                                             rdfs:label "sentence_34399524_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34399524_8
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34399524_8> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34399524> ;
                                                                             gutprop:hasSentenceText "Gut microbial composition differed significantly between groups, with enriched Dubosiella spp." ;
                                                                             rdfs:label "sentence_34399524_8" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34399524_9
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34399524_9> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34399524> ;
                                                                             gutprop:hasSentenceText "dominating these alterations." ;
                                                                             rdfs:label "sentence_34399524_9" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34408160_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34408160_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/34408160> ;
                                                                             gutprop:hasSentenceText "Exploring human-genome gut-microbiome interaction in Parkinson's disease." ;
                                                                             rdfs:label "sentence_34408160_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34408160_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34408160_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34408160> ;
                                                                             gutprop:hasSentenceText "The causes of complex diseases remain an enigma despite decades of epidemiologic research on environmental risks and genome-wide studies that have uncovered tens or hundreds of susceptibility loci for each disease." ;
                                                                             rdfs:label "sentence_34408160_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34408160_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34408160_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34408160> ;
                                                                             gutprop:hasSentenceText "We hypothesize that the microbiome is the missing link." ;
                                                                             rdfs:label "sentence_34408160_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34408160_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34408160_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34408160> ;
                                                                             gutprop:hasSentenceText "Genetic studies have shown that overexpression of alpha-synuclein, a key pathological protein in Parkinson's disease (PD), can cause familial PD and variants at alpha-synuclein locus confer risk of idiopathic PD." ;
                                                                             rdfs:label "sentence_34408160_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34408160_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34408160_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34408160> ;
                                                                             gutprop:hasSentenceText "Recently, dysbiosis of gut microbiome in PD was identified: altered abundances of three microbial clusters were found, one of which was composed of opportunistic pathogens." ;
                                                                             rdfs:label "sentence_34408160_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34408160_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34408160_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34408160> ;
                                                                             gutprop:hasSentenceText "Using two large datasets, we found evidence that the overabundance of opportunistic pathogens in PD gut is influenced by the host genotype at the alpha-synuclein locus, and that the variants responsible modulate alpha-synuclein expression." ;
                                                                             rdfs:label "sentence_34408160_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34408160_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34408160_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34408160> ;
                                                                             gutprop:hasSentenceText "Results put forth testable hypotheses on the role of gut microbiome in the pathogenesis of PD, the incomplete penetrance of PD susceptibility genes, and potential triggers of pathology in the gut." ;
                                                                             rdfs:label "sentence_34408160_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34422393_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34422393_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/34422393> ;
                                                                             gutprop:hasSentenceText "A discussion of the gut microbiome's development, determinants, and dysbiosis in cancers of the esophagus and stomach." ;
                                                                             rdfs:label "sentence_34422393_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34422393_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34422393_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34422393> ;
                                                                             gutprop:hasSentenceText "The microbiome refers to a population of microbes that colonize the skin, nasopharynx, oral cavity, gastrointestinal tract, and urogenital tract." ;
                                                                             rdfs:label "sentence_34422393_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34422393_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34422393_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34422393> ;
                                                                             gutprop:hasSentenceText "The human microbiome consists of bacteria, archaea, fungi, viruses, and phages." ;
                                                                             rdfs:label "sentence_34422393_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34422393_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34422393_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34422393> ;
                                                                             gutprop:hasSentenceText "Recent advances in genomic sequencing have catalyzed a deeper understanding of complex microbe-microbe and host-microbe interactions." ;
                                                                             rdfs:label "sentence_34422393_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34422393_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34422393_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34422393> ;
                                                                             gutprop:hasSentenceText "Dysregulation of these interactions, or dysbiosis of the gastrointestinal tract, has been implicated in a growing list of pathologies including nonalcoholic fatty liver disease, cardiovascular disease, obesity, diabetes, depression, Parkinson's disease, autism, and various gastrointestinal cancers." ;
                                                                             rdfs:label "sentence_34422393_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34422393_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34422393_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34422393> ;
                                                                             gutprop:hasSentenceText "Gastric and esophageal cancer, for example, continue to remain as two of the most common causes of cancer-related deaths worldwide, therefore there is an increased emphasis on investigating the role of dysbiosis on these cancers." ;
                                                                             rdfs:label "sentence_34422393_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34422393_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34422393_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34422393> ;
                                                                             gutprop:hasSentenceText "In this review, we discuss the development and structure of the gut microbiome, its homeostatic and dysbiotic mechanisms, and the key microbes in esophageal and gastric carcinogenesis with a focus on bacterial biology." ;
                                                                             rdfs:label "sentence_34422393_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34422393_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34422393_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34422393> ;
                                                                             gutprop:hasSentenceText "Further clarification of these pathways and discovery of diagnostic or therapeutic targets could have broad impacts on global subpopulations." ;
                                                                             rdfs:label "sentence_34422393_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34422393_8
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34422393_8> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34422393> ;
                                                                             gutprop:hasSentenceText "It is important to understand the nature of the gastrointestinal tract microbiome and its potentional risk factors for dysbiosis in order to tailor its application to the individual patient and create an era of highly personalized, precision medicine." ;
                                                                             rdfs:label "sentence_34422393_8" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34422879_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34422879_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/34422879> ;
                                                                             gutprop:hasSentenceText "Memorable Food: Fighting Age-Related Neurodegeneration by Precision Nutrition." ;
                                                                             rdfs:label "sentence_34422879_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34422879_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34422879_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34422879> ;
                                                                             gutprop:hasSentenceText "Healthcare systems worldwide are seriously challenged by a rising prevalence of neurodegenerative diseases (NDDs), which mostly, but not exclusively, affect the ever-growing population of the elderly." ;
                                                                             rdfs:label "sentence_34422879_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34422879_10
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34422879_10> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34422879> ;
                                                                              gutprop:hasSentenceText "Many studies have associated the Mediterranean diet with a decreased risk of dementia and AD, but a cause-and-effect relationship has not been deduced." ;
                                                                              rdfs:label "sentence_34422879_10" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34422879_11
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34422879_11> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34422879> ;
                                                                              gutprop:hasSentenceText "Studies with caloric restriction showed neuroprotective effects in animal models, but the results in humans are inconsistent." ;
                                                                              rdfs:label "sentence_34422879_11" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34422879_12
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34422879_12> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34422879> ;
                                                                              gutprop:hasSentenceText "The pathologies of NDD are complex and there is a great inter-individual (epi)genetic variance within any population." ;
                                                                              rdfs:label "sentence_34422879_12" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34422879_13
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34422879_13> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34422879> ;
                                                                              gutprop:hasSentenceText "Furthermore, the gut microbiome, being deeply involved in nutrient uptake and lipid metabolism, also represents a pillar of the gut microbiome-brain axis and is linked with the pathogenesis of NDD." ;
                                                                              rdfs:label "sentence_34422879_13" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34422879_14
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34422879_14> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34422879> ;
                                                                              gutprop:hasSentenceText "Numerous studies on the role of different micronutrients (omega-3 fatty acids, bioactive polyphenols from fruit and medicinal plants) in the prevention, prediction, and treatment of NDD have been conducted, but we are still far away from a personalized diet plan for individual NDD patients." ;
                                                                              rdfs:label "sentence_34422879_14" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34422879_15
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34422879_15> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34422879> ;
                                                                              gutprop:hasSentenceText "For this to be realized, large-scale cohorts that would include the precise monitoring of food intake, mapping of genetic variants, epigenetic data, microbiome studies, and metabolome, lipidome, and transcriptome data are needed." ;
                                                                              rdfs:label "sentence_34422879_15" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34422879_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34422879_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34422879> ;
                                                                             gutprop:hasSentenceText "The most known neurodegenerative diseases are Alzheimer's (AD) and Parkinson's disease, multiple sclerosis, and amyotrophic lateral sclerosis, but some viral infections of the brain and traumatic brain injury may also cause NDD." ;
                                                                             rdfs:label "sentence_34422879_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34422879_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34422879_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34422879> ;
                                                                             gutprop:hasSentenceText "Typical for NDD are the malfunctioning of neurons and their irreversible loss, which often progress irreversibly to dementia and ultimately to death." ;
                                                                             rdfs:label "sentence_34422879_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34422879_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34422879_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34422879> ;
                                                                             gutprop:hasSentenceText "Numerous factors are involved in the pathogenesis of NDD: genetic variability, epigenetic changes, extent of oxidative/nitrosative stress, mitochondrial dysfunction, and DNA damage." ;
                                                                             rdfs:label "sentence_34422879_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34422879_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34422879_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34422879> ;
                                                                             gutprop:hasSentenceText "The complex interplay of all the above-mentioned factors may be a fingerprint of neurodegeneration, with different diseases being affected to different extents by particular factors." ;
                                                                             rdfs:label "sentence_34422879_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34422879_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34422879_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34422879> ;
                                                                             gutprop:hasSentenceText "There is a voluminous body of evidence showing the benefits of regular exercise to brain health and cognitive functions." ;
                                                                             rdfs:label "sentence_34422879_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34422879_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34422879_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34422879> ;
                                                                             gutprop:hasSentenceText "Moreover, the importance of a healthy diet, balanced in macro- and micro-nutrients, in preventing neurodegeneration and slowing down a progression to full-blown disease is evident." ;
                                                                             rdfs:label "sentence_34422879_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34422879_8
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34422879_8> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34422879> ;
                                                                             gutprop:hasSentenceText "Individuals affected by NDD almost inevitably have low-grade inflammation and anomalies in lipid metabolism." ;
                                                                             rdfs:label "sentence_34422879_8" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34422879_9
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34422879_9> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34422879> ;
                                                                             gutprop:hasSentenceText "Metabolic and lipid profiles in NDD can be improved by the Mediterranean diet." ;
                                                                             rdfs:label "sentence_34422879_9" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34437440_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34437440_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/34437440> ;
                                                                             gutprop:hasSentenceText "Association of Polygenic Risk Score and Bacterial Toxins at Screening Colonoscopy with Colorectal Cancer Progression: A Multicenter Case-Control Study." ;
                                                                             rdfs:label "sentence_34437440_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34437440_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34437440_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34437440> ;
                                                                             gutprop:hasSentenceText "Colorectal cancer (CRC) is a leading cause of cancer death worldwide, and its incidence is correlated with infections, chronic inflammation, diet, and genetic factors." ;
                                                                             rdfs:label "sentence_34437440_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34437440_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34437440_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34437440> ;
                                                                             gutprop:hasSentenceText "An emerging aspect is that microbial dysbiosis and chronic infections triggered by certain bacteria can be risk factors for tumor progression." ;
                                                                             rdfs:label "sentence_34437440_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34437440_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34437440_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34437440> ;
                                                                             gutprop:hasSentenceText "Recent data suggest that certain bacterial toxins implicated in DNA attack or in proliferation, replication, and death can be risk factors for insurgence and progression of CRC." ;
                                                                             rdfs:label "sentence_34437440_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34437440_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34437440_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34437440> ;
                                                                             gutprop:hasSentenceText "In this study, we recruited more than 300 biopsy specimens from people undergoing colonoscopy, and we analyzed to determine whether a correlation exists between the presence of bacterial genes coding for toxins possibly involved in CRC onset and progression and the different stages of CRC." ;
                                                                             rdfs:label "sentence_34437440_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34437440_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34437440_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34437440> ;
                                                                             gutprop:hasSentenceText "We also analyzed to determine whether CRC-predisposing genetic factors could contribute to bacterial toxins response." ;
                                                                             rdfs:label "sentence_34437440_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34437440_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34437440_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34437440> ;
                                                                             gutprop:hasSentenceText "Our results showed that CIF toxin is associated with polyps or adenomas, whereas pks+ seems to be a predisposing factor for CRC." ;
                                                                             rdfs:label "sentence_34437440_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34437440_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34437440_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34437440> ;
                                                                             gutprop:hasSentenceText "Toxins from <i>Escherichia coli</i> as a whole have a higher incidence rate in adenocarcinoma patients compared to controls, whereas <i>Bacteroides fragilis</i> toxin does not seem to be associated with pre-cancerous nor with cancerous lesions." ;
                                                                             rdfs:label "sentence_34437440_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34437440_8
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34437440_8> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34437440> ;
                                                                             gutprop:hasSentenceText "These results have been obtained irrespectively of the presence of CRC-risk loci." ;
                                                                             rdfs:label "sentence_34437440_8" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34444820_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34444820_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/34444820> ;
                                                                             gutprop:hasSentenceText "Effects of Probiotic NVP-1704 on Mental Health and Sleep in Healthy Adults: An 8-Week Randomized, Double-Blind, Placebo-Controlled Trial." ;
                                                                             rdfs:label "sentence_34444820_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34444820_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34444820_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34444820> ;
                                                                             gutprop:hasSentenceText "The human gut microbiome is closely linked to mental health and sleep." ;
                                                                             rdfs:label "sentence_34444820_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34444820_10
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34444820_10> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34444820> ;
                                                                              gutprop:hasSentenceText "Furthermore, NVP-1704 increased <i>Bifidobacteriaceae</i> and <i>Lactobacillacea</i>, whereas it decreased <i>Enterobacteriaceae</i> in the gut microbiota composition." ;
                                                                              rdfs:label "sentence_34444820_10" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34444820_11
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34444820_11> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34444820> ;
                                                                              gutprop:hasSentenceText "Our findings suggest that probiotic NVP-1704 could be beneficial for mental health and sleep." ;
                                                                              rdfs:label "sentence_34444820_11" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34444820_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34444820_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34444820> ;
                                                                             gutprop:hasSentenceText "We aimed to verify the efficacy and safety of probiotic NVP-1704, a mixture of <i>Lactobacillus reuteri</i> NK33 and <i>Bifidobacterium adolescentis</i> NK98, in improving stress, depression, anxiety, and sleep disturbances, along with the measurement of some blood biomarkers." ;
                                                                             rdfs:label "sentence_34444820_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34444820_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34444820_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34444820> ;
                                                                             gutprop:hasSentenceText "A total of 156 healthy adults with subclinical symptoms of depression, anxiety, and insomnia were retrospectively registered and randomly assigned to receive either NVP-1704 (<i>n</i> = 78) or a placebo (<i>n</i> = 78) for eight weeks." ;
                                                                             rdfs:label "sentence_34444820_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34444820_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34444820_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34444820> ;
                                                                             gutprop:hasSentenceText "Participants completed the Stress Response Inventory, Beck's Depression and Anxiety Inventory, Pittsburg Sleep Quality Index, and Insomnia Severity Index at baseline, at four and eight weeks of treatment." ;
                                                                             rdfs:label "sentence_34444820_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34444820_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34444820_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34444820> ;
                                                                             gutprop:hasSentenceText "Pre- and post-treatment blood tests for biomarkers were conducted." ;
                                                                             rdfs:label "sentence_34444820_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34444820_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34444820_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34444820> ;
                                                                             gutprop:hasSentenceText "After intervention, gut microbiota composition was quantified by pyrosequencing the bacterial 16S rRNA gene." ;
                                                                             rdfs:label "sentence_34444820_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34444820_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34444820_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34444820> ;
                                                                             gutprop:hasSentenceText "The NVP-1704 group had a more significant reduction in depressive symptoms at four and eight weeks of treatment, and anxiety symptoms at four weeks compared to the placebo group." ;
                                                                             rdfs:label "sentence_34444820_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34444820_8
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34444820_8> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34444820> ;
                                                                             gutprop:hasSentenceText "Those receiving NVP-1704 also experienced an improvement in sleep quality." ;
                                                                             rdfs:label "sentence_34444820_8" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34444820_9
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34444820_9> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34444820> ;
                                                                             gutprop:hasSentenceText "NVP-1704 treatment led to a decrease in serum interleukin-6 levels." ;
                                                                             rdfs:label "sentence_34444820_9" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34448737_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34448737_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/34448737> ;
                                                                             gutprop:hasSentenceText "Depression: A Gut \"Microbiome\" Feeling!" ;
                                                                             rdfs:label "sentence_34448737_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34448737_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34448737_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34448737> ;
                                                                             gutprop:hasSentenceText "Burgeoning body of evidence from neuroscience is pouring in highlighting a potential association between gut microbiota with the pathophysiology of depression and anxiety." ;
                                                                             rdfs:label "sentence_34448737_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34448737_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34448737_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34448737> ;
                                                                             gutprop:hasSentenceText "Manipulation of gut microbiota may be then useful to decode this role and to provide novel therapeutics for major depressive disorder (MDD), developing microbiota-related biomarkers to stratify patients at risk and to delineate more homogeneous biotypes of MDD." ;
                                                                             rdfs:label "sentence_34448737_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34480631_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34480631_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/34480631> ;
                                                                             gutprop:hasSentenceText "Microglial depletion and abnormalities in gut microbiota composition and short-chain fatty acids in mice after repeated administration of colony stimulating factor 1 receptor inhibitor PLX5622." ;
                                                                             rdfs:label "sentence_34480631_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34480631_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34480631_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34480631> ;
                                                                             gutprop:hasSentenceText "PLX5622, a brain-penetrant highly specific inhibitor of the colony-stimulating factor 1 receptor (CSF1R), is used to eliminate microglia in the brain." ;
                                                                             rdfs:label "sentence_34480631_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34480631_10
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34480631_10> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34480631> ;
                                                                              gutprop:hasSentenceText "Therefore, abnormalities in the composition of gut microbiota after repeated treatment of PLX5622 should be considered for behavioral and biological functions in animals treated with CSF1R inhibitors." ;
                                                                              rdfs:label "sentence_34480631_10" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34480631_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34480631_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34480631> ;
                                                                             gutprop:hasSentenceText "Considering the role of microglia and gut microbiota in the brain homeostasis, this study was undertaken to investigate whether repeated intragastric administration of PLX5622 (65 mg/kg/day for consecutive 7 days) could affect the composition of gut microbiota and the concentration of short-chain fatty acids (SCFAs) in fresh feces of adult mice." ;
                                                                             rdfs:label "sentence_34480631_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34480631_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34480631_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34480631> ;
                                                                             gutprop:hasSentenceText "Repeated administration of PLX5622 caused significant reductions of the expression of genes and proteins for microglial markers in the prefrontal cortex (PFC) and hippocampus compared to control mice although the elimination of brain's microglia was partial." ;
                                                                             rdfs:label "sentence_34480631_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34480631_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34480631_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34480631> ;
                                                                             gutprop:hasSentenceText "There was a significant alteration in the β-diversity of intestine microbiota in the PLX5622-treated group." ;
                                                                             rdfs:label "sentence_34480631_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34480631_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34480631_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34480631> ;
                                                                             gutprop:hasSentenceText "Linear discriminant analysis effect size identified eight significant enriched bacteria as microbial markers for PLX5622-treated group." ;
                                                                             rdfs:label "sentence_34480631_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34480631_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34480631_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34480631> ;
                                                                             gutprop:hasSentenceText "Repeated administration of PLX5622 affected the relative abundance of several bacteria at the genus and species levels." ;
                                                                             rdfs:label "sentence_34480631_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34480631_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34480631_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34480631> ;
                                                                             gutprop:hasSentenceText "Furthermore, repeated administration of PLX5622 caused a significant change in lactic acid compared to control group." ;
                                                                             rdfs:label "sentence_34480631_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34480631_8
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34480631_8> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34480631> ;
                                                                             gutprop:hasSentenceText "Interestingly, we found significant correlations between microglial markers in the brain and the relative abundance of several bacteria, suggesting microbiome-microglia crosstalk through the brain-gut axis." ;
                                                                             rdfs:label "sentence_34480631_8" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34480631_9
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34480631_9> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34480631> ;
                                                                             gutprop:hasSentenceText "These data demonstrate that repeated administration of PLX5622 leads to an abnormal composition of the gut microbiota and lactic acid in adult mice." ;
                                                                             rdfs:label "sentence_34480631_9" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34520319_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34520319_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/34520319> ;
                                                                             gutprop:hasSentenceText "Sleep, circadian rhythm and gut microbiota: alterations in Alzheimer's disease and their potential links in the pathogenesis." ;
                                                                             rdfs:label "sentence_34520319_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34520319_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34520319_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34520319> ;
                                                                             gutprop:hasSentenceText "ABSTRATCIn recent years, emerging studies have observed gut microbiota (GM) alterations in Alzheimer's disease (AD), even in individuals with mild cognitive impairment (MCI)." ;
                                                                             rdfs:label "sentence_34520319_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34520319_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34520319_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34520319> ;
                                                                             gutprop:hasSentenceText "Further, impaired sleep and circadian patterns are common symptoms of AD, while sleep and circadian rhythm disruption (SCRD) is associated with greater β-amyloid (Aβ) burden and AD risk, sometimes years before the clinical onset of AD." ;
                                                                             rdfs:label "sentence_34520319_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34520319_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34520319_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34520319> ;
                                                                             gutprop:hasSentenceText "Moreover, reports have demonstrated that GM and its metabolites exhibit diurnal rhythmicity and the role of SCRD in dampening the GM rhythmicity and eubiosis." ;
                                                                             rdfs:label "sentence_34520319_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34520319_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34520319_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34520319> ;
                                                                             gutprop:hasSentenceText "This review will provide an evaluation of clinical and animal studies describing GM alterations in distinct conditions, including AD, sleep and circadian disruption." ;
                                                                             rdfs:label "sentence_34520319_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34520319_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34520319_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34520319> ;
                                                                             gutprop:hasSentenceText "It aims to identify the overlapping and distinctive GM alterations in these conditions and their contributions to pathophysiology." ;
                                                                             rdfs:label "sentence_34520319_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34520319_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34520319_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34520319> ;
                                                                             gutprop:hasSentenceText "Although most studies are observational and use different methodologies, data indicate partial commonalities in GM alterations and unanimity at functional level." ;
                                                                             rdfs:label "sentence_34520319_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34520319_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34520319_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34520319> ;
                                                                             gutprop:hasSentenceText "Finally, we discuss the possible interactions between SCRD and GM in AD pathogenesis, as well as several methodological improvements that are necessary for future research." ;
                                                                             rdfs:label "sentence_34520319_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34560239_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34560239_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/34560239> ;
                                                                             gutprop:hasSentenceText "Regulation of neurotoxicity in the striatum and colon of MPTP-induced Parkinson's disease mice by gut microbiome." ;
                                                                             rdfs:label "sentence_34560239_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34560239_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34560239_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34560239> ;
                                                                             gutprop:hasSentenceText "Increasing evidence suggests the role of gut-microbiota-brain axis in the pathogenesis of Parkinson's disease (PD)." ;
                                                                             rdfs:label "sentence_34560239_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34560239_10
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34560239_10> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34560239> ;
                                                                              gutprop:hasSentenceText "The data suggest that MPTP-induced increases in colonic p-α-Syn expression might be associated with dopaminergic neurotoxicity in the striatum via gut-microbiota-brain axis." ;
                                                                              rdfs:label "sentence_34560239_10" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34560239_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34560239_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34560239> ;
                                                                             gutprop:hasSentenceText "The objective of this study was to examine whether repeated administration of MPTP (1-methyl-4-phenyl-1,2,3,6-tetrahydropyridine) can influence the neurotoxicity in the striatum and colon, and the composition of gut microbiota and short-chain fatty acids (SCFAs) in feces of adult mice." ;
                                                                             rdfs:label "sentence_34560239_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34560239_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34560239_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34560239> ;
                                                                             gutprop:hasSentenceText "MPTP caused the reduction of dopamine transporter (DAT) and tyrosine hydroxylase (TH) in the striatum, and increases in phosphorylated α-synuclein (p-α-Syn) in the striatum and colon." ;
                                                                             rdfs:label "sentence_34560239_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34560239_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34560239_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34560239> ;
                                                                             gutprop:hasSentenceText "There was a negative correlation between the expression of TH in the striatum and the expression of p-α-Syn in the colon, suggesting a role of gut-brain communication." ;
                                                                             rdfs:label "sentence_34560239_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34560239_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34560239_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34560239> ;
                                                                             gutprop:hasSentenceText "MPTP caused abnormalities in the α- and β-diversity of gut microbiota in the mice." ;
                                                                             rdfs:label "sentence_34560239_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34560239_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34560239_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34560239> ;
                                                                             gutprop:hasSentenceText "Furthermore, the relative abundance of the genus Faecalicatena in the MPTP-treated group was significantly lower than that of control group." ;
                                                                             rdfs:label "sentence_34560239_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34560239_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34560239_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34560239> ;
                                                                             gutprop:hasSentenceText "Interestingly, there was a positive correlation between the genus Faecalicatena and the expression of TH in the striatum." ;
                                                                             rdfs:label "sentence_34560239_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34560239_8
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34560239_8> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34560239> ;
                                                                             gutprop:hasSentenceText "Moreover, MPTP did not alter the levels of SCFAs in feces samples." ;
                                                                             rdfs:label "sentence_34560239_8" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34560239_9
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34560239_9> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34560239> ;
                                                                             gutprop:hasSentenceText "However, there was a positive correlation between the relative abundance of the genus Faecalicatena and propionic acid." ;
                                                                             rdfs:label "sentence_34560239_9" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34576000_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34576000_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/34576000> ;
                                                                             gutprop:hasSentenceText "Nuclear and Mitochondrial Genome, Epigenome and Gut Microbiome: Emerging Molecular Biomarkers for Parkinson's Disease." ;
                                                                             rdfs:label "sentence_34576000_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34576000_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34576000_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34576000> ;
                                                                             gutprop:hasSentenceText "Parkinson's disease (PD) is currently the second most common neurodegenerative disorder, burdening about 10 million elderly individuals worldwide." ;
                                                                             rdfs:label "sentence_34576000_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34576000_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34576000_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34576000> ;
                                                                             gutprop:hasSentenceText "The multifactorial nature of PD poses a difficult obstacle for understanding the mechanisms involved in its onset and progression." ;
                                                                             rdfs:label "sentence_34576000_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34576000_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34576000_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34576000> ;
                                                                             gutprop:hasSentenceText "Currently, diagnosis depends on the appearance of clinical signs, some of which are shared among various neurologic disorders, hindering early diagnosis." ;
                                                                             rdfs:label "sentence_34576000_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34576000_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34576000_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34576000> ;
                                                                             gutprop:hasSentenceText "There are no effective tools to prevent PD onset, detect the disease in early stages or accurately report the risk of disease progression." ;
                                                                             rdfs:label "sentence_34576000_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34576000_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34576000_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34576000> ;
                                                                             gutprop:hasSentenceText "Hence, there is an increasing demand for biomarkers that may identify disease onset and progression, as treatment-based medicine may not be the best approach for PD." ;
                                                                             rdfs:label "sentence_34576000_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34576000_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34576000_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34576000> ;
                                                                             gutprop:hasSentenceText "Over the last few decades, the search for molecular markers to predict susceptibility, aid in accurate diagnosis and evaluate the progress of PD have intensified, but strategies aimed to improve individualized patient care have not yet been established." ;
                                                                             rdfs:label "sentence_34576000_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34576000_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34576000_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34576000> ;
                                                                             gutprop:hasSentenceText "Genomic variation, regulation by epigenomic mechanisms, as well as the influence of the host gut microbiome seem to have a crucial role in the onset and progress of PD, thus are considered potential biomarkers." ;
                                                                             rdfs:label "sentence_34576000_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34576000_8
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34576000_8> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34576000> ;
                                                                             gutprop:hasSentenceText "As such, the human nuclear and mitochondrial genome, epigenome, and the host gut microbiome might be the key elements to the rise of personalized medicine for PD patients." ;
                                                                             rdfs:label "sentence_34576000_8" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34576833_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34576833_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/34576833> ;
                                                                             gutprop:hasSentenceText "Specific Changes in the Mammalian Gut Microbiome as a Biomarker for Oxytocin-Induced Behavioral Changes." ;
                                                                             rdfs:label "sentence_34576833_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34576833_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34576833_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34576833> ;
                                                                             gutprop:hasSentenceText "Prolonged exposure to psychiatric pharmacological agents is often associated with marked gastrointestinal phenomena, including changes in food intake, bowel motility, gastric emptying, and transit time." ;
                                                                             rdfs:label "sentence_34576833_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34576833_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34576833_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34576833> ;
                                                                             gutprop:hasSentenceText "Those changes are reflected in the gut microbiota composition of the patient and can, therefore, be objectively measured." ;
                                                                             rdfs:label "sentence_34576833_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34576833_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34576833_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34576833> ;
                                                                             gutprop:hasSentenceText "This is in contrast to the standard psychiatric evaluation of patients, which includes symptoms that are subjectively assessed (i.e., mood, anxiety level, perception, thought disorders, etc.)." ;
                                                                             rdfs:label "sentence_34576833_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34576833_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34576833_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34576833> ;
                                                                             gutprop:hasSentenceText "The association between a drug's effect on the microbiota and psychiatric symptoms may allow for quantifiable surrogate markers of treatment effectiveness." ;
                                                                             rdfs:label "sentence_34576833_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34576833_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34576833_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34576833> ;
                                                                             gutprop:hasSentenceText "Changes in the levels of specific drug-sensitive bacterial species can, thus, potentially serve as biomarkers for the intake and effectiveness of psychiatric drugs." ;
                                                                             rdfs:label "sentence_34576833_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34576833_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34576833_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34576833> ;
                                                                             gutprop:hasSentenceText "Here, we show substantial microbiota changes that were associated with oxytocin administration and the decreased anxiety/depression-like behaviors it conferred in a rat model of corticosterone-induced stress." ;
                                                                             rdfs:label "sentence_34576833_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34576833_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34576833_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34576833> ;
                                                                             gutprop:hasSentenceText "Compared with oxytocin, citalopram produced more minor effects on the rats' microbiota." ;
                                                                             rdfs:label "sentence_34576833_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34576833_8
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34576833_8> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34576833> ;
                                                                             gutprop:hasSentenceText "Alterations in the gut microbiota may, therefore, reflect the consumption and effectiveness of some psychiatric drugs." ;
                                                                             rdfs:label "sentence_34576833_8" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34589800_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34589800_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/34589800> ;
                                                                             gutprop:hasSentenceText "Beyond the neuro-immune interplay in depression: Could gut microbes be the missing link?" ;
                                                                             rdfs:label "sentence_34589800_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34589800_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34589800_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34589800> ;
                                                                             gutprop:hasSentenceText "Accumulating evidence have positioned inflammatory signaling pathways as crucial routes by which microbes inhabiting the gastrointestinal tract (the gut microbiota) communicate with the host brain to influence behavior, with impacts on mental illnesses." ;
                                                                             rdfs:label "sentence_34589800_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34589800_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34589800_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34589800> ;
                                                                             gutprop:hasSentenceText "In this short review, an overview of inflammatory and gut microbiota status in human depression and in rodent models of the illness are provided." ;
                                                                             rdfs:label "sentence_34589800_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34589800_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34589800_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34589800> ;
                                                                             gutprop:hasSentenceText "Next, potential inflammatory pathways mediating the communications between the gut and the brain under stressful conditions are described." ;
                                                                             rdfs:label "sentence_34589800_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34589800_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34589800_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34589800> ;
                                                                             gutprop:hasSentenceText "Finally, dietary interventions targeting the gut microbiota-immune-brain axis in the context of depression are briefly discussed." ;
                                                                             rdfs:label "sentence_34589800_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34589852_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34589852_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/34589852> ;
                                                                             gutprop:hasSentenceText "Nutritional psychiatry in the treatment of psychotic disorders: Current hypotheses and research challenges." ;
                                                                             rdfs:label "sentence_34589852_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34589852_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34589852_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34589852> ;
                                                                             gutprop:hasSentenceText "Current treatment for schizophrenia-spectrum disorders focusses primarily on psychotropic medication to treat symptoms, though their efficacy varies between patients and psychotropic medication is often accompanied by severe side effects." ;
                                                                             rdfs:label "sentence_34589852_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34589852_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34589852_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34589852> ;
                                                                             gutprop:hasSentenceText "Nutritional interventions to prevent and treat mental illness have received considerable attention over recent years." ;
                                                                             rdfs:label "sentence_34589852_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34589852_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34589852_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34589852> ;
                                                                             gutprop:hasSentenceText "However, evidence for nutritional interventions in schizophrenia-spectrum disorders remains limited in quantity and quality." ;
                                                                             rdfs:label "sentence_34589852_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34589852_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34589852_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34589852> ;
                                                                             gutprop:hasSentenceText "Pathways currently in focus include: i) nutritional deficits and impairments in glucose metabolism, ii) inflammation and immune dysregulation (also known from the mild encephalitis hypothesis), and iii) altered gut microbiota." ;
                                                                             rdfs:label "sentence_34589852_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34589852_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34589852_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34589852> ;
                                                                             gutprop:hasSentenceText "All of which appear to be interconnected." ;
                                                                             rdfs:label "sentence_34589852_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34589852_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34589852_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34589852> ;
                                                                             gutprop:hasSentenceText "Key limiting factors for advancing research in this field are research challenges associated with assessing and interpreting inflammatory profiles, microbiota and subjective nutritional assessments, which is further complicated by illness characteristics." ;
                                                                             rdfs:label "sentence_34589852_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34589852_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34589852_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34589852> ;
                                                                             gutprop:hasSentenceText "This review describes the state of evidence for key hypotheses, including underlying mechanisms, implicated in schizophrenia-spectrum disorders, the challenges in nutritional psychiatry research and the current state of nutrition interventions in mental healthcare." ;
                                                                             rdfs:label "sentence_34589852_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34603341_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34603341_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/34603341> ;
                                                                             gutprop:hasSentenceText "Consumption of Butylated Starch Alleviates the Chronic Restraint Stress-Induced Neurobehavioral and Gut Barrier Deficits Through Reshaping the Gut Microbiota." ;
                                                                             rdfs:label "sentence_34603341_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34603341_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34603341_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34603341> ;
                                                                             gutprop:hasSentenceText "The beneficial effect of short-chain fatty acids (SCFAs) on host health has been well recognized based on the booming knowledge from gut microbiome research." ;
                                                                             rdfs:label "sentence_34603341_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34603341_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34603341_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34603341> ;
                                                                             gutprop:hasSentenceText "The role of SCFA in influencing psychological function is highlighted in recent years but has not been fully elucidated." ;
                                                                             rdfs:label "sentence_34603341_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34603341_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34603341_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34603341> ;
                                                                             gutprop:hasSentenceText "In this study, the SCFA-acylated starches were used to accomplish a sizeable intestine-targeted release of the SCFAs, and the neurobehavioral, immunological, and microbial effects were further investigated." ;
                                                                             rdfs:label "sentence_34603341_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34603341_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34603341_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34603341> ;
                                                                             gutprop:hasSentenceText "Acetylated-, butylated-, and isobutylated-starch could attenuate the depression-like behaviors and excessive corticosterone production in chronically stressed mice." ;
                                                                             rdfs:label "sentence_34603341_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34603341_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34603341_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34603341> ;
                                                                             gutprop:hasSentenceText "Butylated- starch significantly reduced the colonic permeability <i>via</i> increasing the tight junction proteins (including ZO-1, Claudin, and Occludin) gene expression and reduced the level of the inflammatory cytokines (including IL-1β and IL-6)." ;
                                                                             rdfs:label "sentence_34603341_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34603341_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34603341_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34603341> ;
                                                                             gutprop:hasSentenceText "The butylated starch's neurological and immunological benefits may be derived from the gut microbiome modifications, including normalizing the abundance of certain beneficial microbes (<i>Odoribacter</i> and <i>Oscillibacter</i>) and metabolomic pathways (<i>Tryptophan synthesis</i> and <i>Inositol degradation</i>)." ;
                                                                             rdfs:label "sentence_34603341_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34603341_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34603341_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34603341> ;
                                                                             gutprop:hasSentenceText "The present findings further validate the brain-beneficial effect of butyrate and offer novel guidance for developing novel food or dietary supplements for improving mental health." ;
                                                                             rdfs:label "sentence_34603341_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34692176_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34692176_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/34692176> ;
                                                                             gutprop:hasSentenceText "A Review of Inflammatory Bowel Disease: A Model of Microbial, Immune and Neuropsychological Integration." ;
                                                                             rdfs:label "sentence_34692176_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34692176_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34692176_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34692176> ;
                                                                             gutprop:hasSentenceText "<b>Objective:</b> Inflammatory bowel diseases (IBDs) are complex chronic inflammatory disorders of the gastro-intestinal (GI) tract with uncertain etiology." ;
                                                                             rdfs:label "sentence_34692176_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34692176_10
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34692176_10> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34692176> ;
                                                                              gutprop:hasSentenceText "Commonly cited published literatures with high quality research methodology/results and additional articles from bibliographies of recovered papers were examined and included where relevant." ;
                                                                              rdfs:label "sentence_34692176_10" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34692176_11
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34692176_11> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34692176> ;
                                                                              gutprop:hasSentenceText "<b>Results:</b> Although there is a substantial literature identifying major contributing factors with IBD, there has been little attempt to integrate some factors over time and assess their interplay and relationship with IBD disease activity." ;
                                                                              rdfs:label "sentence_34692176_11" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34692176_12
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34692176_12> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34692176> ;
                                                                              gutprop:hasSentenceText "Such contributing factors include genetic and environmental factors, gut microbiota composition and function, physiological factors, psychological state and gut immune response." ;
                                                                              rdfs:label "sentence_34692176_12" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34692176_13
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34692176_13> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34692176> ;
                                                                              gutprop:hasSentenceText "Interdependences are evident across psychological and biological factors and IBD disease activity." ;
                                                                              rdfs:label "sentence_34692176_13" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34692176_14
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34692176_14> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34692176> ;
                                                                              gutprop:hasSentenceText "Although from the available evidence, it is implausible that a single explanatory model could elucidate the interplay between such factors and the disease course as well as the sequence of the effect during the pathophysiology of IBD." ;
                                                                              rdfs:label "sentence_34692176_14" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34692176_15
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34692176_15> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34692176> ;
                                                                              gutprop:hasSentenceText "<b>Conclusion:</b> Longitudinal monitoring of IBD patients and integrating data related to the contributing/risk factors including psychological state, physiological conditions, inflammatory/immune modulations, and microbiome composition/function, could help to explain how major factors associate and interrelate leading to exacerbation of symptoms and disease activity." ;
                                                                              rdfs:label "sentence_34692176_15" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34692176_16
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34692176_16> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34692176> ;
                                                                              gutprop:hasSentenceText "Identifying the temporal trajectory of biological and psychosocial disturbances may also help to assess their effects and interdependence on individuals' disease status." ;
                                                                              rdfs:label "sentence_34692176_16" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34692176_17
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34692176_17> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34692176> ;
                                                                              gutprop:hasSentenceText "Moreover, this allows greater insight into understanding the temporal progressions of subclinical events as potential ground for disease severity in IBD." ;
                                                                              rdfs:label "sentence_34692176_17" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34692176_18
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34692176_18> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34692176> ;
                                                                              gutprop:hasSentenceText "Furthermore, understanding the interaction between these risk factors may help better interventions in controlling the disease, reducing the costs related to disease management, further implications for clinical practice and research approaches in addition to improving patients' mental health and quality of life." ;
                                                                              rdfs:label "sentence_34692176_18" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34692176_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34692176_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34692176> ;
                                                                             gutprop:hasSentenceText "IBDs comprise two idiopathic disorders: Crohn's disease (CD) and ulcerative colitis (UC)." ;
                                                                             rdfs:label "sentence_34692176_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34692176_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34692176_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34692176> ;
                                                                             gutprop:hasSentenceText "The aetiology, severity and progression of such disorders are still poorly understood but thought to be influenced by multiple factors (including genetic, environmental, immunological, physiological, psychological factors and gut microbiome) and their interactions." ;
                                                                             rdfs:label "sentence_34692176_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34692176_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34692176_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34692176> ;
                                                                             gutprop:hasSentenceText "The overarching aim of this review is to evaluate the extent and nature of the interrelationship between these factors with the disease course." ;
                                                                             rdfs:label "sentence_34692176_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34692176_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34692176_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34692176> ;
                                                                             gutprop:hasSentenceText "A broader conceptual and longitudinal framework of possible neuro-visceral integration, core microbiome analysis and immune modulation assessment may be useful in accurately documenting and characterizing the nature and temporal continuity of crosstalk between these factors and the role of their interaction (s) in IBD disease activity." ;
                                                                             rdfs:label "sentence_34692176_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34692176_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34692176_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34692176> ;
                                                                             gutprop:hasSentenceText "Characterization of these interactions holds the promise of identifying novel diagnostic, interventions, and therapeutic strategies." ;
                                                                             rdfs:label "sentence_34692176_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34692176_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34692176_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34692176> ;
                                                                             gutprop:hasSentenceText "<b>Material and Methods:</b> A search of published literature was conducted by exploring PubMed, EMBASE, MEDLINE, Medline Plus, CDSR library databases." ;
                                                                             rdfs:label "sentence_34692176_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34692176_8
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34692176_8> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34692176> ;
                                                                             gutprop:hasSentenceText "Following search terms relating to key question were set for the search included: \"Inflammatory bowel diseases,\" \"gut microbiota,\" \"psychological distress and IBD,\" \"autonomic reactivity and IBD,\" \"immune modulation,\" \"chronic inflammation,\" \"gut inflammation,\" \"enteric nervous system,\" \"gut nervous system,\" \"Crohn's disease,\" \"Ulcerative colitis\", \"depression and IBD\", \"anxiety and IBD\", \"quality of life in IBD patients,\" \"relapse in IBDs,\" \"remission in IBDs,\" \"IBD disease activity,\" \"brain-gut-axis,\" \"microbial signature in IBD,\" \"validated questionnaires in IBD,\" \"IBD activity indices,\" \"IBD aetiology,\" \"IBDs and stress,\" \"epidemiology of IBDs\", \"autonomic nervous system and gut inflammation\", \"IBD and environment,\" \"genetics of IBDs,\" \"pathways of immune response in IBDs,\" \"sleep disturbances in IBD,\" \"hypothalamic-pituitary-adrenal axis (HPA),\" \"sympatho-adrenal axis,\" \"CNS and its control of gut function\" \"mucosal immune response,\" \"commensal and pathogenic bacteria in the gut,\" \"innate and adaptive immunity.\"" ;
                                                                             rdfs:label "sentence_34692176_8" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34692176_9
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34692176_9> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34692176> ;
                                                                             gutprop:hasSentenceText "Studies evaluating any possible associations between gut microbiome, psychological state, immune modulation, and autonomic function with IBDs were identified." ;
                                                                             rdfs:label "sentence_34692176_9" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34704023_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34704023_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/34704023> ;
                                                                             gutprop:hasSentenceText "Gut microbiome alpha-diversity is not a marker of Parkinson's disease and multiple sclerosis." ;
                                                                             rdfs:label "sentence_34704023_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34704023_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34704023_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34704023> ;
                                                                             gutprop:hasSentenceText "The gut-brain axis may play a central role in the pathogenesis of neurological disorders." ;
                                                                             rdfs:label "sentence_34704023_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34704023_10
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34704023_10> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34704023> ;
                                                                              gutprop:hasSentenceText "Five studies were meta-analysed for multiple sclerosis, corresponding to 303 subjects (164 Multiple Sclerosis/139 healthy controls)." ;
                                                                              rdfs:label "sentence_34704023_10" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34704023_11
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34704023_11> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34704023> ;
                                                                              gutprop:hasSentenceText "For Alzheimer's disease, the meta-analysis was not done as only two studies matched our criteria." ;
                                                                              rdfs:label "sentence_34704023_11" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34704023_12
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34704023_12> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34704023> ;
                                                                              gutprop:hasSentenceText "Neither richness nor evenness was significantly altered in Parkinson's disease and multiple sclerosis patients in comparison to healthy controls (<i>P</i>-value > 0.05)." ;
                                                                              rdfs:label "sentence_34704023_12" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34704023_13
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34704023_13> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34704023> ;
                                                                              gutprop:hasSentenceText "Shannon index was neither associated with neurological disorders (<i>P</i>-value > 0.05)." ;
                                                                              rdfs:label "sentence_34704023_13" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34704023_14
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34704023_14> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34704023> ;
                                                                              gutprop:hasSentenceText "After adjusting for age and sex, none of the alpha-diversity measures were associated with Parkinson's Disease." ;
                                                                              rdfs:label "sentence_34704023_14" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34704023_15
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34704023_15> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34704023> ;
                                                                              gutprop:hasSentenceText "This is the first report investigating systematically alpha-diversity and its potential link to neurological disorders." ;
                                                                              rdfs:label "sentence_34704023_15" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34704023_16
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34704023_16> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34704023> ;
                                                                              gutprop:hasSentenceText "Our study has demonstrated that unlike in other gastro-intestinal, immune and metabolic disorders, loss of bacterial diversity is not associated with Parkinson's disease and multiple sclerosis." ;
                                                                              rdfs:label "sentence_34704023_16" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34704023_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34704023_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34704023> ;
                                                                             gutprop:hasSentenceText "Dozens of case-control studies have been carried out to identify bacterial markers by the use of targeted metagenomics." ;
                                                                             rdfs:label "sentence_34704023_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34704023_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34704023_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34704023> ;
                                                                             gutprop:hasSentenceText "Alterations of several taxonomic profiles have been confirmed across several populations, however, no consensus has been made regarding alpha-diversity." ;
                                                                             rdfs:label "sentence_34704023_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34704023_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34704023_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34704023> ;
                                                                             gutprop:hasSentenceText "A recent publication has described and validated a novel method based on richness and evenness measures of the gut microbiome in order to reduce the complexity and multiplicity of alpha-diversity indices." ;
                                                                             rdfs:label "sentence_34704023_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34704023_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34704023_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34704023> ;
                                                                             gutprop:hasSentenceText "We used these recently described richness and evenness composite measures to investigate the potential link between gut microbiome alpha-diversity and neurological disorders and to determine to what extent it could be used as a marker to diagnose neurological disorders from stool samples." ;
                                                                             rdfs:label "sentence_34704023_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34704023_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34704023_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34704023> ;
                                                                             gutprop:hasSentenceText "We performed an exhaustive review of the literature to identify original published clinical studies including 16S rRNA gene sequencing on Parkinson's disease, multiple Sclerosis and Alzheimer's disease." ;
                                                                             rdfs:label "sentence_34704023_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34704023_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34704023_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34704023> ;
                                                                             gutprop:hasSentenceText "Richness and evenness factors loadings were quantified from sequencing files in addition with the Shannon diversity index." ;
                                                                             rdfs:label "sentence_34704023_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34704023_8
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34704023_8> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34704023> ;
                                                                             gutprop:hasSentenceText "For each disease, we performed a meta-analysis comparing the indices between patients and healthy controls." ;
                                                                             rdfs:label "sentence_34704023_8" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34704023_9
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34704023_9> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34704023> ;
                                                                             gutprop:hasSentenceText "Seven studies were meta-analysed for Parkinson's disease, corresponding to 1067 subjects (631 Parkinson's Disease/436 healthy controls)." ;
                                                                             rdfs:label "sentence_34704023_9" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34758889_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34758889_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/34758889> ;
                                                                             gutprop:hasSentenceText "A fiber-deprived diet causes cognitive impairment and hippocampal microglia-mediated synaptic loss through the gut microbiota and metabolites." ;
                                                                             rdfs:label "sentence_34758889_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34758889_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34758889_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34758889> ;
                                                                             gutprop:hasSentenceText "Cognitive impairment, an increasing mental health issue, is a core feature of the aging brain and neurodegenerative diseases." ;
                                                                             rdfs:label "sentence_34758889_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34758889_10
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34758889_10> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34758889> ;
                                                                              gutprop:hasSentenceText "Of note, a rapid differentiating microbiota change was observed in the mice with a short-term FD diet (7 days) before cognitive impairment, highlighting a possible causal impact of the gut microbiota profile on cognitive outcomes." ;
                                                                              rdfs:label "sentence_34758889_10" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34758889_11
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34758889_11> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34758889> ;
                                                                              gutprop:hasSentenceText "Moreover, the FD diet compromised the intestinal barrier and reduced short-chain fatty acid (SCFA) production." ;
                                                                              rdfs:label "sentence_34758889_11" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34758889_12
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34758889_12> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34758889> ;
                                                                              gutprop:hasSentenceText "We exploit these findings for SCFA receptor knockout mice and oral SCFA supplementation that verified SCFA playing a critical role linking the altered gut microbiota and cognitive impairment." ;
                                                                              rdfs:label "sentence_34758889_12" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34758889_13
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34758889_13> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34758889> ;
                                                                              gutprop:hasSentenceText "This study, for the first time, reports that a fiber-deprived diet leads to cognitive impairment through altering the gut microbiota-hippocampal axis, which is pathologically distinct from normal brain aging." ;
                                                                              rdfs:label "sentence_34758889_13" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34758889_14
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34758889_14> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34758889> ;
                                                                              gutprop:hasSentenceText "These findings alert the adverse impact of dietary fiber deficiency on brain function, and highlight an increase in fiber intake as a nutritional strategy to reduce the risk of developing diet-associated cognitive decline and neurodegenerative diseases." ;
                                                                              rdfs:label "sentence_34758889_14" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34758889_15
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34758889_15> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34758889> ;
                                                                              gutprop:hasSentenceText "Video Abstract." ;
                                                                              rdfs:label "sentence_34758889_15" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34758889_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34758889_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34758889> ;
                                                                             gutprop:hasSentenceText "Industrialized nations especially, have experienced a marked decrease in dietary fiber intake, but the potential mechanism linking low fiber intake and cognitive impairment is poorly understood." ;
                                                                             rdfs:label "sentence_34758889_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34758889_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34758889_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34758889> ;
                                                                             gutprop:hasSentenceText "Emerging research reported that the diversity of gut microbiota in Western populations is significantly reduced." ;
                                                                             rdfs:label "sentence_34758889_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34758889_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34758889_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34758889> ;
                                                                             gutprop:hasSentenceText "However, it is unknown whether a fiber-deficient diet (which alters gut microbiota) could impair cognition and brain functional elements through the gut-brain axis." ;
                                                                             rdfs:label "sentence_34758889_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34758889_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34758889_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34758889> ;
                                                                             gutprop:hasSentenceText "In this study, a mouse model of long-term (15 weeks) dietary fiber deficiency (FD) was used to mimic a sustained low fiber intake in humans." ;
                                                                             rdfs:label "sentence_34758889_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34758889_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34758889_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34758889> ;
                                                                             gutprop:hasSentenceText "We found that FD mice showed impaired cognition, including deficits in object location memory, temporal order memory, and the ability to perform daily living activities." ;
                                                                             rdfs:label "sentence_34758889_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34758889_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34758889_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34758889> ;
                                                                             gutprop:hasSentenceText "The hippocampal synaptic ultrastructure was damaged in FD mice, characterized by widened synaptic clefts and thinned postsynaptic densities." ;
                                                                             rdfs:label "sentence_34758889_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34758889_8
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34758889_8> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34758889> ;
                                                                             gutprop:hasSentenceText "A hippocampal proteomic analysis further identified a deficit of CaMKIId and its associated synaptic proteins (including GAP43 and SV2C) in the FD mice, along with neuroinflammation and microglial engulfment of synapses." ;
                                                                             rdfs:label "sentence_34758889_8" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34758889_9
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34758889_9> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34758889> ;
                                                                             gutprop:hasSentenceText "The FD mice also exhibited gut microbiota dysbiosis (decreased Bacteroidetes and increased Proteobacteria), which was significantly associated with the cognitive deficits." ;
                                                                             rdfs:label "sentence_34758889_9" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34776854_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34776854_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/34776854> ;
                                                                             gutprop:hasSentenceText "Changes in the Gut Microbiome and Predicted Functional Metabolic Effects in an Australian Parkinson's Disease Cohort." ;
                                                                             rdfs:label "sentence_34776854_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34776854_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34776854_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34776854> ;
                                                                             gutprop:hasSentenceText "<b>Background:</b> There has been increasing recognition of the importance of the gut microbiome in Parkinson's disease (PD), but the influence of geographic location has received little attention." ;
                                                                             rdfs:label "sentence_34776854_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34776854_10
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34776854_10> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34776854> ;
                                                                              gutprop:hasSentenceText "<b>Conclusion:</b> This study provides the first comprehensive characterization of the gut microbiome and predicted functional metabolic effects in a southern hemisphere PD population, further exploring the possible mechanisms whereby the gut microbiota may exert their influence on this disease, and providing evidence for the incorporation of such data in future individualized therapeutic strategies." ;
                                                                              rdfs:label "sentence_34776854_10" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34776854_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34776854_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34776854> ;
                                                                             gutprop:hasSentenceText "The present study characterized the gut microbiota and associated changes in host metabolic pathways in an Australian cohort of people with PD (PwP)." ;
                                                                             rdfs:label "sentence_34776854_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34776854_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34776854_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34776854> ;
                                                                             gutprop:hasSentenceText "<b>Methods:</b> The study involved recruitment and assessment of 87 PwP from multiple Movement Disorders Clinics in Australia and 47 healthy controls." ;
                                                                             rdfs:label "sentence_34776854_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34776854_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34776854_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34776854> ;
                                                                             gutprop:hasSentenceText "Illumina sequencing of the V3 and V4 regions of the 16S rRNA gene was used to distinguish inter-cohort differences in gut microbiota; KEGG analysis was subsequently performed to predict functional changes in host metabolic pathways." ;
                                                                             rdfs:label "sentence_34776854_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34776854_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34776854_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34776854> ;
                                                                             gutprop:hasSentenceText "<b>Results:</b> The current findings identified significant differences in relative abundance and diversity of microbial operational taxonomic units (OTUs), and specific bacterial taxa between PwP and control groups." ;
                                                                             rdfs:label "sentence_34776854_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34776854_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34776854_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34776854> ;
                                                                             gutprop:hasSentenceText "Alpha diversity was significantly reduced in PwP when compared to controls." ;
                                                                             rdfs:label "sentence_34776854_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34776854_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34776854_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34776854> ;
                                                                             gutprop:hasSentenceText "Differences were found in two phyla (Synergistetes and Proteobacteria; both increased in PwP), and five genera (C<i>olidextribacter, Intestinibacter, Kineothrix, Agathobaculum</i>, and <i>Roseburia</i>; all decreased in PwP)." ;
                                                                             rdfs:label "sentence_34776854_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34776854_8
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34776854_8> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34776854> ;
                                                                             gutprop:hasSentenceText "Within the PD cohort, there was no association identified between microbial composition and gender, constipation or use of gastrointestinal medication." ;
                                                                             rdfs:label "sentence_34776854_8" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34776854_9
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34776854_9> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34776854> ;
                                                                             gutprop:hasSentenceText "Furthermore, KEGG analysis identified 15 upregulated and 11 downregulated metabolic pathways which were predicted to be significantly altered in PwP." ;
                                                                             rdfs:label "sentence_34776854_9" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34830610_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34830610_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/34830610> ;
                                                                             gutprop:hasSentenceText "Targeting the Gut Microbiome in Prader-Willi Syndrome." ;
                                                                             rdfs:label "sentence_34830610_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34830610_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34830610_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34830610> ;
                                                                             gutprop:hasSentenceText "Overwhelming evidence demonstrates an important role of the gut microbiome in the development of a wide range of diseases, including obesity, metabolic disorders, and mental health symptoms." ;
                                                                             rdfs:label "sentence_34830610_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34830610_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34830610_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34830610> ;
                                                                             gutprop:hasSentenceText "Indeed, interventions targeting the gut microbiome are being actively investigated as a therapeutic strategy to tackle these diseases." ;
                                                                             rdfs:label "sentence_34830610_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34830610_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34830610_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34830610> ;
                                                                             gutprop:hasSentenceText "Given that obesity and mental health symptoms are both hallmarks of Prader-Willi syndrome, targeting the gut microbiome may be a promising therapeutical strategy." ;
                                                                             rdfs:label "sentence_34830610_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34830610_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34830610_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34830610> ;
                                                                             gutprop:hasSentenceText "Only a few studies have investigated the gut microbiome in the context of Prader-Willi syndrome and assessed the efficacy of probiotic supplementation as a therapeutic strategy for this disease." ;
                                                                             rdfs:label "sentence_34830610_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34830610_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34830610_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34830610> ;
                                                                             gutprop:hasSentenceText "Here, we review the knowledge obtained to this date regarding the gut microbiome in individuals with Prader-Willi syndrome." ;
                                                                             rdfs:label "sentence_34830610_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34830610_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34830610_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34830610> ;
                                                                             gutprop:hasSentenceText "The limited evidence available indicate that probiotic supplementation improves some metabolic and mental health aspects, however further studies are warranted to determine whether targeting the gut microbiome may constitute a safe and efficient strategy to treat individuals with Prader-Willi syndrome." ;
                                                                             rdfs:label "sentence_34830610_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34836918_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34836918_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/34836918> ;
                                                                             gutprop:hasSentenceText "Footprints of a microbial toxin from the gut microbiome to mesencephalic mitochondria." ;
                                                                             rdfs:label "sentence_34836918_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34836918_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34836918_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34836918> ;
                                                                             gutprop:hasSentenceText "Idiopathic Parkinson's disease (PD) is characterised by alpha-synuclein (aSyn) aggregation and death of dopaminergic neurons in the midbrain." ;
                                                                             rdfs:label "sentence_34836918_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34836918_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34836918_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34836918> ;
                                                                             gutprop:hasSentenceText "Recent evidence posits that PD may initiate in the gut by microbes or their toxins that promote chronic gut inflammation that will ultimately impact the brain." ;
                                                                             rdfs:label "sentence_34836918_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34836918_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34836918_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34836918> ;
                                                                             gutprop:hasSentenceText "In this work, we sought to demonstrate that the effects of the microbial toxin β-<i>N</i>-methylamino-L-alanine (BMAA) in the gut may trigger some PD cases, which is especially worrying as this toxin is present in certain foods but not routinely monitored by public health authorities." ;
                                                                             rdfs:label "sentence_34836918_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34836918_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34836918_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34836918> ;
                                                                             gutprop:hasSentenceText "To test the hypothesis, we treated wild-type mice, primary neuronal cultures, cell lines and isolated mitochondria with BMAA, and analysed its impact on gut microbiota composition, barrier permeability, inflammation and aSyn aggregation as well as in brain inflammation, dopaminergic neuronal loss and motor behaviour." ;
                                                                             rdfs:label "sentence_34836918_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34836918_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34836918_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34836918> ;
                                                                             gutprop:hasSentenceText "To further examine the key role of mitochondria, we also determined the specific effects of BMAA on mitochondrial function and on inflammasome activation." ;
                                                                             rdfs:label "sentence_34836918_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34836918_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34836918_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34836918> ;
                                                                             gutprop:hasSentenceText "BMAA induced extensive depletion of segmented filamentous bacteria (SFB) that regulate gut immunity, thus triggering gut dysbiosis, immune cell migration, increased intestinal inflammation, loss of barrier integrity and caudo-rostral progression of aSyn." ;
                                                                             rdfs:label "sentence_34836918_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34836918_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34836918_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34836918> ;
                                                                             gutprop:hasSentenceText "Additionally, BMAA induced <i>in vitro</i> and <i>in vivo</i> mitochondrial dysfunction with cardiolipin exposure and consequent activation of neuronal innate immunity." ;
                                                                             rdfs:label "sentence_34836918_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34836918_8
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34836918_8> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34836918> ;
                                                                             gutprop:hasSentenceText "These events primed neuroinflammation, dopaminergic neuronal loss and motor deficits." ;
                                                                             rdfs:label "sentence_34836918_8" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34836918_9
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34836918_9> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34836918> ;
                                                                             gutprop:hasSentenceText "Taken together, our results demonstrate that chronic exposure to dietary BMAA can trigger a chain of events that recapitulate the evolution of the PD pathology from the gut to the brain, which is consistent with 'gut-first' PD." ;
                                                                             rdfs:label "sentence_34836918_9" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34870091_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34870091_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/34870091> ;
                                                                             gutprop:hasSentenceText "Compositional and functional alterations in the oral and gut microbiota in patients with psychosis or schizophrenia: A systematic review." ;
                                                                             rdfs:label "sentence_34870091_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34870091_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34870091_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34870091> ;
                                                                             gutprop:hasSentenceText "<b>Background:</b> Gut and oral microbiota are intrinsically linked to human health." ;
                                                                             rdfs:label "sentence_34870091_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34870091_10
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34870091_10> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34870091> ;
                                                                              gutprop:hasSentenceText "<b>Discussion:</b> Changes in microbiota composition in psychosis and schizophrenia have been correlated with alternations in brain structure and function, altered immunity, altered metabolic pathways and symptom severity." ;
                                                                              rdfs:label "sentence_34870091_10" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34870091_11
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34870091_11> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34870091> ;
                                                                              gutprop:hasSentenceText "Changes have also been identified as potential biomarkers for psychosis that might aid in diagnosis." ;
                                                                              rdfs:label "sentence_34870091_11" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34870091_12
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34870091_12> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34870091> ;
                                                                              gutprop:hasSentenceText "Understanding how predicted or actual functional alterations in microbial genes or metabolic pathways influence symptomatic expression and downstream clinical outcomes may contribute to the development of microbiome targeted interventions for psychosis." ;
                                                                              rdfs:label "sentence_34870091_12" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34870091_13
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34870091_13> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34870091> ;
                                                                              gutprop:hasSentenceText "<b>Registration:</b> The study is prospectively registered in PROSPERO, the International Prospective Register of Systematic Reviews (CRD42021260208)." ;
                                                                              rdfs:label "sentence_34870091_13" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34870091_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34870091_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34870091> ;
                                                                             gutprop:hasSentenceText "Recent studies suggest a direct link with mental health through bidirectional gut-brain pathways." ;
                                                                             rdfs:label "sentence_34870091_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34870091_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34870091_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34870091> ;
                                                                             gutprop:hasSentenceText "Emerging evidence suggests that the composition and/or function of intestinal microbiome differs in those with psychosis and schizophrenia as compared with controls." ;
                                                                             rdfs:label "sentence_34870091_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34870091_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34870091_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34870091> ;
                                                                             gutprop:hasSentenceText "There is relatively little research on the predicted or actual functional alterations associated with the composition of oral and gut microbiota in patients with psychosis." ;
                                                                             rdfs:label "sentence_34870091_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34870091_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34870091_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34870091> ;
                                                                             gutprop:hasSentenceText "We will perform a systematic review and meta-analysis to identify, evaluate and if possible, combine the published literature on compositional alterations in the oral and gut microbiota in patients with psychosis or schizophrenia compared with healthy controls." ;
                                                                             rdfs:label "sentence_34870091_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34870091_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34870091_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34870091> ;
                                                                             gutprop:hasSentenceText "We also aim to explore the potential functional impact of any compositional changes." ;
                                                                             rdfs:label "sentence_34870091_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34870091_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34870091_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34870091> ;
                                                                             gutprop:hasSentenceText "<b>Methods:</b> Original studies involving humans and animals using a case-control, cohort or cross-sectional design will be included." ;
                                                                             rdfs:label "sentence_34870091_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34870091_8
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34870091_8> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34870091> ;
                                                                             gutprop:hasSentenceText "The electronic databases PsycINFO, EMBASE, Web of Science, PubMed/MEDLINE and Cochrane will be systematically searched." ;
                                                                             rdfs:label "sentence_34870091_8" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34870091_9
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34870091_9> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34870091> ;
                                                                             gutprop:hasSentenceText "Quantitative analyses will be performed using random-effects meta-analyses to calculate mean difference with 95% confidence intervals." ;
                                                                             rdfs:label "sentence_34870091_9" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34884399_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34884399_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/34884399> ;
                                                                             gutprop:hasSentenceText "Differences in the Composition of Gut Microbiota between Patients with Parkinson's Disease and Healthy Controls: A Cohort Study." ;
                                                                             rdfs:label "sentence_34884399_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34884399_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34884399_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34884399> ;
                                                                             gutprop:hasSentenceText "Gut microbiome and colonic inflammation can be associated with the predisposition and progression of Parkinson's disease (PD)." ;
                                                                             rdfs:label "sentence_34884399_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34884399_10
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34884399_10> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34884399> ;
                                                                              gutprop:hasSentenceText "Among PD patients, our results presented a higher abundance of <i>Bacteroides</i> phylum, class <i>Corynebacteria</i> among phylum <i>Actinobacteria</i>, class <i>Deltaproteobacteria</i> among phylum <i>Proteobacteria</i>, and genera such as <i>Butyricimonas, Robinsoniella</i>, and <i>Flavonifractor</i>." ;
                                                                              rdfs:label "sentence_34884399_10" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34884399_11
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34884399_11> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34884399> ;
                                                                              gutprop:hasSentenceText "The species <i>Akkermansia muciniphila</i>, <i>Eubacterium biforme</i>, and <i>Parabacteroides merdae</i> were identified as more common in the gut microbiota of PD patients." ;
                                                                              rdfs:label "sentence_34884399_11" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34884399_12
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34884399_12> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34884399> ;
                                                                              gutprop:hasSentenceText "In conclusion, the patients diagnosed with PD have significantly different gut microbiota profiles in comparison with healthy controls." ;
                                                                              rdfs:label "sentence_34884399_12" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34884399_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34884399_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34884399> ;
                                                                             gutprop:hasSentenceText "The presented study aimed to compare gastrointestinal microbiota composition between patients diagnosed with PD and treated only with Levodopa to healthy controls." ;
                                                                             rdfs:label "sentence_34884399_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34884399_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34884399_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34884399> ;
                                                                             gutprop:hasSentenceText "In this prospective study, patients were recruited in 1 academic hospital from July 2019 to July 2020." ;
                                                                             rdfs:label "sentence_34884399_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34884399_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34884399_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
