                                                    gutprop:affect <http://purl.obolibrary.org/obo/NCIT_C3137> ;
                                                    gutprop:containedIn <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/af0e49bd321652d7> ,
                                                                        <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/56d5fcf82beb3aa5> ;
                                                    rdfs:comment "Immune System Diseases: A collective term for a group of disorders that arise from an abnormal functioning of the immune system, leading to an overactive, underactive, or misdirected immune response, resulting in various clinical manifestations. [Definition Source: llama3-8b-8192]" ,
                                                                 "UMLS Match" ;
                                                    rdfs:label "Immune System Diseases" .


###  https://uts.nlm.nih.gov/uts/umls/concept/C0021400
<https://uts.nlm.nih.gov/uts/umls/concept/C0021400> rdf:type owl:NamedIndividual ,
