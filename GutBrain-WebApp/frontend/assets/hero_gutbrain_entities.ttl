                                             rdfs:comment "NCIT Match" ,
                                                          "The part of the pharynx in the back of the throat, at and above the soft palate. The nasopharynx is continuous with the nasal passages. [Definition Source: NCIT]" ;
                                             rdfs:label "Nasopharynx" .


###  http://purl.obolibrary.org/obo/NCIT_C12434
<http://purl.obolibrary.org/obo/NCIT_C12434> rdf:type owl:NamedIndividual ,
                                                      skos:Concept ,
                                                      <https://w3id.org/brainteaser/ontology/schema/AnatomicalSite> ;
                                             skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/AnatomicSite> ;
                                             gutprop:containedIn <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/3e8e40c0af5f5ea5> ;
                                             rdfs:comment "A liquid tissue; its major function is to transport oxygen throughout the body. It also supplies the tissues with nutrients, removes waste products, and contains various components of the immune system defending the body against infection. Several hormones also travel in the blood. [Definition Source: NCIT]" ,
                                                          "NCIT Match" ;
                                             rdfs:label "Blood" .


