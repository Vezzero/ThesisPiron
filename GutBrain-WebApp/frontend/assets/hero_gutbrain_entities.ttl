                                                          "NCIT Match" ;
                                             rdfs:label "Traumatic Encephalopathy" .


###  http://purl.obolibrary.org/obo/NCIT_C35650
<http://purl.obolibrary.org/obo/NCIT_C35650> rdf:type owl:NamedIndividual ,
                                                      skos:Concept ,
                                                      <https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding> ;
                                             skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/DiseaseDisorderOrFinding> ;
                                             gutprop:containedIn <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/1a487832ab5efd39> ,
                                                                 <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/148e86c9c633bd48> ;
                                             rdfs:comment "An infectious process affecting the upper respiratory tract (nose, paranasal sinuses, pharynx, larynx, or trachea). Symptoms include congestion, sneezing, coughing, fever, and sore throat. [Definition Source: NCIT]" ,
