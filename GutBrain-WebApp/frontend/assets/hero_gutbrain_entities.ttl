                                            gutprop:target <https://uts.nlm.nih.gov/uts/umls/concept/C0001792> ;
                                            rdfs:comment "An uncomfortable sensation of difficulty breathing. It may present as an acute or chronic sign of an underlying respiratory or heart disorder. [Definition Source: NCIT]" ,
                                                         "NCIT Match" ;
                                            rdfs:label "Dyspnea" .


###  http://purl.obolibrary.org/obo/NCIT_C3009
<http://purl.obolibrary.org/obo/NCIT_C3009> rdf:type owl:NamedIndividual ,
                                                     skos:Concept ,
                                                     <https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding> ;
