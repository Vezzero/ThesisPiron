<https://w3id.org/hereditary/ontology/gutbrain/resource/anatomicsite/GutTissue> rdf:type owl:NamedIndividual ,
                                                                                         skos:Concept ,
                                                                                         <https://w3id.org/brainteaser/ontology/schema/AnatomicalSite> ;
                                                                                skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/AnatomicSite> ;
                                                                                gutprop:containedIn <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/9fe961e5f7e91269> ;
                                                                                dcterms:creator "Samuel Piron" ;
                                                                                rdfs:comment "Gut tissue refers to the collective mass of cells, tissues, and organs that make up the gastrointestinal tract, including the esophagus, stomach, small intestine, and large intestine. [Definition Source: llama3-8b-8192]" ;
                                                                                rdfs:label "Gut Tissue" .


