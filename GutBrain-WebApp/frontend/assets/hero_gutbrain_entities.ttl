###  http://purl.obolibrary.org/obo/NCIT_C12623
<http://purl.obolibrary.org/obo/NCIT_C12623> rdf:type owl:NamedIndividual ,
                                                      skos:Concept ,
                                                      <https://w3id.org/brainteaser/ontology/schema/AnatomicalSite> ,
                                                      <https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding> ,
                                                      gutprop:Chemical ;
                                             skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/AnatomicSite> ,
                                                           <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/Chemical> ,
                                                           <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/DiseaseDisorderOrFinding> ;
