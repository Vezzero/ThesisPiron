                                             rdfs:comment "NCIT Match" ,
                                                          "The final section of the small intestine. [Definition Source: NCIT]" ;
                                             rdfs:label "Ileum" .


###  http://purl.obolibrary.org/obo/NCIT_C12388
<http://purl.obolibrary.org/obo/NCIT_C12388> rdf:type owl:NamedIndividual ,
                                                      skos:Concept ,
