<http://purl.obolibrary.org/obo/NCIT_C105971> rdf:type owl:NamedIndividual ,
                                                       skos:Concept ,
                                                       gutprop:Chemical ;
                                              skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/Chemical> ;
