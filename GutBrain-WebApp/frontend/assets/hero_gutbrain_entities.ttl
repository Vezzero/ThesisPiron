###  http://purl.obolibrary.org/obo/NCIT_C26714
<http://purl.obolibrary.org/obo/NCIT_C26714> rdf:type owl:NamedIndividual ,
                                                      skos:Concept ,
                                                      <https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding> ;
                                             skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/DiseaseDisorderOrFinding> ;
                                             gutprop:containedIn <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/1dd0b4f576d99d95> ;
                                             gutprop:target <https://uts.nlm.nih.gov/uts/umls/concept/C0027361> ,
                                                            <https://uts.nlm.nih.gov/uts/umls/concept/C0237401> ,
                                                            <https://www.ncbi.nlm.nih.gov/mesh/D000328> ;
                                             rdfs:comment "An autoimmune genetic disorder with an unknown pattern of inheritance that primarily affects the digestive tract. It is caused by intolerance to dietary gluten. Consumption of gluten protein triggers an immune response which damages small intestinal villi and prevents adequate absorption of nutrients. Clinical signs include abdominal cramping, diarrhea or constipation and weight loss. If untreated, the clinical course may progress to malnutrition, anemia, osteoporosis and an increased risk of intestinal malignancies. However, the prognosis is favorable with successful avoidance of gluten in the diet. [Definition Source: NCIT]" ,
                                                          "NCIT Match" ;
                                             rdfs:label "Celiac Disease" .


###  http://purl.obolibrary.org/obo/NCIT_C26723
<http://purl.obolibrary.org/obo/NCIT_C26723> rdf:type owl:NamedIndividual ,
                                                      skos:Concept ,
                                                      <https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding> ;
                                             skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/DiseaseDisorderOrFinding> ;
                                             gutprop:containedIn <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/386cdab8d783c307> ;
                                             rdfs:comment "Inflammation of the colon. [Definition Source: NCIT]" ,
                                                          "NCIT Match" ;
                                             rdfs:label "Colitis" .


###  http://purl.obolibrary.org/obo/NCIT_C26732
<http://purl.obolibrary.org/obo/NCIT_C26732> rdf:type owl:NamedIndividual ,
                                                      skos:Concept ,
                                                      <https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding> ;
                                             skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/DiseaseDisorderOrFinding> ;
                                             gutprop:containedIn <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/bbc9d6ea9ff4b84b> ,
                                                                 <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/2afe5e26e9c8cbec> ;
                                             gutprop:target <https://www.ncbi.nlm.nih.gov/mesh/68010361> ;
                                             rdfs:comment "NCIT Match" ,
                                                          "Narrowing of the coronary arteries due to fatty deposits inside the arterial walls. The diagnostic criteria may include documented history of any of the following: documented coronary artery stenosis greater than or equal to 50% (by cardiac catheterization or other modality of direct imaging of the coronary arteries); previous coronary artery bypass surgery (CABG); previous percutaneous coronary intervention (PCI); previous myocardial infarction. (ACC) [Definition Source: NCIT]" ;
                                             rdfs:label "Coronary Artery Disease" .


###  http://purl.obolibrary.org/obo/NCIT_C26747
<http://purl.obolibrary.org/obo/NCIT_C26747> rdf:type owl:NamedIndividual ,
                                                      skos:Concept ,
                                                      <https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding> ;
                                             skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/DiseaseDisorderOrFinding> ;
                                             gutprop:affect <https://uts.nlm.nih.gov/uts/umls/concept/C0020456> ;
                                             gutprop:containedIn <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/355ebadce839be94> ,
                                                                 <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/9805d0a41f4cd2d9> ;
                                             gutprop:target <https://uts.nlm.nih.gov/uts/umls/concept/C0679646> ,
                                                            <https://www.ncbi.nlm.nih.gov/mesh/68010361> ;
                                             rdfs:comment "A type of diabetes mellitus that is characterized by insulin resistance or desensitization and increased blood glucose levels. This is a chronic disease that can develop gradually over the life of a patient and can be linked to both environmental factors and heredity. [Definition Source: NCIT]" ,
                                                          "NCIT Match" ;
                                             rdfs:label "Type 2 Diabetes Mellitus" .


###  http://purl.obolibrary.org/obo/NCIT_C26756
<http://purl.obolibrary.org/obo/NCIT_C26756> rdf:type owl:NamedIndividual ,
                                                      skos:Concept ,
                                                      <https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding> ;
                                             skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/DiseaseDisorderOrFinding> ;
                                             gutprop:containedIn <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/c3caa99dc595d935> ;
                                             rdfs:comment "An uncomfortable, often painful feeling in the stomach, resulting from impaired digestion. Symptoms include burning stomach pain, bloating, heartburn, nausea, and vomiting. Causes include gastritis, gastric ulcer, gastroesophageal reflux disease, pancreatic disease, and gallbladder disease. [Definition Source: NCIT]" ,
                                                          "NCIT Match" ;
                                             rdfs:label "Dyspepsia" .


###  http://purl.obolibrary.org/obo/NCIT_C26782
<http://purl.obolibrary.org/obo/NCIT_C26782> rdf:type owl:NamedIndividual ,
