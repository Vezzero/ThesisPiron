<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38318337_9> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38318337> ;
                                                                             gutprop:hasSentenceText "Moreover, the symbiotic association between <i>Romboutsia</i> and <i>" ;
                                                                             rdfs:label "sentence_38318337_9" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38331354_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38331354_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/38331354> ;
                                                                             gutprop:hasSentenceText "Depression-like phenotypes in mice following common bile duct ligation: Insights into the gut-liver-brain axis via the vagus nerve." ;
                                                                             rdfs:label "sentence_38331354_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38331354_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38331354_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38331354> ;
                                                                             gutprop:hasSentenceText "Depression frequently occurs in patients with liver cirrhosis, yet the reasons for this correlation are not fully understood." ;
                                                                             rdfs:label "sentence_38331354_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38331354_10
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38331354_10> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38331354> ;
                                                                              gutprop:hasSentenceText "These results suggest that CBDL-induced depression-like phenotypes in mice are mediated through the gut-liver-brain axis via the subdiaphragmatic vagus nerve, and that arketamine might offer a new treatment approach for depression in liver cirrhosis patients." ;
                                                                              rdfs:label "sentence_38331354_10" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38331354_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38331354_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38331354> ;
                                                                             gutprop:hasSentenceText "Dysbiosis of gut microbiota has been implicated in depression through the gut-brain axis via the vagus nerve." ;
                                                                             rdfs:label "sentence_38331354_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38331354_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38331354_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38331354> ;
                                                                             gutprop:hasSentenceText "This study explored the potential role of the gut-liver-brain axis via the vagus nerve in depression-like phenotypes in mice with liver cirrhosis." ;
                                                                             rdfs:label "sentence_38331354_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38331354_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38331354_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38331354> ;
                                                                             gutprop:hasSentenceText "These mice underwent common bile duct ligation (CBDL), a method used to stimulate liver cirrhosis." ;
                                                                             rdfs:label "sentence_38331354_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38331354_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38331354_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38331354> ;
                                                                             gutprop:hasSentenceText "To assess depression-like behaviors, behavioral tests were conducted 10 days following either sham or CBDL surgeries." ;
                                                                             rdfs:label "sentence_38331354_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38331354_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38331354_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38331354> ;
                                                                             gutprop:hasSentenceText "The mice with CBDL displayed symptoms such as splenomegaly, elevated plasma levels of interleukin-6 and tumor necrosis factor-α, depression-like behaviors, decreased levels of synaptic proteins in the prefrontal cortex (PFC), disrupted gut microbiota balance, and changes in blood metabolites (or lipids)." ;
                                                                             rdfs:label "sentence_38331354_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38331354_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38331354_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38331354> ;
                                                                             gutprop:hasSentenceText "Additionally, there were positive or negative correlations between the relative abundance of microbiome and behavioral data or blood metabolites (or lipids)." ;
                                                                             rdfs:label "sentence_38331354_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38331354_8
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38331354_8> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38331354> ;
                                                                             gutprop:hasSentenceText "Significantly, these changes were reversed in CBDL mice by performing a subdiaphragmatic vagotomy." ;
                                                                             rdfs:label "sentence_38331354_8" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38331354_9
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38331354_9> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38331354> ;
                                                                             gutprop:hasSentenceText "Intriguingly, depression-like phenotypes in mice with CBDL were improved after a single injection of arketamine, a new antidepressant." ;
                                                                             rdfs:label "sentence_38331354_9" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38350463_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38350463_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/38350463> ;
                                                                             gutprop:hasSentenceText "Gut production of GABA by a probiotic formula: an in vitro study." ;
                                                                             rdfs:label "sentence_38350463_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38350463_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38350463_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38350463> ;
                                                                             gutprop:hasSentenceText "The objective of this study was to evaluate the influence of a probiotic formula on the production of neuroactive compounds in different parts of the colon in batch culture and in vitro gut simulator experiments." ;
                                                                             rdfs:label "sentence_38350463_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38350463_10
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38350463_10> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38350463> ;
                                                                              gutprop:hasSentenceText "The probiotic-exposed microbiota showed higher levels of Bacteroides, a gut microbe associated with anti-inflammatory activities and a potential GABA producer." ;
                                                                              rdfs:label "sentence_38350463_10" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38350463_11
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38350463_11> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38350463> ;
                                                                              gutprop:hasSentenceText "Results demonstrate the impact of the tested probiotic formula on gut microbiota structure and GABA production." ;
                                                                              rdfs:label "sentence_38350463_11" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38350463_12
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38350463_12> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38350463> ;
                                                                              gutprop:hasSentenceText "In conclusion, the probiotic treatment changed the microbiota composition and increased neuroactive metabolites production, indicating promising potential as psychobiotics, even if further clinical evidence is needed to confirm the effectiveness of these probiotics in improving mental health." ;
                                                                              rdfs:label "sentence_38350463_12" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38350463_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38350463_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38350463> ;
                                                                             gutprop:hasSentenceText "Thirteen lactic acid bacterial strains, belonging to the species Levilactobacillus brevis, Lactiplantibacillus plantarum, Lacticaseibacillus paracasei, Ligilactobacillus salivarius, Streptococcus thermophilus, were characterised for their in vitro ability to produce neurotransmitters." ;
                                                                             rdfs:label "sentence_38350463_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38350463_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38350463_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38350463> ;
                                                                             gutprop:hasSentenceText "L. brevis P30021 and L. plantarum P30025 were selected based on their capability to produce γ-aminobutyric acid (GABA) and acetylcholine in vitro." ;
                                                                             rdfs:label "sentence_38350463_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38350463_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38350463_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38350463> ;
                                                                             gutprop:hasSentenceText "A probiotic formulation with potential psychobiotic activity was prepared and tested in a batch culture of human microbiota monitoring the formation of GABA and acetylcholine." ;
                                                                             rdfs:label "sentence_38350463_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38350463_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38350463_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38350463> ;
                                                                             gutprop:hasSentenceText "Samples of the three colonic tracts were taken from the Simulator of the Human Intestinal Microbiota (SHIME®) evaluating the production of GABA and other neurotransmitters by LC-MS. Short chain fatty acids (SCFA) by GC and microbiota composition by 16S rRNA gene sequencing were also determined." ;
                                                                             rdfs:label "sentence_38350463_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38350463_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38350463_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38350463> ;
                                                                             gutprop:hasSentenceText "Probiotic supplementation led to the formation of GABA and acetylcholine with a decrease in glutamate concentrations in the in vitro batch fermentation." ;
                                                                             rdfs:label "sentence_38350463_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38350463_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38350463_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38350463> ;
                                                                             gutprop:hasSentenceText "Production of GABA after the treatment with probiotics was confirmed in the SHIME® short-term experiment." ;
                                                                             rdfs:label "sentence_38350463_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38350463_8
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38350463_8> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38350463> ;
                                                                             gutprop:hasSentenceText "No differences in short-chain fatty acids were observed up to 72 h of fermentation." ;
                                                                             rdfs:label "sentence_38350463_8" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38350463_9
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38350463_9> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38350463> ;
                                                                             gutprop:hasSentenceText "Different microbiota composition was found in the three different parts of the colon, with a higher abundance of Veillonellaceae in the ascending colon vessels." ;
                                                                             rdfs:label "sentence_38350463_9" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38401573_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38401573_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/38401573> ;
                                                                             gutprop:hasSentenceText "A role of gut-brain axis on prophylactic actions of arketamine in male mice exposed to chronic restrain stress." ;
                                                                             rdfs:label "sentence_38401573_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38401573_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38401573_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38401573> ;
                                                                             gutprop:hasSentenceText "The gut-brain axis, which includes gut microbiota and microbiome-derived metabolites, might be implicated in depression." ;
                                                                             rdfs:label "sentence_38401573_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38401573_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38401573_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38401573> ;
                                                                             gutprop:hasSentenceText "We reported the sustained prophylactic effects of a new antidepressant arketamine in chronic restrain stress (CRS) model of depression." ;
                                                                             rdfs:label "sentence_38401573_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38401573_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38401573_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38401573> ;
                                                                             gutprop:hasSentenceText "In this study, we investigated the role of gut-brain axis on the prophylactic effects of arketamine in the CRS (7 days) model." ;
                                                                             rdfs:label "sentence_38401573_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38401573_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38401573_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38401573> ;
                                                                             gutprop:hasSentenceText "Pretreatment with arketamine (10 mg/kg, 1 day prior to the CRS onset) significantly prevented CRS-induced body weight loss, increased immobility time of forced swimming test, decreased sucrose preference of sucrose preference test, and reduced expressions of synaptic proteins (GluA1 and PSD-95) in the prefrontal cortex (PFC) in the male mice." ;
                                                                             rdfs:label "sentence_38401573_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38401573_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38401573_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38401573> ;
                                                                             gutprop:hasSentenceText "Gut microbiota analysis showed that pretreatment with arketamine might restore altered abundance of gut microbiota in CRS-exposed mice." ;
                                                                             rdfs:label "sentence_38401573_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38401573_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38401573_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38401573> ;
                                                                             gutprop:hasSentenceText "An untargeted metabolomics analysis revealed four metabolites (e.g., L-leucine, N-acetyl-l-glutamine, 2-(2,4-dichlorophenyl)-3-[4-(dimethylamino)phenyl]acrylonitrile, L-threonine amide) that were altered between control and CRS group; however, there were found to be altered between the saline + CRS group and the arketamine + CRS group." ;
                                                                             rdfs:label "sentence_38401573_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38401573_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38401573_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38401573> ;
                                                                             gutprop:hasSentenceText "Network analysis demonstrated correlations among synaptic proteins in the PFC and certain microbiota, and blood metabolites." ;
                                                                             rdfs:label "sentence_38401573_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38401573_8
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38401573_8> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38401573> ;
                                                                             gutprop:hasSentenceText "These findings suggest that gut-brain axis, including its metabolites, might partially contribute to the persistent prophylactic effects of arketamine in the CRS model." ;
                                                                             rdfs:label "sentence_38401573_8" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38409102_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38409102_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/38409102> ;
                                                                             gutprop:hasSentenceText "Microbial composition, functionality, and stress resilience or susceptibility: unraveling sex-specific patterns." ;
                                                                             rdfs:label "sentence_38409102_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38409102_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38409102_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38409102> ;
                                                                             gutprop:hasSentenceText "Following exposure to traumatic stress, women are twice as likely as men to develop mood disorders." ;
                                                                             rdfs:label "sentence_38409102_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38409102_10
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38409102_10> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38409102> ;
                                                                              gutprop:hasSentenceText "Before SPS exposure, the sympathoadrenal axis exhibited alterations within male subgroups only." ;
                                                                              rdfs:label "sentence_38409102_10" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38409102_11
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38409102_11> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38409102> ;
                                                                              gutprop:hasSentenceText "Expression of tight junction protein claudin-5 was lower in brain of SPS-S males, but higher in SPS-R females following SPS." ;
                                                                              rdfs:label "sentence_38409102_11" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38409102_12
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38409102_12> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38409102> ;
                                                                              gutprop:hasSentenceText "Across the study, alpha diversity remained consistently lower in males compared to females." ;
                                                                              rdfs:label "sentence_38409102_12" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38409102_13
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38409102_13> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38409102> ;
                                                                              gutprop:hasSentenceText "Beta diversity revealed distinct separations between male and female susceptible groups before SPS, with this separation becoming evident in the resilient groups following SPS." ;
                                                                              rdfs:label "sentence_38409102_13" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38409102_14
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38409102_14> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38409102> ;
                                                                              gutprop:hasSentenceText "At the genus level, Lactobacillus, Lachnospiraceae_Incertae_Sedis, and Barnesiella exhibited sex-specific alterations, displaying opposing abundances in each sex." ;
                                                                              rdfs:label "sentence_38409102_14" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38409102_15
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38409102_15> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38409102> ;
                                                                              gutprop:hasSentenceText "Additionally, sex-specific changes were observed in microbial predictive functionality and targeted functional modules both before and after SPS." ;
                                                                              rdfs:label "sentence_38409102_15" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38409102_16
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38409102_16> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38409102> ;
                                                                              gutprop:hasSentenceText "Alterations in the microbial short-chain fatty acids (SCFAs), were also observed, with major and minor SCFAs being lower in SPS-susceptible males whereas branched-chain SCFAs being higher in SPS-susceptible females." ;
                                                                              rdfs:label "sentence_38409102_16" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38409102_17
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38409102_17> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38409102> ;
                                                                              gutprop:hasSentenceText "This study highlights distinct pre- and post-trauma differences in microbial composition, functionality, and metabolites, associated with stress resilience in male and female rats." ;
                                                                              rdfs:label "sentence_38409102_17" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38409102_18
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38409102_18> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38409102> ;
                                                                              gutprop:hasSentenceText "The findings underscore the importance of developing sex-specific therapeutic strategies to effectively address stress-related disorders." ;
                                                                              rdfs:label "sentence_38409102_18" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38409102_19
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38409102_19> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38409102> ;
                                                                              gutprop:hasSentenceText "Highlights SPS model induces divergent anxiety and social behavioral responses to traumatic stress in both male and female rodents." ;
                                                                              rdfs:label "sentence_38409102_19" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38409102_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38409102_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38409102> ;
                                                                             gutprop:hasSentenceText "Yet, individual responses to such stress vary, with some people developing stress-induced psychopathologies while others exhibit resilience." ;
                                                                             rdfs:label "sentence_38409102_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38409102_20
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38409102_20> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38409102> ;
                                                                              gutprop:hasSentenceText "SPS-resilient females displayed less anxiety-like behavior and initiated more interactions towards a juvenile rat than SPS-resilient males." ;
                                                                              rdfs:label "sentence_38409102_20" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38409102_21
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38409102_21> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38409102> ;
                                                                              gutprop:hasSentenceText "Sex-specific pre-existing and SPS-induced differences in the gut microbial composition and predictive functionality were observed in susceptible and resilient rats." ;
                                                                              rdfs:label "sentence_38409102_21" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38409102_22
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38409102_22> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38409102> ;
                                                                              gutprop:hasSentenceText "SPS-resilient males displayed elevated cecal acetate levels, whereas SPS-susceptible females exhibited heightened branched-chain SCFAs." ;
                                                                              rdfs:label "sentence_38409102_22" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38409102_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38409102_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38409102> ;
                                                                             gutprop:hasSentenceText "The factors influencing sex-related disparities in affective disorders as well as variations in resilience remain unclear; however, emerging evidence suggests differences in the gut microbiota play a role." ;
                                                                             rdfs:label "sentence_38409102_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38409102_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38409102_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38409102> ;
                                                                             gutprop:hasSentenceText "In this study, using the single prolonged stress (SPS) model of post-traumatic stress disorder, we investigated pre- and post-existing differences in microbial composition, functionality, and metabolites that affect stress susceptibility or resilience in each sex." ;
                                                                             rdfs:label "sentence_38409102_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38409102_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38409102_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38409102> ;
                                                                             gutprop:hasSentenceText "Male and female Sprague-Dawley rats were randomly assigned to control or SPS groups." ;
                                                                             rdfs:label "sentence_38409102_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38409102_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38409102_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38409102> ;
                                                                             gutprop:hasSentenceText "Two weeks following SPS, the animals were exposed to a battery of behavioral tests and decapitated a day later." ;
                                                                             rdfs:label "sentence_38409102_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38409102_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38409102_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38409102> ;
                                                                             gutprop:hasSentenceText "Based on their anxiety index, they were further categorized as SPS-resilient (SPS-R) or SPS-susceptible (SPS-S)." ;
                                                                             rdfs:label "sentence_38409102_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38409102_8
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38409102_8> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38409102> ;
                                                                             gutprop:hasSentenceText "On the day of dissection, cecum, and selected brain tissues were isolated." ;
                                                                             rdfs:label "sentence_38409102_8" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38409102_9
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38409102_9> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38409102> ;
                                                                             gutprop:hasSentenceText "Stool samples were collected before and after SPS, whereas urine samples were taken before and 30 min into the SPS." ;
                                                                             rdfs:label "sentence_38409102_9" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38422755_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38422755_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/38422755> ;
                                                                             gutprop:hasSentenceText "Gut microbiota disturbances in hospitalized older adults with malnutrition and clinical outcomes." ;
                                                                             rdfs:label "sentence_38422755_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38422755_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38422755_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38422755> ;
                                                                             gutprop:hasSentenceText "Malnutrition is one of the most threatening conditions in geriatric populations." ;
                                                                             rdfs:label "sentence_38422755_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38422755_10
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38422755_10> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38422755> ;
                                                                              gutprop:hasSentenceText "Differential abundance of Lachnospiraceae NK4A136 group, Subdoligranulum, and Faecalibacterium prausnitzii were significantly lower and inversely associated with malnutrition, while Corynebacterium, Ruminococcaceae Incertae Sedis, and Fusobacterium were significantly increased and positively associated with malnutrition." ;
                                                                              rdfs:label "sentence_38422755_10" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38422755_11
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38422755_11> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38422755> ;
                                                                              gutprop:hasSentenceText "Corynebacterium, Ruminococcaceae Incertae Sedis, and the overall composition were important predictors of critical care in patients with malnutrition during hospitalization." ;
                                                                              rdfs:label "sentence_38422755_11" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38422755_12
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38422755_12> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38422755> ;
                                                                              gutprop:hasSentenceText "Older adults with malnutrition, especially in a severe stage, may be subject to substantial gut microbial disturbances during hospitalization." ;
                                                                              rdfs:label "sentence_38422755_12" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38422755_13
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38422755_13> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38422755> ;
                                                                              gutprop:hasSentenceText "The gut microbiota profile of patients with malnutrition might help us to predict worse clinical outcomes." ;
                                                                              rdfs:label "sentence_38422755_13" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38422755_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38422755_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38422755> ;
                                                                             gutprop:hasSentenceText "The gut microbiota has an important role in the host's metabolic and muscular health: however, its interplay with disease-related malnutrition is not well understood." ;
                                                                             rdfs:label "sentence_38422755_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38422755_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38422755_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38422755> ;
                                                                             gutprop:hasSentenceText "We aimed to identify the association of malnutrition with the gut microbiota and predict clinical outcomes in hospitalized acutely ill older adults." ;
                                                                             rdfs:label "sentence_38422755_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38422755_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38422755_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38422755> ;
                                                                             gutprop:hasSentenceText "We performed a secondary longitudinal analysis in 108 geriatric patients from a prospective cohort evaluated at admission and 72 h of hospitalization." ;
                                                                             rdfs:label "sentence_38422755_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38422755_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38422755_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38422755> ;
                                                                             gutprop:hasSentenceText "We collected clinical, demographic, nutritional, and 16S rRNA gene-sequenced gut microbiota data." ;
                                                                             rdfs:label "sentence_38422755_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38422755_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38422755_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38422755> ;
                                                                             gutprop:hasSentenceText "Microbiota diversity, overall composition, and differential abundance were calculated and compared between patients with and without malnutrition." ;
                                                                             rdfs:label "sentence_38422755_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38422755_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38422755_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38422755> ;
                                                                             gutprop:hasSentenceText "Microbiota features associated with malnutrition were used to predict clinical outcomes." ;
                                                                             rdfs:label "sentence_38422755_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38422755_8
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38422755_8> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38422755> ;
                                                                             gutprop:hasSentenceText "Patients with malnutrition (51%) had a different microbiota composition compared to those who were well-nourished during hospitalization (ANOSIM R = 0.079, P = 0.003)." ;
                                                                             rdfs:label "sentence_38422755_8" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38422755_9
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38422755_9> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38422755> ;
                                                                             gutprop:hasSentenceText "Patients with severe malnutrition showed poorer α-diversity at admission (Shannon P = 0.012, Simpson P = 0.018) and follow-up (Shannon P = 0.023, Chao1 P = 0.008)." ;
                                                                             rdfs:label "sentence_38422755_9" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38432867_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38432867_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/38432867> ;
                                                                             gutprop:hasSentenceText "Gut microbiota and thyroid-associated ophthalmopathy." ;
                                                                             rdfs:label "sentence_38432867_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38432867_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38432867_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38432867> ;
                                                                             gutprop:hasSentenceText "Thyroid-associated ophthalmopathy (TAO) is a multifactorial-mediated autoimmune orbital disease with the highest incidence of orbital disease in adults." ;
                                                                             rdfs:label "sentence_38432867_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38432867_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38432867_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38432867> ;
                                                                             gutprop:hasSentenceText "Due to the complex clinical manifestations and prolonged course,TAO seriously affect the physical and mental health of patients.The pathogenesis of TAO has not been fully elucidated and the treatment lacks specificity." ;
                                                                             rdfs:label "sentence_38432867_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38432867_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38432867_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38432867> ;
                                                                             gutprop:hasSentenceText "Therefore, in-depth research on the pathogenesis of TAO is to find effective treatments." ;
                                                                             rdfs:label "sentence_38432867_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38432867_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38432867_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38432867> ;
                                                                             gutprop:hasSentenceText "In recent years, studies have suggested that there is gut microbiota disorder in TAO, and the risk factors of TAO can promote gut microbiota disorder." ;
                                                                             rdfs:label "sentence_38432867_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38432867_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38432867_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38432867> ;
                                                                             gutprop:hasSentenceText "Disordered gut microbiota can participate in the occurrence and development of TAO via influencing T cell differentiation, mimicking autoantigens, and influencing host non-coding RNA expression." ;
                                                                             rdfs:label "sentence_38432867_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38432867_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38432867_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38432867> ;
                                                                             gutprop:hasSentenceText "Modulating the gut microbiota also has therapeutic effects on TAO and is a promising therapeutic approach." ;
                                                                             rdfs:label "sentence_38432867_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38508549_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38508549_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/38508549> ;
                                                                             gutprop:hasSentenceText "Along the microbiota-gut-brain axis: Use of plant polysaccharides to improve mental disorders." ;
                                                                             rdfs:label "sentence_38508549_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38508549_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38508549_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38508549> ;
                                                                             gutprop:hasSentenceText "With the development of gut microbiota-specific interventions for mental disorders, the interactions between plant polysaccharides and microbiota in the intestinal and their consequent effects are becoming increasingly important." ;
                                                                             rdfs:label "sentence_38508549_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38508549_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38508549_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38508549> ;
                                                                             gutprop:hasSentenceText "In this review, we discussed the role of plant polysaccharides in improving various mental disorders via the microbiota-gut-brain axis." ;
                                                                             rdfs:label "sentence_38508549_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38508549_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38508549_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38508549> ;
                                                                             gutprop:hasSentenceText "The chemical and structural characteristics and metabolites of these plant polysaccharides were summarised." ;
                                                                             rdfs:label "sentence_38508549_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38508549_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38508549_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38508549> ;
                                                                             gutprop:hasSentenceText "Plant polysaccharides and their metabolites have great potential for reshaping gut microbiota profiles through gut microbiota-dependent fermentation." ;
                                                                             rdfs:label "sentence_38508549_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38508549_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38508549_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38508549> ;
                                                                             gutprop:hasSentenceText "Along the microbiota-gut-brain axis, the consequent pharmacological processes that lead to the elimination of the symptoms of mental disorders include 1) regulation of the central monoamine neurotransmitters, amino acid transmitters and cholinergic signalling system; 2) alleviation of central and peripheral inflammation mainly through the NLRP3/NF-κB-related signalling pathway; 3) inhibition of neuronal apoptosis; and 4) enhancement of antioxidant activities." ;
                                                                             rdfs:label "sentence_38508549_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38508549_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38508549_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38508549> ;
                                                                             gutprop:hasSentenceText "According to this review, monosaccharide glucose and structure -4-α-Glcp-(1→ are the most potent compositions of the most reported plant polysaccharides." ;
                                                                             rdfs:label "sentence_38508549_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38508549_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38508549_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38508549> ;
                                                                             gutprop:hasSentenceText "However, the causal structure-activity relationship remains to be extensively explored." ;
                                                                             rdfs:label "sentence_38508549_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38508549_8
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38508549_8> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38508549> ;
                                                                             gutprop:hasSentenceText "Moreover, mechanistic elucidation, safety verification, and additional rigorous human studies are expected to advance plant polysaccharide-based product development targeting the microbiota-gut-brain axis for people with mental disorders." ;
                                                                             rdfs:label "sentence_38508549_8" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38525261_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38525261_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/38525261> ;
                                                                             gutprop:hasSentenceText "Impact of dietary fiber on gut microbiota composition, function and gut-brain-modules in healthy adults - a systematic review protocol." ;
                                                                             rdfs:label "sentence_38525261_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38525261_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38525261_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38525261> ;
                                                                             gutprop:hasSentenceText "The gut microbiota has been extensively implicated in health and disease." ;
                                                                             rdfs:label "sentence_38525261_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38525261_10
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38525261_10> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38525261> ;
                                                                              gutprop:hasSentenceText "A systematic search of PubMed/MEDLINE and EMBASE, two electronic databases, will be completed." ;
                                                                              rdfs:label "sentence_38525261_10" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38525261_11
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38525261_11> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38525261> ;
                                                                              gutprop:hasSentenceText "Various types of dietary fiber have an impact on the gut microbiota composition, with some promoting the growth of particular taxa while others are reduced in relative abundance." ;
                                                                              rdfs:label "sentence_38525261_11" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38525261_12
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38525261_12> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38525261> ;
                                                                              gutprop:hasSentenceText "Our search focuses on the impact of this food component on the microbiota of healthy individuals." ;
                                                                              rdfs:label "sentence_38525261_12" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38525261_13
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38525261_13> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38525261> ;
                                                                              gutprop:hasSentenceText "Compositional gut microbial changes have been reported and our review will compile and update these observations after reanalysis of their datasets with a consistent bioinformatic pipeline." ;
                                                                              rdfs:label "sentence_38525261_13" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38525261_14
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38525261_14> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38525261> ;
                                                                              gutprop:hasSentenceText "From this it may be possible to predict more detailed functional consequences in terms of neuroactive gut brain modules, of the compositional alterations in gut microbial taxa." ;
                                                                              rdfs:label "sentence_38525261_14" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38525261_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38525261_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38525261> ;
                                                                             gutprop:hasSentenceText "The functional outputs of the gut microbiota, such as microbial metabolites, are considered particularly important in this regard." ;
                                                                             rdfs:label "sentence_38525261_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38525261_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38525261_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38525261> ;
                                                                             gutprop:hasSentenceText "Significant associations exist between alterations in the relative abundance of specific microbial taxa and mental health disorders." ;
                                                                             rdfs:label "sentence_38525261_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38525261_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38525261_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38525261> ;
                                                                             gutprop:hasSentenceText "Dietary fiber has the potential to alter gut microbiota composition and function, modifying bacterial enzymatic function and the production of metabolites." ;
                                                                             rdfs:label "sentence_38525261_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38525261_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38525261_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38525261> ;
                                                                             gutprop:hasSentenceText "As many taxa of microorganisms have enzymes capable of producing or degrading neurochemicals i.e." ;
                                                                             rdfs:label "sentence_38525261_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38525261_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38525261_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38525261> ;
                                                                             gutprop:hasSentenceText "neuroactive gut brain modules, new predictive tools can be applied to existing datasets such as those harvested from dietary fiber interventions." ;
                                                                             rdfs:label "sentence_38525261_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38525261_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38525261_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38525261> ;
                                                                             gutprop:hasSentenceText "We endeavor to perform a systematic review in order to identify studies reporting compositional gut microbiota alterations after interventions with dietary fiber in healthy individuals." ;
                                                                             rdfs:label "sentence_38525261_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38525261_8
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38525261_8> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38525261> ;
                                                                             gutprop:hasSentenceText "We aim to also extract from the selected studies publicly available microbial genomic sequence datasets for reanalysis with a consistent bioinformatics pipeline, with the ultimate intention of identifying altered gut brain modules following dietary fiber interventions." ;
                                                                             rdfs:label "sentence_38525261_8" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38525261_9
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38525261_9> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38525261> ;
                                                                             gutprop:hasSentenceText "Interventional trials and randomized controlled studies that are originally published, including cross-over and non-crossover design and involving healthy adult humans will be included." ;
                                                                             rdfs:label "sentence_38525261_9" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38576868_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38576868_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/38576868> ;
                                                                             gutprop:hasSentenceText "Bipolar disorder and the gut microbiota: a bibliometric analysis." ;
                                                                             rdfs:label "sentence_38576868_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38576868_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38576868_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38576868> ;
                                                                             gutprop:hasSentenceText "Previous studies have explored the relationship between bipolar disorder and gut microbiota." ;
                                                                             rdfs:label "sentence_38576868_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38576868_10
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38576868_10> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38576868> ;
                                                                              gutprop:hasSentenceText "The top 5 keywords with the highest frequency except for bipolar disorder and gut microbiota were as follows: depression, inflammation, probiotic, gut-brain axis, and anxiety." ;
                                                                              rdfs:label "sentence_38576868_10" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38576868_11
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38576868_11> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38576868> ;
                                                                              gutprop:hasSentenceText "In conclusion, this is the first bibliometric analysis to explore the publications in the field of the association between bipolar disorder and the gut microbiota." ;
                                                                              rdfs:label "sentence_38576868_11" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38576868_12
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38576868_12> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38576868> ;
                                                                              gutprop:hasSentenceText "The main research hotspots regarding this field were the characteristics, abundance, and diversity of gut microbiome in bipolar disorder, the role of treatment and gut microbiome in bipolar disorder, microbiome-brain connections in bipolar disorder, and interventions for bipolar disorder based on microbiota composition modification." ;
                                                                              rdfs:label "sentence_38576868_12" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38576868_13
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38576868_13> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38576868> ;
                                                                              gutprop:hasSentenceText "The number of studies about the association between gut microbiota and bipolar disorder is relatively small, and more studies are needed to expand our understanding the association between gut microbiota and bipolar disorder." ;
                                                                              rdfs:label "sentence_38576868_13" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38576868_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38576868_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38576868> ;
                                                                             gutprop:hasSentenceText "However, there has been no bibliometric analysis to summarize and analyze these publications." ;
                                                                             rdfs:label "sentence_38576868_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38576868_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38576868_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38576868> ;
                                                                             gutprop:hasSentenceText "Our objective was to perform a bibliometric analysis to investigate the current status and frontiers of the publications in the field of the association between bipolar disorder and the gut microbiota." ;
                                                                             rdfs:label "sentence_38576868_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38576868_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38576868_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38576868> ;
                                                                             gutprop:hasSentenceText "We retrieved publications concerning the interplay between the gut microbiota and bipolar disorder from the Web of Science Core Collection (WoSCC)." ;
                                                                             rdfs:label "sentence_38576868_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38576868_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38576868_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38576868> ;
                                                                             gutprop:hasSentenceText "The analysis was executed using WoSCC's literature analysis tool and VOSviewer 1.6.16." ;
                                                                             rdfs:label "sentence_38576868_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38576868_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38576868_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38576868> ;
                                                                             gutprop:hasSentenceText "In total, we identified 177 publications originating from 362 institutions across 39 countries/regions, and these articles were disseminated in 104 different journals." ;
                                                                             rdfs:label "sentence_38576868_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38576868_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38576868_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38576868> ;
                                                                             gutprop:hasSentenceText "The most productive institutions, authors, countries/regions, and journals were Zhejiang University contributing 18 publications, Shaohua Hu authoring 12 publications, China with 53 publications, and <i>Frontiers in Psychiatry</i> with 11 publications." ;
                                                                             rdfs:label "sentence_38576868_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38576868_8
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38576868_8> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38576868> ;
                                                                             gutprop:hasSentenceText "The first high-cited document was published in the Journal of Psychiatric Research in 2017, and authored by Evans." ;
                                                                             rdfs:label "sentence_38576868_8" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38576868_9
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38576868_9> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38576868> ;
                                                                             gutprop:hasSentenceText "In this article, they found gut microbiome composition was associated with BD and its illness severity, and they concluded that targeting the gut microbiota may be helpful to develop the effective treatment for bipolar disorder." ;
                                                                             rdfs:label "sentence_38576868_9" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38606411_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38606411_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/38606411> ;
                                                                             gutprop:hasSentenceText "Markers of intestinal barrier damage in patients with chronic insomnia disorder." ;
                                                                             rdfs:label "sentence_38606411_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38606411_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38606411_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38606411> ;
                                                                             gutprop:hasSentenceText "Insomnia disorder stands out as one of the prevalent clinical sleep and psychiatric disorders." ;
                                                                             rdfs:label "sentence_38606411_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38606411_10
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38606411_10> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38606411> ;
                                                                              gutprop:hasSentenceText "Overnight PSG indicated a notable increase in bed time, total wake time, sleep onset latency, and wake after sleep onset in individuals with insomnia disorder." ;
                                                                              rdfs:label "sentence_38606411_10" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38606411_11
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38606411_11> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38606411> ;
                                                                              gutprop:hasSentenceText "Additionally, there was a decrease in sleep efficiency and alterations in sleep structure (increased proportion of N1 and N3 stages, prolonged N1 stage) (P < 0.05)." ;
                                                                              rdfs:label "sentence_38606411_11" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38606411_12
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38606411_12> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38606411> ;
                                                                              gutprop:hasSentenceText "The chronic insomnia disorder group displayed significantly reduced concentrations of serum DAO, D-LA, I-FABP, and ET (P < 0.05)." ;
                                                                              rdfs:label "sentence_38606411_12" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38606411_13
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38606411_13> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38606411> ;
                                                                              gutprop:hasSentenceText "Furthermore, significant positive correlations were identified between intestinal epithelial barrier markers and sleep efficiency, while negative correlations were found with wake after sleep onset, total wake time, PSQI, HAMA, and HAMD." ;
                                                                              rdfs:label "sentence_38606411_13" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38606411_14
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38606411_14> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38606411> ;
                                                                              gutprop:hasSentenceText "Additionally, D-LA levels were significantly positively correlated with ET concentrations." ;
                                                                              rdfs:label "sentence_38606411_14" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38606411_15
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38606411_15> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38606411> ;
                                                                              gutprop:hasSentenceText "Individuals with chronic insomnia disorder manifest disruptions in sleep structure, heightened susceptibility to anxiety and depressive moods, and impaired intestinal barrier function." ;
                                                                              rdfs:label "sentence_38606411_15" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38606411_16
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38606411_16> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38606411> ;
                                                                              gutprop:hasSentenceText "These findings suggest that the occurrence and development of insomnia disorder may be linked to the impairment of the intestinal barrier." ;
                                                                              rdfs:label "sentence_38606411_16" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38606411_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38606411_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38606411> ;
                                                                             gutprop:hasSentenceText "Prior research has unequivocally demonstrated variations in the diversity and abundance of gut microbiota among individuals with insomnia disorder." ;
                                                                             rdfs:label "sentence_38606411_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38606411_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38606411_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38606411> ;
                                                                             gutprop:hasSentenceText "These alterations may play a direct or indirect role in the onset and progression of insomnia disorder by compromising the integrity of the intestinal barrier." ;
                                                                             rdfs:label "sentence_38606411_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38606411_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38606411_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38606411> ;
                                                                             gutprop:hasSentenceText "This study aims to evaluate the impairment of the intestinal barrier in individuals with insomnia disorder by scrutinizing the serum functionality of this barrier." ;
                                                                             rdfs:label "sentence_38606411_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38606411_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38606411_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38606411> ;
                                                                             gutprop:hasSentenceText "45 patients with chronic insomnia disorder and 30 matched healthy volunteers were meticulously selected based on inclusion criteria." ;
                                                                             rdfs:label "sentence_38606411_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38606411_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38606411_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38606411> ;
                                                                             gutprop:hasSentenceText "ELISA technology was employed to measure serum levels of diamine oxidase (DAO), D-lactic acid (D-LA), intestinal fatty acid binding protein (I-FABP), and endothelin (ET)." ;
                                                                             rdfs:label "sentence_38606411_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38606411_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38606411_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38606411> ;
                                                                             gutprop:hasSentenceText "Spearman correlation analysis was used to explore the relationship between intestinal mucosal markers and clinical characteristics." ;
                                                                             rdfs:label "sentence_38606411_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38606411_8
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38606411_8> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38606411> ;
                                                                             gutprop:hasSentenceText "Data were analyzed using SPSS 26.0." ;
                                                                             rdfs:label "sentence_38606411_8" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38606411_9
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38606411_9> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38606411> ;
                                                                             gutprop:hasSentenceText "Compared to the healthy control group, the insomnia disorder group exhibited significantly elevated scores on subjective mood and sleep scales (GAD-7, PHQ-9, HAMA, HAMD, PSQI, and ISI) (P < 0.05)." ;
                                                                             rdfs:label "sentence_38606411_9" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38613087_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38613087_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/38613087> ;
                                                                             gutprop:hasSentenceText "The Power of Psychobiotics in Depression: A Modern Approach through the Microbiota-Gut-Brain Axis: A Literature Review." ;
                                                                             rdfs:label "sentence_38613087_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38613087_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38613087_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38613087> ;
                                                                             gutprop:hasSentenceText "The microbiota-gut-brain (MGB) axis is a complex communication network linking the gut, microbiota, and brain, influencing various aspects of health and disease." ;
                                                                             rdfs:label "sentence_38613087_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38613087_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38613087_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38613087> ;
                                                                             gutprop:hasSentenceText "Dysbiosis, a disturbance in the gut microbiome equilibrium, can significantly impact the MGB axis, leading to alterations in microbial composition and function." ;
                                                                             rdfs:label "sentence_38613087_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38613087_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38613087_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38613087> ;
                                                                             gutprop:hasSentenceText "Emerging evidence highlights the connection between microbiota alterations and neurological and psychiatric disorders, including depression." ;
                                                                             rdfs:label "sentence_38613087_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38613087_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38613087_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38613087> ;
                                                                             gutprop:hasSentenceText "This review explores the potential of psychobiotics in managing depressive disorders, emphasizing their role in restoring microbial balance and influencing the MGB axis." ;
                                                                             rdfs:label "sentence_38613087_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38613087_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38613087_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38613087> ;
                                                                             gutprop:hasSentenceText "Psychobiotics exhibit positive effects on the intestinal barrier, immune response, cortisol levels, and the hypothalamic-pituitary-adrenal (HPA) axis." ;
                                                                             rdfs:label "sentence_38613087_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38613087_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38613087_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38613087> ;
                                                                             gutprop:hasSentenceText "Studies suggest that probiotics may serve as an adjunct therapy for depression, especially in treatment-resistant cases." ;
                                                                             rdfs:label "sentence_38613087_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38613087_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38613087_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38613087> ;
                                                                             gutprop:hasSentenceText "This review discusses key findings from studies on psychobiotics interventions, emphasizing their impact on the gut-brain axis and mental health." ;
                                                                             rdfs:label "sentence_38613087_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38613087_8
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38613087_8> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38613087> ;
                                                                             gutprop:hasSentenceText "The increasing acceptance of the expanded concept of the MGB axis underscores the importance of microorganisms in mental well-being." ;
                                                                             rdfs:label "sentence_38613087_8" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38613087_9
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38613087_9> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38613087> ;
                                                                             gutprop:hasSentenceText "As our understanding of the microbiome's role in health and disease grows, probiotics emerge as promising agents for addressing mental health issues, providing new avenues for therapeutic interventions in depressive disorders." ;
                                                                             rdfs:label "sentence_38613087_9" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38664425_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38664425_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/38664425> ;
                                                                             gutprop:hasSentenceText "Effects of microbiome-based interventions on neurodegenerative diseases: a systematic review and meta-analysis." ;
                                                                             rdfs:label "sentence_38664425_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38664425_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38664425_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38664425> ;
                                                                             gutprop:hasSentenceText "Neurodegenerative diseases (NDDs) are characterized by neuronal damage and progressive loss of neuron function." ;
                                                                             rdfs:label "sentence_38664425_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38664425_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38664425_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38664425> ;
                                                                             gutprop:hasSentenceText "Microbiome-based interventions, such as dietary interventions, biotics, and fecal microbiome transplant, have been proposed as a novel approach to managing symptoms and modulating disease progression." ;
                                                                             rdfs:label "sentence_38664425_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38664425_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38664425_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38664425> ;
                                                                             gutprop:hasSentenceText "Emerging clinical trials have investigated the efficacy of interventions modulating the GM in alleviating or reversing disease progression, yet no comprehensive synthesis have been done." ;
                                                                             rdfs:label "sentence_38664425_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38664425_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38664425_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38664425> ;
                                                                             gutprop:hasSentenceText "A systematic review of the literature was therefore conducted to investigate the efficacy of microbiome-modulating methods." ;
                                                                             rdfs:label "sentence_38664425_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38664425_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38664425_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38664425> ;
                                                                             gutprop:hasSentenceText "The search yielded 4051 articles, with 15 clinical trials included." ;
                                                                             rdfs:label "sentence_38664425_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38664425_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38664425_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38664425> ;
                                                                             gutprop:hasSentenceText "The overall risk of bias was moderate in most studies." ;
                                                                             rdfs:label "sentence_38664425_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38664425_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38664425_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38664425> ;
                                                                             gutprop:hasSentenceText "Most microbiome-modulating interventions changed the GM composition." ;
                                                                             rdfs:label "sentence_38664425_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38664425_8
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38664425_8> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38664425> ;
                                                                             gutprop:hasSentenceText "Despite inconsistent changes in GM composition, the meta-analysis showed that microbiome-modulating interventions improved disease burden (SMD, - 0.57; 95% CI - 0.93 to - 0.21; I<sup>2</sup> = 42%; P = 0.002) with a qualitative trend of improvement in constipation." ;
                                                                             rdfs:label "sentence_38664425_8" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38664425_9
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38664425_9> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38664425> ;
                                                                             gutprop:hasSentenceText "However, current studies have high methodological heterogeneity and small sample sizes, requiring more well-designed and controlled studies to elucidate the complex linkage between microbiome, microbiome-modulating interventions, and NDDs." ;
                                                                             rdfs:label "sentence_38664425_9" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38679353_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38679353_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/38679353> ;
                                                                             gutprop:hasSentenceText "Association between increased and decreased gut microbiota abundance and Parkinson's disease: A systematic review and subgroup meta-analysis." ;
                                                                             rdfs:label "sentence_38679353_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38679353_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38679353_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38679353> ;
                                                                             gutprop:hasSentenceText "The objective of the study was to systematically investigate the association between gut microbiota (GM) abundance and Parkinson's disease (PD)." ;
                                                                             rdfs:label "sentence_38679353_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38679353_10
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38679353_10> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38679353> ;
                                                                              gutprop:hasSentenceText "Patients in the PD cohort exhibited distinctive microbiota compositions compared to healthy individuals, with unique differential patterns in gut microbiome abundance at the phylum, family, and genus levels that may be associated wtih PD pathogenesis." ;
                                                                              rdfs:label "sentence_38679353_10" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38679353_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38679353_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38679353> ;
                                                                             gutprop:hasSentenceText "PubMed, Medline, Cochrane Library and other literature datebase platforms were searched for eligible studies in the English-language from conception to March 1, 2024." ;
                                                                             rdfs:label "sentence_38679353_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38679353_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38679353_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38679353> ;
                                                                             gutprop:hasSentenceText "Studies evaluating the association between GM and PD were included." ;
                                                                             rdfs:label "sentence_38679353_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38679353_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38679353_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38679353> ;
                                                                             gutprop:hasSentenceText "The results of the included studies were analyzed using a random effects model with calculation of the mean difference (MD) with the 95 % confidence interval to quantify the incidence of differences in abundance of various bacterial families in PD patients." ;
                                                                             rdfs:label "sentence_38679353_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38679353_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38679353_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38679353> ;
                                                                             gutprop:hasSentenceText "Continuous models were used to analyze the extracted data." ;
                                                                             rdfs:label "sentence_38679353_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38679353_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38679353_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38679353> ;
                                                                             gutprop:hasSentenceText "A total of 14 studies with 1045 PD cases and 821 healthy controls were included for data extraction and meta-analysis." ;
                                                                             rdfs:label "sentence_38679353_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38679353_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38679353_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38679353> ;
                                                                             gutprop:hasSentenceText "All the included studies exhibited reasonable quality." ;
                                                                             rdfs:label "sentence_38679353_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38679353_8
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38679353_8> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38679353> ;
                                                                             gutprop:hasSentenceText "The included studies reported the data on the ratios of 10 families of GM." ;
                                                                             rdfs:label "sentence_38679353_8" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38679353_9
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38679353_9> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38679353> ;
                                                                             gutprop:hasSentenceText "Of these 10 microbiota families, Bifidobacteriaceae, Ruminococcaceae, Rikenellaceae, Lactobacillaceae, Verrucomicrobiaceae and Christensenellaceae were found to have increased ratios according to the pooled ratios, while Prevotellaceae, Lachnospiraceae, Erysipelotrichaceae and Faecalibacterium were decreased in PD cases." ;
                                                                             rdfs:label "sentence_38679353_9" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38686220_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38686220_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/38686220> ;
                                                                             gutprop:hasSentenceText "Safety and efficacy of faecal microbiota transplantation in patients with mild to moderate Parkinson's disease (GUT-PARFECT): a double-blind, placebo-controlled, randomised, phase 2 trial." ;
                                                                             rdfs:label "sentence_38686220_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38686220_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38686220_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38686220> ;
                                                                             gutprop:hasSentenceText "Dysregulation of the gut microbiome has been implicated in Parkinson's disease (PD)." ;
                                                                             rdfs:label "sentence_38686220_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38686220_10
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38686220_10> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38686220> ;
                                                                              gutprop:hasSentenceText "Between December 2020 and December 2021, FMT procedures were conducted on 46 patients with PD: 22 in the healthy donor group and 24 in the placebo group." ;
                                                                              rdfs:label "sentence_38686220_10" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38686220_11
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38686220_11> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38686220> ;
                                                                              gutprop:hasSentenceText "Clinical evaluations were performed at baseline, 3, 6, and 12 months post-FMT." ;
                                                                              rdfs:label "sentence_38686220_11" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38686220_12
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38686220_12> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38686220> ;
                                                                              gutprop:hasSentenceText "Full data analysis was possible for 21 participants in the healthy donor group and 22 in the placebo group." ;
                                                                              rdfs:label "sentence_38686220_12" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38686220_13
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38686220_13> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38686220> ;
                                                                              gutprop:hasSentenceText "After 12 months, the MDS-UPDRS motor score significantly improved by a mean of 5.8 points (95% CI -11.4 to -0.2) in the healthy donor group and by 2.7 points (-8.3 to 2.9) in the placebo group (p = 0.0235)." ;
                                                                              rdfs:label "sentence_38686220_13" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38686220_14
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38686220_14> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38686220> ;
                                                                              gutprop:hasSentenceText "Adverse events were limited to temporary abdominal discomfort." ;
                                                                              rdfs:label "sentence_38686220_14" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38686220_15
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38686220_15> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38686220> ;
                                                                              gutprop:hasSentenceText "Our findings suggested a single FMT induced mild, but long-lasting beneficial effects on motor symptoms in patients with early-stage PD." ;
                                                                              rdfs:label "sentence_38686220_15" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38686220_16
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38686220_16> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38686220> ;
                                                                              gutprop:hasSentenceText "These findings highlight the potential of modulating the gut microbiome as a therapeutic approach and warrant a further exploration of FMT in larger cohorts of patients with PD in various disease stages." ;
                                                                              rdfs:label "sentence_38686220_16" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38686220_17
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38686220_17> rdf:type owl:NamedIndividual ,
                                                                                       gutprop:Sentence ;
                                                                              gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38686220> ;
                                                                              gutprop:hasSentenceText "Flemish PD patient organizations (VPL and Parkili), Research Foundation Flanders (FWO), Biocodex Microbiota Foundation." ;
                                                                              rdfs:label "sentence_38686220_17" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38686220_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38686220_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38686220> ;
                                                                             gutprop:hasSentenceText "This study aimed to evaluate the clinical effects and safety of a single faecal microbiota transplantation (FMT) in patients with early-stage PD." ;
                                                                             rdfs:label "sentence_38686220_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38686220_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38686220_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38686220> ;
                                                                             gutprop:hasSentenceText "The GUT-PARFECT trial, a single-centre randomised, double-blind, placebo-controlled trial was conducted at Ghent University Hospital between December 01, 2020 and December 12, 2022." ;
                                                                             rdfs:label "sentence_38686220_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38686220_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38686220_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38686220> ;
                                                                             gutprop:hasSentenceText "Participants (aged 50-65 years, Hoehn and Yahr stage 2) were randomly assigned to receive nasojejunal FMT with either healthy donor stool or their own stool." ;
                                                                             rdfs:label "sentence_38686220_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38686220_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38686220_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38686220> ;
                                                                             gutprop:hasSentenceText "Computer-generated randomisation was done in a 1:1 ratio through permutated-block scheduling." ;
                                                                             rdfs:label "sentence_38686220_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38686220_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38686220_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38686220> ;
                                                                             gutprop:hasSentenceText "Treatment allocation was concealed for participants and investigators." ;
                                                                             rdfs:label "sentence_38686220_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38686220_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38686220_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38686220> ;
                                                                             gutprop:hasSentenceText "The primary outcome measure at 12 months was the change in the Movement Disorders Society-Unified Parkinson's Disease Rating Scale (MDS-UPDRS) motor score obtained during off-medication evaluations." ;
                                                                             rdfs:label "sentence_38686220_7" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38686220_8
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38686220_8> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38686220> ;
                                                                             gutprop:hasSentenceText "Intention-to-treat analysis was performed using a mixed model for repeated measures analysis." ;
                                                                             rdfs:label "sentence_38686220_8" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38686220_9
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38686220_9> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38686220> ;
                                                                             gutprop:hasSentenceText "This completed trial is registered on ClinicalTrials.gov (NCT03808389)." ;
                                                                             rdfs:label "sentence_38686220_9" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38707924_0
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38707924_0> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/38707924> ;
                                                                             gutprop:hasSentenceText "The influence of the gut-brain axis on anxiety and depression: A review of the literature on the use of probiotics." ;
                                                                             rdfs:label "sentence_38707924_0" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38707924_1
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38707924_1> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38707924> ;
                                                                             gutprop:hasSentenceText "This review aims to argue how using probiotics can improve anxiety and depressive behaviour without adverse effects, also exploring the impact of postbiotics on it." ;
                                                                             rdfs:label "sentence_38707924_1" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38707924_2
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38707924_2> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38707924> ;
                                                                             gutprop:hasSentenceText "Specifically, probiotics have drawn more attention as effective alternative treatments, considering the rising cost of antidepressant and anti-anxiety drugs and the high risk of side effects." ;
                                                                             rdfs:label "sentence_38707924_2" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38707924_3
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38707924_3> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38707924> ;
                                                                             gutprop:hasSentenceText "Depression and anxiety disorders are among the most common mental illnesses in the world's population, characterised by low mood, poor general interest, and cognitive or motor dysfunction." ;
                                                                             rdfs:label "sentence_38707924_3" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38707924_4
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38707924_4> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38707924> ;
                                                                             gutprop:hasSentenceText "Thus, this study analysed published literature on anxiety, depression, and probiotic supplementation from PubMed and Scopus, focusing on the last twenty years." ;
                                                                             rdfs:label "sentence_38707924_4" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38707924_5
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38707924_5> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38707924> ;
                                                                             gutprop:hasSentenceText "This study focused on the effect of probiotics on mental health as they have drawn more attention because of their extensive clinical applications and positive impact on various diseases." ;
                                                                             rdfs:label "sentence_38707924_5" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38707924_6
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38707924_6> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38707924> ;
                                                                             gutprop:hasSentenceText "Numerous studies have demonstrated how the gut microbiota might be critical for mood regulation and how probiotics can affect host health by regulating the gut-brain axis." ;
                                                                             rdfs:label "sentence_38707924_6" .


###  https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38707924_7
<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38707924_7> rdf:type owl:NamedIndividual ,
                                                                                      gutprop:Sentence ;
                                                                             gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38707924> ;
                                                                             gutprop:hasSentenceText "By comparing the different works analysed, it was possible to identify a strategy by which they are selected and employed and, at the same time, to assess how the effect of probiotics can be optimised using postbiotics, an innovation to improve mental well-being in humans." ;
                                                                             rdfs:label "sentence_38707924_7" .


