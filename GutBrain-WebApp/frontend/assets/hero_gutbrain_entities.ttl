                                                    gutprop:affect <http://purl.obolibrary.org/obo/NCIT_C124639> ,
                                                                   <http://purl.obolibrary.org/obo/NCIT_C2878> ;
                                                    gutprop:changeAbundance <http://purl.obolibrary.org/obo/NCBITaxon_547> ,
                                                                            <http://purl.obolibrary.org/obo/NCBITaxon_562> ,
                                                                            <http://purl.obolibrary.org/obo/OHMI_0000463> ;
                                                    gutprop:containedIn <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/d079a26ae161fbec> ,
                                                                        <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/256aacf6cef366aa> ,
                                                                        <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/4218a10349c7ef3b> ,
                                                                        <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/519d90727ffce8be> ,
                                                                        <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/913fb9334264739d> ;
                                                    gutprop:isA <https://uts.nlm.nih.gov/uts/umls/concept/C0742986> ;
                                                    gutprop:target <https://uts.nlm.nih.gov/uts/umls/concept/C0027361> ,
