                                                    gutprop:influence <http://purl.obolibrary.org/obo/NCIT_C3137> ;
                                                    rdfs:comment "Irritants are substances or agents that cause inflammation, discomfort, or other adverse reactions in living organisms, often through chemical or physical interactions with biological tissues. [Definition Source: llama3-8b-8192]" ,
                                                                 "UMLS Match" ;
                                                    rdfs:label "Irritants" .


###  https://uts.nlm.nih.gov/uts/umls/concept/C0023570
<https://uts.nlm.nih.gov/uts/umls/concept/C0023570> rdf:type owl:NamedIndividual ,
                                                             skos:Concept ,
                                                             gutprop:Drug ;
                                                    skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/Drug> ;
                                                    gutprop:changeEffect <http://purl.obolibrary.org/obo/NCIT_C26845> ;
                                                    gutprop:containedIn <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/af6c9526acea2113> ,
                                                                        <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/cbf5c8d76e1dbb07> ,
                                                                        <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/282684196a9d8709> ;
                                                    rdfs:comment "The naturally occurring form of DIHYDROXYPHENYLALANINE and the immediate precursor of DOPAMINE. Unlike dopamine itself, it can be taken orally and crosses the blood-brain barrier. It is rapidly taken up by dopaminergic neurons and converted to DOPAMINE. It is used for the treatment of PARKINSONIAN DISORDERS and is usually given with agents that inhibit its conversion to dopamine outside of the central nervous system. [Definition Source: UMLS]" ,
                                                                 "UMLS Match" ;
                                                    rdfs:label "Levodopa" .


###  https://uts.nlm.nih.gov/uts/umls/concept/C0023732
<https://uts.nlm.nih.gov/uts/umls/concept/C0023732> rdf:type owl:NamedIndividual ,
                                                             skos:Concept ,
                                                             gutprop:StatisticalTechnique ;
                                                    skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/StatisticalTechnique> ;
                                                    gutprop:containedIn <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/cd5976c386b5b159> ,
                                                                        <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/ea2d6b812ae8c2c3> ,
                                                                        <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/755571540c206c26> ;
                                                    rdfs:comment "Statistical models in which the value of a parameter for a given value of a factor is assumed to be equal to a + bx, where a and b are constants. The models predict a linear regression. [Definition Source: UMLS]" ,
                                                                 "UMLS Match" ;
                                                    rdfs:label "Linear Models" .


###  https://uts.nlm.nih.gov/uts/umls/concept/C0023733
<https://uts.nlm.nih.gov/uts/umls/concept/C0023733> rdf:type owl:NamedIndividual ,
                                                             skos:Concept ,
                                                             gutprop:StatisticalTechnique ;
                                                    skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/StatisticalTechnique> ;
                                                    gutprop:containedIn <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/2c14f57d11df6748> ;
                                                    rdfs:comment "Linear regression is a statistical method used to establish a linear relationship between a dependent variable and one or more independent variables by minimizing the sum of the squared residuals. [Definition Source: llama3-8b-8192]" ,
                                                                 "UMLS Match" ;
                                                    rdfs:label "Linear Regression" .


###  https://uts.nlm.nih.gov/uts/umls/concept/C0023822
<https://uts.nlm.nih.gov/uts/umls/concept/C0023822> rdf:type owl:NamedIndividual ,
                                                             skos:Concept ,
                                                             gutprop:Chemical ;
                                                    skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/Chemical> ;
                                                    gutprop:containedIn <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/465cdc594f7c4bdc> ;
                                                    rdfs:comment "High Density Lipoprotein Cholesterol (HDL-C) is a type of lipoprotein that transports cholesterol from peripheral tissues to the liver for excretion, playing a key role in reverse cholesterol transport and considered a beneficial factor in cardiovascular health. [Definition Source: llama3-8b-8192]" ,
                                                                 "UMLS Match" ;
                                                    rdfs:label "High Density Lipoprotein Cholesterol" .


###  https://uts.nlm.nih.gov/uts/umls/concept/C0023895
<https://uts.nlm.nih.gov/uts/umls/concept/C0023895> rdf:type owl:NamedIndividual ,
                                                             skos:Concept ,
                                                             <https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding> ;
