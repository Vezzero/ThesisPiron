                                             gutprop:locatedIn <https://www.ncbi.nlm.nih.gov/mesh/68010361> ;
                                             rdfs:comment "An organ that constitutes the external surface of the body. It consists of the epidermis, dermis, and skin appendages. [Definition Source: NCIT]" ,
                                                          "NCIT Match" ;
                                             rdfs:label "Skin" .


###  http://purl.obolibrary.org/obo/NCIT_C12521
<http://purl.obolibrary.org/obo/NCIT_C12521> rdf:type owl:NamedIndividual ,
                                                      skos:Concept ,
