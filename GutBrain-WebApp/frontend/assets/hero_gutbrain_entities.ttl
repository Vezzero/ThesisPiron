                                                                <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/c375ab01afa8cf34> ,
                                                                <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/9a91962da4f99851> ;
                                            rdfs:comment "A change from the patient's baseline sleeping pattern, in the hours slept and/or an alteration/dysfunction in the stages of sleep. [Definition Source: NCIT]" ,
                                                         "NCIT Match" ;
                                            rdfs:label "Sleep Disorder" .


###  http://purl.obolibrary.org/obo/NCIT_C3384
<http://purl.obolibrary.org/obo/NCIT_C3384> rdf:type owl:NamedIndividual ,
                                                     skos:Concept ,
                                                     <https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding> ;
                                            skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/DiseaseDisorderOrFinding> ;
                                            gutprop:containedIn <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/897526d6df645aec> ;
                                            rdfs:comment "Abnormal enlargement of the spleen. [Definition Source: NCIT]" ,
                                                         "NCIT Match" ;
                                            rdfs:label "Splenomegaly" .


###  http://purl.obolibrary.org/obo/NCIT_C33877
<http://purl.obolibrary.org/obo/NCIT_C33877> rdf:type owl:NamedIndividual ,
                                                      skos:Concept ,
                                                      gutprop:Chemical ;
                                             skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/Chemical> ;
                                             gutprop:containedIn <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/96e4ed5f88f3ef65> ;
                                             gutprop:locatedIn <http://purl.obolibrary.org/obo/NCIT_C12439> ;
                                             rdfs:comment "A cell that conducts a nerve impulse that originated at a receptor in one of the interior organs of the one of the three cavities of the body and proceeds towards the central nervous system. [Definition Source: NCIT]" ,
                                                          "NCIT Match" ;
                                             rdfs:label "Visceral Afferent Neuron" .


###  http://purl.obolibrary.org/obo/NCIT_C3389
<http://purl.obolibrary.org/obo/NCIT_C3389> rdf:type owl:NamedIndividual ,
                                                     skos:Concept ,
                                                     <https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding> ;
                                            skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/DiseaseDisorderOrFinding> ;
                                            gutprop:containedIn <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/33ac48a5ef0a16d3> ;
                                            gutprop:isA <http://purl.obolibrary.org/obo/OMIT_0002893> ;
                                            rdfs:comment "An anxiety disorder precipitated by an experience of intense fear or horror while exposed to a traumatic (especially life-threatening) event. The disorder is characterized by intrusive recurring thoughts or images of the traumatic event; avoidance of anything associated with the event; a state of hyperarousal and diminished emotional responsiveness. These symptoms are present for at least one month and the disorder is usually long-term. [Definition Source: NCIT]" ,
                                                         "NCIT Match" ;
                                            rdfs:label "Post-Traumatic Stress Disorder" .


###  http://purl.obolibrary.org/obo/NCIT_C3390
<http://purl.obolibrary.org/obo/NCIT_C3390> rdf:type owl:NamedIndividual ,
                                                     skos:Concept ,
                                                     <https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding> ;
                                            skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/DiseaseDisorderOrFinding> ;
                                            gutprop:containedIn <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/1ba7573640bbbb13> ;
                                            rdfs:comment "A sudden loss of neurological function secondary to hemorrhage or ischemia in the brain parenchyma due to a vascular event. [Definition Source: NCIT]" ,
                                                         "NCIT Match" ;
                                            rdfs:label "Stroke" .


###  http://purl.obolibrary.org/obo/NCIT_C33969
<http://purl.obolibrary.org/obo/NCIT_C33969> rdf:type owl:NamedIndividual ,
                                                      skos:Concept ,
                                                      <https://w3id.org/brainteaser/ontology/schema/AnatomicalSite> ;
                                             skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/AnatomicSite> ;
                                             gutprop:containedIn <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/cd35d31d18b78be1> ;
                                             rdfs:comment "Any component of the central nervous system contained within the spinal column or the vertebral canal. [Definition Source: NCIT]" ,
                                                          "NCIT Match" ;
                                             rdfs:label "Spinal Cord" .


###  http://purl.obolibrary.org/obo/NCIT_C34028
<http://purl.obolibrary.org/obo/NCIT_C34028> rdf:type owl:NamedIndividual ,
                                                      skos:Concept ,
                                                      <https://w3id.org/brainteaser/ontology/schema/AnatomicalSite> ;
                                             skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/AnatomicSite> ;
                                             gutprop:containedIn <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/e73c1627141aeb93> ,
                                                                 <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/1df1fcc3cb5ad1d7> ;
                                             rdfs:comment "Any component of one of the two bean-shaped organs located on each side of the spine in the retroperitoneum, which filters and secrets the metabolic products and minerals from the blood, thus maintaining the homeostasis. [Definition Source: NCIT]" ,
                                                          "NCIT Match" ;
                                             rdfs:label "Kidney" .


###  http://purl.obolibrary.org/obo/NCIT_C34077
<http://purl.obolibrary.org/obo/NCIT_C34077> rdf:type owl:NamedIndividual ,
                                                      skos:Concept ,
                                                      <https://w3id.org/brainteaser/ontology/schema/Gene> ;
                                             skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/Gene> ;
                                             gutprop:containedIn <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/e4bd20717954a51e> ;
                                             rdfs:comment "NCIT Match" ,
                                                          "Peroxisome proliferator-activated receptor gamma (505 aa, ~58 kDa) is encoded by the human PPARG gene. This protein plays a role in transcriptional regulation, lipid metabolism, cell differentiation, glucose homeostasis and apoptosis. [Definition Source: NCIT]" ;
                                             rdfs:label "Peroxisome Proliferator-Activated Receptor Gamma" .


###  http://purl.obolibrary.org/obo/NCIT_C34082
<http://purl.obolibrary.org/obo/NCIT_C34082> rdf:type owl:NamedIndividual ,
                                                      skos:Concept ,
                                                      <https://w3id.org/brainteaser/ontology/schema/AnatomicalSite> ;
                                             skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/AnatomicSite> ;
                                             gutprop:containedIn <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/352b369f82b24aae> ,
                                                                 <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/8532abde8f620af9> ;
                                             rdfs:comment "NCIT Match" ,
                                                          "The upper gastrointestinal (GI) tract is comprised of mouth, pharynx, esophagus and stomach while the lower GI tract consists of intestines and anus. The primary function of the GI tract is to ingest, digest, absorb and ultimately excrete food stuff. [Definition Source: NCIT]" ;
                                             rdfs:label "Gastrointestinal Tract" .


###  http://purl.obolibrary.org/obo/NCIT_C3426
<http://purl.obolibrary.org/obo/NCIT_C3426> rdf:type owl:NamedIndividual ,
                                                     skos:Concept ,
                                                     <https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding> ;
                                            skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/DiseaseDisorderOrFinding> ;
                                            gutprop:containedIn <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/10c6bd0ae009d0cc> ;
                                            rdfs:comment "A circumscribed inflammatory and often suppurating lesion on the skin or an internal mucous surface resulting in necrosis of tissue. [Definition Source: NCIT]" ,
                                                         "NCIT Match" ;
                                            rdfs:label "Ulcer" .


###  http://purl.obolibrary.org/obo/NCIT_C34373
<http://purl.obolibrary.org/obo/NCIT_C34373> rdf:type owl:NamedIndividual ,
                                                      skos:Concept ,
                                                      <https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding> ;
                                             skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/DiseaseDisorderOrFinding> ;
                                             gutprop:containedIn <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/ee7637bd419d4a00> ,
                                                                 <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/3bed5d1b9fa17778> ;
                                             gutprop:isA <http://purl.obolibrary.org/obo/NCIT_C26835> ;
                                             rdfs:comment "A neurodegenerative disorder characterized by progressive degeneration of the motor neurons of the central nervous system. It results in weakness and atrophy of the muscles which leads to an inability to initiate and control voluntary movements. [Definition Source: NCIT]" ,
                                                          "NCIT Match" ;
                                             rdfs:label "Amyotrophic Lateral Sclerosis" .


###  http://purl.obolibrary.org/obo/NCIT_C34387
<http://purl.obolibrary.org/obo/NCIT_C34387> rdf:type owl:NamedIndividual ,
                                                      skos:Concept ,
                                                      <https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding> ;
                                             skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/DiseaseDisorderOrFinding> ;
                                             gutprop:containedIn <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/ea325d761f98c6b7> ,
                                                                 <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/8438f53480d72dc1> ;
                                             gutprop:isA <http://purl.obolibrary.org/obo/OMIT_0002893> ;
                                             rdfs:comment "A disorder most often seen in adolescent females characterized by a refusal to maintain a minimally normal body weight, an intense fear of gaining weight, a disturbance in body image, and, in postmenarcheal females, the development of amenorrhea. [Definition Source: NCIT]" ,
                                                          "NCIT Match" ;
                                             rdfs:label "Anorexia Nervosa" .


###  http://purl.obolibrary.org/obo/NCIT_C3439
<http://purl.obolibrary.org/obo/NCIT_C3439> rdf:type owl:NamedIndividual ,
                                                     skos:Concept ,
                                                     <https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding> ;
                                            skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/DiseaseDisorderOrFinding> ;
                                            gutprop:containedIn <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/b8f85a4bd03ec05e> ;
                                            gutprop:target <https://w3id.org/hereditary/ontology/gutbrain/resource/human/ParkinsonDiseasePatients> ;
                                            rdfs:comment "Any disease caused by a virus. [Definition Source: NCIT]" ,
                                                         "NCIT Match" ;
                                            rdfs:label "Viral Infection" .


###  http://purl.obolibrary.org/obo/NCIT_C34423
<http://purl.obolibrary.org/obo/NCIT_C34423> rdf:type owl:NamedIndividual ,
                                                      skos:Concept ,
                                                      <https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding> ;
                                             skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/DiseaseDisorderOrFinding> ;
                                             gutprop:affect <http://purl.obolibrary.org/obo/NCIT_C16877> ,
                                                            <http://purl.obolibrary.org/obo/NCIT_C21007> ,
                                                            <https://uts.nlm.nih.gov/uts/umls/concept/C0588008> ,
                                                            <https://uts.nlm.nih.gov/uts/umls/concept/C2058073> ;
                                             gutprop:changeAbundance <http://purl.obolibrary.org/obo/NCBITaxon_1578> ,
                                                                     <http://purl.obolibrary.org/obo/NCBITaxon_2013654> ,
                                                                     <http://purl.obolibrary.org/obo/NCBITaxon_216851> ,
                                                                     <https://www.ncbi.nlm.nih.gov/mesh/D045857> ,
                                                                     <https://www.ncbi.nlm.nih.gov/mesh/?term=firmicutes> ;
                                             gutprop:containedIn <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/ff85abf3ab562af8> ,
                                                                 <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/121ddc834111e089> ,
                                                                 <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/226a193ae269296d> ,
                                                                 <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/5e657ff6158d3e2a> ;
                                             gutprop:isA <http://purl.obolibrary.org/obo/NCIT_C26835> ,
                                                         <http://purl.obolibrary.org/obo/OMIT_0002893> ;
                                             gutprop:target <https://www.ncbi.nlm.nih.gov/mesh/68010361> ;
                                             rdfs:comment "A disorder of the brain that causes unusual shifts in mood, energy, activity levels and the ability to carry out day-to-day tasks. Often these moods range and shift from periods of elation and energized behavior to those of hopelessness and depression. [Definition Source: NCIT]" ,
                                                          "NCIT Match" ;
                                             rdfs:label "Bipolar Disorder" .


###  http://purl.obolibrary.org/obo/NCIT_C3445
<http://purl.obolibrary.org/obo/NCIT_C3445> rdf:type owl:NamedIndividual ,
                                                     skos:Concept ,
                                                     <https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding> ;
