                                            gutprop:containedIn <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/85d6aeebc7a610e1> ;
                                            rdfs:comment "Loss of appetite. [Definition Source: NCIT]" ,
                                                         "NCIT Match" ;
                                            rdfs:label "Anorexia" .


###  http://purl.obolibrary.org/obo/NCIT_C2878
<http://purl.obolibrary.org/obo/NCIT_C2878> rdf:type owl:NamedIndividual ,
                                                     skos:Concept ,
                                                     <https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding> ;
                                            skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/DiseaseDisorderOrFinding> ;
                                            gutprop:affect <https://uts.nlm.nih.gov/uts/umls/concept/C4287543> ;
                                            gutprop:containedIn <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/0a172e64535a6f2e> ,
                                                                <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/09b814973ec9ebea> ,
                                                                <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/5b5c872608b62897> ;
                                            gutprop:target <http://purl.obolibrary.org/obo/NCIT_C14201> ,
                                                           <https://www.ncbi.nlm.nih.gov/mesh/68010361> ;
                                            rdfs:comment "A category of psychiatric disorders which are characterized by anxious feelings or fear often accompanied by physical symptoms associated with anxiety. [Definition Source: NCIT]" ,
                                                         "NCIT Match" ;
                                            rdfs:label "Anxiety Disorder" .


###  http://purl.obolibrary.org/obo/NCIT_C2884
<http://purl.obolibrary.org/obo/NCIT_C2884> rdf:type owl:NamedIndividual ,
                                                     skos:Concept ,
                                                     <https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding> ;
                                            skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/DiseaseDisorderOrFinding> ;
                                            gutprop:containedIn <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/05d46e97030ec7d8> ;
                                            rdfs:comment "A chronic, systemic autoimmune disorder characterized by inflammation in the synovial membranes and articular surfaces. It manifests primarily as a symmetric, erosive polyarthritis that spares the axial skeleton and is typically associated with the presence in the serum of rheumatoid factor. [Definition Source: NCIT]" ,
                                                         "NCIT Match" ;
                                            rdfs:label "Rheumatoid Arthritis" .


###  http://purl.obolibrary.org/obo/NCIT_C2889
<http://purl.obolibrary.org/obo/NCIT_C2889> rdf:type owl:NamedIndividual ,
                                                     skos:Concept ,
                                                     <https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding> ;
                                            skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/DiseaseDisorderOrFinding> ;
                                            gutprop:affect <http://purl.obolibrary.org/obo/NCIT_C3362> ;
                                            gutprop:containedIn <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/171d4079acceff71> ,
                                                                <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/32e83e92d45d71f6> ,
                                                                <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/33978a88bd56012a> ,
                                                                <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/4c686c14229db037> ,
                                                                <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/61e3ffd9a5c82aec> ;
                                            rdfs:comment "A disorder resulting from loss of function or tissue destruction of an organ or multiple organs, arising from humoral or cellular immune responses of the individual to his own tissue constituents. It may be systemic (e.g., systemic lupus erythematosus), or organ specific, (e.g., thyroiditis). [Definition Source: NCIT]" ,
                                                         "NCIT Match" ;
                                            rdfs:label "Autoimmune Disease" .


###  http://purl.obolibrary.org/obo/NCIT_C2890
<http://purl.obolibrary.org/obo/NCIT_C2890> rdf:type owl:NamedIndividual ,
                                                     skos:Concept ,
                                                     <https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding> ;
                                            skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/DiseaseDisorderOrFinding> ;
                                            gutprop:containedIn <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/c07029807ba0438d> ;
                                            gutprop:target <http://purl.obolibrary.org/obo/NCIT_C14182> ;
                                            rdfs:comment "An acute infectious disorder that is caused by gram positive or gram negative bacteria; representative examples include pneumococcal, streptococcal, salmonella, and meningeal infections. [Definition Source: NCIT]" ,
                                                         "NCIT Match" ;
                                            rdfs:label "Bacterial Infection" .


###  http://purl.obolibrary.org/obo/NCIT_C2893
<http://purl.obolibrary.org/obo/NCIT_C2893> rdf:type owl:NamedIndividual ,
                                                     skos:Concept ,
                                                     <https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding> ;
                                            skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/DiseaseDisorderOrFinding> ;
                                            gutprop:affect <http://purl.obolibrary.org/obo/OMIT_0028544> ;
                                            gutprop:changeAbundance <http://purl.obolibrary.org/obo/NCBITaxon_1486939> ,
                                                                    <https://w3id.org/hereditary/ontology/gutbrain/resource/diseasedisorderorfinding/AlteredGutMicrobiota> ;
                                            gutprop:containedIn <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/d91174e1e13cf05f> ,
                                                                <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/0c68c2b443cf2834> ;
                                            gutprop:target <https://uts.nlm.nih.gov/uts/umls/concept/C0748064> ,
                                                           <https://uts.nlm.nih.gov/uts/umls/concept/C5547365> ,
                                                           <https://www.ncbi.nlm.nih.gov/mesh/D000293> ,
                                                           <https://www.ncbi.nlm.nih.gov/mesh/D002648> ,
                                                           <https://www.ncbi.nlm.nih.gov/mesh/68010361> ;
                                            rdfs:comment "A disorder characterized by behavioral and/or psychological abnormalities, often accompanied by physical symptoms. The symptoms may cause clinically significant distress or impairment in social and occupational areas of functioning. Representative examples include anxiety disorders, cognitive disorders, mood disorders and schizophrenia. [Definition Source: NCIT]" ,
                                                         "NCIT Match" ;
                                            rdfs:label "Psychiatric Disorder" .


###  http://purl.obolibrary.org/obo/NCIT_C2931
<http://purl.obolibrary.org/obo/NCIT_C2931> rdf:type owl:NamedIndividual ,
                                                     skos:Concept ,
                                                     <https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding> ;
                                            skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/DiseaseDisorderOrFinding> ;
                                            gutprop:containedIn <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/68c737df9872f3c0> ;
                                            rdfs:comment "A non-neoplastic or neoplastic disorder affecting the heart or the vessels (arteries, veins and lymph vessels). Representative examples of non-neoplastic cardiovascular disorders are endocarditis and hypertension. Representative examples of neoplastic cardiovascular disorders are endocardial myxoma and angiosarcoma. [Definition Source: NCIT]" ,
                                                         "NCIT Match" ;
                                            rdfs:label "Cardiovascular Disorder" .


###  http://purl.obolibrary.org/obo/NCIT_C2934
<http://purl.obolibrary.org/obo/NCIT_C2934> rdf:type owl:NamedIndividual ,
                                                     skos:Concept ,
                                                     <https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding> ;
                                            skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/DiseaseDisorderOrFinding> ;
                                            gutprop:containedIn <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/62ed1a8b6c448861> ;
                                            rdfs:comment "A non-neoplastic or neoplastic disorder which affects the brain and/or spinal cord. [Definition Source: NCIT]" ,
                                                         "NCIT Match" ;
                                            rdfs:label "Central Nervous System Disorder" .


###  http://purl.obolibrary.org/obo/NCIT_C29393
<http://purl.obolibrary.org/obo/NCIT_C29393> rdf:type owl:NamedIndividual ,
                                                      skos:Concept ,
                                                      gutprop:DietarySupplement ;
                                             skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/DietarySupplement> ;
                                             gutprop:containedIn <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/249b6898670f4986> ;
                                             rdfs:comment "NCIT Match" ,
                                                          "Psyllium [Definition Source: NCIT]" ;
                                             rdfs:label "Psyllium" .


###  http://purl.obolibrary.org/obo/NCIT_C2952
<http://purl.obolibrary.org/obo/NCIT_C2952> rdf:type owl:NamedIndividual ,
                                                     skos:Concept ,
                                                     <https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding> ;
                                            skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/DiseaseDisorderOrFinding> ;
                                            gutprop:containedIn <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/c43ee6a6ee206f5f> ,
                                                                <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/dbdbc8ce6333f81b> ,
                                                                <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/5d81d26d6858ef9f> ;
                                            gutprop:isA <http://purl.obolibrary.org/obo/NCIT_C3138> ,
                                                        <http://purl.obolibrary.org/obo/NCIT_C34510> ;
                                            rdfs:comment "An inflammatory bowel disease involving the mucosal surface of the large intestine and rectum. It may present with an acute or slow onset and follows an intermittent or continuous course. Signs and symptoms include abdominal pain, diarrhea, fever, weight loss, and intestinal hemorrhage. [Definition Source: NCIT]" ,
                                                         "NCIT Match" ;
                                            rdfs:label "Ulcerative Colitis" .


###  http://purl.obolibrary.org/obo/NCIT_C2955
<http://purl.obolibrary.org/obo/NCIT_C2955> rdf:type owl:NamedIndividual ,
                                                     skos:Concept ,
                                                     <https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding> ;
                                            skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/DiseaseDisorderOrFinding> ;
                                            gutprop:containedIn <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/9da15eda078f68c4> ;
                                            rdfs:comment "A malignant epithelial neoplasm that arises from the colon or rectum and invades through the muscularis mucosa into the submucosa.  The vast majority are adenocarcinomas. [Definition Source: NCIT]" ,
                                                         "NCIT Match" ;
                                            rdfs:label "Colorectal Carcinoma" .


###  http://purl.obolibrary.org/obo/NCIT_C2959
<http://purl.obolibrary.org/obo/NCIT_C2959> rdf:type owl:NamedIndividual ,
                                                     skos:Concept ,
                                                     <https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding> ;
                                            skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/DiseaseDisorderOrFinding> ;
                                            gutprop:containedIn <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/e290352a70bff5d9> ;
                                            rdfs:comment "Any disease or disorder that occurs during the course of, or because of, another disease, treatment, or procedure. [Definition Source: NCIT]" ,
                                                         "NCIT Match" ;
                                            rdfs:label "Complication" .


###  http://purl.obolibrary.org/obo/NCIT_C29616
<http://purl.obolibrary.org/obo/NCIT_C29616> rdf:type owl:NamedIndividual ,
                                                      skos:Concept ,
                                                      gutprop:Chemical ;
                                             skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/Chemical> ;
                                             gutprop:containedIn <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/1169fe047a9e51cd> ,
                                                                 <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/289d2dddf0d7f502> ;
                                             gutprop:interact <http://purl.obolibrary.org/obo/CHEBI_52998> ;
                                             rdfs:comment "Fatty acid-binding protein, intestinal (132 aa, ~15 kDa) is encoded by the human FABP2 gene. This protein plays a role in binding to saturated long-chain fatty acids with a high affinity and to unsaturated long-chain fatty acids with less affinity. [Definition Source: NCIT]" ,
                                                          "NCIT Match" ;
                                             rdfs:label "Fatty Acid-Binding Protein, Intestinal" .


###  http://purl.obolibrary.org/obo/NCIT_C2965
<http://purl.obolibrary.org/obo/NCIT_C2965> rdf:type owl:NamedIndividual ,
                                                     skos:Concept ,
                                                     <https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding> ;
                                            skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/DiseaseDisorderOrFinding> ;
                                            gutprop:containedIn <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/21e721c35a5823fd> ,
                                                                <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/72ac0d0cb94cd6c0> ;
                                            gutprop:isA <http://purl.obolibrary.org/obo/NCIT_C3138> ,
                                                        <http://purl.obolibrary.org/obo/NCIT_C34510> ;
                                            rdfs:comment "A gastrointestinal disorder characterized by chronic inflammation involving all layers of the intestinal wall, noncaseating granulomas affecting the intestinal wall and regional lymph nodes, and transmural fibrosis. Crohn disease most commonly involves the terminal ileum; the colon is the second most common site of involvement. [Definition Source: NCIT]" ,
                                                         "NCIT Match" ;
                                            rdfs:label "Crohn Disease" .


###  http://purl.obolibrary.org/obo/NCIT_C2980
<http://purl.obolibrary.org/obo/NCIT_C2980> rdf:type owl:NamedIndividual ,
                                                     skos:Concept ,
                                                     <https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding> ;
                                            skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/DiseaseDisorderOrFinding> ;
                                            gutprop:containedIn <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/9225df7150dd184f> ;
                                            rdfs:comment "A symptom referring to difficulty in swallowing. It may be observed in patients with stroke, motor neuron disorders, cancer of the throat or mouth, head and neck injuries, Parkinson disease, and multiple sclerosis. [Definition Source: NCIT]" ,
                                                         "NCIT Match" ;
                                            rdfs:label "Dysphagia" .


###  http://purl.obolibrary.org/obo/NCIT_C2985
<http://purl.obolibrary.org/obo/NCIT_C2985> rdf:type owl:NamedIndividual ,
                                                     skos:Concept ,
                                                     <https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding> ;
                                            skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/DiseaseDisorderOrFinding> ;
                                            gutprop:containedIn <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/d3e2d2fa788c844a> ;
                                            rdfs:comment "A metabolic disorder characterized by abnormally high blood sugar levels due to diminished production of insulin or insulin resistance/desensitization. [Definition Source: NCIT]" ,
                                                         "NCIT Match" ;
                                            rdfs:label "Diabetes Mellitus" .


