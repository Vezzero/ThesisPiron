                                             gutprop:target <https://w3id.org/hereditary/ontology/gutbrain/resource/human/HumanSubjects> ;
                                             rdfs:comment "An excess of body weight, normally defined as an individual with a body mass index greater than 35 or a body weight greater than one hundred percent of ideal body weight. [Definition Source: NCIT]" ,
                                                          "NCIT Match" ;
                                             rdfs:label "Morbid Obesity" .


###  http://purl.obolibrary.org/obo/NCIT_C34918
<http://purl.obolibrary.org/obo/NCIT_C34918> rdf:type owl:NamedIndividual ,
                                                      skos:Concept ,
                                                      <https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding> ;
