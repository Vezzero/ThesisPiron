###  http://purl.obolibrary.org/obo/NCIT_C35053
<http://purl.obolibrary.org/obo/NCIT_C35053> rdf:type owl:NamedIndividual ,
                                                      skos:Concept ,
                                                      <https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding> ;
                                             skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/DiseaseDisorderOrFinding> ;
                                             gutprop:containedIn <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/b3805932f54c0119> ;
                                             gutprop:target <https://www.ncbi.nlm.nih.gov/mesh/68010361> ;
                                             rdfs:comment "A spontaneous loss of consciousness caused by insufficient blood supply to the brain. [Definition Source: NCIT]" ,
                                                          "NCIT Match" ;
                                             rdfs:label "Syncope" .


###  http://purl.obolibrary.org/obo/NCIT_C35078
<http://purl.obolibrary.org/obo/NCIT_C35078> rdf:type owl:NamedIndividual ,
                                                      skos:Concept ,
                                                      <https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding> ;
                                             skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/DiseaseDisorderOrFinding> ;
                                             gutprop:containedIn <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/cbbd99aab50c7e46> ;
                                             rdfs:comment "A neurologic disorder caused by defective metabolism of the neurotransmitters in the brain. It is characterized by repeated involuntary movements (motor tics) and uncontrollable vocal sounds (vocal tics). The symptoms are usually manifested before the age of eighteen. [Definition Source: NCIT]" ,
                                                          "NCIT Match" ;
                                             rdfs:label "Tourette Syndrome" .


###  http://purl.obolibrary.org/obo/NCIT_C35120
<http://purl.obolibrary.org/obo/NCIT_C35120> rdf:type owl:NamedIndividual ,
                                                      skos:Concept ,
                                                      <https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding> ;
                                             skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/DiseaseDisorderOrFinding> ;
                                             gutprop:containedIn <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/ade98e3941debdb1> ,
                                                                 <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/581c56a9536c4e11> ;
                                             gutprop:target <https://www.ncbi.nlm.nih.gov/mesh/D002648> ,
                                                            <https://www.ncbi.nlm.nih.gov/mesh/68010361> ;
                                             rdfs:comment "An autonomic reflex response to emotional or orthostatic stress, which is characterized by paradoxical hypotension and bradycardia. [Definition Source: NCIT]" ,
                                                          "NCIT Match" ;
                                             rdfs:label "Vasovagal Syncope" .


###  http://purl.obolibrary.org/obo/NCIT_C35241
<http://purl.obolibrary.org/obo/NCIT_C35241> rdf:type owl:NamedIndividual ,
                                                      skos:Concept ,
                                                      <https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding> ;
                                             skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/DiseaseDisorderOrFinding> ;
                                             gutprop:containedIn <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/f319c339db1cf333> ,
                                                                 <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/9b7564fb0822cffc> ;
                                             gutprop:target <http://purl.obolibrary.org/obo/NCIT_C45247> ;
                                             rdfs:comment "Damage to liver structure or function due to trauma or toxicity. [Definition Source: NCIT]" ,
                                                          "NCIT Match" ;
                                             rdfs:label "Injury To Liver" .


###  http://purl.obolibrary.org/obo/NCIT_C35286
<http://purl.obolibrary.org/obo/NCIT_C35286> rdf:type owl:NamedIndividual ,
                                                      skos:Concept ,
                                                      <https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding> ;
                                             skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/DiseaseDisorderOrFinding> ;
                                             gutprop:containedIn <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/d4fe6b159a2e34b0> ;
                                             rdfs:comment "A bacterial infection of the colon secondary to infection with Clostridium difficile bacteria. This infection generally results from the loss of normal gut flora secondary to recent antibiotic use, and manifests as copious watery stools, with associated abdominal pain and myalgia. C. difficile is the most common cause of pseudomembranous colitis, and can progress to toxic megacolon if left untreated. [Definition Source: NCIT]" ,
                                                          "NCIT Match" ;
                                             rdfs:label "Clostridium Difficile Colitis" .


###  http://purl.obolibrary.org/obo/NCIT_C35526
<http://purl.obolibrary.org/obo/NCIT_C35526> rdf:type owl:NamedIndividual ,
                                                      skos:Concept ,
                                                      <https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding> ;
                                             skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/DiseaseDisorderOrFinding> ;
                                             gutprop:affect <http://purl.obolibrary.org/obo/NCIT_C26696> ,
                                                            <https://w3id.org/hereditary/ontology/gutbrain/resource/diseasedisorderorfinding/AlteredIntestinalMicrobiome> ;
                                             gutprop:containedIn <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/cb8a6468241cf265> ,
                                                                 <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/6a6ea60581723c32> ;
                                             gutprop:target <https://uts.nlm.nih.gov/uts/umls/concept/C0237401> ,
                                                            <https://www.ncbi.nlm.nih.gov/mesh/68010361> ;
                                             rdfs:comment "Insomnia that has persisted at least one month. [Definition Source: NCIT]" ,
                                                          "NCIT Match" ;
                                             rdfs:label "Chronic Insomnia" .


###  http://purl.obolibrary.org/obo/NCIT_C35542
<http://purl.obolibrary.org/obo/NCIT_C35542> rdf:type owl:NamedIndividual ,
