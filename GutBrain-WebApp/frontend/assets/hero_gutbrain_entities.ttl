                                             gutprop:containedIn <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/661cfe3190d2540c> ;
                                             rdfs:comment "An inflammatory disorder that affects the upper and lower gastrointestinal tract. Most commonly, this is attributed to viruses; however bacteria, parasites or adverse reactions can also be the culprit. Symptoms include acute diarrhea and vomiting. [Definition Source: NCIT]" ,
                                                          "NCIT Match" ;
                                             rdfs:label "Gastroenteritis" .


###  http://purl.obolibrary.org/obo/NCIT_C34646
<http://purl.obolibrary.org/obo/NCIT_C34646> rdf:type owl:NamedIndividual ,
