###  http://purl.obolibrary.org/obo/NCIT_C38038
<http://purl.obolibrary.org/obo/NCIT_C38038> rdf:type owl:NamedIndividual ,
                                                      skos:Concept ,
                                                      <https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding> ;
