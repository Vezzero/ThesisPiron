    <AnnotationAssertion>
        <AnnotationProperty IRI="http://purl.org/dc/terms/creator"/>
        <IRI>http://edamontology.org/topic_3837</IRI>
        <Literal>Samuel Piron</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>http://edamontology.org/topic_3837</IRI>
        <Literal>Shotgun metagenomic sequencing is a high-throughput DNA sequencing technique that involves randomly fragmenting and reassembling the genetic material from a microbial community to reconstruct its genomic content. [Definition Source: llama3-8b-8192]</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://edamontology.org/topic_3837</IRI>
        <Literal>Shotgun Metagenomic Sequencing</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://purl.org/dc/terms/creator"/>
        <IRI>http://prgdb.org/prgdb4/genes/type/putative/3183135</IRI>
        <Literal>Samuel Piron</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>http://prgdb.org/prgdb4/genes/type/putative/3183135</IRI>
        <Literal>Nycol_K01667 is a protein-coding gene that encodes a protein involved in the regulation of cell growth and differentiation, specifically in the context of cancer development and progression. [Definition Source: llama3-8b-8192]</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://prgdb.org/prgdb4/genes/type/putative/3183135</IRI>
