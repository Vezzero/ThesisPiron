    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>http://purl.obolibrary.org/obo/NCIT_C12470</IRI>
        <Literal>NCIT Match</Literal>
    </AnnotationAssertion>
