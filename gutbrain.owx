    <Annotation>
        <AnnotationProperty IRI="http://purl.org/dc/terms/description"/>
        <Literal xml:lang="en">The Hereditary ontology models phenoclinical, genomics and scientific aspects of the gut-brain axis to provide a unifying layer to query different database sources through an Ontology-Based Data Access (OBDA) framework. This part of the ontology focuses on gut-brain data.</Literal>
    </Annotation>
    <Annotation>
