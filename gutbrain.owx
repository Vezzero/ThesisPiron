    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>https://hereditary.dei.unipd.it/ontology/gutbrain/resource/microbiome/GutMicrobialEcosystem</IRI>
        <Literal>The gut microbial ecosystem refers to the complex community of microorganisms, including bacteria, viruses, fungi, and protozoa, that inhabit the gastrointestinal tract and interact with the host to maintain homeostasis and modulate various physiological processes. [Definition Source: llama3-8b-8192]</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>https://hereditary.dei.unipd.it/ontology/gutbrain/resource/microbiome/GutMicrobialEcosystem</IRI>
