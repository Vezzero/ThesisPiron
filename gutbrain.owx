    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>https://hereditary.dei.unipd.it/ontology/gutbrain/resource/microbiome/GutMicrobial</IRI>
        <Literal>The entity &quot;gut_microbial&quot; refers to the collective community of microorganisms, including bacteria, viruses, fungi, and protozoa, that inhabit the gastrointestinal tract and play a crucial role in human health and disease. [Definition Source: llama3-8b-8192]</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
