    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>http://purl.obolibrary.org/obo/NCIT_C3201</IRI>
        <Literal>An autoimmune multi-organ disease typically associated with vasculopathy and autoantibody production. Most patients have antinuclear antibodies (ANA). The presence of anti-dsDNA or anti-Smith antibodies are highly-specific. [Definition Source: NCIT]</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>http://purl.obolibrary.org/obo/NCIT_C3201</IRI>
        <Literal>NCIT Match</Literal>
    </AnnotationAssertion>
