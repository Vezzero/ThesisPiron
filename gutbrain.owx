    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>/Animal</IRI>
        <Literal xml:lang="en">A non-human living organism that has membranous cell walls, requires oxygen and organic foods, and is capable of voluntary movement, as distinguished from a plant or mineral. [Definition Source: NCI]</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>/Animal</IRI>
        <Literal xml:lang="en">Animal</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#exactMatch"/>
        <IRI>/Animal</IRI>
        <Literal>http://purl.obolibrary.org/obo/NCIT_C14182</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>/BiomedicalTechnique</IRI>
        <Literal xml:lang="en">Research concerned with the application of biological and physiological principles to clinical medicine. [Definition Source: NCI]</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>/BiomedicalTechnique</IRI>
        <Literal xml:lang="en">Biomedical Technique</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#exactMatch"/>
        <IRI>/BiomedicalTechnique</IRI>
        <Literal>http://purl.obolibrary.org/obo/NCIT_C15188</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>/Chemical</IRI>
        <Literal xml:lang="en">A chemical substance is a portion of matter of constant composition, composed of molecular entities of the same type or of different types. [Definition Source: CHEBI]</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>/Chemical</IRI>
        <Literal xml:lang="en">Chemical</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#exactMatch"/>
        <IRI>/Chemical</IRI>
        <Literal>http://purl.obolibrary.org/obo/CHEBI_59999</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>/Class</IRI>
        <Literal xml:lang="en">A collection of taxonomic subdivisions directly under Phylum. It is a major group of organisms, e.g. Mammalia, Reptilia, Gastropoda, Insecta, etc that contains a large number of different sublineages, but have shared characteristics in common (e.g. warm-blooded, fur, six legs etc). [Definition Source: NCI]</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>/Class</IRI>
        <Literal xml:lang="en">Class</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#exactMatch"/>
        <IRI>/Class</IRI>
        <Literal>http://purl.obolibrary.org/obo/NCIT_C45280</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>/DietarySupplement</IRI>
        <Literal xml:lang="en">Products in capsule, tablet or liquid form that provide dietary ingredients, and that are intended to be taken by mouth to increase the intake of nutrients. Dietary supplements can include macronutrients, such as proteins, carbohydrates, and fats; and/or MICRONUTRIENTS, such as VITAMINS; MINERALS; and PHYTOCHEMICALS. [Definition Source: MeSH]</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>/DietarySupplement</IRI>
        <Literal xml:lang="en">Dietary Supplement</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#exactMatch"/>
        <IRI>/DietarySupplement</IRI>
        <Literal>https://www.ncbi.nlm.nih.gov/mesh/68019587</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>/Domain</IRI>
        <Literal xml:lang="en">A taxonomic category above that of Kingdom.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>/Domain</IRI>
        <Literal xml:lang="en">Domain</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#exactMatch"/>
        <IRI>/Domain</IRI>
        <Literal>http://purl.obolibrary.org/obo/NCIT_C62706</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>/Drug</IRI>
        <Literal xml:lang="en">Any substance which when absorbed into a living organism may modify one or more of its functions. The term is generally accepted for a substance taken for a therapeutic purpose, but is also commonly used for abused substances. [Definition Source: CHEBI]</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>/Drug</IRI>
        <Literal xml:lang="en">Drug</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#exactMatch"/>
        <IRI>/Drug</IRI>
        <Literal>http://purl.obolibrary.org/obo/CHEBI_23888</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>/ExperimentalResult</IRI>
        <Literal xml:lang="en">The outcome of an experiment or set of experiments, including observations and primary, processed, and analyzed data. [Definition Source: NCI]</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>/ExperimentalResult</IRI>
        <Literal xml:lang="en">Experimental Result</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#exactMatch"/>
        <IRI>/ExperimentalResult</IRI>
        <Literal>http://purl.obolibrary.org/obo/NCIT_C76125</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>/Family</IRI>
        <Literal xml:lang="en">A taxonomic category between Order and Genus. It consists of a group of organisms among which the differences are quite minor, e.g. Equiidae - horses and their relatives. [Definition Source: NCI]</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>/Family</IRI>
        <Literal xml:lang="en">Family</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#exactMatch"/>
        <IRI>/Family</IRI>
        <Literal>http://purl.obolibrary.org/obo/NCIT_C45290</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>/Food</IRI>
        <Literal xml:lang="en">A functional unit of heredity which occupies a specific position on a particular chromosome and serves as the template for a product that contributes to a phenotype or a biological function. [Definition Source: SNOMEDCT]</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>/Food</IRI>
        <Literal xml:lang="en">Food</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#exactMatch"/>
        <IRI>/Food</IRI>
        <Literal>http://purl.bioontology.org/ontology/SNOMEDCT/67271001</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>/Genome</IRI>
        <Literal xml:lang="en">The genetic complement of an organism, including all of its GENES, as represented in its DNA, or in some cases, its RNA. [Definition Source: MeSH]</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>/Genome</IRI>
        <Literal xml:lang="en">Genome</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#exactMatch"/>
        <IRI>/Genome</IRI>
        <Literal>https://www.ncbi.nlm.nih.gov/mesh/68016678</Literal>
