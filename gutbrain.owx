    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>http://purl.obolibrary.org/obo/CHEBI_145810</IRI>
        <Literal>Insulin is a polypeptide hormone produced by the pancreas that regulates blood sugar levels by facilitating glucose uptake in cells. [Definition Source: llama3-8b-8192]</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
