        <Literal>Samuel Piron</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>https://hereditary.dei.unipd.it/ontology/gutbrain/resource/microbiome/InterventionsRegulatingIntestinalFlora</IRI>
        <Literal>&quot;Interventions_regulating_intestinal_flora&quot; refers to therapeutic approaches or treatments that aim to modulate or alter the composition and function of the intestinal microbiome. [Definition Source: llama3-8b-8192]</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
