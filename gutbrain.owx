        <IRI>http://purl.obolibrary.org/obo/NCIT_C12441</IRI>
        <Literal>Three sections, the midbrain, pons and medulla oblongata, that are located at the base of the brain. The brain stem regulates the central nervous system, and is vital as a conduit for motor and sensory innervations. [Definition Source: NCIT]</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://purl.obolibrary.org/obo/NCIT_C12441</IRI>
        <Literal>Brain Stem</Literal>
    </AnnotationAssertion>
