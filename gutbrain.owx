    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>http://purl.obolibrary.org/obo/CHEBI_14314</IRI>
        <Literal>Glucose-1-phosphate is an organic compound that is a phosphorylated derivative of glucose, specifically a key intermediate in glycolysis and glycogen synthesis. [Definition Source: llama3-8b-8192]</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://purl.obolibrary.org/obo/CHEBI_14314</IRI>
        <Literal>D-Glucose 6-Phosphate</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>http://purl.obolibrary.org/obo/CHEBI_145540</IRI>
        <Literal>Adenosine triphosphate (ATP) is a nucleotide that serves as the primary energy currency of the cell, providing energy for various cellular processes through its hydrolysis into adenosine diphosphate (ADP) and inorganic phosphate. [Definition Source: llama3-8b-8192]</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
