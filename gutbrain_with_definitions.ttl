        gutprop:BiomedicalTechnique ;
    rdfs:label "Voluntary Sampling" ;
    rdfs:comment "STATO Match",
        "Voluntary wheel running refers to a type of exercise or behavior in which an animal, typically a rodent, runs voluntarily on a wheel or other rotating device for physical activity and mental stimulation. [Definition Source: llama3-8b-8192]" ;
    skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/BiomedicalTechnique> ;
