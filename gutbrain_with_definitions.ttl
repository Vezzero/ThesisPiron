<https://w3id.org/hereditary/ontology/gutbrain/resource/statisticaltechnique/BrayCurtisDissimilarity> a owl:NamedIndividual,
        skos:Concept,
        gutprop:StatisticalTechnique ;
    rdfs:label "Bray Curtis Dissimilarity" ;
    dcterms:creator "Samuel Piron" ;
    rdfs:comment "The Bray-Curtis dissimilarity is a measure of dissimilarity between two samples in ecology and microbiology, calculated as half the absolute difference between the two samples' abundance profiles. [Definition Source: llama3-8b-8192]" ;
    skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/StatisticalTechnique> ;
    gutprop:containedIn <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/c026aa830054c766> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/statisticaltechnique/Chao1Index> a owl:NamedIndividual,
        skos:Concept,
        gutprop:StatisticalTechnique ;
    rdfs:label "Chao1 Index" ;
    dcterms:creator "Samuel Piron" ;
    rdfs:comment "The \"chao1_index\" is a measure of alpha diversity that estimates the number of unique species in a community, taking into account the relative abundance of each species. [Definition Source: llama3-8b-8192]" ;
    skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/StatisticalTechnique> ;
    gutprop:containedIn <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/a5f9fa57add4ab46>,
