    rdfs:comment "C57BL/6N Mouse [Definition Source: NCIT]",
        "NCIT Match" ;
    skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/Animal> ;
    gutprop:containedIn <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/3351ca1642aa7ba4>,
