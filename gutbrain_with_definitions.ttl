<http://purl.obolibrary.org/obo/NCIT_C12444> a owl:NamedIndividual,
        skos:Concept,
        <https://w3id.org/brainteaser/ontology/schema/AnatomicalSite> ;
    rdfs:label "Hippocampus" ;
    rdfs:comment "A curved gray matter structure of the temporal lobe lying on the floor of the lateral ventricle of the brain. [Definition Source: NCIT]",
        "NCIT Match" ;
    skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/AnatomicSite> ;
    gutprop:containedIn <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/521e146ab8d7e37a> ;
