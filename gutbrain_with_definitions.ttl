        gutprop:BiomedicalTechnique ;
    rdfs:label "Mitbamp Analyses" ;
    dcterms:creator "Samuel Piron" ;
    rdfs:comment "Mitbamp_analyses refers to a type of bioinformatics analysis that uses the MitBAMP algorithm to identify and characterize membrane-associated proteins in a given biological sample. [Definition Source: llama3-8b-8192]" ;
    skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/BiomedicalTechnique> ;
