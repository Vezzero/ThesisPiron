        gutprop:BiomedicalTechnique ;
    rdfs:label "Legend Plex Kit" ;
    dcterms:creator "Samuel Piron" ;
    rdfs:comment "A legend plex kit is a type of laboratory reagent kit that contains a set of antibodies or probes that are used to detect and quantify multiple analytes or biomarkers in a single assay. [Definition Source: llama3-8b-8192]" ;
    skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/BiomedicalTechnique> ;
