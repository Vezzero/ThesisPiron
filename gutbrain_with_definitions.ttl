<https://w3id.org/hereditary/ontology/gutbrain/resource/biomedicaltechnique/SerumMetabolomicsProfiling> a owl:NamedIndividual,
        skos:Concept,
        gutprop:BiomedicalTechnique ;
    rdfs:label "Serum Metabolomics Profiling" ;
    dcterms:creator "Samuel Piron" ;
    rdfs:comment "Serum_metabolomics_profiling refers to the comprehensive analysis of small molecules, such as metabolites, in serum samples to identify and quantify their concentrations, providing insights into physiological and pathological processes. [Definition Source: llama3-8b-8192]" ;
    skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/BiomedicalTechnique> ;
