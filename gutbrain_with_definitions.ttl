    gutprop:hasSentenceText "Species: <i>Bilophila wadsworthia</i> of the Phylum: Thermodesulfobacteriota, was identified." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37368331> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37368331_26> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37368331_26" ;
    gutprop:hasSentenceText "Only one Genus: <i>Prevotella</i> of the Phylum: Bacteroidetes was decreased." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37368331> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37368331_28> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37368331_28" ;
    gutprop:hasSentenceText "Phylum: Verrucomicrobiota and its Genus: <i>Akkermansia</i>; 2." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37368331> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37368331_3> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37368331_3" ;
    gutprop:hasSentenceText "This systematic review aims to gather existing data on the occidental hemisphere, compare it, and search for any significant association between Parkinson's disease and gut microbiota dysbiosis." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37368331> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37368331_37> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37368331_37" ;
    gutprop:hasSentenceText "Genus: <i>Ruminococcus</i> of the Phylum: Firmicutes, was described." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37368331> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37368331_6> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37368331_6" ;
    gutprop:hasSentenceText "Of the 166 studies found, only 10 were used, as they met our inclusion criteria: case-control studies, studies that assessed the correlation of PD and gut microbiome, studies that took place in occidental regions, and studies that were performed on humans and were written in English." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37368331> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37371676_1> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37371676_1" ;
    gutprop:hasSentenceText "Autoimmune (AI) diseases, which present in a multitude of systemic manifestations, have been connected to many underlying factors." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37371676> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37371676_12> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37371676_12" ;
    gutprop:hasSentenceText "Additionally, we plan to show that diet alterations can promote beneficial changes in the gut microbiota, supporting the body's own endogenous processes to decrease inflammation and increase healing." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37371676> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37371676_3> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37371676_3" ;
    gutprop:hasSentenceText "An individual's gut microbiota is an integral aspect of human functioning, as it is intimately integrated into the metabolic, mechanical, immunological, and neurologic pathways of the body." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37371676> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37371676_5> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37371676_5" ;
    gutprop:hasSentenceText "While the gut microbiome is ever-adaptive, gut dysbiosis can exert a significant influence on physical and mental health." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37371676> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37371676_9> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37371676_9" ;
    gutprop:hasSentenceText "This review aims to define the mechanisms of microbiome crosstalk between the cells of bone and cartilage, as well as to investigate the potential bidirectional connections between AI, bony and cartilaginous tissue, and the gut microbiome." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37371676> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37377497_11> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37377497_11" ;
    gutprop:hasSentenceText "Overall, scientific exploration of triphala polyphenols is warranted to understand their therapeutic efficacy." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37377497> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37377497_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37377497_2" ;
    gutprop:hasSentenceText "Particularly, there is ample evidence that overexposure to mental stress can have lasting detrimental consequences for psychological health, cognitive function, and ultimately well-being." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37377497> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37377497_5> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37377497_5" ;
    gutprop:hasSentenceText "A potential therapeutic strategy for maintaining a healthy life is to address stress-induced health problems with botanicals or dietary supplements such as polyphenols." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37377497> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37377497_6> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37377497_6" ;
    gutprop:hasSentenceText "Triphala, also known as Zhe Busong decoction in Tibetan, is a well-recognized <i>Ayurvedic</i> polyherbal medicine comprising dried fruits from three different plant species." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37377497> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37377497_7> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37377497_7" ;
    gutprop:hasSentenceText "As a promising food-sourced phytotherapy, triphala polyphenols have been used throughout history to treat a variety of medical conditions, including brain health maintenance." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37377497> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37377497_9> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37377497_9" ;
    gutprop:hasSentenceText "Here, the primary objective of this review article is to provide an overview of the classification, safety, and pharmacokinetics of triphala polyphenols, as well as recommendations for the development of triphala polyphenols as a novel therapeutic strategy for promoting resilience in susceptible individuals." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37377497> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37396336_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37396336_0" ;
    gutprop:hasSentenceText "Sex-specific effects of voluntary wheel running on behavior and the gut microbiota-immune-brain axis in mice." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/37396336> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37396336_4> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37396336_4" ;
    gutprop:hasSentenceText "Male and female C57BL/6N mice had voluntary access to running wheels in their home-cages for 24 days or were left undisturbed in identical home-cages without running wheels." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37396336> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37400971_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37400971_0" ;
    gutprop:hasSentenceText "Maternal microbiome disturbance induces deficits in the offspring's behaviors: a systematic review and meta-analysis." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/37400971> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37400971_1> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37400971_1" ;
    gutprop:hasSentenceText "Recent evidence has suggested that changes in maternal gut microbiota in early life may generate neurobiological consequences associated with psychiatric-related abnormalities." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37400971> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37400971_4> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37400971_4" ;
    gutprop:hasSentenceText "We found thirteen studies, from a set of 459 records selected by strategy registered on PROSPERO (#289224), to target preclinical studies that evaluated the behavioral outcomes of the rodents generated by dams submitted to perinatal enteric microbiota perturbation." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37400971> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37400971_6> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37400971_6" ;
    gutprop:hasSentenceText "The MMD also induces a significant effect size for the reduction of the sociability behavior (SMD = -0.63, 95% CI = -1.18 to -0.07, <i>p</i> = 0.011, T2 = 0.30, I2 = 76.11%) and obsessive-compulsive-like behavior (SMD = -0.68, 95% CI = -0.01 to -1.36, <i>p</i> = 0.009, T2 = 0.25, I2 = 62.82%) parameters." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37400971> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37403161_12> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37403161_12" ;
    gutprop:hasSentenceText "Additionally, the SNCA gene overexpression resulted in gut α-Syn protein expression and increased with advanced age." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37403161> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37403161_7> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37403161_7" ;
    gutprop:hasSentenceText "LC-MS/MS was used for characterization of proteins from metabolite treated neuronal cells." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37403161> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37449597_4> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37449597_4" ;
    gutprop:hasSentenceText "Preclinical and clinical studies have shown the important role played by the gut microbiome and gut-related factors in disease development and progression, as well as treatment responses." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37449597> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37464164_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37464164_0" ;
    gutprop:hasSentenceText "Gastrointestinal and Microbiome Profiling in Rodent Models of Neurological and Psychiatric Disorders." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/37464164> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37468912_11> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37468912_11" ;
    gutprop:hasSentenceText "We clarified a differed BA metabolic phenotype in IBS patients with LDSD, which closely correlates with the severity of bowel symptoms." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37468912> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37468912_5> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37468912_5" ;
    gutprop:hasSentenceText "Patients with IBS-D completed questionnaires regarding the irritable bowel severity scoring system (IBS-SSS), stool frequency, Stool Bristol scale, and Self-Rating Scales of mental health." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37468912> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37469436_1> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37469436_1" ;
    gutprop:hasSentenceText "Psychobiotics are a class of probiotics that confer beneficial effects on the mental health of the host." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37469436> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37469436_4> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37469436_4" ;
    gutprop:hasSentenceText "GR1009, isolated from the same source of PS150, and found that GR1009 is phenotypically distinct but genetically similar to PS150." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37469436> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37481569_1> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37481569_1" ;
    gutprop:hasSentenceText "Recently, an important relationship between Parkinson's disease and the gut microbiota, through the brain-gut axis interactions, has been established." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37481569> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37481569_12> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37481569_12" ;
    gutprop:hasSentenceText "Furthermore, when comparing tremors and non-tremors predominant phenotypes; Lactobacilli showed a significant decrease in non-tremors predominant phenotypes." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37481569> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37481569_14> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37481569_14" ;
    gutprop:hasSentenceText "These observations may highlight the importance of the identification of microbiome and specific bacterial changes that can be targeted for the treatment of Parkinson's disease." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37481569> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37481569_3> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37481569_3" ;
    gutprop:hasSentenceText "The present study aimed to identify the gut microbiome that is likely related to Parkinson's disease as well as their possible relation to clinical phenotypes." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37481569> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37481569_4> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37481569_4" ;
    gutprop:hasSentenceText "Thirty patients with Parkinson's disease, who presented to the Parkinson's disease Neurology Clinic of Alexandria University Hospital were enrolled in our study." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37481569> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37485386_1> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37485386_1" ;
    gutprop:hasSentenceText "Depression, a mood disorder characterized by persistent feelings of sadness and aversion to activity that can interfere with daily life, is a condition of great concern." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37485386> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37502424_1> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37502424_1" ;
    gutprop:hasSentenceText "This study presents results of our randomized clinical trial studying the effect of human probiotics on memory and psychological and physical measures following our study protocol registered at clinicaltrials.gov NCT05051501 and described in detail in our previous paper." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37502424> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37502424_10> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37502424_10" ;
    gutprop:hasSentenceText "At follow-up visits after 3, 6, and 8  months, no cross-sectional differences in any of the measures were found between the groups except worse sentence recall of the ALBA test after 3  months of probiotic use." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37502424> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37502424_3> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37502424_3" ;
    gutprop:hasSentenceText "A cross-over design allowed each group to receive probiotics and placebo for 3  months each in reverse order." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37502424> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37502424_6> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37502424_6" ;
    gutprop:hasSentenceText "Primary outcome measures included changes in cognitive functions assessed using brief tests and a neuropsychological battery and changes in mood assessed using validated questionnaires." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37502424> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37511699_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37511699_2" ;
    gutprop:hasSentenceText "Studies of gut microbiota effects on functional and behavioral effects of antidepressants in human and animal models were identified from PubMed up to December 2022." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37511699> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37511699_5> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37511699_5" ;
    gutprop:hasSentenceText "The reviewed papers converged on three themes: (1) Antidepressants can alter the composition and metabolites of gut microbiota, (2) gut microbiota can alter the bioavailability of certain antidepressants, and (3) gut microbiota may modulate the clinical or modeled mood modifying effects of antidepressants." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37511699> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37511699_7> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37511699_7" ;
    gutprop:hasSentenceText "While strong evidence is still lacking to understand the clinical role of antidepressant PMx in human health, there is evidence for interactions among antidepressants, microbiota changes, microbiota metabolite changes, and behavior." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37511699> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37571393_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37571393_0" ;
    gutprop:hasSentenceText "Underlying Mechanisms of Brain Aging and Neurodegenerative Diseases as Potential Targets for Preventive or Therapeutic Strategies Using Phytochemicals." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/37571393> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37574818_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37574818_2" ;
    gutprop:hasSentenceText "Probiotics are extensively employed in dermatology and could be an alternative option for acne therapy." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37574818> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37576972_1> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37576972_1" ;
    gutprop:hasSentenceText "It is widely thought that the intestinal microbiota plays a significant role in the pathogenesis of metabolic disorders." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37576972> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37576972_10> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37576972_10" ;
    gutprop:hasSentenceText "In addition, a significant correlation was observed between the metabolic-related parameters and abundance of altered microbiota including HDL-c (r2 = 0.203, p=0.0005), GLU (r2 = 0.286, p=0.0005) and WC (r2 = 0.061, p=0.037)." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37576972> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37576972_6> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37576972_6" ;
    gutprop:hasSentenceText "In addition, the Phylogenetic Investigation of Communities by Reconstruction of Unobserved States (PICRUSt) based on the KEGG database was used to predict the function of intestinal microbiota." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37576972> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37606895_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37606895_0" ;
    gutprop:hasSentenceText "Gastrointestinal involvement in post-acute Coronavirus disease (COVID)-19 syndrome." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/37606895> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37607587_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37607587_0" ;
    gutprop:hasSentenceText "Gastrointestinal Dysfunction in Neurological and Neurodegenerative Disorders." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/37607587> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37607587_1> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37607587_1" ;
    gutprop:hasSentenceText "Increasing research links the gut microbiome to neurodegenerative disorders." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37607587> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37607587_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37607587_2" ;
    gutprop:hasSentenceText "The gut microbiome communicates with the central nervous system via the gut-brain axis and affects behavioral and cognitive phenotypes." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37607587> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37607587_6> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37607587_6" ;
    gutprop:hasSentenceText "We also discuss strategies to improve the gut microbiome and ultimately brain function." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37607587> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37624502_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37624502_0" ;
    gutprop:hasSentenceText "The association between greenery type and gut microbiome in schizophrenia: did all greenspaces play the equivalent role?" ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/37624502> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37624502_13> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37624502_13" ;
    gutprop:hasSentenceText "Among them, tree coverage was positively associated with increased Bifidobacterium longum (β = 1.069, P = 0.004), which was the dominant composition in the gut microbiota." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37624502> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37624502_14> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37624502_14" ;
    gutprop:hasSentenceText "The relationship between greenspace and gut microbiome in SCZ differed by the type of greenspace." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37624502> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37624502_3> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37624502_3" ;
    gutprop:hasSentenceText "However, the effects of greenspaces on the gut microbiota in SCZ and the effect of different types of greenspaces on the gut microbiota remain unclear." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37624502> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37624502_4> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37624502_4" ;
    gutprop:hasSentenceText "We aim to examine if there were variations in the effects of various greenspace types on the gut microbiome in SCZ." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37624502> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37624502_6> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37624502_6" ;
    gutprop:hasSentenceText "We recruited 243 objects with schizophrenia from Anhui Mental Health Center and collected fecal samples for 16Sr RNA gene sequencing." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37624502> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37624502_8> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37624502_8" ;
    gutprop:hasSentenceText "The association between greenspace and microbiome composition was analyzed with permutational analysis of variance (PERMANOVA)." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37624502> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37624502_9> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37624502_9" ;
    gutprop:hasSentenceText "We conducted the linear regression to capture specific gut microbiome taxa associated with greenery coverage." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37624502> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37655441_3> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37655441_3" ;
    gutprop:hasSentenceText "<i>P. copri</i> in human health, and on the effect of different diets on its relative abundance in the gut microbiome." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37655441> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37657622_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37657622_0" ;
    gutprop:hasSentenceText "Strain-level structure of gut microbiome showed potential association with cognitive function in major depressive disorder: A pilot study." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/37657622> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37657622_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37657622_2" ;
    gutprop:hasSentenceText "In this study, we explored the association between gut microbiota and cognitive function in MDD and its possible mechanisms." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37657622> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37657622_9> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37657622_9" ;
    gutprop:hasSentenceText "Based on our strain-level analysis, we found that gut microbiota may be associated with the pathogenesis of MDD and may have potential effects on cognitive function." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37657622> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37676767_7> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37676767_7" ;
    gutprop:hasSentenceText "We find that diet and bacterial curli alter the microbiome and exacerbate motor performance, as well as intestinal and brain pathologies, but to different extents." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37676767> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37764088_7> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37764088_7" ;
    gutprop:hasSentenceText "Therefore, in this study, we examined 257 children aged 3-4 to investigate links between GM and risk to EF." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37764088> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37764277_7> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37764277_7" ;
    gutprop:hasSentenceText "This review comprehensively summarizes the regulatory role of baicalin in gut-brain axis disorders, laying a foundation for future research, although further confirmatory basic research is required." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37764277> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37834373_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37834373_0" ;
    gutprop:hasSentenceText "Impact of Microbiome-Brain Communication on Neuroinflammation and Neurodegeneration." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/37834373> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37841274_1> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37841274_1" ;
    gutprop:hasSentenceText "Melanin, a ubiquitous dark pigment, plays important roles in the immune system, including scavenging reactive oxygen species formed in response to ultraviolet radiation absorption, absorbing metals, thermal regulation, drug uptake, innate immune system functions, redox, and energy transduction." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37841274> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37841274_7> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37841274_7" ;
    gutprop:hasSentenceText "We theorize that under normal healthy states, melanin retains some of the energy it absorbs from electromagnetic radiation, which is then used to fuel cells, and energy from ATP is used to compliment that energy supply." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37841274> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37841274_9> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37841274_9" ;
    gutprop:hasSentenceText "In addition, in an attempt to explain why removing these plaques does not result in improvements in cognition and mood and why cognitions and moods in these individuals have ebbs and flows, we postulate that it is not the plaques that cause the cognitive symptoms but, rather, inflammation in the brain resulting from the immune system's response to pathogens." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37841274> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37845499_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37845499_0" ;
    gutprop:hasSentenceText "Emerging role of the host microbiome in neuropsychiatric disorders: overview and future directions." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/37845499> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37845499_1> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37845499_1" ;
    gutprop:hasSentenceText "The human body harbors a diverse ecosystem of microorganisms, including bacteria, viruses, and fungi, collectively known as the microbiota." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37845499> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37845499_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37845499_2" ;
    gutprop:hasSentenceText "Current research is increasingly focusing on the potential association between the microbiota and various neuropsychiatric disorders." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37845499> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37845499_5> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37845499_5" ;
    gutprop:hasSentenceText "However, the microbiota presents in other body tissues, though less abundant, also plays crucial role in immune system and human homeostasis, thus influencing the development and progression of neuropsychiatric disorders." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37845499> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37849234_8> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37849234_8" ;
    gutprop:hasSentenceText "As hippocampal neurogenesis cannot be measured in living humans but is modulated by the circulatory systemic environment, we assessed the impact of the Alzheimer's systemic environment on proxy neurogenesis readouts." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37849234> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37849234_9> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37849234_9" ;
    gutprop:hasSentenceText "Serum from Alzheimer's patients decreased neurogenesis in human cells in vitro and were associated with cognitive scores and key microbial genera." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37849234> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37881577_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37881577_0" ;
    gutprop:hasSentenceText "Repeated Social Defeat Stress Induces an Inflammatory Gut Milieu by Altering the Mucosal Barrier Integrity and Gut Microbiota Homeostasis." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/37881577> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37881577_1> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37881577_1" ;
    gutprop:hasSentenceText "Posttraumatic stress disorder (PTSD) is a mental health condition triggered by exposure to traumatic events in an individual's life." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37881577> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37881577_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37881577_2" ;
    gutprop:hasSentenceText "Patients with PTSD are also at a higher risk for comorbidities." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37881577> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37900921_9> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37900921_9" ;
    gutprop:hasSentenceText "We argue that the penetrative ability of 4EP is dependent on its form at the BBB and its physicochemical similarity to endogenous metabolites with dedicated active transport mechanisms across the BBB." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37900921> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37927130_5> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37927130_5" ;
    gutprop:hasSentenceText "Here, we investigated whether F4 exerted therapeutic effects on depressive-like behavior by influencing the central nervous system." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37927130> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37960197_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37960197_0" ;
    gutprop:hasSentenceText "Causality Investigation between Gut Microbiota, Derived Metabolites, and Obstructive Sleep Apnea: A Bidirectional Mendelian Randomization Study." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/37960197> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37960197_10> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37960197_10" ;
    gutprop:hasSentenceText "Moreover, the reverse MR analysis demonstrated a suggestive association between OSA exposure and six microbiota taxa." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37960197> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37960197_11> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37960197_11" ;
    gutprop:hasSentenceText "This study offers compelling evidence regarding the potential beneficial or detrimental causative impact of the gut microbiota and its associated metabolites on OSA risk, thereby providing new insights into the mechanisms of gut microbiome-mediated OSA development." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37960197> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37960197_4> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37960197_4" ;
    gutprop:hasSentenceText "Two-sample MR was used to assess the potential association, and causality was evaluated using inverse variance weighted (IVW), MR-Egger, and weighted median (WM) methods." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37960197> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37978477_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37978477_0" ;
    gutprop:hasSentenceText "Intricate role of intestinal microbe and metabolite in schizophrenia." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/37978477> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37978477_7> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37978477_7" ;
    gutprop:hasSentenceText "Compared with healthy controls, 145 unusual microflora metabolites were detected in the acute and remission groups, which were mainly involved in environmental information processing, metabolism, organismal systems, and human diseases in the Kyoto encyclopedia of genes and genomes pathway." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37978477> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37978477_8> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37978477_8" ;
    gutprop:hasSentenceText "The Sankey diagram showed that 4 abnormal intestinal and 4 anomalous intestinal microbial metabolites were associated with psychiatric clinical symptoms." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37978477> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37995075_10> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37995075_10" ;
    gutprop:hasSentenceText "Intriguingly, genes correlated with the gut microbiota were found to be significantly enriched in pathways of neurodegenerative diseases and the immune system, suggesting that changes in the microbiota may have a systemic impact on the expression of neurodegenerative diseases and immune genes." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37995075> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37995475_1> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37995475_1" ;
    gutprop:hasSentenceText "Investigating the gut microbiota in central hypersomnolence disorders." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37995475> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37995475_8> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37995475_8" ;
    gutprop:hasSentenceText "Our results indicate that both these patient groups differ from controls relative to the presence of rare bacterial taxa." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37995475> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38010793_10> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38010793_10" ;
    gutprop:hasSentenceText "Together, the altered microbiota strengthens the relationship between unbalanced dietary intake and GI symptoms." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38010793> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38010793_7> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38010793_7" ;
    gutprop:hasSentenceText "The Eggerthellaceae was positively correlated with total GI symptoms (FDR-corrected P-value <0.25)." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38010793> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38011787_1> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38011787_1" ;
    gutprop:hasSentenceText "Cryptotanshinone (CPT), a bioactive compound derived from the traditional Chinese herb Salvia miltiorrhiza, exhibits promising antidepressant properties." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38011787> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38011787_4> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38011787_4" ;
    gutprop:hasSentenceText "Notably, CPT administration was found to mitigate harmful bacterial shifts associated with depression." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38011787> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38026003_1> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38026003_1" ;
    gutprop:hasSentenceText "The neonatal period represents a critical stage for the establishment and development of the gut microbiota, which profoundly influences the future health trajectory of individuals." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38026003> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38026003_3> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38026003_3" ;
    gutprop:hasSentenceText "In humans, the intestinal microbiota contributes to several crucial physiological processes, including digestion, nutrient absorption, immune system development, and modulation of host metabolism." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38026003> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38026003_7> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38026003_7" ;
    gutprop:hasSentenceText "However, our understanding of the intricacies and functional significance of the intestinal microbiota in dogs remains limited." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38026003> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38026003_9> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38026003_9" ;
    gutprop:hasSentenceText "Moreover, exploring the similarities and differences in the gut microbial composition between these two species can facilitate translational research, potentially leading to innovative therapeutic interventions and strategies to enhance the well-being of both humans and dogs." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38026003> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38068763_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38068763_0" ;
    gutprop:hasSentenceText "Analysis of the Efficacy of Diet and Short-Term Probiotic Intervention on Depressive Symptoms in Patients after Bariatric Surgery: A Randomized Double-Blind Placebo Controlled Pilot Study." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/38068763> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38068763_1> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38068763_1" ;
    gutprop:hasSentenceText "(1) Background: studies have shown that some patients experience mental deterioration after bariatric surgery." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38068763> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38068763_5> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38068763_5" ;
    gutprop:hasSentenceText "After 5 weeks, we noted an improvement in patients' mental functioning (reduction in BDI and HRSD), but it was not related to the probiotic used." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38068763> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38089822_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38089822_0" ;
    gutprop:hasSentenceText "The relationship between gut microbiota and insomnia: a bi-directional two-sample Mendelian randomization research." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/38089822> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38089822_1> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38089822_1" ;
    gutprop:hasSentenceText "Insomnia is the second most common mental health issue, also is a social and financial burden." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38089822> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38089822_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38089822_2" ;
    gutprop:hasSentenceText "Insomnia affects the balance between sleep, the immune system, and the central nervous system, which may raise the risk of different systemic disorders." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38089822> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38089822_9> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38089822_9" ;
    gutprop:hasSentenceText "It suggested that the relationship between insomnia and intestinal flora was convoluted." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38089822> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38123016_6> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38123016_6" ;
    gutprop:hasSentenceText "Due to the substantial clinical heterogeneity of ASD, medical caretakers may be unlikely to develop a broad and effective general gut microbiota modulator." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38123016> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38123016_7> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38123016_7" ;
    gutprop:hasSentenceText "However, dietary modulation followed by administration of microbiota modulators is a promising option for treating ASD-related behavioral and gastrointestinal symptoms." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38123016> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38132705_13> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38132705_13" ;
    gutprop:hasSentenceText "Ultimately, differences in the gut microbiome of individuals experiencing and not experiencing homelessness could assist in identification of treatment targets to improve health outcomes." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38132705> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38132705_7> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38132705_7" ;
    gutprop:hasSentenceText "In terms of differences in gut microbiota, beta diversity was significantly different between veterans who had experienced homelessness and veterans who had never been homeless (<i>P</i> = 0.047, weighted UniFrac), while alpha diversity was similar." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38132705> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38139446_6> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38139446_6" ;
    gutprop:hasSentenceText "We applied statistical modeling with logistic regression to test for interaction between gut microbiota and these markers." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38139446> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38203207_6> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38203207_6" ;
    gutprop:hasSentenceText "The modulation, development, and renewal of nerves in the ENS and changes in the gut microbiome alter the synthesis and degradation of neurotransmitters, ultimately influencing our mental health." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38203207> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38204948_10> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38204948_10" ;
    gutprop:hasSentenceText "In this review, we examine different theories regarding the association between PCOS and psychiatric disorders and point out different areas of research that are needed to broaden our understanding of this association." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38204948> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38204948_4> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38204948_4" ;
    gutprop:hasSentenceText "Despite the socioeconomic effect that these disorders may have on patients with PCOS and society as a whole, this association is largely lacking in research." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38204948> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38229613_8> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38229613_8" ;
    gutprop:hasSentenceText "We report a higher abundance of Clostridia UCG 014 group, previously not linked to PD." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38229613> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38247868_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38247868_0" ;
    gutprop:hasSentenceText "Psychiatric Comorbidities of Inflammatory Bowel Disease: It Is a Matter of Microglia's Gut Feeling." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/38247868> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38247868_4> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38247868_4" ;
    gutprop:hasSentenceText "Within this context, microglia are the crucial non-neural cells in the brain responsible for innate immune responses following inflammatory insults." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38247868> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38247868_5> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38247868_5" ;
    gutprop:hasSentenceText "Alterations in microglia's functions, such as secretory profile, phagocytic activity, and synaptic pruning, might play significant roles in mediating psychiatric manifestations of IBD." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38247868> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38247868_6> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38247868_6" ;
    gutprop:hasSentenceText "In this review, we discuss the role played by microglia in IBD-associated comorbidities." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38247868> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38260914_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38260914_0" ;
    gutprop:hasSentenceText "Rosacea, microbiome and probiotics: the gut-skin axis." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/38260914> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38260914_1> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38260914_1" ;
    gutprop:hasSentenceText "Rosacea is an inflammatory skin disease involving diverse symptoms with a variable clinical progress which can severely impact the patient's quality of life as well as their mental health." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38260914> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38260914_7> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38260914_7" ;
    gutprop:hasSentenceText "In this context, probiotic supplementation could improve the clinical evolution of these patients as happens in other pathologies." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38260914> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38278499_1> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38278499_1" ;
    gutprop:hasSentenceText "Our aim was to evaluate whether alcohol use is associated with changes in the circulating metabolite profile similar to those present in persons with depression." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38278499> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38278499_7> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38278499_7" ;
    gutprop:hasSentenceText "Reduced serum concentrations of hippuric acid suggest that already-moderate alcohol use is associated with depression-like changes in the serum levels of metabolites associated with gut microbiota and liver function; this may be one possible molecular level link between alcohol use and depression." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38278499> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38283894_1> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38283894_1" ;
    gutprop:hasSentenceText "Autism spectrum disorder (ASD) is a multifaceted developmental condition that commonly appears during early childhood." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38283894> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38292207_1> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38292207_1" ;
    gutprop:hasSentenceText "Anxiety disorders in dogs are ever-growing and represent an important concern in the veterinary behavior field." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38292207> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38292207_5> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38292207_5" ;
    gutprop:hasSentenceText "A variety of microorganisms inhabit the intestines of dogs, which are essential in maintaining intestinal homeostasis." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38292207> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38302874_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38302874_0" ;
    gutprop:hasSentenceText "Chronic intestinal pseudo-obstruction: associations with gut microbiota and genes expression of intestinal serotonergic pathway." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/38302874> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38302874_3> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38302874_3" ;
    gutprop:hasSentenceText "The intestinal endocrine system (IES) jointly with the enteric nervous system (ENS) regulates secreto-motor functions via different hormones and bioactive messengers/neurotransmitters." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38302874> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38318337_4> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38318337_4" ;
    gutprop:hasSentenceText "We conducted a multi-omics analysis to obtain a comprehensive insight into the changes in tryptophan metabolism along the microbiota-gut-brain axis induced by running exercises." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38318337> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38318337_8> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38318337_8" ;
    gutprop:hasSentenceText "The outcomes indicate a shift in microbiota diversity and tryptophan metabolizing capabilities within the running group, linked to increased tryptophan transportation to the hippocampus and brainstem through circulation." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38318337> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38331354_4> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38331354_4" ;
    gutprop:hasSentenceText "These mice underwent common bile duct ligation (CBDL), a method used to stimulate liver cirrhosis." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38331354> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38331354_5> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38331354_5" ;
    gutprop:hasSentenceText "To assess depression-like behaviors, behavioral tests were conducted 10 days following either sham or CBDL surgeries." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38331354> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38331354_8> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38331354_8" ;
    gutprop:hasSentenceText "Significantly, these changes were reversed in CBDL mice by performing a subdiaphragmatic vagotomy." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38331354> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38350463_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38350463_0" ;
    gutprop:hasSentenceText "Gut production of GABA by a probiotic formula: an in vitro study." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/38350463> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38350463_11> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38350463_11" ;
    gutprop:hasSentenceText "Results demonstrate the impact of the tested probiotic formula on gut microbiota structure and GABA production." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38350463> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38350463_12> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38350463_12" ;
    gutprop:hasSentenceText "In conclusion, the probiotic treatment changed the microbiota composition and increased neuroactive metabolites production, indicating promising potential as psychobiotics, even if further clinical evidence is needed to confirm the effectiveness of these probiotics in improving mental health." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38350463> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38350463_7> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38350463_7" ;
    gutprop:hasSentenceText "Production of GABA after the treatment with probiotics was confirmed in the SHIME® short-term experiment." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38350463> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38401573_3> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38401573_3" ;
    gutprop:hasSentenceText "In this study, we investigated the role of gut-brain axis on the prophylactic effects of arketamine in the CRS (7 days) model." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38401573> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38401573_8> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38401573_8" ;
    gutprop:hasSentenceText "These findings suggest that gut-brain axis, including its metabolites, might partially contribute to the persistent prophylactic effects of arketamine in the CRS model." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38401573> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38409102_17> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38409102_17" ;
    gutprop:hasSentenceText "This study highlights distinct pre- and post-trauma differences in microbial composition, functionality, and metabolites, associated with stress resilience in male and female rats." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38409102> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38409102_18> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38409102_18" ;
    gutprop:hasSentenceText "The findings underscore the importance of developing sex-specific therapeutic strategies to effectively address stress-related disorders." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38409102> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38409102_3> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38409102_3" ;
    gutprop:hasSentenceText "The factors influencing sex-related disparities in affective disorders as well as variations in resilience remain unclear; however, emerging evidence suggests differences in the gut microbiota play a role." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38409102> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38409102_5> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38409102_5" ;
    gutprop:hasSentenceText "Male and female Sprague-Dawley rats were randomly assigned to control or SPS groups." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38409102> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38409102_6> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38409102_6" ;
    gutprop:hasSentenceText "Two weeks following SPS, the animals were exposed to a battery of behavioral tests and decapitated a day later." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38409102> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38409102_7> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38409102_7" ;
    gutprop:hasSentenceText "Based on their anxiety index, they were further categorized as SPS-resilient (SPS-R) or SPS-susceptible (SPS-S)." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38409102> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38409102_8> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38409102_8" ;
    gutprop:hasSentenceText "On the day of dissection, cecum, and selected brain tissues were isolated." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38409102> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38422755_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38422755_0" ;
    gutprop:hasSentenceText "Gut microbiota disturbances in hospitalized older adults with malnutrition and clinical outcomes." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/38422755> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38422755_1> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38422755_1" ;
    gutprop:hasSentenceText "Malnutrition is one of the most threatening conditions in geriatric populations." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38422755> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38422755_12> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38422755_12" ;
    gutprop:hasSentenceText "Older adults with malnutrition, especially in a severe stage, may be subject to substantial gut microbial disturbances during hospitalization." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38422755> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38422755_4> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38422755_4" ;
    gutprop:hasSentenceText "We performed a secondary longitudinal analysis in 108 geriatric patients from a prospective cohort evaluated at admission and 72 h of hospitalization." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38422755> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38422755_5> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38422755_5" ;
    gutprop:hasSentenceText "We collected clinical, demographic, nutritional, and 16S rRNA gene-sequenced gut microbiota data." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38422755> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38422755_6> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38422755_6" ;
    gutprop:hasSentenceText "Microbiota diversity, overall composition, and differential abundance were calculated and compared between patients with and without malnutrition." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38422755> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38422755_8> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38422755_8" ;
    gutprop:hasSentenceText "Patients with malnutrition (51%) had a different microbiota composition compared to those who were well-nourished during hospitalization (ANOSIM R = 0.079, P = 0.003)." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38422755> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38422755_9> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38422755_9" ;
    gutprop:hasSentenceText "Patients with severe malnutrition showed poorer α-diversity at admission (Shannon P = 0.012, Simpson P = 0.018) and follow-up (Shannon P = 0.023, Chao1 P = 0.008)." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38422755> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38432867_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38432867_0" ;
    gutprop:hasSentenceText "Gut microbiota and thyroid-associated ophthalmopathy." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/38432867> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38432867_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38432867_2" ;
    gutprop:hasSentenceText "Due to the complex clinical manifestations and prolonged course,TAO seriously affect the physical and mental health of patients.The pathogenesis of TAO has not been fully elucidated and the treatment lacks specificity." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38432867> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38432867_6> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38432867_6" ;
    gutprop:hasSentenceText "Modulating the gut microbiota also has therapeutic effects on TAO and is a promising therapeutic approach." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38432867> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38508549_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38508549_0" ;
    gutprop:hasSentenceText "Along the microbiota-gut-brain axis: Use of plant polysaccharides to improve mental disorders." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/38508549> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38508549_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38508549_2" ;
    gutprop:hasSentenceText "In this review, we discussed the role of plant polysaccharides in improving various mental disorders via the microbiota-gut-brain axis." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38508549> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38508549_4> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38508549_4" ;
    gutprop:hasSentenceText "Plant polysaccharides and their metabolites have great potential for reshaping gut microbiota profiles through gut microbiota-dependent fermentation." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38508549> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38508549_8> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38508549_8" ;
    gutprop:hasSentenceText "Moreover, mechanistic elucidation, safety verification, and additional rigorous human studies are expected to advance plant polysaccharide-based product development targeting the microbiota-gut-brain axis for people with mental disorders." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38508549> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38525261_11> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38525261_11" ;
    gutprop:hasSentenceText "Various types of dietary fiber have an impact on the gut microbiota composition, with some promoting the growth of particular taxa while others are reduced in relative abundance." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38525261> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38525261_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38525261_2" ;
    gutprop:hasSentenceText "The functional outputs of the gut microbiota, such as microbial metabolites, are considered particularly important in this regard." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38525261> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38525261_4> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38525261_4" ;
    gutprop:hasSentenceText "Dietary fiber has the potential to alter gut microbiota composition and function, modifying bacterial enzymatic function and the production of metabolites." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38525261> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38576868_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38576868_0" ;
    gutprop:hasSentenceText "Bipolar disorder and the gut microbiota: a bibliometric analysis." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/38576868> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38576868_1> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38576868_1" ;
    gutprop:hasSentenceText "Previous studies have explored the relationship between bipolar disorder and gut microbiota." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38576868> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38576868_11> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38576868_11" ;
    gutprop:hasSentenceText "In conclusion, this is the first bibliometric analysis to explore the publications in the field of the association between bipolar disorder and the gut microbiota." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38576868> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38576868_12> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38576868_12" ;
    gutprop:hasSentenceText "The main research hotspots regarding this field were the characteristics, abundance, and diversity of gut microbiome in bipolar disorder, the role of treatment and gut microbiome in bipolar disorder, microbiome-brain connections in bipolar disorder, and interventions for bipolar disorder based on microbiota composition modification." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38576868> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38576868_13> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38576868_13" ;
    gutprop:hasSentenceText "The number of studies about the association between gut microbiota and bipolar disorder is relatively small, and more studies are needed to expand our understanding the association between gut microbiota and bipolar disorder." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38576868> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38576868_3> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38576868_3" ;
    gutprop:hasSentenceText "Our objective was to perform a bibliometric analysis to investigate the current status and frontiers of the publications in the field of the association between bipolar disorder and the gut microbiota." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38576868> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38576868_4> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38576868_4" ;
    gutprop:hasSentenceText "We retrieved publications concerning the interplay between the gut microbiota and bipolar disorder from the Web of Science Core Collection (WoSCC)." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38576868> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38606411_1> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38606411_1" ;
    gutprop:hasSentenceText "Insomnia disorder stands out as one of the prevalent clinical sleep and psychiatric disorders." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38606411> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38606411_10> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38606411_10" ;
    gutprop:hasSentenceText "Overnight PSG indicated a notable increase in bed time, total wake time, sleep onset latency, and wake after sleep onset in individuals with insomnia disorder." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38606411> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38606411_14> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38606411_14" ;
    gutprop:hasSentenceText "Additionally, D-LA levels were significantly positively correlated with ET concentrations." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38606411> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38606411_16> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38606411_16" ;
    gutprop:hasSentenceText "These findings suggest that the occurrence and development of insomnia disorder may be linked to the impairment of the intestinal barrier." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38606411> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38606411_3> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38606411_3" ;
    gutprop:hasSentenceText "These alterations may play a direct or indirect role in the onset and progression of insomnia disorder by compromising the integrity of the intestinal barrier." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38606411> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38613087_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38613087_0" ;
    gutprop:hasSentenceText "The Power of Psychobiotics in Depression: A Modern Approach through the Microbiota-Gut-Brain Axis: A Literature Review." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/38613087> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38613087_1> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38613087_1" ;
    gutprop:hasSentenceText "The microbiota-gut-brain (MGB) axis is a complex communication network linking the gut, microbiota, and brain, influencing various aspects of health and disease." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38613087> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38613087_4> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38613087_4" ;
    gutprop:hasSentenceText "This review explores the potential of psychobiotics in managing depressive disorders, emphasizing their role in restoring microbial balance and influencing the MGB axis." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38613087> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38613087_6> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38613087_6" ;
    gutprop:hasSentenceText "Studies suggest that probiotics may serve as an adjunct therapy for depression, especially in treatment-resistant cases." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38613087> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38664425_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38664425_0" ;
    gutprop:hasSentenceText "Effects of microbiome-based interventions on neurodegenerative diseases: a systematic review and meta-analysis." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/38664425> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38679353_3> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38679353_3" ;
    gutprop:hasSentenceText "Studies evaluating the association between GM and PD were included." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38679353> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38686220_5> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38686220_5" ;
    gutprop:hasSentenceText "Computer-generated randomisation was done in a 1:1 ratio through permutated-block scheduling." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38686220> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38686220_8> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38686220_8" ;
    gutprop:hasSentenceText "Intention-to-treat analysis was performed using a mixed model for repeated measures analysis." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38686220> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38707924_5> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38707924_5" ;
    gutprop:hasSentenceText "This study focused on the effect of probiotics on mental health as they have drawn more attention because of their extensive clinical applications and positive impact on various diseases." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38707924> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38707924_6> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38707924_6" ;
    gutprop:hasSentenceText "Numerous studies have demonstrated how the gut microbiota might be critical for mood regulation and how probiotics can affect host health by regulating the gut-brain axis." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38707924> .

