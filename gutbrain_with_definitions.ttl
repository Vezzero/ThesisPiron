        skos:Concept,
        gutprop:Drug ;
    rdfs:label "Citalopram" ;
    rdfs:comment "A furancarbonitrile that is one of the SELECTIVE SEROTONIN REUPTAKE INHIBITORS used as an antidepressant. The drug is also effective in reducing ethanol uptake in alcoholics and is used in depressed patients who also suffer from TARDIVE DYSKINESIA in preference to tricyclic antidepressants, which aggravate dyskinesia. [Definition Source: UMLS]",
        "UMLS Match" ;
    skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/Drug> ;
    gutprop:containedIn <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/1249ab46e28cf794>,
