        skos:Concept,
        <https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding> ;
    rdfs:label "Clostridium Difficile Colitis" ;
    rdfs:comment "A bacterial infection of the colon secondary to infection with Clostridium difficile bacteria. This infection generally results from the loss of normal gut flora secondary to recent antibiotic use, and manifests as copious watery stools, with associated abdominal pain and myalgia. C. difficile is the most common cause of pseudomembranous colitis, and can progress to toxic megacolon if left untreated. [Definition Source: NCIT]",
        "NCIT Match" ;
    skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/DiseaseDisorderOrFinding> ;
    gutprop:containedIn <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/d4fe6b159a2e34b0> .

