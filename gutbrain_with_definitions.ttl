    gutprop:target <http://purl.obolibrary.org/obo/NCIT_C45247> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/diseasedisorderorfinding/EndolysosomalDeficits> a owl:NamedIndividual,
        skos:Concept,
        <https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding> ;
    rdfs:label "Endolysosomal Deficit" ;
    dcterms:creator "Samuel Piron" ;
    rdfs:comment "Endolysosomal_deficits refer to impairments or disruptions in the normal functioning of endolysosomes, which are membrane-bound organelles responsible for cellular digestion and recycling of cellular waste and foreign substances. [Definition Source: llama3-8b-8192]" ;
    skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/DiseaseDisorderOrFinding> ;
    gutprop:containedIn <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/a4df6e70cb5d6e37> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/diseasedisorderorfinding/InducedCellularDamage> a owl:NamedIndividual,
        skos:Concept,
        <https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding> ;
    rdfs:label "Induced Cellular Damage" ;
    dcterms:creator "Samuel Piron" ;
    rdfs:comment "Induced cellular damage refers to the harm or injury caused to cells as a result of external factors, such as environmental toxins, radiation, or chemical agents, which can lead to cellular stress, apoptosis, or necrosis. [Definition Source: llama3-8b-8192]" ;
    skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/DiseaseDisorderOrFinding> ;
    gutprop:containedIn <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/4f973851f300155a>,
        <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/5b1a1166538c0a61> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/diseasedisorderorfinding/IntestinalAlteration> a owl:NamedIndividual,
        skos:Concept,
        <https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding> ;
    rdfs:label "Intestinal Alteration" ;
    dcterms:creator "Samuel Piron" ;
    rdfs:comment "Intestinal_alteration refers to a change or abnormality in the structure or function of the intestine, which can be caused by various factors such as disease, injury, or surgical intervention. [Definition Source: llama3-8b-8192]" ;
    skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/DiseaseDisorderOrFinding> ;
    gutprop:affect <https://w3id.org/hereditary/ontology/gutbrain/resource/diseasedisorderorfinding/Dysregulation> ;
