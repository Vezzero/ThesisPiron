        gutprop:Sentence ;
    rdfs:label "sentence_38203207_8" ;
    gutprop:hasSentenceText "In this review, the intricate control of entero-endocrine signaling and immune responses that keep the gut microbiome in a balanced state, and the influence that changing gut bacteria have on neuropsychiatric disorders, are discussed." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38203207> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38204948_3> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38204948_3" ;
    gutprop:hasSentenceText "Polycystic ovarian syndrome has been linked to an increased prevalence of various psychiatric disorders, including depression and anxiety." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38204948> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38204948_6> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38204948_6" ;
