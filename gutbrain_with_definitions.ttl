<http://purl.obolibrary.org/obo/NCIT_C131261> a owl:NamedIndividual,
        skos:Concept,
        <https://w3id.org/brainteaser/ontology/schema/Gene> ;
    rdfs:label "16S Mitochondrial Ribosomal RNA" ;
    rdfs:comment "16S mitochondrial ribosomal RNA is encoded by the human MT-RNR2 gene. This ribonucleotide is involved in mitochondrial protein translation. [Definition Source: NCIT]",
        "NCIT Match" ;
    skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/Gene> ;
    gutprop:containedIn <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/a7d88a553c9ebff3> .

<http://purl.obolibrary.org/obo/NCIT_C13194> a owl:NamedIndividual,
        skos:Concept,
        <https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding> ;
    rdfs:label "Blood-Brain Barrier" ;
    rdfs:comment "NCIT Match",
        "The mechanism for restricting the passage of charged ions and large molecules from the blood into the brain and central nervous system (CNS) by employing a unique capillary bed with tight junctions between the endothelial cells. [Definition Source: NCIT]" ;
    skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/DiseaseDisorderOrFinding> ;
    gutprop:containedIn <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/f7b0236a1c09117d> ;
    gutprop:target <http://purl.obolibrary.org/obo/NCIT_C45247> .

<http://purl.obolibrary.org/obo/NCIT_C13281> a owl:NamedIndividual,
        skos:Concept,
        <https://w3id.org/brainteaser/ontology/schema/AnatomicalSite> ;
    rdfs:label "Synapse" ;
    rdfs:comment "A cell-cell junction between a neuron and another neuron or a cell in a target organ. At this interface, the presynaptic neuron can transmit chemical (neurotransmitter) or electical signals (nerve impulses) to the postsynaptic target. [Definition Source: NCIT]",
        "NCIT Match" ;
    skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/AnatomicSite> ;
    gutprop:containedIn <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/90dece5494ad6569> .

<http://purl.obolibrary.org/obo/NCIT_C13295> a owl:NamedIndividual,
        skos:Concept,
        <https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding> ;
    rdfs:label "Telomere" ;
    rdfs:comment "A stretch of repetitive nucleotide sequences (TTAGGG repeats in humans) found at both ends of each chromatid arm that plays a role in chromosome stability during replication. [Definition Source: NCIT]",
        "NCIT Match" ;
    skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/DiseaseDisorderOrFinding> ;
    gutprop:affect <http://purl.obolibrary.org/obo/MP_0002229> ;
    gutprop:containedIn <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/59f6b5a0c57f3c17> .

<http://purl.obolibrary.org/obo/NCIT_C13304> a owl:NamedIndividual,
        skos:Concept,
        <https://w3id.org/brainteaser/ontology/schema/AnatomicalSite> ;
    rdfs:label "Pulmonary" ;
    rdfs:comment "NCIT Match",
        "Relating to the lungs as the intended site of administration, where the pharmaceutical product is administered, usually by inhalation, for local action in the lower respiratory tract or for systemic action after absorption via the lower respiratory tract. [Definition Source: NCIT]" ;
    skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/AnatomicSite> ;
    gutprop:containedIn <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/c5740d0cbd3e6ce8> .

<http://purl.obolibrary.org/obo/NCIT_C13319> a owl:NamedIndividual,
        skos:Concept,
        <https://w3id.org/brainteaser/ontology/schema/AnatomicalSite> ;
    rdfs:label "Gland" ;
    rdfs:comment "An organ that produces and secretes hormones (e.g. endocrine gland), saliva or sweat (e.g. exocrine gland). [Definition Source: NCIT]",
        "NCIT Match" ;
    skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/AnatomicSite> ;
    gutprop:containedIn <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/d7b224a3f66dd54d> .

<http://purl.obolibrary.org/obo/NCIT_C13325> a owl:NamedIndividual,
        skos:Concept,
        <https://w3id.org/brainteaser/ontology/schema/AnatomicalSite>,
        gutprop:Chemical ;
    rdfs:label "Serum" ;
    rdfs:comment "NCIT Match",
        "The clear portion of the blood that remains after the removal of the blood cells and the clotting proteins. [Definition Source: NCIT]" ;
    skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/AnatomicSite>,
        <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/Chemical> ;
    gutprop:containedIn <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/63cc98599f0a945b>,
        <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/6f1100171eb6f5a0> .

<http://purl.obolibrary.org/obo/NCIT_C13333> a owl:NamedIndividual,
        skos:Concept,
        gutprop:Chemical ;
    rdfs:label "Tight Junction" ;
    rdfs:comment "Found near the apical surface of cells in simple epithelia. Forms a sealing \"gasket\" around the cell by the fusion of adjacent cell membranes which encircle the apical cell surface like a belt or fence. Prevents fluid moving through the intercellular gap and the lateral diffusion of intrinsic membrane proteins between apical and basolateral domains of the plasma membrane as well as occludes the movement of solute molecules between cells. Various proteins components of this junction have been identified, but how they are linked to form the ultrastructure of the junction is not known. [Definition Source: NCIT]",
        "NCIT Match" ;
    skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/Chemical> ;
    gutprop:containedIn <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/d47e2ef467e70426> .

<http://purl.obolibrary.org/obo/NCIT_C1396> a owl:NamedIndividual,
        skos:Concept,
        gutprop:Chemical ;
    rdfs:label "Recombinant Neurotrophins" ;
    rdfs:comment "NCIT Match",
        "Recombinant Neurotrophins [Definition Source: NCIT]" ;
    skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/Chemical> ;
    gutprop:containedIn <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/ecc6c571d77d765a> .

<http://purl.obolibrary.org/obo/NCIT_C14217> a owl:NamedIndividual,
        skos:Concept,
        gutprop:Chemical ;
    rdfs:label "Herpesvirus" ;
    rdfs:comment "A heterogeneous family of morphologically similar viruses, all of which contain double-stranded DNA and which infect man and a wide variety of other vertebrates. Infections produce type A inclusion bodies; in many instances, infection may remain latent for many years, even in the presence of specific circulating antibodies. Virions are enveloped, ether-sensitive, and vary up to 200 nm in diameter; the nucleocapsids are 100 nm in diameter and of icosahedral symmetry, with 162 capsomeres. The family includes herpes simplex virus, cytomegalovirus, EB virus (all of which infect humans) and many others. [Definition Source: NCIT]",
        "NCIT Match" ;
    skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/Chemical> ;
    gutprop:containedIn <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/ab57be44b0888bce> ;
    gutprop:influence <http://purl.obolibrary.org/obo/NCIT_C17557>,
        <http://purl.obolibrary.org/obo/NCIT_C26845>,
        <http://purl.obolibrary.org/obo/NCIT_C26915>,
        <http://purl.obolibrary.org/obo/NCIT_C2866>,
        <http://purl.obolibrary.org/obo/NCIT_C3137>,
        <http://purl.obolibrary.org/obo/NCIT_C84826>,
        <https://uts.nlm.nih.gov/uts/umls/concept/C4287543> .

<http://purl.obolibrary.org/obo/NCIT_C1424> a owl:NamedIndividual,
        skos:Concept,
        gutprop:DietarySupplement ;
    rdfs:label "Sulforaphane" ;
    rdfs:comment "A naturally-occurring phytochemical belonging to the class of isothiocyanates.  As the aglycone metabolite of glucosinolate glucoraphanin (sulforaphane glucosinolate), sulforaphane acts as an antioxidant and potent stimulator of endogenous detoxifying enzymes.  This agent displays anticarcinogenic properties due to its ability to induce phase II detoxification enzymes, such as glutathione S-transferase and quinone reductase, thereby providing protection against certain carcinogens and toxic, reactive oxygen species.  Broccoli sprouts contain large amounts of sulforaphane, which is also found in other cruciferous vegetables including cabbage and kale. (NCI04) [Definition Source: NCIT]",
        "NCIT Match" ;
    skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/DietarySupplement> ;
