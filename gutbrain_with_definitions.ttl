<https://w3id.org/hereditary/ontology/gutbrain/resource/human/LiverCirrhosisPatients> a owl:NamedIndividual,
        skos:Concept,
        gutprop:Human ;
    rdfs:label "Liver Cirrhosis Patients" ;
    dcterms:creator "Samuel Piron" ;
    rdfs:comment "\"Liver cirrhosis patients\" refers to individuals who have a chronic liver disease characterized by fibrosis and nodular regeneration, leading to impaired liver function and potential complications. [Definition Source: llama3-8b-8192]" ;
    skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/Human> ;
    gutprop:containedIn <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/689e8c60ce63d9f1> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/human/MultipleSclerosisPatients> a owl:NamedIndividual,
        skos:Concept,
        gutprop:Human ;
    rdfs:label "Multiple Sclerosis Patients" ;
    dcterms:creator "Samuel Piron" ;
    rdfs:comment "Multiple_sclerosis_patients refers to individuals diagnosed with multiple sclerosis, a chronic and often disabling autoimmune disease that affects the central nervous system. [Definition Source: llama3-8b-8192]" ;
