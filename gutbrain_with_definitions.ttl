        "UMLS Match" .

<https://uts.nlm.nih.gov/uts/umls/concept/C0027895> a owl:NamedIndividual,
        skos:Concept,
        gutprop:Chemical ;
    rdfs:label "Neuropeptides" ;
    rdfs:comment "Neuropeptides are small peptides that are produced by neurons and play a crucial role in various physiological processes, including neurotransmission, hormone regulation, and immune response. [Definition Source: llama3-8b-8192]"^^xsd:string,
        "UMLS Match"^^xsd:string ;
    skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/Chemical> ;
