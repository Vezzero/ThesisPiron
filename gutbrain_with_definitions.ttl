<https://w3id.org/hereditary/ontology/gutbrain/resource/biomedicaltechnique/SelfReportingQuestionnaire> a owl:NamedIndividual,
        skos:Concept,
        gutprop:BiomedicalTechnique ;
    rdfs:label "Self-Reporting Questionnaire" ;
    dcterms:creator "Samuel Piron" ;
    rdfs:comment "A self-reporting questionnaire is a standardized instrument used to collect subjective information from individuals about their health, behaviors, or experiences through self-administered questions. [Definition Source: llama3-8b-8192]" ;
