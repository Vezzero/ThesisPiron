        gutprop:BiomedicalTechnique ;
    rdfs:label "Bielschowsky Head Tilt Test" ;
    rdfs:comment "The Bielschowsky head tilt test is a clinical examination technique used to assess the presence and severity of papilledema by tilting the patient's head to observe the optic disc and surrounding retinal vessels. [Definition Source: llama3-8b-8192]",
        "UMLS Match" ;
    skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/BiomedicalTechnique> ;
