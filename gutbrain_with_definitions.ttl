        skos:Concept,
        gutprop:Animal ;
    rdfs:label "Mammal" ;
    rdfs:comment "UMLS Match",
        "Warm-blooded vertebrate animals belonging to the class Mammalia, including all that possess hair and suckle their young. [Definition Source: UMLS]" ;
