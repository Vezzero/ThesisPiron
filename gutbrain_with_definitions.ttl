        gutprop:BiomedicalTechnique ;
    rdfs:label "Strain-Level Meta-Analysis" ;
    dcterms:creator "Samuel Piron" ;
    rdfs:comment "A strain-level meta-analysis is a statistical analysis that combines the results from multiple studies to draw conclusions about the effects of different strains of a microorganism on a specific outcome or trait. [Definition Source: llama3-8b-8192]" ;
    skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/BiomedicalTechnique> ;
