<http://purl.obolibrary.org/obo/NCIT_C258> a owl:NamedIndividual,
        skos:Concept,
        gutprop:Drug ;
    rdfs:label "Antibiotic" ;
    rdfs:comment "NCIT Match",
        "Substances naturally produced by microorganisms or their derivatives that selectively target microorganisms not humans. Antibiotics kill or inhibit the growth of microorganisms by targeting components of the microbial cell absent from human cells, including bacterial cell walls, cell membrane, and 30S or 50S ribosomal subunits. These substances are used in the treatment of bacterial and other microbial infections. [Definition Source: NCIT]" ;
    skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/Drug> ;
    gutprop:administered <http://purl.obolibrary.org/obo/NCIT_C45247> ;
