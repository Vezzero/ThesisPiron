<http://purl.obolibrary.org/obo/OMIT_0015462> a owl:NamedIndividual,
        skos:Concept,
        <https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding> ;
    rdfs:label "Vagotomy" ;
    rdfs:comment "A subdiaphragmatic vagotomy is a type of surgical procedure that involves cutting the vagus nerve below the diaphragm to treat conditions such as peptic ulcer disease or gastroesophageal reflux disease (GERD). [Definition Source: llama3-8b-8192]",
        "OMIT Match" ;
    skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/DiseaseDisorderOrFinding> ;
    gutprop:affect <http://purl.obolibrary.org/obo/NCIT_C117277>,
