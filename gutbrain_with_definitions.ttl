<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36984505_1> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_36984505_1" ;
    gutprop:hasSentenceText "<i>Helicobacter pylori</i> infection consists a high global burden affecting more than 50% of the world's population." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36984505> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36984505_6> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_36984505_6" ;
    gutprop:hasSentenceText "In conclusion, by controlling the impact of <i>Helicobacter pylori</i>-related hyperhomocysteinemia on neurodegenerative disorders might offer benefits, and additional research is warranted to clarify this crucial topic currently representing a major worldwide burden." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36984505> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36986165_3> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_36986165_3" ;
    gutprop:hasSentenceText "A growing body of evidence suggests that inflammatory processes and an imbalance in the composition and function of the gut microbiome, which play a critical role in the pathogenesis of various neurological diseases and dietary interventions, such as the Mediterranean diet the DASH diet, or the ketogenic diet can have beneficial effects on their course." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36986165> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36989335_4> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_36989335_4" ;
    gutprop:hasSentenceText "124 children (69 multinutrients, 55 placebo) had diet quality assessed using the Healthy Eating Index-2015 (HEI-2015)." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36989335> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37049591_8> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37049591_8" ;
    gutprop:hasSentenceText "More unique OTUs were observed at the family, genus and species levels in the control group compared with the MDD cases." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37049591> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37071196_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37071196_0" ;
    gutprop:hasSentenceText "Development of the gut microbiota in the first 14 years of life and its relations to internalizing and externalizing difficulties and social anxiety during puberty." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/37071196> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37071196_9> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37071196_9" ;
    gutprop:hasSentenceText "This finding was confirmed by a negative cross-sectional relation between Faecalibacterium and social anxiety in the 14-year-olds." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37071196> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37095530_5> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37095530_5" ;
    gutprop:hasSentenceText "We report some altered gut microbiota that were associated with psychological changes in the long-term closed environment." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37095530> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37127945_1> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37127945_1" ;
    gutprop:hasSentenceText "Bipolar disorder (BD) is a mood disorder that affects millions worldwide." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37127945> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37127945_3> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37127945_3" ;
    gutprop:hasSentenceText "This study aims to assess the relationship between the gut-brain axis and BD and to discuss and compare the efficacy of varying methods of balancing gut microbiotas in BD." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37127945> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37127945_7> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37127945_7" ;
    gutprop:hasSentenceText "Also, 12 articles that met our criteria and eligibility criteria reported on 613 BD patients." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37127945> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37156128_1> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37156128_1" ;
    gutprop:hasSentenceText "The human gut microbiome regulates brain function through the microbiome-gut-brain axis and is implicated in several neuropsychiatric disorders." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37156128> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37156128_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37156128_2" ;
    gutprop:hasSentenceText "However, the relationship between the gut microbiome and the pathogenesis of schizophrenia (SCZ) is poorly defined, and very few studies have examined the effect of antipsychotic treatment response." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37156128> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37156128_7> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37156128_7" ;
    gutprop:hasSentenceText "Linear Discriminant Analysis Effect Size (LEfSe) and Random Forest model identified the top six genera, which significantly differed in abundance between the study groups." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37156128> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37168424_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37168424_2" ;
    gutprop:hasSentenceText "A total of 45 patients with first-episode depression and 22 healthy volunteers were chosen to complete relevant scale evaluations, and feces samples and venous blood samples were collected." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37168424> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37168424_7> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37168424_7" ;
    gutprop:hasSentenceText "The serum SCFA content in the MDD group was higher than that in the C group, and the content positively correlated with the Hamilton anxiety scale scores (<i>r</i> = 0.584, <i>P</i> < 0.05)." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37168424> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37193253_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37193253_0" ;
    gutprop:hasSentenceText "Anxiety Disorders and Gut Dysbiosis in Primary Sjögren's Syndrome-Mediated Dry Eye Patients." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/37193253> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37193253_1> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37193253_1" ;
    gutprop:hasSentenceText "Primary Sjögren's syndrome (pSS), a disease that is associated with a high prevalence of psychological disorders, has become increasingly important." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37193253> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37193253_11> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37193253_11" ;
    gutprop:hasSentenceText "Bacteroidetes (<i>p</i> =0.046) and Odoribacter (<i>p</i> =0.001) were correlated with pSS activity." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37193253> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37193253_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37193253_2" ;
    gutprop:hasSentenceText "Interactions between the gut microbiota and ocular conditions have been identified in pSS." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37193253> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37193253_7> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37193253_7" ;
    gutprop:hasSentenceText "In all participants, we found that the prevalence of anxiety disorder was 30.4%." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37193253> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37193253_8> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37193253_8" ;
    gutprop:hasSentenceText "Dry eye discomfort could promote an anxious state, and conversely, anxiety could threaten tear film and increase the risk of pSS activity." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37193253> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37193253_9> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37193253_9" ;
    gutprop:hasSentenceText "There was a certain correlation between anxiety disorder and gut dysbiosis." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37193253> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37207228_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37207228_0" ;
    gutprop:hasSentenceText "How Toll-like receptors influence Parkinson's disease in the microbiome-gut-brain axis." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/37207228> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37207228_1> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37207228_1" ;
    gutprop:hasSentenceText "Recently, a large number of experimenters have found that the pathogenesis of Parkinson's disease may be related to the gut microbiome and proposed the microbiome-gut-brain axis." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37207228> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37209162_1> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37209162_1" ;
    gutprop:hasSentenceText "As common mental disorders, depression and anxiety impact people all around the world." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37209162> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37212075_7> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37212075_7" ;
    gutprop:hasSentenceText "In the present study, IgA-Biome analyses identified a unique proinflammatory microbial signature in the IgA+ fraction of those with AR that would have otherwise been undetected using conventional microbiome analysis approaches." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37212075> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37213508_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37213508_0" ;
    gutprop:hasSentenceText "Global research trends and focus on the link between colorectal cancer and gut flora: a bibliometric analysis from 2001 to 2021." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/37213508> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37213508_1> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37213508_1" ;
    gutprop:hasSentenceText "Colorectal cancer (CRC) is a highly prevalent cancer, and the global healthcare system bears a significant burden due to its incidence." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37213508> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37213508_16> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37213508_16" ;
    gutprop:hasSentenceText "The results suggest that the role of gut microbiota in CRC and its underlying mechanisms should be closely monitored, particularly in the areas of biomarkers, metabolic pathways, and DNA methylation, which may emerge as hot topics in this field." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37213508> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37228957_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37228957_0" ;
    gutprop:hasSentenceText "The microbiota-gut-brain axis and three common neurological disorders: a mini-review." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/37228957> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37228957_11> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37228957_11" ;
    gutprop:hasSentenceText "Gut microbiota has been regarded as a crucial regulator of the gut-brain axis." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37228957> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37228957_12> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37228957_12" ;
    gutprop:hasSentenceText "The discovery of the microbiota-gut-brain axis is described as a major advancement in neuroscience because it influences the pathophysiology of several neurological and psychiatric disorders." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37228957> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37228957_13> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37228957_13" ;
    gutprop:hasSentenceText "From this, more studies of the microbiota-gut-brain axis are needed in the future, to provide a better understanding of brain disorders and so that better treatment and prognosis." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37228957> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37228957_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37228957_2" ;
    gutprop:hasSentenceText "Recently, a large body of research shows that the gut microbiome affects the brain and its conditions, through the gut-brain axis." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37228957> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37368331_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37368331_0" ;
    gutprop:hasSentenceText "Gut Microbiota and Its Repercussion in Parkinson's Disease: A Systematic Review in Occidental Patients." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/37368331> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37368331_19> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37368331_19" ;
    gutprop:hasSentenceText "Phylum: Verrucomicrobiota, its Genus: <i>Akkermansia</i>, and its Species: <i>Akkermansia muciniphila</i>; 2." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37368331> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37368331_21> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37368331_21" ;
    gutprop:hasSentenceText "Genus: <i>Lactobacillus</i> and <i>Roseburia</i> of the Phylum: Firmicutes; 4." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37368331> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37368331_29> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37368331_29" ;
    gutprop:hasSentenceText "Family: <i>Bifidobacteriaceae</i> and <i>Coriobacteriaceae</i> of the Phylum: Actinobacteriota; 3." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37368331> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37368331_30> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37368331_30" ;
    gutprop:hasSentenceText "Phylum: Firmicutes and its Family: <i>Christensenellaceae</i> and <i>Lactobacillaceae</i>; 4." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37368331> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37368331_31> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37368331_31" ;
    gutprop:hasSentenceText "Family: <i>Enterococcaceae</i> and its Genus: <i>Enterococcus</i>, of the Phylum: Firmicutes; 5." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37368331> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37368331_32> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37368331_32" ;
    gutprop:hasSentenceText "Genus: <i>Lactococcus</i> and <i>Oscillospira</i>, of the Phylum: Firmicutes; 6." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37368331> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37368331_34> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37368331_34" ;
    gutprop:hasSentenceText "Genus: <i>ParaBacteroides</i> of the Phylum: Bacteroidetes." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37368331> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37368331_36> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37368331_36" ;
    gutprop:hasSentenceText "Phylum: Firmicutes, its Family: <i>Lachnospiraceae</i>, and its Genus: <i>Roseburia</i> and 2." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37368331> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37368331_9> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37368331_9" ;
    gutprop:hasSentenceText "The following statistically significant results were described in PD patients, compared with non-PD controls." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37368331> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37371676_10> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37371676_10" ;
    gutprop:hasSentenceText "By doing this, the review also introduces the concept of altering an individual's specific gut microbiota as a form of regenerative medicine and potential tailored therapy for joint destruction seen in AI." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37371676> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37371676_11> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37371676_11" ;
    gutprop:hasSentenceText "We hope to show multiple, specific ways to target the microbiome through diet changes, rebalancing microbial diversity, or decreasing specific microbes associated with increased gut permeability, leading to reduced systemic inflammation contributing to joint pathology." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37371676> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37371676_14> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37371676_14" ;
    gutprop:hasSentenceText "By implementing microbial alterations in regenerative medicine, this current study could lend increasing support to the current research on the associations of the gut microbiota, bone metabolism, and AI-related musculoskeletal pathology." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37371676> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37377497_12> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37377497_12" ;
    gutprop:hasSentenceText "In addition to providing novel insights into the mechanisms of triphala polyphenols for promoting stress resilience, blood brain barrier (BBB) permeability and systemic bioavailability of triphala polyphenols also need to be improved by the research community." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37377497> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37377497_4> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37377497_4" ;
    gutprop:hasSentenceText "A major benefit of enhancing stress resilience in at-risk groups is that it may help prevent the onset of stress-induced mental health problems." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37377497> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37396336_1> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37396336_1" ;
    gutprop:hasSentenceText "Physical exercise has been positioned as a promising strategy to prevent and/or alleviate anxiety and depression, but the biological processes associated with its effects on mental health have yet to be entirely determined." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37396336> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37396336_5> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37396336_5" ;
    gutprop:hasSentenceText "Behaviors were then examined in the open field, splash, elevated plus maze, and tail suspension tests." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37396336> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37396336_7> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37396336_7" ;
    gutprop:hasSentenceText "Voluntary exercise reduced anxiety-like behaviors and altered grooming patterns in males exclusively." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37396336> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37400971_3> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37400971_3" ;
    gutprop:hasSentenceText "Therefore, we run a meta-analysis to examine whether maternal microbiota disturbance (MMD) during neurodevelopment might affect the offspring during adulthood." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37400971> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37403161_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37403161_0" ;
    gutprop:hasSentenceText "Overexpression of human alpha-Synuclein leads to dysregulated microbiome/metabolites with ageing in a rat model of Parkinson disease." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/37403161> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37403161_14> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37403161_14" ;
    gutprop:hasSentenceText "Manipulation of the gut bacteria by short-term antibiotic cocktail treatment revealed a complete loss of short-chain fatty acids and a reduction in succinate levels." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37403161> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37403161_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37403161_2" ;
    gutprop:hasSentenceText "Consequently, there is growing interest in understanding how the gut (commensal) microbiome can regulate α-Syn accumulation, as this could potentially lead to PD." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37403161> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37403161_9> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37403161_9" ;
    gutprop:hasSentenceText "We studied a transgenic (TG) rat model overexpressing the human SNCA gene and found that a progressive gut microbial composition alteration characterized by the reduction of Firmicutes to Bacteroidetes ratio could be detected in the young TG rats." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37403161> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37449597_1> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37449597_1" ;
    gutprop:hasSentenceText "This critical review of the literature shows that there is a close link between the microbiome, the gut, and the brain in Parkinson's disease." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37449597> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37449597_5> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37449597_5" ;
    gutprop:hasSentenceText "These findings suggest that the gut microbiome may be a valuable target for new therapeutic strategies for Parkinson's disease." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37449597> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37464164_1> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37464164_1" ;
    gutprop:hasSentenceText "Mice and other rodent models have been widely used to understand the role of the gut microbiome in various neurological and psychiatric disorders." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37464164> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37468912_10> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37468912_10" ;
    gutprop:hasSentenceText "The score of bowel symptoms (stool frequency and abdominal pain) showing greater severity in the LDSD pattern were positively correlated with bai-expressing bacterial abundances and fecal DCA levels separately." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37468912> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37468912_12> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37468912_12" ;
    gutprop:hasSentenceText "It demonstrates that gut microbiota and host co-metabolism of BAs would provide crucial insight into the biology of the LDSD pattern and its internal relationship with IBS progression." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37468912> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37469436_8> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37469436_8" ;
    gutprop:hasSentenceText "Furthermore, scanning electron microscopy imaging showed a sheet-like EPS structure in PS150, while GR1009 displayed no apparent EPS structure." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37469436> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37481569_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37481569_2" ;
    gutprop:hasSentenceText "Previous studies have declared that alterations in the gut microbiota have a great impact on the pathogenesis and clinical picture of Parkinson's disease (PD)." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37481569> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37485386_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37485386_0" ;
    gutprop:hasSentenceText "Prebiotics for depression: how does the gut microbiota play a role?" ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/37485386> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37485386_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37485386_2" ;
    gutprop:hasSentenceText "Prebiotics, which are non-digestible substances selectively utilized by host microorganisms for health benefits, have gained attention for their potential to improve overall wellness and alleviate various disorders including depression." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37485386> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37485386_4> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37485386_4" ;
    gutprop:hasSentenceText "Our findings suggest that GOS at a daily dosage of 5 g and eicosapentaenoic acid at or less than 1 g can effectively mitigate depressive symptoms." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37485386> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37485660_3> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37485660_3" ;
    gutprop:hasSentenceText "Chronic unpredictable mild stress (CUMS)-induced depressive-like symptoms in mice are usually considered as the highest similarity to the situation in humans." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37485660> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37511699_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37511699_0" ;
    gutprop:hasSentenceText "Pharmacomicrobiomics of Antidepressants in Depression: A Systematic Review." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/37511699> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37571393_1> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37571393_1" ;
    gutprop:hasSentenceText "During aging, several tissues and biological systems undergo a progressive decline in function, leading to age-associated diseases such as neurodegenerative, inflammatory, metabolic, and cardiovascular diseases and cancer." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37571393> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37576972_12> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37576972_12" ;
    gutprop:hasSentenceText "Importantly, our diagnostic model based on five microorganisms established by decision tree analysis could effectively distinguish between patients with and without MetS (AUC = 0.94)." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37576972> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37576972_5> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37576972_5" ;
    gutprop:hasSentenceText "We assessed the variations of gut microbiome between both groups and explored potential associations between intestinal microbiota and parameters of MetS." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37576972> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37576972_8> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37576972_8" ;
    gutprop:hasSentenceText "The fecal microbial diversity significantly differed between groups with or without MetS (α-diversity (Shannon index and Simpson index): p=0.0155, p=0.0089; β-diversity: p=0.001)." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37576972> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37577447_7> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37577447_7" ;
    gutprop:hasSentenceText "The contribution ratio of oral microbiota to intestinal microbiota composition in AD is 5.26% based on Source Tracker，and the AD with ectopic colonization showed the daily maximum standard drinks, red blood cell counts, hemoglobin content, and PACS scores decreasing (all <i>p</i> < 0.05)." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37577447> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37577447_8> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37577447_8" ;
    gutprop:hasSentenceText "Results highlight the connection between oral-gut microbiota in AD and suggest novel potential mechanistic possibilities." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37577447> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37606895_5> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37606895_5" ;
    gutprop:hasSentenceText "Long-term sequelae of SARS-CoV2 infection may persist even after recovery from COVID-19." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37606895> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37606895_7> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37606895_7" ;
    gutprop:hasSentenceText "Post-COVID-19 IBS may pose a substantial healthcare burden to society." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37606895> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37607587_7> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37607587_7" ;
    gutprop:hasSentenceText "Because healthier cognitive phenotypes are observed in individuals with more distinct microbiomes, increased efforts are warranted to develop therapeutic strategies for those at increased risk of developing neurological disorders and patients diagnosed with those disorders." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37607587> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37624502_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37624502_2" ;
    gutprop:hasSentenceText "More and more studies have emphasized the influence of the gut microbiome on schizophrenia (SCZ)." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37624502> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37627638_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37627638_0" ;
    gutprop:hasSentenceText "Multi-Omics Approach Reveals Prebiotic and Potential Antioxidant Effects of Essential Oils from the Mediterranean Diet on Cardiometabolic Disorder Using Humanized Gnotobiotic Mice." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/37627638> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37627638_6> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37627638_6" ;
    gutprop:hasSentenceText "These findings provide compelling evidence of the prebiotic and antioxidant actions of thyme- and oregano-derived essential oils, which extend to cardiac function." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37627638> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37627638_7> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37627638_7" ;
    gutprop:hasSentenceText "These results encourage further investigation into the promising utility of essential oils derived from herbs commonly used in the Mediterranean diet as potential nutraceutical interventions for mitigating chronic diseases linked to CAD and T2DM." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37627638> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37676767_6> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37676767_6" ;
    gutprop:hasSentenceText "We analyze the gut microbiome, motor behavior, and gastrointestinal and brain pathologies." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37676767> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37764088_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37764088_0" ;
    gutprop:hasSentenceText "Altered Gut Microbiota Composition Is Associated with Difficulty in Explicit Emotion Regulation in Young Children." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/37764088> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37764088_10> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37764088_10" ;
    gutprop:hasSentenceText "Our results show that children with EER-risk (an index of inhibitory self-control) had a higher abundance of the genera <i>Actinomyces</i> and <i>Sutterella</i>." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37764088> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37764088_4> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37764088_4" ;
    gutprop:hasSentenceText "Gut microbiota (GM) has attracted attention as a potential biomarker for risk of physical and mental problems in adulthood." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37764088> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37764088_9> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37764088_9" ;
    gutprop:hasSentenceText "GM composition (alpha/beta diversity and genus abundance) was evaluated using 16S rRNA gene sequencing and compared between EF-risk and non-risk groups." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37764088> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37764277_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37764277_0" ;
    gutprop:hasSentenceText "Therapeutic Effects of Baicalin on Diseases Related to Gut-Brain Axis Dysfunctions." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/37764277> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37764277_3> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37764277_3" ;
    gutprop:hasSentenceText "Baicalin, a bioactive flavonoid extracted from <i>Scutellaria baicalensis</i>, is reported to exert various pharmacological effects." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37764277> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37834373_5> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37834373_5" ;
    gutprop:hasSentenceText "Furthermore, changes within the microbial community have been linked to the pathogenesis of Parkinson's disease and Alzheimer's disease." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37834373> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37841274_6> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37841274_6" ;
    gutprop:hasSentenceText "Herpesvirus is also linked with gut dysbiosis and inflammation." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37841274> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37845499_6> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37845499_6" ;
    gutprop:hasSentenceText "For example, oral microbiota imbalance and associated periodontitis might increase the risk for neuropsychiatric disorders." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37845499> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37845499_8> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37845499_8" ;
    gutprop:hasSentenceText "This article provides an overview of the emerging role of the host microbiota in neuropsychiatric disorders and discusses future directions, such as underlying biological mechanisms, reliable biomarkers associated with the host microbiota, and microbiota-targeted interventions, for research in this field." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37845499> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37849234_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37849234_0" ;
    gutprop:hasSentenceText "Microbiota from Alzheimer's patients induce deficits in cognition and hippocampal neurogenesis." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/37849234> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37881577_4> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37881577_4" ;
    gutprop:hasSentenceText "Nevertheless, patients with PTSD harbor a proinflammatory milieu and dysbiotic gut microbiota." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37881577> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37881577_9> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37881577_9" ;
    gutprop:hasSentenceText "The RSDS mice harbor a heightened proinflammatory gut environment and microbiota dysbiosis." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37881577> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37900921_1> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37900921_1" ;
    gutprop:hasSentenceText "Gut-microbiome-derived metabolites, such as 4-Ethylphenol [4EP], have been shown to modulate neurological health and function." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37900921> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37900921_4> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37900921_4" ;
    gutprop:hasSentenceText "We have reviewed the existing literature and discuss mechanisms that are proposed to contribute influx from the gut microbiome, metabolism, and excretion of 4EP." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37900921> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37900921_6> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37900921_6" ;
    gutprop:hasSentenceText "Similarly, kidney dysfunction, another complication observed in autistic individuals, impacts clearance of 4EP and its derivatives from circulation." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37900921> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37927130_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37927130_0" ;
    gutprop:hasSentenceText "<i>Lactobacillus reuteri</i> ATG-F4 Alleviates Chronic Stress-induced Anhedonia by Modulating the Prefrontal Serotonergic System." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/37927130> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37927130_7> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37927130_7" ;
    gutprop:hasSentenceText "Serum and brain metabolite concentrations involved in tryptophan metabolism were regulated by CUS and F4." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37927130> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37960197_1> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37960197_1" ;
    gutprop:hasSentenceText "Various studies have highlighted the important associations between obstructive sleep apnea (OSA) and gut microbiota and related metabolites." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37960197> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37960197_3> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37960197_3" ;
    gutprop:hasSentenceText "Multiple mendelian randomization (MR) analyses were performed to genetically predict the causative impact of 196 gut microbiota and 83 metabolites on OSA." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37960197> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37978477_1> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37978477_1" ;
    gutprop:hasSentenceText "The brain-gut axis has gained increasing attention due to its contribution to the etiology of various central nervous system disorders." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37978477> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37978477_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37978477_2" ;
    gutprop:hasSentenceText "This study aims to elucidate the hypothesis that schizophrenia is associated with disturbances in intestinal microflora and imbalance in intestinal metabolites." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37978477> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37978477_5> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37978477_5" ;
    gutprop:hasSentenceText "Here, we identified 20 dominant disturbances in the gut microbial composition of patients compared with healthy controls, with 3 orders, 4 families, 9 genera, and 4 species." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37978477> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37978477_9> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37978477_9" ;
    gutprop:hasSentenceText "These findings suggest a possible interactive influence of the gut microbiota and their metabolites on the pathophysiology of schizophrenia." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37978477> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37995075_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37995075_0" ;
    gutprop:hasSentenceText "Microbiota Alters and Its Correlation with Molecular Regulation Underlying Depression in PCOS Patients." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/37995075> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37995075_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37995075_2" ;
    gutprop:hasSentenceText "Accumulating evidence suggests that human gut microbiomes are associated with the progression of PCOS and depression." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37995075> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37995075_7> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37995075_7" ;
    gutprop:hasSentenceText "Bacteroides eggerthii was a potential gut microbial biomarker for the PCOS-DP." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37995075> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37995475_11> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37995475_11" ;
    gutprop:hasSentenceText "This study implies that using metabolomics and proteomics approaches to study the role of microbiota in sleep disorders might prove beneficial." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37995475> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38010793_13> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38010793_13" ;
    gutprop:hasSentenceText "These metabolomics findings further support the modulating role of gut microbiota on the associations of unbalanced dietary intake with GI symptoms." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38010793> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38010793_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38010793_2" ;
    gutprop:hasSentenceText "Growing evidence has shown the alterations in the gut microbiota and gut microbiota-derived metabolites in ASD." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38010793> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38010793_3> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38010793_3" ;
    gutprop:hasSentenceText "However, how the altered microbiota might affect the associations between unbalanced diets and GI symptoms in ASD remains unknown." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38010793> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38010793_9> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38010793_9" ;
    gutprop:hasSentenceText "BR31</i> negatively modulated their associations in ASD children (P-value <0.05)." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38010793> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38011787_5> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38011787_5" ;
    gutprop:hasSentenceText "Preliminary exploration of the molecular mechanism underlying CPT's antidepressant effects via transcriptomics analysis and molecular docking indicated that CPT might exert its influence by regulating the PI3K-AKT pathway." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38011787> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38026003_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38026003_0" ;
    gutprop:hasSentenceText "The importance of the intestinal microbiota in humans and dogs in the neonatal period." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/38026003> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38026003_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38026003_2" ;
    gutprop:hasSentenceText "This review examines the importance of intestinal microbiota in humans and dogs, aiming to elucidate the distinct characteristics and variations in the composition between these two species." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38026003> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38026003_8> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38026003_8" ;
    gutprop:hasSentenceText "Understanding the complex dynamics of the intestinal microbiota in both humans and dogs is crucial for devising effective strategies to promote health and manage disease." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38026003> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38068763_4> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38068763_4" ;
    gutprop:hasSentenceText "(3) Results: Depressive symptoms were observed in 45% of 200 bariatric patients." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38068763> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38068763_8> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38068763_8" ;
    gutprop:hasSentenceText "(4) Conclusions: the noted differences in the composition of the gut microbiota (RYGB vs. SG) may be one of the determinants of the proper functioning of the gut-brain microbiota axis, although there is currently a need for further research into this topic using a larger group of patients and different probiotic doses." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38068763> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38089822_5> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38089822_5" ;
    gutprop:hasSentenceText "In this study, we conducted MR analysis between large-scale GWAS data of GMs and insomnia to uncover potential associations." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38089822> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38089822_8> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38089822_8" ;
    gutprop:hasSentenceText "In reverse MR analysis, we discovered a causal link between insomnia and six other GM taxa." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38089822> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38123016_1> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38123016_1" ;
    gutprop:hasSentenceText "The gut-brain axis is gaining more attention in neurodevelopmental disorders, especially autism spectrum disorder (ASD)." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38123016> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38123016_4> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38123016_4" ;
    gutprop:hasSentenceText "Developing microbiota-based interventions such as probiotics, gastrointestinal (GI) microbiota transplantation, or metabolite supplementation may offer an exciting approach to treating ASD." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38123016> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38132705_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38132705_2" ;
    gutprop:hasSentenceText "To highlight associations between history of homelessness and the gut microbiome, we compared the gut microbiome of veterans who reported having a previous experience of homelessness to those from individuals who reported never having experienced a period of homelessness." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38132705> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38132705_6> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38132705_6" ;
    gutprop:hasSentenceText "A lifetime history of homelessness was found to be associated with alcohol use disorder, substance use disorder, and healthy eating index compared to those without such a history." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38132705> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38132705_8> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38132705_8" ;
    gutprop:hasSentenceText "The microbial community differences were, in part, driven by a lower relative abundance of <i>Akkermansia</i> in veterans who had experienced homelessness (mean; range [in percentages], 1.07; 0-33.9) compared to veterans who had never been homeless (2.02; 0-36.8) (<i>P</i> = 0.014, ancom-bc2)." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38132705> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38139446_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38139446_0" ;
    gutprop:hasSentenceText "A Pilot Interaction Analysis of Gut Microbiota and Peripheral Markers of Aging in Severe Psychiatric Disorders: A Role for <i>Lachnoclostridium</i>?" ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/38139446> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38139446_3> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38139446_3" ;
    gutprop:hasSentenceText "In this study, we present findings from a secondary interaction analysis of gut microbiota, aging, and inflammatory marker data from a cohort of patients with different diagnoses of severe mental disorders." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38139446> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38139446_5> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38139446_5" ;
    gutprop:hasSentenceText "We performed 16S rRNA sequencing as well as measurement of telomere length via quantitative fluorescence in situ hybridization and high-sensitivity C-reactive protein." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38139446> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38139446_7> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38139446_7" ;
    gutprop:hasSentenceText "Our results showed statistically significant interactions between telomere length and gut microbiota pointing to the genus <i>Lachnostridium</i>, which remained significantly associated with a reduced likelihood of MDD even after adjustment for a series of covariates." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38139446> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38139446_8> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38139446_8" ;
    gutprop:hasSentenceText "Although exploratory, these findings show that specific gut microbiota signatures overexpressing <i>Lachnoclostridium</i> and interacting with biological aging could modulate the liability for MDD." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38139446> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38203207_1> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38203207_1" ;
    gutprop:hasSentenceText "Bacteria in the gut microbiome play an intrinsic part in immune activation, intestinal permeability, enteric reflex, and entero-endocrine signaling." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38203207> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38203207_4> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38203207_4" ;
    gutprop:hasSentenceText "Signals from the CNS are returned to entero-epithelial cells (EES) via efferent VN fibers and communicate with 100 to 500 million neurons in the submucosa and myenteric plexus of the gut wall, which is referred to as the enteric nervous system (ENS)." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38203207> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38203207_7> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38203207_7" ;
    gutprop:hasSentenceText "The more we decipher the gut microbiome and understand its effect on neurotransmission, the closer we may get to developing novel therapeutic and psychobiotic compounds to improve cognitive functions and prevent mental disorders." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38203207> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38204948_8> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38204948_8" ;
    gutprop:hasSentenceText "Recently, more research has begun to focus on the gut-brain axis, addressing the nutritional needs of PCOS patients." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38204948> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38229613_7> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38229613_7" ;
    gutprop:hasSentenceText "Observations from this study support the other global research on the PD gut microbiome background and provide fresh insight into the gut microbial composition of PD patients from a south Indian population." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38229613> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38247868_3> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38247868_3" ;
    gutprop:hasSentenceText "Evidence suggests that varying levels of neuroinflammation might underlie these states in IBD patients." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38247868> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38260914_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38260914_2" ;
    gutprop:hasSentenceText "The pathophysiological model of rosacea involves an unbalanced immune system predisposed to excessive inflammation, in addition to vascular and nervous alterations, being certain cutaneous microorganisms' triggers of the symptoms onset." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38260914> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38260914_8> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38260914_8" ;
    gutprop:hasSentenceText "Through this review we aim to establish and compile the basics and directions of current knowledge to understand the mechanisms by which the microbiome influences the pathogenesis of rosacea, and how modulation of the skin and gut microbiota could benefit these patients." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38260914> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38278499_5> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38278499_5" ;
    gutprop:hasSentenceText "Our main finding was that self-reported alcohol use was negatively correlated with serum concentrations of hippuric acid in the GP cohort." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38278499> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38292207_11> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38292207_11" ;
    gutprop:hasSentenceText "In this review, we explore the few but relevant studies performed on canine anxiety disorders." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38292207> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38292207_12> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38292207_12" ;
    gutprop:hasSentenceText "We agree that innovative bacterial therapeutical approaches for canine anxiety disorders will become a promising field of investigation and certainly pave the way for new approaches to these behavioral conditions." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38292207> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38292207_3> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38292207_3" ;
    gutprop:hasSentenceText "Moreover, these anxiety disorders can potentially result in the abandonment or euthanasia of dogs." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38292207> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38292207_7> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38292207_7" ;
    gutprop:hasSentenceText "The disruption of a balanced composition of resident commensal communities, or dysbiosis, is implicated in several pathological conditions, including mental disorders such as anxiety." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38292207> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38292207_9> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38292207_9" ;
    gutprop:hasSentenceText "Furthermore, novel therapeutic strategies using prebiotics and probiotics have been shown to ameliorate anxiety-related symptoms." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38292207> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38302874_17> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38302874_17" ;
    gutprop:hasSentenceText "The results of our pilot study provide the basis for new biomarkers and innovative therapies targeting the microbiota or serotonin pathways in PIPO patients." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38302874> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38302874_4> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38302874_4" ;
    gutprop:hasSentenceText "The neurotransmitter 5-hydroxytryptamine (5-HT) (or serotonin) is linked to intestinal peristalsis and secretory reflexes." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38302874> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38302874_5> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38302874_5" ;
    gutprop:hasSentenceText "Gut microbiota and its interplay with ENS affect 5-HT synthesis, release, and the subsequent serotonin receptor activation." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38302874> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38302874_6> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38302874_6" ;
    gutprop:hasSentenceText "To date, the interplay between 5-HT and gut microbiota in PIPO remains largely unclear." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38302874> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38302874_9> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38302874_9" ;
    gutprop:hasSentenceText "After DNA extraction, the MAM was assessed by next generation sequencing (NGS) of the V3-V4 region of the bacterial RNA 16 S, on an Illumina Miseq platform." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38302874> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38331354_1> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38331354_1" ;
    gutprop:hasSentenceText "Depression frequently occurs in patients with liver cirrhosis, yet the reasons for this correlation are not fully understood." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38331354> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38331354_7> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38331354_7" ;
    gutprop:hasSentenceText "Additionally, there were positive or negative correlations between the relative abundance of microbiome and behavioral data or blood metabolites (or lipids)." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38331354> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38350463_1> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38350463_1" ;
    gutprop:hasSentenceText "The objective of this study was to evaluate the influence of a probiotic formula on the production of neuroactive compounds in different parts of the colon in batch culture and in vitro gut simulator experiments." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38350463> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38350463_9> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38350463_9" ;
    gutprop:hasSentenceText "Different microbiota composition was found in the three different parts of the colon, with a higher abundance of Veillonellaceae in the ascending colon vessels." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38350463> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38401573_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38401573_0" ;
    gutprop:hasSentenceText "A role of gut-brain axis on prophylactic actions of arketamine in male mice exposed to chronic restrain stress." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/38401573> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38401573_1> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38401573_1" ;
    gutprop:hasSentenceText "The gut-brain axis, which includes gut microbiota and microbiome-derived metabolites, might be implicated in depression." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38401573> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38409102_14> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38409102_14" ;
    gutprop:hasSentenceText "At the genus level, Lactobacillus, Lachnospiraceae_Incertae_Sedis, and Barnesiella exhibited sex-specific alterations, displaying opposing abundances in each sex." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38409102> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38409102_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38409102_2" ;
    gutprop:hasSentenceText "Yet, individual responses to such stress vary, with some people developing stress-induced psychopathologies while others exhibit resilience." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38409102> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38422755_13> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38422755_13" ;
    gutprop:hasSentenceText "The gut microbiota profile of patients with malnutrition might help us to predict worse clinical outcomes." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38422755> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38422755_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38422755_2" ;
    gutprop:hasSentenceText "The gut microbiota has an important role in the host's metabolic and muscular health: however, its interplay with disease-related malnutrition is not well understood." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38422755> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38422755_3> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38422755_3" ;
    gutprop:hasSentenceText "We aimed to identify the association of malnutrition with the gut microbiota and predict clinical outcomes in hospitalized acutely ill older adults." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38422755> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38432867_4> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38432867_4" ;
    gutprop:hasSentenceText "In recent years, studies have suggested that there is gut microbiota disorder in TAO, and the risk factors of TAO can promote gut microbiota disorder." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38432867> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38508549_1> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38508549_1" ;
    gutprop:hasSentenceText "With the development of gut microbiota-specific interventions for mental disorders, the interactions between plant polysaccharides and microbiota in the intestinal and their consequent effects are becoming increasingly important." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38508549> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38508549_6> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38508549_6" ;
    gutprop:hasSentenceText "According to this review, monosaccharide glucose and structure -4-α-Glcp-(1→ are the most potent compositions of the most reported plant polysaccharides." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38508549> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38525261_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38525261_0" ;
    gutprop:hasSentenceText "Impact of dietary fiber on gut microbiota composition, function and gut-brain-modules in healthy adults - a systematic review protocol." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/38525261> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38525261_7> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38525261_7" ;
    gutprop:hasSentenceText "We endeavor to perform a systematic review in order to identify studies reporting compositional gut microbiota alterations after interventions with dietary fiber in healthy individuals." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38525261> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38606411_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38606411_2" ;
    gutprop:hasSentenceText "Prior research has unequivocally demonstrated variations in the diversity and abundance of gut microbiota among individuals with insomnia disorder." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38606411> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38606411_4> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38606411_4" ;
    gutprop:hasSentenceText "This study aims to evaluate the impairment of the intestinal barrier in individuals with insomnia disorder by scrutinizing the serum functionality of this barrier." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38606411> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38606411_9> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38606411_9" ;
    gutprop:hasSentenceText "Compared to the healthy control group, the insomnia disorder group exhibited significantly elevated scores on subjective mood and sleep scales (GAD-7, PHQ-9, HAMA, HAMD, PSQI, and ISI) (P < 0.05)." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38606411> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38613087_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38613087_2" ;
    gutprop:hasSentenceText "Dysbiosis, a disturbance in the gut microbiome equilibrium, can significantly impact the MGB axis, leading to alterations in microbial composition and function." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38613087> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38613087_3> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38613087_3" ;
    gutprop:hasSentenceText "Emerging evidence highlights the connection between microbiota alterations and neurological and psychiatric disorders, including depression." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38613087> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38613087_9> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38613087_9" ;
    gutprop:hasSentenceText "As our understanding of the microbiome's role in health and disease grows, probiotics emerge as promising agents for addressing mental health issues, providing new avenues for therapeutic interventions in depressive disorders." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38613087> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38664425_8> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38664425_8" ;
    gutprop:hasSentenceText "Despite inconsistent changes in GM composition, the meta-analysis showed that microbiome-modulating interventions improved disease burden (SMD, - 0.57; 95% CI - 0.93 to - 0.21; I<sup>2</sup> = 42%; P = 0.002) with a qualitative trend of improvement in constipation." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38664425> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38679353_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38679353_0" ;
    gutprop:hasSentenceText "Association between increased and decreased gut microbiota abundance and Parkinson's disease: A systematic review and subgroup meta-analysis." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/38679353> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38679353_6> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38679353_6" ;
    gutprop:hasSentenceText "A total of 14 studies with 1045 PD cases and 821 healthy controls were included for data extraction and meta-analysis." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38679353> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38686220_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38686220_0" ;
    gutprop:hasSentenceText "Safety and efficacy of faecal microbiota transplantation in patients with mild to moderate Parkinson's disease (GUT-PARFECT): a double-blind, placebo-controlled, randomised, phase 2 trial." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/38686220> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38686220_1> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38686220_1" ;
    gutprop:hasSentenceText "Dysregulation of the gut microbiome has been implicated in Parkinson's disease (PD)." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38686220> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38686220_12> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38686220_12" ;
    gutprop:hasSentenceText "Full data analysis was possible for 21 participants in the healthy donor group and 22 in the placebo group." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38686220> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38686220_13> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38686220_13" ;
    gutprop:hasSentenceText "After 12 months, the MDS-UPDRS motor score significantly improved by a mean of 5.8 points (95% CI -11.4 to -0.2) in the healthy donor group and by 2.7 points (-8.3 to 2.9) in the placebo group (p = 0.0235)." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38686220> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38686220_16> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38686220_16" ;
    gutprop:hasSentenceText "These findings highlight the potential of modulating the gut microbiome as a therapeutic approach and warrant a further exploration of FMT in larger cohorts of patients with PD in various disease stages." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38686220> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38686220_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38686220_2" ;
    gutprop:hasSentenceText "This study aimed to evaluate the clinical effects and safety of a single faecal microbiota transplantation (FMT) in patients with early-stage PD." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38686220> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38707924_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38707924_0" ;
    gutprop:hasSentenceText "The influence of the gut-brain axis on anxiety and depression: A review of the literature on the use of probiotics." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/38707924> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38707924_4> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38707924_4" ;
    gutprop:hasSentenceText "Thus, this study analysed published literature on anxiety, depression, and probiotic supplementation from PubMed and Scopus, focusing on the last twenty years." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38707924> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38707924_7> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38707924_7" ;
    gutprop:hasSentenceText "By comparing the different works analysed, it was possible to identify a strategy by which they are selected and employed and, at the same time, to assess how the effect of probiotics can be optimised using postbiotics, an innovation to improve mental well-being in humans." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38707924> .

