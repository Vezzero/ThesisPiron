    rdfs:label "Malignant Neoplasms" ;
    rdfs:comment "Malignant Neoplasms are abnormal and uncontrolled cell growths that invade and damage surrounding tissues and organs, often resulting in serious health consequences or death. [Definition Source: llama3-8b-8192]"^^xsd:string,
