<http://purl.obolibrary.org/obo/NCIT_C17741> a owl:NamedIndividual,
        skos:Concept,
        <https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding> ;
    rdfs:label "Oxidative Stress" ;
    rdfs:comment "A disturbance in the prooxidant-antioxidant balance in favor of the former, leading to potential damage. Indicators of oxidative stress include damaged DNA bases, protein oxidation products, and lipid peroxidation products.  The damage to biological tissues is caused by superoxide and other free radicals generated by many factors, including exposure to alcohol, medications, trauma, cold, toxins, and radiation or by antimicrobial cellular immunity, metabolic abnormality, or \"normal\" aging; not synonymous with hypoxia or hyperoxia.  Oxidative stress promotes a range of degenerative disorders, including cancer, diabetes, premature aging, Alzheimer's, and many others. [Definition Source: NCIT]",
        "NCIT Match" ;
    skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/DiseaseDisorderOrFinding> ;
    gutprop:affect <http://purl.obolibrary.org/obo/NCIT_C2866> ;
    gutprop:containedIn <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/230b5df35d447765>,
        <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/b6db063012866258>,
        <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/cc1072fa4c4e2fe6> .

<http://purl.obolibrary.org/obo/NCIT_C34423> a owl:NamedIndividual,
        skos:Concept,
        <https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding> ;
    rdfs:label "Bipolar Disorder" ;
    rdfs:comment "A disorder of the brain that causes unusual shifts in mood, energy, activity levels and the ability to carry out day-to-day tasks. Often these moods range and shift from periods of elation and energized behavior to those of hopelessness and depression. [Definition Source: NCIT]",
        "NCIT Match" ;
    skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/DiseaseDisorderOrFinding> ;
    gutprop:affect <http://purl.obolibrary.org/obo/NCIT_C16877>,
