<https://w3id.org/hereditary/ontology/gutbrain/resource/human/CrewMembers> a owl:NamedIndividual,
        skos:Concept,
        gutprop:Human ;
    rdfs:label "Crew Members" ;
    dcterms:creator "Samuel Piron" ;
    rdfs:comment "\"Crew_members\" refers to individuals who are part of a team or group responsible for operating, maintaining, or supporting a vehicle, aircraft, spacecraft, or other complex system. [Definition Source: llama3-8b-8192]" ;
    skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/Human> ;
    gutprop:containedIn <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/60ed501533683fa0> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/human/DonorGroup> a owl:NamedIndividual,
        skos:Concept,
        gutprop:Human ;
    rdfs:label "Donor Group" ;
    dcterms:creator "Samuel Piron" ;
    rdfs:comment "A donor group is a collection of individuals or entities that donate biological materials, such as tissues, cells, or organs, for research, transplantation, or other purposes. [Definition Source: llama3-8b-8192]" ;
    skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/Human> ;
    gutprop:containedIn <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/073529e1bf1f9256> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/human/EpilepticPatients> a owl:NamedIndividual,
        skos:Concept,
        gutprop:Human ;
    rdfs:label "Epileptic Patients" ;
    dcterms:creator "Samuel Piron" ;
    rdfs:comment "Epileptic_patients refers to individuals who have been diagnosed with epilepsy, a neurological disorder characterized by recurrent seizures. [Definition Source: llama3-8b-8192]" ;
    skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/Human> ;
    gutprop:containedIn <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/b6fed1b4b83eb5f3> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/human/InsomniaDisorderGroup> a owl:NamedIndividual,
        skos:Concept,
        gutprop:Human ;
    rdfs:label "Insomnia Disorder Group" ;
    dcterms:creator "Samuel Piron" ;
    rdfs:comment "Insomnia disorder group refers to a cluster of sleep disorders characterized by difficulty initiating or maintaining sleep, or both, despite adequate opportunity and circumstances for sleep, and resulting in daytime impairment or distress. [Definition Source: llama3-8b-8192]" ;
    skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/Human> ;
    gutprop:containedIn <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/e405554df4a13558>,
