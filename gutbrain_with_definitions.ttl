        <http://purl.obolibrary.org/obo/NCBITaxon_283168> ;
    gutprop:influence <http://purl.obolibrary.org/obo/NCIT_C4910> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/chemical/SialylAlpha26Lactose> a owl:NamedIndividual,
        skos:Concept,
        gutprop:Chemical ;
    rdfs:label "Sialyl Alpha2 6 Lactose" ;
    dcterms:creator "Samuel Piron" ;
    rdfs:comment "\"Sialyl-alpha-2,6-lactose\" is a type of glycan, specifically a sialylated oligosaccharide, composed of a lactose molecule with a sialic acid residue linked to the 6th carbon of the galactose moiety. [Definition Source: llama3-8b-8192]" ;
    skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/Chemical> ;
    gutprop:containedIn <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/00f8ee8d233e6089>,
        <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/982d099f51db0786> .

gutbrain:contains a owl:ObjectProperty ;
