        skos:Concept,
        gutprop:BiomedicalTechnique ;
    rdfs:label "Neurologic Examination" ;
    rdfs:comment "Assessment of sensory and motor responses and reflexes that is used to determine impairment of the nervous system. [Definition Source: UMLS]",
        "UMLS Match" ;
    skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/BiomedicalTechnique> ;
