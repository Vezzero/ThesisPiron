    rdfs:label "Effects Of Chemotherapy" ;
    rdfs:comment "The entity \"Effects Of Chemotherapy\" refers to the unintended consequences or outcomes resulting from the administration of chemotherapy, including physical, emotional, and cognitive changes. [Definition Source: llama3-8b-8192]"^^xsd:string,
