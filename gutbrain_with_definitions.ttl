<https://uts.nlm.nih.gov/uts/umls/concept/C0051318> a owl:NamedIndividual,
        skos:Concept,
        gutprop:Chemical ;
    rdfs:label "Glua1" ;
    rdfs:comment "An IBOTENIC ACID homolog and glutamate agonist. The compound is the defining agonist for the AMPA subtype of glutamate receptors (RECEPTORS, AMPA). It has been used as a radionuclide imaging agent but is more commonly used as an experimental tool in cell biological studies. [Definition Source: UMLS]",
        "UMLS Match" ;
    skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/Chemical> ;
    gutprop:containedIn <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/7510c8b80563c18d> .

<https://uts.nlm.nih.gov/uts/umls/concept/C0061126> a owl:NamedIndividual,
        skos:Concept,
        gutprop:Chemical ;
    rdfs:label "Gastric Inhibitory Polypeptide Receptor" ;
    rdfs:comment "The gastric inhibitory polypeptide receptor (GIPR) is a G-protein coupled receptor that binds to gastric inhibitory polypeptide (GIP), a hormone involved in glucose-stimulated insulin secretion and glucose homeostasis. [Definition Source: llama3-8b-8192]",
        "UMLS Match" ;
    skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/Chemical> ;
    gutprop:containedIn <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/0fd9eae081aaa66c>,
