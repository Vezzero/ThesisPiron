<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37511699_3> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37511699_3" ;
    gutprop:hasSentenceText "Risk of bias was assessed, and results are presented as a systematic review following PRISMA guidelines." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37511699> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37511699_4> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37511699_4" ;
    gutprop:hasSentenceText "A total of 28 (21 animal, 7 human) studies were included in the review." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37511699> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37511699_6> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37511699_6" ;
    gutprop:hasSentenceText "The majority (n = 22) of studies had at least moderate levels of bias present." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37511699> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37574818_9> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37574818_9" ;
    gutprop:hasSentenceText "© 2023 Society of Chemical Industry." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37574818> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37576972_14> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37576972_14" ;
    gutprop:hasSentenceText "These new findings provide novel insights into a better understanding of this disease and provide the theoretical basis for implementing new interventional therapies in clinical practice." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37576972> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37576972_9> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37576972_9" ;
    gutprop:hasSentenceText "Moreover, the microbial composition was significantly different between the two groups, involving five phyla and 38 genera (p<0.05)." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37576972> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37624502_1> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37624502_1" ;
    gutprop:hasSentenceText "In recent years, attention has been focused on the benefit of greenspace on mental health, and it is suggested this link may vary with the type of greenspace." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37624502> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37624502_10> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37624502_10" ;
    gutprop:hasSentenceText "Tree coverage was consistently associated with microbial composition in both 1500 m (R<sup>2</sup> = 0.007, P = 0.030) and 3000 m (R<sup>2</sup> = 0.007, P = 0.039)." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37624502> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37624502_11> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37624502_11" ;
    gutprop:hasSentenceText "In contrast, there was no association with grass cover in any of the buffer zones." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37624502> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37624502_15> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37624502_15" ;
    gutprop:hasSentenceText "Besides, \"tree coverage\" may present a dominant effect on the important taxonomic composition." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37624502> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37624502_5> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37624502_5" ;
    gutprop:hasSentenceText "Besides, we sink to explore important taxonomic compositions associated with different greenspace types." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37624502> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37624502_7> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37624502_7" ;
    gutprop:hasSentenceText "Three types of greenery coverage were calculated with different circular buffers (800, 1500, and 3000 m) corresponding to individual addresses." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37624502> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37655441_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37655441_2" ;
    gutprop:hasSentenceText "Yet, the verdict is still out on the definitive role of" ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37655441> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37655441_4> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37655441_4" ;
    gutprop:hasSentenceText "The puzzling discrepancies among" ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37655441> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37655441_7> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37655441_7" ;
    gutprop:hasSentenceText "Here, we scrutinize" ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37655441> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37657622_6> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37657622_6" ;
    gutprop:hasSentenceText "Time to complete the Stroop-C had significant negative correlations with bin_31 and bin_32." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37657622> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37657622_7> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37657622_7" ;
    gutprop:hasSentenceText "Bin_55 had significant negative correlations with time to complete the Stroop-C, time to complete the Stroop-CW, and repeated animal words in 60 s but significant positive correlations with correct answers in 120 s on the Stroop-CW." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37657622> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37764088_1> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37764088_1" ;
    gutprop:hasSentenceText "Executive function (EF) consists of explicit emotion regulation (EER) and cognitive control (CC)." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37764088> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37764088_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37764088_2" ;
    gutprop:hasSentenceText "Childhood EER in particular predicts mental and physical health in adulthood." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37764088> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37764088_3> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37764088_3" ;
    gutprop:hasSentenceText "Identifying factors affecting EER development has implications for lifelong physical and mental health." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37764088> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37764088_8> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37764088_8" ;
    gutprop:hasSentenceText "EF was measured using the Mother-Reported Behavior Rating Inventory of Executive Function-Preschool version." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37764088> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37764277_1> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37764277_1" ;
    gutprop:hasSentenceText "The gut-brain axis is an active area of research." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37764277> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37900921_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37900921_2" ;
    gutprop:hasSentenceText "Although the source of such metabolites is becoming better understood, knowledge gaps remain as to the mechanisms by which they enter host circulation, how they are transported in the body, how they are metabolised and excreted, and the way they exert their effects." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37900921> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37960197_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37960197_2" ;
    gutprop:hasSentenceText "Nevertheless, the establishment of causal relationships between these associations remains to be determined." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37960197> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37995475_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37995475_0" ;
    gutprop:hasSentenceText "Guardians of Rest?" ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/37995475> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37995475_9> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37995475_9" ;
    gutprop:hasSentenceText "However, after adjustment for various confounding factors such as BMI, age, and gender, there were no statistical differences among the groups." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37995475> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38045924_4> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38045924_4" ;
    gutprop:hasSentenceText "Among the first-hand microbiota modulation strategies, nutritional interventions represent an easily applicable option in both clinical and home settings." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38045924> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38045924_6> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38045924_6" ;
    gutprop:hasSentenceText "The investigation of the microbiota response to non-pharmacological therapies is an ever-expanding field with the potential to allow the design of increasingly accessible and successful intervention strategies." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38045924> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38132705_4> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38132705_4" ;
    gutprop:hasSentenceText "Microbiome samples underwent genomic sequencing and were analyzed based on alpha diversity, beta diversity, and taxonomic differences." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38132705> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38132705_5> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38132705_5" ;
    gutprop:hasSentenceText "Additionally, demographic information, dietary data, and mental health history were collected." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38132705> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38204948_7> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38204948_7" ;
    gutprop:hasSentenceText "Other studies speculate that abnormal levels of neurotransmitters and neuronal signaling may play a role." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38204948> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38229613_4> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38229613_4" ;
    gutprop:hasSentenceText "Sequenced data were analyzed using web-based tools BugSeq and MicrobiomeAnalyst." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38229613> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38278499_4> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38278499_4" ;
    gutprop:hasSentenceText "Alcohol use was associated with alterations in circulating concentrations of metabolites in both cohorts." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38278499> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38283894_11> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38283894_11" ;
    gutprop:hasSentenceText "Additionally, no substantial publication bias was observed among the studies." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38283894> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38283894_3> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38283894_3" ;
    gutprop:hasSentenceText "The identification of biomarkers may provide insights into the underlying mechanisms and pathophysiology of the disorder." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38283894> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38292207_10> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38292207_10" ;
    gutprop:hasSentenceText "However, regarding the canine veterinary behavior field, there is still a lack of insightful research on this topic." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38292207> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38292207_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38292207_2" ;
    gutprop:hasSentenceText "These disorders are often disregarded in veterinary clinical practice, negatively impacting the animal's and owner's quality of life." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38292207> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38292207_6> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38292207_6" ;
    gutprop:hasSentenceText "These microbes can impact mental health through several mechanisms, including metabolic, neural, endocrine, and immune-mediated pathways." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38292207> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38409102_12> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38409102_12" ;
    gutprop:hasSentenceText "Across the study, alpha diversity remained consistently lower in males compared to females." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38409102> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38508549_7> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38508549_7" ;
    gutprop:hasSentenceText "However, the causal structure-activity relationship remains to be extensively explored." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38508549> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38525261_10> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38525261_10" ;
    gutprop:hasSentenceText "A systematic search of PubMed/MEDLINE and EMBASE, two electronic databases, will be completed." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38525261> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38525261_13> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38525261_13" ;
    gutprop:hasSentenceText "Compositional gut microbial changes have been reported and our review will compile and update these observations after reanalysis of their datasets with a consistent bioinformatic pipeline." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38525261> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38525261_14> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38525261_14" ;
    gutprop:hasSentenceText "From this it may be possible to predict more detailed functional consequences in terms of neuroactive gut brain modules, of the compositional alterations in gut microbial taxa." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38525261> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38576868_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38576868_2" ;
    gutprop:hasSentenceText "However, there has been no bibliometric analysis to summarize and analyze these publications." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38576868> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38576868_5> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38576868_5" ;
    gutprop:hasSentenceText "The analysis was executed using WoSCC's literature analysis tool and VOSviewer 1.6.16." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38576868> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38576868_6> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38576868_6" ;
    gutprop:hasSentenceText "In total, we identified 177 publications originating from 362 institutions across 39 countries/regions, and these articles were disseminated in 104 different journals." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38576868> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38576868_7> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38576868_7" ;
    gutprop:hasSentenceText "The most productive institutions, authors, countries/regions, and journals were Zhejiang University contributing 18 publications, Shaohua Hu authoring 12 publications, China with 53 publications, and <i>Frontiers in Psychiatry</i> with 11 publications." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38576868> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38576868_8> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38576868_8" ;
    gutprop:hasSentenceText "The first high-cited document was published in the Journal of Psychiatric Research in 2017, and authored by Evans." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38576868> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38606411_11> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38606411_11" ;
    gutprop:hasSentenceText "Additionally, there was a decrease in sleep efficiency and alterations in sleep structure (increased proportion of N1 and N3 stages, prolonged N1 stage) (P < 0.05)." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38606411> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38606411_13> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38606411_13" ;
    gutprop:hasSentenceText "Furthermore, significant positive correlations were identified between intestinal epithelial barrier markers and sleep efficiency, while negative correlations were found with wake after sleep onset, total wake time, PSQI, HAMA, and HAMD." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38606411> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38606411_8> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38606411_8" ;
    gutprop:hasSentenceText "Data were analyzed using SPSS 26.0." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38606411> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38613087_8> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38613087_8" ;
    gutprop:hasSentenceText "The increasing acceptance of the expanded concept of the MGB axis underscores the importance of microorganisms in mental well-being." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38613087> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38664425_4> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38664425_4" ;
    gutprop:hasSentenceText "A systematic review of the literature was therefore conducted to investigate the efficacy of microbiome-modulating methods." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38664425> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38664425_5> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38664425_5" ;
    gutprop:hasSentenceText "The search yielded 4051 articles, with 15 clinical trials included." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38664425> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38664425_6> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38664425_6" ;
    gutprop:hasSentenceText "The overall risk of bias was moderate in most studies." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38664425> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38679353_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38679353_2" ;
    gutprop:hasSentenceText "PubMed, Medline, Cochrane Library and other literature datebase platforms were searched for eligible studies in the English-language from conception to March 1, 2024." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38679353> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38679353_7> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38679353_7" ;
    gutprop:hasSentenceText "All the included studies exhibited reasonable quality." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38679353> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38686220_11> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38686220_11" ;
    gutprop:hasSentenceText "Clinical evaluations were performed at baseline, 3, 6, and 12 months post-FMT." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38686220> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38686220_3> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38686220_3" ;
    gutprop:hasSentenceText "The GUT-PARFECT trial, a single-centre randomised, double-blind, placebo-controlled trial was conducted at Ghent University Hospital between December 01, 2020 and December 12, 2022." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38686220> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38686220_9> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38686220_9" ;
    gutprop:hasSentenceText "This completed trial is registered on ClinicalTrials.gov (NCT03808389)." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38686220> .

