        skos:Concept,
        gutprop:Chemical ;
    rdfs:label "Interleukin-17A" ;
    rdfs:comment "Interleukin-17A is a pro-inflammatory cytokine that plays a key role in the immune response, particularly in the activation of immune cells and the regulation of inflammation. [Definition Source: llama3-8b-8192]"^^xsd:string,
        "UMLS Match"^^xsd:string ;
    skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/Chemical> ;
    gutprop:containedIn <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/12eb814a49816e7d> .

