<https://w3id.org/hereditary/ontology/gutbrain/resource/biomedicaltechnique/Photobiomodulation> a owl:NamedIndividual,
        skos:Concept,
        gutprop:BiomedicalTechnique ;
    rdfs:label "Photobiomodulation" ;
    dcterms:creator "Samuel Piron" ;
    rdfs:comment "Photobiomodulation is a non-invasive medical treatment that uses low-intensity laser or light-emitting diodes to stimulate cellular processes, promoting tissue repair, pain relief, and wound healing. [Definition Source: llama3-8b-8192]" ;
    skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/BiomedicalTechnique> ;
