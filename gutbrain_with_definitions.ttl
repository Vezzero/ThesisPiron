<http://purl.obolibrary.org/obo/OMIT_0044699> a owl:NamedIndividual,
        skos:Concept,
        <https://w3id.org/brainteaser/ontology/schema/Gene> ;
    rdfs:label "Elovl6" ;
    rdfs:comment "Elvl6 is a gene that encodes for the enzyme Elongation of Very Long Chain Fatty Acids Protein 6, involved in the synthesis of very long chain fatty acids. [Definition Source: llama3-8b-8192]",
        "OMIT Match" ;
