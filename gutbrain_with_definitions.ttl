        gutprop:Animal ;
    rdfs:label "Rats, Transgenic" ;
    rdfs:comment "Laboratory rats that have been produced from a genetically manipulated rat EGG or rat EMBRYO, MAMMALIAN. They contain genes from another species. [Definition Source: UMLS]",
