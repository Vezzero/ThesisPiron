        <https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34147969_9>,
        <https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38331354_6> ;
    gutprop:taggedAs "chemical",
        "gene" .

<https://w3id.org/hereditary/ontology/gutbrain/resource/mention/ff4a3a1399cc2f13> a owl:NamedIndividual,
        gutprop:Mention ;
    rdfs:label "mention_chemical_smadcam-1",
        "mention_gene_smadcam-1" ;
    gutprop:hasMentionText "sMAdCAM-1" ;
    gutprop:locatedIn <https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36462169_3>,
        <https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36462169_5> ;
    gutprop:taggedAs "chemical",
        "gene" .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/21167931_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_21167931_0" ;
    gutprop:hasSentenceText "Lymphocytes in neuroprotection, cognition and emotion: is intolerance really the answer?" ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/21167931> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/21167931_11> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_21167931_11" ;
    gutprop:hasSentenceText "This reinterpretation of findings relevant to \"protective autoimmunity\" suggests that ongoing, and planned, clinical trials of anti-inflammatory strategies to treat depressive disorders are justified." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/21167931> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/21167931_3> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_21167931_3" ;
    gutprop:hasSentenceText "However, recent studies in specific pathogen-free (SPF) rodents suggest a different--and potentially contradictory--relationship between immune processes and mental health." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/21167931> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/21167931_5> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_21167931_5" ;
    gutprop:hasSentenceText "Indeed, some reported effects of this so-called \"protective autoimmunity\" seem of direct relevance to depressive disorders." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/21167931> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/21167931_6> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_21167931_6" ;
    gutprop:hasSentenceText "These findings pose a dilemma for those intending to manipulate inflammatory pathways as a treatment for depression." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/21167931> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/21167931_9> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_21167931_9" ;
    gutprop:hasSentenceText "We find that \"protective autoimmunity\" is likely to be relevant only to very clean SPF animals that lack normal levels of activated T cells, CNS T cell traffic and mature Treg." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/21167931> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/23981537_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_23981537_0" ;
    gutprop:hasSentenceText "Metabolic features of the cell danger response." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/23981537> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/23981537_3> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_23981537_3" ;
    gutprop:hasSentenceText "The resulting metabolic mismatch between available resources and functional capacity produces a cascade of changes in cellular electron flow, oxygen consumption, redox, membrane fluidity, lipid dynamics, bioenergetics, carbon and sulfur resource allocation, protein folding and aggregation, vitamin availability, metal homeostasis, indole, pterin, 1-carbon and polyamine metabolism, and polymer formation." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/23981537> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/23981537_5> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_23981537_5" ;
    gutprop:hasSentenceText "After the danger has been eliminated or neutralized, a choreographed sequence of anti-inflammatory and regenerative pathways is activated to reverse the CDR and to heal." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/23981537> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/23981537_8> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_23981537_8" ;
    gutprop:hasSentenceText "The systemic form of the CDR, and its magnified form, the purinergic life-threat response (PLTR), are under direct control by ancient pathways in the brain that are ultimately coordinated by centers in the brainstem." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/23981537> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/24103493_5> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_24103493_5" ;
    gutprop:hasSentenceText "This review considers current knowledge of these potential mechanisms that threaten to create an intergenerational cycle of obesity." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/24103493> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/24956966_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_24956966_0" ;
    gutprop:hasSentenceText "Microbiota and neurodevelopmental windows: implications for brain disorders." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/24956966> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/24956966_4> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_24956966_4" ;
    gutprop:hasSentenceText "This review compares the parallel early development of the intestinal microbiota and the nervous system." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/24956966> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/25034760_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_25034760_2" ;
    gutprop:hasSentenceText "This paper reviews these connections and provides a context by which multiple risk factors for schizophrenia may be related." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/25034760> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/25231862_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_25231862_2" ;
    gutprop:hasSentenceText "NAS consumption is considered safe and beneficial owing to their low caloric content, yet supporting scientific data remain sparse and controversial." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/25231862> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/25869281_1> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_25869281_1" ;
    gutprop:hasSentenceText "Gut microbiota play a vital role in maintaining the health of the host." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/25869281> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/25911232_3> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_25911232_3" ;
    gutprop:hasSentenceText "Regulation of the microbiota-brain-gut axis is essential for maintaining homeostasis, including that of the CNS." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/25911232> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/25911232_8> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_25911232_8" ;
    gutprop:hasSentenceText "Finally, the concept of psychobiotics, bacterial-based interventions with mental health benefit, is also emerging." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/25911232> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/25940667_11> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_25940667_11" ;
    gutprop:hasSentenceText "Atopobiosis may contribute to the dynamics of a variety of inflammatory diseases." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/25940667> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/25940667_8> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_25940667_8" ;
    gutprop:hasSentenceText "Another source is microbes translocated from the oral cavity." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/25940667> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/25940667_9> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_25940667_9" ;
    gutprop:hasSentenceText "'Dysbiosis' is also used to describe translocation of cells into blood or other tissues." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/25940667> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/26129950_1> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_26129950_1" ;
    gutprop:hasSentenceText "Increasing evidence suggests that maintenance of homeostasis between gut microbiota and host plays an important role in human health." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/26129950> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/26129950_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_26129950_2" ;
    gutprop:hasSentenceText "Many diseases, such as those affecting the liver, have been linked to imbalances in gut microbial communities." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/26129950> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/26408987_3> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_26408987_3" ;
    gutprop:hasSentenceText "Gut bacteria can communicate with the host through the microbiota-gut-brain axis (which mainly includes the immune, neuroendocrine, and neural pathways) to influence brain and behavior." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/26408987> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/26426677_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_26426677_2" ;
    gutprop:hasSentenceText "Accumulating evidence indicates that the immune system is an important interface between intestinal inflammation and the enteric, sensory, central and autonomic nervous systems." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/26426677> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/26426677_4> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_26426677_4" ;
    gutprop:hasSentenceText "This article reviews some major insights into this complex homeostatic network that have been achieved during the past two years and attempts to put these advances into perspective with novel opportunities of pharmacological intervention." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/26426677> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/26627987_1> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_26627987_1" ;
    gutprop:hasSentenceText "The gut microbiome comprises the collective genome of the trillions of microorganisms residing in our gastrointestinal ecosystem." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/26627987> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/26627987_3> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_26627987_3" ;
    gutprop:hasSentenceText "The purpose of this review is to summarize what is known about the gut microbiome, how it is connected to the development of disease and to identify the bacterial and biochemical targets that should be the focus of future research." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/26627987> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/26627987_4> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_26627987_4" ;
    gutprop:hasSentenceText "Understanding the mechanisms behind the activity and proliferation of the gut microbiome will provide us new insights that may pave the way for novel therapeutic strategies." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/26627987> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/26923630_1> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_26923630_1" ;
    gutprop:hasSentenceText "Emerging evidence indicates that disruption of the gut microbial community (dysbiosis) impairs mental health." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/26923630> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/26923630_7> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_26923630_7" ;
    gutprop:hasSentenceText "Importantly, novel object recognition, but not spatial, memory was impaired in antibiotic-treated mice." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/26923630> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/26927355_1> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_26927355_1" ;
    gutprop:hasSentenceText "The prevalence of diabetes in China has surged from 0.67% before 1980 to 11.6% currently." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/26927355> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/26927355_7> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_26927355_7" ;
    gutprop:hasSentenceText "This is an energy source that may even cause nonalcoholic fatty liver." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/26927355> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/27319972_12> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_27319972_12" ;
    gutprop:hasSentenceText "Even at this juncture, there is evidence to pinpoint key sites of communication where gut microbial interventions either with drugs or diet or perhaps fecal microbiota transplantation may positively impact mental health." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/27319972> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/27319972_4> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_27319972_4" ;
    gutprop:hasSentenceText "That the microbial content of the gut plays a key role in immune development is now beyond doubt." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/27319972> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/27319972_5> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_27319972_5" ;
    gutprop:hasSentenceText "Early disruption of the host-microbe interplay can have lifelong consequences, not just in terms of intestinal function but in distal organs including the brain." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/27319972> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/27698624_3> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_27698624_3" ;
    gutprop:hasSentenceText "While mental health care requires the professional training in counseling, psychotherapy and psychiatry, complimentary therapeutic strategies, such as attention to a nutritional and diverse diet and supplementation of probiotic foods, may be integrated alongside psychotherapy treatment models." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/27698624> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/27698624_6> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_27698624_6" ;
    gutprop:hasSentenceText "A case study demonstrates an example of a biopsychosocial approach integrating cognitive psychotherapy, dietary changes, and mindfulness activities, in treating symptoms of anxiety." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/27698624> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/27763700_1> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_27763700_1" ;
    gutprop:hasSentenceText "Manipulating gut microbes may improve mental health." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/27763700> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/27763700_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_27763700_2" ;
    gutprop:hasSentenceText "Prebiotics are indigestible compounds that increase the growth and activity of health-promoting microorganisms, yet few studies have examined how prebiotics affect CNS function." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/27763700> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/27793225_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_27793225_0" ;
    gutprop:hasSentenceText "The Importance of Diet and Gut Health to the Treatment and Prevention of Mental Disorders." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/27793225> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/27793225_3> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_27793225_3" ;
    gutprop:hasSentenceText "Conversely, a nutrient-rich diet is understood to be protective of mental health, and researchers are now aiming to understand the biological underpinnings of this relationship." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/27793225> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/27793225_4> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_27793225_4" ;
    gutprop:hasSentenceText "The gut microbiota has been proposed as a key mediator of this link, given its association with both diet and mental health." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/27793225> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/27793225_8> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_27793225_8" ;
    gutprop:hasSentenceText "Here we discuss specific, targeted dietary and gut focused strategies for the prevention and treatment of mental disorder." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/27793225> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/27900676_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_27900676_0" ;
    gutprop:hasSentenceText "Functional Implications of the IL-23/IL-17 Immune Axis in Schizophrenia." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/27900676> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/27900676_1> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_27900676_1" ;
    gutprop:hasSentenceText "The aetiology of schizophrenia seems to stem from complex interactions amongst environmental, genetic, metabolic, immunologic and oxidative components." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/27900676> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/27900676_6> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_27900676_6" ;
    gutprop:hasSentenceText "These preliminary observations provide crucial clues about the functional implications of IL-23/IL-17 axis in schizophrenia." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/27900676> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/27900676_7> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_27900676_7" ;
    gutprop:hasSentenceText "In this review, an attempt has been made to highlight the biology of IL-23/IL-17 axis and its relevance to schizophrenia risk and pathogenesis." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/27900676> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/27900676_8> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_27900676_8" ;
    gutprop:hasSentenceText "Given the pathogenic potential of the IL-23/IL-17 axis, therapeutic targeting of this axis may be a promising approach to benefit patients suffering from this devastating disorder." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/27900676> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/27930574_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_27930574_2" ;
    gutprop:hasSentenceText "Discovering new prebiotics is a challenging and arduous task due to strict inclusion criteria; thus, highly limited numbers of prebiotic candidates have been identified." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/27930574> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/27930574_3> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_27930574_3" ;
    gutprop:hasSentenceText "Notably, the large numbers of published studies may contain substantial information attached to various features of known prebiotics that can be used to predict new candidates." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/27930574> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/27930574_8> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_27930574_8" ;
    gutprop:hasSentenceText "Finally, we identified a high-confidence list of candidates of prebiotics that are strongly supported by the literature." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/27930574> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28399458_8> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_28399458_8" ;
    gutprop:hasSentenceText "These results have to be discussed with caution, because information on infants' diseases were based exclusively on maternal self-reports." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/28399458> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28442250_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_28442250_0" ;
    gutprop:hasSentenceText "Analysis of microbiota in first episode psychosis identifies preliminary associations with symptom severity and treatment response." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/28442250> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28572752_1> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_28572752_1" ;
    gutprop:hasSentenceText "<b>Objective</b>: Alterations of gut microbiota composition or function may participate in the pathophysiology of several diseases." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/28572752> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28572752_4> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_28572752_4" ;
    gutprop:hasSentenceText "In addition, a group of healthy controls was included." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/28572752> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28629758_3> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_28629758_3" ;
    gutprop:hasSentenceText "Male C57BL/6 mice experienced social defeat or a control condition once a day for 10 consecutive days." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/28629758> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28629758_7> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_28629758_7" ;
    gutprop:hasSentenceText "and reduced abundance of Turicibacter spp., which were also strongly correlated to social avoidance severity." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/28629758> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28629758_8> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_28629758_8" ;
    gutprop:hasSentenceText "Although at this time a causal connection cannot be inferred, these results point to the possibility that specific clusters of bacterial communities in cecum contents may be linked to vulnerability to social deficits stemming from prolonged social stressor experiences." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/28629758> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28816544_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_28816544_2" ;
    gutprop:hasSentenceText "Despite their high prevalence and mental health impact, affective pathogenesis is poorly understood, and often remains recurrent and resistant to treatment." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/28816544> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28816544_3> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_28816544_3" ;
    gutprop:hasSentenceText "The lack of efficient antidepressants and presently limited conceptual innovation necessitate novel approaches and new drug targets in the field of antidepressant therapy." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/28816544> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28816544_4> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_28816544_4" ;
    gutprop:hasSentenceText "Areas covered: Herein, the authors discuss the emerging role of neuro-immune interactions in affective pathogenesis, which can become useful targets for CNS drug discovery, including modulating neuroinflammatory pathways to alleviate affective pathogenesis." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/28816544> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28843021_6> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_28843021_6" ;
    gutprop:hasSentenceText "Seventy variables, related to demographics, clinical parameters including nonmotor symptoms, and sample processing, were analyzed in relation to microbiome variability and controlled differential analyses were performed." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/28843021> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28843021_9> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_28843021_9" ;
    gutprop:hasSentenceText "Metagenomic sequencing of select samples enabled the reconstruction of genomes of so far uncharacterized differentially abundant organisms." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/28843021> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28852308_7> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_28852308_7" ;
    gutprop:hasSentenceText "Further studies are warranted to establish whether or not the findings of preclinical animal experiments can be generalized to humans." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/28852308> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28976454_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_28976454_0" ;
    gutprop:hasSentenceText "The Gut and Its Microbiome as Related to Central Nervous System Functioning and Psychological Well-being: Introduction to the Special Issue of Psychosomatic Medicine." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/28976454> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28976454_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_28976454_2" ;
    gutprop:hasSentenceText "This article describes new developments in brain-gut interactions as an introduction to a special issue of Psychosomatic Medicine, based on a joint symposium of the American Psychosomatic Society and the American Gastroenterological Association." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/28976454> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/29022384_1> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_29022384_1" ;
    gutprop:hasSentenceText "The acquisition and early maturation of infant microbiota is not well understood despite its likely influence on later health." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/29022384> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/29023380_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_29023380_0" ;
    gutprop:hasSentenceText "The Gut Microbiome Feelings of the Brain: A Perspective for Non-Microbiologists." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/29023380> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/29023380_1> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_29023380_1" ;
    gutprop:hasSentenceText "<b>Objectives:</b> To comprehensively review the scientific knowledge on the gut-brain axis." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/29023380> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/29023380_12> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_29023380_12" ;
    gutprop:hasSentenceText "Nutritional approaches, microbiome manipulations, enteric and brain barrier reinforcement and sensing and trafficking modulation might improve physical and mental health outcomes." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/29023380> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/29023380_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_29023380_2" ;
    gutprop:hasSentenceText "<b>Methods:</b> Various publications on the gut-brain axis, until 31 July 2017, were screened using the Medline, Google, and Cochrane Library databases." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/29023380> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/29023380_5> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_29023380_5" ;
    gutprop:hasSentenceText "<b>Results:</b> Tremendous progress has been made in exploring the interactions between nutrients, the microbiome, and the intestinal, epithelium-enteric nervous, endocrine and immune systems and the brain." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/29023380> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/29023380_6> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_29023380_6" ;
    gutprop:hasSentenceText "The basis of the gut-brain axis comprises of an array of multichannel sensing and trafficking pathways that are suggested to convey the enteric signals to the brain." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/29023380> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/29023380_8> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_29023380_8" ;
    gutprop:hasSentenceText "Their mutual and harmonious but intricate interaction is essential for human life and brain performance." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/29023380> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/29023380_9> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_29023380_9" ;
    gutprop:hasSentenceText "However, a failure in the interaction leads to a number of inflammatory-, autoimmune-, neurodegenerative-, metabolic-, mood-, behavioral-, cognitive-, autism-spectrum-, stress- and pain-related disorders." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/29023380> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/29843470_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_29843470_0" ;
    gutprop:hasSentenceText "Recognizing Depression from the Microbiota⁻Gut⁻Brain Axis." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/29843470> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/29843470_4> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_29843470_4" ;
    gutprop:hasSentenceText "Unfortunately, most of the patients have never received any treatment." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/29843470> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/29955222_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_29955222_0" ;
    gutprop:hasSentenceText "Ancient <i>Thali</i> Diet: Gut Microbiota, Immunity, and Health." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/29955222> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/29955222_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_29955222_2" ;
    gutprop:hasSentenceText "Emerging evidence suggests that above dietary components can directly impact the composition and metabolic activity of the mammalian gut microbiota and in turn, affect both physical and mental health." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/29955222> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/29955222_3> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_29955222_3" ;
    gutprop:hasSentenceText "There is a growing recognition that rise in chronic disease burden in Western countries may due to progressive loss of beneficial bacteria and microbial diversity." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/29955222> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30033172_4> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_30033172_4" ;
    gutprop:hasSentenceText "Diet is a key modifiable environmental factor that modulates the gut microbiota and its metabolic capacities that, in turn, could impact human physiology." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30033172> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30033172_5> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_30033172_5" ;
    gutprop:hasSentenceText "On this basis, the diet and the gut microbiota could act as synergistic forces that provide resilience against disease or that speed the progress from health to disease states." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30033172> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30033172_7> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_30033172_7" ;
    gutprop:hasSentenceText "Translational studies showing that dietary-induced alterations in microbial communities recapitulate some of the pathological features of the original host further support this notion." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30033172> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30072879_10> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_30072879_10" ;
    gutprop:hasSentenceText "MPTP also showed genotype- and sex-dependent effects." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30072879> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30072879_3> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_30072879_3" ;
    gutprop:hasSentenceText "PD symptoms often demonstrate sex differences." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30072879> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30258234_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_30258234_0" ;
    gutprop:hasSentenceText "Microglia in neurodegeneration." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/30258234> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30258234_4> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_30258234_4" ;
    gutprop:hasSentenceText "In response to specific stimuli, or with neuroinflammation, microglia also have the capacity to damage and kill neurons." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30258234> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30258234_8> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_30258234_8" ;
    gutprop:hasSentenceText "Initiation or exacerbation of neurodegeneration results from an imbalance between these microglial functions; correcting such imbalance may be a potential mode for therapy." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30258234> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30394313_6> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_30394313_6" ;
    gutprop:hasSentenceText "Potentially immunogenic epitopes were screened against a predictive human Immune Epitope Database." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30394313> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30405455_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_30405455_0" ;
    gutprop:hasSentenceText "Metabolic and Microbiota Measures as Peripheral Biomarkers in Major Depressive Disorder." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/30405455> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30405455_3> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_30405455_3" ;
    gutprop:hasSentenceText "Through our work and that of others, we have seen an amazing increase in our knowledge of how bacteria signal to the brain and the implications this has for psychiatry." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30405455> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30405455_7> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_30405455_7" ;
    gutprop:hasSentenceText "Enabling stratification of clinical populations, based on individual biological differences, to predict treatment response to pharmacological and non-pharmacological interventions." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30405455> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30518033_10> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_30518033_10" ;
    gutprop:hasSentenceText "Our results suggest that the microbiota, host genetics, and psychological symptoms are strongly related, yet the deeper mechanistic links need further exploration." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30518033> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30518033_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_30518033_2" ;
    gutprop:hasSentenceText "Mounting evidence shows that the gut microbiota play an important role in communication within the gut⁻brain axis." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30518033> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30584306_1> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_30584306_1" ;
    gutprop:hasSentenceText "Gut microbiota can affect human behavior and mood in many ways." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30584306> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30584306_8> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_30584306_8" ;
    gutprop:hasSentenceText "There are totally 13 taxonomic biomarkers with <i>P</i>-value <0.01 from Firmicutes." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30584306> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30659564_3> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_30659564_3" ;
    gutprop:hasSentenceText "There is a rapidly growing number of data that links the gut microbiome to the development and functioning of the central nervous system, which is a currently proposed paradigm shift in neuroscience." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30659564> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30717162_6> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_30717162_6" ;
    gutprop:hasSentenceText "At the end of treatment (W6), no change was observed in the Chao1 index." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30717162> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30717162_9> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_30717162_9" ;
    gutprop:hasSentenceText "The within-subject dissimilarities did not depend on sex, age, BMI, illness duration and a daily dose of escitalopram." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30717162> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30818031_5> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_30818031_5" ;
    gutprop:hasSentenceText "Fecal samples were obtained to assess the gut microbiota." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30818031> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30818031_6> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_30818031_6" ;
    gutprop:hasSentenceText "FCR grade was assessed using the Concerns About Recurrence Scale (CARS)." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30818031> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30826885_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_30826885_0" ;
    gutprop:hasSentenceText "The Relationship Between Perinatal Mental Health and Stress: a Review of the Microbiome." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/30826885> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30826885_5> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_30826885_5" ;
    gutprop:hasSentenceText "Bidirectional communication between the nervous system and the microbiota is an important factor to alter host homeostasis and development of PMAD." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30826885> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30828318_3> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_30828318_3" ;
    gutprop:hasSentenceText "But not to diminish such findings, much still needs to be considered, including the fact that the vagus nerve links to many other body sites that also host a microbiome." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30828318> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30828318_6> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_30828318_6" ;
    gutprop:hasSentenceText "(iii) What role do environmental pollutants play in this microbes-host ecosystem?" ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30828318> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30900006_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_30900006_2" ;
    gutprop:hasSentenceText "Both genetics and environmental factors influence gut microbiota composition and function." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30900006> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30900006_3> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_30900006_3" ;
    gutprop:hasSentenceText "This study examines host-microbe signaling at the gastrointestinal barrier to identify bottom-up mechanisms of microbiota-brain communication." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30900006> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30900006_6> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_30900006_6" ;
    gutprop:hasSentenceText "Significant differences in fecal miRNA profiles were determined using the nCounter NanoString platform." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30900006> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30900006_7> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_30900006_7" ;
    gutprop:hasSentenceText "A BLASTn analysis identified conserved fecal miRNA target regions in bacterial metagenomes with 14 significant correlations found between fecal miRNA and predicted taxa relative abundance in our dataset." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30900006> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31053995_10> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_31053995_10" ;
    gutprop:hasSentenceText "We also suggest a molecular mechanism, explaining our findings, which involves gut microbiota." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31053995> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31053995_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_31053995_2" ;
    gutprop:hasSentenceText "Conversely, current omics techniques allow the investigation of hundreds of molecules potentially altered by disease conditions." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31053995> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31053995_6> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_31053995_6" ;
    gutprop:hasSentenceText "All p-values obtained in different tests were corrected for multiplicity by controlling the false discovery rate (FDR)." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31053995> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31083360_15> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_31083360_15" ;
    gutprop:hasSentenceText "In addition, there was no standardized probiotics regimen, with multiple different strains and concentrations of probiotics, and variable duration of treatments." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31083360> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31083360_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_31083360_2" ;
    gutprop:hasSentenceText "Despite its prevalence (affecting 0.1% to 1.8% of the global population), the pathogenesis of ASD remains incompletely understood." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31083360> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31132457_1> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_31132457_1" ;
    gutprop:hasSentenceText "One of the key behavioral phenotypes in infancy are different temperament traits, and certain early life temperament traits have been shown to precede later mental health problems." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31132457> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31132457_5> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_31132457_5" ;
    gutprop:hasSentenceText "The study population (n = 301, 53% boys) was drawn from the FinnBrain Birth Cohort Study." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31132457> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31154909_6> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_31154909_6" ;
    gutprop:hasSentenceText "In conclusion, it appears that BCM-7 might have multiple functions pertinent to human health; however, the evidence is limited and warrants further pre-clinical and clinical studies for hypothesis confirmation." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31154909> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31179435_8> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_31179435_8" ;
    gutprop:hasSentenceText "Quality evaluation for each included study was done using the Cochrane risk of bias and the Jadad scale." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31179435> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31218116_11> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_31218116_11" ;
    gutprop:hasSentenceText "It is hypothesized that participants in the HIIT+ will experience improvements in all outcomes when compared to those in the WLC." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31218116> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31218116_8> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_31218116_8" ;
    gutprop:hasSentenceText "WLC participants will be offered a 12-week HIIT program + online lifestyle education sessions after completing the final assessment." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31218116> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31218116_9> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_31218116_9" ;
    gutprop:hasSentenceText "The primary outcomes are QoL and gut microbiota composition assessed with 16S rRNA sequencing." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31218116> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31248424_8> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_31248424_8" ;
    gutprop:hasSentenceText "In contrast, Prevotella was more abundant in controls." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31248424> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31255682_6> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_31255682_6" ;
    gutprop:hasSentenceText "We found that MD index was positively correlated with MEs diversity and gut IgA levels, and negatively correlated with gut microbiota richness." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31255682> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31255682_8> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_31255682_8" ;
    gutprop:hasSentenceText "Our results may imply a role of the microbiome in the etiology of schizophrenia and contribute to the development of microbiome targeted interventions for schizophrenia." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31255682> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31260640_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_31260640_2" ;
    gutprop:hasSentenceText "An increasing body of preclinical and clinical evidence has revealed that the gut microbial ecosystem can affect neuropsychiatric health." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31260640> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31260640_3> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_31260640_3" ;
    gutprop:hasSentenceText "However, there is still a need of further studies to elucidate the complex gene-environment interactions and the role of the MGB axis in neuropsychiatric diseases, with the aim of identifying biomarkers and new therapeutic targets, to allow early diagnosis and improving treatments." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31260640> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31260640_4> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_31260640_4" ;
    gutprop:hasSentenceText "<b>Areas covered</b>: To review the role of MGB axis in neuropsychiatric disorders, prediction and prevention of disease through exploitation, integration, and combination of data from existing gut microbiome/microbiota projects and appropriate other International '-Omics' studies." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31260640> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31260640_5> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_31260640_5" ;
    gutprop:hasSentenceText "The authors also evaluated the new technological advances to investigate and modulate, through nutritional and other interventions, the gut microbiota." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31260640> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31330299_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_31330299_0" ;
    gutprop:hasSentenceText "Monocyte mobilisation, microbiota & mental illness." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/31330299> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31330299_4> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_31330299_4" ;
    gutprop:hasSentenceText "One of the major pathways through which the microbiota influences the brain is the immune system, where there is an increasing appreciation for the role of monocyte trafficking in regulating brain homeostasis." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31330299> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31377712_6> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_31377712_6" ;
    gutprop:hasSentenceText "Psychosocial characteristics (eg, psychological distress, coping strategies), QoL, psychological well-being and resilience will be assessed by self-report questionnaires." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31377712> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31383280_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_31383280_2" ;
    gutprop:hasSentenceText "Adequate nutrition during the perinatal period is essential to maternal and infant health, including maternal mental health and the child's neurologic and neuropsychiatric development." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31383280> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31383280_3> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_31383280_3" ;
    gutprop:hasSentenceText "Nutrition holds promise to improve prevention and treatment of PMAD." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31383280> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31493127_11> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_31493127_11" ;
    gutprop:hasSentenceText "However, this work concentrates on the impact of bacterial cell components, metabolites, and signal molecules as promising alternatives to the currently widespread probiotics that have both advantages and disadvantages." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31493127> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31493127_5> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_31493127_5" ;
    gutprop:hasSentenceText "This enables them to constantly interact with the nervous system including the brain and the immune system of the host organism." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31493127> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31498131_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_31498131_0" ;
    gutprop:hasSentenceText "Increasing Comparability and Utility of Gut Microbiome Studies in Parkinson's Disease: A Systematic Review." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/31498131> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31498131_6> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_31498131_6" ;
    gutprop:hasSentenceText "To move from the current heterogeneous dataset towards clinically relevant biomarkers and the identification of putative therapeutic targets, recommendations are derived from the limitations of the available studies to increase the future comparability of microbiome studies in PD." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31498131> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31530799_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_31530799_0" ;
    gutprop:hasSentenceText "Abnormal composition of gut microbiota is associated with resilience versus susceptibility to inescapable electric stress." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/31530799> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31530799_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_31530799_2" ;
    gutprop:hasSentenceText "In the learned helplessness (LH) paradigm, ~60-70% rats are susceptible to LH in the face of inescapable electric stress." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31530799> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31530799_3> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_31530799_3" ;
    gutprop:hasSentenceText "The role of gut microbiota in susceptibility in the LH paradigm is unknown." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31530799> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31539679_13> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_31539679_13" ;
    gutprop:hasSentenceText "Therefore, it is likely that the brain-gut axis plays a role in resilience versus susceptibility to stress." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31539679> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31539679_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_31539679_2" ;
    gutprop:hasSentenceText "However, the role of brain-gut axis in the resilience versus susceptibility after stress remains unclear." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31539679> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31568686_1> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_31568686_1" ;
    gutprop:hasSentenceText "The prevalence of psychological disorders remains stable despite steady increases in pharmacological treatments suggesting the need for auxiliary treatment options." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31568686> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31568686_5> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_31568686_5" ;
    gutprop:hasSentenceText "Gut microbiota are proposed to directly and indirectly influence mood, cognition, and behavior which are key components of mental health." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31568686> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31568686_8> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_31568686_8" ;
    gutprop:hasSentenceText "While the importance of the GM in psychological well-being must be respected, it is not proposed to be a panacea, but instead, an additional arm to a multidisciplinary approach to treatment and prevention." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31568686> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31596658_6> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_31596658_6" ;
    gutprop:hasSentenceText "<b><i>Materials and methods</i>:</b> A literature search was conducted for published reports on the effect of light on the microbiome." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31596658> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31596658_8> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_31596658_8" ;
    gutprop:hasSentenceText "This has also now been demonstrated in human subjects." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31596658> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31610228_13> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_31610228_13" ;
    gutprop:hasSentenceText "The findings may represent a link between alcohol use and alcohol-related morbidity." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31610228> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31646148_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_31646148_0" ;
    gutprop:hasSentenceText "Gut microbial metabolites in depression: understanding the biochemical mechanisms." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/31646148> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31646148_1> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_31646148_1" ;
    gutprop:hasSentenceText "Gastrointestinal and central function are intrinsically connected by the gut microbiota, an ecosystem that has co-evolved with the host to expand its biotransformational capabilities and interact with host physiological processes by means of its metabolic products." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31646148> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31646148_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_31646148_2" ;
    gutprop:hasSentenceText "Abnormalities in this microbiota-gut-brain axis have emerged as a key component in the pathophysiology of depression, leading to more research attempting to understand the neuroactive potential of the products of gut microbial metabolism." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31646148> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31646148_5> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_31646148_5" ;
    gutprop:hasSentenceText "We propose that direct and indirect mechanisms exist through which gut microbial metabolites affect depressive behavior: these include (i) direct stimulation of central receptors, (ii) peripheral stimulation of neural, endocrine, and immune mediators, and (iii) epigenetic regulation of histone acetylation and DNA methylation." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31646148> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31646148_6> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_31646148_6" ;
    gutprop:hasSentenceText "Elucidating these mechanisms is essential to expand our understanding of the etiology of depression, and to develop new strategies to harness the beneficial psychotropic effects of these molecules." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31646148> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31646148_7> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_31646148_7" ;
    gutprop:hasSentenceText "Overall, the review highlights the potential for dietary interventions to represent such novel therapeutic strategies for major depressive disorder." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31646148> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31662903_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_31662903_0" ;
    gutprop:hasSentenceText "Are Nonnutritive Sweeteners Obesogenic?" ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/31662903> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31662903_5> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_31662903_5" ;
    gutprop:hasSentenceText "One unit of NNSs was 100 mL beverage with NNSs or 2 tablets/teaspoons of NNSs." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31662903> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31685046_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_31685046_2" ;
    gutprop:hasSentenceText "However, studies on the MiTBamp in MDD are lacking." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31685046> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31704402_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_31704402_2" ;
    gutprop:hasSentenceText "Conversely, greater urbanisation associates with increased risk of mental health disorders." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31704402> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31704402_4> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_31704402_4" ;
    gutprop:hasSentenceText "However, there remains a lack of controlled experimental evidence testing possible beneficial effects from passive exposure to natural biodiversity via airborne microbiota." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31704402> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31704402_5> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_31704402_5" ;
    gutprop:hasSentenceText "Previous mouse model studies have used unrealistic environmental microbial exposures-including excessive soil and organic matter contact, feed supplements and injections-to demonstrate host microbiota, immune biomarker, and behavioural changes." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31704402> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31722343_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_31722343_2" ;
    gutprop:hasSentenceText "Bacterial functions in the gut play a critical role in healthy host functioning, and its disruption can contribute to many medical conditions." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31722343> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31726457_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_31726457_0" ;
    gutprop:hasSentenceText "Gut Microbiota: A Perspective for Psychiatrists." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/31726457> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31726457_3> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_31726457_3" ;
    gutprop:hasSentenceText "To further complicate matters, we each harbour a unique microbiota community that is subject to change by a number of factors including diet, exercise, stress, health status, genetics, medication, and age, amongst others." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31726457> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31821833_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_31821833_0" ;
    gutprop:hasSentenceText "The connection between microbiome and schizophrenia." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/31821833> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31917834_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_31917834_2" ;
    gutprop:hasSentenceText "A consequence of this major neuronal reorganizing and remodeling is a heightened level of vulnerability to stressors and immune challenges." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31917834> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31940482_7> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_31940482_7" ;
    gutprop:hasSentenceText "Our findings provide a basis for exploring the disease-modifying potential of B. subtilis as a dietary supplement." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31940482> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31952911_7> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_31952911_7" ;
    gutprop:hasSentenceText "However, we found that all studies had risk of bias and that the included studies displayed great variability in methods of storage, analysis of the fecal samples, reporting of results and statistics used." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31952911> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31955786_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_31955786_0" ;
    gutprop:hasSentenceText "Neuroactive compounds in foods: Occurrence, mechanism and potential health effects." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/31955786> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31955786_1> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_31955786_1" ;
    gutprop:hasSentenceText "Neuroactive compounds are synthesized by certain plants and microorganisms by undertaking different tasks, especially as a stress response." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31955786> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31955786_3> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_31955786_3" ;
    gutprop:hasSentenceText "Fermented foods contain some of these compounds, which can affect human health and mood." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31955786> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31955786_4> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_31955786_4" ;
    gutprop:hasSentenceText "Moreover, food processing such as roasting and malting alter amount and profile of neuroactive compounds in foods." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31955786> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31955786_8> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_31955786_8" ;
    gutprop:hasSentenceText "The focus of this comprehensive review is to investigate the neuroactive compounds found naturally in foods or formed during fermentation." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31955786> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32056910_11> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_32056910_11" ;
    gutprop:hasSentenceText "Limitations A large number of gut microbiota estimation methods and statistical techniques were utilized; therefore, meta-analysis was not possible." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32056910> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32155131_3> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_32155131_3" ;
    gutprop:hasSentenceText "Altered components of the gut could represent a key role in gut-brain axis, which is a bidirectional system between the central nervous system and the enteric nervous system." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32155131> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32155131_4> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_32155131_4" ;
    gutprop:hasSentenceText "Diet can alter the microbiota composition, affecting gut-brain axis function." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32155131> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32155131_5> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_32155131_5" ;
    gutprop:hasSentenceText "Gut microbiome restoration through selected probiotics' administration has been reported." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32155131> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32163822_1> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_32163822_1" ;
    gutprop:hasSentenceText "A growing body of evidence point toward the bidirectional gut microbiota-brain axis playing a role in mental health." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32163822> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32188376_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_32188376_0" ;
    gutprop:hasSentenceText "Diet and Neurocognition in Mood Disorders - An Overview of the Overlooked." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/32188376> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32188376_3> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_32188376_3" ;
    gutprop:hasSentenceText "Diet and nutrition impact on brain /mental health, but cognitive outcomes have been less researched in psychiatric disorders." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32188376> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32188376_5> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_32188376_5" ;
    gutprop:hasSentenceText "This narrative review aimed to assess the potential cognitive benefits of dietary and nutritional interventions in subjects diagnosed with mood disorders." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32188376> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32188376_7> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_32188376_7" ;
    gutprop:hasSentenceText "Efficacy to improve select cognitive deficits has been reported, but results are either preliminary or inconsistent." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32188376> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32389857_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_32389857_0" ;
    gutprop:hasSentenceText "Targeting the microbiota in pharmacology of psychiatric disorders." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/32389857> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32389857_1> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_32389857_1" ;
    gutprop:hasSentenceText "There is increasing interest in the role of the gut microbiota in health and disease." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32389857> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32389857_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_32389857_2" ;
    gutprop:hasSentenceText "In particular, gut microbiota influences the Central Nervous System (CNS) development and homeostasis through neural pathways or routes involving the immune and circulatory systems." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32389857> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32389857_3> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_32389857_3" ;
    gutprop:hasSentenceText "The CNS, in turn, shapes the intestinal flora through endocrine or stress-mediated responses." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32389857> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32389857_5> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_32389857_5" ;
    gutprop:hasSentenceText "Consequently, a dysfunction within this axis, as observed in case of dysbiosis, can have an impact on the behavior of a given individual (e.g." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32389857> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32389857_8> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_32389857_8" ;
    gutprop:hasSentenceText "It should be considered that the whole microbiota has a significant role not only on aspects concerning human physiology, such as harvesting of nutrients and energy from the ingested food or production of a wide range of bioactive compounds, but also has positive effects on the gastrointestinal barrier function and actively contributes to the pharmacokinetics of several compounds including neuropsychiatric drugs." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32389857> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32431588_3> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_32431588_3" ;
    gutprop:hasSentenceText "Thus, there is increasing interest in developing strategies that target and attenuate α-syn aggregation and spread." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32431588> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32438623_1> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_32438623_1" ;
    gutprop:hasSentenceText "The gut microbiota plays a role in gut-brain communication and can influence psychological functioning." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32438623> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32438623_11> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_32438623_11" ;
    gutprop:hasSentenceText "Relative abundance of the genus <i>Lactobacillus</i> increased significantly between pre- and post-course time points." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32438623> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32438623_15> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_32438623_15" ;
    gutprop:hasSentenceText "More research is needed on the effect of dietary changes on gut microbiome composition, in particular in relation to the promotion of bacterial genera, such as <i>Lactobacillus</i>, which are recognised as being beneficial for a range of physical and mental health outcomes." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32438623> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32438623_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_32438623_2" ;
    gutprop:hasSentenceText "Diet is one of the major determinants of gut microbiota composition." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32438623> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32438623_5> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_32438623_5" ;
    gutprop:hasSentenceText "Twenty-four participants completed the study." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32438623> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32469834_9> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_32469834_9" ;
    gutprop:hasSentenceText "Further consideration of papers which incorporate functional analyses (e.g., metabolomics) is required to integrate this body of literature." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32469834> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32517799_12> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_32517799_12" ;
    gutprop:hasSentenceText "The predicted microbial pantothenic acid production potential was linked to the presence of specific non-motor symptoms." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32517799> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32517799_5> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_32517799_5" ;
    gutprop:hasSentenceText "Stool samples from these individuals were first analysed by 16S rRNA gene sequencing." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32517799> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32518376_7> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_32518376_7" ;
    gutprop:hasSentenceText "Interestingly, there were positive correlations between the plasma levels of pro-inflammatory cytokines and spleen weight, suggesting a relationship between inflammatory events and spleen weight." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32518376> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32538869_5> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_32538869_5" ;
    gutprop:hasSentenceText "It becomes clear from the limited data that exist that there is a fine line between acceleration and inhibition, but that cross-reactivity is widespread, and it is more common for other proteins (among the studied cases) to accelerate alpha-synuclein amyloid formation than to block it." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32538869> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32545788_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_32545788_2" ;
    gutprop:hasSentenceText "The inflammasomes are recognized as innate immune system sensors and receptors that manage the activation of caspase-1 and stimulate inflammation response." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32545788> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32545788_3> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_32545788_3" ;
    gutprop:hasSentenceText "They have been associated with several inflammatory disorders." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32545788> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32572814_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_32572814_2" ;
    gutprop:hasSentenceText "Risk factors for PD include aging, as well as environmental and genetic factors." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32572814> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32572814_8> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_32572814_8" ;
    gutprop:hasSentenceText "SALS, an endogenous product of aldehyde and dopamine condensation, may be selectively toxic to dopaminergic neurons." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32572814> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32600151_3> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_32600151_3" ;
    gutprop:hasSentenceText "Given the health and economic impacts of AD, treatments that target the underlying etiology of AD or modify the course of the disease are of significant interest." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32600151> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32605552_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_32605552_0" ;
    gutprop:hasSentenceText "The study protocol for a pseudo-randomised pre-post designed controlled intervention trial to study the effects of a 7-week cooking program on self-efficacy and biomarkers of health: the ECU lifestyle and biomarkers get connected study (ECULABJMOF) including the Jamie's Ministry of Food WA participant experience." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/32605552> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32605552_10> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_32605552_10" ;
    gutprop:hasSentenceText "Primary endpoints were participants' cooking confidence as a proxy for self-efficacy." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32605552> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32605552_12> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_32605552_12" ;
    gutprop:hasSentenceText "The community cooking program provided participants with information and advice on food sourcing, preparation and nutrition to improve home cooking skills." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32605552> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32605552_15> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_32605552_15" ;
    gutprop:hasSentenceText "The extensive data collected will inform future research into the relationship between diet, the gut-microbiota and human health." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32605552> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32605552_3> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_32605552_3" ;
    gutprop:hasSentenceText "The aims of this study were to evaluate whether a community-based cooking program instigated a change to participants' skills, attitudes, knowledge, enjoyment and satisfaction of cooking and cooking confidence (self-efficacy)." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32605552> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32605552_6> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_32605552_6" ;
    gutprop:hasSentenceText "Intervention participants were surveyed three times (baseline, 7 weeks and 6 months) and the control group were surveyed at baseline and 5 weeks." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32605552> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32605552_7> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_32605552_7" ;
    gutprop:hasSentenceText "All participants were registered via an online website and were 18 years or over." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32605552> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32605552_8> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_32605552_8" ;
    gutprop:hasSentenceText "Upon consent, participants were offered four levels of commitment, defined by different assessments." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32605552> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32667590_1> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_32667590_1" ;
    gutprop:hasSentenceText "The microbiota-gut-brain axis is a bidirectional signaling mechanism between the gastrointestinal tract and the central nervous system." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32667590> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32739746_10> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_32739746_10" ;
    gutprop:hasSentenceText "Thus, a commensal fungus that is a common colonizer of humans had widespread effects on the physiology of its host." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32739746> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32739746_11> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_32739746_11" ;
    gutprop:hasSentenceText "To our knowledge, this is the first report of microbial manipulation of the endocannabinoid (eCB) system that resulted in neuroendocrine changes contributing to anxiety-like behavior." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32739746> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32739746_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_32739746_2" ;
    gutprop:hasSentenceText "Although the etiology of anxiety disorders is incompletely understood, one aspect of host health that affects anxiety disorders is the gut-brain axis." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32739746> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32772900_9> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_32772900_9" ;
    gutprop:hasSentenceText "Gut dysbiosis is seen in various mental health conditions." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32772900> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32816830_1> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_32816830_1" ;
    gutprop:hasSentenceText "A double-blinded, randomised controlled trial." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32816830> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32816830_13> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_32816830_13" ;
    gutprop:hasSentenceText "Participants will be provided with a summary of findings once the study is completed." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32816830> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32816830_9> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_32816830_9" ;
    gutprop:hasSentenceText "Alteration of sleep will be recorded using an actigraphy device worn by all participants over the whole study." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32816830> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32834004_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_32834004_2" ;
    gutprop:hasSentenceText "Currently, statistical testing methods are commonly performed to identify OTUs that are associated with a phenotype." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32834004> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32834004_3> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_32834004_3" ;
    gutprop:hasSentenceText "The limitations of statistical testing methods include that the validity of p-values/q-values depend sensitively on the correctness of models and that the statistical significance does not necessarily imply predictivity." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32834004> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32834004_4> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_32834004_4" ;
    gutprop:hasSentenceText "Predictive analysis using methods such as LASSO is an alternative approach for identifying associated OTUs and for measuring the predictability of the phenotype variable with OTUs and other covariate variables." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32834004> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32834004_7> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_32834004_7" ;
    gutprop:hasSentenceText "Our simulation studies show that the predictive performance of LASSO with appropriate variable transformation works remarkably well on zero-inflated data." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32834004> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32834004_8> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_32834004_8" ;
    gutprop:hasSentenceText "Our results of real data analysis show that Parkinson's disease can be predicted based on selected OTUs after the binary transformation, age, and sex with high accuracy (Error Rate = 0.199, AUC = 0.872, AUPRC = 0.912)." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32834004> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32890382_11> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_32890382_11" ;
    gutprop:hasSentenceText "These epigenetic modifications are also correlated with neurophysiological, inflammatory or hypothalamic-pituitary-adrenal axis dysregulations." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32890382> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32890382_4> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_32890382_4" ;
    gutprop:hasSentenceText "We searched on Pubmed, PsycINFO, PsycARTICLES and Sciencedirect articles with the keywords psychiatric disorders, epigenome, microbiome and family relationships." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32890382> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32890382_5> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_32890382_5" ;
    gutprop:hasSentenceText "Some gene polymorphisms interact with negative environment and lead to psychiatric disorders." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32890382> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32890382_9> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_32890382_9" ;
    gutprop:hasSentenceText "Our findings support the hypothesis that epigenetic mediate gene-environment interactions and psychiatric disorders." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32890382> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32979562_5> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_32979562_5" ;
    gutprop:hasSentenceText "We also identified 38 species increased and 6 species decreased significantly in the BPD group." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32979562> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32983561_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_32983561_2" ;
    gutprop:hasSentenceText "Ironically in the expansive world of the microbiome, gut microbes are most affected by modern, fast paced, westernized lifestyles, indicating a significant correlation based on geography, and physical and mental habits." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32983561> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32999308_10> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_32999308_10" ;
    gutprop:hasSentenceText "DJ-1 appeared also to be involved in ILCs development." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32999308> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33046051_12> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33046051_12" ;
    gutprop:hasSentenceText "The second dataset's 18 MS samples (Miyake et al, PLoS ONE 10:0137429, 2015) and 18 self-reported healthy samples from the (McDonald et al, Msystems 3:00031-18, 2018) dataset were used to validate the developed classification model." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33046051> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33046051_18> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33046051_18" ;
    gutprop:hasSentenceText "shotgun metagenomic sequencing)." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33046051> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33046051_6> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33046051_6" ;
    gutprop:hasSentenceText "We have used three different sets of MS samples sequenced during three independent studies (Jangi et al, Nat Commun 7:1-11, 2016), (Miyake et al, PLoS ONE 10:0137429, 2015), (McDonald et al, Msystems 3:00031-18, 2018) and this approach strengthens our results." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33046051> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33046051_7> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33046051_7" ;
    gutprop:hasSentenceText "Analyzed sequences were from healthy control and MS groups of sequences." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33046051> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33067915_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33067915_0" ;
    gutprop:hasSentenceText "Interaction between Maternal Immune Activation and Antibiotic Use during Pregnancy and Child Risk of Autism Spectrum Disorder." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/33067915> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33067915_11> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33067915_11" ;
    gutprop:hasSentenceText "No other immune activation exposures seemed to interact with antibiotic use." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33067915> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33076930_3> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33076930_3" ;
    gutprop:hasSentenceText "Aromatic bacterial metabolites are attracting considerable attention due to their impact on gut homeostasis and host's physiology." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33076930> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33076930_9> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33076930_9" ;
    gutprop:hasSentenceText "Overall, this study underpins the importance of the metabolic pathways of the gut microbiome involved in drug metabolism not only to preserve drug effectiveness, but also to avoid potential side effects of bacterial breakdown products of the unabsorbed residue of medication." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33076930> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33092203_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33092203_0" ;
    gutprop:hasSentenceText "Clustering on Human Microbiome Sequencing Data: A Distance-Based Unsupervised Learning Model." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/33092203> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33092203_1> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33092203_1" ;
    gutprop:hasSentenceText "Modeling and analyzing human microbiome allows the assessment of the microbial community and its impacts on human health." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33092203> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33092203_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33092203_2" ;
    gutprop:hasSentenceText "Microbiome composition can be quantified using 16S rRNA technology into sequencing data, which are usually skewed and heavy-tailed with excess zeros." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33092203> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33092203_3> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33092203_3" ;
    gutprop:hasSentenceText "Clustering methods are useful in personalized medicine by identifying subgroups for patients stratification." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33092203> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33092203_4> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33092203_4" ;
    gutprop:hasSentenceText "However, there is currently a lack of standardized clustering method for the complex microbiome sequencing data." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33092203> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33092203_5> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33092203_5" ;
    gutprop:hasSentenceText "We propose a clustering algorithm with a specific beta diversity measure that can address the presence-absence bias encountered for sparse count data and effectively measure the sample distances for sample stratification." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33092203> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33092203_9> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33092203_9" ;
    gutprop:hasSentenceText "The proposed algorithm was implemented to a human gut microbiome study on Parkinson's diseases to identify distinct microbiome states with biological interpretations." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33092203> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33105830_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33105830_2" ;
    gutprop:hasSentenceText "Gut commensal bacteria maintain a symbiotic relationship with the host and display a critical function in the homeostasis of the host immune system." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33105830> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33144709_1> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33144709_1" ;
    gutprop:hasSentenceText "The field of nutritional psychiatry has generated observational and efficacy data supporting a role for healthy dietary patterns in depression onset and symptom management." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33144709> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33144709_7> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33144709_7" ;
    gutprop:hasSentenceText "To fully identify and elucidate complex mechanisms of action, intervention studies that assess markers related to these pathways within clinically diagnosed human populations are needed." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33144709> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33194817_11> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33194817_11" ;
    gutprop:hasSentenceText "Our findings provide further insights into the involvement of gut microbiota in diseases related to brain-gut disorder." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33194817> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33194817_6> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33194817_6" ;
    gutprop:hasSentenceText "Metagenomic analysis revealed 26 clusters of orthologous groups of protein (COG) categories consisting of a total of 4,631 functional genes." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33194817> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33212907_4> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33212907_4" ;
    gutprop:hasSentenceText "The primary outcome was a change in HbA1c." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33212907> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33212907_7> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33212907_7" ;
    gutprop:hasSentenceText "HbA1c decreased from 43 ± 2.7 mmol/mol to 41 ± 2.3 mmol/mol, <i>p</i> < 0.001, with average of 5% weight loss." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33212907> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33240722_3> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33240722_3" ;
    gutprop:hasSentenceText "A major area of research has been the directional relationship between intestinal microbiota and the central nervous system (CNS), called the microbiota-gut-brain axis." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33240722> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33240722_4> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33240722_4" ;
    gutprop:hasSentenceText "It is hypothesized that the intestinal microbiota affects brain activity and behavior via endocrine, neural, and immune pathways." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33240722> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33240722_7> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33240722_7" ;
    gutprop:hasSentenceText "Through this review, we outline the established knowledge regarding the gut microbiome and gut-brain axis." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33240722> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33244049_6> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33244049_6" ;
    gutprop:hasSentenceText "Moreover, a novel genus from the family Lachnospiraceae is associated with emotional well-being scores, both positive and negative." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33244049> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33271210_1> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33271210_1" ;
    gutprop:hasSentenceText "In recent decades, the diagnostic and therapeutic implications of the microbiome changes and the impact of probiotic supplementation have increased rapidly." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33271210> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33271210_10> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33271210_10" ;
    gutprop:hasSentenceText "One study did not find significant differences in microbiome composition after micronutrient treatment." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33271210> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33271210_6> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33271210_6" ;
    gutprop:hasSentenceText "Six studies examined the effects of various treatment interventions such as probiotic supplementation on microbiota composition and behaviors." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33271210> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33287442_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33287442_0" ;
    gutprop:hasSentenceText "The Gut Microbiota: A Potential Gateway to Improved Health Outcomes in Breast Cancer Treatment and Survivorship." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/33287442> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33318317_7> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33318317_7" ;
    gutprop:hasSentenceText "The study showed for the first-time, alteration in the cognitive capacity leading to the corresponding changes in microbiota profiles." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33318317> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33327540_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33327540_0" ;
    gutprop:hasSentenceText "Ketogenic Diet: A Dietary Modification as an Anxiolytic Approach?" ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/33327540> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33327540_1> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33327540_1" ;
    gutprop:hasSentenceText "Anxiety disorders comprise persistent, disabling conditions that are distributed across the globe, and are associated with the high medical and socioeconomic burden of the disease." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33327540> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33416892_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33416892_2" ;
    gutprop:hasSentenceText "Chronic or intermittent food restriction has profound effects in shaping brain and peripheral metabolism, immunity, and gut microbiome biology." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33416892> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33416892_4> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33416892_4" ;
    gutprop:hasSentenceText "This review discusses these findings and their potential application to the prevention and treatment of CNS neuroinflammatory diseases and the promotion of healthy brain aging." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33416892> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33454868_8> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33454868_8" ;
    gutprop:hasSentenceText "We aimed at discovering new methods to prevent or treat BC by changing intestinal microorganisms." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33454868> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33467657_1> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33467657_1" ;
    gutprop:hasSentenceText "The widespread consumption of 'western'-style diets along with sedentary lifestyles has led to a global epidemic of obesity." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33467657> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33467657_5> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33467657_5" ;
    gutprop:hasSentenceText "In animal models, maternal obesogenic diet consumption disrupts CNS homeostasis in offspring, which is critical for healthy neurodevelopment, by altering hypothalamic and hippocampal development and recruitment of glial cells, which subsequently dysregulates dopaminergic and serotonergic systems." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33467657> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33467657_7> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33467657_7" ;
    gutprop:hasSentenceText "Furthermore, accumulating evidence suggests that the gut microbiome may directly and indirectly contribute to these maternal diet effects in both human and animal studies." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33467657> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33511258_4> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33511258_4" ;
    gutprop:hasSentenceText "The current study was a follow-up work aiming to investigate the functional role of the gut metagenomes in the observed beneficial effects." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33511258> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33511258_5> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33511258_5" ;
    gutprop:hasSentenceText "The fecal metagenomes of the probiotic (n = 43) and placebo (n = 36) receivers were analyzed in depth." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33511258> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33651324_10> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33651324_10" ;
    gutprop:hasSentenceText "Higher levels of aerotolerant bacteria were associated with worse psychological well-being (rho = -0.35, p = 0.02), less social satisfaction (r = - 0.42, p < 0.01), and more negative affect (rho = 0.46, p < 0.01)." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33651324> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33651324_9> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33651324_9" ;
    gutprop:hasSentenceText "Moreover, PLWH experienced significantly worse psychological well-being (p = 0.02), less social satisfaction (p = 0.03), and more negative affect (p = 0.02)." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33651324> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33664475_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33664475_0" ;
    gutprop:hasSentenceText "Sialylated human milk oligosaccharides program cognitive development through a non-genomic transmission mode." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/33664475> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33664475_1> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33664475_1" ;
    gutprop:hasSentenceText "Breastmilk contains bioactive molecules essential for brain and cognitive development." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33664475> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33664475_11> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33664475_11" ;
    gutprop:hasSentenceText "These were associated with a site- (PFC) and time-specific (eye-opening) reduced expression of genes involved in central nervous system development." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33664475> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33664475_5> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33664475_5" ;
    gutprop:hasSentenceText "Neu5Ac is involved in the formation of brain structures sustaining cognition." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33664475> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33664475_7> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33664475_7" ;
    gutprop:hasSentenceText "To test whether lactational 6'SL deprivation affects cognitive capabilities in adulthood, we assessed attention, perseveration, and memory." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33664475> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33677218_5> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33677218_5" ;
    gutprop:hasSentenceText "Treatment with fecal microbiota transplantation ameliorated depression-like behaviors." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33677218> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33693453_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33693453_2" ;
    gutprop:hasSentenceText "Diet is one of the major factors involved in shaping the gut microbiota composition across the lifespan." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33693453> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33693453_3> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33693453_3" ;
    gutprop:hasSentenceText "However, whether and how diet can affect the brain via its effects on the microbiota is only now beginning to receive attention." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33693453> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33693453_5> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33693453_5" ;
    gutprop:hasSentenceText "Animal studies investigating the potential of nutritional interventions on the microbiota-gut-brain axis have led to advancements in our understanding of the role of diet in this bidirectional communication." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33693453> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33693453_6> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33693453_6" ;
    gutprop:hasSentenceText "In this review, we summarize the current state of the literature triangulating diet, microbiota, and host behavior/brain processes and discuss potential underlying mechanisms." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33693453> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33693453_7> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33693453_7" ;
    gutprop:hasSentenceText "Additionally, determinants of the responsiveness to a dietary intervention and evidence for the microbiota as an underlying modulator of the effect of diet on brain health are outlined." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33693453> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33693453_8> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33693453_8" ;
    gutprop:hasSentenceText "In particular, we emphasize the understudied use of whole-dietary approaches in this endeavor and the need for greater evidence from clinical populations." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33693453> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33713734_7> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33713734_7" ;
    gutprop:hasSentenceText "No impact of psychotropic medication was found." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33713734> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33722869_11> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33722869_11" ;
    gutprop:hasSentenceText "All participants voluntarily provided informed consent." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33722869> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33722869_5> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33722869_5" ;
    gutprop:hasSentenceText "In an ancillary component, the study will also investigate gastrointestinal and mental health symptoms in a larger sample, and explore relationships with diet, exercise, oral health, substance use, medical history, early life adversity and psychosocial factors." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33722869> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33782648_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33782648_2" ;
    gutprop:hasSentenceText "Since the prevalence of most of these disorders increases with age, the consequences for our aging population are only going to grow." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33782648> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33782648_4> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33782648_4" ;
    gutprop:hasSentenceText "While each disorder has specific initiating mechanisms and pathologies, certain common pathways appear to be involved in most, if not all, neurological disorders." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33782648> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33782648_6> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33782648_6" ;
    gutprop:hasSentenceText "One of these compounds is the flavonol fisetin." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33782648> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33782648_8> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33782648_8" ;
    gutprop:hasSentenceText "These beneficial effects stem from its actions on multiple pathways associated with the different neurological disorders." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33782648> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33782648_9> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33782648_9" ;
    gutprop:hasSentenceText "These actions include its well characterized anti-inflammatory and anti-oxidant effects as well as more recently described effects on the regulated cell death oxytosis/ferroptosis pathway, the gut microbiome and its senolytic activity." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33782648> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33807447_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33807447_2" ;
    gutprop:hasSentenceText "The composition of the gut microbiota is modified by multiple internal and external factors, such as diet." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33807447> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33825149_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33825149_2" ;
    gutprop:hasSentenceText "Mitochondrial dysfunction is an area with high potential." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33825149> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33825149_3> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33825149_3" ;
    gutprop:hasSentenceText "The neurobiological signaling connections between the gut microbiome and the central nervous system are incompletely understood." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33825149> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33860090_4> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33860090_4" ;
    gutprop:hasSentenceText "In this regard, microbial-directed therapies such as probiotics are emerging as potential therapeutic options." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33860090> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33860090_5> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33860090_5" ;
    gutprop:hasSentenceText "Probiotic supplementation is postulated to confer a variety of health benefits due to the diverse functions of these live microorganisms, including inhibition of pathogen colonization, modulation/\"normalization\" of the microbiome and/or its function, immunomodulatory effects (e.g." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33860090> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33860090_6> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33860090_6" ;
    gutprop:hasSentenceText "reducing inflammation), and improved host epithelial barrier function." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33860090> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33895287_6> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33895287_6" ;
    gutprop:hasSentenceText "Here we aimed to determine the extent to which chemotherapy-associated gut manipulations modulate the behavioral and biological consequences of chemotherapy." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33895287> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33899052_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33899052_0" ;
    gutprop:hasSentenceText "Gut Microbiome Changes with Osteopathic Treatment of Constipation in Parkinson's Disease: A Pilot Study." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/33899052> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33899052_11> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33899052_11" ;
    gutprop:hasSentenceText "The Pre-OMM mean number of families within the phylum Firmicutes decreased by 3 (p = .043; d = 1.177) Post-OMM." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33899052> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33899052_6> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33899052_6" ;
    gutprop:hasSentenceText "Also, the Bristol stool scale and questionnaires validated for constipation were administered for diagnosis, symptom severity, and quality of life during a 4-week control-period (A), 4-weekly OMM-treatments (B), and 2-weeks no-intervention (A)." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33899052> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33899052_9> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33899052_9" ;
    gutprop:hasSentenceText "Mean constipation severity significantly decreased (p = .010; d = 1.508) Post-OMM." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33899052> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33936013_1> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33936013_1" ;
    gutprop:hasSentenceText ": Prevalence, Regulation, and Role in Acid Stress Tolerance." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33936013> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33936013_5> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33936013_5" ;
    gutprop:hasSentenceText "A total of 961 <i>Bacteroides</i> genomes were analyzed <i>in silico</i> and 17 metabolically and genetically diverse human intestinal isolates representing 11 species were screened <i>in vitro</i>." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33936013> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33938181_10> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33938181_10" ;
    gutprop:hasSentenceText "GIP can thus be regarded as an antimicrobial adjuvant with potential for augmenting the available antibiotic arsenal." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33938181> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33938181_4> a owl:NamedIndividual,
        gutprop:Sentence ;
