        <http://purl.obolibrary.org/obo/NCIT_C92200>,
        <http://purl.obolibrary.org/obo/OMIT_0028544>,
        <https://uts.nlm.nih.gov/uts/umls/concept/C0007222>,
        <https://uts.nlm.nih.gov/uts/umls/concept/C0011860> ;
