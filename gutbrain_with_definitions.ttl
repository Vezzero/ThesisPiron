    rdfs:label "Severe Depression" ;
    rdfs:comment "Severe Depression: A mental health disorder characterized by a persistent and intense feeling of sadness, hopelessness, and loss of interest in activities, accompanied by significant impairment in daily life and functioning. [Definition Source: llama3-8b-8192]"^^xsd:string,
