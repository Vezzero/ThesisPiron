    dcterms:creator "Samuel Piron" ;
    rdfs:comment "Patients_with_schizophrenia refers to individuals diagnosed with schizophrenia, a chronic and severe mental disorder characterized by hallucinations, delusions, and disorganized thinking and behavior. [Definition Source: llama3-8b-8192]" ;
    skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/Human> ;
