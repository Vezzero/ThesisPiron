<https://w3id.org/hereditary/ontology/gutbrain/resource/biomedicaltechnique/StressModel> a owl:NamedIndividual,
        skos:Concept,
        gutprop:BiomedicalTechnique ;
    rdfs:label "Stress Model" ;
    dcterms:creator "Samuel Piron" ;
    rdfs:comment "A stress model is a theoretical framework or mathematical representation that describes the relationship between stressors and their effects on an organism or system, often used to predict and understand physiological responses to stress. [Definition Source: llama3-8b-8192]" ;
