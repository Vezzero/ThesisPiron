<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/24103493_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_24103493_2" ;
    gutprop:hasSentenceText "The health consequences of obesity affect both physical and mental health, and the excess body weight can be linked to an elevated risk for developing type 2 diabetes, cardiovascular problems, and depression." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/24103493> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/24103493_4> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_24103493_4" ;
    gutprop:hasSentenceText "In turn, mother's excess body weight during and after pregnancy can be linked to the risk for offspring overweight and obesity through dietary habits, mode of delivery and feeding, breast milk composition, and through the influence on infant gut microbiota." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/24103493> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/25173628_7> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_25173628_7" ;
    gutprop:hasSentenceText "HFD microbiota also disrupted markers of intestinal barrier function, increased circulating endotoxin, and increased lymphocyte expression of ionized calcium-binding adapter molecule 1, toll-like receptor 2, and toll-like receptor 4." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/25173628> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/25231862_4> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_25231862_4" ;
    gutprop:hasSentenceText "These NAS-mediated deleterious metabolic effects are abrogated by antibiotic treatment, and are fully transferrable to germ-free mice upon faecal transplantation of microbiota configurations from NAS-consuming mice, or of microbiota anaerobically incubated in the presence of NAS." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/25231862> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/25869281_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_25869281_0" ;
    gutprop:hasSentenceText "Lactobacillus fermentum NS9 restores the antibiotic induced physiological and psychological abnormalities in rats." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/25869281> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/25869281_4> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_25869281_4" ;
    gutprop:hasSentenceText "The results showed that NS9 normalised the composition of gut microbiota and alleviated the ampicillin-induced inflammation in the colon." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/25869281> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/25911232_5> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_25911232_5" ;
    gutprop:hasSentenceText "A number of approaches have been used to interrogate this axis including the use of germ-free animals, probiotic agents, antibiotics, or animals exposed to pathogenic bacterial infections." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/25911232> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/26129950_5> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_26129950_5" ;
    gutprop:hasSentenceText "The prevalence of Bacteroidetes and Firmicutes were reduced, and Proteobacteria was greatly increased in the guts of rats after antibiotic treatment." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/26129950> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/26190966_5> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_26190966_5" ;
    gutprop:hasSentenceText "In this review, we provide converging evidence showing that obesity is associated with exacerbated neuroinflammation leading to dysfunction in vulnerable brain regions associated with mood regulation, learning, and memory such as the hippocampus." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/26190966> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/26408987_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_26408987_0" ;
    gutprop:hasSentenceText "Administration of Lactobacillus helveticus NS8 improves behavioral, cognitive, and biochemical aberrations caused by chronic restraint stress." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/26408987> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/26408987_5> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_26408987_5" ;
    gutprop:hasSentenceText "In order to examine this hypothesis, the chronic restraint stress depression model was established in this study." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/26408987> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/26408987_7> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_26408987_7" ;
    gutprop:hasSentenceText "Supplemental Lactobacillus helveticus NS8 was provided every day during stress until the end of experiment, and selective serotonin reuptake inhibitor (SSRI) citalopram (CIT) served as a positive control." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/26408987> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/26923630_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_26923630_0" ;
    gutprop:hasSentenceText "Cognitive impairment by antibiotic-induced gut dysbiosis: Analysis of gut microbiota-brain communication." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/26923630> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/26923630_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_26923630_2" ;
    gutprop:hasSentenceText "Germ-free mice and antibiotic-induced gut dysbiosis are two approaches to establish causality in gut microbiota-brain relationships." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/26923630> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/26927355_5> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_26927355_5" ;
    gutprop:hasSentenceText "A new knowledge of colon microbiota could be applied to provide a second harvest of food energy; for example, large molecules of carbohydrates, which are undigested by the stomach and small intestine, produce by-products that the body can absorb in the colon." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/26927355> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/26927355_9> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_26927355_9" ;
    gutprop:hasSentenceText "Clinically, however, colon microbiota have had immediate applications; fecal microbiota have been transplanted from healthy persons to treat recurrent Clostridium difficile infection at Mayo Clinic." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/26927355> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/27698624_1> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_27698624_1" ;
    gutprop:hasSentenceText "Over the past decade, research has shown that diet and gut health affects symptoms expressed in stress related disorders, depression, and anxiety through changes in the gut microbiota." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/27698624> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/27763700_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_27763700_0" ;
    gutprop:hasSentenceText "Early life diets with prebiotics and bioactive milk fractions attenuate the impact of stress on learned helplessness behaviours and alter gene expression within neural circuits important for stress resistance." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/27763700> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/27763700_4> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_27763700_4" ;
    gutprop:hasSentenceText "Juvenile, male F344 rats were fed diets containing either GOS and PDX alone, LAC alone, or GOS, PDX and LAC." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/27763700> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28073356_8> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_28073356_8" ;
    gutprop:hasSentenceText "While evidence in favour of the helminth-gut microbiota-central nervous system hypothesis is circumstantial, it would be unwise to rule it out as a possible mechanism by which gastrointestinal helminth infections induce childhood cognitive morbidity." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/28073356> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28158162_16> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_28158162_16" ;
    gutprop:hasSentenceText "Large-scale randomized, placebo-controlled studies are warranted in the future to evaluate the clinical efficacy and safety of probiotics in patients with migraine headache.Key words: Migraine headache, gut microbiota, brain function, probiotics." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/28158162> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28442250_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_28442250_2" ;
    gutprop:hasSentenceText "Here we investigated differences in fecal microbiota between 28 patients with first-episode psychosis (FEP) and 16 healthy matched controls and explored whether such differences were associated with response after up to 12months of treatment." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/28442250> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28556833_4> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_28556833_4" ;
    gutprop:hasSentenceText "This study was undertaken to examine whether anti-mouse IL-6 receptor antibody (MR16-1) induces antidepressant effects in a social defeat stress model." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/28556833> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28572752_3> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_28572752_3" ;
    gutprop:hasSentenceText "<b>Materials and methods</b>: We investigated all <sup>13</sup>C-D-xylose breath tests performed at Lovisenberg Diaconal Hospital during the years 2005 to 2011, using patient files for diagnosing the patients into one of three patient categories: alcohol overconsumption, coeliac disease and functional bowel disorder." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/28572752> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28843021_10> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_28843021_10" ;
    gutprop:hasSentenceText "Our study reveals differential abundances of gut microbial taxa in PD and its prodrome idiopathic rapid eye movement sleep behavior disorder in comparison to the healthy controls, and highlights the potential of metagenomics to identify and characterize microbial taxa, which are enriched or depleted in PD and/or idiopathic rapid eye movement sleep behavior disorder." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/28843021> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28852308_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_28852308_0" ;
    gutprop:hasSentenceText "Influence of gut microbiota on neuropsychiatric disorders." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/28852308> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28852308_6> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_28852308_6" ;
    gutprop:hasSentenceText "In this respect, recent studies in animals have indicated that gut microbiota transplantation can transfer a behavioral phenotype, suggesting that the gut microbiota may be a modifiable factor modulating the development or pathogenesis of neuropsychiatric conditions." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/28852308> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28976454_4> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_28976454_4" ;
    gutprop:hasSentenceText "The association between dysbiosis with obesity, metabolic syndrome, and Type 2 diabetes mellitus is still inconclusive, but evidence suggests that bariatric surgery may favorably alter the gut microbial community structure." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/28976454> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/29022384_4> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_29022384_4" ;
    gutprop:hasSentenceText "In our study, overlap between maternal vaginal microbiota and infant faecal microbiota was minimal, while the similarity between maternal rectal microbiota and infant microbiota was more pronounced." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/29022384> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/29023380_7> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_29023380_7" ;
    gutprop:hasSentenceText "These are mediated by neuroanatomy (represented by the vagal and spinal afferent neurons), the neuroendocrine-hypothalamic-pituitary-adrenal (HPA) axis (represented by the gut hormones), immune routes (represented by multiple cytokines), microbially-derived neurotransmitters, and finally the gate keepers of the intestinal and brain barriers." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/29023380> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/29249803_4> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_29249803_4" ;
    gutprop:hasSentenceText "The role of the gut microbiota in the antidepressant effects of ketamine enantiomers in a chronic social defeat stress (CSDS) model of depression was examined using 16S ribosomal RNA gene sequencing of fecal samples." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/29249803> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/29249803_7> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_29249803_7" ;
    gutprop:hasSentenceText "Furthermore, (R)-ketamine, but not (S)-ketamine, significantly attenuated the reduction in the levels of Mollicutes in the susceptible mice." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/29249803> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/29249803_9> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_29249803_9" ;
    gutprop:hasSentenceText "Notably, (R)-ketamine was more potent than (S)-ketamine at reducing the levels of Butyricimonas in the susceptible mice." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/29249803> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/29352709_10> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_29352709_10" ;
    gutprop:hasSentenceText "In conclusion, there are some difference of gut microbiota between schizophrenia patients and healthy controls and the insights from this study could be used to develop microbiota-based diagnosis for schizophrenia." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/29352709> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/29352709_5> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_29352709_5" ;
    gutprop:hasSentenceText "Finally, we investigated differences in fecal microbiota between 64 schizophrenia patients and 53 healthy controls." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/29352709> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/29843470_6> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_29843470_6" ;
    gutprop:hasSentenceText "Abnormal microbiota and the microbiota⁻gut⁻brain dysfunction may cause mental disorders, while correcting these disturbance could alleviate depression." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/29843470> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/29843470_8> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_29843470_8" ;
    gutprop:hasSentenceText "Depression is closely related with the health condition of the brain⁻gut axis, and maintaining/restoring the normal condition of gut microbiota helps in the prevention/therapy of mental disorders." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/29843470> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/29857583_5> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_29857583_5" ;
    gutprop:hasSentenceText "Several studies showed an increase of <i>Lactobacillus</i>, <i>Bifidobacterium</i>, Verrucomicrobiaceae and <i>Akkermansia</i> in PD." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/29857583> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30072879_11> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_30072879_11" ;
    gutprop:hasSentenceText "MPTP increased the time WT, but not KO, females and males spent exploring objects." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30072879> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30072879_12> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_30072879_12" ;
    gutprop:hasSentenceText "In WT mice, MPTP improved sensorimotor function in males but impaired it in females." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30072879> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30309367_7> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_30309367_7" ;
    gutprop:hasSentenceText "Furthermore, manipulation of the gut microbiota using prebiotics and probiotics plays a potential role in the regulation of visceral pain disorders." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30309367> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30317530_7> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_30317530_7" ;
    gutprop:hasSentenceText "An in-depth understanding of the functioning of gut microbiota has led to some very exciting developments in therapeutics, such as prebiotics, probiotics, drugs and faecal transplantation leading to improved health." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30317530> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30394313_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_30394313_0" ;
    gutprop:hasSentenceText "Alteration of gut microbiota-associated epitopes in children with autism spectrum disorders." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/30394313> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30394313_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_30394313_2" ;
    gutprop:hasSentenceText "Gastrointestinal (GI) problems are common in children with ASD, and although gut microbiota is known to play an important role in ASD through the gut-brain axis, the specific mechanism is unknown." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30394313> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30405455_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_30405455_2" ;
    gutprop:hasSentenceText "In the past 7 years, we have studied the role of microbiota-brain communication on behavior in mouse models using germ-free mice, mice exposed to antibiotics, and healthy specific pathogen free mice." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30405455> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30405455_8> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_30405455_8" ;
    gutprop:hasSentenceText "Here we consider the links between co-morbid metabolic syndrome and depression, focusing on biomarkers including leptin and ghrelin in combination with assessing gut microbiota composition, as a potential tool to help identify individual differences in depressed population." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30405455> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30528936_7> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_30528936_7" ;
    gutprop:hasSentenceText "Interestingly, two bacteria, including the phylum Actinobacteria and the class Coriobacteriia were significantly correlated with the immobility time of FST." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30528936> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30701194_3> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_30701194_3" ;
    gutprop:hasSentenceText "Ninety-two children with ASD and 42 age-matched children exhibiting typical development (TD) were enrolled in the two-stage study." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30701194> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30707176_11> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_30707176_11" ;
    gutprop:hasSentenceText "Ruminococcaceae was the predominant gut bacteria and was associated with the clinical symptoms and hemodynamics of VVS, suggesting that gut microbiota might be involved in the development of VVS." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30707176> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30707176_5> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_30707176_5" ;
    gutprop:hasSentenceText "The diversity and microbiota compositions of the VVS cases and controls were compared with the independent sample t test or Mann-Whitney U test." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30707176> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30717162_5> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_30717162_5" ;
    gutprop:hasSentenceText "The study was conducted on 17 inpatients (52.9% females), who followed the same daily hospital routine, including a standard diet and received 5⁻20 mg daily doses of escitalopram." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30717162> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30828318_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_30828318_2" ;
    gutprop:hasSentenceText "Exciting pilot studies suggest probiotic applications to the gut can reduce anxiety and depression via the vagus nerve." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30828318> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31053995_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_31053995_0" ;
    gutprop:hasSentenceText "Gender specific decrease of a set of circulating N-acylphosphatidyl ethanolamines (NAPEs) in the plasma of Parkinson's disease patients." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/31053995> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31053995_4> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_31053995_4" ;
    gutprop:hasSentenceText "The aim of current study was to evaluate the potential of a particular set of N-acyl-phosphatidylethanolamines (NAPEs) as potential non-invasive plasma markers of ongoing neurodegeneration from Parkinson's disease in human subjects." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31053995> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31148353_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_31148353_0" ;
    gutprop:hasSentenceText "Gutting the brain of inflammation: A key role of gut microbiome in human umbilical cord blood plasma therapy in Parkinson's disease model." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/31148353> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31154909_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_31154909_0" ;
    gutprop:hasSentenceText "Unravelled facets of milk derived opioid peptides: a focus on gut physiology, fractures and obesity." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/31154909> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31179435_13> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_31179435_13" ;
    gutprop:hasSentenceText "Overall, 11 studies showed a positive effect on anxiety symptoms by regulating intestinal microbiota, which indicated 52% of the 21 studies were effective, and there were five studies that used probiotic supplements as interventions and six used non-probiotic interventions." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31179435> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31248424_1> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_31248424_1" ;
    gutprop:hasSentenceText "Emerging evidence suggests that gut microbiome composition alterations affect neurodegeneration through neuroinflammation in the pathogenesis of Parkinson's disease (PD)." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31248424> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31248424_6> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_31248424_6" ;
    gutprop:hasSentenceText "We further examined the cytokine changes associated with the altered gut microbiota seen in patients with PD in another independent cohort of 120 PD patients and 120 controls." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31248424> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31255682_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_31255682_0" ;
    gutprop:hasSentenceText "Altered gut microbiota and mucosal immunity in patients with schizophrenia." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/31255682> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31302116_1> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_31302116_1" ;
    gutprop:hasSentenceText "Women are roughly twice as likely as men to suffer from stress-related disorders, especially major depression and generalized anxiety." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31302116> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31302116_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_31302116_2" ;
    gutprop:hasSentenceText "Accumulating evidence suggest that microbes inhabiting the gastrointestinal tract (the gut microbiota) interact with the host brain and may play a key role in the pathogenesis of mental illnesses." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31302116> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31377712_1> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_31377712_1" ;
    gutprop:hasSentenceText "Multiple sclerosis (MS), the most common neurological disease causing disability in young adults, is widely recognised as a major stress factor." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31377712> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31488882_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_31488882_2" ;
    gutprop:hasSentenceText "Herein, we provide a potential mechanistic link between gut microbiota dysbiosis and neuroinflammation in AD progression." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31488882> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31488882_3> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_31488882_3" ;
    gutprop:hasSentenceText "Using AD mouse models, we discovered that, during AD progression, the alteration of gut microbiota composition leads to the peripheral accumulation of phenylalanine and isoleucine, which stimulates the differentiation and proliferation of pro-inflammatory T helper 1 (Th1) cells." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31488882> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31662903_6> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_31662903_6" ;
    gutprop:hasSentenceText "The faecal microbiota was assessed with GA-map® dysbiosis test and SCFA with gas chromatography and flame ionisation detection." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31662903> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31685046_4> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_31685046_4" ;
    gutprop:hasSentenceText "We performed shotgun metagenomic sequencing of stool samples from 26 MDD patients and 29 healthy controls (HCs)." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31685046> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31685046_5> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_31685046_5" ;
    gutprop:hasSentenceText "In addition to the microbiota community and the MiTBamp analyses, we also built a classification based on the Random Forests (RF) and Boruta algorithm to identify the gut microbiota as biomarkers for MDD." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31685046> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31685046_6> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_31685046_6" ;
    gutprop:hasSentenceText "The Bacteroidetes abundance was strongly reduced whereas that of Actinobacteria was significantly increased in the MDD patients compared with the abundance in the HCs." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31685046> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31704402_7> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_31704402_7" ;
    gutprop:hasSentenceText "Furthermore, we found a nominal soil-derived anaerobic spore-forming butyrate-producer, Kineothrix alysoides, was supplemented to a greater extent in the gut microbiomes of high biodiversity treatment mice." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31704402> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31722343_6> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_31722343_6" ;
    gutprop:hasSentenceText "The following review highlights published evidence linking the function of gut microbiota both to bipolar disorder risk and to the effect of medications that influence microbiota, inflammation, and mood symptoms." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31722343> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31750916_3> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_31750916_3" ;
    gutprop:hasSentenceText "This review examines evidence of the effects of dietary fiber on depression and inflammation and considers plausible mechanisms linking dietary fiber and depression, including microbiota-driven modification of gene expression and increased production of neurotransmitters." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31750916> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31821833_1> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_31821833_1" ;
    gutprop:hasSentenceText "There has been an accumulation of knowledge about the human microbiome, some detailed investigations of the gastrointestinal microbiota and its functions, and the highlighting of complex interactions between the gut, the gut microbiota, and the central nervous system." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31821833> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31917834_6> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_31917834_6" ;
    gutprop:hasSentenceText "Exposure to probiotics during puberty can mitigate inflammation, reverse dysbiosis, and decrease vulnerabilities to brain disorders later in life." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31917834> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31917834_7> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_31917834_7" ;
    gutprop:hasSentenceText "The goal of this review is to reveal the consequences of pubertal exposure to stress and immune challenges on the gut microbiota, immune reactivity within the brain, and the risk or resilience to stress-induced mental illnesses and neurodegenerative disorders." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31917834> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31940482_4> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_31940482_4" ;
    gutprop:hasSentenceText "Multiple B. subtilis strains trigger the protective effect via both spores and vegetative cells, partly due to a biofilm formation in the gut of the worms and the release of bacterial metabolites." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31940482> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31952911_6> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_31952911_6" ;
    gutprop:hasSentenceText "The most consistent microbiota changes were a tendency towards higher abundance of Actinobacteria and lower abundance of Firmicutes at the phylum level, lower abundance of Lachnospiraceae at family level and lower abundance of Faecalibacterium at genus level for the mental disorders overall." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31952911> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32056910_4> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_32056910_4" ;
    gutprop:hasSentenceText "This review set out to identify case-control studies comparing the gut microbiota in anxiety/depression, IBS, and both conditions comorbidly relative to each other and to controls, as well as gut microbiota investigations including measures of both IBS and anxiety/depression." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32056910> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32056910_9> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_32056910_9" ;
    gutprop:hasSentenceText "Machine learning and beta diversity distinguished between IBS participants with and without anxiety/depression by their gut microbiota." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32056910> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32163822_3> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_32163822_3" ;
    gutprop:hasSentenceText "Further support for the relevance of the bidirectional gut microbiota-brain communication in mood disorders has been presented, such as the effect of probiotics on brain connectivity and mental health outcomes and pregnancy related stress on gut microbiota in the newborn child." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32163822> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32188376_1> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_32188376_1" ;
    gutprop:hasSentenceText "Bipolar disorder and major depression are associated with significant disability, morbidity, and reduced life expectancy." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32188376> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32379622_13> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_32379622_13" ;
    gutprop:hasSentenceText "These findings suggest that betaine supplementation contributed to resilience to anhedonia in mice subjected to CSDS through anti-inflammation action." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32379622> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32379622_9> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_32379622_9" ;
    gutprop:hasSentenceText "At the genus level, CSDS caused marked increases in the several bacteria of water-treated mice, but not betaine-treated mice." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32379622> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32431588_6> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_32431588_6" ;
    gutprop:hasSentenceText "Using HEK293 cells overexpressing α-syn-A53T-CFP/YFP, we assessed α-syn seeding activity using Fluorescence Resonance Energy Transfer (FRET) to detect and quantify α-syn aggregation." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32431588> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32518376_3> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_32518376_3" ;
    gutprop:hasSentenceText "Here, we investigated the effects of subdiaphragmatic vagotomy (SDV) on the depression-like phenotype and the abnormal composition of gut microbiota in mice after lipopolysaccharide (LPS) administration." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32518376> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32518376_8> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_32518376_8" ;
    gutprop:hasSentenceText "Furthermore, LPS led to significant alterations in gut microbiota diversity in sham-operated mice, but not SDV-operated mice." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32518376> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32538869_1> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_32538869_1" ;
    gutprop:hasSentenceText "It was recently shown (Sampson et al., Elife9, 2020) that an amyloidogenic protein, CsgA, present in E. coli biofilms in the gut can trigger Parkinson's disease in mice." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32538869> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32538869_6> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_32538869_6" ;
    gutprop:hasSentenceText "It is of high importance to expand investigations of cross-reactivity between amyloidogenic proteins to both reveal underlying mechanisms and links between human diseases, as well as to develop new treatments that may be based on an altered gut microbiome." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32538869> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32572814_11> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_32572814_11" ;
    gutprop:hasSentenceText "The effects of butyrate in turn were significantly attenuated by beta-hydroxy butyrate (BHB), a selective FA3R antagonist." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32572814> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32572814_12> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_32572814_12" ;
    gutprop:hasSentenceText "Moreover, a selective FA3R agonist (AR 420626) also provided protective effects against SALS, which was totally blocked by BHB." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32572814> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32739746_9> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_32739746_9" ;
    gutprop:hasSentenceText "Further, increasing AEA levels using the well-characterized fatty acid amide hydrolase (FAAH) inhibitor URB597 was sufficient to reverse both neuroendocrine phenotypes in C. albicans-colonized mice." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32739746> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32834004_5> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_32834004_5" ;
    gutprop:hasSentenceText "We investigate three strategies of performing predictive analysis: (1) LASSO: fitting a LASSO multinomial logistic regression model to all OTU counts with specific transformation; (2) screening+GLM: screening OTUs with q-values returned by fitting a GLMM to each OTU, then fitting a GLM model using a subset of selected OTUs; (3) screening+LASSO: fitting a LASSO to a subset of OTUs selected with GLMM." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32834004> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32987656_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_32987656_2" ;
    gutprop:hasSentenceText "The pathogenesis of PD is believed to involve oxidative stress, disruption to mitochondria, alterations to the protein α-synuclein, and neuroinflammatory processes." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32987656> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32987656_7> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_32987656_7" ;
    gutprop:hasSentenceText "Evidence suggests that the intake of dietary polyphenols may inhibit neurodegeneration and the progression of PD." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32987656> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33067915_7> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33067915_7" ;
    gutprop:hasSentenceText "Among women who were not exposed to an antibiotic at any point during pregnancy, flu in second trimester was significantly associated with increased odds of ASD (aOR = 4.05 [1.14-14.38], P = .03), after adjustment for child sex, child birth year, maternal age, gestational age, C-section delivery, and low birthweight." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33067915> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33067915_9> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33067915_9" ;
    gutprop:hasSentenceText "LAY SUMMARY: We looked at whether the association between activation of the immune system during pregnancy and risk of the child developing autism spectrum disorder (ASD) differed among women who did or did not take an antibiotic at any point during pregnancy." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33067915> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33076930_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33076930_0" ;
    gutprop:hasSentenceText "Gut bacterial deamination of residual levodopa medication for Parkinson's disease." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/33076930> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33194817_3> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33194817_3" ;
    gutprop:hasSentenceText "Here, we propose that the differences in structure and composition of IBS-D and depression gut microbiota give rise to different downstream functions, which lead to distinct clinical phenotypes <i>via</i> host metabolism and further influence the interaction of brain-gut axis." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33194817> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33194817_8> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33194817_8" ;
    gutprop:hasSentenceText "Context based genome annotation suggest that an alteration of <i>Escherichia coli</i> and <i>Enterobacter cloacae</i> in IBS-D and depression respectively may be responsible for the enrichment described above." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33194817> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33195226_6> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33195226_6" ;
    gutprop:hasSentenceText "Analysis of composition of microbiomes (ANCOM) models were performed to evaluate microbiota compositions, which identified a decreased relative abundance of the <i>Erysipelotrichaceae</i> family and <i>Allobaculum</i> genus in this mouse model of SZ." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33195226> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33244049_3> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33244049_3" ;
    gutprop:hasSentenceText "The research was performed using high-throughput 16S rRNA gene sequencing to obtain gut microbiome profiles, as well as a self-report survey that included the Positive Affect Negative Affect Schedule (PANAS)." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33244049> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33244049_7> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33244049_7" ;
    gutprop:hasSentenceText "Together, the current findings highlight the enterotype-specific links between the gut microbiota community and emotion in healthy adults and suggest the possible roles of the gut microbiome in promoting mental health." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33244049> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33271210_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33271210_0" ;
    gutprop:hasSentenceText "A systematic review of microbiome changes and impact of probiotic supplementation in children and adolescents with neuropsychiatric disorders." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/33271210> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33271210_7> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33271210_7" ;
    gutprop:hasSentenceText "One study showed an increase in prosocial behavior in children with Autism Spectrum Disorder (ASD) and an increase in the Lachnospiraceae family following prebiotic supplementation." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33271210> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33271210_9> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33271210_9" ;
    gutprop:hasSentenceText "A study evaluating infant supplementation of prebiotics showed both a decreased likelihood of developing Attention Deficit Hyperactivity Disorder (ADHD) or ASD and decreased gut Bifidobacterium." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33271210> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33271426_5> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33271426_5" ;
    gutprop:hasSentenceText "Alpha and beta diversity findings were inconsistent; however, differences in bacterial taxa indicated disorders may be characterised by a higher abundance of proinflammatory species (e.g., Enterobacteriaceae and Desulfovibrio), and lower short-chain fatty acid producing-bacteria (e.g., Faecalibacterium)." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33271426> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33287442_7> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33287442_7" ;
    gutprop:hasSentenceText "Many cancer treatments have been shown to shift the gut microbiota toward dysbiosis; however, the microbiota can also be positively manipulated through diet, prebiotic and probiotic supplementation, and exercise." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33287442> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33318317_3> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33318317_3" ;
    gutprop:hasSentenceText "Elderly patients diagnosed with mild cognitive impairment underwent a randomized-control trial of mindful awareness practice." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33318317> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33422110_5> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33422110_5" ;
    gutprop:hasSentenceText "While VSL #3 has been reported to have anti-inflammatory effects, DSS is often used as a model of colitis because of the gut inflammation and the breach of the intestinal barrier that it induces." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33422110> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33422110_8> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33422110_8" ;
    gutprop:hasSentenceText "In fact, DSS markedly increased taxa belonging to the Bacteroidaceae and Porphyromonadaceae families but reduced those from Rikencellaceae and S24-7, as well as provoking colonic pro-inflammatory cytokine expression, consistent with an inflamed gut." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33422110> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33422110_9> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33422110_9" ;
    gutprop:hasSentenceText "The DSS also increased the impact of LPS plus paraquat upon microglial morphology, along with circulating lipocalin-2 (neutrophil marker) and IL-6." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33422110> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33454868_5> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33454868_5" ;
    gutprop:hasSentenceText "This review focuses on how gut microbiota can affect breast cancer development through estrogen activity and discusses the types of bacteria that may be involved in the onset and the progression of breast cancer." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33454868> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33467657_4> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33467657_4" ;
    gutprop:hasSentenceText "We briefly summarise research implicating the gut microbiota in maternal obesity-induced changes to offspring behaviour." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33467657> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33505487_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33505487_2" ;
    gutprop:hasSentenceText "In the genus level, the abundance of <i>Pseudobutyrivibrio</i> and <i>Ruminiclostridium</i> is higher in the experiment group than in the control, whereas that of <i>Fusicatenibacter</i> is less." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33505487> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33511258_1> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33511258_1" ;
    gutprop:hasSentenceText "Stress has been shown to disturb the balance of human intestinal microbiota and subsequently causes mental health problems like anxiety and depression." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33511258> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33511258_10> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33511258_10" ;
    gutprop:hasSentenceText "Our results showed a potential link between probiotic-induced gut microbiota modulation and stress/anxiety alleviation in stressed adults, supporting that the gut-brain axis was involved in relieving stress-related symptoms." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33511258> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33651324_12> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33651324_12" ;
    gutprop:hasSentenceText "The over-representation of aerotolerant bacteria in the gut may reflect worse oxidative stress and barrier defects and may contribute to emotional distress during HIV infection." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33651324> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33651324_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33651324_2" ;
    gutprop:hasSentenceText "We investigated whether dysbiotic signatures in the gut microbiome of persons living with HIV (PLWH) are associated with their emotional status." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33651324> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33651324_3> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33651324_3" ;
    gutprop:hasSentenceText "We retrospectively examined the gut microbiome and clinical evaluation of 129 adults (94 PLWH and 35 HIV-) enrolled at UC San Diego's HIV Neurobehavioral Research Program." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33651324> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33664475_4> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33664475_4" ;
    gutprop:hasSentenceText "We capitalized on a knock-out (KO) mouse model (B6.129-St6gal1<sup>tm2Jxm</sup>/J) lacking the gene responsible for the synthesis of sialyl(alpha2,6)lactose (6'SL), one of the two sources of sialic acid (Neu5Ac) to the lactating offspring." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33664475> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33664475_6> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33664475_6" ;
    gutprop:hasSentenceText "To deprive lactating offspring of 6'SL, we cross-fostered newborn wild-type (WT) pups to KO dams, which provide 6'SL-deficient milk." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33664475> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33677218_4> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33677218_4" ;
    gutprop:hasSentenceText "ELISA, immunofluorescence staining and Western blot were used to analysis the activation of glial cells and NLRP3 inflammasome." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33677218> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33692356_1> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33692356_1" ;
    gutprop:hasSentenceText "The gut microbiota is emerging as an important modulator of neurodegenerative diseases, and accumulating evidence has linked gut microbes to Parkinson's disease (PD) symptomatology and pathophysiology." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33692356> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33722869_3> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33722869_3" ;
    gutprop:hasSentenceText "The Bugs and Brains Study aims to investigate complex relationships between anxiety/depression and irritable bowel syndrome (IBS) in two ways." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33722869> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33777957_7> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33777957_7" ;
    gutprop:hasSentenceText "Overall, the gut microbiota provides a novel way to alter neurotransmitter modulation in the brain and treat gut-brain axis diseases, such as anxiety and depression." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33777957> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33819374_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33819374_0" ;
    gutprop:hasSentenceText "Trimethylamine modulates dauer formation, neurodegeneration, and lifespan through tyra-3/daf-11 signaling in Caenorhabditis elegans." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/33819374> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33819374_4> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33819374_4" ;
    gutprop:hasSentenceText "We demonstrate that the tyramine receptor TYRA-3, a conserved G protein-coupled receptor (GPCR), is required to sense TMA and mediate its responses." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33819374> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33895287_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33895287_2" ;
    gutprop:hasSentenceText "Disruptions to gut homeostasis (diarrhea, constipation, microbial dysbiosis) are also observed in patients receiving chemotherapy." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33895287> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33899052_12> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33899052_12" ;
    gutprop:hasSentenceText "There were significant changes in the normalized abundance of phyla Actinobacteria (p = .040; d = 0.845) and Verrucomicrobia (p = .024; d = 0.675) as well as in genus Roseburia (p = .033; d = 1.109), Intestinimonas (p = .035; d = 0.627) and Anaerotruncus (p = .004) Post-OMM." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33899052> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33899052_13> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33899052_13" ;
    gutprop:hasSentenceText "The gut microbiome shifted among individuals with constipation and PD after four weekly treatments with the OMM-sequence." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33899052> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33899052_4> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33899052_4" ;
    gutprop:hasSentenceText "The effects of 4 weekly treatments on the gut microbiome among men and women over 40 years old with chronic constipation and PD were investigated." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33899052> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33936013_7> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33936013_7" ;
    gutprop:hasSentenceText "We showed that the GAD-system consists of at least four highly conserved genes encoding a GAD, a glutaminase, a glutamate/GABA antiporter, and a potassium channel." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33936013> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33936013_8> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33936013_8" ;
    gutprop:hasSentenceText "We demonstrated a high prevalence of the GAD-system among <i>Bacteroides</i> with 90% of all <i>Bacteroides</i> genomes (96% in human gut isolates only) harboring all genes of the GAD-system and 16 intestinal <i>Bacteroides</i> strains producing GABA <i>in vitro</i> (ranging from 0.09 to 60.84 mM)." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33936013> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33963281_5> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33963281_5" ;
    gutprop:hasSentenceText "Moreover, the absence of the gut microbiota suppressed inflammatory response and cognitive impairment induced by SD in germ-free (GF) mice." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33963281> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33963284_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33963284_2" ;
    gutprop:hasSentenceText "(R,S)-ketamine is a racemic mixture of equal amounts of (R)-ketamine (arketamine) and (S)-ketamine (esketamine)." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33963284> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33963284_5> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33963284_5" ;
    gutprop:hasSentenceText "In clinical trials, non-ketamine NMDAR-related compounds did not exhibit ketamine-like robust antidepressant actions in patients with depression, despite these compounds showing antidepressant-like effects in rodents." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33963284> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33967849_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33967849_0" ;
    gutprop:hasSentenceText "Effectiveness of Probiotic, Prebiotic, and Synbiotic Supplementation to Improve Perinatal Mental Health in Mothers: A Systematic Review and Meta-Analysis." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/33967849> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33967849_5> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33967849_5" ;
    gutprop:hasSentenceText "Pooled mean differences (MD) and odds ratios (pOR) with 95% confidence intervals (CI) were calculated in random-effects meta-analyses for the outcomes of interest in the review." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33967849> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33967849_7> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33967849_7" ;
    gutprop:hasSentenceText "There were no differences between probiotics and control groups in the mean depression scores (MD -0.46; 95% CI -2.16, 1.25) at end of follow-up." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33967849> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34004259_4> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34004259_4" ;
    gutprop:hasSentenceText "Repeated administration of CNO or C21 as drinking water did not alter the α- and β-diversity of gut microbiota in mice compared with control mice." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34004259> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34004259_7> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34004259_7" ;
    gutprop:hasSentenceText "In addition, the LEfSe algorithm identified the family Clostridiaceae, the genus Faecalicatena and the genus Marinisporobacter, these three bacteria of different taxonomic as potential microbial markers for the C21 group relative to the control group." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34004259> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34004259_8> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34004259_8" ;
    gutprop:hasSentenceText "In contrast, repeated administration of CNO (or C21) did not alter SCFAs in feces samples of adult mice." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34004259> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34004259_9> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34004259_9" ;
    gutprop:hasSentenceText "The data suggest that repeated administration of CNO or C21 contributes to an unusual organization of the gut microbiota in adult mice." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34004259> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34014031_10> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34014031_10" ;
    gutprop:hasSentenceText "In this review, we focus on the influence of intestine microbiota on the expression of bipolar gene TRANK1 and propose that intestine microbiota-dependent type 1 interferon signalling is sufficient to induce the over-expression of TRANK1, consequently causing the compromise of BBB integrity and facilitating the entrance of inflammatory mediators into the brain." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34014031> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34014031_9> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34014031_9" ;
    gutprop:hasSentenceText "Administration of type 1 interferon can induce the expression of TRANK1, which is associated with elevated circulating biomarkers of the impaired blood-brain barrier in BD patients." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34014031> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34092293_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34092293_0" ;
    gutprop:hasSentenceText "Studies on blood enrichment and anti-tumor effects of combined Danggui Buxue Decoction, Fe and rhEPO based on colon cancer-related anemia model and gut microbiota modulation." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/34092293> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34092293_5> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34092293_5" ;
    gutprop:hasSentenceText "oxaliplatin, rhEPO + DBD high dosage + Fe (EDF) and rhEPO + DBD high dosage (ED) groups had the best blood enrichment effect." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34092293> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34092293_9> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34092293_9" ;
    gutprop:hasSentenceText "Our findings proposed the best treatment combination of DBD, rhEPO and Fe in CCRA and provided theoretical basis and literature reference for CCRA-induced intestinal flora disorder and the regulatory mechanism of EDF." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34092293> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34147969_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34147969_2" ;
    gutprop:hasSentenceText "Soluble epoxide hydrolase (coded by the Ephx2 gene) plays an important role in inflammation, which has been implicated in stress-related depression." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34147969> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34172092_3> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34172092_3" ;
    gutprop:hasSentenceText "Herein we used a non-absorbable antibiotic vancomycin to modify the gut microbiota in streptozotocin (STZ)-induced T1D mice and studied the impact of microbial changes on cognitive performances in T1D mice and its potential gut-brain neural mechanism." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34172092> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34174901_3> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34174901_3" ;
    gutprop:hasSentenceText "Surprisingly the consequences of minocycline's antibiotic (i.e., antibacterial) effects on the gut microbiota and systemic immune response after spinal cord injury have largely been ignored despite their links to changes in mental health and immune suppression." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34174901> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34204057_1> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34204057_1" ;
    gutprop:hasSentenceText "It has been established, worldwide, that non-communicable diseases such as obesity, diabetes, metabolic syndrome, and cardiovascular events account for a high percentage of morbidity and mortality in contemporary societies." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34204057> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34290352_11> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34290352_11" ;
    gutprop:hasSentenceText "This study suggests that the intestinal flora of depressed patients has a tendency to return to normal under escitalopram treatment." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34290352> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34311029_1> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34311029_1" ;
    gutprop:hasSentenceText "Lipids are essential in maintaining brain function, and lipid profiles have been reported to be altered in aged and Alzheimer's disease (AD) brains as compared to healthy mature brains." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34311029> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34408160_4> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34408160_4" ;
    gutprop:hasSentenceText "Recently, dysbiosis of gut microbiome in PD was identified: altered abundances of three microbial clusters were found, one of which was composed of opportunistic pathogens." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34408160> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34408160_6> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34408160_6" ;
    gutprop:hasSentenceText "Results put forth testable hypotheses on the role of gut microbiome in the pathogenesis of PD, the incomplete penetrance of PD susceptibility genes, and potential triggers of pathology in the gut." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34408160> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34422393_1> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34422393_1" ;
    gutprop:hasSentenceText "The microbiome refers to a population of microbes that colonize the skin, nasopharynx, oral cavity, gastrointestinal tract, and urogenital tract." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34422393> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34437440_1> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34437440_1" ;
    gutprop:hasSentenceText "Colorectal cancer (CRC) is a leading cause of cancer death worldwide, and its incidence is correlated with infections, chronic inflammation, diet, and genetic factors." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34437440> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34444820_3> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34444820_3" ;
    gutprop:hasSentenceText "A total of 156 healthy adults with subclinical symptoms of depression, anxiety, and insomnia were retrospectively registered and randomly assigned to receive either NVP-1704 (<i>n</i> = 78) or a placebo (<i>n</i> = 78) for eight weeks." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34444820> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34448737_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34448737_2" ;
    gutprop:hasSentenceText "Manipulation of gut microbiota may be then useful to decode this role and to provide novel therapeutics for major depressive disorder (MDD), developing microbiota-related biomarkers to stratify patients at risk and to delineate more homogeneous biotypes of MDD." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34448737> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34480631_9> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34480631_9" ;
    gutprop:hasSentenceText "These data demonstrate that repeated administration of PLX5622 leads to an abnormal composition of the gut microbiota and lactic acid in adult mice." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34480631> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34704023_12> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34704023_12" ;
    gutprop:hasSentenceText "Neither richness nor evenness was significantly altered in Parkinson's disease and multiple sclerosis patients in comparison to healthy controls (<i>P</i>-value > 0.05)." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34704023> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34758889_9> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34758889_9" ;
    gutprop:hasSentenceText "The FD mice also exhibited gut microbiota dysbiosis (decreased Bacteroidetes and increased Proteobacteria), which was significantly associated with the cognitive deficits." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34758889> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34836918_1> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34836918_1" ;
    gutprop:hasSentenceText "Idiopathic Parkinson's disease (PD) is characterised by alpha-synuclein (aSyn) aggregation and death of dopaminergic neurons in the midbrain." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34836918> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34836918_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34836918_2" ;
    gutprop:hasSentenceText "Recent evidence posits that PD may initiate in the gut by microbes or their toxins that promote chronic gut inflammation that will ultimately impact the brain." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34836918> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34836918_3> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34836918_3" ;
    gutprop:hasSentenceText "In this work, we sought to demonstrate that the effects of the microbial toxin β-<i>N</i>-methylamino-L-alanine (BMAA) in the gut may trigger some PD cases, which is especially worrying as this toxin is present in certain foods but not routinely monitored by public health authorities." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34836918> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34884399_8> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34884399_8" ;
    gutprop:hasSentenceText "In this study, we enrolled 27 hospitalized PD patients with well-controlled symptoms." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34884399> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34961418_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34961418_0" ;
    gutprop:hasSentenceText "Effects of Berberine on Gut Microbiota in Patients with Mild Metabolic Disorders Induced by Olanzapine." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/34961418> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34961418_1> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34961418_1" ;
    gutprop:hasSentenceText "Secondary metabolic disturbances in patients with schizophrenia or bipolar disorder may be attributed to olanzapine." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34961418> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34961418_3> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34961418_3" ;
    gutprop:hasSentenceText "This study aims to investigate the effects of berberine on intestinal flora in patients with mild metabolic disorders induced by olanzapine." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34961418> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34961418_9> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34961418_9" ;
    gutprop:hasSentenceText "In patients who received berberine, the abundance of firmicutes was significantly decreased, and the abundance of bacteroides was significantly increased, and in patients who received placebo, the abundance of firmicutes was significantly increased post-treatment, compared to baseline (both [Formula: see text]< 0.05)." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34961418> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34970638_4> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34970638_4" ;
    gutprop:hasSentenceText "Mice in the DEX group were gavaged twice a day with 0.2 mg/kg of DEX for 5 weeks, whereas CON mice were given the same amount of solvent." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34970638> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34985325_9> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34985325_9" ;
    gutprop:hasSentenceText "This review also discusses the potential health benefits of the administration of probiotics, prebiotics, postbiotics, and synbiotics and fecal microbiota transplantation in neurological disorders." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34985325> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35069178_5> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_35069178_5" ;
    gutprop:hasSentenceText "Accumulating evidence suggests that the onset of non-motor symptoms, such as gastrointestinal manifestations, often precede the onset of motor symptoms and disease diagnosis, lending support to the potential role that the microbiome-gut-brain axis might play in the underlying pathological mechanisms of Parkinson's disease." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35069178> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35203906_1> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_35203906_1" ;
    gutprop:hasSentenceText "In this review we attempt to collate the existing scientific evidence regarding the possible role of severe acute respiratory syndrome coronavirus 2 (SARS-CoV-2) in the pathophysiology of Parkinson's disease (PD), as well as to investigate the impact of PD/parkinsonism on the clinical course of the viral infection itself." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35203906> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35207632_5> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_35207632_5" ;
    gutprop:hasSentenceText "Thus, identification of potential targets for novel therapies to alleviate PD-induced GI dysfunctions are essential to improve clinical outcomes and quality of life in people with PD." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35207632> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35207632_6> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_35207632_6" ;
    gutprop:hasSentenceText "Unlike the central nervous system (CNS), where PD pathology and the mechanisms involved in CNS damage are relatively well characterised, the effect of PD at the cellular and tissue level in the enteric nervous system (ENS) remains unclear, making it difficult to alleviate or reverse GI symptoms." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35207632> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35326429_9> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_35326429_9" ;
    gutprop:hasSentenceText "Influenza infections may increase the risk of Parkinson's disease by causing the overgrowth of H<sub>2</sub>S-producing bacteria both in the colon and duodenum." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35326429> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35327401_4> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_35327401_4" ;
    gutprop:hasSentenceText "<i>Drosophila</i> models have been extensively used not only to study animal behaviors (i.e., courtship, aggression, sleep, and learning & memory), but also some human related neurodegenerative diseases (i.e., Alzheimer's disease and Parkinson's disease) in the past." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35327401> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35565918_5> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_35565918_5" ;
    gutprop:hasSentenceText "For the moment, it seems that KD can provide therapeutic benefits in patients with neurological problems by effectively controlling the balance between pro- and antioxidant processes and pro-excitatory and inhibitory neurotransmitters, and modulating inflammation or changing the composition of the gut microbiome." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35565918> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35565918_6> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_35565918_6" ;
    gutprop:hasSentenceText "In this review we evaluated the potential therapeutic efficacy of KD in epilepsy, depression, migraine, Alzheimer's disease and Parkinson's disease." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35565918> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35571084_12> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_35571084_12" ;
    gutprop:hasSentenceText "Finally, we propose to screen the long list of antibiofilm agents, both FDA-approved drugs and novel compounds, for their neuroprotective effects and develop new pharmaceuticals that target the gut microbiome for the treatment of NDs." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35571084> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35654142_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_35654142_2" ;
    gutprop:hasSentenceText "The Escherichia coli functional amyloid CsgA is known to accelerate α-synuclein aggregation in vitro and induce PD symptoms in mice." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35654142> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35722294_6> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_35722294_6" ;
    gutprop:hasSentenceText "Moreover, enrichment analyses revealed that host genes correlated with <i>Blautia</i> genus abundance were mainly involved in mitochondrial function and energy metabolism, and mapped to neurodegenerative diseases (NDDs) and metabolic diseases." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35722294> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35798742_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_35798742_2" ;
    gutprop:hasSentenceText "We aimed to investigate the connection between the oral and gut microbiome and the functional changes in the PD-specific gut microbiome using shotgun metagenomic sequencing." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35798742> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35798742_3> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_35798742_3" ;
    gutprop:hasSentenceText "The taxonomic composition of the oral and gut microbiome was significantly different between PD patients and healthy controls (P = 0.003 and 0.001, respectively)." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35798742> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35798742_5> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_35798742_5" ;
    gutprop:hasSentenceText "Functional analysis revealed that microbial gene markers for glutamate and arginine biosynthesis were downregulated, while antimicrobial resistance gene markers were upregulated in PD patients than healthy controls (all P < 0.001)." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35798742> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35914559_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_35914559_0" ;
    gutprop:hasSentenceText "Oral ingestion of the environmental toxicant trichloroethylene in rats induces alterations in the gut microbiome: Relevance to idiopathic Parkinson's disease." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/35914559> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35914559_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_35914559_2" ;
    gutprop:hasSentenceText "As a major site of contact with the environment, questions have emerged surrounding the cause and effect of alterations to the gut microbiome by environmental contaminants associated with PD risk, such as pesticides, metals, and organic solvents." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35914559> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35914559_4> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_35914559_4" ;
    gutprop:hasSentenceText "As TCE is the most common organic contaminant within drinking water, we postulated that ingestion of TCE associated with PD-related neurodegeneration may alter the gut microbiome to a similar extent as observed in persons with PD." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35914559> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35965349_5> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_35965349_5" ;
    gutprop:hasSentenceText "Previous studies investigating the effects of AGPs on the poultry gut microbiome have largely focused on 16S rDNA surveys based on a single gastrointestinal (GI) site, diet, and/or timepoint, resulting in an inconsistent view of their impact on community composition." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35965349> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36056574_1> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_36056574_1" ;
    gutprop:hasSentenceText "Depression is prevalent among Asian Americans (AsA) during the COVID-19 pandemic, and depression often leads to sleep disturbance in this population." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36056574> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36072564_4> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_36072564_4" ;
    gutprop:hasSentenceText "Levels of microbiota-derived metabolites are elevated in older individuals with age-associated diseases and cognitive defects compared to younger, healthy age groups." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36072564> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36191806_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_36191806_2" ;
    gutprop:hasSentenceText "We previously reported that Chrna7 knock-out (KO) mice show depression-like behaviors through abnormal composition of gut microbiota and systemic inflammation." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36191806> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36191806_6> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_36191806_6" ;
    gutprop:hasSentenceText "the species Lactobacillus sp. BL302, the species Lactobacillus hominis, and the species Lactobacillus reuteri, were identified as potential microbial markers in the KO + SDV group." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36191806> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36216056_10> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_36216056_10" ;
    gutprop:hasSentenceText "The metabolism pathways of estrogen signaling (estriol, 16-glucuronide-estriol and 21-desoxycortisol) and choline metabolism (phosphocholine) were significantly altered by PM exposure." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36216056> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36216056_12> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_36216056_12" ;
    gutprop:hasSentenceText "Fibrobacteres and Deinococcus-Thermus were positively correlated with the level of phosphocholine, which was correlated with increased spontaneous activity, excitability and anxiety." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36216056> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36216056_14> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_36216056_14" ;
    gutprop:hasSentenceText "Exposure to PM may affect composition of gut microbiome and alterations of estrogen signaling pathway and choline metabolism pathway, which were associated with partial SCZ-like behaviors." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36216056> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36332796_8> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_36332796_8" ;
    gutprop:hasSentenceText "We explain the strong relationship between the gut microbiota and the brain in PD subjects, by delineating the multiple mechanisms involved inneuroinflammation and oxidative stress." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36332796> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36346385_11> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_36346385_11" ;
    gutprop:hasSentenceText "Notably, depletion of microglia using a CSF1R inhibitor eliminates the beneficial effects of prebiotics by restoring motor deficits to ASO mice despite feeding a prebiotic diet." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36346385> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36346385_4> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_36346385_4" ;
    gutprop:hasSentenceText "Intestinal bacteria ferment dietary fibers into short-chain fatty acids, with fecal levels of these molecules differing between PD and healthy controls and in mouse models." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36346385> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36346385_8> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_36346385_8" ;
    gutprop:hasSentenceText "Concomitantly, the gut microbiome of ASO mice adopts a profile correlated with health upon prebiotic treatment, which also reduces microglial activation." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36346385> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36346385_9> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_36346385_9" ;
    gutprop:hasSentenceText "Single-cell RNA-seq analysis of microglia from the substantia nigra and striatum uncovers increased pro-inflammatory signaling and reduced homeostatic responses in ASO mice compared to wild-type counterparts on standard diets." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36346385> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36411639_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_36411639_0" ;
    gutprop:hasSentenceText "Deciphering the gut microbiome in neurodegenerative diseases and metagenomic approaches for characterization of gut microbes." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/36411639> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36411639_4> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_36411639_4" ;
    gutprop:hasSentenceText "Gut microbial-derived metabolites also have an important role in neurological diseases such as Alzheimer's disease, Parkinson's disease, etc." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36411639> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36493975_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_36493975_2" ;
    gutprop:hasSentenceText "Dietary intake of cuprizone (CPZ) produces demyelination resembling that of patients with MS." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36493975> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36493975_4> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_36493975_4" ;
    gutprop:hasSentenceText "SDV significantly ameliorated demyelination and microglial activation in the brain compared with sham-operated CPZ-treated mice." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36493975> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36493975_5> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_36493975_5" ;
    gutprop:hasSentenceText "Furthermore, 16S ribosomal RNA analysis revealed that SDV significantly improved the abnormal gut microbiota composition of CPZ-treated mice." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36493975> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36493975_6> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_36493975_6" ;
    gutprop:hasSentenceText "An untargeted metabolomic analysis demonstrated that SDV significantly improved abnormal blood levels of metabolites in CPZ-treated mice compared with sham-operated CPZ-treated mice." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36493975> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36493975_9> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_36493975_9" ;
    gutprop:hasSentenceText "Together, these data suggest that CPZ produces demyelination in the brain through the gut-microbiota-brain axis via the subdiaphragmatic vagus nerve." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36493975> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36517709_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_36517709_0" ;
    gutprop:hasSentenceText "Porphyra haitanensis Polysaccharides Attenuates Blood Lipid via Gut-Liver Axis in Diet-Induced High-Fat Mesocricetus auratus through Multiple Integrated Omics." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/36517709> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36517709_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_36517709_2" ;
    gutprop:hasSentenceText "The present study is aimed at revealing the mechanism of Porphyra haitanensis polysaccharide (PHP) in decreasing blood lipids by acting through gut-liver axis in Mesocricetus auratus fed a high-fat diet." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36517709> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36550591_11> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_36550591_11" ;
    gutprop:hasSentenceText "Lactococcus is enriched in DD-derived microbiota composition, and Biffdobacterium and Lactobacillus in H12-8 group." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36550591> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36550591_15> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_36550591_15" ;
    gutprop:hasSentenceText "XPJYF treatment targets inflammation, activation, and glycometabolim in astrocyte via gut microbiota modulation, thereby improve animal behaviors, HPA axis dysfunction, and neurotransmitter synthesis in depression rats." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36550591> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36550591_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_36550591_2" ;
    gutprop:hasSentenceText "We collected fecal microbiota from patients with depressive disorder (DD) and cultured microbiota in vitro." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36550591> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36651663_10> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_36651663_10" ;
    gutprop:hasSentenceText "The relative abundance of <i>Anaerostipes</i> was positively correlated with childhood trauma, and higher levels of <i>Turicibacter sanguinis</i> and lower levels of Lentisphaerae were found in individuals who experienced life-threatening traumas." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36651663> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36698474_11> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_36698474_11" ;
    gutprop:hasSentenceText "Even the usage of pesticides was positively correlated with the burdens of Parkinson's disease, schizophrenia, cardiovascular diseases, and neoplasms." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36698474> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36699448_1> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_36699448_1" ;
    gutprop:hasSentenceText "The gut microbiome and host genetics are both associated with major depressive disorder (MDD); however, the molecular mechanisms among the associations are poorly understood, especially in the Asian, Chinese group." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36699448> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36738999_3> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_36738999_3" ;
    gutprop:hasSentenceText "In our study, C57BL/6J mice were divided into three groups: control diet group (CON, 10 % kcal fat), high-cholesterol diet model group (HCD, 42.0 % kcal fat + 1.25 % kcal Cholesterol), and chronic restraint stress group (CRS, 10 % kcal fat) which as a positive control group for the depression model." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36738999> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36738999_4> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_36738999_4" ;
    gutprop:hasSentenceText "Six weeks later, depressive- and anxiety-like behavior were evaluated for using the OFT, SPT and TST." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36738999> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36738999_7> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_36738999_7" ;
    gutprop:hasSentenceText "5-HT (also named 5-hydroxytryptamine, 5-HT) and related receptors expression were monitored by ELISA, RT-PCR and Western blot." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36738999> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36738999_9> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_36738999_9" ;
    gutprop:hasSentenceText "Similar to CRS model, short-term HCD intervention induced anxiety and depression-like behavior behavioral abnormalities in mice." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36738999> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36760344_6> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_36760344_6" ;
    gutprop:hasSentenceText "To examine the intestinal flora, 16S rRNA gene sequencing was performed on faecal samples of 56 Tibetan Buddhist monks and neighbouring residents." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36760344> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36804535_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_36804535_0" ;
    gutprop:hasSentenceText "Beneficial effects of arketamine on the reduced bone mineral density in susceptible mice after chronic social defeat stress: Role of the gut-microbiota-bone-brain axis." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/36804535> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36804535_6> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_36804535_6" ;
    gutprop:hasSentenceText "Furthermore, significant differences in the abundance of microbiota (and plasma metabolites) were found between the CSDS + saline and CSDS + arketamine groups." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36804535> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36816743_10> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_36816743_10" ;
    gutprop:hasSentenceText "At the phylum level, <i>Firmicutes</i>, <i>Bacteroidetes</i>, <i>Actinobacteria</i>, <i>Proteobacteria</i>, and <i>Verrucomicrobia</i> were more researched." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36816743> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36900437_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_36900437_0" ;
    gutprop:hasSentenceText "Fermented Wheat Germ Alleviates Depression-like Behavior in Rats with Chronic and Unpredictable Mild Stress." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/36900437> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36900437_11> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_36900437_11" ;
    gutprop:hasSentenceText "In addition, FWG effectively altered the gut microbiota structure and remodeled the gut microbiota in CUMS rats, restored neurotransmitter levels in depressed rats through the brain-gut axis, and restored amino acid metabolic functions." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36900437> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36938477_1> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_36938477_1" ;
    gutprop:hasSentenceText "The aim of this study was to evaluate the effects of probiotics on the treatment of constipation in patients with Parkinson's disease (PD) by analyzing data from published randomized clinical trials (RCTs)." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36938477> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36938477_11> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_36938477_11" ;
    gutprop:hasSentenceText "Our results show that probiotic intake has beneficial effects on constipation in PD patients." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36938477> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36938477_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_36938477_2" ;
    gutprop:hasSentenceText "PD is a neurodegenerative disease characterized by clinical symptoms such as rigidity, bradykinesia, and resting tremor." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36938477> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36978911_5> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_36978911_5" ;
    gutprop:hasSentenceText "The gut microbiome has important roles to play in the generation of bioactive flavonoid metabolites retaining or exceeding the antioxidative and anti-inflammatory properties of the intact flavonoid and, in some cases, new antitumor and antineurodegenerative bioactivities." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36978911> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36984505_4> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_36984505_4" ;
    gutprop:hasSentenceText "According to the infection hypothesis in relation to neurodegeneration, <i>Helicobacter pylori</i> as non-commensal gut microbiome has been advocated as trigger and/or mediator of neurodegenerative diseases, such as the development of Alzheimer's disease." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36984505> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36984505_5> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_36984505_5" ;
    gutprop:hasSentenceText "Among others, <i>Helicobacter pylori</i>-related inflammatory mediators, defensins, autophagy, vitamin D, dietary factors, role of probiotics, and some pathogenetic considerations including relevant involved genes are discussed within this opinion article." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36984505> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36989335_1> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_36989335_1" ;
    gutprop:hasSentenceText "The 8-week Micronutrients for ADHD in Youth (MADDY) randomized controlled trial (<i>N</i> = 126, age 6-12) of broad-spectrum multinutrients for ADHD with emotional dysregulation found 3 times as many responders with multinutrients (54%) compared to placebo (18%) by Clinical Global Impression-Improvement (CGI-I)." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36989335> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37023596_1> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37023596_1" ;
    gutprop:hasSentenceText "The roles of gut microbiota and susceptibility genes in patients with major depression disorder (MDD) are not well understood." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37023596> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37049591_4> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37049591_4" ;
    gutprop:hasSentenceText "Fecal samples were collected, and the compositional characteristics of the intestinal flora were determined in MDD patients by MiSeq sequencing." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37049591> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37071196_11> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37071196_11" ;
    gutprop:hasSentenceText "Results indicate that Prevotella 9 and Faecalibacterium may be relevant microbial taxa in relation to externalizing behavior and social anxiety, respectively." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37071196> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37095530_6> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37095530_6" ;
    gutprop:hasSentenceText "Four potential psychobiotics (Bacteroides uniformis, Roseburia inulinivorans, Eubacterium rectale, and Faecalibacterium prausnitzii) were identified." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37095530> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37127945_10> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37127945_10" ;
    gutprop:hasSentenceText "Probiotic supplementation was found to lower patient rehospitalizations and significantly improve depressive symptoms and cognitive impairments among patients with BD." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37127945> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37127945_8> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37127945_8" ;
    gutprop:hasSentenceText "Most studies analyzed found an overall difference in gut microbiota composition in bipolar patients compared to healthy controls, though the alterations found were not consistent." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37127945> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37127945_9> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37127945_9" ;
    gutprop:hasSentenceText "Differences in Lactobacillus, Faecalibacterium, and Ruminococcus abundance in BD compared to controls were found to be the most consistent across a few of the studies, but their effects on the gut-brain axis conflicted." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37127945> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37168424_3> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37168424_3" ;
    gutprop:hasSentenceText "The 16S RNA method was used to analyze the intestinal microflora and the characteristics of serum SCFAs detection by ELISA kit, as well as the intestinal flora, SCFAs content and their correlation with MDD clinical indicators." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37168424> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37193253_12> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37193253_12" ;
    gutprop:hasSentenceText "There is a bidirectional relationship between anxiety disorder and the gut microbiota in pSS-mediated dry eye." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37193253> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37193253_14> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37193253_14" ;
    gutprop:hasSentenceText "Main gut microbiota alterations that have a facilitating impact on anxiety are emerging in pSS-mediated dry eye." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37193253> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37207228_5> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37207228_5" ;
    gutprop:hasSentenceText "To better understand the contribution of Toll-like receptor 2 and Toll-like receptor 4 dysfunction in the gut to early α-synuclein aggregation, we discussed the structural function of Toll-like receptor 2 and Toll-like receptor 4 and signal transduction of Toll-like receptor 2 and Toll-like receptor 4 in Parkinson's disease by reviewing clinical, animal models, and <i>in vitro</i> studies." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37207228> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37209162_11> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37209162_11" ;
    gutprop:hasSentenceText "• GABA levels in the brain are assonated with B. licheniformis regulating depressive-like and anxiety-like behaviours." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37209162> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37212075_5> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37212075_5" ;
    gutprop:hasSentenceText "In addition, discriminant taxa analyses identified a more pro-inflammatory bacterial profile in the IgA+ fraction of those with the AR clinical subclass compared to IgA-Biome analyses of those with the TD subclass and with the taxa identified in the unsorted control samples." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37212075> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37368331_13> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37368331_13" ;
    gutprop:hasSentenceText "Genus: <i>Enterococcus</i>, <i>Hungatella</i>, <i>Lactobacillus</i>, and <i>Oscillospira</i> of the Phylum: Firmicutes; 4." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37368331> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37368331_17> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37368331_17" ;
    gutprop:hasSentenceText "A significant decrease was described in the Family: <i>Lachnospiraceae</i> and its Genus: <i>Blautia</i>, <i>Coprococcus</i>, and <i>Roseburia</i>, which belong to the Phylum: Firmicutes." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37368331> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37396336_8> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37396336_8" ;
    gutprop:hasSentenceText "Although the exercise intervention resulted in changes to brain inflammatory activity and to cecal microbiota composition and inferred function in both sexes, reductions in the jejunal expression of pro-inflammatory markers were observed in females only." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37396336> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37403161_13> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37403161_13" ;
    gutprop:hasSentenceText "Further, older TG animals had increased intestinal inflammation, decreased Na<sup>+</sup> current and a robust alteration in metabolite production characterized by the increase of succinate levels in feces and serum." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37403161> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37403161_16> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37403161_16" ;
    gutprop:hasSentenceText "Our data emphasize that the gut microbiome dysbiosis synchronous with ageing leads to a specific alteration of gut metabolites and can be modulated by antibiotics which may affect PD pathology." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37403161> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37403161_4> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37403161_4" ;
    gutprop:hasSentenceText "<sup>1</sup>H-NMR was employed to understand the metabolite production and intestinal inflammation estimated using ELISA and RNA-sequencing from feces and the intestinal epithelial layer respectively." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37403161> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37464164_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37464164_2" ;
    gutprop:hasSentenceText "Here we describe a protocol to characterize the structural and functional phenotype of the rodent gut and to examine the gut microbiota composition through V4 16S rRNA gene sequencing and microbiome profiling." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37464164> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37468912_7> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37468912_7" ;
    gutprop:hasSentenceText "IBS-D patients with LDSD had a higher incidence of BA overexcretion (41% vs. 23% non-LDSD) with significant elevations in fecal total BAs and serum BA precursor 7α-hydroxy-4-cholesten-3-one levels." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37468912> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37469436_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37469436_0" ;
    gutprop:hasSentenceText "Exopolysaccharide is the potential effector of <i>Lactobacillus fermentum</i> PS150, a hypnotic psychobiotic strain." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/37469436> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37469436_9> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37469436_9" ;
    gutprop:hasSentenceText "Using the phenol-sulfate assay, we found that the sugar content value of the crude extract containing EPS (C-EPS) from PS150 was approximately five times higher than that of GR1009, indicating that GR1009 has a lower EPS production activity than PS150." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37469436> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37481569_9> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37481569_9" ;
    gutprop:hasSentenceText "Although Prevotella was decreased among PD patients relative to the healthy control, the difference was not statistically significant." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37481569> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37485386_6> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37485386_6" ;
    gutprop:hasSentenceText "The plausible mechanisms underlying the impact of prebiotics on depression include the synthesis of neurotransmitters, production of short-chain fatty acids, and regulation of inflammation." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37485386> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37485660_4> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37485660_4" ;
    gutprop:hasSentenceText "Herein, we determined the potential functions of the flavonoid-enriched fraction from Seabuckthorn, which was named SBF, in treating major depressive disorder in mice." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37485660> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37485660_7> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37485660_7" ;
    gutprop:hasSentenceText "The results suggest the beneficial effects of Seabuckthorn flavonoids in functioning as a health food supplement to treat major depressive disorders." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37485660> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37502424_13> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37502424_13" ;
    gutprop:hasSentenceText "The treatment with human probiotics and prebiotics did not improve cognitive, affective, or physical measures in community-dwelling individuals with normal or mildly impaired cognitive functions." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37502424> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37502424_9> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37502424_9" ;
    gutprop:hasSentenceText "At baseline, the probiotic-placebo group A (<i>n</i> = 40, age 69 ± 7 years, education 16 ± 3 years, 63% females, body mass index 28.5 ± 6, subjective memory complaint in 43%) did not differ from the placebo-probiotic group B (<i>n</i> = 32) in any of the sociodemographic characteristics and evaluated measures including cognitive status." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37502424> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37574818_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37574818_0" ;
    gutprop:hasSentenceText "Ameliorative effect of Lactobacillus plantarum CCFM8661 on oleic acid-induced acne: integrated gut microbiota link to acne pathogenesis." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/37574818> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37574818_1> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37574818_1" ;
    gutprop:hasSentenceText "Acne vulgaris is an inflammatory disease of the pilosebaceous unit of the skin that has serious adverse effects on the physical and mental health of patients." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37574818> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37576972_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37576972_0" ;
    gutprop:hasSentenceText "Profiles and diagnostic value of intestinal microbiota in schizophrenia patients with metabolic syndrome." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/37576972> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37576972_13> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37576972_13" ;
    gutprop:hasSentenceText "Our study established the compositional and functional characteristics of intestinal microbiota in schizophrenia patients with MetS." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37576972> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37576972_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37576972_2" ;
    gutprop:hasSentenceText "However, the gut microbiota composition and characteristics of schizophrenia patients with metabolic syndrome (MetS) have been largely understudied." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37576972> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37576972_7> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37576972_7" ;
    gutprop:hasSentenceText "We also conducted Decision Tree Analysis to develop a diagnostic model for the MetS in patients with schizophrenia based on the composition of intestinal microbiota." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37576972> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37577447_3> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37577447_3" ;
    gutprop:hasSentenceText "16S rRNA sequence libraries were used to compare oral and gut microbial profiles in persons with AD and healthy controls (HC)." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37577447> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37606895_6> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37606895_6" ;
    gutprop:hasSentenceText "Patients with COVID-19 are more likely to develop post-COVID-19 IBS than healthy controls." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37606895> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37676767_5> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37676767_5" ;
    gutprop:hasSentenceText "Here, we study whether fiber deprivation and exposure to bacterial curli, a protein cross-seeding with αSyn, individually or together, exacerbate disease in the enteric and central nervous systems of a transgenic PD mouse model." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37676767> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37764277_5> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37764277_5" ;
    gutprop:hasSentenceText "Baicalin protects the central nervous system through anti-neuroinflammatory and anti-neuronal apoptotic effects, suppresses obesity through anti-inflammatory and antioxidant effects, and alleviates intestinal disorders through regulatory effects on intestinal microorganisms and short-chain fatty acid production." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37764277> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37841274_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37841274_2" ;
    gutprop:hasSentenceText "Many tissue types, including brain, heart, arteries, ovaries, and others, contain melanin." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37841274> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37841274_8> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37841274_8" ;
    gutprop:hasSentenceText "We further theorize that loss of melanin reduces the energy supply of cells, which in the case of AD, PD, and LBD results in an inability to sustain immune system defenses and remove the plaques associated with the disease, which appear to be part of the immune system's attempt to eradicate the pathogens seen in these neurodegenerative diseases." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37841274> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37845499_4> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37845499_4" ;
    gutprop:hasSentenceText "The gut microbiota in the gastrointestinal tract has received particular attention due to its high abundance and its potential role in psychiatric and neurodegenerative disorders." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37845499> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37845499_7> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37845499_7" ;
    gutprop:hasSentenceText "Additionally, studies using the postmortem brain samples have detected the widespread presence of oral bacteria in the brains of patients with Alzheimer's disease." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37845499> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37881577_13> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37881577_13" ;
    gutprop:hasSentenceText "Traumatic stress induces dysregulation of gut barrier functions, which may underlie the observed gut microbiota changes and proinflammatory gut milieu, all of which may have an interdependent effect on the health and increased risk of comorbidities in patients with PTSD." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37881577> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37900921_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37900921_0" ;
    gutprop:hasSentenceText "4-Ethylphenol-fluxes, metabolism and excretion of a gut microbiome derived neuromodulator implicated in autism." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/37900921> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37900921_7> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37900921_7" ;
    gutprop:hasSentenceText "Evidence indicates that accumulation of 4EPS in the brain of mice affects connectivity between subregions, particularly those linked to anxiety." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37900921> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37927130_11> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37927130_11" ;
    gutprop:hasSentenceText "Together, our findings suggest F4 as a potential therapeutic approach for relieving some depressive symptoms and highlight the involvement of the tryptophan metabolism in mitigating CUS-induced depressive-like behaviors through the action of this bacterium." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37927130> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37927130_3> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37927130_3" ;
    gutprop:hasSentenceText "However, it remains unclear how gut dysbiosis contributes to mental dysfunction, and how correction of the gut microbiota alleviates neuropsychiatric disorders." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37927130> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37995075_9> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37995075_9" ;
    gutprop:hasSentenceText "The enhanced differential expressed genes (DEGs) in the PCOS-DP were enriched in pathways involved in signal transduction and endocrine and metabolic diseases, whereas several lipid metabolism pathways were downregulated." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37995075> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37995475_5> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37995475_5" ;
    gutprop:hasSentenceText "In this study, we observed the gut microbiota composition of patients suffering from narcolepsy type 1, narcolepsy type 2, and idiopathic hypersomnia." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37995475> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38010793_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38010793_0" ;
    gutprop:hasSentenceText "Multi-omics analyses demonstrate the modulating role of gut microbiota on the associations of unbalanced dietary intake with gastrointestinal symptoms in children with autism spectrum disorder." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/38010793> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38010793_1> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38010793_1" ;
    gutprop:hasSentenceText "Our previous work revealed that unbalanced dietary intake was an important independent factor associated with constipation and gastrointestinal (GI) symptoms in children with autism spectrum disorder (ASD)." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38010793> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38010793_12> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38010793_12" ;
    gutprop:hasSentenceText "enriched in eight metabolic pathways, and were identified to correlate with constipation and total GI symptoms in ASD children (FDR-corrected P-value <0.25)." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38010793> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38010793_5> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38010793_5" ;
    gutprop:hasSentenceText "We found that there existed 11 altered gut microbiota (FDR-corrected P-value <0.05) and 397 altered metabolites (P-value <0.05) in children with ASD compared with TD children." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38010793> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38010793_6> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38010793_6" ;
    gutprop:hasSentenceText "Among the 11 altered microbiota, the <i>Turicibacter</i>, <i>Coprococcus 1</i>, and <i>Lachnospiraceae FCS020 group</i> were positively correlated with constipation (FDR-corrected P-value <0.25)." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38010793> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38011787_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38011787_2" ;
    gutprop:hasSentenceText "Employing a rat model subjected to Chronic Unpredictable Mild Stress (CUMS), behavioral analyses (open field experiment, elevated cross maze experiment, sugar water preference experiment, forced swimming experiment) and inflammatory factor assessments were conducted to assess the efficacy of CPT in alleviating depressive symptoms and inflammatory responses induced by CUMS." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38011787> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38011787_3> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38011787_3" ;
    gutprop:hasSentenceText "Moreover, 16 S rDNA analysis revealed alterations in the gut microbiota of rats exposed to both CUMS and CPT administration." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38011787> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38026003_4> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38026003_4" ;
    gutprop:hasSentenceText "Dysbiosis, an imbalance or disruption of the gut microbial community, has been linked to various disorders, such as inflammatory bowel disease, obesity, and even neurological conditions." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38026003> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38045924_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38045924_2" ;
    gutprop:hasSentenceText "This axis has been suggested to play a role in several neurological disorders, such as Parkinson's disease, Alzheimer's disease, multiple sclerosis, and epilepsy, paving the way for microbiome-based intervention strategies for the mitigation and treatment of symptoms." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38045924> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38123016_8> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38123016_8" ;
    gutprop:hasSentenceText "Future work should focus on the accuracy of biomarker tests and developing specific psychobiotic agents tailored towards the gut microbiota seen in ASD patients, which may include developing individualized treatment options." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38123016> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38203207_3> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38203207_3" ;
    gutprop:hasSentenceText "A vast number of signals generated in the gastrointestinal tract (GIT) reach the brain via afferent fibers of the vagus nerve (VN)." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38203207> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38203207_5> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38203207_5" ;
    gutprop:hasSentenceText "Intercommunications between the gut and CNS regulate mood, cognitive behavior, and neuropsychiatric disorders such as autism, depression, and schizophrenia." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38203207> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38204948_1> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38204948_1" ;
    gutprop:hasSentenceText "Polycystic ovarian syndrome (PCOS) is the most common endocrine disorder in women, affecting up to 15% of reproductive-aged women." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38204948> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38229613_1> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38229613_1" ;
    gutprop:hasSentenceText "Recent advancement in understanding neurological disorders has revealed the involvement of dysbiosis of the gut microbiota in the pathophysiology of Parkinson's disease (PD)." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38229613> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38283894_4> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38283894_4" ;
    gutprop:hasSentenceText "The present study aimed to explore the causes of ASD by investigating the key biomedical markers, trace elements, and microbiota factors between children with autism spectrum disorder (ASD) and control subjects." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38283894> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38283894_7> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38283894_7" ;
    gutprop:hasSentenceText "The Joanna Briggs Institute (JBI) critical appraisal checklist was used to assess the article quality, and a random model was used to assess the mean difference and standardized difference between ASD and the control group in all biomedical markers, trace elements, and microbiota factors." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38283894> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38302874_16> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38302874_16" ;
    gutprop:hasSentenceText "A possible dysfunction of the serotonin pathway, possibly related to or triggered by an altered microbiota, may contribute to dysmotility in PIPO patients." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38302874> .

