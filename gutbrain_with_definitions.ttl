<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38283894_5> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38283894_5" ;
    gutprop:hasSentenceText "Medline, PubMed, ProQuest, EMBASE, Cochrane Library, PsycINFO, Web of Science, and EMBSCO databases have been searched for publications from 2012 to 2023 with no language restrictions using the population, intervention, control, and outcome (PICO) approach." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38283894> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38283894_8> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38283894_8" ;
    gutprop:hasSentenceText "From 76,217 records, 43 studies met the inclusion and exclusion criteria and were included in this meta-analysis." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38283894> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38292207_0> a owl:NamedIndividual,
