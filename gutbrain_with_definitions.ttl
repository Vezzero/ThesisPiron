<https://uts.nlm.nih.gov/uts/umls/concept/C0041696> a owl:NamedIndividual,
        skos:Concept,
        <https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding> ;
    rdfs:label "Unipolar Depression" ;
    rdfs:comment "UMLS Match"^^xsd:string,
        "Unipolar Depression: A mental health disorder characterized by a single episode of major depressive disorder, typically lasting for at least two weeks, without a history of manic or hypomanic episodes. [Definition Source: llama3-8b-8192]"^^xsd:string ;
    skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/DiseaseDisorderOrFinding> ;
