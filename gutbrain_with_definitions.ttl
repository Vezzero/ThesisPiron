<https://uts.nlm.nih.gov/uts/umls/concept/C3179158> a owl:NamedIndividual,
        skos:Concept,
        <https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding> ;
    rdfs:label "Hypnotic Effect" ;
    rdfs:comment "The \"Hypnotic Effect\" refers to a state of consciousness characterized by heightened suggestibility, deep relaxation, and a focused attention, often induced by hypnosis or other forms of trance induction. [Definition Source: llama3-8b-8192]"^^xsd:string,
        "UMLS Match"^^xsd:string ;
