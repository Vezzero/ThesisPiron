    rdfs:label "Demyelinating Diseases" ;
    rdfs:comment "Demyelinating Diseases: A group of conditions characterized by the destruction or damage of the myelin sheath surrounding nerve fibers, leading to impaired nerve function and communication. [Definition Source: llama3-8b-8192]"^^xsd:string,
