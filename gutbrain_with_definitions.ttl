<https://w3id.org/hereditary/ontology/gutbrain/resource/statisticaltechnique/RankingAlgorithm> a owl:NamedIndividual,
        skos:Concept,
        gutprop:StatisticalTechnique ;
    rdfs:label "Ranking Algorithm" ;
    dcterms:creator "Samuel Piron" ;
    rdfs:comment "A ranking algorithm is a computational method used to assign a score or ranking to a set of entities, such as genes, proteins, or diseases, based on their relevance or similarity to a given query or criteria. [Definition Source: llama3-8b-8192]" ;
    skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/StatisticalTechnique> ;
    gutprop:containedIn <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/180d561cea8e4ca5> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/statisticaltechnique/ReceiverOperatingCharacteristicCurveAnalysis> a owl:NamedIndividual,
        skos:Concept,
        gutprop:StatisticalTechnique ;
    rdfs:label "Receiver Operating Characteristic Curve Analysis" ;
    dcterms:creator "Samuel Piron" ;
    rdfs:comment "Receiver operating characteristic (ROC) curve analysis is a statistical method used to evaluate the performance of a diagnostic test by plotting the true positive rate against the false positive rate at different threshold settings. [Definition Source: llama3-8b-8192]" ;
    skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/StatisticalTechnique> ;
    gutprop:containedIn <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/55f632578b50089d> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/statisticaltechnique/SensitivityAnalysis> a owl:NamedIndividual,
        skos:Concept,
        gutprop:StatisticalTechnique ;
    rdfs:label "Sensitivity Analysis" ;
    dcterms:creator "Samuel Piron" ;
    rdfs:comment "Sensitivity analysis is a statistical method used to determine how uncertainty in the inputs or parameters of a model affects the reliability of its outputs or predictions. [Definition Source: llama3-8b-8192]" ;
    skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/StatisticalTechnique> ;
