<https://uts.nlm.nih.gov/uts/umls/concept/C4318444> a owl:NamedIndividual,
        skos:Concept,
        gutprop:Chemical ;
    rdfs:label "Disks Large Homolog 4 Protein" ;
    rdfs:comment "The Disks Large Homolog 4 Protein is a protein that is involved in the regulation of cell adhesion and the cytoskeleton, and is also a tumor suppressor. [Definition Source: llama3-8b-8192]"^^xsd:string,
        "UMLS Match"^^xsd:string ;
    skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/Chemical> ;
