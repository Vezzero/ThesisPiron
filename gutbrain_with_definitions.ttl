    rdfs:label "Tolc Protein, E Coli" ;
    rdfs:comment "The TolC protein, E. coli is a bacterial outer membrane protein that forms a channel for the efflux of antibiotics and other toxic compounds from the periplasmic space to the external environment. [Definition Source: llama3-8b-8192]"^^xsd:string,
