        skos:Concept,
        <https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding> ;
    rdfs:label "Mixed Anxiety And Depressive Disorder" ;
    rdfs:comment "Mixed Anxiety and Depressive Disorder (MADD) is a mental health condition characterized by the co-occurrence of symptoms of both anxiety and depressive disorders, often presenting with a mix of anxiety and depressive symptoms. [Definition Source: llama3-8b-8192]"^^xsd:string,
        "UMLS Match"^^xsd:string ;
