<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36931666_6> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_36931666_6" ;
    gutprop:hasSentenceText "Data will be analysed using the SPSS software (V.16.0)." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36931666> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36938477_8> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_36938477_8" ;
    gutprop:hasSentenceText "The frequency of bowel movements per week was the only index that could be summarized among the records." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36938477> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36978911_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_36978911_2" ;
    gutprop:hasSentenceText "They have received considerable attention as potential therapeutic agents in biomedicine and have been widely used in traditional complimentary medicine for generations." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36978911> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36978911_4> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_36978911_4" ;
    gutprop:hasSentenceText "Methods are emerging to determine the active components used in complimentary medicine and their therapeutic targets and to decipher the complexities of how network pharmacology provides such therapeutic effects." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36978911> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36978911_7> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_36978911_7" ;
    gutprop:hasSentenceText "Gut health is an important consideration effecting the overall health and wellbeing of linked organ systems." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36978911> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36989335_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_36989335_2" ;
    gutprop:hasSentenceText "Our primary aim for this analysis tests the hypothesis that those with poor overall diet quality at baseline benefit more." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36989335> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36989335_3> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_36989335_3" ;
    gutprop:hasSentenceText "The second aim is to explore whether specific components of diet quality moderate treatment response." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36989335> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36989335_6> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_36989335_6" ;
    gutprop:hasSentenceText "HEI-2015 total score did not moderate treatment response [odds ratio = 1.00 (95% CI: 0.90,1.10), <i>p</i> = 0.984] or improvement [β = -0.01 (95% CI: -0.06,0.04), <i>p</i> = 0.648]." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36989335> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37023596_12> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37023596_12" ;
    gutprop:hasSentenceText "These results suggested a dynamic effect of interaction among genetics and gut microbes on treatment." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37023596> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37023596_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37023596_2" ;
    gutprop:hasSentenceText "Examining the microbiome and host genetics might be helpful for clinical decision-making." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37023596> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37023596_5> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37023596_5" ;
    gutprop:hasSentenceText "The factors that were significantly correlated with efficacy were used to predict the treatment response." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37023596> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37049591_7> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37049591_7" ;
    gutprop:hasSentenceText "A total of 2,705,809 optimized sequences were obtained, with an average of 54,116 per sample." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37049591> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37071196_12> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37071196_12" ;
    gutprop:hasSentenceText "These correlational findings need validations from other similar cohort studies, as well as well-designed mechanistic pre-clinical investigations before inferring cause and effect." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37071196> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37095530_1> a owl:NamedIndividual,
