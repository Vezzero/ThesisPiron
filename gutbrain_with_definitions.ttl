<https://uts.nlm.nih.gov/uts/umls/concept/C0068563> a owl:NamedIndividual,
        skos:Concept,
        gutprop:Chemical ;
    rdfs:label "Growth Associated Protein 43" ;
    rdfs:comment "Growth Associated Protein 43 (GAP-43) is a neuronal protein involved in axonal growth, guidance, and plasticity, playing a crucial role in neuronal development and regeneration. [Definition Source: llama3-8b-8192]"^^xsd:string,
