    rdfs:label "sentence_37371676_2" ;
    gutprop:hasSentenceText "These factors include the environment, genetics, individual microbiomes, and diet." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37371676> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37371676_4> a owl:NamedIndividual,
