    rdfs:label "Upper Respiratory Tract Infection" ;
    rdfs:comment "An infectious process affecting the upper respiratory tract (nose, paranasal sinuses, pharynx, larynx, or trachea). Symptoms include congestion, sneezing, coughing, fever, and sore throat. [Definition Source: NCIT]",
        "NCIT Match" ;
    skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/DiseaseDisorderOrFinding> ;
