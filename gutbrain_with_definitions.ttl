    rdfs:label "Leukocyte Trafficking" ;
    rdfs:comment "Leukocyte Trafficking: The process by which leukocytes, such as white blood cells, migrate through the body in response to chemical signals, inflammation, or infection, to reach specific tissues or organs to perform their immune functions. [Definition Source: llama3-8b-8192]"^^xsd:string,
        "UMLS Match"^^xsd:string ;
