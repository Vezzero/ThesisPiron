<http://purl.obolibrary.org/obo/PCO_0000064> a owl:NamedIndividual,
        skos:Concept,
        gutprop:StatisticalTechnique ;
    rdfs:label "Inverse Simpson Diversity Index" ;
    rdfs:comment "PCO Match",
        "The inverse Simpson diversity index is a measure of species richness that calculates the reciprocal of the Simpson index, which is the probability that two randomly selected individuals from a sample belong to the same species. [Definition Source: llama3-8b-8192]" ;
    skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/StatisticalTechnique> ;
    gutprop:containedIn <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/5238dcfb247368d0> .

