<https://uts.nlm.nih.gov/uts/umls/concept/C5848503> a owl:NamedIndividual,
        skos:Concept,
        gutprop:BiomedicalTechnique ;
    rdfs:label "Metagenomic Dna And Rna Sequencing" ;
    rdfs:comment "Metagenomic DNA and RNA sequencing refers to the high-throughput sequencing of genetic material extracted directly from environmental samples or complex mixtures, allowing for the simultaneous analysis of multiple microbial species and their gene expression. [Definition Source: llama3-8b-8192]",
        "UMLS Match" ;
    skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/BiomedicalTechnique> ;
    gutprop:containedIn <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/45e7bd94c88e554e>,
