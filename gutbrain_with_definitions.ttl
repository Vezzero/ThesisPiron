        skos:Concept,
        gutprop:Chemical ;
    rdfs:label "Receptors, Gastrointestinal Hormone" ;
    rdfs:comment "Receptors, Gastrointestinal Hormone: Proteins located on the surface of target cells that bind to gastrointestinal hormones, such as gastrin, secretin, and cholecystokinin, to transmit signals that regulate various physiological processes. [Definition Source: llama3-8b-8192]"^^xsd:string,
        "UMLS Match"^^xsd:string ;
