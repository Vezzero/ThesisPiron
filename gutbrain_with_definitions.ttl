<https://w3id.org/hereditary/ontology/gutbrain/resource/statisticaltechnique/SimpsonIndex> a owl:NamedIndividual,
        skos:Concept,
        gutprop:StatisticalTechnique ;
    rdfs:label "Simpson Index" ;
    dcterms:creator "Samuel Piron" ;
    rdfs:comment "The Simpson Index is a measure of the similarity between two sets of sequences, such as DNA or protein sequences, that takes into account the number of identical matches and the total length of the sequences. [Definition Source: llama3-8b-8192]" ;
    skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/StatisticalTechnique> ;
    gutprop:containedIn <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/c134875b7e54a4ad> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/statisticaltechnique/StatisticalTestingMethod> a owl:NamedIndividual,
        skos:Concept,
        gutprop:StatisticalTechnique ;
