<http://purl.obolibrary.org/obo/NCIT_C129885> a owl:NamedIndividual,
        skos:Concept,
        gutprop:Chemical ;
    rdfs:label "Tryptophan Metabolite" ;
    rdfs:comment "Molecules created during the catabolism of the amino acid tryptophan. Increased concentrations of tryptophan metabolites are associated with neurological disease-related cognitive deficits and depressive symptoms and may be used as biomarkers for cancer risk. [Definition Source: NCIT]",
        "NCIT Match" ;
    skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/Chemical> ;
    gutprop:containedIn <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/c329ae2ec787dcf5> .

<http://purl.obolibrary.org/obo/NCIT_C13025> a owl:NamedIndividual,
        skos:Concept,
        <https://w3id.org/brainteaser/ontology/schema/AnatomicalSite> ;
    rdfs:label "Stomach Part" ;
    rdfs:comment "NCIT Match",
        "Stomach Part [Definition Source: NCIT]" ;
    skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/AnatomicSite> ;
    gutprop:containedIn <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/d5a0d90574d530f8> .

<http://purl.obolibrary.org/obo/NCIT_C13056> a owl:NamedIndividual,
