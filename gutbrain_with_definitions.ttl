<https://w3id.org/hereditary/ontology/gutbrain/resource/biomedicaltechnique/BioinformaticTest> a owl:NamedIndividual,
        skos:Concept,
        gutprop:BiomedicalTechnique ;
    rdfs:label "Bioinformatic Test" ;
    dcterms:creator "Samuel Piron" ;
    rdfs:comment "A bioinformatic test is a computational analysis or method used to analyze and interpret biological data, such as genomic sequences, gene expressions, or protein structures, to draw conclusions about biological processes or phenomena. [Definition Source: llama3-8b-8192]" ;
    skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/BiomedicalTechnique> ;
