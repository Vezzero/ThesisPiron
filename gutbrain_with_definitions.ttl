<http://purl.obolibrary.org/obo/NCIT_C129660> a owl:NamedIndividual,
        skos:Concept,
        gutprop:Chemical ;
    rdfs:label "Microbial Dna" ;
    rdfs:comment "DNA that originates from a microbe. [Definition Source: NCIT]",
        "NCIT Match" ;
    skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/Chemical> ;
