<https://w3id.org/hereditary/ontology/gutbrain/resource/biomedicaltechnique/FpgTechnique> a owl:NamedIndividual,
        skos:Concept,
        gutprop:BiomedicalTechnique ;
    rdfs:label "Fpg Technique" ;
    dcterms:creator "Samuel Piron" ;
    rdfs:comment "\"Fpg_technique\" refers to a type of technique used in forensic genetics, specifically a method for analyzing and processing DNA samples using fluorescently labeled primers and probes. [Definition Source: llama3-8b-8192]" ;
    skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/BiomedicalTechnique> ;
    gutprop:containedIn <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/0239a380295a3f37> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/biomedicaltechnique/FpiTechnique> a owl:NamedIndividual,
        skos:Concept,
        gutprop:BiomedicalTechnique ;
    rdfs:label "Fpi Technique" ;
    dcterms:creator "Samuel Piron" ;
    rdfs:comment "FPI technique refers to a method of fluorescence polarization imaging used to measure the fluorescence anisotropy of a sample, typically in biological systems. [Definition Source: llama3-8b-8192]" ;
    skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/BiomedicalTechnique> ;
    gutprop:containedIn <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/af3e0180867cc177> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/biomedicaltechnique/GaMapDysbiosisTest> a owl:NamedIndividual,
        skos:Concept,
        gutprop:BiomedicalTechnique ;
    rdfs:label "Ga-Map Dysbiosis Test" ;
    dcterms:creator "Samuel Piron" ;
    rdfs:comment "A ga-map_dysbiosis_test is a type of diagnostic test that assesses the imbalance of the gut microbiome, also known as dysbiosis, using genomic analysis and mapping techniques. [Definition Source: llama3-8b-8192]" ;
    skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/BiomedicalTechnique> ;
    gutprop:containedIn <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/427f1c949c2912e0> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/biomedicaltechnique/HippocampalProteomicAnalysis> a owl:NamedIndividual,
        skos:Concept,
        gutprop:BiomedicalTechnique ;
    rdfs:label "Hippocampal Proteomic Analysis" ;
    dcterms:creator "Samuel Piron" ;
    rdfs:comment "Hippocampal_proteomic_analysis refers to the application of proteomic techniques, such as mass spectrometry, to identify and quantify proteins in the hippocampus, a region of the brain involved in memory and spatial navigation. [Definition Source: llama3-8b-8192]" ;
    skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/BiomedicalTechnique> ;
    gutprop:containedIn <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/455caac355127136> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/biomedicaltechnique/HomeostasisModelAssessmentInsulinResistance> a owl:NamedIndividual,
        skos:Concept,
        gutprop:BiomedicalTechnique ;
    rdfs:label "Homeostasis Model Assessment Insulin Resistance" ;
    dcterms:creator "Samuel Piron" ;
    rdfs:comment "Homeostasis_model_assessment_insulin_resistance is a measure of insulin resistance, calculated using the homeostasis model assessment (HOMA) formula, which estimates the degree of insulin resistance and beta-cell function in individuals. [Definition Source: llama3-8b-8192]" ;
    skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/BiomedicalTechnique> ;
    gutprop:containedIn <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/27d4a0a61da62681> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/biomedicaltechnique/MicrobiomeProfiling> a owl:NamedIndividual,
        skos:Concept,
        gutprop:BiomedicalTechnique ;
    rdfs:label "Microbiome Profiling" ;
    dcterms:creator "Samuel Piron" ;
    rdfs:comment "Microbiome_profiling refers to the process of analyzing and characterizing the microbial communities present in a specific environment or individual, typically using high-throughput sequencing technologies and bioinformatic tools. [Definition Source: llama3-8b-8192]" ;
    skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/BiomedicalTechnique> ;
    gutprop:containedIn <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/1bfdc21a61627b80> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/biomedicaltechnique/StoolBiobank> a owl:NamedIndividual,
        skos:Concept,
        gutprop:BiomedicalTechnique ;
    rdfs:label "Stool Biobank" ;
    dcterms:creator "Samuel Piron" ;
    rdfs:comment "A stool biobank is a repository that stores and manages stool samples, often for research purposes, allowing for the collection, preservation, and distribution of these samples for various studies. [Definition Source: llama3-8b-8192]" ;
    skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/BiomedicalTechnique> ;
    gutprop:containedIn <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/08da64df06c28f74> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/chemical/GutIgaLevel> a owl:NamedIndividual,
        skos:Concept,
        gutprop:Chemical ;
    rdfs:label "Gut Iga Level" ;
    dcterms:creator "Samuel Piron" ;
    rdfs:comment "The \"gut_iga_level\" refers to the level of IgA antibodies present in the gut, which plays a crucial role in the immune system's defense against pathogens and other foreign substances. [Definition Source: llama3-8b-8192]" ;
    skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/Chemical> ;
    gutprop:containedIn <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/1f5bb5cd683022ec>,
