<https://w3id.org/hereditary/ontology/gutbrain/resource/biomedicaltechnique/Unifrac> a owl:NamedIndividual,
        skos:Concept,
        gutprop:BiomedicalTechnique ;
    rdfs:label "Unifrac" ;
    dcterms:creator "Samuel Piron" ;
    rdfs:comment "Unifrac is a computational method used to analyze and compare microbial community structures by calculating the fraction of unique or shared features (e.g., genes, species) between samples. [Definition Source: llama3-8b-8192]" ;
    skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/BiomedicalTechnique> ;
