<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38318337_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38318337_0" ;
    gutprop:hasSentenceText "Exploring the interplay between running exercises, microbial diversity, and tryptophan metabolism along the microbiota-gut-brain axis." ;
