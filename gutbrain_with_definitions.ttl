<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38283894_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38283894_2" ;
    gutprop:hasSentenceText "The etiology of ASD remains multifactorial and not yet fully understood." ;
