<https://w3id.org/hereditary/ontology/gutbrain/resource/biomedicaltechnique/UpdrsPartIIIMotorScores> a owl:NamedIndividual,
        skos:Concept,
        gutprop:BiomedicalTechnique ;
    rdfs:label "Updrs Part Iii Motor Score" ;
    dcterms:creator "Samuel Piron" ;
    rdfs:comment "\"Updrs_part_iii_motor_scores\" refers to the motor subscore of the Unified Parkinson's Disease Rating Scale (UPDRS) Part III, which assesses the severity of motor symptoms in patients with Parkinson's disease. [Definition Source: llama3-8b-8192]" ;
    skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/BiomedicalTechnique> ;
    gutprop:containedIn <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/c86828f9ef5fcdc7> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/biomedicaltechnique/ValidatedQuestionnaire> a owl:NamedIndividual,
        skos:Concept,
        gutprop:BiomedicalTechnique ;
    rdfs:label "Validated Questionnaire" ;
    dcterms:creator "Samuel Piron" ;
    rdfs:comment "A validated questionnaire is a standardized set of questions that have been scientifically tested and proven to accurately measure a specific concept, trait, or outcome. [Definition Source: llama3-8b-8192]" ;
    skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/BiomedicalTechnique> ;
    gutprop:containedIn <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/790d30b06b3ba419>,
        <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/828809e811385392>,
        <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/d69a31b69f472664>,
        <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/d8caa2caf21f8048> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/chemical/21Desoxycortisol> a owl:NamedIndividual,
        skos:Concept,
        gutprop:Chemical ;
    rdfs:label "21-Desoxycortisol" ;
    dcterms:creator "Samuel Piron" ;
    rdfs:comment "21-Desoxycortisol is a type of corticosteroid hormone that is a precursor to cortisol and is involved in the regulation of the body's response to stress. [Definition Source: llama3-8b-8192]" ;
    skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/Chemical> ;
    gutprop:containedIn <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/4a025c93b55eaf62> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/chemical/Cd4Regulatory> a owl:NamedIndividual,
        skos:Concept,
        gutprop:Chemical ;
    rdfs:label "Cd4 Regulatory" ;
    dcterms:creator "Samuel Piron" ;
    rdfs:comment "\"cd4_regulatory\" refers to a type of T cell that plays a crucial role in regulating the immune response by suppressing or enhancing the activity of other immune cells. [Definition Source: llama3-8b-8192]" ;
    skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/Chemical> ;
    gutprop:containedIn <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/f0902197e6414591> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/chemical/DeadCell> a owl:NamedIndividual,
        skos:Concept,
        gutprop:Chemical ;
    rdfs:label "Dead Cell" ;
    dcterms:creator "Samuel Piron" ;
    rdfs:comment "A dead cell is a cell that has ceased to function and has lost its structural and functional integrity, typically due to cellular damage, disease, or injury. [Definition Source: llama3-8b-8192]" ;
    skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/Chemical> ;
    gutprop:containedIn <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/cc3a8f60c91438cd> ;
    gutprop:influence <http://purl.obolibrary.org/obo/NCIT_C3137> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/chemical/DerivedMetabolite> a owl:NamedIndividual,
        skos:Concept,
        gutprop:Chemical ;
    rdfs:label "Derived Metabolite" ;
    dcterms:creator "Samuel Piron" ;
    rdfs:comment "A derived metabolite is a metabolite that is produced through the modification or transformation of another metabolite or molecule, often through enzymatic reactions or chemical conversions. [Definition Source: llama3-8b-8192]" ;
    skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/Chemical> ;
    gutprop:containedIn <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/a28ce4d9072b7b0c>,
        <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/d957a40fadcee050> ;
    gutprop:influence <http://purl.obolibrary.org/obo/NCIT_C26845>,
        <http://purl.obolibrary.org/obo/NCIT_C2866>,
        <https://w3id.org/hereditary/ontology/gutbrain/resource/diseasedisorderorfinding/NeurodegenerativeDiseases> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/chemical/EntericGlialCellsNetwork> a owl:NamedIndividual,
        skos:Concept,
        gutprop:Chemical ;
    rdfs:label "Enteric Glial Cell Network" ;
    dcterms:creator "Samuel Piron" ;
    rdfs:comment "The \"enteric glial cells network\" refers to a complex network of glial cells, including enteric glial cells, satellite glial cells, and other supporting cells, that interact and communicate with each other to regulate the function and homeostasis of the enteric nervous system. [Definition Source: llama3-8b-8192]" ;
    skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/Chemical> ;
    gutprop:containedIn <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/af1361b39dbe1191> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/chemical/GlutamateMetabolite> a owl:NamedIndividual,
        skos:Concept,
        gutprop:Chemical ;
    rdfs:label "Glutamate Metabolite" ;
    dcterms:creator "Samuel Piron" ;
    rdfs:comment "Glutamate_metabolite refers to a metabolite that is derived from the amino acid glutamate, which plays a crucial role in various cellular processes, including neurotransmission and energy metabolism. [Definition Source: llama3-8b-8192]" ;
    skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/Chemical> ;
    gutprop:containedIn <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/f8e2c04dec21b642> ;
    gutprop:locatedIn <https://w3id.org/hereditary/ontology/gutbrain/resource/human/AsdPatients> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/chemical/Me> a owl:NamedIndividual,
        skos:Concept,
        gutprop:Chemical ;
    rdfs:label "Me" ;
    dcterms:creator "Samuel Piron" ;
    rdfs:comment "I am a human being, specifically a conscious entity composed of a biological body and a mind, characterized by the ability to think, feel, and interact with the environment. [Definition Source: llama3-8b-8192]" ;
    skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/Chemical> ;
    gutprop:containedIn <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/2744ccd10c7533bd> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/chemical/MicrobiallyDerivedNeurotransmitters> a owl:NamedIndividual,
        skos:Concept,
        gutprop:Chemical ;
    rdfs:label "Microbially-Derived Neurotransmitter" ;
    dcterms:creator "Samuel Piron" ;
    rdfs:comment "Microbially-derived neurotransmitters refer to neurotransmitters produced by microorganisms, such as bacteria or fungi, that can interact with the host's nervous system and potentially influence brain function or behavior. [Definition Source: llama3-8b-8192]" ;
    skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/Chemical> ;
    gutprop:containedIn <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/933136d37ea50d9e> ;
    gutprop:locatedIn <http://purl.obolibrary.org/obo/NCIT_C12439> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/chemical/MicrobiomeBorneCurli> a owl:NamedIndividual,
        skos:Concept,
        gutprop:Chemical ;
    rdfs:label "Microbiome-Borne Curli" ;
    dcterms:creator "Samuel Piron" ;
    rdfs:comment "Microbiome-borne_curli refers to a type of extracellular matrix structure produced by certain bacteria, typically Pseudomonas aeruginosa, composed of a complex mixture of proteins, carbohydrates, and nucleic acids, which plays a role in biofilm formation and host-pathogen interactions. [Definition Source: llama3-8b-8192]" ;
    skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/Chemical> ;
    gutprop:containedIn <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/a37a30941622d84e> ;
    gutprop:impact <http://purl.obolibrary.org/obo/NCBITaxon_2> ;
    gutprop:influence <http://purl.obolibrary.org/obo/NCIT_C26845> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/chemical/Neurochemical> dcterms:creator "Samuel Piron" ;
    rdfs:comment "A neurochemical is a chemical substance that plays a role in the functioning of the nervous system, including neurotransmitters, hormones, and other signaling molecules. [Definition Source: llama3-8b-8192]" .

<https://w3id.org/hereditary/ontology/gutbrain/resource/chemical/Neurochemicals> a owl:NamedIndividual,
        skos:Concept,
        gutprop:Chemical ;
    rdfs:label "Neurochemical" ;
    dcterms:creator "Samuel Piron" ;
    rdfs:comment "Neurochemicals are small molecules, such as neurotransmitters, hormones, and peptides, that play a crucial role in transmitting and modulating signals within the nervous system. [Definition Source: llama3-8b-8192]" ;
    skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/Chemical> ;
    gutprop:containedIn <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/4900427f34456661> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/chemical/Rhepo> a owl:NamedIndividual,
        skos:Concept,
        gutprop:Chemical,
        gutprop:Drug ;
    rdfs:label "Rhepo" ;
    dcterms:creator "Samuel Piron" ;
    rdfs:comment "Rhepo is a genus of fungi in the family Rhizomycetaceae, commonly known as \"rhepo fungi\" or \"rhepo-like fungi\". [Definition Source: llama3-8b-8192]" ;
    skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/Chemical>,
        <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/Drug> ;
