<http://purl.obolibrary.org/obo/PR_000012942> a owl:NamedIndividual,
        skos:Concept,
        <https://w3id.org/brainteaser/ontology/schema/Gene> ;
    rdfs:label "Adipose Triglyceride Lipase" ;
    rdfs:comment "Adipose triglyceride lipase (ATGL) is a lipase enzyme that catalyzes the hydrolysis of triglycerides in adipose tissue, playing a key role in the breakdown of stored fat for energy release. [Definition Source: llama3-8b-8192]",
        "PR Match" ;
    skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/Gene> ;
