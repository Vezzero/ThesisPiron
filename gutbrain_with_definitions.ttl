    rdfs:label "HMGB1 Gene" ;
    rdfs:comment "NCIT Match",
        "This gene plays a role in chromatin remodeling, signal transduction and the regulation of gene transcription. It is also involved in the pro-inflammatory response. [Definition Source: NCIT]" ;
    skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/Gene> ;
    gutprop:containedIn <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/a9dbcd6c743a61ba> .

