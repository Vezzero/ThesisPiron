<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/21167931_4> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_21167931_4" ;
    gutprop:hasSentenceText "These studies suggest that effector T cells specific for central nervous system (CNS) antigens can assist recovery from an array of environmental insults ranging from nerve injury to psychological stress, while in contrast, regulatory T cells (Treg) oppose such recovery." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/21167931> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/24103493_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_24103493_0" ;
    gutprop:hasSentenceText "Excess body weight during pregnancy and offspring obesity: potential mechanisms." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/24103493> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/24798884_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_24798884_0" ;
    gutprop:hasSentenceText "Priming for health: gut microbiota acquired in early life regulates physiology, brain and behaviour." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/24798884> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/24798884_4> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_24798884_4" ;
    gutprop:hasSentenceText "Early-life perturbations of the developing gut microbiota can impact on the central nervous system and potentially lead to adverse mental health outcomes." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/24798884> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/25034760_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_25034760_0" ;
    gutprop:hasSentenceText "Autoimmune diseases, gastrointestinal disorders and the microbiome in schizophrenia: more than a gut feeling." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/25034760> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/25034760_1> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_25034760_1" ;
    gutprop:hasSentenceText "Autoimmunity, gastrointestinal (GI) disorders and schizophrenia have been associated with one another for a long time." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/25034760> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/25034760_3> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_25034760_3" ;
    gutprop:hasSentenceText "Epidemiological studies strongly link schizophrenia with autoimmune disorders including enteropathic celiac disease." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/25034760> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/25034760_6> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_25034760_6" ;
    gutprop:hasSentenceText "This inflammation impacts endothelial barrier permeability and can precipitate translocation of gut bacteria into systemic circulation." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/25034760> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/25034760_8> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_25034760_8" ;
    gutprop:hasSentenceText "Such processes trigger innate immunity, including activation of complement C1q, which also functions at synapses in the brain." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/25034760> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/25173628_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_25173628_2" ;
    gutprop:hasSentenceText "Here, we test the hypothesis that obesity-associated changes in gut microbiota are intrinsically able to impair neurocognitive behavior in mice." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/25173628> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/25173628_3> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_25173628_3" ;
    gutprop:hasSentenceText "Conventionally housed, nonobese, adult male C57BL/6 mice maintained on a normal chow diet were subjected to a microbiome depletion/transplantation paradigm using microbiota isolated from donors on either a high-fat diet (HFD) or control diet." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/25173628> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/25231862_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_25231862_0" ;
    gutprop:hasSentenceText "Artificial sweeteners induce glucose intolerance by altering the gut microbiota." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/25231862> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/25231862_1> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_25231862_1" ;
    gutprop:hasSentenceText "Non-caloric artificial sweeteners (NAS) are among the most widely used food additives worldwide, regularly consumed by lean and obese individuals alike." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/25231862> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/25231862_3> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_25231862_3" ;
    gutprop:hasSentenceText "Here we demonstrate that consumption of commonly used NAS formulations drives the development of glucose intolerance through induction of compositional and functional alterations to the intestinal microbiota." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/25231862> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/25231862_6> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_25231862_6" ;
    gutprop:hasSentenceText "Collectively, our results link NAS consumption, dysbiosis and metabolic abnormalities, thereby calling for a reassessment of massive NAS usage." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/25231862> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/25869281_7> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_25869281_7" ;
    gutprop:hasSentenceText "These findings suggest that NS9 is beneficial to the host, because it restores the physiological and psychological abnormalities induced by ampicillin." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/25869281> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/25911232_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_25911232_2" ;
    gutprop:hasSentenceText "The brain-gut axis is a bidirectional communication system between the central nervous system (CNS) and the gastrointestinal tract." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/25911232> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/25940667_6> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_25940667_6" ;
    gutprop:hasSentenceText "A number of recent, sequence-based and ultramicroscopic studies have uncovered an authentic blood microbiome in a number of non-communicable diseases." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/25940667> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/26129950_3> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_26129950_3" ;
    gutprop:hasSentenceText "However, it is not clear whether an imbalance in gut microbiota promotes the onset of liver injury or if the imbalance results from the pathological state." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/26129950> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/26129950_9> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_26129950_9" ;
    gutprop:hasSentenceText "Modulation of gut microbiota could be a novel target for preventing cholesterol-related metabolic disorders." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/26129950> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/26190966_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_26190966_0" ;
    gutprop:hasSentenceText "Role of neuroinflammation in the emotional and cognitive alterations displayed by animal models of obesity." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/26190966> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/26408987_1> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_26408987_1" ;
    gutprop:hasSentenceText "Increasing numbers of studies have suggested that the gut microbiota is involved in the pathophysiology of stress-related disorders." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/26408987> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/26408987_11> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_26408987_11" ;
    gutprop:hasSentenceText "They also suggest the therapeutic potential of L. helveticus NS8 in stress-related and possibly other kinds of depression." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/26408987> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/26426677_1> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_26426677_1" ;
    gutprop:hasSentenceText "Intestinal inflammation is a major health problem which impairs the quality of life, impacts mental health and is exacerbated by stress and psychiatric disturbances which, in turn, can affect disease prognosis and response to treatment." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/26426677> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/26927355_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_26927355_0" ;
    gutprop:hasSentenceText "Letter to the Editor: The Surge of Type 2 Diabetes Mellitus in China - an International Alert: Physical Exercise and Low-Caloric Diet May Reduce the Risks of Type 2 Diabetes Mellitus and Dementia." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/26927355> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/26927355_6> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_26927355_6" ;
    gutprop:hasSentenceText "Colon microbiota can ferment these carbohydrates to the short-chain fatty acid butyrate." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/26927355> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/27319972_1> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_27319972_1" ;
    gutprop:hasSentenceText "There is now a large volume of evidence to support the view that the immune system is a key communication pathway between the gut and brain, which plays an important role in stress-related psychopathologies and thus provides a potentially fruitful target for psychotropic intervention." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/27319972> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/27566465_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_27566465_0" ;
    gutprop:hasSentenceText "Alzheimer's disease and gut microbiota." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/27566465> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/27566465_7> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_27566465_7" ;
    gutprop:hasSentenceText "All the results suggest that AD may begin in the gut, and is closely related to the imbalance of gut microbiota." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/27566465> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/27566465_8> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_27566465_8" ;
    gutprop:hasSentenceText "Modulation of gut microbiota through personalized diet or beneficial microbiota intervention will probably become a new treatment for AD." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/27566465> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/27763700_6> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_27763700_6" ;
    gutprop:hasSentenceText "After 4 weeks, rats were exposed to inescapable stress, and either immediately killed for blood and tissues, or assessed for learned helplessness 24 h later." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/27763700> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/27793225_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_27793225_2" ;
    gutprop:hasSentenceText "Changes in diet around the world mean that populations are now increasingly reliant on highly processed, poor quality foods, which have been linked to increased risk for mental disorder." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/27793225> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/27930574_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_27930574_0" ;
    gutprop:hasSentenceText "A MeSH-based text mining method for identifying novel prebiotics." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/27930574> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/27930574_5> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_27930574_5" ;
    gutprop:hasSentenceText "We defined an optimal feature set for prebiotics prediction using a systematic feature-ranking algorithm with which a variety of carbohydrates can be accurately classified into different clusters in accordance with their chemical and biological attributes." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/27930574> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/27930574_6> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_27930574_6" ;
    gutprop:hasSentenceText "The optimal feature set was used to separate positive prebiotics from other carbohydrates, and a cross-validation procedure was employed to assess the prediction accuracy of the model." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/27930574> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28073356_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_28073356_0" ;
    gutprop:hasSentenceText "Gut microbiota disturbance during helminth infection: can it affect cognition and behaviour of children?" ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/28073356> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28073356_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_28073356_2" ;
    gutprop:hasSentenceText "Recent studies have shown that helminth infections can alter the normal gut microbiota." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/28073356> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28073356_9> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_28073356_9" ;
    gutprop:hasSentenceText "Further empirical studies are necessary to test an indirect effect of helminth infections on the modulation of mood and behaviour through its effects on the gut microbiota." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/28073356> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28158162_1> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_28158162_1" ;
    gutprop:hasSentenceText "Recent studies have shown that migraine headache is often associated with concomitant gastrointestinal diseases." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/28158162> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28158162_15> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_28158162_15" ;
    gutprop:hasSentenceText "Moreover, it can be inferred that probiotics may have a beneficial effect on the frequency and severity of migraine headache attacks." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/28158162> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28158162_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_28158162_2" ;
    gutprop:hasSentenceText "There is a higher prevalence of headaches in patients with gastrointestinal disorders." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/28158162> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28158162_3> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_28158162_3" ;
    gutprop:hasSentenceText "These associations between migraine and gastrointestinal disorders suggest a potential link to a bidirectional modulation of gut microbiota and brain function." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/28158162> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28158162_4> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_28158162_4" ;
    gutprop:hasSentenceText "The underlying working mechanistic links between migraine and gastrointestinal diseases may include increased intestinal epithelial permeability and inflammation." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/28158162> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28158162_5> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_28158162_5" ;
    gutprop:hasSentenceText "This review presents an overview of the relationship between gut microbiota and brain function, especially with regard to migraine headache." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/28158162> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28158162_9> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_28158162_9" ;
    gutprop:hasSentenceText "In this literature review, we mainly discussed the relationship between gut microbiota and brain function, especially with regard to migraine headache." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/28158162> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28399458_1> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_28399458_1" ;
    gutprop:hasSentenceText "Maternal mental health prior to and during pregnancy has been shown to be associated with inflammatory diseases and gastrointestinal complaints in the offspring." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/28399458> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28399458_6> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_28399458_6" ;
    gutprop:hasSentenceText "Infant inflammatory diseases, gastrointestinal complaints and drug administration assessed via questionnaire (maternal report) at four months postpartum (n=279)." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/28399458> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28442250_4> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_28442250_4" ;
    gutprop:hasSentenceText "A subgroup of FEP patients with the strongest microbiota differences also showed poorer response after up to 12months of treatment." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/28442250> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28556833_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_28556833_0" ;
    gutprop:hasSentenceText "Blockade of interleukin-6 receptor in the periphery promotes rapid and sustained antidepressant actions: a possible role of gut-microbiota-brain axis." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/28556833> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28556833_5> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_28556833_5" ;
    gutprop:hasSentenceText "Intravenous injection of MR16-1 induced rapid-onset and long-lasting antidepressant effects in susceptible mice after social defeat stress through its anti-inflammatory actions." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/28556833> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28556833_8> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_28556833_8" ;
    gutprop:hasSentenceText "Gut microbiota analysis using 16S ribosomal RNA gene sequencing showed that MR16-1 significantly improved decreased Firmicutes/Bacteroidetes ratio in susceptible mice." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/28556833> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28572752_11> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_28572752_11" ;
    gutprop:hasSentenceText "The role of gut microbiota in chronic alcohol overconsumption should be investigated further." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/28572752> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28629758_4> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_28629758_4" ;
    gutprop:hasSentenceText "Social avoidance behaviors were examined three weeks after the last defeat or control episode and blood, brain, and cecum contents were collected 24h afterward for the determination of corticosterone, pro-inflammatory cytokines, and microbial populations." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/28629758> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28716445_3> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_28716445_3" ;
    gutprop:hasSentenceText "The purpose of this review is to familiarize clinicians with the physiology controlling feeding behavior and its implications for psychiatric conditions, such as anorexia nervosa and depression." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/28716445> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28816544_6> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_28816544_6" ;
    gutprop:hasSentenceText "It is suggested that novel antidepressants can be developed based on targeting microglia-, PUFAs-, glucocorticoid- and gut microbiota-mediated cellular pathways." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/28816544> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28843021_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_28843021_0" ;
    gutprop:hasSentenceText "The nasal and gut microbiome in Parkinson's disease and idiopathic rapid eye movement sleep behavior disorder." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/28843021> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28843021_1> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_28843021_1" ;
    gutprop:hasSentenceText "Increasing evidence connects the gut microbiota and the onset and/or phenotype of Parkinson's disease (PD)." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/28843021> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28843021_3> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_28843021_3" ;
    gutprop:hasSentenceText "It is, however, unknown whether these differences can be observed in individuals at high risk, for example, with idiopathic rapid eye movement sleep behavior disorder, a prodromal condition of α-synuclein aggregation disorders including PD." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/28843021> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28852308_1> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_28852308_1" ;
    gutprop:hasSentenceText "The last decade has witnessed a growing appreciation of the fundamental role played by an early assembly of a diverse and balanced gut microbiota and its subsequent maintenance for future health of the host." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/28852308> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/29022384_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_29022384_0" ;
    gutprop:hasSentenceText "Does the maternal vaginal microbiota play a role in seeding the microbiota of neonatal gut and nose?" ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/29022384> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/29022384_10> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_29022384_10" ;
    gutprop:hasSentenceText "Only vaginally delivered, fully breastfed infants had gut microbiota dominated by Bifidobacteria." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/29022384> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/29022384_12> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_29022384_12" ;
    gutprop:hasSentenceText "The sources of a large proportion of infant microbiota could not be identified in maternal microbiota, and the sources of seeding of infant gut and nasal microbiota remain to be elucidated." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/29022384> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/29022384_5> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_29022384_5" ;
    gutprop:hasSentenceText "However, an infant's nasal and gut microbiota were no more similar to that of its own mother, than to that of unrelated mothers." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/29022384> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/29022384_7> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_29022384_7" ;
    gutprop:hasSentenceText "We conclude that the transfer of maternal vaginal microbes play a minor role in seeding infant stool microbiota." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/29022384> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/29023380_3> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_29023380_3" ;
    gutprop:hasSentenceText "The search was performed using the following keywords: \"gut-brain axis\", \"gut-microbiota-brain axis\", \"nutrition microbiome/microbiota\", \"enteric nervous system\", \"enteric glial cells/network\", \"gut-brain pathways\", \"microbiome immune system\", \"microbiome neuroendocrine system\" and \"intestinal/gut/enteric neuropeptides\"." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/29023380> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/29249803_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_29249803_0" ;
    gutprop:hasSentenceText "Possible role of the gut microbiota-brain axis in the antidepressant effects of (R)-ketamine in a social defeat stress model." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/29249803> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/29249803_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_29249803_2" ;
    gutprop:hasSentenceText "(R)-ketamine has a greater potency and longer-lasting antidepressant effects than (S)-ketamine." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/29249803> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/29249803_3> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_29249803_3" ;
    gutprop:hasSentenceText "Here, we investigated whether the gut microbiota plays a role in the antidepressant effects of these two ketamine enantiomers." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/29249803> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/29352709_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_29352709_0" ;
    gutprop:hasSentenceText "Analysis of gut microbiota diversity and auxiliary diagnosis as a biomarker in patients with schizophrenia: A cross-sectional study." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/29352709> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/29843470_1> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_29843470_1" ;
    gutprop:hasSentenceText "Major depression is one of the leading causes of disability, morbidity, and mortality worldwide." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/29843470> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/29843470_3> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_29843470_3" ;
    gutprop:hasSentenceText "Traditional depression treatments all target the brain, with different drugs and/or psychotherapy." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/29843470> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/29843470_7> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_29843470_7" ;
    gutprop:hasSentenceText "Nowadays, the gut microbiota modulation has become a hot topic in treatment research of mental disorders." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/29843470> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/29857583_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_29857583_2" ;
    gutprop:hasSentenceText "Parkinson's disease (PD) is the most intensively studied neurodegenerative disease in this context." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/29857583> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/29857583_7> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_29857583_7" ;
    gutprop:hasSentenceText "and Prevotellaceae was observed in PD." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/29857583> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/29955222_4> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_29955222_4" ;
    gutprop:hasSentenceText "This perspective explores the possibility of using Indian <i>thali</i>, an ancient approach to diet that provides both fiber and different phytochemicals by incorporating a variety of plant foods in different colors." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/29955222> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30072879_13> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_30072879_13" ;
    gutprop:hasSentenceText "Further, MPTP impaired cued fear memory in WT, but not KO, male mice." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30072879> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30072879_15> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_30072879_15" ;
    gutprop:hasSentenceText "MPTP treatment and genotype affected the diversity of the gut microbiome." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30072879> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30072879_18> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_30072879_18" ;
    gutprop:hasSentenceText "MPTP's effect on motor and cognitive performance may then be, at least in part, be mediated by the gut microbiome." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30072879> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30072879_19> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_30072879_19" ;
    gutprop:hasSentenceText "These data also support mGlu8 as a novel therapeutic target for PD and highlight the importance of including both sexes in preclinical studies." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30072879> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30072879_6> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_30072879_6" ;
    gutprop:hasSentenceText "Additionally, the gut microbiome can communicate with the CNS via the gut-brain axis." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30072879> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30258234_6> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_30258234_6" ;
    gutprop:hasSentenceText "Pathways associated with such injury include several sensing and housekeeping pathways, such as the Trem2, Cx3cr1 and progranulin pathways, which act as immune checkpoints to keep the microglial inflammatory response under control, and the scavenger receptor pathways, which promote clearance of injurious stimuli." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30258234> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30309367_1> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_30309367_1" ;
    gutprop:hasSentenceText "Visceral pain is a complex and heterogeneous disorder, which can range from the mild discomfort of indigestion to the agonizing pain of renal colic." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30309367> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30309367_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_30309367_2" ;
    gutprop:hasSentenceText "Regulation of visceral pain involves the spinal cord as well as higher order brain structures." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30309367> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30317530_1> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_30317530_1" ;
    gutprop:hasSentenceText "Gut microbiota has evolved along with their hosts and is an integral part of the human body." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30317530> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30317530_5> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_30317530_5" ;
    gutprop:hasSentenceText "Though the gut microbiota is dynamic, it performs some basic functions in the immunological, metabolic, structural and neurological landscapes of the human body." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30317530> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30317530_6> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_30317530_6" ;
    gutprop:hasSentenceText "Gut microbiota also exerts significant influence on both physical and mental health of an individual." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30317530> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30394313_1> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_30394313_1" ;
    gutprop:hasSentenceText "Autism spectrum disorder (ASD) affects 1% of children and has no cure." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30394313> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30394313_13> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_30394313_13" ;
    gutprop:hasSentenceText "Further study of the MEs identified here may advance our understanding of the pathogenesis of ASD." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30394313> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30394313_3> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_30394313_3" ;
    gutprop:hasSentenceText "Recent evidence suggests that gut microbiota may participate in the pathogenesis of ASD through immune- and inflammation-mediated pathways." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30394313> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30405455_4> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_30405455_4" ;
    gutprop:hasSentenceText "Gut microbiota composition and function are influenced both by genetics, age, sex, diet, life experiences, and many other factors of psychiatric and bodily disorders and thus may act as potential biomarkers of the gut-brain axis that could be used in psychiatry and co-morbid conditions." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30405455> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30405455_5> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_30405455_5" ;
    gutprop:hasSentenceText "There is a particular need in major depressive disorder and other mental illness to identify biomarkers that can stratify patients into more homogeneous groups to provide better treatment and for development of new therapeutic approaches." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30405455> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30518033_1> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_30518033_1" ;
    gutprop:hasSentenceText "Psychobiotics are probiotic strains that confer mental health benefits to the host through the modulation of the gut microbial population." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30518033> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30518033_4> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_30518033_4" ;
    gutprop:hasSentenceText "Hence, in our research, we attempted to draw a connection between host genetics, microbiota composition, and anxiety by performing an elevated plus maze (EPM) test on four genetically different mice." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30518033> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30528936_6> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_30528936_6" ;
    gutprop:hasSentenceText "Furthermore, a total of 30 bacteria were significantly altered in the LPS + saline treated mice and LPS + ketamine treated mice." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30528936> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30584306_11> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_30584306_11" ;
    gutprop:hasSentenceText "Defects of the Firmicutes may lead to the depression in short-chain fatty acids, which could account for the physiological basis of low-level inflammation of depression." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30584306> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30659564_8> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_30659564_8" ;
    gutprop:hasSentenceText "Moreover, gut microbiome can be associated with obesity and inflammatory gastrointestinal disorders." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30659564> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30701194_10> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_30701194_10" ;
    gutprop:hasSentenceText "Finally, gut 2-keto-glutaramic acid was validated as a potential biomarker for ASD." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30701194> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30701194_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_30701194_2" ;
    gutprop:hasSentenceText "Here, we investigated the composition of the gut microbiota and metabolites in children with ASD." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30701194> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30701194_5> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_30701194_5" ;
    gutprop:hasSentenceText "Systematic bioinformatic analyses were performed to identify gut metabolites associated with altered gut microbiota composition." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30701194> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30701194_8> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_30701194_8" ;
    gutprop:hasSentenceText "These changes in glutamate metabolism were correlated with lower levels of the highly abundant bacteria Bacteroides vulgatus and higher levels of the potentially harmful Eggerthella lenta and Clostridium botulinum." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30701194> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30701194_9> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_30701194_9" ;
    gutprop:hasSentenceText "Lower gut cortisol levels have also been identified in the ASD group and associated with changes in gut microbiota glutamate metabolism." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30701194> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30707176_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_30707176_0" ;
    gutprop:hasSentenceText "Gut microbiota analysis and its significance in vasovagal syncope in children." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/30707176> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30707176_3> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_30707176_3" ;
    gutprop:hasSentenceText "This study was designed to analyze the gut microbiota in children with VVS and explore its clinical significance." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30707176> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30707176_6> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_30707176_6" ;
    gutprop:hasSentenceText "The correlation between the predominant bacteria and clinical symptoms was analyzed using Pearson or Spearman correlation test." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30707176> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30707176_7> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_30707176_7" ;
    gutprop:hasSentenceText "No significant differences in diversity were evident between VVS and controls (P > 0.05)." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30707176> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30717162_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_30717162_0" ;
    gutprop:hasSentenceText "Fecal Microbiota Analysis in Patients Going through a Depressive Episode during Treatment in a Psychiatric Hospital Setting." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/30717162> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30717162_1> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_30717162_1" ;
    gutprop:hasSentenceText "There is a worldwide prevalence of generalized anxiety and major depressive disorders (MDD)." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30717162> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30717162_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_30717162_2" ;
    gutprop:hasSentenceText "Gut⁻brain axis dysfunction, antibacterial activity, and modulatory effects of antidepressants toward intestinal bacteria have been shown both in vitro and in vivo." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30717162> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30818031_1> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_30818031_1" ;
    gutprop:hasSentenceText "Dysfunctional processing of fear memory may be involved in the pathophysiology of fear of cancer recurrence (FCR), which is cited as the major unmet psychological need of cancer survivors." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30818031> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30818031_3> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_30818031_3" ;
    gutprop:hasSentenceText "We therefore hypothesized that the gut microbiota is associated with FCR in cancer survivors." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30818031> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30826885_1> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_30826885_1" ;
    gutprop:hasSentenceText "Our current understanding of the underlying mechanisms and etiologies of perinatal mood and anxiety disorders (PMADs) is not clearly identified." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30826885> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30828318_8> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_30828318_8" ;
    gutprop:hasSentenceText "For verification of a link between the gut microbiota and brain, and to test new therapies, human studies are needed, and are long overdue." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30828318> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30900006_4> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_30900006_4" ;
    gutprop:hasSentenceText "We examined differences in gut microbiota composition and fecal miRNA profiles in BALB/c and C57BL/6 mice, in relation to gastrointestinal homeostasis and evaluated the response to perturbation of the gut microbiota by broad-spectrum antibiotic treatment." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30900006> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31053995_1> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_31053995_1" ;
    gutprop:hasSentenceText "Current markers of Parkinson's disease (PD) fail to detect the early progression of disease state." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31053995> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31053995_3> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_31053995_3" ;
    gutprop:hasSentenceText "Based on evidence previously collected by our group in a mouse model of PD, we speculated that a particular set of circulating lipids might be significantly altered by the pathology." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31053995> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31053995_8> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_31053995_8" ;
    gutprop:hasSentenceText "Further to this, the observed downregulation of these NAPEs is in line with the results in plasma of a mouse model of Parkinson's (6-OHDA)." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31053995> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31083360_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_31083360_0" ;
    gutprop:hasSentenceText "A Systematic Review of the Role of Prebiotics and Probiotics in Autism Spectrum Disorders." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/31083360> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31083360_12> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_31083360_12" ;
    gutprop:hasSentenceText "As for probiotics, there is limited evidence to support the role of probiotics in alleviating the GI or behavioral symptoms in children with ASD." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31083360> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31083360_5> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_31083360_5" ;
    gutprop:hasSentenceText "However, systematic reviews of the effect of prebiotics/probiotics on ASD and its associated symptoms are lacking." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31083360> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31132457_10> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_31132457_10" ;
    gutprop:hasSentenceText "The IBQ-R main dimension surgency (positive emotionality) was associated positively both with genus Bifidobacterium and Streptococcus." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31132457> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31132457_12> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_31132457_12" ;
    gutprop:hasSentenceText "This is the first study demonstrating associations, but not causal connections, between GMC and temperament in young infants in a prospective design." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31132457> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31132457_3> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_31132457_3" ;
    gutprop:hasSentenceText "For example, toddler temperament traits have been found to associate with differences in GMC; however, studies in infants are lacking although infancy is a rapid period of neurodevelopment as well as GM development." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31132457> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31132457_7> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_31132457_7" ;
    gutprop:hasSentenceText "GMC taxonomic composition (at Genus and OTU level), observed sample clusters, diversity and richness were investigated in relation to the maternal reports of Infant Behavior Questionnaire -Revised (IBQ-R) at the age of 6 months." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31132457> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31148353_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_31148353_2" ;
    gutprop:hasSentenceText "Although human umbilical cord blood (hUCB) stem/progenitor cells present with no or minimal capacity of differentiation into mature dopaminergic neurons, their transplantation significantly attenuates parkinsonian symptoms likely via bystander effects, specifically stem cell graft-mediated secretion of growth factors, anti-inflammatory cytokines, or synaptic function altogether promoting brain repair." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31148353> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31154909_4> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_31154909_4" ;
    gutprop:hasSentenceText "It is hypothesised that activation of the μ-opioid receptors in the gut can alter gut microbial composition, impair gut barrier integrity and bile acid metabolism, in addition to increasing gastrointestinal transit time and gut inflammation." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31154909> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31154909_5> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_31154909_5" ;
    gutprop:hasSentenceText "Further, it is hypothesised that BCM-7 may influence fractures and obesity via μ-opioid receptor pathways." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31154909> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31179435_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_31179435_0" ;
    gutprop:hasSentenceText "Effects of regulating intestinal microbiota on anxiety symptoms: A systematic review." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/31179435> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31179435_10> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_31179435_10" ;
    gutprop:hasSentenceText "In the 21 studies, 15 chose probiotics as interventions to regulate intestinal microbiota and six chose non-probiotic ways such as adjusting daily diets." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31179435> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31179435_11> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_31179435_11" ;
    gutprop:hasSentenceText "Probiotic supplements in seven studies contained only one kind of probiotic, two studies used a product that contained two kinds of probiotics and the supplements used in the other five studies included at least three kinds of probiotics." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31179435> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31179435_14> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_31179435_14" ;
    gutprop:hasSentenceText "In addition, it should be noted that six of seven studies showed that regulation of intestinal microbiota could treat anxiety symptoms, the rate of efficacy was 86%." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31179435> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31179435_15> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_31179435_15" ;
    gutprop:hasSentenceText "We find that more than half of the studies included showed it was positive to treat anxiety symptoms by regulation of intestinal microbiota." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31179435> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31179435_4> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_31179435_4" ;
    gutprop:hasSentenceText "To find evidence supporting improvement of anxiety symptoms by regulation of intestinal microbiota." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31179435> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31218116_10> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_31218116_10" ;
    gutprop:hasSentenceText "The secondary outcomes are markers of metabolic syndrome (waist circumference, fasting glucose, serum lipids, blood pressure, and body composition), gastrointestinal symptoms, sleep quality, adherence to a GFD, exercise behavior, self-regulatory efficacy, and self-compassion." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31218116> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31218116_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_31218116_2" ;
    gutprop:hasSentenceText "Unfortunately, many people with celiac disease report poor quality of life (QoL) despite following a strict GFD, and up to 30% still report negative symptoms (eg, gastrointestinal upset)." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31218116> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31248424_10> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_31248424_10" ;
    gutprop:hasSentenceText "Bacteroides abundance was correlated with motor symptom severity defined by UPDRS part III motor scores (rho = 0.637 [95% confidence interval 0.474 to 0.758], P < 0.01)." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31248424> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31248424_15> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_31248424_15" ;
    gutprop:hasSentenceText "The altered plasma cytokine profiles associated with gut microbiome composition alterations suggest aberrant immune responses may contribute to inflammatory processes in PD." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31248424> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31255682_3> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_31255682_3" ;
    gutprop:hasSentenceText "Shotgun metagenomic sequencing and 16S rRNA sequencing were performed, and the gut microbiota-associated epitopes (MEs) were predicted, which, together with IgA content, were used to determine the gut microbiota composition associated with gut immune status." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31255682> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31255682_5> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_31255682_5" ;
    gutprop:hasSentenceText "Based on two-stage metagenomic-wide association studies, nineteen gut microbiota taxonomies were associated with schizophrenia, and the microbial dysbiosis (MD) index was calculated based on the abundance of differential taxonomies." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31255682> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31302116_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_31302116_0" ;
    gutprop:hasSentenceText "Stress-induced disturbances along the gut microbiota-immune-brain axis and implications for mental health: Does sex matter?" ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/31302116> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31302116_4> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_31302116_4" ;
    gutprop:hasSentenceText "This review will also analyze the idea that gut microbes and sex hormones influence each other, and that this reciprocal crosstalk may come to modulate inflammatory players along the gut microbiota-immune-brain axis and influence behavior in a sex-dependent way." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31302116> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31330299_6> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_31330299_6" ;
    gutprop:hasSentenceText "We also cover how the gastrointestinal microbiota is implicated in these mental illnesses." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31330299> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31377712_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_31377712_0" ;
    gutprop:hasSentenceText "Biopsychosocial model of resilience in young adults with multiple sclerosis (BPS-ARMS): an observational study protocol exploring psychological reactions early after diagnosis." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/31377712> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31377712_8> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_31377712_8" ;
    gutprop:hasSentenceText "The results are expected to allow a comprehensive understanding of the determinants of resilience in young patients with MS and to inform resilience interventions, tailored to young patients' specific needs, aiming to reduce the risk of maladaptive reactions to the disease and to improve psychological well-being and QoL." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31377712> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31383280_4> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_31383280_4" ;
    gutprop:hasSentenceText "The ability to manipulate the gut microbiota composition and structure through host nutrition and to harness the gut microbes for improved individualized nutrition may be an important new direction for prevention and treatment of PMAD, thus improving the mental health of mother and child." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31383280> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31488882_4> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_31488882_4" ;
    gutprop:hasSentenceText "The brain-infiltrated peripheral Th1 immune cells are associated with the M1 microglia activation, contributing to AD-associated neuroinflammation." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31488882> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31493127_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_31493127_0" ;
    gutprop:hasSentenceText "Probiotics and Psychobiotics: the Role of Microbial Neurochemicals." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/31493127> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31530799_11> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_31530799_11" ;
    gutprop:hasSentenceText "These findings suggest that abnormal composition of the gut microbiota, including organisms such as Lactobacillus, contributes to susceptibility versus resilience to LH in rats subjected to inescapable electric foot shock." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31530799> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31539679_1> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_31539679_1" ;
    gutprop:hasSentenceText "The brain-gut axis plays a role in the pathogenesis of stress-related disorders such as depression." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31539679> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31539679_4> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_31539679_4" ;
    gutprop:hasSentenceText "Using CSDS paradigm, we investigated the effects of antibiotic-induced microbiome depletion on the resilience versus susceptibility in mice." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31539679> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31539679_8> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_31539679_8" ;
    gutprop:hasSentenceText "CSDS was shown to significantly improve the abnormal composition of gut microbiota in the antibiotic-treated group." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31539679> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31568686_3> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_31568686_3" ;
    gutprop:hasSentenceText "While our understanding of the precise role of gut microbiota (GM) in psychological illness is in its infancy, it represents an attractive target for novel interventions." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31568686> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31596658_1> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_31596658_1" ;
    gutprop:hasSentenceText "<b><i>Objective</i>:</b> The objective of this review is to consider the dual effects of microbiome and photobiomodulation (PBM) on human health and to suggest a relationship between these two as a novel mechanism." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31596658> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31596658_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_31596658_2" ;
    gutprop:hasSentenceText "<b><i>Background</i>:</b> PBM describes the use of low levels of visible or near-infrared (NIR) light to heal and stimulate tissue, and to relieve pain and inflammation." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31596658> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31596658_4> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_31596658_4" ;
    gutprop:hasSentenceText "Also, in recent years, increasing attention has been paid to the total microbial population that colonizes the human body, chiefly in the gut and the mouth, called the microbiome." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31596658> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31610228_1> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_31610228_1" ;
    gutprop:hasSentenceText "Alcohol-related morbidity may involve changes in the gut microbiota and immune dysregulation." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31610228> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31610228_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_31610228_2" ;
    gutprop:hasSentenceText "We have previously demonstrated alterations in gut microbiota composition and functions in patients with alcohol overconsumption, and now aimed to investigate possible associations between cytokine levels, gut microbiota, and clinical symptoms." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31610228> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31662903_1> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_31662903_1" ;
    gutprop:hasSentenceText "Associations between Diet, Faecal Microbiota, and Short-Chain Fatty Acids in Morbidly Obese Subjects." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31662903> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31662903_10> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_31662903_10" ;
    gutprop:hasSentenceText "Butyric acid has antiobesogenic effects, reduces insulin resistance, and improves dyslipidaemia." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31662903> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31662903_11> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_31662903_11" ;
    gutprop:hasSentenceText "Since the weight-reducing effect of NNSs on obese adults trying to lose weight is dubious, it seems imprudent to use NNSs that might counteract the favourable effects of butyric acid." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31662903> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31662903_7> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_31662903_7" ;
    gutprop:hasSentenceText "Fourteen men and 75 women with a mean age of 44.6 (SD 8.7) years, BMI 41.8 (SD 3.6) kg/m<sup>2</sup>, and intake of NNSs 7.5 units/day (SD 3.2; range 0-43) were included." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31662903> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31685046_1> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_31685046_1" ;
    gutprop:hasSentenceText "The microbiota-gut-brain axis, especially the microbial tryptophan (Trp) biosynthesis and metabolism pathway (MiTBamp), may play a critical role in the pathogenesis of major depressive disorder (MDD)." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31685046> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31685046_11> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_31685046_11" ;
    gutprop:hasSentenceText "The present findings enabled a better understanding of the changes in gut microbiota and the related Trp pathway in MDD." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31685046> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31685046_3> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_31685046_3" ;
    gutprop:hasSentenceText "The aim of the present study was to analyze the gut microbiota composition and the MiTBamp in MDD patients." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31685046> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31685046_9> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_31685046_9" ;
    gutprop:hasSentenceText "Furthermore, we found a negative correlation between the K01626 abundance and the HAMD scores in the MDD group." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31685046> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31704402_8> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_31704402_8" ;
    gutprop:hasSentenceText "Also, increasing relative abundance of this rare organism correlated with reduced anxiety-like behaviour in the most anxious mice." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31704402> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31704402_9> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_31704402_9" ;
    gutprop:hasSentenceText "Our results point to an intriguing new hypothesis: that biodiverse soils may represent an important supplementary source of butyrate-producing bacteria capable of resupplying the mammalian gut microbiome, with potential for gut health and mental health benefits." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31704402> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31726457_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_31726457_2" ;
    gutprop:hasSentenceText "The extraordinary complexity of the gut ecosystem, and how it interacts with the intestinal epithelium to manifest physiological changes in the brain to influence mood and behaviour, has been the subject of intense scientific scrutiny over the last 2 decades." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31726457> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31750916_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_31750916_0" ;
    gutprop:hasSentenceText "Dietary fiber and its associations with depression and inflammation." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/31750916> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31750916_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_31750916_2" ;
    gutprop:hasSentenceText "Observational studies support associations between dietary fiber intake and depression and inflammation, but the potential mechanisms are poorly understood." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31750916> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31750916_4> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_31750916_4" ;
    gutprop:hasSentenceText "Additionally, inflammation may mediate the relationship between dietary fiber intake and depression." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31750916> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31750916_5> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_31750916_5" ;
    gutprop:hasSentenceText "A high-fiber diet potentially lowers inflammation by modifying both the pH and the permeability of the gut." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31750916> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31769847_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_31769847_2" ;
    gutprop:hasSentenceText "In this view, the gut microbiota has been considered a potential therapeutic target using probiotics and prebiotics." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31769847> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31769847_7> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_31769847_7" ;
    gutprop:hasSentenceText "Probiotics seem to offer some benefit in major depressive disorder and Alzheimer's disease." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31769847> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31769847_8> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_31769847_8" ;
    gutprop:hasSentenceText "One study showed that probiotics reduced rehospitalization in patients with acute mania." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31769847> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31821833_3> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_31821833_3" ;
    gutprop:hasSentenceText "Given this information and the fact, that the gut microbiota is sensitive to internal and environmental influences, we have speculated that among the factors that influence the formation and composition of gut microbiota during life, possible key elements in the schizophrenia development chain are hidden where gut microbiota is a linking component." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31821833> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31917834_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_31917834_0" ;
    gutprop:hasSentenceText "Adolescence and Aging: Impact of Adolescence Inflammatory Stress and Microbiota Alterations on Brain Development, Aging, and Neurodegeneration." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/31917834> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31917834_3> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_31917834_3" ;
    gutprop:hasSentenceText "The gut microbiota is a fundamental modulator of stress and immune responses and has been found to play a role in mental health conditions and neurodegenerative disorders." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31917834> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31940482_6> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_31940482_6" ;
    gutprop:hasSentenceText "We further demonstrate functional roles of the sphingolipid metabolism genes lagr-1, asm-3, and sptl-3 in the anti-aggregation effect." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31940482> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31955786_10> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_31955786_10" ;
    gutprop:hasSentenceText "Furthermore, the importance of gut-brain axis, probiotics and prebiotics are discussed." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31955786> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31955786_9> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_31955786_9" ;
    gutprop:hasSentenceText "Their formation pathways in humans, plants and microorganisms, potential health effects, effects of diet on the formation of microbial metabolites including neuroactive compounds in the gut are discussed throughout this review." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31955786> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32041265_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_32041265_0" ;
    gutprop:hasSentenceText "Interventional Influence of the Intestinal Microbiome Through Dietary Intervention and Bowel Cleansing Might Improve Motor Symptoms in Parkinson's Disease." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/32041265> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32041265_13> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_32041265_13" ;
    gutprop:hasSentenceText "Dietary intervention and bowel cleansing may provide an additional non-pharmacologic therapeutic option for PD patients." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32041265> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32041265_3> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_32041265_3" ;
    gutprop:hasSentenceText "In conjunction with a better understanding of the intestinal microbiome, a link to the misfolding and spread of alpha-synuclein via inflammatory processes within the gut is discussed." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32041265> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32041265_5> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_32041265_5" ;
    gutprop:hasSentenceText "Additionally, we tested in this proof-of-concept study whether dietary intervention alone or additional physical colon cleaning may lead to changes of the gut microbiome in PD." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32041265> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32041265_7> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_32041265_7" ;
    gutprop:hasSentenceText "10 of those patients received additional treatment with daily fecal enema over 8 days." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32041265> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32041265_9> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_32041265_9" ;
    gutprop:hasSentenceText "In comparison to HC, we could confirm previously reported PD associated microbiome changes." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32041265> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32155131_7> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_32155131_7" ;
    gutprop:hasSentenceText "Our findings indicate that this probiotic formulation can counteract the detrimental effect of 6-OHDA <i>in vitro</i> and <i>in vivo</i> models of PD." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32155131> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32163822_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_32163822_2" ;
    gutprop:hasSentenceText "Most of this research is conducted on animals why we in this review summarize and comment upon recent studies evaluating the gut microbiome in mental health in humans." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32163822> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32188376_4> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_32188376_4" ;
    gutprop:hasSentenceText "Neurocognitive dysfunction is a major driver of social dysfunction and a therapeutic target in mood disorders, although effective cognitive-enhancers are currently lacking." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32188376> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32379622_14> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_32379622_14" ;
    gutprop:hasSentenceText "Therefore, it is likely that betaine could be a prophylactic nutrient to prevent stress-related psychiatric disorders." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32379622> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32379622_4> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_32379622_4" ;
    gutprop:hasSentenceText "CSDS was performed during betaine supplementation." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32379622> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32379622_8> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_32379622_8" ;
    gutprop:hasSentenceText "Betaine supplementation ameliorated the abnormal diversity and composition of the microbiota in the host gut after CSDS." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32379622> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32431588_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_32431588_2" ;
    gutprop:hasSentenceText "The spread of α-syn pathology across brain regions is thought to play a key role in the onset and progression of clinical phenotypes." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32431588> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32431588_9> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_32431588_9" ;
    gutprop:hasSentenceText "We found that 3-HPPA effectively attenuated MSA-induced aggregation of monomer into high molecular weight aggregates capable of inducing intracellular aggregation." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32431588> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32438623_12> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_32438623_12" ;
    gutprop:hasSentenceText "This increase was associated with participants intake of unpasteurised milk and dairy products." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32438623> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32438623_3> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_32438623_3" ;
    gutprop:hasSentenceText "The impact of unpasteurised dairy products on the microbiota is unknown." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32438623> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32459708_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_32459708_0" ;
    gutprop:hasSentenceText "The role of the gut microbiota in the pathophysiology of mental and neurological disorders." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/32459708> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32469834_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_32469834_0" ;
    gutprop:hasSentenceText "The human gut microbiota and depression: widely reviewed, yet poorly understood." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/32469834> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32469834_3> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_32469834_3" ;
    gutprop:hasSentenceText "(2020) on their recent systematic review of the gut microbiota in Major Depressive Disorder (MDD), the first to incorporate a meta-analysis." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32469834> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32469834_6> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_32469834_6" ;
    gutprop:hasSentenceText "(2020) conducted a meta-analysis of alpha diversity in participants with MDD compared to controls, whereby they unexpectedly observed no significant difference between groups." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32469834> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32469834_8> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_32469834_8" ;
    gutprop:hasSentenceText "Future research should consider research quality, other forms of depression, incorporate comprehensive meta-analyses, where possible, as well as investigate associations between anxiety/depression symptom measures and the gut microbiota." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32469834> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32517799_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_32517799_0" ;
    gutprop:hasSentenceText "Parkinson's disease-associated alterations of the gut microbiome predict disease-relevant changes in metabolic functions." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/32517799> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32517799_13> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_32517799_13" ;
    gutprop:hasSentenceText "Our results suggest that PD-associated alterations of the gut microbiome can translate into substantial functional differences affecting host metabolism and disease phenotype." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32517799> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32517799_3> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_32517799_3" ;
    gutprop:hasSentenceText "Herein, we addressed this question by an analysis of stool samples from the Luxembourg Parkinson's Study (n = 147 typical PD cases, n = 162 controls)." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32517799> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32517799_4> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_32517799_4" ;
    gutprop:hasSentenceText "All individuals underwent detailed clinical assessment, including neurological examinations and neuropsychological tests followed by self-reporting questionnaires." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32517799> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32517799_6> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_32517799_6" ;
    gutprop:hasSentenceText "Second, we predicted the potential secretion for 129 microbial metabolites through personalised metabolic modelling using the microbiome data and genome-scale metabolic reconstructions of human gut microbes." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32517799> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32538869_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_32538869_0" ;
    gutprop:hasSentenceText "Crosstalk Between Alpha-Synuclein and Other Human and Non-Human Amyloidogenic Proteins: Consequences for Amyloid Formation in Parkinson's Disease." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/32538869> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32545788_8> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_32545788_8" ;
    gutprop:hasSentenceText "This review will provide a focus on the available knowledge about the NLRP3 inflammasome role in these pathologies and describe the balance between the activation of the harmful and beneficial inflammasome so that new therapies can be created for patients with these diseases." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32545788> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32572814_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_32572814_0" ;
    gutprop:hasSentenceText "Butyrate Protects Against Salsolinol-Induced Toxicity in SH-SY5Y Cells: Implication for Parkinson's Disease." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/32572814> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32572814_3> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_32572814_3" ;
    gutprop:hasSentenceText "Recent converging reports suggest a role for the gut microbiome and epigenetic factors in the onset and/or progression of PD." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32572814> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32572814_4> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_32572814_4" ;
    gutprop:hasSentenceText "Of particular relevance and potential therapeutic targets in this regard are histone deacetylases (HDACs), enzymes that are involved in chromatin remodeling." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32572814> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32572814_7> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_32572814_7" ;
    gutprop:hasSentenceText "In this study we sought to determine whether butyrate may have protective effects against salsolionl (SALS)-induced toxicity in SH-SY5Y cells." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32572814> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32600151_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_32600151_2" ;
    gutprop:hasSentenceText "The disease is characterized by progressive memory loss, cognitive impairment, and the cerebral accumulation of amyloid-β peptide." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32600151> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32600151_6> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_32600151_6" ;
    gutprop:hasSentenceText "We present symptom improvement in a patient with AD following fecal microbiota transplantation for a <i>Clostridioides difficile</i> infection." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32600151> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32667590_6> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_32667590_6" ;
    gutprop:hasSentenceText "The primary focus is on the pathways involved in intestinal metabolites of microbial origin, including short-chain fatty acids, tryptophan metabolites, and bacterial components that can activate the host's immune system." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32667590> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32667590_7> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_32667590_7" ;
    gutprop:hasSentenceText "We also list clinical evidence regarding prebiotics, probiotics, and fecal microbiota transplantation as adjuvant therapies for neuropsychiatric disorders." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32667590> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32739746_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_32739746_0" ;
    gutprop:hasSentenceText "Colonization with the commensal fungus Candida albicans perturbs the gut-brain axis through dysregulation of endocannabinoid signaling." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/32739746> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32739746_1> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_32739746_1" ;
    gutprop:hasSentenceText "Anxiety disorders are the most prevalent mental health disorder worldwide, with a lifetime prevalence of 5-7 % of the human population." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32739746> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32739746_7> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_32739746_7" ;
    gutprop:hasSentenceText "The HPA axis and anxiety-like behavior are negatively regulated by the endocannabinoid N-arachidonoylethanolamide (AEA)." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32739746> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32772900_6> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_32772900_6" ;
    gutprop:hasSentenceText "This manuscript also discusses how the psychotropics used to treat these conditions may have an antimicrobial effect on GM, and the potential for new strategies of management with probiotics and faecal transplantation." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32772900> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32816830_5> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_32816830_5" ;
    gutprop:hasSentenceText "A randomised, double-blind, placebo-controlled, study design is proposed to examine whether Fibre-fix added to an existing LFD may help modulate gastrointestinal function, improve markers of sleep, mental health and promote QOL in patients with IBS." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32816830> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32819434_3> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_32819434_3" ;
    gutprop:hasSentenceText "However, the mechanisms linking the gut microbiota with brain dysfunctions (gut-brain axis) in ASD have not yet been full elucidated." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32819434> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32819434_4> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_32819434_4" ;
    gutprop:hasSentenceText "Due to its genetic mutations and downregulated expression in patients with ASD, EPHB6, which also plays important roles in gut homeostasis, is generally considered a candidate gene for ASD." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32819434> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32819434_5> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_32819434_5" ;
    gutprop:hasSentenceText "Nonetheless, the role and mechanism of EPHB6 in regulating the gut microbiota and the development of ASD are unclear." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32819434> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32834004_6> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_32834004_6" ;
    gutprop:hasSentenceText "We have conducted empirical studies using three simulation datasets generated using Dirichlet-multinomial models and a real gut microbiome data related to Parkinson's disease to investigate the performance of the three strategies for predictive analysis." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32834004> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32890382_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_32890382_2" ;
    gutprop:hasSentenceText "We hypothesized interactions between epigenetic processes, inflammatory response and gut microbiota with family surroundings or environmental characteristics." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32890382> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32979562_9> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_32979562_9" ;
    gutprop:hasSentenceText "The features of cross-sectional design, limited sample size, the heterogeneity of bipolar disorders, and a lack of serum/plasma tryptophan concentration measurements." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32979562> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32987656_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_32987656_0" ;
    gutprop:hasSentenceText "The Pathology of Parkinson's Disease and Potential Benefit of Dietary Polyphenols." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/32987656> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32987656_5> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_32987656_5" ;
    gutprop:hasSentenceText "Intake of polyphenols through diet is also associated with lower PD risk in humans." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32987656> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32987656_8> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_32987656_8" ;
    gutprop:hasSentenceText "Polyphenols appear to have a positive effect on the gut microbiome, which may decrease inflammation that contributes to the disease." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32987656> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32987656_9> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_32987656_9" ;
    gutprop:hasSentenceText "Therefore, a diet rich in polyphenols may decrease the symptoms and increase quality of life in PD patients." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32987656> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32999308_1> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_32999308_1" ;
    gutprop:hasSentenceText "The proper communication between gut and brain is pivotal for the maintenance of health and, dysregulation of the gut-brain axis can lead to several clinical disorders." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32999308> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32999308_12> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_32999308_12" ;
    gutprop:hasSentenceText "Our data suggest that metabolites and inflammation produced in the gut could be used as biomarkers for PD detection." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32999308> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32999308_13> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_32999308_13" ;
    gutprop:hasSentenceText "Perhaps, these metabolites and inflammatory mediators could be involved in triggering inflammation resulting in PD pathology." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32999308> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32999308_4> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_32999308_4" ;
    gutprop:hasSentenceText "DJ-1 is a chaperone protein involved in the protection against PD and genetic mutations in this protein have been shown to cause familial PD." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32999308> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32999308_7> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_32999308_7" ;
    gutprop:hasSentenceText "We revealed that deficiency of DJ-1 leads to a significant increase in two specific genera/species, namely Alistipes and Rikenella." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32999308> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32999308_9> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_32999308_9" ;
    gutprop:hasSentenceText "Fecal and serum metabolic profile showed that malonate which influences the immune system was significantly more abundant in DJ-1<sup>-/-</sup> mice." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32999308> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33046051_16> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33046051_16" ;
    gutprop:hasSentenceText "Our results demonstrate that the developed classification model provides a good tool that can be used to suggest the presence or absence of MS condition by collecting and analyzing gut microbiome samples." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33046051> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33063712_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33063712_0" ;
    gutprop:hasSentenceText "The emerging role of probiotics in neurodegenerative diseases: new hope for Parkinson's disease?" ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/33063712> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33063712_8> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33063712_8" ;
    gutprop:hasSentenceText "Future investigations in Parkinson's disease should consider the role of the gut-brain axis and additional comprehension of the underlying mechanisms is extremely necessary." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33063712> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33076930_1> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33076930_1" ;
    gutprop:hasSentenceText "Parkinson's disease (PD) is a progressive neurodegenerative disorder characterized by both motor and non-motor symptoms." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33076930> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33076930_8> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33076930_8" ;
    gutprop:hasSentenceText "Levodopa is deaminated by the gut bacterium C. sporogenes producing a metabolite that inhibits ileal motility ex vivo." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33076930> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33105830_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33105830_0" ;
    gutprop:hasSentenceText "Probiotics in Treatment of Viral Respiratory Infections and Neuroinflammatory Disorders." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/33105830> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33105830_4> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33105830_4" ;
    gutprop:hasSentenceText "Probiotics are well known to reinforce immunity and counteract inflammation by restoring symbiosis within the gut microbiota." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33105830> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33105830_5> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33105830_5" ;
    gutprop:hasSentenceText "As a result, probiotics protect against various diseases, including respiratory infections and neuroinflammatory disorders." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33105830> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33177907_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33177907_0" ;
    gutprop:hasSentenceText "Gut Microbiota Changes and Their Relationship with Inflammation in Patients with Acute and Chronic Insomnia." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/33177907> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33177907_1> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33177907_1" ;
    gutprop:hasSentenceText "The major purpose of this study was to detect the changes in gut microbiota composition and inflammatory cytokines production associated with acute and chronic insomnia." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33177907> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33177907_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33177907_2" ;
    gutprop:hasSentenceText "This study also evaluated the relationship between gut microbiota changes and increased inflammatory cytokines in insomnia patients." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33177907> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33177907_3> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33177907_3" ;
    gutprop:hasSentenceText "Outpatients with acute and chronic insomnia (aged 26-55 years; n=20 and 38, respectively) and age/gender-matched healthy controls (n=38) were recruited from a southern China region." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33177907> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33177907_8> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33177907_8" ;
    gutprop:hasSentenceText "These ﬁndings suggest that insomnia symptomology, gut microbiota, and inflammation may be interrelated in complex ways." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33177907> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33177907_9> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33177907_9" ;
    gutprop:hasSentenceText "Gut microbiota may serve as an important indicator for auxiliary diagnosis of insomnia and provide possible new therapeutic targets in the ﬁeld of sleep disorders." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33177907> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33194817_1> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33194817_1" ;
    gutprop:hasSentenceText "Irritable bowel syndrome (IBS) and depression have high tendencies of comorbidity." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33194817> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33194817_10> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33194817_10" ;
    gutprop:hasSentenceText "These changes led us to propose a connection between genomic signatures and clinical differences observed in IBS-D and depression." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33194817> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33194817_9> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33194817_9" ;
    gutprop:hasSentenceText "Correlation with host metabolites, such as maltotriose and isomaltose in carbohydrate metabolism and anandamide in neuroactive metabolism, drew further connections between these findings." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33194817> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33195226_1> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33195226_1" ;
    gutprop:hasSentenceText "Schizophrenia (SZ) is a psychiatric disorder that constitutes one of the top 10 global causes of disability." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33195226> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33195226_10> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33195226_10" ;
    gutprop:hasSentenceText "Our discovery opens up new avenues to explore gut dysbiosis and its proposed links to brain dysfunction in SZ, as well as novel therapeutic approaches to this devastating disorder." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33195226> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33195226_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33195226_2" ;
    gutprop:hasSentenceText "More recently, a potential pathogenic role for the gut microbial community (microbiota) has been highlighted, with numerous studies describing dysregulated microbial profiles in SZ patients when compared to healthy controls." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33195226> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33195226_7> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33195226_7" ;
    gutprop:hasSentenceText "We also identified a signature of bacteria discriminating between the genotypes (KO and WT), consisting of the Erysipelotrichales, Bacteroidales, and Clostridiales orders and macroscopic gut differences." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33195226> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33195226_8> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33195226_8" ;
    gutprop:hasSentenceText "We thus uncovered global differential community composition in the gut microbiota profile between mGlu5 KO and WT mice, outlining the first evidence for gut dysbiosis in a genetic animal model of SZ." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33195226> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33212907_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33212907_0" ;
    gutprop:hasSentenceText "PROFAST: A Randomized Trial Assessing the Effects of Intermittent Fasting and <i>Lacticaseibacillus rhamnosus</i> Probiotic among People with Prediabetes." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/33212907> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33212907_1> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33212907_1" ;
    gutprop:hasSentenceText "Both intermittent fasting and specific probiotics have shown promise in improving glucose tolerance with a potential for synergistic effects through alterations to gut microbiota." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33212907> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33212907_5> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33212907_5" ;
    gutprop:hasSentenceText "Secondary outcomes included changes in anthropometry, body composition, glucoregulatory markers, lipids, hunger hormones, liver enzymes, inflammatory markers, gut hormones, calorie and macronutrient intake, quality of life, hunger, mood and eating behavior." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33212907> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33212907_6> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33212907_6" ;
    gutprop:hasSentenceText "Of 33 participants who commenced the trial, 26 participants (mean age 52 years, body mass index (BMI) 34.7 kg/m<sup>2</sup>) completed the intervention (<i>n</i> = 11 placebo, <i>n</i> = 15 probiotic)." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33212907> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33212907_9> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33212907_9" ;
    gutprop:hasSentenceText "This study shows additional psychological benefits of probiotic supplementation during intermittent fasting to achieve weight loss and glycemic improvement in prediabetes." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33212907> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33240722_8> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33240722_8" ;
    gutprop:hasSentenceText "In addition to gut microbiome in neurological and psychiatry diseases, we have briefly discussed microbial metabolites affecting the blood-brain barrier (BBB), immune dysregulation, modification of autonomic sensorimotor connections, and hypothalamus-pituitary-adrenal axis." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33240722> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33244049_1> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33244049_1" ;
    gutprop:hasSentenceText "With increasing attention being paid to improving emotional well-being, recent evidence points to gut microbiota as a key player in regulating mental and physical health via bidirectional communication between the brain and gut." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33244049> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33244049_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33244049_2" ;
    gutprop:hasSentenceText "Here, we examine the association between emotional well-being and gut microbiome profiles (i.e., gut microbiome composition, diversity, and the moderating role of the enterotypes) among healthy Korean adults (n = 83, mean age = 48.9, SD = 13.2)." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33244049> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33244049_4> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33244049_4" ;
    gutprop:hasSentenceText "The cluster-based analysis identified two enterotypes dominated by the genera Bacteroides (n = 49) and Prevotella (n = 34)." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33244049> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33271210_14> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33271210_14" ;
    gutprop:hasSentenceText "A better understanding of the specific bacteria contributions, gut-brain pathways, and role in pathophysiological mechanisms in neuropsychiatric disorders in the child and adolescent populations can possibly provide alternative tools for a clinical psychiatrist." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33271210> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33271210_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33271210_2" ;
    gutprop:hasSentenceText "However, the potential for clinical translation of microbiome research for children and adolescents with psychiatric disorders is unclear." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33271210> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33271210_4> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33271210_4" ;
    gutprop:hasSentenceText "We performed a literature search for the gut microbiota in child and adolescent population (0-18 years old) with mental health disorders from July 1999 through July 2019 in several databases: ClinicalTrials.gov, Ovid EBM Reviews, Ovid Embase, Ovid Medline, Ovid PsycINFO, Scopus, and Web of Science." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33271210> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33271210_5> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33271210_5" ;
    gutprop:hasSentenceText "A total of 7 studies met inclusion criteria consisting of randomized controlled trials and cohort studies that examined various associations between psychiatric disorders and gut microbiota in youth." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33271210> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33271426_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33271426_0" ;
    gutprop:hasSentenceText "The gut microbiota in anxiety and depression - A systematic review." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/33271426> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33287442_1> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33287442_1" ;
    gutprop:hasSentenceText "Breast cancer is the most frequently diagnosed cancer in women worldwide." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33287442> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33287442_5> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33287442_5" ;
    gutprop:hasSentenceText "It is through these mechanisms that the gut microbiota appears to influence breast cancer risk, response to treatment, and recurrence." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33287442> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33287442_6> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33287442_6" ;
    gutprop:hasSentenceText "A disrupted gut microbiota or state of 'dysbiosis' can contribute to a biological environment associated with higher risk for cancer development as well as contribute to negative treatment side-effects." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33287442> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33287442_8> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33287442_8" ;
    gutprop:hasSentenceText "The objective of this review is to provide an overview of the current understanding of the relationship between the gut microbiota and breast cancer and to highlight potential strategies for modulation of the gut microbiota that could lead to improved clinical outcomes and overall health in this population." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33287442> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33301807_1> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33301807_1" ;
    gutprop:hasSentenceText "After spinal cord injury (SCI), intestinal dysfunction has a serious impact on physical and mental health, quality of life, and social participation." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33301807> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33318317_4> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33318317_4" ;
    gutprop:hasSentenceText "Neuropsychological assessments, inflammatory markers, and gut microbiota profiles were tested." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33318317> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33406628_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33406628_0" ;
    gutprop:hasSentenceText "Gut Microbiota Dysbiosis Is Associated with Elevated Bile Acids in Parkinson's Disease." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/33406628> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33406628_1> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33406628_1" ;
    gutprop:hasSentenceText "The gut microbiome can impact brain health and is altered in Parkinson's disease (PD)." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33406628> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33406628_3> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33406628_3" ;
    gutprop:hasSentenceText "We sought to determine whether the appendix microbiome is altered in PD and to analyze the biological consequences of the microbial alterations." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33406628> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33416892_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33416892_0" ;
    gutprop:hasSentenceText "Effects of dietary restriction on neuroinflammation in neurodegenerative diseases." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/33416892> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33422110_11> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33422110_11" ;
    gutprop:hasSentenceText "These data suggest that disruption of the intestinal integrity and the associated microbiome can interact with systemic inflammatory events to promote widespread brain-gut changes that could be relevant for PD and at the very least, suggestive of novel neuro-immune communication." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33422110> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33454868_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33454868_0" ;
    gutprop:hasSentenceText "Gut microbiota homeostasis restoration may become a novel therapy for breast cancer." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/33454868> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33454868_1> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33454868_1" ;
    gutprop:hasSentenceText "Breast cancer is the most diagnosed cancer in women." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33454868> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33454868_4> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33454868_4" ;
    gutprop:hasSentenceText "Through studies over the last decade, we now know that alterations in the composition of the gut microbiome are associated with protection against colonization by pathogens and other diseases, such as diabetes and cancer." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33454868> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33454868_7> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33454868_7" ;
    gutprop:hasSentenceText "This review will further explore the relationship between intestinal microbes and breast cancer and propose a method to treat breast cancer by improving intestinal microbes." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33454868> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33467657_6> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33467657_6" ;
    gutprop:hasSentenceText "The adverse effects of maternal obesogenic diets are also conferred through changes to hormones including leptin, insulin and oxytocin which interact with these brain regions and neuronal circuits." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33467657> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33505487_1> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33505487_1" ;
    gutprop:hasSentenceText "Results showed the overall structure of gut microbiome has no significant difference between experimental and control groups." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33505487> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33505487_3> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33505487_3" ;
    gutprop:hasSentenceText "The 16S KEGG function prediction suggested that Parkinson disease, retinol metabolism, and arachidonic acid metabolism could explain the biological function of different gut microbiome." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33505487> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33505487_4> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33505487_4" ;
    gutprop:hasSentenceText "Furthermore, cytokines in the serum showed a correlation with the abundance of <i>Pseudobutyrivibrio</i> in CFC." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33505487> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33511258_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33511258_2" ;
    gutprop:hasSentenceText "Our previous study showed that ingesting the probiotic strain, <i>Lactobacillus</i> (<i>L</i>.)" ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33511258> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33511258_6> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33511258_6" ;
    gutprop:hasSentenceText "The gut microbiomes of the placebo group at weeks 0 and 12 showed a significantly greater Aitchison distance (<i>P</i> < 0.001) compared with the probiotic group." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33511258> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33514545_5> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33514545_5" ;
    gutprop:hasSentenceText "We demonstrate this approach using a patient-derived cerebral MPS carrying the PD-causing A53T mutation, gaining two important findings: (i) that systemic interaction enhances features of in vivo-like behavior of cerebral MPSs, and (ii) that microbiome-associated short-chain fatty acids increase expression of pathology-associated pathways in PD." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33514545> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33651324_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33651324_0" ;
    gutprop:hasSentenceText "Gut microbiota dysbiosis is associated with worse emotional states in HIV infection." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/33651324> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33651324_1> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33651324_1" ;
    gutprop:hasSentenceText "The biological mechanisms underlying emotional distress in HIV infection are likely to be complex but remain understudied." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33651324> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33651324_4> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33651324_4" ;
    gutprop:hasSentenceText "A subset of participants (32 PLWH vs. 13 HIV-) underwent an emotional assessment using the NIH Toolbox Emotion Battery summarized by three composite scores (negative affect, social satisfaction, and psychological well-being)." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33651324> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33651324_6> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33651324_6" ;
    gutprop:hasSentenceText "The gut microbiota profiles were evaluated in relation to participants' emotional assessment." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33651324> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33651324_8> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33651324_8" ;
    gutprop:hasSentenceText "We found that the relative abundance of aerotolerant bacteria was significantly higher in PLWH (p < 0.01) and was associated with a lifetime major depression diagnosis independently of HIV status (p = 0.05)." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33651324> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33664475_12> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33664475_12" ;
    gutprop:hasSentenceText "Our data suggest that 6'SL in maternal milk adjusts cognitive development through a short-term upregulation of genes modulating neuronal patterning in the PFC." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33664475> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33664475_9> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33664475_9" ;
    gutprop:hasSentenceText "To investigate the underlying molecular mechanisms, we assessed gene expression (at eye-opening and in adulthood) in two brain regions mediating executive functions and memory (hippocampus and prefrontal cortex, PFC)." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33664475> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33677218_10> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33677218_10" ;
    gutprop:hasSentenceText "The anti-depression effects of fecal microbiota transplantation were associated with the suppressed activation of glial cells and NLRP3 inflammasome in the brain." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33677218> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33677218_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33677218_2" ;
    gutprop:hasSentenceText "Considering the putative connection among gut microbiota, neural function, and behavior, the present study investigated the potential signaling of gut microbiota to modulate depression-like behaviors and neuroinflammation." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33677218> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33692356_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33692356_0" ;
    gutprop:hasSentenceText "Meta-analysis of the Parkinson's disease gut microbiome suggests alterations linked to intestinal inflammation." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/33692356> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33692356_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33692356_2" ;
    gutprop:hasSentenceText "PD is often preceded by gastrointestinal symptoms and alterations of the enteric nervous system accompany the disease." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33692356> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33692356_3> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33692356_3" ;
    gutprop:hasSentenceText "Several studies have analyzed the gut microbiome in PD, but a consensus on the features of the PD-specific microbiota is missing." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33692356> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33692356_4> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33692356_4" ;
    gutprop:hasSentenceText "Here, we conduct a meta-analysis re-analyzing the ten currently available 16S microbiome datasets to investigate whether common alterations in the gut microbiota of PD patients exist across cohorts." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33692356> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33692356_5> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33692356_5" ;
    gutprop:hasSentenceText "We found significant alterations in the PD-associated microbiome, which are robust to study-specific technical heterogeneities, although differences in microbiome structure between PD and controls are small." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33692356> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33713734_11> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33713734_11" ;
    gutprop:hasSentenceText "If our observations are validated in future independent studies, they support the notion that parts of aberrant gut microbiota are shared by AD and states of dysmetabolism." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33713734> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33713734_4> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33713734_4" ;
    gutprop:hasSentenceText "Results The pattern of higher prevalence of Flavonifractor and lower Centered Log-Ratio (CLR) abundance of Christensenellaceae was associated with AD." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33713734> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33722869_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33722869_0" ;
    gutprop:hasSentenceText "Bugs and Brains, the Gut and Mental Health Study: a mixed-methods study investigating microbiota composition and function in anxiety, depression and irritable bowel syndrome." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/33722869> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33777957_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33777957_0" ;
    gutprop:hasSentenceText "Brain Neurotransmitter Modulation by Gut Microbiota in Anxiety and Depression." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/33777957> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33777957_1> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33777957_1" ;
    gutprop:hasSentenceText "Anxiety and depression are highly prevalent mental illnesses worldwide and have long been thought to be closely associated to neurotransmitter modulation." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33777957> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33777957_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33777957_2" ;
    gutprop:hasSentenceText "There is growing evidence indicating that changes in the composition of the gut microbiota are related to mental health including anxiety and depression." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33777957> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33777957_4> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33777957_4" ;
    gutprop:hasSentenceText "Therefore, we reviewed studies conducted on germ-free rodents, or in animals subjected to microbiota absence using antibiotics, as well as via the usage of probiotics." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33777957> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33777957_6> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33777957_6" ;
    gutprop:hasSentenceText "However, a lot of work is needed to determine how gut microbiota mediated neurotransmission in human brain has any physiological significance and, if any, how it can be used in therapy." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33777957> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33782648_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33782648_0" ;
    gutprop:hasSentenceText "Preventing and Treating Neurological Disorders with the Flavonol Fisetin." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/33782648> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33782648_1> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33782648_1" ;
    gutprop:hasSentenceText "Neurological disorders, including neurodegenerative diseases, have a significant negative impact on both patients and society at large." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33782648> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33782648_10> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33782648_10" ;
    gutprop:hasSentenceText "Therefore, the growing body of pre-clinical data, along with fisetin's ability to modulate a large number of pathways associated with brain dysfunction, strongly suggest that it would be worthwhile to pursue its therapeutic effects in humans." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33782648> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33807447_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33807447_0" ;
    gutprop:hasSentenceText "Changes in Gut Microbiota after a Four-Week Intervention with Vegan vs. Meat-Rich Diets in Healthy Participants: A Randomized Controlled Trial." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/33807447> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33807447_10> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33807447_10" ;
    gutprop:hasSentenceText "Importantly, changes in genera <i>Coprococcus, Roseburia</i> and <i>Faecalibacterium</i> should be subjected to intense investigation as markers for physical and mental health." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33807447> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33807447_7> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33807447_7" ;
    gutprop:hasSentenceText "Overall, the gut microbiota was not remarkably altered between VD and MD after the trial." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33807447> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33807447_8> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33807447_8" ;
    gutprop:hasSentenceText "<i>Coprococcus</i> was found to be increased in VD while being decreased in MD." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33807447> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33819374_5> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33819374_5" ;
    gutprop:hasSentenceText "TMA activates guanylyl cyclase DAF-11 signaling through TYRA-3 in amphid neurons (ASK) and ciliated neurons (BAG) to mediate food-sensing behavior." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33819374> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33819374_6> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33819374_6" ;
    gutprop:hasSentenceText "Bacterial mutants deficient in TMA production enhance dauer formation, extend lifespan, and are less preferred as a food source." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33819374> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33819374_7> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33819374_7" ;
    gutprop:hasSentenceText "Increased levels of TMA lead to neural damage in models of Parkinson's disease and shorten lifespan." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33819374> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33825149_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33825149_0" ;
    gutprop:hasSentenceText "Gut Microbial Metabolites in Parkinson's Disease: Implications of Mitochondrial Dysfunction in the Pathogenesis and Treatment." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/33825149> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33825149_6> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33825149_6" ;
    gutprop:hasSentenceText "The intervention of gut microbial metabolites via the microbiota-gut-brain axis may serve as a promising therapeutic strategy for PD." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33825149> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33825149_7> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33825149_7" ;
    gutprop:hasSentenceText "In this narrative review, we summarize the potential roles of gut microbial dysbiosis in PD, with emphasis on microbial metabolites and mitochondrial function." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33825149> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33860090_1> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33860090_1" ;
    gutprop:hasSentenceText "The gut-brain axis is a hot topic in Parkinson's disease (PD)." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33860090> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33860090_10> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33860090_10" ;
    gutprop:hasSentenceText "Further targeted animal and human studies are also warranted to understand the mechanisms of actions of probiotics in PD and to tailor probiotic therapy based on individual host profiles to improve patient outcomes in this disabling disorder." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33860090> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33860090_7> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33860090_7" ;
    gutprop:hasSentenceText "Interestingly, several PD animal model studies have demonstrated the potential neuroprotective effects of probiotics in reducing dopaminergic neuronal degeneration." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33860090> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33860090_8> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33860090_8" ;
    gutprop:hasSentenceText "Notably, two randomized placebo-controlled trials have provided class I evidence for probiotics as a treatment for constipation in PD." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33860090> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33895287_11> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33895287_11" ;
    gutprop:hasSentenceText "Taken together, these data provide further evidence that the gut microbiota likely contributes to the development of chemotherapy-associated side effects." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33895287> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33899052_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33899052_2" ;
    gutprop:hasSentenceText "Chronic constipation frequently manifests prior to motor symptoms and impairs quality of life." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33899052> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33899052_5> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33899052_5" ;
    gutprop:hasSentenceText "Severity of PD was rated with the Movement Disorders Society-Unified PD rating scale (UPDRS) in six subjects with constipation." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33899052> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33936013_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33936013_0" ;
    gutprop:hasSentenceText "GABA Production by Human Intestinal <i>Bacteroides</i> spp." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/33936013> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33936013_11> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33936013_11" ;
    gutprop:hasSentenceText "Altogether, our results suggest an important contribution of <i>Bacteroides</i> in the regulation of the GABAergic system in the human gut." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33936013> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33963281_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33963281_2" ;
    gutprop:hasSentenceText "Emerging evidence suggests that gut microbiota plays a critical role in the pathogenesis and development of inflammatory and psychiatric diseases, possibly via gut microbiota-brain interactions and neuroinflammation." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33963281> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33963284_1> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33963284_1" ;
    gutprop:hasSentenceText "The discovery of robust antidepressant actions exerted by the N-methyl-D-aspartate receptor (NMDAR) antagonist (R,S)-ketamine has been a crucial breakthrough in mood disorder research." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33963284> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33963284_3> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33963284_3" ;
    gutprop:hasSentenceText "In 2019, an esketamine nasal spray from Johnson & Johnson was approved in the United States of America and Europe for treatment-resistant depression." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33963284> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33963284_6> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33963284_6" ;
    gutprop:hasSentenceText "Thus, the rodent data do not necessarily translate to humans due to the complexity of human psychiatric disorders." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33963284> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33963284_9> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33963284_9" ;
    gutprop:hasSentenceText "Furthermore, we discuss the possible role of the brain-gut-microbiota axis and brain-spleen axis in stress-related psychiatric disorders and in the antidepressant-like action of arketamine." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33963284> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33967849_12> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33967849_12" ;
    gutprop:hasSentenceText "There is a lack of RCT evidence supporting prebiotics and synbiotics supplementation for similar purposes in the perinatal period." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33967849> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33967849_6> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33967849_6" ;
    gutprop:hasSentenceText "<b>Results:</b> From 3,868 studies identified through the search strategy, three RCTs of low risk of bias involving 713 participants were included, all three testing probiotics." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33967849> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33968794_1> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33968794_1" ;
    gutprop:hasSentenceText "Several studies have highlighted the roles played by the gut microbiome in central nervous system diseases." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33968794> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33968794_5> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33968794_5" ;
    gutprop:hasSentenceText "We conclude that there are intestinal dysbiosis in Parkinson's disease." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33968794> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34002020_8> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34002020_8" ;
    gutprop:hasSentenceText "We therefore expected that either reduced serum PEA or increased stool PEA would mediate the association between microbial diversity and anhedonia amotivation." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34002020> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34004259_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34004259_0" ;
    gutprop:hasSentenceText "Abnormalities in the composition of the gut microbiota in mice after repeated administration of DREADD ligands." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/34004259> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34004259_10> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34004259_10" ;
    gutprop:hasSentenceText "Therefore, abnormalities in the composition of gut microbiota by repeated dosing of DREADD ligands should be taken into consideration for behavioral and biological functions in rodents treated with DREADD ligands." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34004259> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34014031_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34014031_0" ;
    gutprop:hasSentenceText "Impaired blood-brain barrier in the microbiota-gut-brain axis: Potential role of bipolar susceptibility gene TRANK1." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/34014031> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34014031_1> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34014031_1" ;
    gutprop:hasSentenceText "Bipolar disorder (BD) is a common psychiatric illness with high prevalence and disease burden." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34014031> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34014031_6> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34014031_6" ;
    gutprop:hasSentenceText "BD individuals showed altered diversity and compositions in the commensal microbiota." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34014031> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34014031_7> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34014031_7" ;
    gutprop:hasSentenceText "In addition to pro-inflammatory factors, such as interleukin-6 and tumour necrosis factor-α, type 1 interferon signalling pathway is also modulated by specific intestinal bacterial strains." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34014031> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34014031_8> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34014031_8" ;
    gutprop:hasSentenceText "Disruption of the microbiota-gut-brain axis contributes to peripheral and central nervous system inflammation, which accounts for the BD aetiology." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34014031> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34032650_5> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34032650_5" ;
    gutprop:hasSentenceText "This observation has been replicated in patients with major depression who show decreased microbial diversity." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34032650> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34074025_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34074025_2" ;
    gutprop:hasSentenceText "Dysfunction of MAIT cells and dysbiosis occur in common chronic diseases of inflammatory, metabolic, and tumor nature." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34074025> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34074025_6> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34074025_6" ;
    gutprop:hasSentenceText "In multiple sclerosis and other autoimmune conditions, several studies have been done, or are in progress, to find correlations between intestinal permeability, dysbiosis, MAIT cell responses, and clinical biomarkers in treated and treatment-naïve patients." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34074025> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34098340_1> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34098340_1" ;
    gutprop:hasSentenceText "Murine studies demonstrate that maternal prenatal gut microbiota influences brain development and behaviour of offspring." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34098340> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34098340_11> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34098340_11" ;
    gutprop:hasSentenceText "These findings support animal studies showing that the composition of maternal prenatal gut microbiota is related to offspring brain development and behaviour." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34098340> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34098340_8> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34098340_8" ;
    gutprop:hasSentenceText "We found evidence that the alpha diversity of the maternal faecal microbiota during the third trimester of pregnancy predicts child internalising behaviour at two years of age (-2·74, (-4·71, -0·78), p = 0·01 (Wald test), R<sup>2</sup>=0·07)." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34098340> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34172092_1> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34172092_1" ;
    gutprop:hasSentenceText "Modification of the gut microbiota has been reported to reduce the incidence of type 1 diabetes mellitus (T1D)." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34172092> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34172092_7> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34172092_7" ;
    gutprop:hasSentenceText "Our results demonstrate the protective role of microbiota metabolite acetate in cognitive functions and suggest long-term acetate deficiency as a risk factor of cognitive decline." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34172092> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34174901_10> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34174901_10" ;
    gutprop:hasSentenceText "Furthermore, although minocycline attenuated spinal cord injury-induced microglial activation, it did not affect the lesion size or promote measurable motor recovery." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34174901> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34174901_11> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34174901_11" ;
    gutprop:hasSentenceText "We show that minocycline's microbiota effects precede its long-term effects on systemic cytokines and chemokines following spinal cord injury." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34174901> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34174901_6> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34174901_6" ;
    gutprop:hasSentenceText "Plasma levels of cytokines/chemokines and fecal microbiota composition (using 16s rRNA sequencing) were monitored for 4 weeks following spinal cord injury as measures of the microbiota-immune axis." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34174901> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34205336_3> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34205336_3" ;
    gutprop:hasSentenceText "However, it is not well understood how the gut microbiome and neurons in the brain mutually interact or how these interactions affect normal brain functioning and cognition." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34205336> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34216356_7> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34216356_7" ;
    gutprop:hasSentenceText "This article summarizes the known interactions between the gut microbiome and neurodegenerative diseases, highlighting assay techniques for the gut microbiome, and we also discuss the potential therapeutic role of microbiome-based therapies in diseases." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34216356> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34250955_3> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34250955_3" ;
    gutprop:hasSentenceText "Emerging to the forefront, an interesting concept has developed suggesting that the initial pathophysiological changes occur in the gastrointestinal tract before changes are seen within the brain." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34250955> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34250955_5> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34250955_5" ;
    gutprop:hasSentenceText "Firstly, we will focus on the gastrointestinal conditions and symptoms which commonly affects patients, including both upper and lower gastrointestinal issues." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34250955> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34250955_6> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34250955_6" ;
    gutprop:hasSentenceText "Secondly, the impact of nutrition and diet on neurological health and PD physiology, with particular emphasis on commonly consumed items including macronutrients and micronutrients." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34250955> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34250955_7> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34250955_7" ;
    gutprop:hasSentenceText "Finally, variability of the gut microbiome will also be discussed and its link with both the symptoms and signs of PD." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34250955> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34250955_8> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34250955_8" ;
    gutprop:hasSentenceText "The evidence presented in this review highly suggests that the initial pathogenesis in the gut may proceed the development of prodromal PD subtypes, and therefore building on this further could be imperative and lead to earlier diagnosis with new and improved therapeutics." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34250955> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34290352_6> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34290352_6" ;
    gutprop:hasSentenceText "The differences of gut microbiota between patients and controls, the characteristics of gut microbiota under treatment and the potential differences in metabolic functions were thus investigated." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34290352> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34290352_9> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34290352_9" ;
    gutprop:hasSentenceText "The beta diversity of some patients resembled participants in the control group." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34290352> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34311029_3> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34311029_3" ;
    gutprop:hasSentenceText "A major accompanying pathological symptom of these conditions is cognitive impairment, which is linked with changes in lipid metabolism." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34311029> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34311029_4> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34311029_4" ;
    gutprop:hasSentenceText "Thus, nutraceuticals that affect brain lipid metabolism or lipid levels as a whole have the potential to ameliorate cognitive decline." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34311029> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34357134_4> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34357134_4" ;
    gutprop:hasSentenceText "Participants in the cross-sectional observational study will be 140 patients with schizophrenia recruited from three Japanese facilities and 70 healthy individuals." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34357134> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34357554_8> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34357554_8" ;
    gutprop:hasSentenceText "We have critically summarised the clinical and preclinical reports from the past a decade emphasising that the significant changes in gut microbiota can enhance the host susceptibility towards neurodegenerative disorders." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34357554> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34393849_10> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34393849_10" ;
    gutprop:hasSentenceText "Moreover, abundance of <i>Haemophilus</i> was positively correlated with cognition (<i>r</i> = 0.428, <i>P</i> = 0.009), excitement (<i>r</i> = 0.266, <i>P</i> = 0.037), and depression (<i>r</i> = 0.295, <i>P</i> = 0.020)." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34393849> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34393849_3> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34393849_3" ;
    gutprop:hasSentenceText "Therefore, this study aimed to investigate gut microbiota dysbiosis and its relationship with psychopathologies in schizophrenia." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34393849> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34393849_9> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34393849_9" ;
    gutprop:hasSentenceText "Furthermore, Pearson's correlation analysis revealed that abundance of <i>Haemophilu</i>s was positively correlated with negative psychiatric symptoms (<i>r</i> = 0.303, <i>P</i> = 0.021), while abundance of <i>Coprococcus</i> was negatively correlated with negative psychiatric symptoms (<i>r</i> = -<i>0.285, P</i> = <i>0.025</i>)." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34393849> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34399524_4> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34399524_4" ;
    gutprop:hasSentenceText "We assessed accumulation of AGEs in plasma, kidney, and liver and measured inflammatory markers and gut microbial composition." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34399524> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34422393_5> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34422393_5" ;
    gutprop:hasSentenceText "Gastric and esophageal cancer, for example, continue to remain as two of the most common causes of cancer-related deaths worldwide, therefore there is an increased emphasis on investigating the role of dysbiosis on these cancers." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34422393> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34422879_1> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34422879_1" ;
    gutprop:hasSentenceText "Healthcare systems worldwide are seriously challenged by a rising prevalence of neurodegenerative diseases (NDDs), which mostly, but not exclusively, affect the ever-growing population of the elderly." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34422879> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34437440_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34437440_2" ;
    gutprop:hasSentenceText "An emerging aspect is that microbial dysbiosis and chronic infections triggered by certain bacteria can be risk factors for tumor progression." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34437440> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34444820_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34444820_0" ;
    gutprop:hasSentenceText "Effects of Probiotic NVP-1704 on Mental Health and Sleep in Healthy Adults: An 8-Week Randomized, Double-Blind, Placebo-Controlled Trial." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/34444820> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34448737_1> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34448737_1" ;
    gutprop:hasSentenceText "Burgeoning body of evidence from neuroscience is pouring in highlighting a potential association between gut microbiota with the pathophysiology of depression and anxiety." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34448737> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34480631_10> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34480631_10" ;
    gutprop:hasSentenceText "Therefore, abnormalities in the composition of gut microbiota after repeated treatment of PLX5622 should be considered for behavioral and biological functions in animals treated with CSF1R inhibitors." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34480631> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34480631_4> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34480631_4" ;
    gutprop:hasSentenceText "There was a significant alteration in the β-diversity of intestine microbiota in the PLX5622-treated group." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34480631> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34480631_5> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34480631_5" ;
    gutprop:hasSentenceText "Linear discriminant analysis effect size identified eight significant enriched bacteria as microbial markers for PLX5622-treated group." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34480631> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34480631_7> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34480631_7" ;
    gutprop:hasSentenceText "Furthermore, repeated administration of PLX5622 caused a significant change in lactic acid compared to control group." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34480631> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34520319_7> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34520319_7" ;
    gutprop:hasSentenceText "Finally, we discuss the possible interactions between SCRD and GM in AD pathogenesis, as well as several methodological improvements that are necessary for future research." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34520319> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34560239_5> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34560239_5" ;
    gutprop:hasSentenceText "MPTP caused abnormalities in the α- and β-diversity of gut microbiota in the mice." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34560239> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34560239_7> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34560239_7" ;
    gutprop:hasSentenceText "Interestingly, there was a positive correlation between the genus Faecalicatena and the expression of TH in the striatum." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34560239> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34576000_8> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34576000_8" ;
    gutprop:hasSentenceText "As such, the human nuclear and mitochondrial genome, epigenome, and the host gut microbiome might be the key elements to the rise of personalized medicine for PD patients." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34576000> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34576833_3> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34576833_3" ;
    gutprop:hasSentenceText "This is in contrast to the standard psychiatric evaluation of patients, which includes symptoms that are subjectively assessed (i.e., mood, anxiety level, perception, thought disorders, etc.)." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34576833> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34589800_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34589800_0" ;
    gutprop:hasSentenceText "Beyond the neuro-immune interplay in depression: Could gut microbes be the missing link?" ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/34589800> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34589852_1> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34589852_1" ;
    gutprop:hasSentenceText "Current treatment for schizophrenia-spectrum disorders focusses primarily on psychotropic medication to treat symptoms, though their efficacy varies between patients and psychotropic medication is often accompanied by severe side effects." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34589852> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34589852_4> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34589852_4" ;
    gutprop:hasSentenceText "Pathways currently in focus include: i) nutritional deficits and impairments in glucose metabolism, ii) inflammation and immune dysregulation (also known from the mild encephalitis hypothesis), and iii) altered gut microbiota." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34589852> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34603341_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34603341_0" ;
    gutprop:hasSentenceText "Consumption of Butylated Starch Alleviates the Chronic Restraint Stress-Induced Neurobehavioral and Gut Barrier Deficits Through Reshaping the Gut Microbiota." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/34603341> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34603341_1> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34603341_1" ;
    gutprop:hasSentenceText "The beneficial effect of short-chain fatty acids (SCFAs) on host health has been well recognized based on the booming knowledge from gut microbiome research." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34603341> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34603341_3> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34603341_3" ;
    gutprop:hasSentenceText "In this study, the SCFA-acylated starches were used to accomplish a sizeable intestine-targeted release of the SCFAs, and the neurobehavioral, immunological, and microbial effects were further investigated." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34603341> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34603341_4> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34603341_4" ;
    gutprop:hasSentenceText "Acetylated-, butylated-, and isobutylated-starch could attenuate the depression-like behaviors and excessive corticosterone production in chronically stressed mice." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34603341> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34704023_16> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34704023_16" ;
    gutprop:hasSentenceText "Our study has demonstrated that unlike in other gastro-intestinal, immune and metabolic disorders, loss of bacterial diversity is not associated with Parkinson's disease and multiple sclerosis." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34704023> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34704023_5> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34704023_5" ;
    gutprop:hasSentenceText "We used these recently described richness and evenness composite measures to investigate the potential link between gut microbiome alpha-diversity and neurological disorders and to determine to what extent it could be used as a marker to diagnose neurological disorders from stool samples." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34704023> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34704023_8> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34704023_8" ;
    gutprop:hasSentenceText "For each disease, we performed a meta-analysis comparing the indices between patients and healthy controls." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34704023> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34758889_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34758889_0" ;
    gutprop:hasSentenceText "A fiber-deprived diet causes cognitive impairment and hippocampal microglia-mediated synaptic loss through the gut microbiota and metabolites." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/34758889> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34758889_10> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34758889_10" ;
    gutprop:hasSentenceText "Of note, a rapid differentiating microbiota change was observed in the mice with a short-term FD diet (7 days) before cognitive impairment, highlighting a possible causal impact of the gut microbiota profile on cognitive outcomes." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34758889> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34776854_1> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34776854_1" ;
    gutprop:hasSentenceText "<b>Background:</b> There has been increasing recognition of the importance of the gut microbiome in Parkinson's disease (PD), but the influence of geographic location has received little attention." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34776854> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34776854_8> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34776854_8" ;
    gutprop:hasSentenceText "Within the PD cohort, there was no association identified between microbial composition and gender, constipation or use of gastrointestinal medication." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34776854> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34830610_4> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34830610_4" ;
    gutprop:hasSentenceText "Only a few studies have investigated the gut microbiome in the context of Prader-Willi syndrome and assessed the efficacy of probiotic supplementation as a therapeutic strategy for this disease." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34830610> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34830610_6> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34830610_6" ;
    gutprop:hasSentenceText "The limited evidence available indicate that probiotic supplementation improves some metabolic and mental health aspects, however further studies are warranted to determine whether targeting the gut microbiome may constitute a safe and efficient strategy to treat individuals with Prader-Willi syndrome." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34830610> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34870091_4> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34870091_4" ;
    gutprop:hasSentenceText "There is relatively little research on the predicted or actual functional alterations associated with the composition of oral and gut microbiota in patients with psychosis." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34870091> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34970638_1> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34970638_1" ;
    gutprop:hasSentenceText "Although the link between gut microbiota and depression has been suggested, changes of gut microbiota vary largely among individuals with depression." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34970638> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34970638_5> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34970638_5" ;
    gutprop:hasSentenceText "Mice in the CUMS group were exposed to stressors." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34970638> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34985325_1> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34985325_1" ;
    gutprop:hasSentenceText "The human body is full of an extensive number of commensal microbes, consisting of bacteria, viruses, and fungi, collectively termed the human microbiome." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34985325> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34985325_3> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34985325_3" ;
    gutprop:hasSentenceText "These microbial communities play a central role in the maturation and development of the immune system, the central nervous system, and the GIT system and are also responsible for essential metabolic pathways." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34985325> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34985325_5> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34985325_5" ;
    gutprop:hasSentenceText "Recent publications have highlighted that an imbalance in the gut microflora, known as dysbiosis, is associated with the onset and progression of neurological disorders." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34985325> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34985325_8> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34985325_8" ;
    gutprop:hasSentenceText "This review aims to present a comprehensive overview of the potential involvement of the human gut microbiome in the pathogenesis of neurological disorders, with a particular emphasis on the potential of microbe-based therapies and/or diagnostic microbial biomarkers." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34985325> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34988495_3> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34988495_3" ;
    gutprop:hasSentenceText "In this publication, we describe exposures, health conditions, and medication use of Veterans in the US Veteran Microbiome Project (US-VMP) and examine the associations between these characteristics and the gut microbiota." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34988495> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34988495_4> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34988495_4" ;
    gutprop:hasSentenceText "This cohort included 331 US Veterans seeking healthcare with the Veterans Health Administration who were 83% male with an average (±SD) age of 47.6 ​± ​13.4 years." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34988495> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34988495_5> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34988495_5" ;
    gutprop:hasSentenceText "The cohort displayed a high prevalence of PTSD (49.8%) and history of traumatic brain injuries (76.1%), and high current use of prescription medications (74.9%) to treat various acute and chronic conditions." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34988495> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35069178_7> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_35069178_7" ;
    gutprop:hasSentenceText "We will discuss the role of α-synuclein in non-motor disease pathology, proposed pathways constituting the connection between the gut microbiome and the brain, existing evidence related to pre- and probiotic interventions." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35069178> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35083314_4> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_35083314_4" ;
    gutprop:hasSentenceText "In this paper (Leite <i>et al.</i> (2021), Cell Reports, doi: 10.1016/j.celrep.2021.109765), we demonstrate significant differences in the small intestinal microbiome in older subjects, using duodenal aspirates from 251 subjects aged 18-80 years." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35083314> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35203906_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_35203906_2" ;
    gutprop:hasSentenceText "Since etiology of PD is not completely understood, various studies suggest different potential links between coronavirus disease 2019 (COVID-19) and PD." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35203906> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35207632_8> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_35207632_8" ;
    gutprop:hasSentenceText "This review focuses on common PD-related GI symptoms, and summarizes the current treatments available and their limitations." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35207632> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35281490_11> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_35281490_11" ;
    gutprop:hasSentenceText "Continued biomedical advances in understanding the microbiota-gut-brain axis will extend the frontier of neurodegenerative disorders and enable the utilization of novel diagnostic and therapeutic strategies to mitigate the pathological burden of these diseases." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35281490> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35281490_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_35281490_2" ;
    gutprop:hasSentenceText "Beginning as early as <i>in utero</i> fetal development and continuing through birth to late-stage adulthood, the crosstalk between the gut microbiome and brain is essential for modulating various metabolic, neurodevelopmental, and immune-related pathways." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35281490> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35281490_6> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_35281490_6" ;
    gutprop:hasSentenceText "Studies have identified potential mediators that link gut dysbiosis and neurological disorders." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35281490> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35317228_7> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_35317228_7" ;
    gutprop:hasSentenceText "The accurate translation of the microbiome information to brain disorder could promote better understanding of neuronal diseases and aid in finding alternative and novel therapies." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35317228> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35326429_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_35326429_0" ;
    gutprop:hasSentenceText "Hydrogen Sulfide Produced by Gut Bacteria May Induce Parkinson's Disease." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/35326429> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35326429_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_35326429_2" ;
    gutprop:hasSentenceText "Study evidence favors the view that the microbiome of the colon harbors increased amounts of H<sub>2</sub>S producing bacteria in Parkinson's disease." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35326429> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35326429_4> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_35326429_4" ;
    gutprop:hasSentenceText "In the cells, excessive amounts of H<sub>2</sub>S can potentially release cytochrome c protein from the mitochondria, increase the iron content of the cytosolic iron pool, and increase the amount of reactive oxygen species." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35326429> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35326429_8> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_35326429_8" ;
    gutprop:hasSentenceText "Special attention should be devoted to changes not only in the colonic but also in the duodenal microbiome composition with regard to the pathogenesis of Parkinson's disease." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35326429> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35327401_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_35327401_0" ;
    gutprop:hasSentenceText "<i>Drosophila</i> Model for Studying Gut Microbiota in Behaviors and Neurodegenerative Diseases." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/35327401> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35327401_1> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_35327401_1" ;
    gutprop:hasSentenceText "Mounting evidence indicates that the gut microbiota is linked to several physiological processes and disease development in mammals; however, the underlying mechanisms remained unexplored mostly due to the complexity of the mammalian gut microbiome." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35327401> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35327401_5> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_35327401_5" ;
    gutprop:hasSentenceText "This review comprehensively summarizes the current understanding of the gut microbiota of <i>Drosophila</i> and its impact on fly behavior, physiology, and neurodegenerative diseases." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35327401> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35432226_1> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_35432226_1" ;
    gutprop:hasSentenceText "There is continued debate regarding Parkinson's disease etiology and whether it originates in the brain or begins in the gut." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35432226> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35432226_3> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_35432226_3" ;
    gutprop:hasSentenceText "Most research indicates those with Parkinson's disease have an altered gut microbiome compared to controls." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35432226> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35432226_4> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_35432226_4" ;
    gutprop:hasSentenceText "However, some studies do not report gut microbiome differences, potentially due to the brain or body-first progression type." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35432226> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35571084_3> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_35571084_3" ;
    gutprop:hasSentenceText "In this review, we highlight the advantages of using <i>Caenorhabditis elegans</i> (C. elegans) to disentangle the microbe-host interaction that regulates neurodegeneration." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35571084> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35571084_8> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_35571084_8" ;
    gutprop:hasSentenceText "Because bacterial amyloid fibrils contribute to biofilm formation, inhibition of amyloid production often leads to the disruption of biofilms." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35571084> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35654142_1> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_35654142_1" ;
    gutprop:hasSentenceText "The gut microbiome has been shown to have key implications in the pathogenesis of Parkinson's disease (PD)." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35654142> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35654142_5> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_35654142_5" ;
    gutprop:hasSentenceText "Furthermore, we identify and characterize new CsgA homologs encoded by bacteria present in the human microbiome." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35654142> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35654142_7> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_35654142_7" ;
    gutprop:hasSentenceText "Remarkably, we demonstrate that slowing down CsgA aggregation leads to an increased acceleration of α-synuclein aggregation, suggesting that the intrinsic amyloidogenicity of gut bacterial CsgA homologs affects their ability to accelerate α-synuclein aggregation." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35654142> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35674870_10> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_35674870_10" ;
    gutprop:hasSentenceText "Finally, we will comment on the potential clinical translatability of immunobiomarkers identified in PD patient cohorts and provide an update on current therapeutic strategies aimed at overcoming or preventing inflammation in PD." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35674870> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35674870_3> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_35674870_3" ;
    gutprop:hasSentenceText "The discovery of inherited gene mutations in PD has allowed researchers to develop cellular and animal models to study the mechanisms of the underlying biology, but the original cause of neuroinflammation in PD is still debated to date." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35674870> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35674870_4> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_35674870_4" ;
    gutprop:hasSentenceText "Cell autonomous alterations in neuronal cells, including mitochondrial damage and protein aggregation, could play a role, but recent findings also highlighted the importance of intercellular communication at both local and systemic level." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35674870> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35674870_7> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_35674870_7" ;
    gutprop:hasSentenceText "In this review, we will provide an up-to-date summary of the main cellular alterations underlying neuroinflammation in PD, including those induced by environmental factors (e.g." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35674870> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35722294_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_35722294_0" ;
    gutprop:hasSentenceText "Integrated Microbiome and Host Transcriptome Profiles Link Parkinson's Disease to <i>Blautia</i> Genus: Evidence From Feces, Blood, and Brain." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/35722294> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35722294_1> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_35722294_1" ;
    gutprop:hasSentenceText "A link between the gut microbiome and Parkinson's disease (PD) has been intensively studied, and more than 100 differential genera were identified across the studies." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35722294> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35798742_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_35798742_0" ;
    gutprop:hasSentenceText "Oral and gut dysbiosis leads to functional alterations in Parkinson's disease." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/35798742> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35798742_6> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_35798742_6" ;
    gutprop:hasSentenceText "We identified a connection between the oral and gut microbiota in PD, which might lead to functional alteration of the microbiome in PD." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35798742> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35965349_3> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_35965349_3" ;
    gutprop:hasSentenceText "AGPs are thought to operate through modulating the gut microbiome to limit opportunities for colonization by pathogens, increase nutrient utilization, and reduce inflammation." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35965349> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35965349_6> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_35965349_6" ;
    gutprop:hasSentenceText "In this study, we perform a systematic investigation of both the composition and function of the chicken gut microbiome, in response to AGPs." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35965349> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35965349_9> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_35965349_9" ;
    gutprop:hasSentenceText "Our study reveals a more nuanced view of the impact of AGPs, dependent on age of bird, diet, and intestinal site sampled." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35965349> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36056574_10> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_36056574_10" ;
    gutprop:hasSentenceText "Those with depressive symptoms showed a higher abundance of <i>Actinobacteria,</i> while those without depressive symptoms had a higher abundance of <i>Bacteroidetes</i>." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36056574> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36056574_12> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_36056574_12" ;
    gutprop:hasSentenceText "Gut microbial diversity showed promising associations with depressive symptoms and sleep disturbance among Chinese and Korean immigrants." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36056574> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36056574_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_36056574_2" ;
    gutprop:hasSentenceText "The gut microbiota (GM) plays a critical role in mental health and sleep quality, and the composition of the GM is largely unknown among AsA." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36056574> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36056574_7> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_36056574_7" ;
    gutprop:hasSentenceText "Permutational multivariate analysis of variance and linear discriminant analysis effect size were applied to examine associations of the GM with symptoms." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36056574> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36056574_8> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_36056574_8" ;
    gutprop:hasSentenceText "Among 20 participants, 55% (<i>n</i> = 11) reported depressive symptoms and 35% (<i>n</i> = 7) reported sleep disturbance." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36056574> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36072564_5> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_36072564_5" ;
    gutprop:hasSentenceText "The identified metabolites with higher concentration in aged hosts, which include choline and trimethylamine, are known risk factors for age-related diseases." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36072564> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36072564_8> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_36072564_8" ;
    gutprop:hasSentenceText "In this review, we highlight the impact of age on the composition of the microbiome and microbiota-derived metabolites and their influence on age-associated diseases caused by dysfunctional brain-resident macrophages." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36072564> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36072680_3> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_36072680_3" ;
    gutprop:hasSentenceText "The structure and function of gut microbiota are affected by genetics and environmental factors, such as altered dietary habits, gastroenteritis, stress, increased use of alcohol and drugs, and medication use." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36072680> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36216056_9> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_36216056_9" ;
    gutprop:hasSentenceText "PM exposure significantly increased the relative abundance of Verrucomicrobia and decreased that of Fibrobacteres et al." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36216056> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36332796_10> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_36332796_10" ;
    gutprop:hasSentenceText "Key Scientific Concepts of Review: Alterations in the gut microbiome and associated metabolites may contribute to pathogenesis in PD." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36332796> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36332796_5> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_36332796_5" ;
    gutprop:hasSentenceText "of Review: In this review, we summarize how alterations in the gut microbiome can affect PD pathogenesis." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36332796> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36346385_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_36346385_0" ;
    gutprop:hasSentenceText "A prebiotic diet modulates microglial states and motor deficits in α-synuclein overexpressing mice." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/36346385> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36346385_5> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_36346385_5" ;
    gutprop:hasSentenceText "Among other effects, dietary microbial metabolites can modulate activation of microglia, brain-resident immune cells implicated in PD." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36346385> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36411639_5> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_36411639_5" ;
    gutprop:hasSentenceText "Vital communication between the gut microbes and the central nervous system is known as the microbiota-gut-brain axis." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36411639> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36411639_6> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_36411639_6" ;
    gutprop:hasSentenceText "It provides a communication pathway between the gut and brain which is made up of the vagus nerve, immune system components, and neuroendocrine." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36411639> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36493975_1> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_36493975_1" ;
    gutprop:hasSentenceText "Multiple sclerosis (MS) is the most common demyelinating disease that attacks the central nervous system." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36493975> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36517709_7> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_36517709_7" ;
    gutprop:hasSentenceText "PHP regulates lipid metabolism through the gut microbiota, and the gut-liver axis plays an important role in its hypolipidemic effects." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36517709> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36550591_12> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_36550591_12" ;
    gutprop:hasSentenceText "GLUCOSE1PMETAB-PWY and PWY-7328 of which biofunctions were dominantly encoded by Biffdobacterium were the top two of altered pathways." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36550591> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36550591_3> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_36550591_3" ;
    gutprop:hasSentenceText "Some of microbiota were transplanted into germ-free rats with the intragastric administration of XPJYF grain at the dose of 1.533 g/kg/day." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36550591> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36550591_5> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_36550591_5" ;
    gutprop:hasSentenceText "Products of hypothalamus-pituitary-adrenocortical (HPA) axis, neurotransmitter, and serum cytokines were investigated by enzyme linked immunosorbent assay." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36550591> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36550591_6> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_36550591_6" ;
    gutprop:hasSentenceText "Glial fibrillary acidic protein (GFAP), a biomarker of astrocyte, was quantified using immunofluorescence." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36550591> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36564391_5> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_36564391_5" ;
    gutprop:hasSentenceText "The results showed that the relative abundances of potential pro-inflammatory bacteria, genes and pathways were significantly increased in PD, while potential anti-inflammatory bacteria, genes and pathways were significantly decreased." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36564391> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36651663_12> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_36651663_12" ;
    gutprop:hasSentenceText "These findings will help lay the foundation for future studies to identify microbial role players in symptoms of anxiety, depression, and PTSD and provide future therapeutic targets to improve mental health outcomes." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36651663> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36651663_7> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_36651663_7" ;
    gutprop:hasSentenceText "In our cohort of N=198, 17.17% reported depressive symptoms, 37.37% state anxiety symptoms, 40.90% trait anxiety symptoms, and 8.08% PTSD symptoms, with high levels of comorbidity." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36651663> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36651663_8> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_36651663_8" ;
    gutprop:hasSentenceText "Individuals with trait anxiety had lower Simpson's diversity." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36651663> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36698474_9> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_36698474_9" ;
    gutprop:hasSentenceText "Following the increase in total calorie intake, alcohol intake, ratios of animal to vegetal foods, and poultry meat to pulses, the burdens of the above diseases continuously rose." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36698474> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36699448_3> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_36699448_3" ;
    gutprop:hasSentenceText "We reported the different gut microbiota characteristics between MDD and control groups in the Chinese group and further constructed the association between host genetics and the gut microbiome." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36699448> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36699448_8> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_36699448_8" ;
    gutprop:hasSentenceText "Furthermore, our findings suggested that the gut microbiome diversity might affect microRNA expression in the brain and influenced <i>SERPINA5</i> and other spatially close genes afterward." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36699448> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36699448_9> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_36699448_9" ;
    gutprop:hasSentenceText "These findings suggest new linkages between depression and gut microbiome in Asian, Chinese people, which might be mediated by genes and microRNA regulation in space distance." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36699448> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36707651_3> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_36707651_3" ;
    gutprop:hasSentenceText "Nowadays, gut microbiota is in the spotlight of new research related to this kind of psychiatric disorder, as it can be consistently related to several pathophysiological events observed in BD." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36707651> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36707651_4> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_36707651_4" ;
    gutprop:hasSentenceText "In the context of the so-called microbiota-gut-brain (MGB) axis, it is shown to have a strong influence on host neuromodulation and endocrine functions (i.e., controlling the synthesis of neurotransmitters like serotonin or mediating the activation of the hypothalamic-pituitary-adrenal axis), as well as in modulation of host immune responses, critically regulating intestinal, systemic and brain inflammation (neuroinflammation)." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36707651> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36738999_11> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_36738999_11" ;
    gutprop:hasSentenceText "The concentration of 5-HT increased in the hippocampus, meanwhile, the expression of 5-HT receptor HTR2A was distinct in different regions of the brain tissue." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36738999> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36757367_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_36757367_0" ;
    gutprop:hasSentenceText "Targeting the gut-microbiota-brain axis in irritable bowel disease to improve cognitive function - recent knowledge and emerging therapeutic opportunities." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/36757367> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36757367_1> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_36757367_1" ;
    gutprop:hasSentenceText "The brain-gut axis forms a bidirectional communication system between the gastrointestinal (GI) tract and cognitive brain areas." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36757367> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36757367_10> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_36757367_10" ;
    gutprop:hasSentenceText "This adds to the growing body of evidence supporting targeted therapeutic strategies to modulate the gut microbiota for the treatment of brain/mental-health-related disease." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36757367> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36757367_3> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_36757367_3" ;
    gutprop:hasSentenceText "The gut-microbiota-brain axis refers to the communication between gut-resident bacteria and the brain." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36757367> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36757367_8> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_36757367_8" ;
    gutprop:hasSentenceText "We discuss the contribution of gut microbiota to neuronal disorders and the tangible links between diseases of the GI tract with cognitive function and behaviour." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36757367> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36760344_16> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_36760344_16" ;
    gutprop:hasSentenceText "We confirmed that the gut microbiota composition differed between the monks and control subjects." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36760344> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36804535_1> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_36804535_1" ;
    gutprop:hasSentenceText "Patients with depression exhibit reduced bone mineral density (BMD)." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36804535> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36804535_9> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_36804535_9" ;
    gutprop:hasSentenceText "Therefore, arketamine could serve as a drug therapy for depressed patients with low BMD." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36804535> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36881806_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_36881806_0" ;
    gutprop:hasSentenceText "Brain, Gut, and Immune Interconnections in Psychiatric Disorders: Implications for Treatment." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/36881806> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36881806_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_36881806_2" ;
    gutprop:hasSentenceText "The purpose of the current article is to describe the associations between the gut microbiota and brain in psychiatric disorders." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36881806> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36900437_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_36900437_2" ;
    gutprop:hasSentenceText "Studies have reported that food fermentation with probiotics can enrich the nutritional values of food and produce functional microorganisms that can alleviate depression and anxiety." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36900437> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36900437_7> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_36900437_7" ;
    gutprop:hasSentenceText "FWG was prepared by fermenting wheat germs with <i>Lactobacillus plantarum</i>." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36900437> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36900437_9> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_36900437_9" ;
    gutprop:hasSentenceText "In addition, the study also analyzed the potential anti-depressive mechanism of FWG based on behavioral changes, physiological and biochemical index changes, and intestinal flora changes in depressed rats." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36900437> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36931666_1> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_36931666_1" ;
    gutprop:hasSentenceText "Recently, the improvement of chronic hyperglycaemia-related damage of type 2 diabetes mellitus (T2DM) through functional food consumption has attracted the attention of many clinicians." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36931666> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36931666_4> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_36931666_4" ;
    gutprop:hasSentenceText "The participants will be randomly assigned into two equal groups of intervention (n=24) and placebo (n=24) and receive 5 g/day of DSP or placebo for 8 weeks, respectively." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36931666> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36931666_5> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_36931666_5" ;
    gutprop:hasSentenceText "At baseline and post-intervention, fasting blood samples will be collected to assess the serum levels of lipid profile, glycaemic indices, antioxidant and oxidative stress, anti-/inflammatory biomarkers, lipopolysaccharide, 8-hydroxy-guanine, adipokines, hypothalamic-pituitary-adrenal axis biomarkers, immune system and mental health." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36931666> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36931666_8> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_36931666_8" ;
    gutprop:hasSentenceText "In this study, the potential effects of DSP on patients with T2DM will be evaluated for the first time." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36931666> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36938477_12> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_36938477_12" ;
    gutprop:hasSentenceText "Further research, including multicenter studies, is needed to assess the long-term efficacy and safety of probiotic supplements in neurodegenerative diseases." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36938477> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36938477_4> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_36938477_4" ;
    gutprop:hasSentenceText "Probiotics are often used to treat functional constipation." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36938477> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36938477_6> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_36938477_6" ;
    gutprop:hasSentenceText "To conduct this study, we searched Scopus, PubMed, and Google Scholar for published articles on PD, probiotics, and constipation." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36938477> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36978911_10> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_36978911_10" ;
    gutprop:hasSentenceText "Native flavonoids have many beneficial properties in the alleviation of inflammation in tissues, however, concerns have been raised that therapeutic levels of flavonoids may not be achieved, thus allowing them to display optimal therapeutic effects." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36978911> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36984505_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_36984505_0" ;
    gutprop:hasSentenceText "Controlling the Impact of <i>Helicobacter pylori</i>-Related Hyperhomocysteinemia on Neurodegeneration." ;
