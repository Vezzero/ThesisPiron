<https://w3id.org/hereditary/ontology/gutbrain/resource/food/AgeDiet> a owl:NamedIndividual,
        skos:Concept,
        gutprop:Food ;
    rdfs:label "Diet" ;
    dcterms:creator "Samuel Piron" ;
    rdfs:comment "Age-diet refers to the relationship between an individual's age and their dietary habits or nutritional intake. [Definition Source: llama3-8b-8192]" ;
    skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/Food> ;
    gutprop:containedIn <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/cd2eed25560cde2d> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/food/HighColesterolDiet> a owl:NamedIndividual,
        skos:Concept,
        gutprop:Food ;
    rdfs:label "High-Cholesterol Diet" ;
    dcterms:creator "Samuel Piron" ;
    rdfs:comment "A high-cholesterol diet is a dietary pattern characterized by regular consumption of foods rich in cholesterol, such as eggs, dairy products, and organ meats, which can increase blood cholesterol levels and potentially contribute to cardiovascular disease. [Definition Source: llama3-8b-8192]" ;
    skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/Food> ;
    gutprop:containedIn <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/9f6b4c9e81d62681>,
