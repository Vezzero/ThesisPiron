<https://uts.nlm.nih.gov/uts/umls/concept/C0017741> a owl:NamedIndividual,
        skos:Concept,
        gutprop:BiomedicalTechnique ;
    rdfs:label "Glucose Tolerance Test" ;
    rdfs:comment "A test to determine the ability of an individual to maintain HOMEOSTASIS of BLOOD GLUCOSE. It includes measuring blood glucose levels in a fasting state, and at prescribed intervals before and after oral glucose intake (75 or 100 g) or intravenous infusion (0.5 g/kg). [Definition Source: UMLS]",
        "UMLS Match" ;
    skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/BiomedicalTechnique> ;
    gutprop:containedIn <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/2b31e2e798b71744> .

<https://uts.nlm.nih.gov/uts/umls/concept/C0017787> a owl:NamedIndividual,
        skos:Concept,
        <https://w3id.org/brainteaser/ontology/schema/Gene> ;
    rdfs:label "Glutamate Synthase" ;
    rdfs:comment "An enzyme that catalyzes the formation of 2 molecules of glutamate from glutamine plus alpha-ketoglutarate in the presence of NADPH. EC 1.4.1.13. [Definition Source: UMLS]",
        "UMLS Match" ;
    skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/Gene> ;
    gutprop:containedIn <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/60ea4f71a9124fa1>,
        <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/a9c23d3527fde02b> .

<https://uts.nlm.nih.gov/uts/umls/concept/C0019643> a owl:NamedIndividual,
        skos:Concept,
        gutprop:Chemical ;
    rdfs:label "Histone Deacetylase" ;
    rdfs:comment "Deacetylases that remove N-acetyl groups from amino side chains of the amino acids of HISTONES. The enzyme family can be divided into at least three structurally-defined subclasses. Class I and class II deacetylases utilize a zinc-dependent mechanism. The sirtuin histone deacetylases belong to class III and are NAD-dependent enzymes. [Definition Source: UMLS]",
        "UMLS Match" ;
    skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/Chemical> ;
    gutprop:containedIn <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/01259b2ab89b252b>,
        <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/94e834c5769eb408>,
        <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/fd790cb86e4eaea9> .

<https://uts.nlm.nih.gov/uts/umls/concept/C0020663> a owl:NamedIndividual,
        skos:Concept,
        <https://w3id.org/brainteaser/ontology/schema/AnatomicalSite> ;
    rdfs:label "Hypothalamic Structure" ;
    rdfs:comment "UMLS Match",
        "Ventral part of the DIENCEPHALON extending from the region of the OPTIC CHIASM to the caudal border of the MAMMILLARY BODIES and forming the inferior and lateral walls of the THIRD VENTRICLE. [Definition Source: UMLS]" ;
    skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/AnatomicSite> ;
    gutprop:containedIn <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/8ed020260a1d25cf> .

<https://uts.nlm.nih.gov/uts/umls/concept/C0020838> a owl:NamedIndividual,
        skos:Concept,
        <https://w3id.org/brainteaser/ontology/schema/Gene> ;
    rdfs:label "Secretory Immunoglobulin A" ;
    rdfs:comment "The principle immunoglobulin in exocrine secretions such as milk, respiratory and intestinal mucin, saliva and tears. The complete molecule (around 400 kD) is composed of two four-chain units of IMMUNOGLOBULIN A, one SECRETORY COMPONENT and one J chain (IMMUNOGLOBULIN J-CHAINS). [Definition Source: UMLS]",
        "UMLS Match" ;
    skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/Gene> ;
    gutprop:containedIn <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/1d2c643900bf829f> .

<https://uts.nlm.nih.gov/uts/umls/concept/C0020962> a owl:NamedIndividual,
        skos:Concept,
        <https://w3id.org/brainteaser/ontology/schema/AnatomicalSite> ;
    rdfs:label "Immune System" ;
    rdfs:comment "The body's defense mechanism against foreign organisms or substances and deviant native cells. It includes the humoral immune response and the cell-mediated response and consists of a complex of interrelated cellular, molecular, and genetic components. [Definition Source: UMLS]",
        "UMLS Match" ;
    skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/AnatomicSite> ;
    gutprop:containedIn <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/cc9fdfb04e76d3bb> .

<https://uts.nlm.nih.gov/uts/umls/concept/C0021044> a owl:NamedIndividual,
        skos:Concept,
        gutprop:BiomedicalTechnique ;
    rdfs:label "Immunohistochemistry" ;
    rdfs:comment "Histochemical localization of immunoreactive substances using labeled antibodies as reagents. [Definition Source: UMLS]",
        "UMLS Match" ;
    skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/BiomedicalTechnique> ;
    gutprop:containedIn <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/e5a00a7d8df14569> .

<https://uts.nlm.nih.gov/uts/umls/concept/C0021400> a owl:NamedIndividual,
        skos:Concept,
        <https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding> ;
    rdfs:label "Influenza" ;
    rdfs:comment "Influenza is a highly contagious respiratory illness caused by the influenza virus, characterized by symptoms such as fever, cough, and fatigue. [Definition Source: llama3-8b-8192]"^^xsd:string,
        "UMLS Match"^^xsd:string ;
    skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/DiseaseDisorderOrFinding> ;
