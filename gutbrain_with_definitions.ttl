        <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/2da68e03534ea726>,
        <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/536e559ae7781a43>,
        <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/72ea8c34445be6ce>,
        <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/7d3d16382dc9c0eb>,
        <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/9621e7ef97198ef2>,
        <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/c32193ef58b8db73>,
        <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/c502624dc3c78d29>,
        <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/d4c90fc47beb3bc6>,
        <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/fb00982ca8585961> ;
    gutprop:usedBy <https://uts.nlm.nih.gov/uts/umls/concept/C0162789>,
