    rdfs:comment "A human gene is a segment of DNA that contains the instructions for synthesizing a specific protein or RNA molecule, and is typically located on one of the 23 pairs of chromosomes in the human genome. [Definition Source: llama3-8b-8192]",
        "UMLS Match" ;
    skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/Gene> ;
    gutprop:containedIn <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/96639e4e6cd9877b> .

<https://uts.nlm.nih.gov/uts/umls/concept/C0314760> a owl:NamedIndividual,
        skos:Concept,
        gutprop:Species ;
    rdfs:label "Coliform Bacteria" ;
    rdfs:comment "Any rod-shaped, Gram-negative, non-spore forming, motile or non-motile bacteria which can ferment lactose with the production of acid and gas. [Definition Source: UMLS]",
        "UMLS Match" ;
