    rdfs:label "Psychiatric Symptom" ;
    rdfs:comment "A psychiatric symptom is a subjective experience or observable behavior that is indicative of a mental disorder or psychological distress, such as anxiety, depression, or psychosis. [Definition Source: llama3-8b-8192]"^^xsd:string,
