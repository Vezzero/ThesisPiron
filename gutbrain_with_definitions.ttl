<http://purl.obolibrary.org/obo/NCIT_C21075> a owl:NamedIndividual,
        skos:Concept,
        <https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding> ;
    rdfs:label "Nociception" ;
    rdfs:comment "NCIT Match",
        "The stimulus-response process involving the stimulation of peripheral pain-carrying nerve fibers (e.g., C-fibers, A-delta fibers) and the transmission of impulses along peripheral nerves of the central nervous system, where the stimulus is perceived as pain. (Taber's) [Definition Source: NCIT]" ;
    skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/DiseaseDisorderOrFinding> ;
