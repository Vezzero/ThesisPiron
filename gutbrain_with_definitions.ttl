<https://w3id.org/hereditary/ontology/gutbrain/resource/dietarysupplement/DateSeedPowder> a owl:NamedIndividual,
        skos:Concept,
        gutprop:DietarySupplement ;
    rdfs:label "Date Seed Powder" ;
    dcterms:creator "Samuel Piron" ;
    rdfs:comment "Date seed powder is a type of dietary supplement or ingredient made from the powdered seeds of the date palm tree (Phoenix dactylifera). [Definition Source: llama3-8b-8192]" ;
    skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/DietarySupplement> ;
