        <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/fa9fc7a1f0d3bf72> ;
    gutprop:impact <https://w3id.org/hereditary/ontology/gutbrain/resource/diseasedisorderorfinding/AlteredGutMicrobiota> ;
    gutprop:influence <http://purl.obolibrary.org/obo/NCIT_C124639>,
        <http://purl.obolibrary.org/obo/NCIT_C35041>,
        <http://purl.obolibrary.org/obo/OMIT_0005141> .

