    rdfs:label "Acne" ;
    rdfs:comment "An inflammatory process of the sebaceous glands which is characterized by comedones, nodules, papules and/or pustules on the skin. [Definition Source: NCIT]",
        "NCIT Match" ;
    skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/DiseaseDisorderOrFinding> ;
