<http://purl.obolibrary.org/obo/OBI_0000185> a owl:NamedIndividual,
        skos:Concept,
        gutprop:BiomedicalTechnique ;
    rdfs:label "Imaging Assay" ;
    rdfs:comment "Brain_imaging_techniques refers to a set of methods used to visualize and analyze the structure and function of the brain, including techniques such as magnetic resonance imaging (MRI), computed tomography (CT), positron emission tomography (PET), and functional magnetic resonance imaging (fMRI). [Definition Source: llama3-8b-8192]",
        "OBI Match" ;
    skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/BiomedicalTechnique> ;
    gutprop:containedIn <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/362ac30821a71223> .

<http://purl.obolibrary.org/obo/OBI_0000739> a owl:NamedIndividual,
        skos:Concept,
        gutprop:StatisticalTechnique ;
    rdfs:label "Students T-Test" ;
    rdfs:comment "OBI Match",
        "Paired_and_unpaired_student_s_t-tests refers to a statistical test used to compare the means of two groups, either with or without pairing, to determine if there is a significant difference between the groups. [Definition Source: llama3-8b-8192]" ;
    skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/StatisticalTechnique> ;
    gutprop:containedIn <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/746160e237722ddb> .

<http://purl.obolibrary.org/obo/OBI_0200163> a owl:NamedIndividual,
        skos:Concept,
        gutprop:StatisticalTechnique ;
    rdfs:label "False Discovery Rate Correction Method" ;
    rdfs:comment "OBI Match",
        "The entity \"false_discovery_rate__fdr_\" refers to the expected proportion of Type I errors (false positives) among all significant test results, often used to control the number of false discoveries in multiple hypothesis testing. [Definition Source: llama3-8b-8192]" ;
    skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/StatisticalTechnique> ;
    gutprop:containedIn <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/efe0641bef6827e7> .

<http://purl.obolibrary.org/obo/OBI_0302900> a owl:NamedIndividual,
        skos:Concept,
        gutprop:StatisticalTechnique ;
    rdfs:label "Group Randomization" ;
    rdfs:comment "Mendelian randomization (MR) analyses: A statistical technique that uses genetic variants as instrumental variables to estimate the causal effect of a modifiable risk factor on an outcome, by leveraging the random assignment of genetic variants at conception. [Definition Source: llama3-8b-8192]",
        "OBI Match" ;
    skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/StatisticalTechnique> ;
    gutprop:containedIn <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/f92973f56735e7d1> .

<http://purl.obolibrary.org/obo/OBI_0500003> a owl:NamedIndividual,
        skos:Concept,
        gutprop:StatisticalTechnique ;
    rdfs:label "Cross Over Design" ;
    rdfs:comment "A cross-sectional design is a research study methodology that involves collecting data from a sample of participants at a single point in time, often to examine the prevalence or characteristics of a particular condition or outcome. [Definition Source: llama3-8b-8192]",
        "OBI Match" ;
    skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/StatisticalTechnique> ;
    gutprop:containedIn <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/e6ef5479c342aea4> .

