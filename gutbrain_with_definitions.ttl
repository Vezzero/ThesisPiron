<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38318337_1> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38318337_1" ;
    gutprop:hasSentenceText "The emergent recognition of the gut-brain axis connection has shed light on the role of the microbiota in modulating the gut-brain axis's functions." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38318337> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38318337_11> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38318337_11" ;
    gutprop:hasSentenceText "These findings have potential applications for developing microbiota-based approaches in the context of exercise for neurological diseases, especially on mental health and overall well-being." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38318337> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38318337_3> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38318337_3" ;
    gutprop:hasSentenceText "In our study, we aimed to investigate the impact of running exercises on microbial tryptophan metabolism using a mouse model." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38318337> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38318337_9> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38318337_9" ;
    gutprop:hasSentenceText "Moreover, the symbiotic association between <i>Romboutsia</i> and <i>" ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38318337> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38350463_8> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38350463_8" ;
    gutprop:hasSentenceText "No differences in short-chain fatty acids were observed up to 72 h of fermentation." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38350463> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38409102_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38409102_0" ;
    gutprop:hasSentenceText "Microbial composition, functionality, and stress resilience or susceptibility: unraveling sex-specific patterns." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/38409102> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38409102_10> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38409102_10" ;
    gutprop:hasSentenceText "Before SPS exposure, the sympathoadrenal axis exhibited alterations within male subgroups only." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38409102> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38409102_13> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38409102_13" ;
    gutprop:hasSentenceText "Beta diversity revealed distinct separations between male and female susceptible groups before SPS, with this separation becoming evident in the resilient groups following SPS." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38409102> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38409102_15> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38409102_15" ;
    gutprop:hasSentenceText "Additionally, sex-specific changes were observed in microbial predictive functionality and targeted functional modules both before and after SPS." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38409102> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38409102_21> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38409102_21" ;
    gutprop:hasSentenceText "Sex-specific pre-existing and SPS-induced differences in the gut microbial composition and predictive functionality were observed in susceptible and resilient rats." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38409102> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38409102_9> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38409102_9" ;
    gutprop:hasSentenceText "Stool samples were collected before and after SPS, whereas urine samples were taken before and 30 min into the SPS." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38409102> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38422755_7> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38422755_7" ;
    gutprop:hasSentenceText "Microbiota features associated with malnutrition were used to predict clinical outcomes." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38422755> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38432867_3> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38432867_3" ;
    gutprop:hasSentenceText "Therefore, in-depth research on the pathogenesis of TAO is to find effective treatments." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38432867> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38508549_3> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38508549_3" ;
    gutprop:hasSentenceText "The chemical and structural characteristics and metabolites of these plant polysaccharides were summarised." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38508549> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38525261_1> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38525261_1" ;
    gutprop:hasSentenceText "The gut microbiota has been extensively implicated in health and disease." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38525261> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38525261_12> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38525261_12" ;
    gutprop:hasSentenceText "Our search focuses on the impact of this food component on the microbiota of healthy individuals." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38525261> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38525261_3> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38525261_3" ;
    gutprop:hasSentenceText "Significant associations exist between alterations in the relative abundance of specific microbial taxa and mental health disorders." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38525261> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38525261_5> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38525261_5" ;
    gutprop:hasSentenceText "As many taxa of microorganisms have enzymes capable of producing or degrading neurochemicals i.e." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38525261> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38525261_6> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38525261_6" ;
    gutprop:hasSentenceText "neuroactive gut brain modules, new predictive tools can be applied to existing datasets such as those harvested from dietary fiber interventions." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38525261> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38525261_8> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38525261_8" ;
    gutprop:hasSentenceText "We aim to also extract from the selected studies publicly available microbial genomic sequence datasets for reanalysis with a consistent bioinformatics pipeline, with the ultimate intention of identifying altered gut brain modules following dietary fiber interventions." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38525261> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38525261_9> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38525261_9" ;
    gutprop:hasSentenceText "Interventional trials and randomized controlled studies that are originally published, including cross-over and non-crossover design and involving healthy adult humans will be included." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38525261> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38606411_7> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38606411_7" ;
    gutprop:hasSentenceText "Spearman correlation analysis was used to explore the relationship between intestinal mucosal markers and clinical characteristics." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38606411> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38613087_5> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38613087_5" ;
    gutprop:hasSentenceText "Psychobiotics exhibit positive effects on the intestinal barrier, immune response, cortisol levels, and the hypothalamic-pituitary-adrenal (HPA) axis." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38613087> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38664425_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38664425_2" ;
    gutprop:hasSentenceText "Microbiome-based interventions, such as dietary interventions, biotics, and fecal microbiome transplant, have been proposed as a novel approach to managing symptoms and modulating disease progression." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38664425> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38664425_3> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38664425_3" ;
    gutprop:hasSentenceText "Emerging clinical trials have investigated the efficacy of interventions modulating the GM in alleviating or reversing disease progression, yet no comprehensive synthesis have been done." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38664425> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38664425_7> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38664425_7" ;
    gutprop:hasSentenceText "Most microbiome-modulating interventions changed the GM composition." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38664425> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38664425_9> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38664425_9" ;
    gutprop:hasSentenceText "However, current studies have high methodological heterogeneity and small sample sizes, requiring more well-designed and controlled studies to elucidate the complex linkage between microbiome, microbiome-modulating interventions, and NDDs." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38664425> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38679353_5> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38679353_5" ;
    gutprop:hasSentenceText "Continuous models were used to analyze the extracted data." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38679353> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38679353_8> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38679353_8" ;
    gutprop:hasSentenceText "The included studies reported the data on the ratios of 10 families of GM." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38679353> .

