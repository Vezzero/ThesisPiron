    gutprop:containedIn <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/e2162d026d5f0fd7> .

<https://uts.nlm.nih.gov/uts/umls/concept/C5197854> a owl:NamedIndividual,
        skos:Concept,
        gutprop:BiomedicalTechnique ;
    rdfs:label "Morris Water Maze Test" ;
    rdfs:comment "A maze test often used to evaluate spatial learning and memory in rodent models by measuring the time it takes for a submerged platform in an open swimming arena to be found. [Definition Source: UMLS]",
        "UMLS Match" ;
    skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/BiomedicalTechnique> ;
    gutprop:containedIn <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/e509b2b0acf22911> .

<https://uts.nlm.nih.gov/uts/umls/concept/C5234846> a owl:NamedIndividual,
        skos:Concept,
        <https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding> ;
    rdfs:label "Olfactory Impairment" ;
    rdfs:comment "Olfactory Impairment: A reduction or loss of the ability to perceive and distinguish different odors, which can be caused by various factors such as genetic disorders, head trauma, or neurodegenerative diseases. [Definition Source: llama3-8b-8192]"^^xsd:string,
        "UMLS Match"^^xsd:string ;
    skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/DiseaseDisorderOrFinding> ;
    gutprop:containedIn <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/2d4942dde43e4048> .

<https://uts.nlm.nih.gov/uts/umls/concept/C5392081> a owl:NamedIndividual,
        skos:Concept,
        gutprop:BiomedicalTechnique ;
    rdfs:label "Open Field Apparatus Method",
        "Open Field Test" ;
    rdfs:comment "A maze test in which an animal is placed in an open chamber designed to assess anxiety and exploratory behavior by movement patterns. In novel object recognition test various objects are added to open field to assess exploration and memory. [Definition Source: UMLS]",
        "UMLS Match" ;
    skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/BiomedicalTechnique> ;
    gutprop:containedIn <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/2f17746ce62d286b>,
