        skos:Concept,
        <https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding> ;
    rdfs:label "Cholesterol" ;
    rdfs:comment "Cholesterol is a type of steroid lipid molecule that is produced by the liver and found in the bloodstream, playing a crucial role in the structure and function of cell membranes and serving as a precursor to bile acids and certain hormones. [Definition Source: llama3-8b-8192]"^^xsd:string,
        "UMLS Match"^^xsd:string ;
    skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/DiseaseDisorderOrFinding> ;
