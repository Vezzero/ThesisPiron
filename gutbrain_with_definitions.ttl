<https://uts.nlm.nih.gov/uts/umls/concept/C0315079> a owl:NamedIndividual,
        skos:Concept,
        gutprop:Species ;
    rdfs:label "Clostridium Sporogenes" ;
    rdfs:comment "A species of anaerobic, Gram positive, rod shaped bacteria assigned to the phylum Firmicutes. This species is proteolytic, does not produce botulinum toxin, is beta-hemolytic and positive for indole. C. sporogenes is pathogenic and culture is associated with a foul odor. [Definition Source: UMLS]",
        "UMLS Match" ;
    skos:broaderTransitive <http://purl.obolibrary.org/obo/NCBITaxon_2> ;
    skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/Bacteria> ;
