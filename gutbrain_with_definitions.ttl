        gutprop:BiomedicalTechnique ;
    rdfs:label "Novel Object Recognition Test" ;
    rdfs:comment "The \"novel_object_recognition_test\" is a cognitive assessment tool used to evaluate an individual's ability to recognize and distinguish between new and familiar objects. [Definition Source: llama3-8b-8192]",
