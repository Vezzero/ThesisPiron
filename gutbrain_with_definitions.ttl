<https://uts.nlm.nih.gov/uts/umls/concept/C4021734> a owl:NamedIndividual,
        skos:Concept,
        <https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding> ;
    rdfs:label "Mitochondrial Dysfunction" ;
    rdfs:comment "Mitochondrial dysfunction refers to a disruption in the normal functioning of mitochondria, the cellular organelles responsible for generating energy, leading to impaired energy production, oxidative stress, and potential cellular damage. [Definition Source: llama3-8b-8192]"^^xsd:string,
        "UMLS Match"^^xsd:string ;
    skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/DiseaseDisorderOrFinding> ;
