<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38318337_6> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38318337_6" ;
    gutprop:hasSentenceText "Fecal microbiota analysis aimed to examine the composition and diversity of the gut microbiota, and taxon-function analysis explored the associations between specific microbial taxa and functional activities in tryptophan metabolism." ;
