<https://uts.nlm.nih.gov/uts/umls/concept/C0014038> a owl:NamedIndividual,
        skos:Concept,
        <https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding> ;
    rdfs:label "Encephalitis" ;
    rdfs:comment "Encephalitis is an inflammatory response in the brain, typically caused by a viral or bacterial infection, which can lead to symptoms such as fever, headache, and altered mental status. [Definition Source: llama3-8b-8192]"^^xsd:string,
        "UMLS Match"^^xsd:string ;
    skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/DiseaseDisorderOrFinding> ;
    gutprop:containedIn <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/7501f78cb72941da> .

<https://uts.nlm.nih.gov/uts/umls/concept/C0016807> a owl:NamedIndividual,
        skos:Concept,
        <https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding> ;
    rdfs:label "Functional Disorder Of Intestine" ;
    rdfs:comment "A Functional Disorder Of Intestine is a condition characterized by altered bowel habits, abdominal pain, and other symptoms in the absence of any detectable organic cause or structural abnormality. [Definition Source: llama3-8b-8192]"^^xsd:string,
        "UMLS Match"^^xsd:string ;
    skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/DiseaseDisorderOrFinding> ;
    gutprop:containedIn <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/b62c7c4aad22e824> ;
