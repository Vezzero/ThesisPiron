<http://purl.obolibrary.org/obo/NCIT_C2155> a owl:NamedIndividual,
        skos:Concept,
        <https://w3id.org/brainteaser/ontology/schema/Gene> ;
    rdfs:label "Tyrosine Hydroxylase Inhibitor" ;
    rdfs:comment "Any substance that inhibits tyrosine 3-monooxygenase (tyrosine hydroxylase), an enzyme that catalyzes the conversion of tyrosine to dihydroxyphenylalanine, a precursor to dopamine, norepinephrine, and epinephrine. Inhibition of tyrosine hydroxylase can lead to a depletion of dopamine and norepinephrine in the brain. [Definition Source: NCIT]",
        "NCIT Match" ;
    skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/Gene> ;
    gutprop:containedIn <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/48ae045b460037c0> .

