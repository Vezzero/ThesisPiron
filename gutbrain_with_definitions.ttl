<https://uts.nlm.nih.gov/uts/umls/concept/C0009241> a owl:NamedIndividual,
        skos:Concept,
        <https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding> ;
    rdfs:label "Cognition Disorders" ;
    rdfs:comment "Cognition Disorders: A broad term referring to a range of mental health conditions characterized by impairments in one or more cognitive functions, such as attention, memory, language, problem-solving, or executive functions. [Definition Source: llama3-8b-8192]"^^xsd:string,
