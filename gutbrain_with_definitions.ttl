        gutprop:Chemical ;
    rdfs:label "Interleukin-18" ;
    rdfs:comment "Interleukin-18 is a pro-inflammatory cytokine that plays a key role in the immune response by stimulating the production of interferon-gamma and activating natural killer cells. [Definition Source: llama3-8b-8192]"^^xsd:string,
