<http://purl.obolibrary.org/obo/NCIT_C12662> a owl:NamedIndividual,
        skos:Concept,
        <https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding> ;
    rdfs:label "Stem Cell" ;
    rdfs:comment "An unspecialized cell that has the capacity for reproduction through cell division and can be induced to differentiate into a tissue or organ specific cell. [Definition Source: NCIT]",
        "NCIT Match" ;
    skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/DiseaseDisorderOrFinding> ;
