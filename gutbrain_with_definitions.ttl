<https://uts.nlm.nih.gov/uts/umls/concept/C0011854> a owl:NamedIndividual,
        skos:Concept,
        <https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding> ;
    rdfs:label "Diabetes Mellitus, Insulin-Dependent" ;
    rdfs:comment "Diabetes Mellitus, Insulin-Dependent is a type of diabetes characterized by a deficiency of insulin production by the pancreas, requiring insulin therapy to control blood sugar levels. [Definition Source: llama3-8b-8192]"^^xsd:string,
        "UMLS Match"^^xsd:string ;
    skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/DiseaseDisorderOrFinding> ;
