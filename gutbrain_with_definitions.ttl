        <https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding> ;
    rdfs:label "Co-Morbid Conditions" ;
    rdfs:comment "Co-Morbid Conditions: A set of two or more chronic diseases or health conditions that coexist in an individual, often interacting with each other and affecting the diagnosis, treatment, and prognosis of each condition. [Definition Source: llama3-8b-8192]"^^xsd:string,
        "UMLS Match"^^xsd:string ;
