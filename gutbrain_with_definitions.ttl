<https://w3id.org/hereditary/ontology/gutbrain/resource/chemical/SerumHormone> a owl:NamedIndividual,
        skos:Concept,
        gutprop:Chemical ;
    rdfs:label "Serum Hormone" ;
    dcterms:creator "Samuel Piron" ;
    rdfs:comment "A serum hormone is a hormone that is present in the serum or plasma of an organism, typically produced by endocrine glands and transported through the bloodstream to exert its biological effects. [Definition Source: llama3-8b-8192]" ;
    skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/Chemical> ;
    gutprop:containedIn <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/cd9232309b0dc2af> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/diseasedisorderorfinding/AbnormalBloodLevels> a owl:NamedIndividual,
        skos:Concept,
        <https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding> ;
    rdfs:label "Abnormal Blood Level" ;
    dcterms:creator "Samuel Piron" ;
    rdfs:comment "Abnormal blood levels refer to concentrations of blood components, such as hemoglobin, glucose, or electrolytes, that deviate from the normal range or expected values, often indicating a medical condition or disease. [Definition Source: llama3-8b-8192]" ;
    skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/DiseaseDisorderOrFinding> ;
    gutprop:containedIn <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/8777fe39a7745cd8> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/diseasedisorderorfinding/CholesterolAccumulation> a owl:NamedIndividual,
        skos:Concept,
        <https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding> ;
    rdfs:label "Cholesterol Accumulation" ;
    dcterms:creator "Samuel Piron" ;
    rdfs:comment "Cholesterol_accumulation refers to the abnormal accumulation of cholesterol in the body, often resulting in conditions such as atherosclerosis, xanthomas, or hyperlipidemia. [Definition Source: llama3-8b-8192]" ;
    skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/DiseaseDisorderOrFinding> ;
    gutprop:containedIn <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/a215b8591691873b>,
