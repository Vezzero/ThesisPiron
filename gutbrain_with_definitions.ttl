    rdfs:label "Epilepsy" ;
    rdfs:comment "Epilepsy is a chronic neurological disorder characterized by recurrent seizures or episodes of abnormal brain activity. [Definition Source: llama3-8b-8192]",
        "OMIT Match" ;
    skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/DiseaseDisorderOrFinding> ;
