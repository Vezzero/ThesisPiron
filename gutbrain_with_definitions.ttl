    rdfs:label "Congenital Rubella Syndrome" ;
    rdfs:comment "Congenital Rubella Syndrome is a rare condition caused by maternal rubella virus infection during pregnancy, characterized by a range of congenital anomalies and defects affecting multiple organs and systems. [Definition Source: llama3-8b-8192]"^^xsd:string,
