    rdfs:comment "The colon microbiota refers to the collective community of microorganisms, including bacteria, viruses, fungi, and protozoa, that inhabit the colon and play a crucial role in maintaining gut health and modulating the host's immune system. [Definition Source: llama3-8b-8192]",
        "UMLS Match" ;
    skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/Microbiome> ;
    gutprop:containedIn <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/7403b7a37a456f77> ;
    gutprop:isLinkedTo <http://purl.obolibrary.org/obo/NCIT_C84442>,
        <https://uts.nlm.nih.gov/uts/umls/concept/C0011847> .

