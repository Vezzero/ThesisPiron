    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38318337> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38318337_5> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38318337_5" ;
    gutprop:hasSentenceText "The analyses integrated multiple components, such as tryptophan changes and metabolite levels in the gut, blood, hippocampus, and brainstem." ;
