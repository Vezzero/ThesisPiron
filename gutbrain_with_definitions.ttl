<http://purl.obolibrary.org/obo/NCIT_C12381> a owl:NamedIndividual,
        skos:Concept,
        <https://w3id.org/brainteaser/ontology/schema/AnatomicalSite> ;
    rdfs:label "Cecum" ;
    rdfs:comment "A blind pouch-like commencement of the colon in the right lower quadrant of the abdomen at the end of the small intestine and the start of the large intestine. [Definition Source: NCIT]",
        "NCIT Match" ;
    skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/AnatomicSite> ;
    gutprop:containedIn <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/393eedcc6d779ccb> ;
    gutprop:locatedIn <http://purl.obolibrary.org/obo/NCIT_C45247> .

<http://purl.obolibrary.org/obo/NCIT_C12386> a owl:NamedIndividual,
        skos:Concept,
        <https://w3id.org/brainteaser/ontology/schema/AnatomicalSite> ;
    rdfs:label "Small Intestine" ;
    rdfs:comment "NCIT Match",
        "The section of the intestines between the pylorus and cecum. The small intestine is approximately 20 feet long and consists of the duodenum, the jejunum, and the ileum. Its main function is to absorb nutrients from food as the food is transported to the large intestine. [Definition Source: NCIT]" ;
    skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/AnatomicSite> ;
    gutprop:containedIn <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/1241dd498a6e2964> .

<http://purl.obolibrary.org/obo/NCIT_C12387> a owl:NamedIndividual,
        skos:Concept,
        <https://w3id.org/brainteaser/ontology/schema/AnatomicalSite> ;
    rdfs:label "Ileum" ;
    rdfs:comment "NCIT Match",
        "The final section of the small intestine. [Definition Source: NCIT]" ;
    skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/AnatomicSite> ;
    gutprop:containedIn <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/a65df377395a8067> ;
    gutprop:locatedIn <https://uts.nlm.nih.gov/uts/umls/concept/C0009932>,
        <https://w3id.org/hereditary/ontology/gutbrain/resource/human/PediatricChronicIntestinalPseudoObstructionPatients> .

<http://purl.obolibrary.org/obo/NCIT_C12388> a owl:NamedIndividual,
        skos:Concept,
        <https://w3id.org/brainteaser/ontology/schema/AnatomicalSite> ;
    rdfs:label "Jejunum" ;
    rdfs:comment "NCIT Match",
        "The portion of the small intestine that extends from the duodenum to the ileum. [Definition Source: NCIT]" ;
    skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/AnatomicSite> ;
    gutprop:containedIn <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/e0524bd77d812231> .

<http://purl.obolibrary.org/obo/NCIT_C12390> a owl:NamedIndividual,
        skos:Concept,
        <https://w3id.org/brainteaser/ontology/schema/AnatomicalSite> ;
    rdfs:label "Rectum" ;
    rdfs:comment "NCIT Match",
        "The terminal portion of the gastrointestinal tract, extending from the rectosigmoid junction to the anal canal. [Definition Source: NCIT]" ;
    skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/AnatomicSite> ;
    gutprop:containedIn <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/fdca9cb0db1db597> .

<http://purl.obolibrary.org/obo/NCIT_C12419> a owl:NamedIndividual,
        skos:Concept,
        <https://w3id.org/brainteaser/ontology/schema/AnatomicalSite> ;
    rdfs:label "Head" ;
    rdfs:comment "NCIT Match",
        "The anterior and superior part of a human bearing the mouth, the brain and sensory organs. [Definition Source: NCIT]" ;
    skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/AnatomicSite> ;
    gutprop:containedIn <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/9f2e6d33a3717ee8> .

<http://purl.obolibrary.org/obo/NCIT_C12423> a owl:NamedIndividual,
        skos:Concept,
        <https://w3id.org/brainteaser/ontology/schema/AnatomicalSite> ;
    rdfs:label "Nasopharynx" ;
    rdfs:comment "NCIT Match",
        "The part of the pharynx in the back of the throat, at and above the soft palate. The nasopharynx is continuous with the nasal passages. [Definition Source: NCIT]" ;
    skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/AnatomicSite> ;
    gutprop:containedIn <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/e7b4f58fa29fd17c> .

<http://purl.obolibrary.org/obo/NCIT_C12434> a owl:NamedIndividual,
        skos:Concept,
        <https://w3id.org/brainteaser/ontology/schema/AnatomicalSite> ;
    rdfs:label "Blood" ;
    rdfs:comment "A liquid tissue; its major function is to transport oxygen throughout the body. It also supplies the tissues with nutrients, removes waste products, and contains various components of the immune system defending the body against infection. Several hormones also travel in the blood. [Definition Source: NCIT]",
        "NCIT Match" ;
    skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/AnatomicSite> ;
    gutprop:containedIn <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/3e8e40c0af5f5ea5> .

<http://purl.obolibrary.org/obo/NCIT_C12441> a owl:NamedIndividual,
        skos:Concept,
        <https://w3id.org/brainteaser/ontology/schema/AnatomicalSite> ;
    rdfs:label "Brain Stem" ;
    rdfs:comment "NCIT Match",
        "Three sections, the midbrain, pons and medulla oblongata, that are located at the base of the brain. The brain stem regulates the central nervous system, and is vital as a conduit for motor and sensory innervations. [Definition Source: NCIT]" ;
    skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/AnatomicSite> ;
    gutprop:containedIn <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/c54413bf0ee0313b> .

<http://purl.obolibrary.org/obo/NCIT_C12447> a owl:NamedIndividual,
        skos:Concept,
        <https://w3id.org/brainteaser/ontology/schema/AnatomicalSite> ;
    rdfs:label "Basal Ganglia" ;
    rdfs:comment "Clusters of neurons comprising the globus pallidus, putamen, caudate, nucleus accumbens, substantia nigra and subthalamic nucleus. They are involved with high level aspects of inhibitory motor activity in coordination with the excitation commands issued from the cerebellum. [Definition Source: NCIT]",
        "NCIT Match" ;
    skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/AnatomicSite> ;
    gutprop:containedIn <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/3e5accf0b44f69db> .

<http://purl.obolibrary.org/obo/NCIT_C12450> a owl:NamedIndividual,
        skos:Concept,
        <https://w3id.org/brainteaser/ontology/schema/AnatomicalSite> ;
    rdfs:label "Striatum" ;
    rdfs:comment "NCIT Match",
        "Striatum [Definition Source: NCIT]" ;
    skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/AnatomicSite> ;
    gutprop:containedIn <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/b11bae2d7599588e> ;
    gutprop:locatedIn <http://purl.obolibrary.org/obo/NCIT_C45247> .

<http://purl.obolibrary.org/obo/NCIT_C12521> a owl:NamedIndividual,
        skos:Concept,
        gutprop:Chemical ;
    rdfs:label "Erythrocyte" ;
    rdfs:comment "A blood cell specialized for oxygen transport, having a high concentration of hemoglobin in the cytoplasm. They are biconcave, anucleate discs, with a 6-8um diameter in humans. [Definition Source: NCIT]",
        "NCIT Match" ;
    skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/Chemical> ;
    gutprop:containedIn <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/e77702d233350854> .

<http://purl.obolibrary.org/obo/NCIT_C12623> a owl:NamedIndividual,
        skos:Concept,
        <https://w3id.org/brainteaser/ontology/schema/AnatomicalSite>,
        <https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding>,
        gutprop:Chemical ;
    rdfs:label "Neuron" ;
    rdfs:comment "Any of the conducting cells of the nervous system. A typical neuron consists of a cell body, containing the nucleus and the surrounding cytoplasm (perikaryon); several short radiating processes (dendrites); and one long process (the axon), which terminates in twiglike branches (telodendrons) and may have branches (collaterals) projecting along its course. [Definition Source: NCIT]",
        "NCIT Match" ;
    skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/AnatomicSite>,
        <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/Chemical>,
        <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/DiseaseDisorderOrFinding> ;
    gutprop:containedIn <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/54a5836c43aef491>,
        <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/ad523424f063161f> ;
    gutprop:impact <http://purl.obolibrary.org/obo/OHMI_0000020>,
        <https://w3id.org/hereditary/ontology/gutbrain/resource/diseasedisorderorfinding/AlteredGutMicrobiota> ;
    gutprop:locatedIn <http://purl.obolibrary.org/obo/NCIT_C12439> .

<http://purl.obolibrary.org/obo/NCIT_C126482> a owl:NamedIndividual,
        skos:Concept,
        gutprop:Food ;
    rdfs:label "Meat" ;
    rdfs:comment "NCIT Match",
        "The flesh of animals used as food. [Definition Source: NCIT]" ;
    skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/Food> ;
