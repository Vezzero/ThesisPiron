<https://uts.nlm.nih.gov/uts/umls/concept/C1145628> a owl:NamedIndividual,
        skos:Concept,
        <https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding> ;
    rdfs:label "Autonomic Nervous System Disorders" ;
    rdfs:comment "Autonomic Nervous System Disorders refer to a group of conditions characterized by dysfunction or damage to the autonomic nervous system, leading to abnormal regulation of involuntary bodily functions such as heart rate, blood pressure, digestion, and respiration. [Definition Source: llama3-8b-8192]"^^xsd:string,
        "UMLS Match"^^xsd:string ;
    skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/DiseaseDisorderOrFinding> ;
