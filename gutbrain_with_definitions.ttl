<https://uts.nlm.nih.gov/uts/umls/concept/C5544451> a owl:NamedIndividual,
        skos:Concept,
        <https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding> ;
    rdfs:label "Neuroinflammatory Diseases" ;
    rdfs:comment "Neuroinflammatory Diseases: A group of conditions characterized by an abnormal immune response in the central nervous system, leading to inflammation and damage to brain and spinal cord tissues. [Definition Source: llama3-8b-8192]"^^xsd:string,
