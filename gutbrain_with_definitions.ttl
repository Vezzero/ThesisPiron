<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32545788_4> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_32545788_4" ;
    gutprop:hasSentenceText "The NLRP3 inflammasome is the most well characterized." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32545788> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32545788_6> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_32545788_6" ;
    gutprop:hasSentenceText "Recent evidence has greatly improved our understanding of the mechanisms by which the NLRP3 inflammasome is activated." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32545788> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32572814_10> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_32572814_10" ;
    gutprop:hasSentenceText "Exposure of SH-SY5Y cells for 24 h to 400 μM SALS resulted in approximately 60% cell death, which was concentration-dependently prevented by butyrate." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32572814> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32572814_6> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_32572814_6" ;
    gutprop:hasSentenceText "Recently, its significance in regulation of some critical brain functions and usefulness in neurodegenerative diseases such as PD has been suggested." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32572814> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32600151_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_32600151_0" ;
    gutprop:hasSentenceText "Rapid improvement in Alzheimer's disease symptoms following fecal microbiota transplantation: a case report." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/32600151> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32605552_1> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_32605552_1" ;
    gutprop:hasSentenceText "Australia, like other nations, has experienced a shift in dietary patterns away from home cooking of nutritious foods, towards a reliance on pre-prepared convenience meals." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32605552> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32605552_13> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_32605552_13" ;
    gutprop:hasSentenceText "The study was designed to explore whether food literacy programs are efficacious in improving participant physical health and well-being in order to combat the rise in obesity and diet-related disease." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32605552> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32605552_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_32605552_2" ;
    gutprop:hasSentenceText "These are typically energy-dense, nutrient-poor and contribute to the rising prevalence of obesity and chronic disease burden." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32605552> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32667590_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_32667590_0" ;
    gutprop:hasSentenceText "The role of the microbiota-gut-brain axis in neuropsychiatric disorders." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/32667590> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32667590_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_32667590_2" ;
    gutprop:hasSentenceText "The complexity of the intestinal ecosystem is extraordinary; it comprises more than 100 trillion microbial cells that inhabit the small and large intestine, and this interaction between microbiota and intestinal epithelium can cause physiological changes in the brain and influence mood and behavior." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32667590> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32667590_4> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_32667590_4" ;
    gutprop:hasSentenceText "Evidence indicates that intestinal microbiota are involved in neurological and psychiatric disorders." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32667590> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32739746_3> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_32739746_3" ;
    gutprop:hasSentenceText "Adolescence is a key developmental window in which stress and anxiety disorders are a major health concern." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32739746> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32772900_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_32772900_0" ;
    gutprop:hasSentenceText "Gut microbes in neurocognitive and mental health disorders." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/32772900> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32772900_1> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_32772900_1" ;
    gutprop:hasSentenceText "As individuals age, the prevalence of neurocognitive and mental health disorders increases." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32772900> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32772900_10> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_32772900_10" ;
    gutprop:hasSentenceText "Various psychotropic medications can have an influence on the gut microbiota by their antimicrobial effect." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32772900> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32772900_4> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_32772900_4" ;
    gutprop:hasSentenceText "<b>Methodology:</b> Scoping review about the effect of gut microbiota on neurocognitive and mental health disorders." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32772900> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32772900_5> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_32772900_5" ;
    gutprop:hasSentenceText "This scoping review found there is an evolving evidence of the involvement of the gut microbiota in the pathophysiology of neurocognitive and mental health disorders." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32772900> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32816830_6> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_32816830_6" ;
    gutprop:hasSentenceText "Participants will provide stool and blood samples, daily bowel symptoms diaries and 3-day diet records." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32816830> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32816830_8> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_32816830_8" ;
    gutprop:hasSentenceText "Gut health will be assessed via faecal microbiome composition, faecal pH and SCFA levels." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32816830> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32834004_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_32834004_0" ;
    gutprop:hasSentenceText "Predictive analysis methods for human microbiome data with application to Parkinson's disease." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/32834004> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32834004_9> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_32834004_9" ;
    gutprop:hasSentenceText "These results provide strong evidences of the relationship between Parkinson's disease and the gut microbiome." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32834004> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32890382_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_32890382_0" ;
    gutprop:hasSentenceText "From Family Surroundings to Intestinal Flora, A Literature Review Concerning Epigenetic Processes in Psychiatric Disorders." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/32890382> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32890382_1> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_32890382_1" ;
    gutprop:hasSentenceText "Some behaviors or psychiatric conditions seem to be inherited from parents or explain by family environment." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32890382> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32890382_10> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_32890382_10" ;
    gutprop:hasSentenceText "Several environmental characteristics such as traumatic life events, family adversity, psychological stress or internal environment such as gut microbiota diversity and diet showed an impact on epigenetic." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32890382> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32979562_10> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_32979562_10" ;
    gutprop:hasSentenceText "The present findings enable a better understanding of changes in gastrointestinal microbiome and MiTBamp in BPD." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32979562> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32979562_8> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_32979562_8" ;
    gutprop:hasSentenceText "Finally, RF classification based on gut microbiota at the genus level can achieve an area under the receiver operating characteristic curve of 0.997." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32979562> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32983561_3> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_32983561_3" ;
    gutprop:hasSentenceText "The gut–brain axis is an established axis demonstrating the effect of the gut microbiota on the biochemical processes in the brain." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32983561> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32983561_4> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_32983561_4" ;
    gutprop:hasSentenceText "With the existence of mindfulness initiatives such as adoption of a ‘yogic lifestyle’ aimed at creating a sense of harmony and balance within the individual, this special report considers the available evidence base, asking whether the harmony created by adopting this lifestyle can be related to establishing harmony in the gut–brain axis." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32983561> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32987656_4> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_32987656_4" ;
    gutprop:hasSentenceText "Polyphenols are secondary metabolites of plants, which have shown benefit in several experimental models of PD." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32987656> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32987656_6> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_32987656_6" ;
    gutprop:hasSentenceText "In this review, we provide an overview of the pathology of PD and the data supporting the potential neuroprotective capacity of increased polyphenols in the diet." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32987656> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32999308_5> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_32999308_5" ;
    gutprop:hasSentenceText "However, how the deficiency of DJ-1 influences the risk of PD remains incompletely understood." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32999308> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33046051_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33046051_0" ;
    gutprop:hasSentenceText "Using data science for medical decision making case: role of gut microbiome in multiple sclerosis." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/33046051> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33046051_4> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33046051_4" ;
    gutprop:hasSentenceText "This paper aims to provide an understanding of differences between microbial data of individuals who have been diagnosed with multiple sclerosis and those who were not by exploiting data science techniques on publicly available data." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33046051> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33063712_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33063712_2" ;
    gutprop:hasSentenceText "Altered components of the gut could play a key role in the gut-brain axis, which is a bidirectional system between the central nervous system and the enteric nervous system." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33063712> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33063712_4> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33063712_4" ;
    gutprop:hasSentenceText "Diet can alter the microbiota composition, affecting the gut-brain axis function." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33063712> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33063712_6> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33063712_6" ;
    gutprop:hasSentenceText "Preclinical and clinical investigations discussed in this review strengthen the correlation between intestinal microbiota and brain and the concept that modifying the microbiome composition may improve brain neurochemistry, modulating different pathways." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33063712> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33076930_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33076930_2" ;
    gutprop:hasSentenceText "Gastrointestinal tract dysfunction is one of the non-motor features, where constipation is reported as the most common gastrointestinal symptom." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33076930> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33076930_4> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33076930_4" ;
    gutprop:hasSentenceText "In particular, Clostridium sporogenes is a key contributor to the production of these bioactive metabolites in the human gut." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33076930> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33076930_6> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33076930_6" ;
    gutprop:hasSentenceText "The deaminated metabolite from levodopa, 3-(3,4-dihydroxyphenyl)propionic acid, elicits an inhibitory effect on ileal motility in an ex vivo model." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33076930> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33105830_1> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33105830_1" ;
    gutprop:hasSentenceText "Inflammation is a biological response to the activation of the immune system by various infectious or non-infectious agents, which may lead to tissue damage and various diseases." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33105830> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33105830_6> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33105830_6" ;
    gutprop:hasSentenceText "A growing body of research supports the beneficial role of probiotics in lung and mental health through modulating the gut-lung and gut-brain axes." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33105830> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33144709_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33144709_0" ;
    gutprop:hasSentenceText "Diet and depression: exploring the biological mechanisms of action." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/33144709> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33177907_7> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33177907_7" ;
    gutprop:hasSentenceText "Acute/chronic insomnia-related signature bacteria also showed correlations with these patients' self-reported sleep quality and plasma IL-1β." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33177907> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33195226_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33195226_0" ;
    gutprop:hasSentenceText "Microbiome Profiling Reveals Gut Dysbiosis in the Metabotropic Glutamate Receptor 5 Knockout Mouse Model of Schizophrenia." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/33195226> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33195226_3> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33195226_3" ;
    gutprop:hasSentenceText "However, no animal model of SZ has previously recapitulated the gut dysbiosis observed clinically." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33195226> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33195226_9> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33195226_9" ;
    gutprop:hasSentenceText "Our findings suggest that this widely used preclinical model of SZ also has substantial utility for investigations of gut dysbiosis and associated signaling via the microbiota-gut-brain axis, as potential modulators of SZ pathogenesis." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33195226> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33240722_1> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33240722_1" ;
    gutprop:hasSentenceText "The gut microbiota regulates the function and health of the human gut." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33240722> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33240722_5> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33240722_5" ;
    gutprop:hasSentenceText "An alteration in the composition of the gut microbiome has been linked to a variety of neurodevelopmental and neurodegenerative disorders." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33240722> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33240722_6> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33240722_6" ;
    gutprop:hasSentenceText "The connection between gut microbiome and several CNS disorders indicates that the focus of research in the future should be on the bacterial and biochemical targets." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33240722> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33244049_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33244049_0" ;
    gutprop:hasSentenceText "Emotional well-being and gut microbiome profiles by enterotype." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/33244049> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33271210_13> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33271210_13" ;
    gutprop:hasSentenceText "More studies are needed to determine whether gut dysbiosis leads to the development and/or contributes to the severity of mental disorders or whether gut dysbiosis is a result of other processes that accompany mental disorders." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33271210> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33271210_15> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33271210_15" ;
    gutprop:hasSentenceText "Moreover, it may ultimately aid the clinician with intervention strategies, or detect populations at risk for developing neuropsychiatric disorders." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33271210> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33271426_7> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33271426_7" ;
    gutprop:hasSentenceText "Although the gut microbiota remains a promising target for prevention and therapy, future research should assess confounders, particularly diet and psychotropic medications, and should examine microorganism function." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33271426> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33287442_3> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33287442_3" ;
    gutprop:hasSentenceText "There are many factors that impact an individual's risk of developing breast cancer, their response to treatments, and their risk of recurrence." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33287442> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33287442_4> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33287442_4" ;
    gutprop:hasSentenceText "The community of microorganisms inhabiting the gastrointestinal tract, the gut microbiota, affects human health through metabolic, neural, and endocrine signaling, and immune activity." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33287442> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33301807_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33301807_0" ;
    gutprop:hasSentenceText "Spinal cord injury and gut microbiota: A review." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/33301807> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33301807_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33301807_2" ;
    gutprop:hasSentenceText "Recent data from rodent and human studies indicated that SCI causes gut dysbiosis." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33301807> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33301807_3> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33301807_3" ;
    gutprop:hasSentenceText "Remodeling gut microbiota could be beneficial for the recovery of intestinal function and motor function after SCI." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33301807> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33301807_4> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33301807_4" ;
    gutprop:hasSentenceText "However, few studies have explored SCI with focus on the gut microbiota and \"microbiota-gut-brain\" axis." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33301807> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33301807_7> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33301807_7" ;
    gutprop:hasSentenceText "The current microbial research has shifted from descriptive to mechanismal perspective, and future research using new technologies may further demonstrate the pathophysiological mechanism of association of SCI with gut microbiota, elucidate the mode of interaction of gut microbiota and hosts, and help develop personalized microbiota-targeted therapies and drugs based on microbiota or corresponding metabolites." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33301807> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33318317_1> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33318317_1" ;
    gutprop:hasSentenceText "There is ample scientific and clinical evidence of the effects of gut microbiota on the brain but no definitive evidence that the brain can affect changes in gut microbiota under the bi-directional gut-brain axis concept." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33318317> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33318317_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33318317_2" ;
    gutprop:hasSentenceText "As there is no pharmacotherapeutic intervention for the early stages of cognitive decline, research has focused on cognitive stimulation in reversing or slowing the impairment." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33318317> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33318317_5> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33318317_5" ;
    gutprop:hasSentenceText "Here, we report that their cognitive impairment was improved and associated with changes in gut bacterial profile." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33318317> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33318317_8> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33318317_8" ;
    gutprop:hasSentenceText "This strongly suggests that signals from the different segments of brain could dictate directly or indirectly the abundances of specific gut microbes." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33318317> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33406628_5> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33406628_5" ;
    gutprop:hasSentenceText "We found microbial dysbiosis affecting lipid metabolism, including an upregulation of bacteria responsible for secondary bile acid synthesis." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33406628> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33416892_1> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33416892_1" ;
    gutprop:hasSentenceText "Recent and accumulating work in experimental animal models and humans shows that diet has a much more pervasive and prominent role than previously thought in modulating neuroinflammatory and neurodegenerative mechanisms leading to some of the most common chronic central nervous system (CNS) diseases." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33416892> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33422110_3> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33422110_3" ;
    gutprop:hasSentenceText "To our knowledge, this is the first study to examine microbiome alteration prior to the induction of a PD murine model." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33422110> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33422110_7> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33422110_7" ;
    gutprop:hasSentenceText "However, the DSS treatment caused marked changes in the gut microbiome and was also associated with augmented behavioral and inflammatory outcomes." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33422110> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33454868_3> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33454868_3" ;
    gutprop:hasSentenceText "Gut microbiota comprise the bacteria residing in a host's gastrointestinal tract." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33454868> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33467657_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33467657_0" ;
    gutprop:hasSentenceText "Mechanisms Underlying the Cognitive and Behavioural Effects of Maternal Obesity." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/33467657> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33467657_8> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33467657_8" ;
    gutprop:hasSentenceText "As the specific pathways shaping abnormal behaviour in offspring in the context of maternal obesogenic diet exposure remain unknown, further investigations are needed to address this knowledge gap." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33467657> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33467657_9> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33467657_9" ;
    gutprop:hasSentenceText "Use of animal models permits investigation of changes in neuroinflammation, neurotransmitter activity and hormones across global brain network and sex differences, which could be directly and indirectly modulated by the gut microbiome." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33467657> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33505487_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33505487_0" ;
    gutprop:hasSentenceText "Acupoint Massage Therapy Alters the Composition of Gut Microbiome in Functional Constipation Patients." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/33505487> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33511258_7> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33511258_7" ;
    gutprop:hasSentenceText "Meanwhile, the Shannon diversity index of the placebo group (<i>P</i> < 0.05) but not the probiotic group decreased significantly at week 12." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33511258> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33514545_1> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33514545_1" ;
    gutprop:hasSentenceText "Slow progress in the fight against neurodegenerative diseases (NDs) motivates an urgent need for highly controlled in vitro systems to investigate organ-organ- and organ-immune-specific interactions relevant for disease pathophysiology." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33514545> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33651324_11> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33651324_11" ;
    gutprop:hasSentenceText "The association of aerotolerant bacteria with social satisfaction and negative affect was independent of HIV status (p < 0.05, for both)." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33651324> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33664475_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33664475_2" ;
    gutprop:hasSentenceText "While sialylated human milk oligosaccharides (HMOs) have been implicated in phenotypic programming, their selective role and underlying mechanisms remained elusive." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33664475> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33664475_3> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33664475_3" ;
    gutprop:hasSentenceText "Here, we investigated the long-term consequences of a selective lactational deprivation of a specific sialylated HMO in mice." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33664475> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33664475_8> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33664475_8" ;
    gutprop:hasSentenceText "To detail the associated endophenotypes, we investigated hippocampal electrophysiology, plasma metabolomics, and gut microbiota composition." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33664475> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33677218_1> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33677218_1" ;
    gutprop:hasSentenceText "Evidence from previous studies has demonstrated that the gut-microbiota-brain axis is vital in regulating of behavior and neuroinflammation in the central nervous system." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33677218> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33677218_6> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33677218_6" ;
    gutprop:hasSentenceText "5-Hydroxytryptamine decreased in the chronic unpredictable mild stress rat model but significantly increased after fecal microbiota transplantation." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33677218> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33677218_7> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33677218_7" ;
    gutprop:hasSentenceText "The treatment with fecal microbiota transplantation decreased the production of IL-1β and TNF-α." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33677218> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33677218_9> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33677218_9" ;
    gutprop:hasSentenceText "Fecal microbiota transplantation can improve depression-like behaviors induced by chronic unpredictable mild stress." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33677218> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33693453_1> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33693453_1" ;
    gutprop:hasSentenceText "Over the past decade, the gut microbiota has emerged as a key component in regulating brain processes and behavior." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33693453> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33693453_4> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33693453_4" ;
    gutprop:hasSentenceText "Several mechanisms for gut-to-brain communication have been identified, including microbial metabolites, immune, neuronal, and metabolic pathways, some of which could be prone to dietary modulation." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33693453> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33693453_9> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33693453_9" ;
    gutprop:hasSentenceText "While promising results are reported, additional data, specifically from clinical cohorts, are required to provide evidence-based recommendations for the development of microbiota-targeted, whole-dietary strategies to improve brain and mental health." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33693453> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33713734_3> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33713734_3" ;
    gutprop:hasSentenceText "The gut microbiota was profiled using 16S rRNA gene amplicon sequencing." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33713734> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33722869_1> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33722869_1" ;
    gutprop:hasSentenceText "Research has highlighted relationships between the micro-organisms that inhabit our gastrointestinal tract (oral and gut microbiota) with host mood and gastrointestinal functioning." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33722869> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33722869_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33722869_2" ;
    gutprop:hasSentenceText "Mental health disorders and functional gastrointestinal disorders co-occur at high rates, although the mechanisms underlying these associations remain unclear." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33722869> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33722869_8> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33722869_8" ;
    gutprop:hasSentenceText "This study aims to use a systems biology approach to characterise oral and gut microbial composition <u>and</u> function using 16S rRNA gene sequencing and nuclear MR spectroscopy." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33722869> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33722869_9> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33722869_9" ;
    gutprop:hasSentenceText "As part of the ancillary component, it will collect questionnaire data from 1000 participants aged 18-40 years, capturing mental health, gastrointestinal health, oral health, diet and psychosocial factors." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33722869> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33782648_3> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33782648_3" ;
    gutprop:hasSentenceText "It is now acknowledged that neurological disorders are multi-factorial involving disruptions in multiple cellular systems." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33782648> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33807447_1> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33807447_1" ;
    gutprop:hasSentenceText "An essential role of the gut microbiota in health and disease is strongly suggested by recent research." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33807447> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33807447_3> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33807447_3" ;
    gutprop:hasSentenceText "A vegan diet is known to show beneficial health effects, yet the role of the gut microbiota is unclear." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33807447> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33807447_5> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33807447_5" ;
    gutprop:hasSentenceText "Alpha diversity as well as beta diversity did not differ significantly between MD and VD." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33807447> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33819374_1> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33819374_1" ;
    gutprop:hasSentenceText "In the nematode Caenorhabditis elegans, signals derived from bacteria in the diet, the animal's major nutrient source, can modulate both behavior and healthspan." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33819374> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33819374_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33819374_2" ;
    gutprop:hasSentenceText "Here we describe a dual role for trimethylamine (TMA), a human gut flora metabolite, which acts as a nutrient signal and a neurotoxin." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33819374> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33819374_8> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33819374_8" ;
    gutprop:hasSentenceText "Our results reveal conserved signaling pathways modulated by TMA in C. elegans that are likely to be relevant for its effects in mammalian systems." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33819374> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33825149_1> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33825149_1" ;
    gutprop:hasSentenceText "The search for therapeutic targets for Parkinson's disease (PD) is hindered by the incomplete understanding of the pathophysiology of the disease." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33825149> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33825149_4> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33825149_4" ;
    gutprop:hasSentenceText "Multiple lines of evidence suggest that the gut microbiota participates in the pathogenesis of PD." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33825149> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33825149_5> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33825149_5" ;
    gutprop:hasSentenceText "Gut microbial dysbiosis may contribute to the loss of dopaminergic neurons through mitochondrial dysfunction." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33825149> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33825149_8> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33825149_8" ;
    gutprop:hasSentenceText "We then review the possible ways in which microbial metabolites affect the central nervous system, as well as the impact of microbial metabolites on mitochondrial dysfunction." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33825149> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33825149_9> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33825149_9" ;
    gutprop:hasSentenceText "We finally discuss the possibility of gut microbiota as a therapeutic target for PD." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33825149> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33860090_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33860090_0" ;
    gutprop:hasSentenceText "Probiotics for Parkinson's disease: Current evidence and future directions." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/33860090> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33895287_12> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33895287_12" ;
    gutprop:hasSentenceText "This work has significant implications in the future treatment of anxiety in patients, and warrants future studies using microbe-based treatment options." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33895287> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33895287_4> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33895287_4" ;
    gutprop:hasSentenceText "The potential gut-to-brain pathway is poorly understood in patients receiving chemotherapy." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33895287> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33895287_8> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33895287_8" ;
    gutprop:hasSentenceText "In cohabitation studies, presumed coprophagia promoted body mass recovery, however strong associations with inflammation and behavior were not observed." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33895287> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33936013_10> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33936013_10" ;
    gutprop:hasSentenceText "Our data also indicate that the GAD-system might represent the only amino acid-dependent acid tolerance system in <i>Bacteroides</i>." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33936013> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33936013_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33936013_2" ;
    gutprop:hasSentenceText "The high neuroactive potential of metabolites produced by gut microbes has gained traction over the last few years, with metagenomic-based studies suggesting an important role of microbiota-derived γ-aminobutyric acid (GABA) in modulating mental health." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33936013> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33938181_3> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33938181_3" ;
    gutprop:hasSentenceText "GIP had a potent disruptive action on drug efflux pumps of the multidrug resistant bacteria" ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33938181> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33963284_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33963284_0" ;
    gutprop:hasSentenceText "Molecular mechanisms underlying the antidepressant actions of arketamine: beyond the NMDA receptor." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/33963284> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33963284_7> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33963284_7" ;
    gutprop:hasSentenceText "Collectively, the available studies indicate that it is unlikely that NMDAR plays a major role in the antidepressant action of (R,S)-ketamine and its enantiomers, although the precise molecular mechanisms underlying antidepressant actions of (R,S)-ketamine and its enantiomers remain unclear." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33963284> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33963284_8> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33963284_8" ;
    gutprop:hasSentenceText "In this paper, we review recent findings on the molecular mechanisms underlying the antidepressant actions of (R,S)-ketamine and its potent enantiomer arketamine." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33963284> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33968794_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33968794_0" ;
    gutprop:hasSentenceText "Review: The Role of Intestinal Dysbiosis in Parkinson's Disease." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/33968794> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33968794_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33968794_2" ;
    gutprop:hasSentenceText "Clinical symptoms and neuropathology have suggested that Parkinson's disease may originate in the gut, which is home to approximately 100 trillion microbes." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33968794> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33968794_7> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33968794_7" ;
    gutprop:hasSentenceText "Additional studies remain necessary to explore and verify the mechanisms through which dysbiosis may cause or promote Parkinson's disease." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33968794> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34002020_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34002020_0" ;
    gutprop:hasSentenceText "Endocannabinoid system mediates the association between gut-microbial diversity and anhedonia/amotivation in a general population cohort." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/34002020> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34002020_1> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34002020_1" ;
    gutprop:hasSentenceText "Anhedonia and amotivation are debilitating symptoms and represent unmet therapeutic needs in a range of clinical conditions." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34002020> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34002020_12> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34002020_12" ;
    gutprop:hasSentenceText "We found a direct, significant, association between alpha diversity and anhedonia/amotivation (β = -0.37; 95%CI: -0.71 to -0.03; P = 0.03)." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34002020> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34002020_14> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34002020_14" ;
    gutprop:hasSentenceText "Our results suggest that gut-microbial diversity might contribute to anhedonia/amotivation via the endocannabinoid system." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34002020> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34002020_15> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34002020_15" ;
    gutprop:hasSentenceText "These findings shed light on the biological underpinnings of anhedonia/amotivation and suggest the gut microbiota-endocannabinoid axis as a promising therapeutic target in an area of unmet clinical need." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34002020> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34002020_3> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34002020_3" ;
    gutprop:hasSentenceText "Based on results obtained from animal models, we tested the hypothesis that the endocannabinoid system mediates the association between gut-microbiome diversity and anhedonia/amotivation in a general population cohort." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34002020> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34002020_7> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34002020_7" ;
    gutprop:hasSentenceText "PEA is considered the endogenous equivalent of cannabidiol, with increased serum levels believed to have anti-depressive effects, while increased stool PEA levels, reflecting increased excretion, are believed to have opposite, detrimental, effects on mental health." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34002020> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34004259_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34004259_2" ;
    gutprop:hasSentenceText "The brain-gut-microbiota axis has a crucial role in bidirectional interactions between the brain and the gastrointestinal microbiota." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34004259> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34004259_5> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34004259_5" ;
    gutprop:hasSentenceText "However, we found significant changes in relative abundance for several bacteria in the CNO (or C21) group at the taxonomic level compared to the control group." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34004259> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34014031_11> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34014031_11" ;
    gutprop:hasSentenceText "Activated neuroinflammation eventually contributes to the occurrence and development of BD." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34014031> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34014031_12> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34014031_12" ;
    gutprop:hasSentenceText "This review provides a new perspective on how gut microbiota participate in the pathogenesis of BD." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34014031> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34014031_5> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34014031_5" ;
    gutprop:hasSentenceText "Intestine microbiota is increasingly recognized as a critical environmental factor for human health and diseases via the microbiota-gut-brain axis." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34014031> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34032650_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34032650_0" ;
    gutprop:hasSentenceText "Psychobiotics: Evolution of Novel Antidepressants." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/34032650> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34032650_1> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34032650_1" ;
    gutprop:hasSentenceText "The gut-brain axis is a bidirectional communication system which allows the central nervous system and gastrointestinal tract to interact with and respond to each other rapidly and effectively." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34032650> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34032650_4> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34032650_4" ;
    gutprop:hasSentenceText "It was initially demonstrated in a rodent model of depression that the gut microbiota was altered." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34032650> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34032650_6> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34032650_6" ;
    gutprop:hasSentenceText "Furthermore, when rodents receive a microbiota transplant from a depressed patient their behaviour alters, as does their tryptophan metabolism and immune status." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34032650> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34032650_8> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34032650_8" ;
    gutprop:hasSentenceText "While some psychobiotics have shown efficacy in treating depression, other bacteria have yielded negative findings." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34032650> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34074025_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34074025_0" ;
    gutprop:hasSentenceText "MAIT Cells and Microbiota in Multiple Sclerosis and Other Autoimmune Diseases." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/34074025> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34074025_3> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34074025_3" ;
    gutprop:hasSentenceText "This review is aimed at analyzing the changes of MAIT cells, as well as of the microbiota, in multiple sclerosis and other autoimmune disorders." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34074025> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34074025_4> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34074025_4" ;
    gutprop:hasSentenceText "Common features of dysbiosis in these conditions are the reduced richness of microbial species and the unbalance between pro-inflammatory and immune regulatory components of the gut microbiota." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34074025> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34092293_4> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34092293_4" ;
    gutprop:hasSentenceText "Here, CCRA model was successfully induced by subcutaneous inoculation of CT-26 and i.p." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34092293> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34098340_10> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34098340_10" ;
    gutprop:hasSentenceText "A healthy prenatal diet indirectly related to decreased child internalising behaviours via higher alpha diversity of maternal faecal microbiota." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34098340> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34098340_3> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34098340_3" ;
    gutprop:hasSentenceText "This study aimed to evaluate relationships between the prenatal faecal microbiota, prenatal diet and childhood behaviour." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34098340> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34098340_4> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34098340_4" ;
    gutprop:hasSentenceText "A sub-cohort of 213 mothers and 215 children were selected from a longitudinal pre-birth cohort." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34098340> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34098340_5> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34098340_5" ;
    gutprop:hasSentenceText "Maternal prenatal exposure measures collected during the third trimester included the faecal microbiota (generated using 16S rRNA amplicon sequencing), and dietary intake." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34098340> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34147969_1> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34147969_1" ;
    gutprop:hasSentenceText "The brain-gut-microbiota axis plays a crucial role in the bidirectional interactions between the brain and the gut." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34147969> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34147969_6> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34147969_6" ;
    gutprop:hasSentenceText "Behavioral, biochemical tests and 16S ribosome RNA analysis were performed." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34147969> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34172092_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34172092_2" ;
    gutprop:hasSentenceText "We hypothesized that the gut microbiota shifts might also have an effect on cognitive functions in T1D." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34172092> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34172092_6> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34172092_6" ;
    gutprop:hasSentenceText "Exogenous acetate supplement or fecal microbiota transplant recovered hippocampal SYP level in vancomycin-treated T1D mice, and this effect was attenuated by vagal inhibition or vagotomy." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34172092> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34174901_12> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34174901_12" ;
    gutprop:hasSentenceText "These results provide an exciting new target of minocycline as a therapeutic for central nervous system diseases and injuries." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34174901> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34174901_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34174901_2" ;
    gutprop:hasSentenceText "The majority of studies show that minocycline can reduce tissue damage and improve functional recovery following central nervous system injuries, mainly attributed to the drug's direct anti-inflammatory, anti-oxidative, and neuroprotective properties." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34174901> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34174901_5> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34174901_5" ;
    gutprop:hasSentenceText "We investigated a group that received minocycline following spinal cord injury (immediately after injury for 7 days), an untreated spinal cord injury group, an untreated uninjured group, and an uninjured group that received minocycline." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34174901> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34204057_6> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34204057_6" ;
    gutprop:hasSentenceText "There is also evidence highlighting the impact of healthy nutrition in female people on the composition of the gut microbiota and future metabolic and overall health of their offspring." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34204057> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34205336_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34205336_0" ;
    gutprop:hasSentenceText "Regulation of Neurotransmitters by the Gut Microbiota and Effects on Cognition in Neurological Disorders." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/34205336> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34205336_1> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34205336_1" ;
    gutprop:hasSentenceText "Emerging evidence indicates that gut microbiota is important in the regulation of brain activity and cognitive functions." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34205336> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34216356_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34216356_0" ;
    gutprop:hasSentenceText "The Relationship Between the Gut Microbiome and Neurodegenerative Diseases." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/34216356> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34216356_5> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34216356_5" ;
    gutprop:hasSentenceText "But the exact relationship between neurodegenerative diseases and gut microbiota remains unclear." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34216356> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34250955_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34250955_0" ;
    gutprop:hasSentenceText "Parkinson's Disease and the Gut: Symptoms, Nutrition, and Microbiota." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/34250955> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34250955_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34250955_2" ;
    gutprop:hasSentenceText "Recently, there has been a growing focus on the relationship between the gut and the development of PD." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34250955> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34250955_4> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34250955_4" ;
    gutprop:hasSentenceText "This review is aimed at highlighting the relationship between PD and the gastrointestinal tract, along with the supporting evidence for this." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34250955> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34277527_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34277527_2" ;
    gutprop:hasSentenceText "Multiple genetic and non-genetic (exposome) factors interact early in life, modulating the risk of developing the most common complex neurodevelopmental disorders (NDDs), with potential long-term consequences on health." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34277527> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34277527_4> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34277527_4" ;
    gutprop:hasSentenceText "The crucial role played by diet and gut microbiota in brain development and functioning would indicate that modulating the gut-brain axis may help protect against the onset and progression of mental-health disorders." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34277527> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34277527_9> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34277527_9" ;
    gutprop:hasSentenceText "Furthermore, we describe the evidence supporting the key role played by gut microbiota, diet and nutrition in neurodevelopment, as well as the effectiveness of certain dietary and microbiome-based interventions aimed at preventing or treating NDDs." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34277527> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34290352_1> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34290352_1" ;
    gutprop:hasSentenceText "The alterations in the gut microbiota have been reported to be correlated with the development of depression." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34290352> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34290352_10> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34290352_10" ;
    gutprop:hasSentenceText "The metabolic function of gut microbiota after treatment was still different from that of the control group." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34290352> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34290352_4> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34290352_4" ;
    gutprop:hasSentenceText "The MDD group received individualized treatment with escitalopram at a maximum dose of 20 mg/day." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34290352> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34290352_8> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34290352_8" ;
    gutprop:hasSentenceText "Alpha diversity was significantly higher in MDD group than those of the other groups, and the alpha diversity was not significantly different between control and follow-up groups." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34290352> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34311029_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34311029_0" ;
    gutprop:hasSentenceText "Fatty acids and beyond: Age and Alzheimer's disease related changes in lipids reveal the neuro-nutraceutical potential of lipids in cognition." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/34311029> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34357134_1> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34357134_1" ;
    gutprop:hasSentenceText "In schizophrenia, social cognitive impairment is considered one of the greatest obstacles to social participation." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34357134> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34357554_1> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34357554_1" ;
    gutprop:hasSentenceText "The neurodegeneration and its related CNS pathologies need an urgent toolbox to minimize the global mental health burden." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34357554> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34357554_6> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34357554_6" ;
    gutprop:hasSentenceText "The gut microbiota and CNS communicate using a common language that synchronizes the tuning of immune cells." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34357554> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34357554_7> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34357554_7" ;
    gutprop:hasSentenceText "The intestinal gut microbial community has a profound role in the maturation of the immune system as well as the development of the nervous system." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34357554> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34393849_1> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34393849_1" ;
    gutprop:hasSentenceText "Increasing evidence indicates an interaction between dysbiosis of the microbiota and the pathogenesis of schizophrenia." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34393849> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34393849_11> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34393849_11" ;
    gutprop:hasSentenceText "The study findings suggest that alterations in certain gut microbiota may interfere with psychological symptoms in schizophrenia." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34393849> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34393849_8> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34393849_8" ;
    gutprop:hasSentenceText "The beta-diversity of microbiota composition in the acute group was distinct from that in the remission and control groups (PC1 = 21.11% vs. PC2 = 12.86%, <i>P</i> = 0.021)." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34393849> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34408160_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34408160_0" ;
    gutprop:hasSentenceText "Exploring human-genome gut-microbiome interaction in Parkinson's disease." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/34408160> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34422879_10> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34422879_10" ;
    gutprop:hasSentenceText "Many studies have associated the Mediterranean diet with a decreased risk of dementia and AD, but a cause-and-effect relationship has not been deduced." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34422879> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34422879_13> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34422879_13" ;
    gutprop:hasSentenceText "Furthermore, the gut microbiome, being deeply involved in nutrient uptake and lipid metabolism, also represents a pillar of the gut microbiome-brain axis and is linked with the pathogenesis of NDD." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34422879> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34422879_4> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34422879_4" ;
    gutprop:hasSentenceText "Numerous factors are involved in the pathogenesis of NDD: genetic variability, epigenetic changes, extent of oxidative/nitrosative stress, mitochondrial dysfunction, and DNA damage." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34422879> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34422879_8> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34422879_8" ;
    gutprop:hasSentenceText "Individuals affected by NDD almost inevitably have low-grade inflammation and anomalies in lipid metabolism." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34422879> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34437440_3> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34437440_3" ;
    gutprop:hasSentenceText "Recent data suggest that certain bacterial toxins implicated in DNA attack or in proliferation, replication, and death can be risk factors for insurgence and progression of CRC." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34437440> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34437440_5> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34437440_5" ;
    gutprop:hasSentenceText "We also analyzed to determine whether CRC-predisposing genetic factors could contribute to bacterial toxins response." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34437440> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34444820_11> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34444820_11" ;
    gutprop:hasSentenceText "Our findings suggest that probiotic NVP-1704 could be beneficial for mental health and sleep." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34444820> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34444820_9> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34444820_9" ;
    gutprop:hasSentenceText "NVP-1704 treatment led to a decrease in serum interleukin-6 levels." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34444820> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34480631_1> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34480631_1" ;
    gutprop:hasSentenceText "PLX5622, a brain-penetrant highly specific inhibitor of the colony-stimulating factor 1 receptor (CSF1R), is used to eliminate microglia in the brain." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34480631> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34520319_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34520319_0" ;
    gutprop:hasSentenceText "Sleep, circadian rhythm and gut microbiota: alterations in Alzheimer's disease and their potential links in the pathogenesis." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/34520319> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34520319_3> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34520319_3" ;
    gutprop:hasSentenceText "Moreover, reports have demonstrated that GM and its metabolites exhibit diurnal rhythmicity and the role of SCRD in dampening the GM rhythmicity and eubiosis." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34520319> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34520319_5> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34520319_5" ;
    gutprop:hasSentenceText "It aims to identify the overlapping and distinctive GM alterations in these conditions and their contributions to pathophysiology." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34520319> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34520319_6> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34520319_6" ;
    gutprop:hasSentenceText "Although most studies are observational and use different methodologies, data indicate partial commonalities in GM alterations and unanimity at functional level." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34520319> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34560239_1> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34560239_1" ;
    gutprop:hasSentenceText "Increasing evidence suggests the role of gut-microbiota-brain axis in the pathogenesis of Parkinson's disease (PD)." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34560239> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34560239_8> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34560239_8" ;
    gutprop:hasSentenceText "Moreover, MPTP did not alter the levels of SCFAs in feces samples." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34560239> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34560239_9> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34560239_9" ;
    gutprop:hasSentenceText "However, there was a positive correlation between the relative abundance of the genus Faecalicatena and propionic acid." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34560239> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34576000_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34576000_0" ;
    gutprop:hasSentenceText "Nuclear and Mitochondrial Genome, Epigenome and Gut Microbiome: Emerging Molecular Biomarkers for Parkinson's Disease." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/34576000> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34576000_4> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34576000_4" ;
    gutprop:hasSentenceText "There are no effective tools to prevent PD onset, detect the disease in early stages or accurately report the risk of disease progression." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34576000> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34576000_7> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34576000_7" ;
    gutprop:hasSentenceText "Genomic variation, regulation by epigenomic mechanisms, as well as the influence of the host gut microbiome seem to have a crucial role in the onset and progress of PD, thus are considered potential biomarkers." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34576000> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34576833_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34576833_0" ;
    gutprop:hasSentenceText "Specific Changes in the Mammalian Gut Microbiome as a Biomarker for Oxytocin-Induced Behavioral Changes." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/34576833> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34576833_1> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34576833_1" ;
    gutprop:hasSentenceText "Prolonged exposure to psychiatric pharmacological agents is often associated with marked gastrointestinal phenomena, including changes in food intake, bowel motility, gastric emptying, and transit time." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34576833> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34576833_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34576833_2" ;
    gutprop:hasSentenceText "Those changes are reflected in the gut microbiota composition of the patient and can, therefore, be objectively measured." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34576833> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34576833_5> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34576833_5" ;
    gutprop:hasSentenceText "Changes in the levels of specific drug-sensitive bacterial species can, thus, potentially serve as biomarkers for the intake and effectiveness of psychiatric drugs." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34576833> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34576833_7> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34576833_7" ;
    gutprop:hasSentenceText "Compared with oxytocin, citalopram produced more minor effects on the rats' microbiota." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34576833> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34576833_8> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34576833_8" ;
    gutprop:hasSentenceText "Alterations in the gut microbiota may, therefore, reflect the consumption and effectiveness of some psychiatric drugs." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34576833> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34589800_3> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34589800_3" ;
    gutprop:hasSentenceText "Next, potential inflammatory pathways mediating the communications between the gut and the brain under stressful conditions are described." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34589800> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34603341_6> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34603341_6" ;
    gutprop:hasSentenceText "The butylated starch's neurological and immunological benefits may be derived from the gut microbiome modifications, including normalizing the abundance of certain beneficial microbes (<i>Odoribacter</i> and <i>Oscillibacter</i>) and metabolomic pathways (<i>Tryptophan synthesis</i> and <i>Inositol degradation</i>)." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34603341> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34692176_11> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34692176_11" ;
    gutprop:hasSentenceText "<b>Results:</b> Although there is a substantial literature identifying major contributing factors with IBD, there has been little attempt to integrate some factors over time and assess their interplay and relationship with IBD disease activity." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34692176> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34692176_12> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34692176_12" ;
    gutprop:hasSentenceText "Such contributing factors include genetic and environmental factors, gut microbiota composition and function, physiological factors, psychological state and gut immune response." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34692176> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34692176_13> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34692176_13" ;
    gutprop:hasSentenceText "Interdependences are evident across psychological and biological factors and IBD disease activity." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34692176> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34692176_14> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34692176_14" ;
    gutprop:hasSentenceText "Although from the available evidence, it is implausible that a single explanatory model could elucidate the interplay between such factors and the disease course as well as the sequence of the effect during the pathophysiology of IBD." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34692176> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34692176_15> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34692176_15" ;
    gutprop:hasSentenceText "<b>Conclusion:</b> Longitudinal monitoring of IBD patients and integrating data related to the contributing/risk factors including psychological state, physiological conditions, inflammatory/immune modulations, and microbiome composition/function, could help to explain how major factors associate and interrelate leading to exacerbation of symptoms and disease activity." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34692176> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34692176_3> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34692176_3" ;
    gutprop:hasSentenceText "The aetiology, severity and progression of such disorders are still poorly understood but thought to be influenced by multiple factors (including genetic, environmental, immunological, physiological, psychological factors and gut microbiome) and their interactions." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34692176> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34692176_5> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34692176_5" ;
    gutprop:hasSentenceText "A broader conceptual and longitudinal framework of possible neuro-visceral integration, core microbiome analysis and immune modulation assessment may be useful in accurately documenting and characterizing the nature and temporal continuity of crosstalk between these factors and the role of their interaction (s) in IBD disease activity." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34692176> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34704023_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34704023_0" ;
    gutprop:hasSentenceText "Gut microbiome alpha-diversity is not a marker of Parkinson's disease and multiple sclerosis." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/34704023> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34704023_10> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34704023_10" ;
    gutprop:hasSentenceText "Five studies were meta-analysed for multiple sclerosis, corresponding to 303 subjects (164 Multiple Sclerosis/139 healthy controls)." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34704023> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34704023_11> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34704023_11" ;
    gutprop:hasSentenceText "For Alzheimer's disease, the meta-analysis was not done as only two studies matched our criteria." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34704023> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34704023_13> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34704023_13" ;
    gutprop:hasSentenceText "Shannon index was neither associated with neurological disorders (<i>P</i>-value > 0.05)." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34704023> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34704023_9> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34704023_9" ;
    gutprop:hasSentenceText "Seven studies were meta-analysed for Parkinson's disease, corresponding to 1067 subjects (631 Parkinson's Disease/436 healthy controls)." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34704023> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34758889_1> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34758889_1" ;
    gutprop:hasSentenceText "Cognitive impairment, an increasing mental health issue, is a core feature of the aging brain and neurodegenerative diseases." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34758889> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34758889_11> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34758889_11" ;
    gutprop:hasSentenceText "Moreover, the FD diet compromised the intestinal barrier and reduced short-chain fatty acid (SCFA) production." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34758889> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34758889_13> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34758889_13" ;
    gutprop:hasSentenceText "This study, for the first time, reports that a fiber-deprived diet leads to cognitive impairment through altering the gut microbiota-hippocampal axis, which is pathologically distinct from normal brain aging." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34758889> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34758889_6> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34758889_6" ;
    gutprop:hasSentenceText "We found that FD mice showed impaired cognition, including deficits in object location memory, temporal order memory, and the ability to perform daily living activities." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34758889> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34776854_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34776854_0" ;
    gutprop:hasSentenceText "Changes in the Gut Microbiome and Predicted Functional Metabolic Effects in an Australian Parkinson's Disease Cohort." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/34776854> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34776854_3> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34776854_3" ;
    gutprop:hasSentenceText "<b>Methods:</b> The study involved recruitment and assessment of 87 PwP from multiple Movement Disorders Clinics in Australia and 47 healthy controls." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34776854> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34776854_5> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34776854_5" ;
    gutprop:hasSentenceText "<b>Results:</b> The current findings identified significant differences in relative abundance and diversity of microbial operational taxonomic units (OTUs), and specific bacterial taxa between PwP and control groups." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34776854> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34776854_9> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34776854_9" ;
    gutprop:hasSentenceText "Furthermore, KEGG analysis identified 15 upregulated and 11 downregulated metabolic pathways which were predicted to be significantly altered in PwP." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34776854> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34830610_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34830610_0" ;
    gutprop:hasSentenceText "Targeting the Gut Microbiome in Prader-Willi Syndrome." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/34830610> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34830610_5> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34830610_5" ;
    gutprop:hasSentenceText "Here, we review the knowledge obtained to this date regarding the gut microbiome in individuals with Prader-Willi syndrome." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34830610> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34836918_7> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34836918_7" ;
    gutprop:hasSentenceText "Additionally, BMAA induced <i>in vitro</i> and <i>in vivo</i> mitochondrial dysfunction with cardiolipin exposure and consequent activation of neuronal innate immunity." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34836918> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34870091_10> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34870091_10" ;
    gutprop:hasSentenceText "<b>Discussion:</b> Changes in microbiota composition in psychosis and schizophrenia have been correlated with alternations in brain structure and function, altered immunity, altered metabolic pathways and symptom severity." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34870091> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34870091_7> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34870091_7" ;
    gutprop:hasSentenceText "<b>Methods:</b> Original studies involving humans and animals using a case-control, cohort or cross-sectional design will be included." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34870091> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34908715_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34908715_2" ;
    gutprop:hasSentenceText "There is differential increase in evidences focusing on the bidirectional communication between the gut microbiome and the brain." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34908715> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34908715_6> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34908715_6" ;
    gutprop:hasSentenceText "Stress can affect the microbiota-gut-brain axis at every stages of life." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34908715> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34908715_8> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34908715_8" ;
    gutprop:hasSentenceText "The current studies target on elaborating the underlying mechanisms of microbiota-gut-brain axis and attempt to exemplify intervention and therapeutic strategies for neuropsychiatric disorders." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34908715> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34961418_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34961418_2" ;
    gutprop:hasSentenceText "It is important to prevent mild metabolic disorders progressing to metabolic syndrome." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34961418> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34970638_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34970638_2" ;
    gutprop:hasSentenceText "Explore the heterogeneity of microbiota-gut-brain axis and new pathogenic characteristics in murine models of depression." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34970638> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34985325_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34985325_0" ;
    gutprop:hasSentenceText "A Comprehensive Review on the Role of the Gut Microbiome in Human Neurological Disorders." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/34985325> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34985325_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34985325_2" ;
    gutprop:hasSentenceText "The initial acquisition of microbiota occurs from both the external and maternal environments, and the vast majority of them colonize the gastrointestinal tract (GIT)." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34985325> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35069178_3> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_35069178_3" ;
    gutprop:hasSentenceText "However, recent research suggests a potential relationship between the commensal gut bacteria and the brain capable of influencing neurodevelopment, brain function and health." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35069178> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35069178_6> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_35069178_6" ;
    gutprop:hasSentenceText "This review will provide an overview of and critically discuss the current knowledge of the relationship between the gut microbiota and Parkinson's disease." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35069178> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35069178_8> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_35069178_8" ;
    gutprop:hasSentenceText "Finally, we will highlight the potential opportunity for the development of novel preventative measures and therapeutic options that could target the microbiome-gut-brain axis in the context of Parkinson's disease." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35069178> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35203906_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_35203906_0" ;
    gutprop:hasSentenceText "Parkinson's Disease in Light of the COVID-19 Pandemic." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/35203906> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35207632_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_35207632_0" ;
    gutprop:hasSentenceText "Gastrointestinal Dysfunction in Parkinson's Disease: Current and Potential Therapeutics." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/35207632> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35207632_7> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_35207632_7" ;
    gutprop:hasSentenceText "However, the resurgence of interest in understanding how the GI tract is involved in various disease states, such as PD, has resulted in the identification of novel therapeutic avenues." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35207632> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35281490_1> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_35281490_1" ;
    gutprop:hasSentenceText "The human gut microbiota is a complex, dynamic, and highly diverse community of microorganisms." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35281490> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35281490_4> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_35281490_4" ;
    gutprop:hasSentenceText "Evidence from large-population cohort studies suggests that individuals with neurodegenerative conditions have an altered gut microbial composition as well as microbial and serum metabolomic profiles distinct from those in the healthy population." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35281490> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35281490_9> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_35281490_9" ;
    gutprop:hasSentenceText "In addition, we also discuss how pathogenic transformation of microbial composition leads to increased endotoxin production and fewer beneficial metabolites, both of which could trigger immune cell activation and enteric neuronal dysfunction." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35281490> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35317228_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_35317228_0" ;
    gutprop:hasSentenceText "Analysis methods for the gut microbiome in neuropsychiatric and neurodegenerative disorders." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/35317228> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35317228_4> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_35317228_4" ;
    gutprop:hasSentenceText "In this review, we provide an overview of the link between the gut microbiome and neuropsychiatric or neurodegenerative disorders." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35317228> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35317228_5> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_35317228_5" ;
    gutprop:hasSentenceText "We also introduce analytical methods used to assess the connection between the gut microbiome and the brain." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35317228> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35326429_1> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_35326429_1" ;
    gutprop:hasSentenceText "Several bacterial species can generate hydrogen sulfide (H<sub>2</sub>S)." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35326429> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35326429_5> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_35326429_5" ;
    gutprop:hasSentenceText "These events can lead to the formation of alpha-synuclein oligomers and fibrils in cells containing the alpha-synuclein protein." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35326429> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35326429_6> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_35326429_6" ;
    gutprop:hasSentenceText "In addition, bacterially produced H<sub>2</sub>S can interfere with the body urate metabolism and affect the blood erythrocytes and lymphocytes." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35326429> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35432226_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_35432226_0" ;
    gutprop:hasSentenceText "To the Gut Microbiome and Beyond: The Brain-First or Body-First Hypothesis in Parkinson's Disease." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/35432226> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35432226_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_35432226_2" ;
    gutprop:hasSentenceText "Recently, evidence has been provided for both, with Parkinson's disease onset presenting as either a \"body-first\" or \"brain-first\" progression." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35432226> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35432226_6> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_35432226_6" ;
    gutprop:hasSentenceText "Future microbiome research should consider this hypothesis and investigate whether gut microbiome differences exist between each type of progression." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35432226> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35565918_1> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_35565918_1" ;
    gutprop:hasSentenceText "The ketogenic diet (KD) is a high-fat, low-carbohydrate and adequate-protein diet that has gained popularity in recent years in the context of neurological diseases (NDs)." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35565918> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35571084_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_35571084_0" ;
    gutprop:hasSentenceText "Using <i>Caenorhabditis elegans</i> to Model Therapeutic Interventions of Neurodegenerative Diseases Targeting Microbe-Host Interactions." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/35571084> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35571084_10> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_35571084_10" ;
    gutprop:hasSentenceText "elegans</i> and mouse ND models, we found that about half of them are known to inhibit bacterial growth or biofilm formation, suggesting a strong correlation between the neuroprotective and antibiofilm activities." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35571084> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35571084_14> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_35571084_14" ;
    gutprop:hasSentenceText "elegans</i> ND models can serve as a platform for fast, high-throughput, and low-cost drug screens that target the microbe-host interaction in NDs." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35571084> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35571084_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_35571084_2" ;
    gutprop:hasSentenceText "Although how microbes modulate neurodegeneration is still mostly unclear, recent studies have started to probe into the mechanisms for the communication between microbes and hosts in NDs." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35571084> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35654142_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_35654142_0" ;
    gutprop:hasSentenceText "Mechanistic insights into accelerated α-synuclein aggregation mediated by human microbiome-associated functional amyloids." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/35654142> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35654142_6> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_35654142_6" ;
    gutprop:hasSentenceText "These CsgA homologs display diverse aggregation kinetics, and they differ in their ability to modulate α-synuclein aggregation." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35654142> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35674870_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_35674870_2" ;
    gutprop:hasSentenceText "In this context, mechanisms related to immune response can act as modifiers at different steps of the neurodegenerative process and justify the growing interest in anti-inflammatory agents as potential disease-modifying treatments in PD." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35674870> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35674870_8> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_35674870_8" ;
    gutprop:hasSentenceText "the gut microbiome) and those related to the genetic background of affected patients." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35674870> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35674870_9> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_35674870_9" ;
    gutprop:hasSentenceText "Starting from the lesson provided by familial forms of PD, we will discuss pathophysiological mechanisms linked to inflammation that could also play a role in idiopathic forms." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35674870> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35722294_4> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_35722294_4" ;
    gutprop:hasSentenceText "Our data showed that the composition of fecal microbiota was different from that of blood and brain." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35722294> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35722294_9> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_35722294_9" ;
    gutprop:hasSentenceText "Further studies are greatly encouraged to determine the role of <i>Blautia</i> genus in the pathogenesis of PD." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35722294> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35965349_13> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_35965349_13" ;
    gutprop:hasSentenceText "As alternative feed additives are developed to mimic the action of AGPs, our study highlights the need to ensure such alternatives result in functional changes that are consistent with site-, age-, and diet-associated taxa." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35965349> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35965349_15> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_35965349_15" ;
    gutprop:hasSentenceText "Consequently, the data generated in this study will be crucial for the development of next-generation feed additives targeting gut health and poultry production." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35965349> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35965349_8> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_35965349_8" ;
    gutprop:hasSentenceText "Functional investigations were performed through metatranscriptomics analyses and metabolomics." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35965349> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36056574_4> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_36056574_4" ;
    gutprop:hasSentenceText "Depressive symptoms (PROMIS Short Form-Depression) and sleep quality (Pittsburgh Sleep Quality Index [PSQI]) were collected via surveys." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36056574> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36056574_5> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_36056574_5" ;
    gutprop:hasSentenceText "PROMIS measure T-score > 55 indicates positive depressive symptoms, and a total PSQI score > 5 indicates sleep disturbance." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36056574> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36056574_6> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_36056574_6" ;
    gutprop:hasSentenceText "16S rRNA V3-V4 gene regions were sequenced from fecal specimens to measure GM." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36056574> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36072564_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_36072564_0" ;
    gutprop:hasSentenceText "Age-dependent effects of gut microbiota metabolites on brain resident macrophages." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/36072564> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36072564_3> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_36072564_3" ;
    gutprop:hasSentenceText "Besides dietary changes and frequent use of antibiotics, the microbiome is also profoundly affected by aging." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36072564> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36072680_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_36072680_0" ;
    gutprop:hasSentenceText "Dietary Modification for the Restoration of Gut Microbiome and Management of Symptoms in Irritable Bowel Syndrome." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/36072680> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36072680_4> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_36072680_4" ;
    gutprop:hasSentenceText "Whereas there are various management approaches cited in the literature to manage symptoms of IBS, the purpose of this article is to focus on dietary options that will restore the gut microbiome and help in managing IBS symptoms." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36072680> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36072680_6> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_36072680_6" ;
    gutprop:hasSentenceText "The clinical practice guidelines recommended by the American College of Gastroenterology outlines evidence-based dietary recommendations for patients with IBS to manage symptoms." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36072680> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36191806_10> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_36191806_10" ;
    gutprop:hasSentenceText "Network analysis showed correlations between relative abundance of several microbiome and plasma metabolites (or behavioral data)." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36191806> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36191806_8> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_36191806_8" ;
    gutprop:hasSentenceText "Furthermore, there were several plasma metabolites altered among the three groups." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36191806> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36191806_9> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_36191806_9" ;
    gutprop:hasSentenceText "Moreover, there were correlations between relative abundance of several microbiome and behavioral data (or synaptic proteins)." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36191806> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36216056_11> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_36216056_11" ;
    gutprop:hasSentenceText "Verrucomicrobia was negatively correlated with the level of estriol, which was correlated with decreased learning and spatial memory." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36216056> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36216056_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_36216056_2" ;
    gutprop:hasSentenceText "Disturbance of gut microbiome was involved in SCZ." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36216056> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36332796_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_36332796_0" ;
    gutprop:hasSentenceText "Gut microbiome and Parkinson's disease: Perspective on pathogenesis and treatment." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/36332796> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36332796_1> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_36332796_1" ;
    gutprop:hasSentenceText "Parkinson's disease (PD) is a disease of ⍺-synuclein aggregation-mediated dopaminergic neuronal loss in the substantia nigra pars compacta, which leads to motor and non-motor symptoms." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36332796> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36332796_11> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_36332796_11" ;
    gutprop:hasSentenceText "In some studies, probiotics have been shown to exert anti-oxidative effects in PD via improved mitochondrial dynamics and homeostasis, thus reducing PD-related consequences." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36332796> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36332796_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_36332796_2" ;
    gutprop:hasSentenceText "Through the last two decades of research, there has been growing consensus that inflammation-mediated oxidative stress, mitochondrial dysfunction, and cytokine-induced toxicity are mainly involved in neuronal damage and loss associated with PD." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36332796> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36332796_3> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_36332796_3" ;
    gutprop:hasSentenceText "However, it remains unclear how these mechanisms relate to sporadic PD, a more common form of PD." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36332796> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36346385_10> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_36346385_10" ;
    gutprop:hasSentenceText "However, prebiotic feeding reverses pathogenic microglial states in ASO mice and promotes expansion of protective disease-associated macrophage (DAM) subsets of microglia." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36346385> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36411639_7> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_36411639_7" ;
    gutprop:hasSentenceText "Disturbance in gut microbiota composition can alter the central nervous system and enteric nervous system functions." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36411639> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36462169_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_36462169_0" ;
    gutprop:hasSentenceText "Elevated Systemic Levels of Markers Reflecting Intestinal Barrier Dysfunction and Inflammasome Activation Are Correlated in Severe Mental Illness." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/36462169> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36493975_8> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_36493975_8" ;
    gutprop:hasSentenceText "There were also correlations between demyelination or microglial activation in the brain and blood levels of metabolites." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36493975> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36532064_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_36532064_0" ;
    gutprop:hasSentenceText "Hypothesis of a potential BrainBiota and its relation to CNS autoimmune inflammation." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/36532064> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36532064_3> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_36532064_3" ;
    gutprop:hasSentenceText "We discuss the hypothesis of a brain microbiota, the BrainBiota: bacteria living in symbiosis with brain cells." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36532064> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36532064_4> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_36532064_4" ;
    gutprop:hasSentenceText "Existence of various bacteria in the human brain is suggested by morphological evidence, presence of bacterial proteins, metabolites, transcripts and mucosal-associated invariant T cells." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36532064> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36550591_13> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_36550591_13" ;
    gutprop:hasSentenceText "XPJYF improved behaviors and repressed astrocyte activation in depression rats." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36550591> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36550591_7> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_36550591_7" ;
    gutprop:hasSentenceText "Microbiota culturing in vitro after XPJYF treatment was analyze by 16 s RNA sequencing technology." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36550591> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36550591_8> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_36550591_8" ;
    gutprop:hasSentenceText "We used lipopolysaccharide (LPS) to mimic activated rat primary astrocyte in vitro." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36550591> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36564391_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_36564391_0" ;
    gutprop:hasSentenceText "Inflammatory microbes and genes as potential biomarkers of Parkinson's disease." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/36564391> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36564391_1> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_36564391_1" ;
    gutprop:hasSentenceText "As the second-largest neurodegenerative disease in the world, Parkinson's disease (PD) has brought a severe economic and medical burden to our society." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36564391> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36564391_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_36564391_2" ;
    gutprop:hasSentenceText "Growing evidence in recent years suggests that the gut microbiome may influence PD, but the exact pathogenesis of PD remains unclear." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36564391> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36564391_8> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_36564391_8" ;
    gutprop:hasSentenceText "Furthermore, random forest models performed well for PD prediction based on 11 genera (accuracy > 80%) or 6 genes (accuracy > 90%) related to inflammation." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36564391> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36651663_1> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_36651663_1" ;
    gutprop:hasSentenceText "The prevalence of anxiety and depression soared following the COVID-19 pandemic." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36651663> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36698474_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_36698474_2" ;
    gutprop:hasSentenceText "Increasing research found that a diet with poor quality such as western diet disrupts gut microbiota and increases the susceptibility to various neurological and mental disorders, while a balanced diet regulates gut microbiota and prevents and alleviates the neurological and mental disorders." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36698474> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36699448_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_36699448_0" ;
    gutprop:hasSentenceText "The host genetics affects gut microbiome diversity in Chinese depressed patients." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/36699448> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36707651_1> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_36707651_1" ;
    gutprop:hasSentenceText "Bipolar disorders (BD) represent a severe leading disabling mental condition worldwide characterized by episodic and often progressive mood fluctuations with manic and depressive stages." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36707651> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36707651_5> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_36707651_5" ;
    gutprop:hasSentenceText "The present review aims to elucidate pathophysiological mechanisms derived from the MGB axis disruption and possible therapeutic approaches mainly focusing on gut microbiota in the complex network of BD." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36707651> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36707651_6> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_36707651_6" ;
    gutprop:hasSentenceText "Understanding the mechanisms of gut microbiota and its bidirectional communication with the immune and other systems can shed light on the discovery of new therapies for improving the clinical management of these patients." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36707651> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36738999_12> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_36738999_12" ;
    gutprop:hasSentenceText "More importantly, we found that compared with the CON diet, HCD induced the decrease of intestinal flora diversity, especially the decrease the relative abundance of Akkermansia_muciniphila, which was statistically significant." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36738999> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36738999_6> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_36738999_6" ;
    gutprop:hasSentenceText "The expression of peripheral and central inflammation was detected by LEGEND plex kits." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36738999> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36738999_8> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_36738999_8" ;
    gutprop:hasSentenceText "Meantime, gut microbe of stool samples was performed by 16S rRNA gene sequencing." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36738999> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36757367_7> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_36757367_7" ;
    gutprop:hasSentenceText "In this review, we focus on recent advances in our understanding of the intricate connections between the gut-microbiota and the brain." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36757367> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36760344_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_36760344_0" ;
    gutprop:hasSentenceText "Alteration of faecal microbiota balance related to long-term deep meditation." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/36760344> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36760344_11> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_36760344_11" ;
    gutprop:hasSentenceText "At the genus level, <i>Prevotella</i> and <i>Bacteroides</i> were significantly enriched in the meditation group." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36760344> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36760344_7> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_36760344_7" ;
    gutprop:hasSentenceText "Based on the sequencing data, linear discriminant analysis effect size (LEfSe) was employed to identify differential intestinal microbial communities between the two groups." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36760344> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36760344_8> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_36760344_8" ;
    gutprop:hasSentenceText "Phylogenetic Investigation of Communities by Reconstruction of Unobserved States (PICRUSt) analysis was used to predict the function of faecal microbiota." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36760344> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36804535_7> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_36804535_7" ;
    gutprop:hasSentenceText "Correlations were observed between the abundance of certain microbiota (and plasma metabolites) and cortical (and total) BMD." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36804535> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36816743_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_36816743_0" ;
    gutprop:hasSentenceText "The Role of Gut Microbiota in Various Neurological and Psychiatric Disorders-An Evidence Mapping Based on Quantified Evidence." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/36816743> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36816743_13> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_36816743_13" ;
    gutprop:hasSentenceText "We found varied levels of evidence for the associations between gut microbiota and neurological diseases; some gut microbiota increased the risk of neurological diseases, whereas others showed evidence of benefit that gut microbiota might be promising therapeutic targets for such diseases." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36816743> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36816743_4> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_36816743_4" ;
    gutprop:hasSentenceText "We also created an evidence map showing the role of gut microbiota in neurological diseases and the certainty of the evidence." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36816743> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36816743_8> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_36816743_8" ;
    gutprop:hasSentenceText "A total of 15 diseases have been investigated for the potential association between gut microbiome alpha diversity and disease, with the Shannon index and Simpson index being the most widely studied." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36816743> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36881806_4> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_36881806_4" ;
    gutprop:hasSentenceText "In this brief review, we describe current conceptualizations regarding the complex interconnections between psychiatric disorders and the gut microbiota." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36881806> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36900437_1> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_36900437_1" ;
    gutprop:hasSentenceText "Depression is a chronic mental illness with devastating effects on a person's physical and mental health." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36900437> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36900437_4> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_36900437_4" ;
    gutprop:hasSentenceText "For example, gamma-aminobutyric acid (GABA) is reported to have antidepressant effects." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36900437> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36931666_7> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_36931666_7" ;
    gutprop:hasSentenceText "To compare the quantitative variables, paired and unpaired Student's t-tests and covariance analyses will be used." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36931666> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36938477_10> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_36938477_10" ;
    gutprop:hasSentenceText "We calculated a standardized mean difference (SMD) of 0.92 (95% CI, 0.65 to 1.19; I-squared = 57.0%; p < 0.001) to determine the treatment effect in terms of frequency of bowel movements per week in the RCTs." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36938477> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36986165_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_36986165_0" ;
    gutprop:hasSentenceText "The Role of Diet as a Modulator of the Inflammatory Process in the Neurological Diseases." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/36986165> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36986165_1> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_36986165_1" ;
    gutprop:hasSentenceText "Neurological diseases are recognized as major causes of disability and mortality worldwide." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36986165> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36986165_4> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_36986165_4" ;
    gutprop:hasSentenceText "The aim of this review was to take a closer look at the role of diet and its ingredients in modulating inflammation associated with the development and/or progression of central nervous system diseases." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36986165> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36989335_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_36989335_0" ;
    gutprop:hasSentenceText "Treatment response to supplemental nutrients for ADHD is independent of diet quality: the MADDY Study RCT." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/36989335> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36989335_5> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_36989335_5" ;
    gutprop:hasSentenceText "For each potential moderator, the outcome CGI-I at week 8 (RCT-end), was modeled two ways: (1) as a dichotomous variable: responder/non-responder, with responders defined by a rating of 1 or 2 'very much' or 'much improved,' all else equals non-responder using logistic regression, and (2) as a dimensional improvement outcome from 1 = very much improved to 7 = very much worse, using linear regression." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36989335> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36989335_7> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_36989335_7" ;
    gutprop:hasSentenceText "However, total vegetable intake moderated level of improvement in exploratory analysis [β = -0.48 (95% CI: -0.82, -0.13), <i>p</i> = 0.007]: those with higher baseline vegetable intake showed greater benefit from multinutrients compared to placebo." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36989335> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37023596_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37023596_0" ;
    gutprop:hasSentenceText "Different roles of microbiota and genetics in the prediction of treatment response in major depressive disorder." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/37023596> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37023596_3> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37023596_3" ;
    gutprop:hasSentenceText "Patients with MDD were recruited in this study and subsequently treated for eight weeks." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37023596> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37049591_1> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37049591_1" ;
    gutprop:hasSentenceText "With increasing attention paid to the concept of the microbiota-gut-brain axis, mounting evidence reveals that the gut microbiota is involved in a variety of neurological and psychiatric diseases." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37049591> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37049591_10> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37049591_10" ;
    gutprop:hasSentenceText "These may result in increased neurotoxic metabolites and reduced generation of serotonin in the disease process." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37049591> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37071196_3> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37071196_3" ;
    gutprop:hasSentenceText "Fecal microbiota composition was analysed by 16S ribosomal RNA gene amplicon sequencing in a total of 1003 samples from 193 children." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37071196> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37071196_5> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37071196_5" ;
    gutprop:hasSentenceText "Most children within three of these clusters remained in the same clusters from the age of 12 to 14 years, suggesting stability in microbial development and transition during this period." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37071196> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37071196_8> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37071196_8" ;
    gutprop:hasSentenceText "One Faecalibacterium-depleted pubertal cluster was related to more social anxiety at age 14." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37071196> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37095530_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37095530_0" ;
    gutprop:hasSentenceText "Positive mood-related gut microbiota in a long-term closed environment: a multiomics study based on the \"Lunar Palace 365\" experiment." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/37095530> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37095530_3> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37095530_3" ;
    gutprop:hasSentenceText "However, the correlation between gut microbiota and psychological changes inside long-term closed environments is still poorly understood." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37095530> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37127945_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37127945_0" ;
    gutprop:hasSentenceText "A systematic review on gut-brain axis aberrations in bipolar disorder and methods of balancing the gut microbiota." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/37127945> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37127945_11> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37127945_11" ;
    gutprop:hasSentenceText "Multiple studies included in this review point toward a possible link between BD and the gut microbiota." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37127945> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37127945_12> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37127945_12" ;
    gutprop:hasSentenceText "Probiotic supplements and other gut-balancing therapies could serve as effective adjunctive methods for the treatment of BD." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37127945> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37127945_14> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37127945_14" ;
    gutprop:hasSentenceText "Furthermore, the microbiota aberrations found in patients with BD were not consistent across multiple studies." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37127945> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37127945_15> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37127945_15" ;
    gutprop:hasSentenceText "Despite these limitations, our findings demonstrate the need for further research regarding the relationship between aberrant gut microbiota profiles and BD, as well as the effectiveness of gut balancing methods as adjunctive treatments." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37127945> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37127945_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37127945_2" ;
    gutprop:hasSentenceText "Up to half of the diagnosed patients are reported to not receive adequate treatment." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37127945> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37127945_4> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37127945_4" ;
    gutprop:hasSentenceText "Using PubMed, Embase, and Google Scholar from November 2021 to February 2022, we found 5310 studies on gut microbiota and its relation to BD." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37127945> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37156128_10> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37156128_10" ;
    gutprop:hasSentenceText "Our findings contribute to a better understanding of the role of the gut microbiome in SCZ pathophysiology and suggest potential targeted interventions." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37156128> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37193253_13> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37193253_13" ;
    gutprop:hasSentenceText "Alterations in certain classes of gut microbiota are associated with pSS activity and dry eye severity." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37193253> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37193253_15> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37193253_15" ;
    gutprop:hasSentenceText "Future studies are needed to explore specific therapeutic targets for improving mental health in pSS-mediated dry eye by microbiota intervention." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37193253> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37209162_3> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37209162_3" ;
    gutprop:hasSentenceText "It is becoming possible to treat mental disorders by regulating the composition of the gut microbiota." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37209162> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37212075_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37212075_0" ;
    gutprop:hasSentenceText "IgA-Biome Profiles Correlate with Clinical Parkinson's Disease Subtypes." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/37212075> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37212075_6> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37212075_6" ;
    gutprop:hasSentenceText "IgA-Biome analyses underscores the importance of the host immune response in shaping the gut microbiome potentially affecting disease progression and presentation." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37212075> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37213508_15> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37213508_15" ;
    gutprop:hasSentenceText "The findings of this study provide a bibliometric analysis and visualization of the key research areas in gut microbiota and CRC over the past 20 years." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37213508> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37213508_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37213508_2" ;
    gutprop:hasSentenceText "Modulating the gut microbiota is a promising approach to enhance the efficacy of CRC treatment and reduce its adverse effects." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37213508> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37213508_7> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37213508_7" ;
    gutprop:hasSentenceText "The articles and reviews on gut microbiota in CRC were obtained from the Web of Science Core Collection (WOSCC) on November 2, 2022." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37213508> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37228957_1> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37228957_1" ;
    gutprop:hasSentenceText "Neurological disorders are an important cause of disability and death globally." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37228957> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37228957_10> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37228957_10" ;
    gutprop:hasSentenceText "The number of gut microbiota is much more than the number of body cells." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37228957> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37228957_6> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37228957_6" ;
    gutprop:hasSentenceText "Before humans, microorganisms existed for a hundred million years." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37228957> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37228957_9> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37228957_9" ;
    gutprop:hasSentenceText "Most of the human microbiota live in the gut." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37228957> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37291666_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37291666_0" ;
    gutprop:hasSentenceText "A comprehensive look at the psychoneuroimmunoendocrinology of spinal cord injury and its progression: mechanisms and clinical opportunities." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/37291666> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37291666_1> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37291666_1" ;
    gutprop:hasSentenceText "Spinal cord injury (SCI) is a devastating and disabling medical condition generally caused by a traumatic event (primary injury)." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37291666> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37291666_3> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37291666_3" ;
    gutprop:hasSentenceText "The alterations that occur in the spinal cord have not only local but also systemic consequences and virtually all organs and tissues of the body incur important changes after SCI, explaining the progression and detrimental consequences related to this condition." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37291666> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37291666_5> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37291666_5" ;
    gutprop:hasSentenceText "The initial traumatic event and the consequent neurological disruption trigger immune, endocrine, and multisystem dysfunction, which in turn affect the patient's psyche and well-being." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37291666> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37368331_1> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37368331_1" ;
    gutprop:hasSentenceText "(1) Background: Parkinson's disease (PD) is a relatively common and complex pathology, and some of its mechanisms remain to be elucidated." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37368331> .

