<https://uts.nlm.nih.gov/uts/umls/concept/C3839098> a owl:NamedIndividual,
        skos:Concept,
        gutprop:BiomedicalTechnique ;
    rdfs:label "Deoxyribonucleic Acid Extraction Technique" ;
    rdfs:comment "Any method that extracts and purifies DNA from biological samples, which can include the proper handling of biological samples prior to nucleic acid isolation, the separation of DNA from the rest of the components in the samples, and the storage of the DNA isolates. [Definition Source: UMLS]",
        "UMLS Match" ;
