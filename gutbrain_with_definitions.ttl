<https://w3id.org/hereditary/ontology/gutbrain/resource/biomedicaltechnique/FunctionalEnrichmentAnalysis> a owl:NamedIndividual,
        skos:Concept,
        gutprop:BiomedicalTechnique ;
    rdfs:label "Functional Enrichment Analysis" ;
    dcterms:creator "Samuel Piron" ;
    rdfs:comment "Functional enrichment analysis is a computational method that identifies biological processes, pathways, or functions that are significantly overrepresented among a set of genes or proteins of interest, often used to interpret high-throughput data. [Definition Source: llama3-8b-8192]" ;
    skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/BiomedicalTechnique> ;
