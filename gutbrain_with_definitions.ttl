<https://uts.nlm.nih.gov/uts/umls/concept/C4076168> a owl:NamedIndividual,
        skos:Concept,
        gutprop:Species ;
    rdfs:label "Multidrug-Resistant Bacteria" ;
    rdfs:comment "Multi Drug Resistance (MDR) is defined as non-susceptibility to at least one agent in three or more epidemiologically significant antimicrobial categories. Non-susceptibility refers to either a resistant, intermediate or non-susceptible result obtained from in vitro antimicrobial susceptibility testing. http://onlinelibrary.wiley.com/enhanced/doi/10.1111/j.1469-0691.2011.03570.x/ (Accessed on 6 October 2015) [Definition Source: UMLS]",
        "UMLS Match" ;
    skos:broaderTransitive <http://purl.obolibrary.org/obo/NCBITaxon_2> ;
    skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/Bacteria> ;
    gutprop:containedIn <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/b81c8ed663109327> ;
    gutprop:interact <https://uts.nlm.nih.gov/uts/umls/concept/C0061126> .

<https://uts.nlm.nih.gov/uts/umls/concept/C4505065> a owl:NamedIndividual,
        skos:Concept,
        <https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding> ;
    rdfs:label "Noncommunicable Diseases" ;
    rdfs:comment "Noncommunicable Diseases (NCDs) are chronic conditions that are not caused by infectious agents, such as heart disease, stroke, cancer, diabetes, and chronic respiratory diseases, which are typically managed through lifestyle changes and medical treatment. [Definition Source: llama3-8b-8192]"^^xsd:string,
        "UMLS Match"^^xsd:string ;
    skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/DiseaseDisorderOrFinding> ;
    gutprop:containedIn <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/23fb237fc534c420> .

<https://uts.nlm.nih.gov/uts/umls/concept/C4763419> a owl:NamedIndividual,
        skos:Concept,
        gutprop:BiomedicalTechnique ;
    rdfs:label "High Sensitivity C-Reactive Protein Measurement" ;
    rdfs:comment "The determination of the amount of C-reactive protein (CRP) present in a sample through the use of immunonephelometry, immunoturbidimetry, high-sensitivity enzyme-linked immunosorbent assay (ELISA) and/or resonant acoustic profiling (RAP). This test is optimized to measure lower concentrations of CRP than a conventional CRP test. [Definition Source: UMLS]",
        "UMLS Match" ;
    skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/BiomedicalTechnique> ;
    gutprop:containedIn <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/4804b7060388172d> .

<https://uts.nlm.nih.gov/uts/umls/concept/C5394401> a owl:NamedIndividual,
        skos:Concept,
        <https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding> ;
    rdfs:label "Dysregulated Immune Function" ;
    rdfs:comment "\"Dysregulated Immune Function\" refers to an abnormal or impaired immune response, characterized by an imbalance or malfunction of the immune system's ability to recognize and respond to pathogens, resulting in compromised host defense or excessive inflammation. [Definition Source: llama3-8b-8192]"^^xsd:string,
        "UMLS Match"^^xsd:string ;
    skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/DiseaseDisorderOrFinding> ;
    gutprop:containedIn <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/11526689363227bf>,
