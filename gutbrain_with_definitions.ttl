<https://w3id.org/hereditary/ontology/gutbrain/resource/microbiome/BrainMicrobiota> a owl:NamedIndividual,
        skos:Concept,
        gutprop:Microbiome ;
    rdfs:label "Brain Microbiota" ;
    dcterms:creator "Samuel Piron" ;
    rdfs:comment "The brain microbiota refers to the collective community of microorganisms, including bacteria, viruses, fungi, and other microorganisms, that inhabit the central nervous system and brain, influencing brain function, behavior, and overall health. [Definition Source: llama3-8b-8192]" ;
    skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/Microbiome> ;
    gutprop:comparedTo <http://purl.obolibrary.org/obo/OHMI_0000020> ;
    gutprop:containedIn <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/810b374b84bb70f1>,
        <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/beba5bb26bf67585> ;
    gutprop:isLinkedTo <http://purl.obolibrary.org/obo/NCIT_C3137> ;
    gutprop:locatedIn <http://purl.obolibrary.org/obo/NCIT_C12439> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/microbiome/DormantBloodMicrobiome> a owl:NamedIndividual,
        skos:Concept,
        gutprop:Microbiome ;
    rdfs:label "Dormant Blood Microbiome" ;
    dcterms:creator "Samuel Piron" ;
    rdfs:comment "The \"dormant_blood_microbiome\" refers to a hypothetical or theoretical community of microorganisms that are present in the blood but are not actively metabolizing or replicating, potentially remaining in a dormant or quiescent state. [Definition Source: llama3-8b-8192]" ;
    skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/Microbiome> ;
    gutprop:containedIn <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/9e81c085b5a11a01>,
        <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/e56eb162f1a7469a> ;
    gutprop:isLinkedTo <https://uts.nlm.nih.gov/uts/umls/concept/C4505065> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/microbiome/GutMicrobialEcosystem> a owl:NamedIndividual,
        skos:Concept,
        gutprop:Microbiome ;
    rdfs:label "Gut Microbial Ecosystem" ;
    dcterms:creator "Samuel Piron" ;
    rdfs:comment "The gut microbial ecosystem refers to the complex community of microorganisms, including bacteria, viruses, fungi, and protozoa, that inhabit the gastrointestinal tract and interact with the host to maintain homeostasis and modulate various physiological processes. [Definition Source: llama3-8b-8192]" ;
    skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/Microbiome> ;
    gutprop:containedIn <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/7e3b154672625775> ;
    gutprop:isLinkedTo <http://purl.obolibrary.org/obo/NCIT_C27195>,
        <http://purl.obolibrary.org/obo/NCIT_C50742> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/microbiome/Pathobiont> a owl:NamedIndividual,
        skos:Concept,
        gutprop:Microbiome ;
    rdfs:label "Pathobiont" ;
    dcterms:creator "Samuel Piron" ;
    rdfs:comment "A pathobiont is a microorganism that is typically present in the human body in small numbers and is generally considered harmless, but can cause disease or contribute to disease progression under certain conditions. [Definition Source: llama3-8b-8192]" ;
    skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/Microbiome> ;
    gutprop:containedIn <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/76f7276a032a341b> ;
    gutprop:isLinkedTo <http://purl.obolibrary.org/obo/NCIT_C124639> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/microbiome/Pharmacomicrobiomics> a owl:NamedIndividual,
        skos:Concept,
        gutprop:Microbiome ;
    rdfs:label "Pharmacomicrobiomic" ;
    dcterms:creator "Samuel Piron" ;
    rdfs:comment "Pharmacomicrobiomics is the study of the interactions between pharmaceuticals and the microbiome, aiming to understand how microorganisms influence the efficacy, safety, and metabolism of drugs. [Definition Source: llama3-8b-8192]" ;
    skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/Microbiome> ;
    gutprop:containedIn <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/fc0fa109f9ddee1f> ;
    gutprop:isLinkedTo <http://purl.obolibrary.org/obo/NCIT_C124639> .

