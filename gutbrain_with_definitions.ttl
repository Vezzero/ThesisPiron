<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37371676_13> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37371676_13" ;
    gutprop:hasSentenceText "This concept of microbial alteration falls under the definition of regenerative medicine and should be included accordingly." ;
