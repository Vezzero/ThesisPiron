<https://uts.nlm.nih.gov/uts/umls/concept/C0023733> a owl:NamedIndividual,
        skos:Concept,
        gutprop:StatisticalTechnique ;
    rdfs:label "Linear Regression" ;
    rdfs:comment "Linear regression is a statistical method used to establish a linear relationship between a dependent variable and one or more independent variables by minimizing the sum of the squared residuals. [Definition Source: llama3-8b-8192]",
        "UMLS Match" ;
    skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/StatisticalTechnique> ;
