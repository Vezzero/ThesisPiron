    rdfs:label "sentence_33938181_5" ;
    gutprop:hasSentenceText "<i>E. amylovora 1189</i> strains." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33938181> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33938181_8> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33938181_8" ;
    gutprop:hasSentenceText "in <i>E. coli TG1</i> and 4-20-fold in" ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33938181> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33938181_9> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33938181_9" ;
    gutprop:hasSentenceText "<i>E. amylovora 1189</i>." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33938181> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33967849_1> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33967849_1" ;
    gutprop:hasSentenceText "<b>Introduction:</b> There is an emerging interest in modulating the gut microbiota to target the gut-brain axis and improve maternal mental health in the perinatal period." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33967849> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33968794_3> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33968794_3" ;
    gutprop:hasSentenceText "Alterations in the gastrointestinal microbiota populations may promote the development and progression of Parkinson's disease." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33968794> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33968794_8> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33968794_8" ;
    gutprop:hasSentenceText "Preclinical studies have shown that gastrointestinal microbial therapy may represent an effective and novel treatment for Parkinson's disease; however, more studies, especially clinical studies, are necessary to explore the curative effects of microbial therapy in Parkinson's disease." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33968794> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34002020_10> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34002020_10" ;
    gutprop:hasSentenceText "Data were imputed using multiple imputation by chained equations." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34002020> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34002020_11> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34002020_11" ;
    gutprop:hasSentenceText "Mean age was 65.2 ± 7.6; 93% of the sample were females." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34002020> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34002020_4> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34002020_4" ;
    gutprop:hasSentenceText "We used longitudinal data collected from 786 volunteer twins recruited as part the TwinsUK register." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34002020> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34002020_5> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34002020_5" ;
    gutprop:hasSentenceText "Our hypothesis was tested with a multilevel mediation model using family structure as random intercept." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34002020> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34002020_9> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34002020_9" ;
    gutprop:hasSentenceText "Analyses were adjusted for obesity, diet, antidepressant use, sociodemographic and technical covariates." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34002020> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34014031_13> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34014031_13" ;
    gutprop:hasSentenceText "Future studies are needed to validate these assumptions and develop new treatment targets for BD." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34014031> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34014031_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34014031_2" ;
    gutprop:hasSentenceText "Accumulating susceptibility genes for BD have been identified in recent years." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34014031> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34014031_4> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34014031_4" ;
    gutprop:hasSentenceText "Despite its high heritability, gene and environment interaction is commonly accepted as the major contributing factor to BD pathogenesis." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34014031> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34032650_11> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34032650_11" ;
    gutprop:hasSentenceText "A significant impact of such a diet is likely mediated through the gut microbiota." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34032650> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34032650_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34032650_2" ;
    gutprop:hasSentenceText "It is becoming increasingly clear that major players in this complex system are gut bacteria." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34032650> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34032650_3> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34032650_3" ;
    gutprop:hasSentenceText "The mechanisms of signal transmission from bacteria to the brain are complex and not fully elucidated, but include neural, endocrine, immune, and metabolic pathways." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34032650> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34074025_1> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34074025_1" ;
    gutprop:hasSentenceText "The functions of mucosal-associated invariant T (MAIT) cells in homeostatic conditions include the interaction with the microbiota and its products, the protection of body barriers, and the mounting of a tissue-repair response to injuries or infections." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34074025> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34092293_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34092293_2" ;
    gutprop:hasSentenceText "However, the best therapeutic schedule and related mechanism on CCRA were still uncertain." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34092293> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34092293_6> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34092293_6" ;
    gutprop:hasSentenceText "Attractively, EDF group also showed antitumor activity." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34092293> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34098340_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34098340_0" ;
    gutprop:hasSentenceText "Maternal prenatal gut microbiota composition predicts child behaviour." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/34098340> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34098340_12> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34098340_12" ;
    gutprop:hasSentenceText "Our findings highlight the need to evaluate potential impacts of the prenatal gut microbiota on early life brain development." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34098340> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34098340_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34098340_2" ;
    gutprop:hasSentenceText "No human study has related maternal gut microbiota to behavioural outcomes during early life." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34098340> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34098340_6> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34098340_6" ;
    gutprop:hasSentenceText "The behavioural outcome used the Childhood Behaviour Checklist at age two." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34098340> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34147969_10> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34147969_10" ;
    gutprop:hasSentenceText "Furthermore, subdiaphragmatic vagotomy blocked the development of these behavioral abnormalities after ingestion of F. rodentium." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34147969> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34174901_1> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34174901_1" ;
    gutprop:hasSentenceText "Minocycline is a clinically available synthetic tetracycline derivative with anti-inflammatory and antibiotic properties." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34174901> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34174901_7> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34174901_7" ;
    gutprop:hasSentenceText "Additionally, motor recovery and anxiety-like behavior were assessed throughout the study, and microglial activation was analyzed immediately rostral to, caudal to, and at the lesion epicenter." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34174901> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34204057_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34204057_0" ;
    gutprop:hasSentenceText "Mediterranean Diet as an Antioxidant: The Impact on Metabolic Health and Overall Wellbeing." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/34204057> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34204057_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34204057_2" ;
    gutprop:hasSentenceText "Several modifiable risk factors, such as sedentary activities, sleep deprivation, smoking, and unhealthy dietary habits have contributed to this increase." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34204057> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34204057_4> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34204057_4" ;
    gutprop:hasSentenceText "The beneficial effects of the MD can be mainly attributed to its numerous components rich in anti-inflammatory and antioxidant properties." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34204057> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34204057_7> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34204057_7" ;
    gutprop:hasSentenceText "It is therefore important to highlight the beneficial effects of the MD on metabolic, reproductive, and mental health, while shaping the overall health of future generations." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34204057> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34204057_8> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34204057_8" ;
    gutprop:hasSentenceText "The beneficial effects of MD can be further enhanced by increased physical activity in the context of a well-balanced healthy lifestyle." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34204057> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34205336_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34205336_2" ;
    gutprop:hasSentenceText "Microbes mediate communication among the metabolic, peripheral immune, and central nervous systems via the microbiota-gut-brain axis." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34205336> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34205336_4> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34205336_4" ;
    gutprop:hasSentenceText "We summarize the mechanisms whereby the gut microbiota regulate the production, transportation, and functioning of neurotransmitters." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34205336> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34216356_1> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34216356_1" ;
    gutprop:hasSentenceText "Many recent studies have shown that the gut microbiome plays important roles in human physiology and pathology." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34216356> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34216356_4> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34216356_4" ;
    gutprop:hasSentenceText "Several researchers have explored the links between these topics to study the potential pathogenic or therapeutic effects of intestinal microbiota in disease." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34216356> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34216356_6> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34216356_6" ;
    gutprop:hasSentenceText "As technology advances, new techniques for studying the microbiome will be developed and refined, and the relationship between diseases and gut microbiota will be revealed." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34216356> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34277527_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34277527_0" ;
    gutprop:hasSentenceText "Towards Tailored Gut Microbiome-Based and Dietary Interventions for Promoting the Development and Maintenance of a Healthy Brain." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/34277527> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34277527_10> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34277527_10" ;
    gutprop:hasSentenceText "Finally, we emphasize the need for further research to gain greater insight into the complex interplay between diet, gut microbiome and brain development." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34277527> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34277527_3> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34277527_3" ;
    gutprop:hasSentenceText "To date, the understating of the precise etiology underpinning these neurological alterations, and their clinical management pose a challenge." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34277527> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34277527_6> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34277527_6" ;
    gutprop:hasSentenceText "In addition, certain dietary interventions have emerged as promising alternatives or adjuvant strategies for improving the management of particular NDDs, at least in particular subsets of subjects." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34277527> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34277527_7> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34277527_7" ;
    gutprop:hasSentenceText "The gut microbiota can be a key to mediating the effects of other exposome factors such as diet on mental health, and ongoing research in Psychiatry and Neuropediatrics is developing Precision Nutrition Models to classify subjects according to a diet response prediction based on specific individual features, including microbiome signatures." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34277527> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34277527_8> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34277527_8" ;
    gutprop:hasSentenceText "Here, we review current scientific evidence for the impact of early life environmental factors, including diet, on gut microbiota and neuro-development, emphasizing the potential long-term consequences on health; and also summarize the state of the art regarding the mechanisms underlying diet and gut microbiota influence on the brain-gut axis." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34277527> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34357134_6> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34357134_6" ;
    gutprop:hasSentenceText "In secondary analyses, we will assess the reliability and validity of the Japanese translations of each measure and conduct an exploratory investigation of patient background, psychiatric symptoms, defeatist performance belief, and gut microbiota as determinants of social cognition." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34357134> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34357554_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34357554_0" ;
    gutprop:hasSentenceText "Immune-microbiome interplay and its implications in neurodegenerative disorders." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/34357554> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34357554_3> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34357554_3" ;
    gutprop:hasSentenceText "The chronic manipulated immunological drive can accelerate the neuronal pathology hence promoting the burden of neurodegenerative disorders." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34357554> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34357554_4> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34357554_4" ;
    gutprop:hasSentenceText "The gut is home for trillions of microorganisms having a mutual relationship with the host system." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34357554> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34357554_5> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34357554_5" ;
    gutprop:hasSentenceText "The gut-brain axis is a unique biochemical pathway through which the gut residing microbes connects with the brain cells and regulates various physiological and pathological cascades." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34357554> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34393849_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34393849_2" ;
    gutprop:hasSentenceText "However, limited information is available on the specific microbial communities associated with symptoms of schizophrenia." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34393849> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34393849_5> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34393849_5" ;
    gutprop:hasSentenceText "Psychotic symptoms were evaluated using the Positive and Negative Syndrome Scale." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34393849> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34393849_6> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34393849_6" ;
    gutprop:hasSentenceText "Microbiota compositions, diversity and community structure were evaluated using 16S rRNA sequencing." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34393849> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34393849_7> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34393849_7" ;
    gutprop:hasSentenceText "Pearson's correlation analysis was used to evaluate the association between bacterial taxa and psychotic symptoms." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34393849> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34399524_11> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34399524_11" ;
    gutprop:hasSentenceText "These effects were reversed or discontinued by a diet lower in AGEs." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34399524> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34399524_7> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34399524_7" ;
    gutprop:hasSentenceText "The inflammatory z-score increased after the baked chow diet." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34399524> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34399524_8> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34399524_8" ;
    gutprop:hasSentenceText "Gut microbial composition differed significantly between groups, with enriched Dubosiella spp." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34399524> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34408160_1> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34408160_1" ;
    gutprop:hasSentenceText "The causes of complex diseases remain an enigma despite decades of epidemiologic research on environmental risks and genome-wide studies that have uncovered tens or hundreds of susceptibility loci for each disease." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34408160> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34422393_3> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34422393_3" ;
    gutprop:hasSentenceText "Recent advances in genomic sequencing have catalyzed a deeper understanding of complex microbe-microbe and host-microbe interactions." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34422393> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34422393_6> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34422393_6" ;
    gutprop:hasSentenceText "In this review, we discuss the development and structure of the gut microbiome, its homeostatic and dysbiotic mechanisms, and the key microbes in esophageal and gastric carcinogenesis with a focus on bacterial biology." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34422393> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34422879_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34422879_0" ;
    gutprop:hasSentenceText "Memorable Food: Fighting Age-Related Neurodegeneration by Precision Nutrition." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/34422879> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34422879_11> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34422879_11" ;
    gutprop:hasSentenceText "Studies with caloric restriction showed neuroprotective effects in animal models, but the results in humans are inconsistent." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34422879> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34422879_12> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34422879_12" ;
    gutprop:hasSentenceText "The pathologies of NDD are complex and there is a great inter-individual (epi)genetic variance within any population." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34422879> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34422879_7> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34422879_7" ;
    gutprop:hasSentenceText "Moreover, the importance of a healthy diet, balanced in macro- and micro-nutrients, in preventing neurodegeneration and slowing down a progression to full-blown disease is evident." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34422879> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34422879_9> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34422879_9" ;
    gutprop:hasSentenceText "Metabolic and lipid profiles in NDD can be improved by the Mediterranean diet." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34422879> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34437440_8> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34437440_8" ;
    gutprop:hasSentenceText "These results have been obtained irrespectively of the presence of CRC-risk loci." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34437440> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34444820_1> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34444820_1" ;
    gutprop:hasSentenceText "The human gut microbiome is closely linked to mental health and sleep." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34444820> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34444820_6> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34444820_6" ;
    gutprop:hasSentenceText "After intervention, gut microbiota composition was quantified by pyrosequencing the bacterial 16S rRNA gene." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34444820> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34444820_8> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34444820_8" ;
    gutprop:hasSentenceText "Those receiving NVP-1704 also experienced an improvement in sleep quality." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34444820> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34448737_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34448737_0" ;
    gutprop:hasSentenceText "Depression: A Gut \"Microbiome\" Feeling!" ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/34448737> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34480631_6> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34480631_6" ;
    gutprop:hasSentenceText "Repeated administration of PLX5622 affected the relative abundance of several bacteria at the genus and species levels." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34480631> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34480631_8> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34480631_8" ;
    gutprop:hasSentenceText "Interestingly, we found significant correlations between microglial markers in the brain and the relative abundance of several bacteria, suggesting microbiome-microglia crosstalk through the brain-gut axis." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34480631> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34576000_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34576000_2" ;
    gutprop:hasSentenceText "The multifactorial nature of PD poses a difficult obstacle for understanding the mechanisms involved in its onset and progression." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34576000> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34576000_3> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34576000_3" ;
    gutprop:hasSentenceText "Currently, diagnosis depends on the appearance of clinical signs, some of which are shared among various neurologic disorders, hindering early diagnosis." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34576000> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34576000_5> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34576000_5" ;
    gutprop:hasSentenceText "Hence, there is an increasing demand for biomarkers that may identify disease onset and progression, as treatment-based medicine may not be the best approach for PD." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34576000> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34576000_6> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34576000_6" ;
    gutprop:hasSentenceText "Over the last few decades, the search for molecular markers to predict susceptibility, aid in accurate diagnosis and evaluate the progress of PD have intensified, but strategies aimed to improve individualized patient care have not yet been established." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34576000> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34576833_4> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34576833_4" ;
    gutprop:hasSentenceText "The association between a drug's effect on the microbiota and psychiatric symptoms may allow for quantifiable surrogate markers of treatment effectiveness." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34576833> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34589852_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34589852_0" ;
    gutprop:hasSentenceText "Nutritional psychiatry in the treatment of psychotic disorders: Current hypotheses and research challenges." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/34589852> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34589852_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34589852_2" ;
    gutprop:hasSentenceText "Nutritional interventions to prevent and treat mental illness have received considerable attention over recent years." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34589852> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34589852_3> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34589852_3" ;
    gutprop:hasSentenceText "However, evidence for nutritional interventions in schizophrenia-spectrum disorders remains limited in quantity and quality." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34589852> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34589852_7> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34589852_7" ;
    gutprop:hasSentenceText "This review describes the state of evidence for key hypotheses, including underlying mechanisms, implicated in schizophrenia-spectrum disorders, the challenges in nutritional psychiatry research and the current state of nutrition interventions in mental healthcare." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34589852> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34603341_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34603341_2" ;
    gutprop:hasSentenceText "The role of SCFA in influencing psychological function is highlighted in recent years but has not been fully elucidated." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34603341> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34603341_7> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34603341_7" ;
    gutprop:hasSentenceText "The present findings further validate the brain-beneficial effect of butyrate and offer novel guidance for developing novel food or dietary supplements for improving mental health." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34603341> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34692176_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34692176_0" ;
    gutprop:hasSentenceText "A Review of Inflammatory Bowel Disease: A Model of Microbial, Immune and Neuropsychological Integration." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/34692176> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34692176_17> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34692176_17" ;
    gutprop:hasSentenceText "Moreover, this allows greater insight into understanding the temporal progressions of subclinical events as potential ground for disease severity in IBD." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34692176> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34692176_7> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34692176_7" ;
    gutprop:hasSentenceText "<b>Material and Methods:</b> A search of published literature was conducted by exploring PubMed, EMBASE, MEDLINE, Medline Plus, CDSR library databases." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34692176> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34704023_1> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34704023_1" ;
    gutprop:hasSentenceText "The gut-brain axis may play a central role in the pathogenesis of neurological disorders." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34704023> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34704023_14> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34704023_14" ;
    gutprop:hasSentenceText "After adjusting for age and sex, none of the alpha-diversity measures were associated with Parkinson's Disease." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34704023> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34704023_15> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34704023_15" ;
    gutprop:hasSentenceText "This is the first report investigating systematically alpha-diversity and its potential link to neurological disorders." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34704023> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34704023_4> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34704023_4" ;
    gutprop:hasSentenceText "A recent publication has described and validated a novel method based on richness and evenness measures of the gut microbiome in order to reduce the complexity and multiplicity of alpha-diversity indices." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34704023> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34704023_7> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34704023_7" ;
    gutprop:hasSentenceText "Richness and evenness factors loadings were quantified from sequencing files in addition with the Shannon diversity index." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34704023> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34758889_14> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34758889_14" ;
    gutprop:hasSentenceText "These findings alert the adverse impact of dietary fiber deficiency on brain function, and highlight an increase in fiber intake as a nutritional strategy to reduce the risk of developing diet-associated cognitive decline and neurodegenerative diseases." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34758889> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34758889_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34758889_2" ;
    gutprop:hasSentenceText "Industrialized nations especially, have experienced a marked decrease in dietary fiber intake, but the potential mechanism linking low fiber intake and cognitive impairment is poorly understood." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34758889> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34758889_3> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34758889_3" ;
    gutprop:hasSentenceText "Emerging research reported that the diversity of gut microbiota in Western populations is significantly reduced." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34758889> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34758889_4> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34758889_4" ;
    gutprop:hasSentenceText "However, it is unknown whether a fiber-deficient diet (which alters gut microbiota) could impair cognition and brain functional elements through the gut-brain axis." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34758889> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34758889_5> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34758889_5" ;
    gutprop:hasSentenceText "In this study, a mouse model of long-term (15 weeks) dietary fiber deficiency (FD) was used to mimic a sustained low fiber intake in humans." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34758889> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34776854_6> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34776854_6" ;
    gutprop:hasSentenceText "Alpha diversity was significantly reduced in PwP when compared to controls." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34776854> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34830610_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34830610_2" ;
    gutprop:hasSentenceText "Indeed, interventions targeting the gut microbiome are being actively investigated as a therapeutic strategy to tackle these diseases." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34830610> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34836918_5> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34836918_5" ;
    gutprop:hasSentenceText "To further examine the key role of mitochondria, we also determined the specific effects of BMAA on mitochondrial function and on inflammasome activation." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34836918> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34870091_1> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34870091_1" ;
    gutprop:hasSentenceText "<b>Background:</b> Gut and oral microbiota are intrinsically linked to human health." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34870091> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34870091_11> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34870091_11" ;
    gutprop:hasSentenceText "Changes have also been identified as potential biomarkers for psychosis that might aid in diagnosis." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34870091> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34870091_12> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34870091_12" ;
    gutprop:hasSentenceText "Understanding how predicted or actual functional alterations in microbial genes or metabolic pathways influence symptomatic expression and downstream clinical outcomes may contribute to the development of microbiome targeted interventions for psychosis." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34870091> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34870091_9> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34870091_9" ;
    gutprop:hasSentenceText "Quantitative analyses will be performed using random-effects meta-analyses to calculate mean difference with 95% confidence intervals." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34870091> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34884399_3> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34884399_3" ;
    gutprop:hasSentenceText "In this prospective study, patients were recruited in 1 academic hospital from July 2019 to July 2020." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34884399> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34884399_6> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34884399_6" ;
    gutprop:hasSentenceText "Next-Generation Sequencing was used to assess the microbiota composition." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34884399> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34884399_7> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34884399_7" ;
    gutprop:hasSentenceText "The endpoint was the difference in composition of the gut microbiota." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34884399> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34884399_9> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34884399_9" ;
    gutprop:hasSentenceText "The control group included 44 healthy subjects matched for age." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34884399> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34908715_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34908715_0" ;
    gutprop:hasSentenceText "Gut-brain axis: Synergistic approach." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/34908715> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34908715_1> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34908715_1" ;
    gutprop:hasSentenceText "Since decades, there is a change in concept of the gut-brain axis." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34908715> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34908715_3> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34908715_3" ;
    gutprop:hasSentenceText "It supports existence of far-reaching model of \"gut-brain axis.\"" ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34908715> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34908715_4> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34908715_4" ;
    gutprop:hasSentenceText "This axis is attaining more adherence to fields investigating biological and physiological footing of psychiatric, neuro-developmental, age-related, and neurodegenerative disorders." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34908715> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34961418_5> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34961418_5" ;
    gutprop:hasSentenceText "Metabolic assessments and intestinal flora were quantified at baseline and after 4, 8, and 12 weeks of treatment." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34961418> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34970638_6> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34970638_6" ;
    gutprop:hasSentenceText "After behavioural evaluations, all mice were sacrificed for harvesting tissues and blood samples." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34970638> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34970638_8> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34970638_8" ;
    gutprop:hasSentenceText "Faecal microbial communities were analysed by sequencing 16S rDNAs." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34970638> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34985325_4> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34985325_4" ;
    gutprop:hasSentenceText "Various factors, including host genetic predisposition, environmental factors, lifestyle, diet, antibiotic or nonantibiotic drug use, etc., affect the composition of the gut microbiota." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34985325> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35069178_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_35069178_0" ;
    gutprop:hasSentenceText "The Gut-Brain Axis and Its Relation to Parkinson's Disease: A Review." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/35069178> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35069178_4> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_35069178_4" ;
    gutprop:hasSentenceText "This bidirectional communication is often referred to as the microbiome-gut-brain axis." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35069178> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35083314_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_35083314_0" ;
    gutprop:hasSentenceText "The small bowel microbiome changes significantly with age and aspects of the ageing process." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/35083314> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35083314_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_35083314_2" ;
    gutprop:hasSentenceText "However, studies to date have used stool samples, which do not represent the entire gut." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35083314> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35083314_3> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_35083314_3" ;
    gutprop:hasSentenceText "Although more challenging to access, the small intestine plays critical roles in host metabolism and immune function." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35083314> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35203906_3> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_35203906_3" ;
    gutprop:hasSentenceText "Suggested connections include, among others, similar prodromal symptoms, renin-angiotensin-aldosterone system involvement, or gut microbiome dysbiosis participation." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35203906> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35281490_7> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_35281490_7" ;
    gutprop:hasSentenceText "Recent findings have also elucidated the potential mechanisms of disease pathology in the enteric nervous system prior to the onset of neurodegeneration." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35281490> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35317228_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_35317228_2" ;
    gutprop:hasSentenceText "However, accumulating evidence suggests that the composition of the microbiome is strongly associated with brain functions and diseases." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35317228> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35326429_3> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_35326429_3" ;
    gutprop:hasSentenceText "Additionally, H<sub>2</sub>S can easily penetrate cell membranes and enter the cell interior." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35326429> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35327401_3> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_35327401_3" ;
    gutprop:hasSentenceText "The availability of powerful genetic tools and resources in <i>Drosophila</i> allowed the scientists to unravel the mechanisms by which the gut microbes affect fitness, health, and behavior of their hosts." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35327401> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35565918_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_35565918_0" ;
    gutprop:hasSentenceText "The Therapeutic Role of Ketogenic Diet in Neurological Disorders." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/35565918> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35565918_4> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_35565918_4" ;
    gutprop:hasSentenceText "Consequently, more effective therapeutic strategies are being sought to increase the effectiveness of available forms of therapy and improve the quality of life of patients." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35565918> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35565918_7> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_35565918_7" ;
    gutprop:hasSentenceText "In our opinion, KD should be considered as an adjuvant therapeutic option for some neurological diseases." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35565918> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35654142_3> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_35654142_3" ;
    gutprop:hasSentenceText "However, the mechanism governing CsgA-mediated acceleration of α-synuclein aggregation is unclear." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35654142> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35654142_4> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_35654142_4" ;
    gutprop:hasSentenceText "Here, we show that CsgA can form stable homodimeric species that correlate with faster α-synuclein amyloid aggregation." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35654142> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35654142_8> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_35654142_8" ;
    gutprop:hasSentenceText "Finally, we identify a complex between CsgA and α-synuclein that functions as a platform to accelerate α-synuclein aggregation." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35654142> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35654142_9> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_35654142_9" ;
    gutprop:hasSentenceText "Taken together, our work reveals complex interplay between bacterial amyloids and α-synuclein that better informs our understanding of PD causation." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35654142> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35674870_5> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_35674870_5" ;
    gutprop:hasSentenceText "This has given rise to debate about the role of non-neuronal cells in PD and reignited intense research into the gut-brain axis and other non-neuronal interactions in the development of the disease." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35674870> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35722294_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_35722294_2" ;
    gutprop:hasSentenceText "However, the predominant genera contributing to PD remain poorly understood." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35722294> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35722294_3> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_35722294_3" ;
    gutprop:hasSentenceText "Inspired by recent advances showing microbiota distribution in the blood and brain, we, here, comprehensively investigated currently available fecal microbiome data (1,914 samples) to identify significantly altered genera, which were further validated by comparison to the results from microbiome analysis of blood (85 samples) and brain (268 samples)." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35722294> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35965349_10> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_35965349_10" ;
    gutprop:hasSentenceText "Although AGPs have a limited impact on taxonomic abundances, they do appear to redefine influential taxa that may promote the exclusion of other taxa." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35965349> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35965349_11> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_35965349_11" ;
    gutprop:hasSentenceText "Microbiome expression profiles further reveal a complex landscape in both the expression and taxonomic representation of multiple pathways including cell wall biogenesis, antimicrobial resistance, and several involved in energy, amino acid, and nucleotide metabolism." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35965349> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35965349_14> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_35965349_14" ;
    gutprop:hasSentenceText "The genes and pathways identified in this study are therefore expected to drive future studies, applying tools such as community-based metabolic modeling, focusing on the mechanistic impact of different dietary regimes on the microbiome." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35965349> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36056574_11> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_36056574_11" ;
    gutprop:hasSentenceText "No significant taxa were identified for sleep disturbance." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36056574> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36056574_13> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_36056574_13" ;
    gutprop:hasSentenceText "Specific taxa were identified as associated with depressive symptoms." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36056574> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36072564_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_36072564_2" ;
    gutprop:hasSentenceText "Several factors can induce an alteration in the bacterial composition of the host's gastrointestinal tract." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36072564> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36072564_6> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_36072564_6" ;
    gutprop:hasSentenceText "While the underlying mechanisms and pathways remain elusive for the most part, it has been shown, that these metabolites are able to trigger the innate immunity in the central nervous system by influencing development and activation status of brain-resident macrophages." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36072564> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36072680_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_36072680_2" ;
    gutprop:hasSentenceText "A healthy diet plays an integral role in maintaining the gut microbiota equilibrium, thus promoting digestive health." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36072680> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36072680_7> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_36072680_7" ;
    gutprop:hasSentenceText "Recent advancements in the dietary management of IBS highlighting the use of a patient-centered, personalized nutrition approach along with lifestyle changes, pharmacological therapies, and psychosocial and behavioral interventions are also reviewed and discussed." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36072680> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36191806_5> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_36191806_5" ;
    gutprop:hasSentenceText "LEfSe (linear discriminant analysis effect size) analysis revealed that" ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36191806> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36216056_15> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_36216056_15" ;
    gutprop:hasSentenceText "But whether gut microbiome regulates these metabolic pathways and behaviors remains to be determined." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36216056> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36332796_6> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_36332796_6" ;
    gutprop:hasSentenceText "We highlight various mechanisms increasing/decreasing the risk of PD development." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36332796> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36332796_7> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_36332796_7" ;
    gutprop:hasSentenceText "Based on the previous supporting evidence, we suggest how early interventions could protect against PD development and how controlling specific factors, including our diet, could modify our perspective on disease mechanisms and therapeutics." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36332796> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36517709_1> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_36517709_1" ;
    gutprop:hasSentenceText "Hyperlipidemia is currently a global public health problem severely affecting people's physical and mental health, as well as their quality of life." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36517709> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36532064_1> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_36532064_1" ;
    gutprop:hasSentenceText "Infectious agents have been long considered to play a role in the pathogenesis of neurological diseases as part of the interaction between genetic susceptibility and the environment." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36532064> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36532064_5> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_36532064_5" ;
    gutprop:hasSentenceText "Based on our data, we discuss the hypothesis that these bacteria are an integral part of brain development and immune tolerance as well as directly linked to the gut microbiome." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36532064> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36550591_10> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_36550591_10" ;
    gutprop:hasSentenceText "Microbiota composition during 8 mg/ml of XPJYF (H12-8) for 12 h showed the more consistency." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36550591> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36564391_10> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_36564391_10" ;
    gutprop:hasSentenceText "Our results provided further insights into the prediction and treatment of PD based on inflammation." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36564391> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36564391_3> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_36564391_3" ;
    gutprop:hasSentenceText "In addition, the current diagnosis of PD could be inaccurate and expensive." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36564391> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36564391_9> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_36564391_9" ;
    gutprop:hasSentenceText "Finally, a possible mechanism was presented to explain the pathogenesis of inflammation leading to PD." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36564391> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36651663_11> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_36651663_11" ;
    gutprop:hasSentenceText "COVID-19 infection and vaccination influenced the overall microbial composition and were associated with distinct relative taxonomic abundance profiles." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36651663> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36651663_4> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_36651663_4" ;
    gutprop:hasSentenceText "Microbial communities from stool samples were profiled in 198 individuals who completed validated, self-report questionnaires." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36651663> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36651663_5> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_36651663_5" ;
    gutprop:hasSentenceText "16S ribosomal RNA gene V3-4 amplicon sequencing was performed." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36651663> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36698474_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_36698474_0" ;
    gutprop:hasSentenceText "The different trends in the burden of neurological and mental disorders following dietary transition in China, the USA, and the world: An extension analysis for the Global Burden of Disease Study 2019." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/36698474> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36698474_13> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_36698474_13" ;
    gutprop:hasSentenceText "Our results suggest that improving diet quality and food production sustainability might be a promising way to stop the expanding burdens of neurological and mental disorders." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36698474> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36698474_3> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_36698474_3" ;
    gutprop:hasSentenceText "Yet, there is limited research on the association between the disease burden expanding of neurological and mental disorders with a dietary transition." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36698474> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36698474_4> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_36698474_4" ;
    gutprop:hasSentenceText "We compared the disability-adjusted life-years (DALYs) trend by age for neurological and mental disorders in China, in the United States of America (USA), and across the world from 1990 to 2019, evaluated the dietary transition in the past 60 years, and analyzed the association between the burden trend of the two disorders with the changes in diet composition and food production." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36698474> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36698474_8> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_36698474_8" ;
    gutprop:hasSentenceText "Additionally, the upward trend was associated with the dramatic dietary transition including a reduction in dietary quality and food production sustainability, during which the younger generation is more affected than the older." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36698474> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36699448_6> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_36699448_6" ;
    gutprop:hasSentenceText "We found three associations between host genetics with microbiome features: beta diversity and rs6108 (<i>p</i> = 8.65 × 10<sup>-9</sup>), <i>Actinobacteria</i> and rs77379751 (<i>p</i> = 8.56 × 10<sup>-9</sup>), and PWY-5913 and rs1775633082 (<i>p</i> = 4.54 × 10<sup>-8</sup>)." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36699448> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36707651_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_36707651_0" ;
    gutprop:hasSentenceText "Microbiota-gut-brain axis mechanisms in the complex network of bipolar disorders: potential clinical implications and translational opportunities." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/36707651> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36707651_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_36707651_2" ;
    gutprop:hasSentenceText "The biological mechanisms underlying the pathophysiology of BD remain incompletely understood, but it seems that there is a complex picture of genetic and environmental factors implicated." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36707651> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36757367_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_36757367_2" ;
    gutprop:hasSentenceText "Disturbances to this system in disease states such as inflammatory bowel disease have consequences for neuronal activity and subsequent cognitive function." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36757367> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36757367_4> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_36757367_4" ;
    gutprop:hasSentenceText "This circuits exists to detect gut microorganisms and relay information to specific areas of the central nervous system (CNS) that in turn, regulate gut physiology." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36757367> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36760344_1> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_36760344_1" ;
    gutprop:hasSentenceText "Advancements in research have confirmed that gut microbiota can influence health through the microbiota-gut-brain axis." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36760344> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36760344_14> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_36760344_14" ;
    gutprop:hasSentenceText "Moreover, plasma levels of clinical risk factors were significantly decreased in the meditation group, including total cholesterol and apolipoprotein B." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36760344> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36760344_3> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_36760344_3" ;
    gutprop:hasSentenceText "However, few studies have comprehensively investigated faecal microbiota following long-term (several years) deep meditation." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36760344> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36760344_4> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_36760344_4" ;
    gutprop:hasSentenceText "Therefore, we propose that long-term meditation may regulate gut microbiota homeostasis and, in turn, affect physical and mental health." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36760344> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36760344_5> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_36760344_5" ;
    gutprop:hasSentenceText "To investigate the effects of long-term deep meditation on the gut microbiome structure." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36760344> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36804535_5> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_36804535_5" ;
    gutprop:hasSentenceText "There was a negative correlation between anhedonia-like behavior and BMD." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36804535> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36816743_3> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_36816743_3" ;
    gutprop:hasSentenceText "We used A Measurement Tool to Assess Systematic Reviews (AMSTAR-2) to evaluate the quality of included SRs." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36816743> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36816743_7> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_36816743_7" ;
    gutprop:hasSentenceText "According to the AMSTAR-2 assessment, 21 SRs scored \"critically low\" in terms of methodological quality, 16 SR scored \"low,\" and 5 SR scored \"moderate.\"" ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36816743> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36881806_1> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_36881806_1" ;
    gutprop:hasSentenceText "Recent studies have linked the gut microbiota to psychiatric symptoms and disorders through complex bidirectional networks." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36881806> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36900437_12> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_36900437_12" ;
    gutprop:hasSentenceText "In conclusion, we suggest that FWG has antidepressant effects, and its potential mechanism may act by restoring the disordered brain-gut axis." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36900437> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36900437_3> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_36900437_3" ;
    gutprop:hasSentenceText "Wheat germ is an inexpensive raw material that is rich in bioactive ingredients." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36900437> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36938477_7> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_36938477_7" ;
    gutprop:hasSentenceText "We selected RCTs from 944 studies, and ultimately included 3 RCTs in our meta-analysis." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36938477> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36938477_9> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_36938477_9" ;
    gutprop:hasSentenceText "We extracted and analyzed the results as means and standard deviations." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36938477> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36978911_1> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_36978911_1" ;
    gutprop:hasSentenceText "Flavonoids are a biodiverse family of dietary compounds that have antioxidant, anti-inflammatory, antiviral, and antibacterial cell protective profiles." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36978911> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36978911_13> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_36978911_13" ;
    gutprop:hasSentenceText "Studies are warranted to experimentally examine the efficacy of flavonoid metabolites directly, as they emerge as novel therapeutic options." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36978911> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36978911_3> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_36978911_3" ;
    gutprop:hasSentenceText "Such complimentary medical herbal formulations are extremely complex mixtures of many pharmacologically active compounds that provide a therapeutic outcome through a network pharmacological effects of considerable complexity." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36978911> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36986165_6> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_36986165_6" ;
    gutprop:hasSentenceText "Personalized nutritional interventions may constitute a non-invasive and effective strategy in combating neurological disorders." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36986165> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36989335_9> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_36989335_9" ;
    gutprop:hasSentenceText "The finding that higher baseline vegetable intake may improve response to multinutrients deserves further exploration, including dietary effect on gut microbiota and absorption of multinutrients and parental factors." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36989335> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37023596_10> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37023596_10" ;
    gutprop:hasSentenceText "The contribution of different components to the AUC was evaluated by removing genetic information, microbiota abundance, and pathway data." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37023596> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37023596_11> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37023596_11" ;
    gutprop:hasSentenceText "The gut microbiome was an important predictor of the response after eight weeks, while genetics was an important predictor of the response after two weeks." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37023596> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37023596_13> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37023596_13" ;
    gutprop:hasSentenceText "Furthermore, these results provide new guidance for clinical decisions: in cases of inadequate treatment effects after two weeks, the composition of the intestinal flora can be improved by diet therapy, which could ultimately affect the efficacy." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37023596> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37023596_4> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37023596_4" ;
    gutprop:hasSentenceText "We identified the differences between the population with a response after two weeks and those with a response after eight weeks." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37023596> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37023596_6> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37023596_6" ;
    gutprop:hasSentenceText "The differences in the importance of microbiota and genetics in prediction were analyzed." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37023596> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37023596_7> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37023596_7" ;
    gutprop:hasSentenceText "Our study identified rs58010457 as a potentially key locus affecting the treatment effect." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37023596> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37023596_8> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37023596_8" ;
    gutprop:hasSentenceText "Different microbiota and enriched pathways might play different roles in the response after two and eight weeks." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37023596> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37023596_9> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37023596_9" ;
    gutprop:hasSentenceText "We found that the area under the curve (AUC) value was greater than 0.8 for both random forest models." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37023596> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37049591_11> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37049591_11" ;
    gutprop:hasSentenceText "These changed factors may potentially be utilized as biomarkers for MDD in the future, playing more important roles in the disease course." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37049591> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37049591_6> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37049591_6" ;
    gutprop:hasSentenceText "Stool samples of bacterial 16S sequencing was carried out." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37049591> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37071196_1> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37071196_1" ;
    gutprop:hasSentenceText "Relations between the gut microbiota and host mental health have been suggested by a growing number of case-control and cross-sectional studies, while supporting evidence is limited in large community samples followed during an extended period." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37071196> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37071196_10> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37071196_10" ;
    gutprop:hasSentenceText "The findings of this study continue to map gut microbiota development in a relatively large community sample followed from birth onwards, importantly extending our knowledge to puberty." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37071196> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37071196_4> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37071196_4" ;
    gutprop:hasSentenceText "Through a clustering method, four distinct microbial clusters were newly identified in puberty." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37071196> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37095530_10> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37095530_10" ;
    gutprop:hasSentenceText "These observations reveal that gut microbiota contributed to a robust effect on the maintenance and improvement of mental health in a long-term closed environment." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37095530> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37095530_11> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37095530_11" ;
    gutprop:hasSentenceText "Our findings represent a key step towards a better understanding the role of the gut microbiome in mammalian mental health during space flight and provide a basis for future efforts to develop microbiota-based countermeasures that mitigate risks to crew mental health during future long-term human space expeditions on the moon or Mars." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37095530> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37095530_12> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37095530_12" ;
    gutprop:hasSentenceText "This study also provides an essential reference for future applications of psychobiotics to neuropsychiatric treatments." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37095530> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37095530_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37095530_2" ;
    gutprop:hasSentenceText "Recently, with the in-depth research of the microbiota-gut-brain axis, gut microbiota has been considered a new approach to maintain and improve psychological health." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37095530> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37095530_9> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37095530_9" ;
    gutprop:hasSentenceText "Furthermore, the results of animal experiments confirmed the positive regulatory effect and mechanism of these potential psychobiotics on mood." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37095530> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37156128_5> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37156128_5" ;
    gutprop:hasSentenceText "Fecal samples were analyzed using 16s rRNA sequencing in this cross-sectional study." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37156128> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37168424_6> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37168424_6" ;
    gutprop:hasSentenceText "<i>Dialister</i> negatively correlated with all measured clinical symptoms (<i>r</i> < 0, <i>P</i> < 0.05)." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37168424> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37193253_10> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37193253_10" ;
    gutprop:hasSentenceText "Prevotella was associated with dry eye severity (<i>p</i> <0.001)." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37193253> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37193253_5> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37193253_5" ;
    gutprop:hasSentenceText "Faecal samples were evaluated using 16S ribosomal RNA gene sequencing." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37193253> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37209162_12> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37209162_12" ;
    gutprop:hasSentenceText "• Gut microbiota composition alteration followed by metabolic changes may play a role in the GABA levels increase." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37209162> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37209162_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37209162_2" ;
    gutprop:hasSentenceText "Recent studies have found that the gut microbiome plays an important role in mental health." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37209162> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37213508_3> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37213508_3" ;
    gutprop:hasSentenceText "The causal relationship between specific microorganisms' presence and CRC development has been widely validated." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37213508> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37213508_5> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37213508_5" ;
    gutprop:hasSentenceText "Therefore, this study analyzed the research hotspots and trends in human gut microbiology and CRC over the last two decades from a bibliometric perspective." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37213508> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37228957_7> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37228957_7" ;
    gutprop:hasSentenceText "Today, there are trillions of these microbes living in our bodies, it is called human microbiota." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37228957> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37291666_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37291666_2" ;
    gutprop:hasSentenceText "This initial trauma is accompanied by a set of biological mechanisms directed to ameliorate neural damage but also exacerbate initial damage (secondary injury)." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37291666> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37291666_6> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37291666_6" ;
    gutprop:hasSentenceText "In the present review, we will explore the most important local and systemic consequences of SCI from a PNIE perspective, defining the changes occurring in each system and how all these mechanisms are interconnected." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37291666> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37291666_7> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37291666_7" ;
    gutprop:hasSentenceText "Finally, potential clinical approaches derived from this knowledge will also be collectively presented with the aim to develop integrative therapies to maximize the clinical management of these patients." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37291666> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37368331_16> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37368331_16" ;
    gutprop:hasSentenceText "Phylum: Proteobacteria." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37368331> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37368331_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37368331_2" ;
    gutprop:hasSentenceText "Change in host microbiota is related to the pathophysiology of numerous diseases." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37368331> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37368331_39> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37368331_39" ;
    gutprop:hasSentenceText "However, more studies are needed to find the precise pathophysiologic involvement of other groups of pathogens, such as fungi and parasites, in the development and progression of PD." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37368331> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37368331_8> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37368331_8" ;
    gutprop:hasSentenceText "(3) Results: The studies analyzed were divided into three geographic areas: Region 1: United States of America and Canada; Region 2: Germany, Ireland, and Finland; and Region 3: Italy; based on geographical similarities among these populations." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37368331> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37371676_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37371676_0" ;
    gutprop:hasSentenceText "Using the Microbiome as a Regenerative Medicine Strategy for Autoimmune Diseases." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/37371676> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37377497_3> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37377497_3" ;
    gutprop:hasSentenceText "In fact, some individuals are resilient to the same stressor." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37377497> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37396336_9> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37396336_9" ;
    gutprop:hasSentenceText "These findings support the view that voluntary exercise, even when performed during a short period, is beneficial for mental and intestinal health and that its sex-specific effects on behavior could be, at least in part, related to some components of the gut microbiota-immune-brain axis." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37396336> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37400971_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37400971_2" ;
    gutprop:hasSentenceText "However, the number of studies on humans investigating this problem is limited, and preclinical findings sometimes conflict." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37400971> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37400971_7> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37400971_7" ;
    gutprop:hasSentenceText "The effect size was not significant or inconclusive for memory and anxiety-like behavior, or inconclusive for schizophrenia-like and depressive-like behavior." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37400971> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37403161_3> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37403161_3" ;
    gutprop:hasSentenceText "We used 16S rRNA and shotgun sequencing to characterise microbial diversity." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37403161> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37403161_5> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37403161_5" ;
    gutprop:hasSentenceText "The Na<sup>+</sup> channel current and gut permeability were measured using an Ussing chamber." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37403161> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37403161_8> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37403161_8" ;
    gutprop:hasSentenceText "Finally, Metascape and Ingenuity Pathway Analysis (IPA) bioinformatics tools were used for identification of dysregulated pathways." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37403161> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37449597_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37449597_2" ;
    gutprop:hasSentenceText "The vagus nerve, the main component of the parasympathetic nervous system, is involved in the regulation of immune response, digestion, heart rate, and control of mood." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37449597> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37449597_3> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37449597_3" ;
    gutprop:hasSentenceText "It can detect microbiota metabolites through its afferents, transferring this gut information to the central nervous system." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37449597> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37464164_3> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37464164_3" ;
    gutprop:hasSentenceText "This protocol will have utility for those investigating the gut, and associated microbiota, in a wide range of different rodent models of human disorders." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37464164> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37468912_3> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37468912_3" ;
    gutprop:hasSentenceText "Still, it is unclear the linkage between the LDSD pattern and the BA metabolic phenotype." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37468912> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37468912_4> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37468912_4" ;
    gutprop:hasSentenceText "This study aimed to uncover the biological basis of the LDSD pattern from the BA metabolic perspective." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37468912> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37469436_3> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37469436_3" ;
    gutprop:hasSentenceText "In the present study, we discovered a <i>L. fermentum</i> strain" ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37469436> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37481569_5> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37481569_5" ;
    gutprop:hasSentenceText "A cross-matching control group of 35 healthy subjects of similar age and sex were included." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37481569> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37481569_7> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37481569_7" ;
    gutprop:hasSentenceText "Quantitative SYBR Green Real-Time PCR was done for the identification and quantitation of selected bacterial phyla, genera and/or species." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37481569> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37485386_5> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37485386_5" ;
    gutprop:hasSentenceText "While EGCG exhibits potential antidepressant properties, a higher dosage of 3 g/d may be necessary to elicit significant effects." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37485386> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37485660_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37485660_2" ;
    gutprop:hasSentenceText "Major depressive disorders seriously threaten mental health worldwide and may even lead to death." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37485660> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37502424_12> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37502424_12" ;
    gutprop:hasSentenceText "The only change was observed for the TMT B test after the first three months but no change was observed after the second three months." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37502424> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37502424_4> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37502424_4" ;
    gutprop:hasSentenceText "A small subset of participants was examined online due to the COVID-19 pandemic." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37502424> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37502424_5> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37502424_5" ;
    gutprop:hasSentenceText "After 6  months a small number of volunteers were additionally assessed after 2  months without any intervention." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37502424> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37502424_7> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37502424_7" ;
    gutprop:hasSentenceText "Secondary outcome measures included changes in self-report and subjective measures using depression and anxiety questionnaires, seven visual analog scales of subjective feelings (memory, digestion, etc." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37502424> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37511699_1> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37511699_1" ;
    gutprop:hasSentenceText "This systematic review evaluated the animal and human evidence for pharmacomicrobiomics (PMx) interactions of antidepressant medications." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37511699> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37511699_8> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37511699_8" ;
    gutprop:hasSentenceText "Well-controlled studies of the mediating and moderating effects of baseline and treatment-emergent changes in microbiota on therapeutic and adverse responses to antidepressants are needed to better establish a potential role of PMx in personalizing antidepressant treatment selection and response prediction." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37511699> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37576972_11> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37576972_11" ;
    gutprop:hasSentenceText "Furthermore, KEGG pathway analysis showed that 16 signaling pathways were significantly enriched between the two groups (p<0.05)." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37576972> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37577447_4> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37577447_4" ;
    gutprop:hasSentenceText "Source Tracker and NetShift were used to identify bacteria responsible for ectopic colonization and indicate the driver function of ectopic colonization bacteria." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37577447> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37607587_4> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37607587_4" ;
    gutprop:hasSentenceText "Healthier metabolic and lipid profiles and cognitive phenotypes are observed in individuals with more distinct microbiomes." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37607587> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37624502_12> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37624502_12" ;
    gutprop:hasSentenceText "In the regression analysis, higher tree coverage was significantly correlated with the relative abundance of several taxa." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37624502> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37624502_16> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37624502_16" ;
    gutprop:hasSentenceText "Our findings might provide instructive evidence for the design of urban greenspace to optimize health and well-being in SCZ as well as the whole people." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37624502> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37627638_3> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37627638_3" ;
    gutprop:hasSentenceText "Our findings demonstrated prebiotic and potential antioxidant effects elicited by these essential oils." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37627638> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37627638_5> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37627638_5" ;
    gutprop:hasSentenceText "Moreover, functional enrichment analysis of the cardiac tissue proteome unveiled an over-representation of pathways related to mitochondrial function, oxidative stress, and cardiac contraction." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37627638> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37655441_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37655441_0" ;
    gutprop:hasSentenceText "The curious case of <i>Prevotella copri</i>." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/37655441> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37655441_5> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37655441_5" ;
    gutprop:hasSentenceText "<i>P. copri</i> studies have only recently been attributed to the diversity of its strains, which substantially differ in their encoded metabolic patterns from the commonly used reference strain." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37655441> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37655441_6> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37655441_6" ;
    gutprop:hasSentenceText "However, such strain differences cannot be resolved by common 16S rRNA amplicon profiling methods." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37655441> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37655441_8> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37655441_8" ;
    gutprop:hasSentenceText "<i>P. copri</i>, its versatile metabolic potential, and the hypotheses behind the conflicting observations on its association with diet and human health." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37655441> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37655441_9> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37655441_9" ;
    gutprop:hasSentenceText "We also provide suggestions for designing studies and bioinformatics pipelines to better research <i>P. copri</i>." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37655441> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37657622_8> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37657622_8" ;
    gutprop:hasSentenceText "This study only tested the cognitive function of MDD in a small sample, which may have caused some bias." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37657622> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37676767_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37676767_2" ;
    gutprop:hasSentenceText "Many PD risk factors are known, but those affecting disease progression are not." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37676767> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37676767_3> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37676767_3" ;
    gutprop:hasSentenceText "Lifestyle and microbial dysbiosis are candidates in this context." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37676767> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37676767_8> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37676767_8" ;
    gutprop:hasSentenceText "Our results shed important insights on how diet and microbiome-borne insults modulate PD progression via the gut-brain axis and have implications for lifestyle management of PD." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37676767> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37764088_5> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37764088_5" ;
    gutprop:hasSentenceText "Furthermore, GM is related to brain function/structure, which plays a crucial role in emotional processing." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37764088> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37764088_6> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37764088_6" ;
    gutprop:hasSentenceText "However, little is known about how GM compositions are associated with the development of emotion regulation in early childhood." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37764088> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37764277_4> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37764277_4" ;
    gutprop:hasSentenceText "This narrative review summarizes the molecular mechanisms and potential targets of baicalin in disorders of the gut-brain axis." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37764277> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37764277_6> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37764277_6" ;
    gutprop:hasSentenceText "The bioactivities of baicalin are mediated through the gut-brain axis." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37764277> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37834373_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37834373_2" ;
    gutprop:hasSentenceText "This complex interplay between the microbiota, the gut, and the CNS is referred to as the gut-brain axis." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37834373> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37841274_11> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37841274_11" ;
    gutprop:hasSentenceText "Therefore, alteration of melanin levels may be at the core of many diseases." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37841274> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37841274_12> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37841274_12" ;
    gutprop:hasSentenceText "We propose regulating melanin levels may offer new avenues for treatment development." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37841274> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37841274_3> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37841274_3" ;
    gutprop:hasSentenceText "Almost all cells contain precursors to melanin." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37841274> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37849234_5> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37849234_5" ;
    gutprop:hasSentenceText "We found impairments in behaviours reliant on adult hippocampal neurogenesis, an essential process for certain memory functions and mood, resulting from Alzheimer's patient transplants." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37849234> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37849234_6> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37849234_6" ;
    gutprop:hasSentenceText "Notably, the severity of impairments correlated with clinical cognitive scores in donor patients." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37849234> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37849234_7> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37849234_7" ;
    gutprop:hasSentenceText "Discrete changes in the rat caecal and hippocampal metabolome were also evident." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37849234> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37881577_3> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37881577_3" ;
    gutprop:hasSentenceText "However, it is not well understood how PTSD affects human health and/or promotes the risk for comorbidities." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37881577> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37881577_5> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37881577_5" ;
    gutprop:hasSentenceText "Gut barrier integrity helps to maintain normal gut homeostasis and its dysregulation promotes gut dysbiosis and inflammation." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37881577> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37881577_8> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37881577_8" ;
    gutprop:hasSentenceText "Polarized intestinal epithelial cells and 3-dimensional crypt cultures were used for mechanistic analysis." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37881577> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37927130_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37927130_2" ;
    gutprop:hasSentenceText "Gut microbial changes by fecal microbiota transplantation or probiotics treatment reportedly modulates depressive symptoms." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37927130> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37978477_6> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37978477_6" ;
    gutprop:hasSentenceText "Several unique bacterial taxa associated with schizophrenia severity." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37978477> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37995475_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37995475_2" ;
    gutprop:hasSentenceText "In recent years, there has been an increased interest in elucidating the influence of the gut microbiota on sleep physiology." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37995475> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37995475_3> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37995475_3" ;
    gutprop:hasSentenceText "The gut microbiota affects the central nervous system by modulating neuronal pathways through the neuroendocrine and immune system, the hypothalamus-pituitary-adrenal axis, and various metabolic pathways." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37995475> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/37995475_4> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_37995475_4" ;
    gutprop:hasSentenceText "The gut microbiota can also influence circadian rhythms." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/37995475> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38026003_5> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38026003_5" ;
    gutprop:hasSentenceText "Furthermore, recent research has unveiled the profound influence of the gut-brain axis, emphasizing the bidirectional communication between the gut microbiota and the central nervous system, impacting cognitive function and mental health." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38026003> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38045924_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38045924_0" ;
    gutprop:hasSentenceText "Microbiota-gut-brain axis and ketogenic diet: how close are we to tackling epilepsy?" ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/38045924> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38045924_1> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38045924_1" ;
    gutprop:hasSentenceText "The microbiota-gut-brain axis refers to the intricate bidirectional communication between commensal microorganisms residing in the digestive tract and the central nervous system, along neuroendocrine, metabolic, immune, and inflammatory pathways." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38045924> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38045924_3> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38045924_3" ;
    gutprop:hasSentenceText "Epilepsy is a multifaceted neurological condition affecting more than 50 million individuals worldwide, 30% of whom do not respond to conventional pharmacological therapies." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38045924> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38068763_3> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38068763_3" ;
    gutprop:hasSentenceText "We also analyzed patients' mental states, eating habits and microbiota." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38068763> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38089822_10> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38089822_10" ;
    gutprop:hasSentenceText "Our findings may offer beneficial biomarkers for disease development and prospective candidate treatment targets for insomnia." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38089822> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38089822_3> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38089822_3" ;
    gutprop:hasSentenceText "The gut microbiota, referred to as the \"second genome,\" has the ability to control host homeostasis." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38089822> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38089822_4> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38089822_4" ;
    gutprop:hasSentenceText "It has been discovered that disruption of the gut-brain axis is linked to insomnia." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38089822> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38089822_6> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38089822_6" ;
    gutprop:hasSentenceText "Ten GM taxa were detected to have causal associations with insomnia." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38089822> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38123016_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38123016_0" ;
    gutprop:hasSentenceText "The many faces of microbiota-gut-brain axis in autism spectrum disorder." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/38123016> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38123016_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38123016_2" ;
    gutprop:hasSentenceText "Many factors can influence microbiota in early life, including host genetics and perinatal events (infections, mode of birth/delivery, medications, nutritional supply, and environmental stressors)." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38123016> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38123016_3> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38123016_3" ;
    gutprop:hasSentenceText "The gut microbiome can influence blood-brain barrier (BBB) permeability, drug bioavailability, and social behaviors." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38123016> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38132705_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38132705_0" ;
    gutprop:hasSentenceText "Association of homelessness and diet on the gut microbiome: a United States-Veteran Microbiome Project (US-VMP) study." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/38132705> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38132705_10> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38132705_10" ;
    gutprop:hasSentenceText "We analyzed, for the first time, bacterial gut microbiome associations among those with experiences of homelessness on alpha diversity, beta diversity, and taxonomic differences." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38132705> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38132705_11> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38132705_11" ;
    gutprop:hasSentenceText "Additionally, we characterized the influences of diet, demographic characteristics, military service history, and mental health conditions on the microbiome of veterans with and without any lifetime history of homelessness." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38132705> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38132705_12> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38132705_12" ;
    gutprop:hasSentenceText "Future longitudinal research to evaluate the complex relationships between homelessness, the gut microbiome, and mental health outcomes is recommended." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38132705> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38132705_3> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38132705_3" ;
    gutprop:hasSentenceText "Moreover, we examined the impact of the cumulative exposure of prior and current homelessness to understand possible associations between these experiences and the gut microbiome." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38132705> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38132705_9> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38132705_9" ;
    gutprop:hasSentenceText "Additional research is required to facilitate understanding regarding the complex associations between homelessness, the gut microbiome, and mental and physical health conditions, with a focus on increasing understanding regarding the longitudinal impact of housing instability throughout the lifespan.IMPORTANCEAlthough there are known stressors related to homelessness as well as chronic health conditions experienced by those without stable housing, there has been limited work evaluating the associations between microbial community composition and homelessness." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38132705> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38139446_1> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38139446_1" ;
    gutprop:hasSentenceText "Excessive predominance of pathological species in the gut microbiota could increase the production of inflammatory mediators at the gut level and, via modification of the gut-blood barrier, at the systemic level." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38139446> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38139446_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38139446_2" ;
    gutprop:hasSentenceText "This pro-inflammatory state could, in turn, increase biological aging that is generally proxied by telomere shortening." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38139446> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38203207_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38203207_0" ;
    gutprop:hasSentenceText "Our Mental Health Is Determined by an Intrinsic Interplay between the Central Nervous System, Enteric Nerves, and Gut Microbiota." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/38203207> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38204948_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38204948_0" ;
    gutprop:hasSentenceText "Neuroendocrine, neurotransmitter, and gut microbiota imbalance contributing to potential psychiatric disorder prevalence in polycystic ovarian syndrome." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/38204948> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38204948_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38204948_2" ;
    gutprop:hasSentenceText "Polycystic ovarian syndrome is a heterogeneous disorder, both in the sense that many different factors may play a role in its manifestation and that multiple systems throughout the body can be affected." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38204948> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38204948_5> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38204948_5" ;
    gutprop:hasSentenceText "There are currently several theories regarding the link between PCOS and mental health." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38204948> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38229613_3> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38229613_3" ;
    gutprop:hasSentenceText "Full-length bacterial 16S rRNA gene sequencing of fecal samples was performed using amplified polymerase chain reaction (PCR) products on the GridION Nanopore sequencer." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38229613> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38260914_4> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38260914_4" ;
    gutprop:hasSentenceText "The introduction and consolidation of the next-generation sequencing in recent years has provided unprecedented information about the microbiome." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38260914> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38278499_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38278499_2" ;
    gutprop:hasSentenceText "If so, these findings could partially explain the link between alcohol use and depression." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38278499> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38283894_10> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38283894_10" ;
    gutprop:hasSentenceText "The results of the overall analyses were stable after performing the sensitivity analyses." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38283894> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38283894_13> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38283894_13" ;
    gutprop:hasSentenceText "These results suggest that these indicators may be a potential biomarker panel for the diagnosis or determining therapeutic targets of ASD." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/38283894> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/38283894_14> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_38283894_14" ;
    gutprop:hasSentenceText "Furthermore, large, sample-based, and randomized controlled trials are needed to confirm these results." ;
