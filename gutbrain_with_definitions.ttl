<https://uts.nlm.nih.gov/uts/umls/concept/C0008555> a owl:NamedIndividual,
        skos:Concept,
        gutprop:BiomedicalTechnique ;
    rdfs:label "Gas Chromatography" ;
    rdfs:comment "Fractionation of a vaporized sample as a consequence of partition between a mobile gaseous phase and a stationary phase held in a column. Two types are gas-solid chromatography, where the fixed phase is a solid, and gas-liquid, in which the stationary phase is a nonvolatile liquid supported on an inert solid matrix. [Definition Source: UMLS]",
        "UMLS Match" ;
    skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/BiomedicalTechnique> ;
    gutprop:containedIn <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/3e399c46e9652dad>,
