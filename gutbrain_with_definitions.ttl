    rdfs:label "Chronic Constipation" ;
    rdfs:comment "Chronic Constipation: A condition characterized by infrequent bowel movements, hard or lumpy stools, and a sense of incomplete evacuation, persisting for at least 3 months. [Definition Source: llama3-8b-8192]"^^xsd:string,
