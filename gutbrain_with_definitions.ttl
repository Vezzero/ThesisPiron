<https://uts.nlm.nih.gov/uts/umls/concept/C4228195> a owl:NamedIndividual,
        skos:Concept,
        <https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding> ;
    rdfs:label "Motor Disability" ;
    rdfs:comment "Motor Disability refers to a physical impairment that affects an individual's ability to perform voluntary movements, maintain posture, or control muscle tone, resulting in limitations in daily activities and social participation. [Definition Source: llama3-8b-8192]"^^xsd:string,
        "UMLS Match"^^xsd:string ;
    skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/DiseaseDisorderOrFinding> ;
