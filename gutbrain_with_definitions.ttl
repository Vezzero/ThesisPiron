<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/21167931_10> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_21167931_10" ;
    gutprop:hasSentenceText "The data indicate that even in SPF models the effectors of beneficial effects are not the proinflammatory autoimmune cells themselves, but rather unidentified regulatory cells." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/21167931> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/21167931_7> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_21167931_7" ;
    gutprop:hasSentenceText "Should we administer anti-inflammatory treatments, or should we induce self-reactive T cells?" ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/21167931> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/23981537_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_23981537_2" ;
    gutprop:hasSentenceText "It is triggered by encounters with chemical, physical, or biological threats that exceed the cellular capacity for homeostasis." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/23981537> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/23981537_7> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_23981537_7" ;
    gutprop:hasSentenceText "Metabolic memory of past stress encounters is stored in the form of altered mitochondrial and cellular macromolecule content, resulting in an increase in functional reserve capacity through a process known as mitocellular hormesis." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/23981537> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/23981537_9> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_23981537_9" ;
    gutprop:hasSentenceText "Chemosensory integration of whole body metabolism occurs in the brainstem and is a prerequisite for normal brain, motor, vestibular, sensory, social, and speech development." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/23981537> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/24798884_3> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_24798884_3" ;
    gutprop:hasSentenceText "Integrating these observations is an important new research frontier." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/24798884> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/24956966_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_24956966_2" ;
    gutprop:hasSentenceText "The microbiota undergoes a vigorous process of development throughout the lifespan and establishes its symbiotic rapport with the host early in life." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/24956966> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/25911232_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_25911232_0" ;
    gutprop:hasSentenceText "Microbiota regulation of the Mammalian gut-brain axis." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/25911232> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/25911232_1> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_25911232_1" ;
    gutprop:hasSentenceText "The realization that the microbiota-gut-brain axis plays a critical role in health and disease has emerged over the past decade." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/25911232> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/25911232_4> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_25911232_4" ;
    gutprop:hasSentenceText "The routes of this communication are not fully elucidated but include neural, humoral, immune, and metabolic pathways." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/25911232> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/25940667_1> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_25940667_1" ;
    gutprop:hasSentenceText "Blood in healthy organisms is seen as a 'sterile' environment: it lacks proliferating microbes." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/25940667> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/25940667_10> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_25940667_10" ;
    gutprop:hasSentenceText "To avoid ambiguity, we here use the term 'atopobiosis' for microbes that appear in places other than their normal location." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/25940667> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/25940667_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_25940667_2" ;
    gutprop:hasSentenceText "Dormant or not-immediately-culturable forms are not absent, however, as intracellular dormancy is well established." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/25940667> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/25940667_3> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_25940667_3" ;
    gutprop:hasSentenceText "We highlight here that a great many pathogens can survive in blood and inside erythrocytes." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/25940667> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/25940667_4> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_25940667_4" ;
    gutprop:hasSentenceText "'Non-culturability', reflected by discrepancies between plate counts and total counts, is commonplace in environmental microbiology." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/25940667> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/25940667_5> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_25940667_5" ;
    gutprop:hasSentenceText "It is overcome by improved culturing methods, and we asked how common this would be in blood." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/25940667> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/26190966_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_26190966_2" ;
    gutprop:hasSentenceText "Identifying the pathophysiological mechanisms underlying these health issues is a major public health challenge." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/26190966> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/26426677_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_26426677_0" ;
    gutprop:hasSentenceText "Neuroimmune pharmacological approaches." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/26426677> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/26927355_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_26927355_2" ;
    gutprop:hasSentenceText "It is even higher than the prevalence in the United States." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/26927355> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/26927355_3> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_26927355_3" ;
    gutprop:hasSentenceText "Certainly, China's economic open-ups, improving living standard, and modernization have propagated the surge." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/26927355> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/26927355_4> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_26927355_4" ;
    gutprop:hasSentenceText "From a traditional public-health point of view, increased food intake and decreased exercise were the main contributors." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/26927355> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/27319972_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_27319972_0" ;
    gutprop:hasSentenceText "Microbes, Immunity, and Behavior: Psychoneuroimmunology Meets the Microbiome." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/27319972> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/27319972_6> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_27319972_6" ;
    gutprop:hasSentenceText "It is clear that the immune system and nervous system are in continuous communication in order to maintain a state of homeostasis." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/27319972> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/27698624_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_27698624_2" ;
    gutprop:hasSentenceText "Psycho-behavioral function and somatic health interaction have often been ignored in health care with resulting deficits in treatment quality and outcomes." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/27698624> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/27698624_7> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_27698624_7" ;
    gutprop:hasSentenceText "This case study shows a possible treatment protocol to explore the efficacy of targeting the gut-brain-axis that may be used as an impetus for future controlled studies." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/27698624> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/27793225_5> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_27793225_5" ;
    gutprop:hasSentenceText "Importantly, several critical \"windows of opportunity\" for prevention and intervention have been identified, particularly early life and adolescence; these are periods of rapid development and transition that provide a foundation for future health." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/27793225> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/27793225_7> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_27793225_7" ;
    gutprop:hasSentenceText "Improving diet quality and subsequent gut health may have benefits for individuals' mental health, as well as the mental health of future generations." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/27793225> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/27930574_7> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_27930574_7" ;
    gutprop:hasSentenceText "Our method achieved a specificity of 0.876 and a sensitivity of 0.838." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/27930574> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28073356_7> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_28073356_7" ;
    gutprop:hasSentenceText "Evidence on the complex interactions between extrinsic (parasite) and intrinsic (host-derived) factors has been synthesised and discussed." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/28073356> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28158162_6> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_28158162_6" ;
    gutprop:hasSentenceText "Literature review." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/28158162> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28158162_7> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_28158162_7" ;
    gutprop:hasSentenceText "Anesthesia and Operation Center, Department of Anesthesiology, Chinese PLA General Hospital." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/28158162> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28399458_10> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_28399458_10" ;
    gutprop:hasSentenceText "fetal programming)." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/28399458> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28399458_4> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_28399458_4" ;
    gutprop:hasSentenceText "Prospective-longitudinal study initiated in 2009/2010." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/28399458> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28572752_5> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_28572752_5" ;
    gutprop:hasSentenceText "The time curves of <sup>13</sup>CO<sub>2</sub> excretion in breath samples were divided into two phases, evaluating small intestinal absorption (0-60 min) and colonic microbial metabolism (90-240 min), respectively." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/28572752> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28716445_1> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_28716445_1" ;
    gutprop:hasSentenceText "Physical and mental health is dependent on the environment, and feeding is a prime example of this environmental exchange." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/28716445> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28716445_4> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_28716445_4" ;
    gutprop:hasSentenceText "Growing understanding of how integrated bacterial life is in the body has shown that gut bacteria regulate basic physiologic processes and are implicated in various disease states and contribute to regulation of mood." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/28716445> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28843021_11> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_28843021_11" ;
    gutprop:hasSentenceText "© 2017 The Authors." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/28843021> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28843021_12> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_28843021_12" ;
    gutprop:hasSentenceText "Movement Disorders published by Wiley Periodicals, Inc. on behalf of International Parkinson and Movement Disorder Society." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/28843021> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/28852308_5> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_28852308_5" ;
    gutprop:hasSentenceText "However, it is not yet clear whether these changes in the microbiome are causally related to such diseases or are secondary effects thereof." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/28852308> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/29022384_6> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_29022384_6" ;
    gutprop:hasSentenceText "These findings were independent of delivery mode." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/29022384> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/29023380_10> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_29023380_10" ;
    gutprop:hasSentenceText "The limited availability of information on the mechanisms, pathways and cause-and-effect relationships hinders us from translating and implementing the knowledge from the bench to the clinic." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/29023380> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/29023380_11> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_29023380_11" ;
    gutprop:hasSentenceText "<b>Implications:</b> Further understanding of this intricate field might potentially shed light on novel preventive and therapeutic strategies to combat these disorders." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/29023380> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/29023380_4> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_29023380_4" ;
    gutprop:hasSentenceText "Relevant articles were selected and reviewed." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/29023380> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/29352709_4> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_29352709_4" ;
    gutprop:hasSentenceText "We restricted inclusion criteria strictly to control confounding bias." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/29352709> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/29857583_10> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_29857583_10" ;
    gutprop:hasSentenceText "We show that standardization of sample collection and analysis is necessary for ensuring the reproducibility and comparability of data." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/29857583> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/29857583_11> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_29857583_11" ;
    gutprop:hasSentenceText "We also provide evidence that assessing the microbiota composition at high taxonomic resolution reveals changes in relative abundance that may be specific to or characteristic of one disease or disease group, and might evolve discriminative power." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/29857583> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/29857583_12> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_29857583_12" ;
    gutprop:hasSentenceText "The interactions between bacterial species and strains and the co-abundances must be investigated before assumptions about the effects of specific bacteria on the host can be made with certainty." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/29857583> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/29857583_4> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_29857583_4" ;
    gutprop:hasSentenceText "To enhance the comparability of different studies, only human case-control studies were included." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/29857583> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/29857583_8> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_29857583_8" ;
    gutprop:hasSentenceText "On a low taxonomic resolution, like the phylum level, the changes are not disease-specific and are inconsistent." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/29857583> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30033172_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_30033172_0" ;
    gutprop:hasSentenceText "Towards microbiome-informed dietary recommendations for promoting metabolic and mental health: Opinion papers of the MyNewGut project." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/30033172> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30033172_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_30033172_2" ;
    gutprop:hasSentenceText "Break-down of this delicate balance under sustained exposure to stressors (e.g." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30033172> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30033172_3> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_30033172_3" ;
    gutprop:hasSentenceText "unhealthy diets) can, however, contribute to the onset of disease." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30033172> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30033172_8> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_30033172_8" ;
    gutprop:hasSentenceText "In this introductory paper by the European project MyNewGut, we briefly summarize the investigations conducted to better understand the role of dietary patterns and food components in metabolic and mental health and the specificities of the microbiome-mediating mechanisms." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30033172> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30033172_9> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_30033172_9" ;
    gutprop:hasSentenceText "We also discuss how advances in the understanding of the microbiome's role in dietary health effects can help to provide acceptable scientific grounds on which to base dietary advice for promoting healthy living." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30033172> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30072879_16> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_30072879_16" ;
    gutprop:hasSentenceText "In addition, there were significant associations between microbiome α-diversity and sensorimotor performance, as well as microbiome composition and fear learning." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30072879> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30258234_1> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_30258234_1" ;
    gutprop:hasSentenceText "The neuroimmune system is involved in development, normal functioning, aging, and injury of the central nervous system." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30258234> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30258234_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_30258234_2" ;
    gutprop:hasSentenceText "Microglia, first described a century ago, are the main neuroimmune cells and have three essential functions: a sentinel function involved in constant sensing of changes in their environment, a housekeeping function that promotes neuronal well-being and normal operation, and a defense function necessary for responding to such changes and providing neuroprotection." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30258234> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30258234_3> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_30258234_3" ;
    gutprop:hasSentenceText "Microglia use a defined armamentarium of genes to perform these tasks." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30258234> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30317530_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_30317530_2" ;
    gutprop:hasSentenceText "Microbiota acquired at birth develops in parallel as the host develops and maintains its temporal stability and diversity through adulthood until death." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30317530> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30405455_1> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_30405455_1" ;
    gutprop:hasSentenceText "Advances in understanding the role of the microbiome in physical and mental health are at the forefront of medical research and hold potential to have a direct impact on precision medicine approaches." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30405455> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30405455_6> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_30405455_6" ;
    gutprop:hasSentenceText "Peripheral outcome measures of host-microbe bidirectional communication have significant translational value as biomarkers." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30405455> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30584306_12> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_30584306_12" ;
    gutprop:hasSentenceText "This is a cross-sectional study and the sample size is comparatively small." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30584306> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30584306_13> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_30584306_13" ;
    gutprop:hasSentenceText "Though several diet-related factors were controlled in the study, there is no quantified assessment of it." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30584306> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30584306_9> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_30584306_9" ;
    gutprop:hasSentenceText "There are differences in 17 KEGG pathways between the two groups." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30584306> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30659564_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_30659564_0" ;
    gutprop:hasSentenceText "Can microbiology affect psychiatry?" ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/30659564> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30659564_10> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_30659564_10" ;
    gutprop:hasSentenceText "This subject requires further examination, especially taking into consideration potential therapeutic options." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30659564> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30659564_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_30659564_2" ;
    gutprop:hasSentenceText "Every single human consists of thousands of genes, billions of neurons and trillions of bacteria." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30659564> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30659564_5> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_30659564_5" ;
    gutprop:hasSentenceText "This phenomenon is known as \"gut-brain axis\"." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30659564> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30659564_6> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_30659564_6" ;
    gutprop:hasSentenceText "The strongest evidence for the role of microbes in the gut-brain axis comes from animal studies." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30659564> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30659564_7> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_30659564_7" ;
    gutprop:hasSentenceText "Nevertheless, the gutbrain crosstalk is a bidirectional communication system that not only provides gastrointestinal homeostasis, but can also affect motivation as well as higher cognitive functions." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30659564> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30707176_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_30707176_2" ;
    gutprop:hasSentenceText "But the mechanisms have not been completely explained." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30707176> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30717162_10> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_30717162_10" ;
    gutprop:hasSentenceText "No significant differences between taxa levels, at the studied time points, were observed when adjusted for multiple hypotheses testing procedures." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30717162> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30717162_12> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_30717162_12" ;
    gutprop:hasSentenceText "We have also found that individual microbiome stability was not affected by hospitalization." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30717162> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30826885_3> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_30826885_3" ;
    gutprop:hasSentenceText "The stress response activates the HPA axis and dysregulates the ANS, leading to the inhibition of the parasympathetic system." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30826885> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30828318_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_30828318_0" ;
    gutprop:hasSentenceText "Disentangling What We Know About Microbes and Mental Health." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/30828318> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30828318_4> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_30828318_4" ;
    gutprop:hasSentenceText "Questions remain that touch the core of being human: (i) Do our microbes influence happiness and to what extent?" ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30828318> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30828318_7> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_30828318_7" ;
    gutprop:hasSentenceText "While approaching life from a reductionist perspective has a long history in science, we need to try to interrogate these health and disease issues from a wider perspective." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30828318> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30900006_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_30900006_0" ;
    gutprop:hasSentenceText "Microbe and host interaction in gastrointestinal homeostasis." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/30900006> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30900006_1> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_30900006_1" ;
    gutprop:hasSentenceText "Researchers in psychiatry and neuroscience are increasingly recognizing the importance of gut-brain communication in mental health." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30900006> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30900006_10> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_30900006_10" ;
    gutprop:hasSentenceText "The results of this study provide insight into how specific taxa influence gut barrier integrity and function." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30900006> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/30900006_11> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_30900006_11" ;
    gutprop:hasSentenceText "More generally, these data in the context of recent published studies makes a significant contribution to our understanding of host-microbe interactions providing new knowledge that can be harnessed by us and others in future mechanistic studies." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/30900006> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31083360_10> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_31083360_10" ;
    gutprop:hasSentenceText "Most of these were prospective, open-label studies." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31083360> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31083360_7> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_31083360_7" ;
    gutprop:hasSentenceText "The inclusion criteria were original clinical trials, published in English between the period 1st January 1988 and 1st February 2019." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31083360> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31083360_8> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_31083360_8" ;
    gutprop:hasSentenceText "<i>Results</i>: A total of eight clinical trials were systematically reviewed." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31083360> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31132457_11> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_31132457_11" ;
    gutprop:hasSentenceText "Alpha diversity had a negative association with negative emotionality and fear reactivity." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31132457> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31132457_9> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_31132457_9" ;
    gutprop:hasSentenceText "The clusters associated with temperament in a sex-dependent manner." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31132457> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31179435_17> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_31179435_17" ;
    gutprop:hasSentenceText "More studies are needed to clarify this conclusion since we still cannot run meta-analysis so far." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31179435> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31179435_5> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_31179435_5" ;
    gutprop:hasSentenceText "This systematic review of randomised controlled trials was searched based on the following databases: PubMed, EMBASE, the Cochrane Library, OVID, Web of Knowledge, China National Knowledge Infrastructure (CNKI), Wanfang Data, VIP databases and SinoMed." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31179435> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31179435_6> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_31179435_6" ;
    gutprop:hasSentenceText "The retrieval time dated back to 25 July 2018." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31179435> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31179435_7> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_31179435_7" ;
    gutprop:hasSentenceText "Then we screened research literatures based on established inclusion and exclusion criteria." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31179435> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31179435_9> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_31179435_9" ;
    gutprop:hasSentenceText "A total of 3334 articles were retrieved and 21 studies were included which contained 1503 subjects." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31179435> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31218116_12> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_31218116_12" ;
    gutprop:hasSentenceText "These improvements are expected to be maintained at the 3-month follow-up." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31218116> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31218116_13> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_31218116_13" ;
    gutprop:hasSentenceText "The findings from this study will advance the knowledge regarding the effects of HIIT and lifestyle education on key outcomes for an at-risk chronic disease population." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31218116> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31218116_4> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_31218116_4" ;
    gutprop:hasSentenceText "Participants in the HIIT+ will engage in a 12-week HIIT + lifestyle education program." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31218116> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31218116_5> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_31218116_5" ;
    gutprop:hasSentenceText "HIIT sessions will be comprised of 2 workouts per week, working up to 14 × 30-second intervals at 90% maximal heart rate (HRmax) followed by 2 minutes recovery at 50% HRmax." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31218116> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31218116_6> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_31218116_6" ;
    gutprop:hasSentenceText "The 6 biweekly lifestyle sessions will involve education on the promotion of a whole foods GFD, sleep hygiene, psychosocial coping skills (eg, self-compassion), and self-regulatory skills to master changes in behaviors." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31218116> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31218116_7> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_31218116_7" ;
    gutprop:hasSentenceText "Assessments will occur at pre and post 12-week intervention and 3-month follow-up." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31218116> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31248424_4> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_31248424_4" ;
    gutprop:hasSentenceText "Diet and comorbidities were controlled in the analyses." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31248424> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31330299_3> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_31330299_3" ;
    gutprop:hasSentenceText "Understanding the underlying signalling pathways in which the microbiota impacts these disorders is crucial for the development of future therapeutics for improving CNS functionality." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31330299> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31377712_10> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_31377712_10" ;
    gutprop:hasSentenceText "The findings will be disseminated through scientific publications in peer-reviewed journals, conference presentations, social media and specific websites." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31377712> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31377712_11> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_31377712_11" ;
    gutprop:hasSentenceText "ClinicalTrials.gov (NCT03825055)." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31377712> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31377712_9> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_31377712_9" ;
    gutprop:hasSentenceText "The study has been approved by the Verona University Hospital Ethics Committee (approval number: 2029CESC)." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31377712> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31493127_1> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_31493127_1" ;
    gutprop:hasSentenceText "In light of recent data, microorganisms should be construed as organisms that are capable of communication and collective behaviors." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31493127> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31493127_10> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_31493127_10" ;
    gutprop:hasSentenceText "Some of the publications focus on the involvement of neurochemicals in the bidirectional communication within the host-microbiota system." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31493127> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31493127_12> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_31493127_12" ;
    gutprop:hasSentenceText "Such biologically active agents of microbial origin are referred to as postbiotics or, alternatively, metabiotics (the term preferred in this work)." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31493127> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31493127_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_31493127_2" ;
    gutprop:hasSentenceText "Microbial communication signals are involved both in interactions among microbial cells within microbial social systems, including the human body-inhabiting microconsortium, and the dialog between the microbiota and the host organism." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31493127> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31493127_3> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_31493127_3" ;
    gutprop:hasSentenceText "The microbiota inhabits various niches of the host organism, especially the gastrointestinal (GI) tract." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31493127> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31493127_4> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_31493127_4" ;
    gutprop:hasSentenceText "Microorganisms release diverse signal molecules and, in addition, specifically respond to host signals." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31493127> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31493127_7> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_31493127_7" ;
    gutprop:hasSentenceText "This ongoing dialog may either stabilize the host's physical and mental health state or, alternatively, cause serious health problems." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31493127> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31493127_9> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_31493127_9" ;
    gutprop:hasSentenceText "A number of recent review works address the microbiota-host system and its communication signals." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31493127> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31498131_3> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_31498131_3" ;
    gutprop:hasSentenceText "While certain findings were replicated across several studies, various contradictory findings were reported." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31498131> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31530799_12> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_31530799_12" ;
    gutprop:hasSentenceText "Therefore, it appears likely that brain-gut axis plays a role in stress susceptibility in the LH paradigm." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31530799> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31539679_11> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_31539679_11" ;
    gutprop:hasSentenceText "Specific microbiome were not determined." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31539679> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31568686_4> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_31568686_4" ;
    gutprop:hasSentenceText "An extensive review of relevant literature was undertaken." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31568686> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31596658_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_31596658_0" ;
    gutprop:hasSentenceText "\"Photobiomics\": Can Light, Including Photobiomodulation, Alter the Microbiome?" ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/31596658> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31596658_10> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_31596658_10" ;
    gutprop:hasSentenceText "Some mechanisms by which this phenomenon might occur are considered." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31596658> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31662903_4> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_31662903_4" ;
    gutprop:hasSentenceText "The diet was assessed with a validated food frequency questionnaire." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31662903> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31685046_10> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_31685046_10" ;
    gutprop:hasSentenceText "Finally, RF classification at the genus level can achieve an area under the receiver operating characteristic curve of 0.890." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31685046> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31704402_1> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_31704402_1" ;
    gutprop:hasSentenceText "Growing epidemiological evidence links natural green space exposure with a range of health benefits, including for mental health." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31704402> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31704402_10> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_31704402_10" ;
    gutprop:hasSentenceText "Our findings have potential to inform cost-effective population health interventions through microbiome-conscious green space design and, ultimately, the mainstreaming of biodiversity into health care." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31704402> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31704402_3> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_31704402_3" ;
    gutprop:hasSentenceText "Microbiomes are proposed as an important but understudied link that may help explain many green space-human health associations." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31704402> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31722343_5> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_31722343_5" ;
    gutprop:hasSentenceText "While the heterogeneity in microbial communities between individuals might be associated with disease risk, it may also moderate the efficacy or adverse effects associated with the use of medication." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31722343> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31726457_5> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_31726457_5" ;
    gutprop:hasSentenceText "Long-term perturbations to this homeostatic environment may contribute to the progression of a number of disorders by altering physiological processes including hypothalamic-pituitary-adrenal axis activation, neurotransmitter systems, immune function, and the inflammatory response." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31726457> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31769847_11> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_31769847_11" ;
    gutprop:hasSentenceText "In most studies, no major adverse effects were reported." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31769847> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31769847_5> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_31769847_5" ;
    gutprop:hasSentenceText "From a total of 212 studies screened, 11 were included in the final systematic review." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31769847> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31769847_6> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_31769847_6" ;
    gutprop:hasSentenceText "Quality assessment of the included trials was assessed by the Jadad scale." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31769847> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31917834_1> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_31917834_1" ;
    gutprop:hasSentenceText "Puberty/adolescence is a critical phase during neurodevelopment with numerous structural, neurochemical, and molecular changes occurring in response to genetic and environmental signals." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31917834> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31940482_5> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_31940482_5" ;
    gutprop:hasSentenceText "We identify several host metabolic pathways differentially regulated in response to probiotic exposure, including sphingolipid metabolism." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31940482> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31952911_3> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_31952911_3" ;
    gutprop:hasSentenceText "We systematically searched the databases CENTRAL, PubMed, EMBASE, PsycINFO and LILACS." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31952911> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/31952911_8> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_31952911_8" ;
    gutprop:hasSentenceText "Due to the many limitations of the included studies the findings should be interpreted with caution." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/31952911> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32041265_8> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_32041265_8" ;
    gutprop:hasSentenceText "Stool samples were collected before and after 14 days of intervention." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32041265> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32056910_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_32056910_0" ;
    gutprop:hasSentenceText "Feeling down?" ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/32056910> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32056910_5> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_32056910_5" ;
    gutprop:hasSentenceText "Methods Four databases were systematically searched using comprehensive search terms (OVID Medline, Embase, PsycINFO, and PubMed), following PRISMA guidelines." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32056910> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32056910_6> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_32056910_6" ;
    gutprop:hasSentenceText "Results Systematic review identified 17 studies (10 human, 7 animal)." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32056910> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32163822_5> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_32163822_5" ;
    gutprop:hasSentenceText "Thus, well-designed longitudinal studies with larger sample size, accounting for confounders are needed." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32163822> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32188376_6> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_32188376_6" ;
    gutprop:hasSentenceText "Eight clinical trials with nutrients were identified, whereas none involved dietary interventions." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32188376> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32188376_8> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_32188376_8" ;
    gutprop:hasSentenceText "Methodological recommendations for future cognition trials in the field are advanced." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32188376> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32188376_9> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_32188376_9" ;
    gutprop:hasSentenceText "Current evidence and future views are discussed from the perspectives of precision medicine, clinical staging, nutritional psychiatry, and the brain-gut-microbiota axis." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32188376> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32379622_12> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_32379622_12" ;
    gutprop:hasSentenceText "Specific microbiome were not determined." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32379622> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32389857_11> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_32389857_11" ;
    gutprop:hasSentenceText "Therefore, the emerging picture on the complex drug-microbiota bidirectional interplay will have considerable implications in the future not only in terms of clinical practice but also, upstream, on drug development." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32389857> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32389857_9> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_32389857_9" ;
    gutprop:hasSentenceText "Indeed, the microbiota is able to affect drug absorption and metabolism up to have an impact on drug activity and/or toxicity." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32389857> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32438623_8> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_32438623_8" ;
    gutprop:hasSentenceText "Nutrient intake was monitored with a food frequency questionnaire." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32438623> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32469834_11> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_32469834_11" ;
    gutprop:hasSentenceText "We encourage further systematic reviews in this space, particularly which consider research quality and incorporate comprehensive meta-analyses." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32469834> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32469834_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_32469834_2" ;
    gutprop:hasSentenceText "In this correspondence, we compliment Sanada et al." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32469834> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32469834_4> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_32469834_4" ;
    gutprop:hasSentenceText "We also comment on how this synthesis should be extended in future research." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32469834> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32469834_5> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_32469834_5" ;
    gutprop:hasSentenceText "Sanada et al." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32469834> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32469834_7> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_32469834_7" ;
    gutprop:hasSentenceText "A meta-analysis was only able to be performed on alpha diversity indices." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32469834> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32517799_7> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_32517799_7" ;
    gutprop:hasSentenceText "Our key results include the following." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32517799> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32572814_9> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_32572814_9" ;
    gutprop:hasSentenceText "SH-SY5Y cells, derived from human neuroblastoma cells, are used as a model of these neurons." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32572814> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32605552_11> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_32605552_11" ;
    gutprop:hasSentenceText "Secondary endpoints were dietary intake, physical activity levels, body composition, anthropometry, blood, urine and faecal biomarkers of systemic, physical and mental health." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32605552> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32605552_14> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_32605552_14" ;
    gutprop:hasSentenceText "It will support future use of public health cooking program initiatives aimed at improving food literacy, self-efficacy and physical and mental health." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32605552> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32605552_16> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_32605552_16" ;
    gutprop:hasSentenceText "Retrospectively registered on 16.08.2019 with the Australian New Zealand Clinical Trials Registry (ANZCTR)." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32605552> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32605552_17> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_32605552_17" ;
    gutprop:hasSentenceText "ACTRN12619001144101 ." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32605552> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32605552_18> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_32605552_18" ;
    gutprop:hasSentenceText "Protocol version 4." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32605552> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32605552_4> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_32605552_4" ;
    gutprop:hasSentenceText "The pseudo-random, pre-post study design consisted of an intervention and a control group." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32605552> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32605552_5> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_32605552_5" ;
    gutprop:hasSentenceText "Participant recruitment and group allocation was based on their program start dates." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32605552> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32605552_9> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_32605552_9" ;
    gutprop:hasSentenceText "The minimum participation level included an online survey and levels 2, 3 and 4 involved attendance at a clinic with increasing functional, anthropometric and biomarker measurements." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32605552> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32667590_3> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_32667590_3" ;
    gutprop:hasSentenceText "Currently, there has been an emphasis on how such interactions affect mental health." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32667590> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32772900_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_32772900_2" ;
    gutprop:hasSentenceText "Current biomedical treatments do not completely address the management of these conditions." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32772900> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32772900_7> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_32772900_7" ;
    gutprop:hasSentenceText "This understanding can open up the need for a gut related approach in these disorders as well as unlock the door for the role of gut related microbiota management." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32772900> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32772900_8> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_32772900_8" ;
    gutprop:hasSentenceText "KEY MESSAGES Challenges of managing mental health conditions remain in spite of new pharmacological therapy." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32772900> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32816830_11> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_32816830_11" ;
    gutprop:hasSentenceText "Ethics approval was obtained from the Human Research Ethics Committee of Edith Cowan University (2019-00619-YAN)." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32816830> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32816830_12> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_32816830_12" ;
    gutprop:hasSentenceText "Results will be disseminated in peer-review journal publications, and conference presentations." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32816830> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32816830_15> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_32816830_15" ;
    gutprop:hasSentenceText "ACTRN12620000032954." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32816830> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32816830_7> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_32816830_7" ;
    gutprop:hasSentenceText "Additionally, they will complete validated questionnaires relating to FODMAP intake, sleep, mental health and QOL before and after a 3-week intervention." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32816830> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32819434_11> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_32819434_11" ;
    gutprop:hasSentenceText "Video abstract." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32819434> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32834004_1> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_32834004_1" ;
    gutprop:hasSentenceText "Microbiome data consists of operational taxonomic unit (OTU) counts characterized by zero-inflation, over-dispersion, and grouping structure among samples." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32834004> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32890382_6> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_32890382_6" ;
    gutprop:hasSentenceText "Negative environment is correlated with different epigenetic modifications in genes implicated in mental health." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32890382> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32890382_7> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_32890382_7" ;
    gutprop:hasSentenceText "Gut microbiota diversity affect host epigenetic." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32890382> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32890382_8> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_32890382_8" ;
    gutprop:hasSentenceText "Animal studies showed evidences for a transgenerational transmission of epigenetic characteristics." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32890382> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32979562_7> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_32979562_7" ;
    gutprop:hasSentenceText "We also identified significant genera and species which were closely related to these KOs." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32979562> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32983561_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_32983561_0" ;
    gutprop:hasSentenceText "Retracted: Exploring the microbiome and mindfulness connection." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/32983561> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32983561_1> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_32983561_1" ;
    gutprop:hasSentenceText "Mental health and its impact on overall well-being is a topic that is at the forefront of consideration in most industrialized countries." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32983561> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32987656_3> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_32987656_3" ;
    gutprop:hasSentenceText "There is currently no cure for the disease." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32987656> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/32999308_3> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_32999308_3" ;
    gutprop:hasSentenceText "For differential diagnosis and preventive treatment, there is an urgent need for the identification of biomarkers indicating early disease stages long before the disease phenotype manifests." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/32999308> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33046051_1> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33046051_1" ;
    gutprop:hasSentenceText "A decade ago, the advancements in the microbiome data sequencing techniques initiated the development of research of the microbiome and its relationship with the host organism." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33046051> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33046051_10> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33046051_10" ;
    gutprop:hasSentenceText "These include using taxa abundances at different taxonomy levels as well as predictive function analysis at different hierarchical levels of KEGG pathways." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33046051> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33046051_11> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33046051_11" ;
    gutprop:hasSentenceText "The highest accuracy of the classification model was obtained at the genus level of taxonomy (76.82%) and the third hierarchical level of KEGG pathways (70.95%)." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33046051> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33046051_13> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33046051_13" ;
    gutprop:hasSentenceText "The significance of this step is to show that the model is not overtrained for a specific dataset but can also be used on other independent datasets." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33046051> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33046051_14> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33046051_14" ;
    gutprop:hasSentenceText "Again, the highest classification model accuracy for both validating datasets combined was obtained at the genus level of taxonomy (70.98%) and third hierarchical level of KEGG pathways (67.24%)." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33046051> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33046051_15> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33046051_15" ;
    gutprop:hasSentenceText "The accuracy of the independent set remained very relevant." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33046051> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33046051_17> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33046051_17" ;
    gutprop:hasSentenceText "The accuracy of the model can be further increased by using sequencing methods that allow higher taxa resolution (i.e." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33046051> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33046051_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33046051_2" ;
    gutprop:hasSentenceText "The development of sophisticated bioinformatics and data science tools for the analysis of large amounts of data followed." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33046051> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33046051_8> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33046051_8" ;
    gutprop:hasSentenceText "The extracted set of statistically significant bacteria from the (Jangi et al, Nat Commun 7:1-11, 2016) dataset samples and their statistically significant predictive functions were used to develop a Random Forest classifier." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33046051> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33046051_9> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33046051_9" ;
    gutprop:hasSentenceText "In total, 8 models based on two criteria: bacteria abundance (at six taxonomic levels) and predictive functions (at two levels), were constructed and evaluated." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33046051> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33063712_1> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33063712_1" ;
    gutprop:hasSentenceText "Neurodegenerative disease etiology is still unclear, but different contributing factors, such as lifestyle and genetic factors are involved." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33063712> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33092203_6> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33092203_6" ;
    gutprop:hasSentenceText "Our distance measure used for clustering is derived from a parametric based mixture model producing sample-specific distributions conditional on the observed operational taxonomic unit (OTU) counts and estimated mixture weights." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33092203> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33092203_7> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33092203_7" ;
    gutprop:hasSentenceText "The method can provide accurate estimates of the true zero proportions and thus construct a precise beta diversity measure." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33092203> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33092203_8> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33092203_8" ;
    gutprop:hasSentenceText "Extensive simulation studies have been conducted and suggest that the proposed method achieves substantial clustering improvement compared with some widely used distance measures when a large proportion of zeros is presented." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33092203> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33144709_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33144709_2" ;
    gutprop:hasSentenceText "To guide future clinical trials and targeted dietary therapies, this review provides an overview of what is currently known regarding underlying mechanisms of action by which diet may influence mental and brain health." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33144709> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33144709_3> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33144709_3" ;
    gutprop:hasSentenceText "The mechanisms of action associating diet with health outcomes are complex, multifaceted, interacting, and not restricted to any one biological pathway." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33144709> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33144709_4> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33144709_4" ;
    gutprop:hasSentenceText "Numerous pathways were identified through which diet could plausibly affect mental health." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33144709> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33144709_6> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33144709_6" ;
    gutprop:hasSentenceText "However, the nascent nature of the nutritional psychiatry field to date means that the existing literature identified in this review is largely comprised of preclinical animal studies." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33144709> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33177907_4> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33177907_4" ;
    gutprop:hasSentenceText "Participants' gut microbiome, plasma cytokines, and self-reported sleep quality and psychopathological symptoms were measured." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33177907> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33194817_5> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33194817_5" ;
    gutprop:hasSentenceText "We analyzed functional genes contributed by the primary genus and evaluated their correlations with clinical indices and host metabolites." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33194817> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33195226_5> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33195226_5" ;
    gutprop:hasSentenceText "We found a significant genotype difference in microbial beta diversity." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33195226> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33240722_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33240722_0" ;
    gutprop:hasSentenceText "Gut-Brain Axis and its Neuro-Psychiatric Effects: A Narrative Review." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/33240722> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33240722_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33240722_2" ;
    gutprop:hasSentenceText "Preliminary evidence suggests its impact on multiple human systems including the nervous and immune systems." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33240722> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33271210_12> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33271210_12" ;
    gutprop:hasSentenceText "This is a relatively new area of research and the number of included studies is limited." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33271210> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33271426_3> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33271426_3" ;
    gutprop:hasSentenceText "Consideration of shared underlying features is essential due to the high rates of comorbidity." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33271426> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33287442_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33287442_2" ;
    gutprop:hasSentenceText "The disease and its treatments exert profound effects on an individual's physical and mental health." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33287442> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33327540_3> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33327540_3" ;
    gutprop:hasSentenceText "Nutritional intervention may be hypothesized as a promising treatment strategy; in particular, it facilitates relapse prevention." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33327540> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33454868_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33454868_2" ;
    gutprop:hasSentenceText "It significantly impairs a patient's physical and mental health." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33454868> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33511258_11> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33511258_11" ;
    gutprop:hasSentenceText "The beneficial effect relied not only on microbial diversity changes but more importantly gut metagenome modulations at the SGB and functional gene levels." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33511258> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33651324_5> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33651324_5" ;
    gutprop:hasSentenceText "We then sequenced the 16S rDNA V3-V4 regions from stool and performed taxonomic assignment using CLC Microbial Genomics Module." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33651324> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33651324_7> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33651324_7" ;
    gutprop:hasSentenceText "All analyses were done in R statistical software." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33651324> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33693453_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33693453_0" ;
    gutprop:hasSentenceText "Diet and the Microbiota-Gut-Brain Axis: Sowing the Seeds of Good Mental Health." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/33693453> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33722869_10> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33722869_10" ;
    gutprop:hasSentenceText "Approval was granted by the University of Melbourne Human Research Ethics Committee (#1749221)." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33722869> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33722869_12> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33722869_12" ;
    gutprop:hasSentenceText "Results will be published in peer-reviewed journals and presented at scientific conferences." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33722869> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33722869_7> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33722869_7" ;
    gutprop:hasSentenceText "Participation is completed within 1 month, and involves comprehensive questionnaires, anthropometrics, a diagnostic clinical interview, collection of two saliva samples, and stool, urine and hair samples." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33722869> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33782648_5> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33782648_5" ;
    gutprop:hasSentenceText "Thus, it is becoming increasingly important to identify compounds that can modulate the multiple pathways that contribute to disease development or progression." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33782648> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33807447_6> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33807447_6" ;
    gutprop:hasSentenceText "Plotting of baseline and end samples emphasized a highly intra-individual microbial composition." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33807447> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33899052_10> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33899052_10" ;
    gutprop:hasSentenceText "Mean quality of life significantly improved (p = .041; d = 1.072) Post-OMM." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33899052> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33899052_7> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33899052_7" ;
    gutprop:hasSentenceText "Biweekly stool samples were assessed for normalized microbiota abundance." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33899052> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33899052_8> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33899052_8" ;
    gutprop:hasSentenceText "The mean Bristol rating improved from type 2 (± 1) Pre-OMM to 3 (± 1; p = .167; d = 0.677) Post-OMM." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33899052> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33967849_14> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33967849_14" ;
    gutprop:hasSentenceText "<b>Systematic Review Registration:</b> PROSPERO, CRD42019137158." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33967849> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/33967849_4> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_33967849_4" ;
    gutprop:hasSentenceText "Study selection, risk of bias appraisal, and data extraction were independently performed by two reviewers." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/33967849> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34002020_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34002020_2" ;
    gutprop:hasSentenceText "The gut-microbiome-endocannabinoid axis might represent a potential modifiable target for interventions." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34002020> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34014031_3> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34014031_3" ;
    gutprop:hasSentenceText "However, the exact functions of these genes remain largely unknown." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34014031> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34032650_9> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34032650_9" ;
    gutprop:hasSentenceText "Larger-scale, well-designed studies are required." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34032650> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34074025_5> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34074025_5" ;
    gutprop:hasSentenceText "The literature concerning MAIT cells in these disorders is rather complex, and sometimes not consistent." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34074025> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34074025_7> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34074025_7" ;
    gutprop:hasSentenceText "The final aims are to explain what activates MAIT cells in diseases not primarily infective, which interactions with the microbiota are potentially pathogenic, and their dynamics related to disease course and disease-modifying treatments." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34074025> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34098340_13> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34098340_13" ;
    gutprop:hasSentenceText "This study was funded by the National Health and Medical Research Council of Australia (1082307, 1147980), Murdoch Children's Research Institute, Barwon Health and Deakin University." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34098340> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34098340_7> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34098340_7" ;
    gutprop:hasSentenceText "Models were adjusted for prenatal diet, smoking, perceived stress, maternal age and sample batch." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34098340> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34147969_11> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34147969_11" ;
    gutprop:hasSentenceText "Detailed mechanisms are unclear." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34147969> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34172092_8> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34172092_8" ;
    gutprop:hasSentenceText "Video Abstract." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34172092> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34216356_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34216356_2" ;
    gutprop:hasSentenceText "Also, microbiome-based therapies have been used to improve health status and treat diseases." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34216356> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34277527_1> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34277527_1" ;
    gutprop:hasSentenceText "Mental health is determined by a complex interplay between the Neurological Exposome and the Human Genome." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34277527> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34277527_11> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34277527_11" ;
    gutprop:hasSentenceText "Such knowledge would help towards achieving tailored integrative treatments, including personalized nutrition." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34277527> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34290352_5> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34290352_5" ;
    gutprop:hasSentenceText "After depressive symptoms improved to a HAMD scale score > 50%, a fecal sample was collected again and used as the follow-up group." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34290352> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34290352_7> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34290352_7" ;
    gutprop:hasSentenceText "The Firmicutes/Bacteroidetes ratio was significantly different within three groups, and the ratio of follow-up group was significantly lower than those of the other two groups." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34290352> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34311029_8> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34311029_8" ;
    gutprop:hasSentenceText "Lastly, instead of direct supplementation, compounds that affect pathways involved with lipid metabolism should also be considered as a way of manipulating lipid levels to improve cognition." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34311029> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34357134_0> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34357134_0" ;
    gutprop:hasSentenceText "Study Protocol: The Evaluation Study for Social Cognition Measures in Japan (ESCoM)." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/title/34357134> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34357134_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34357134_2" ;
    gutprop:hasSentenceText "Although numerous measures have been developed to assess social cognition, only a limited number of them have become available in Japan." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34357134> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34357134_3> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34357134_3" ;
    gutprop:hasSentenceText "We are therefore planning this evaluation study for social cognition measures in Japan (ESCoM) to confirm their psychometric characteristics and to promote research focused on social cognition." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34357134> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34357134_5> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34357134_5" ;
    gutprop:hasSentenceText "In our primary analysis, we will calculate several psychometric indicators with a focus on whether they can independently predict social functioning." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34357134> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34357134_7> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34357134_7" ;
    gutprop:hasSentenceText "The protocol for this study is registered in UMIN-CTR, unique ID UMIN000043777." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34357134> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34357554_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34357554_2" ;
    gutprop:hasSentenceText "The neuroimmune system critically regulates the brain maturation and survival of neurons across the nervous system." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34357554> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34393849_12> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34393849_12" ;
    gutprop:hasSentenceText "Our results provide evidence that may help in the development of therapeutic strategies using microbial-based targets." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34393849> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34393849_13> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34393849_13" ;
    gutprop:hasSentenceText "The data that support the findings of this study have been deposited in the NCBI (https://submit.ncbi.nlm.nih.gov/) with accession number SUB9453991." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34393849> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34399524_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34399524_2" ;
    gutprop:hasSentenceText "Whether these biological consequences are reversible by limiting dietary AGE intake is unknown." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34399524> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34399524_6> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34399524_6" ;
    gutprop:hasSentenceText "These increases were normalized after the switch diet." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34399524> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34399524_9> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34399524_9" ;
    gutprop:hasSentenceText "dominating these alterations." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34399524> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34408160_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34408160_2" ;
    gutprop:hasSentenceText "We hypothesize that the microbiome is the missing link." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34408160> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34422393_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34422393_2" ;
    gutprop:hasSentenceText "The human microbiome consists of bacteria, archaea, fungi, viruses, and phages." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34422393> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34422393_7> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34422393_7" ;
    gutprop:hasSentenceText "Further clarification of these pathways and discovery of diagnostic or therapeutic targets could have broad impacts on global subpopulations." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34422393> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34422879_15> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34422879_15" ;
    gutprop:hasSentenceText "For this to be realized, large-scale cohorts that would include the precise monitoring of food intake, mapping of genetic variants, epigenetic data, microbiome studies, and metabolome, lipidome, and transcriptome data are needed." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34422879> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34422879_5> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34422879_5" ;
    gutprop:hasSentenceText "The complex interplay of all the above-mentioned factors may be a fingerprint of neurodegeneration, with different diseases being affected to different extents by particular factors." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34422879> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34422879_6> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34422879_6" ;
    gutprop:hasSentenceText "There is a voluminous body of evidence showing the benefits of regular exercise to brain health and cognitive functions." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34422879> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34444820_4> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34444820_4" ;
    gutprop:hasSentenceText "Participants completed the Stress Response Inventory, Beck's Depression and Anxiety Inventory, Pittsburg Sleep Quality Index, and Insomnia Severity Index at baseline, at four and eight weeks of treatment." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34444820> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34444820_5> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34444820_5" ;
    gutprop:hasSentenceText "Pre- and post-treatment blood tests for biomarkers were conducted." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34444820> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34589852_5> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34589852_5" ;
    gutprop:hasSentenceText "All of which appear to be interconnected." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34589852> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34589852_6> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34589852_6" ;
    gutprop:hasSentenceText "Key limiting factors for advancing research in this field are research challenges associated with assessing and interpreting inflammatory profiles, microbiota and subjective nutritional assessments, which is further complicated by illness characteristics." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34589852> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34692176_10> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34692176_10" ;
    gutprop:hasSentenceText "Commonly cited published literatures with high quality research methodology/results and additional articles from bibliographies of recovered papers were examined and included where relevant." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34692176> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34692176_16> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34692176_16" ;
    gutprop:hasSentenceText "Identifying the temporal trajectory of biological and psychosocial disturbances may also help to assess their effects and interdependence on individuals' disease status." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34692176> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34692176_18> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34692176_18" ;
    gutprop:hasSentenceText "Furthermore, understanding the interaction between these risk factors may help better interventions in controlling the disease, reducing the costs related to disease management, further implications for clinical practice and research approaches in addition to improving patients' mental health and quality of life." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34692176> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34692176_4> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34692176_4" ;
    gutprop:hasSentenceText "The overarching aim of this review is to evaluate the extent and nature of the interrelationship between these factors with the disease course." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34692176> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34692176_6> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34692176_6" ;
    gutprop:hasSentenceText "Characterization of these interactions holds the promise of identifying novel diagnostic, interventions, and therapeutic strategies." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34692176> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34704023_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34704023_2" ;
    gutprop:hasSentenceText "Dozens of case-control studies have been carried out to identify bacterial markers by the use of targeted metagenomics." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34704023> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34704023_3> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34704023_3" ;
    gutprop:hasSentenceText "Alterations of several taxonomic profiles have been confirmed across several populations, however, no consensus has been made regarding alpha-diversity." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34704023> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34758889_15> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34758889_15" ;
    gutprop:hasSentenceText "Video Abstract." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34758889> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34870091_13> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34870091_13" ;
    gutprop:hasSentenceText "<b>Registration:</b> The study is prospectively registered in PROSPERO, the International Prospective Register of Systematic Reviews (CRD42021260208)." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34870091> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34870091_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34870091_2" ;
    gutprop:hasSentenceText "Recent studies suggest a direct link with mental health through bidirectional gut-brain pathways." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34870091> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34870091_6> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34870091_6" ;
    gutprop:hasSentenceText "We also aim to explore the potential functional impact of any compositional changes." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34870091> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34870091_8> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34870091_8" ;
    gutprop:hasSentenceText "The electronic databases PsycINFO, EMBASE, Web of Science, PubMed/MEDLINE and Cochrane will be systematically searched." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34870091> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34884399_4> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34884399_4" ;
    gutprop:hasSentenceText "The detailed demographic data and medical history were collected using a set of questionnaires." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34884399> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34884399_5> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34884399_5" ;
    gutprop:hasSentenceText "Fecal samples were obtained from all participants." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34884399> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34908715_5> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34908715_5" ;
    gutprop:hasSentenceText "Many factors can change microbiota composition in early life as well as with the increasing age." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34908715> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34961418_6> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34961418_6" ;
    gutprop:hasSentenceText "Incidence rates of adverse reactions were recorded." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34961418> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34985325_6> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34985325_6" ;
    gutprop:hasSentenceText "Moreover, characterization of the microbiome-host cross talk pathways provides insight into novel therapeutic strategies." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34985325> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34988495_7> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_34988495_7" ;
    gutprop:hasSentenceText "Many of the Veteran characteristics examined were associated with altered relative abundances of specific taxa." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34988495> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35069178_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_35069178_2" ;
    gutprop:hasSentenceText "Despite tremendous progress in the field, the exact pathways and mechanisms responsible for the initiation and progression of this disease remain unclear." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35069178> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35083314_6> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_35083314_6" ;
    gutprop:hasSentenceText "Lastly, many taxa associated with increasing chronologic age were anaerobes." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35083314> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35083314_7> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_35083314_7" ;
    gutprop:hasSentenceText "These changes may contribute to changes in human health that occur during the ageing process." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35083314> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35207632_3> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_35207632_3" ;
    gutprop:hasSentenceText "These symptoms not only impact patient quality of life, but also complicate disease management." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35207632> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35317228_1> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_35317228_1" ;
    gutprop:hasSentenceText "For a long time, the central nervous system was believed to be the only regulator of cognitive functions." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35317228> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35317228_6> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_35317228_6" ;
    gutprop:hasSentenceText "The limitations of the methods used at present are also discussed." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35317228> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35565918_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_35565918_2" ;
    gutprop:hasSentenceText "The complexity of the pathogenesis of these diseases means that effective forms of treatment are still lacking." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35565918> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35565918_3> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_35565918_3" ;
    gutprop:hasSentenceText "Conventional therapy is often associated with increasing tolerance and/or drug resistance." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35565918> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35571084_13> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_35571084_13" ;
    gutprop:hasSentenceText "To this end, the <i>C." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35571084> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35571084_4> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_35571084_4" ;
    gutprop:hasSentenceText "We summarize the microbial pro- and anti-neurodegenerative factors identified using the <i>C." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35571084> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35571084_5> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_35571084_5" ;
    gutprop:hasSentenceText "elegans</i> ND models and the effects of many are confirmed in mouse models." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35571084> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35571084_9> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_35571084_9" ;
    gutprop:hasSentenceText "Interestingly, from a list of 59 compounds that showed neuroprotective effects in <i>C." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35571084> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35965349_12> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_35965349_12" ;
    gutprop:hasSentenceText "Many AGP-induced changes in metabolic enzyme expression likely serve to redirect metabolic flux with the potential to regulate bacterial growth or produce metabolites that impact the host." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35965349> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35965349_16> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_35965349_16" ;
    gutprop:hasSentenceText "Video Abstract." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35965349> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35965349_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_35965349_2" ;
    gutprop:hasSentenceText "To mitigate their removal, efficacious alternatives are required." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35965349> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/35965349_4> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_35965349_4" ;
    gutprop:hasSentenceText "However, little is known concerning the underlying mechanisms." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/35965349> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36056574_14> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_36056574_14" ;
    gutprop:hasSentenceText "Future studies with a larger sample size are warranted to confirm our findings." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36056574> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36332796_9> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_36332796_9" ;
    gutprop:hasSentenceText "We conclude that the neurodetrimental effects of western diet (WD) and the neuroprotective effects of Mediterranean diets should be further exploredin humans through clinical trials." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36332796> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36411639_1> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_36411639_1" ;
    gutprop:hasSentenceText "The central nervous system has essential role in the regulation of the physiological condition of the human body." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36411639> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36651663_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_36651663_2" ;
    gutprop:hasSentenceText "To effectively treat these conditions, a comprehensive understanding of all etiological factors is needed." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36651663> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36651663_6> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_36651663_6" ;
    gutprop:hasSentenceText "Microbial diversity and community structure were analyzed, together with relative taxonomic abundance." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36651663> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36698474_1> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_36698474_1" ;
    gutprop:hasSentenceText "The highly processed western diet is substituting the low-processed traditional diet in the last decades globally." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36698474> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36698474_12> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_36698474_12" ;
    gutprop:hasSentenceText "Contrary to China, the corresponding burdens of the USA trended to reduce with the improvements in diet quality and food production sustainability." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36698474> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36698474_5> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_36698474_5" ;
    gutprop:hasSentenceText "We identified an age-related upward pattern in disease burden in China." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36698474> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36699448_5> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_36699448_5" ;
    gutprop:hasSentenceText "We found significant differences in the ACE and Chao indexes of alpha diversity while no discrepancy in beta diversity." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36699448> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36738999_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_36738999_2" ;
    gutprop:hasSentenceText "A growing body of evidence shows that there is a complex relationship between dietary patterns and mental health." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36738999> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36760344_10> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_36760344_10" ;
    gutprop:hasSentenceText "The α-diversity indices of the meditation and control groups differed significantly." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36760344> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36760344_13> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_36760344_13" ;
    gutprop:hasSentenceText "Functional predictive analysis further showed that several pathways-including glycan biosynthesis, metabolism and lipopolysaccharide biosynthesis-were significantly enriched in the meditation group." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36760344> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36760344_15> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_36760344_15" ;
    gutprop:hasSentenceText "Long-term traditional Tibetan Buddhist meditation may positively impact physical and mental health." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36760344> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36760344_18> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_36760344_18" ;
    gutprop:hasSentenceText "Overall, these results suggest that meditation plays a positive role in psychosomatic conditions and well-being." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36760344> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36760344_2> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_36760344_2" ;
    gutprop:hasSentenceText "Meditation, as an inner mental exercise, can positively impact the regulation of an individual's physical and mental health." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36760344> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36760344_9> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_36760344_9" ;
    gutprop:hasSentenceText "In addition, we evaluated biochemical indices in the plasma." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36760344> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36804535_10> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_36804535_10" ;
    gutprop:hasSentenceText "This article is part of the Special Issue on \"Ketamine and its Metabolites\"." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36804535> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36816743_1> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_36816743_1" ;
    gutprop:hasSentenceText "We searched PubMed, Cochrane Library, and Epistemonikos to identify systematic reviews and meta-analysis (SRs)." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36816743> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36816743_12> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_36816743_12" ;
    gutprop:hasSentenceText "Some diseases have been found to have specific flora changes, and some diseases have been found to have common intestinal microbiological changes." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36816743> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36816743_5> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_36816743_5" ;
    gutprop:hasSentenceText "In total, 42 studies were included in this evidence mapping." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36816743> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36816743_6> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_36816743_6" ;
    gutprop:hasSentenceText "Most findings were obtained from observational studies." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36816743> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36816743_9> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_36816743_9" ;
    gutprop:hasSentenceText "A total of 12 diseases were investigated for potential link between beta diversity and disease." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36816743> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36881806_3> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_36881806_3" ;
    gutprop:hasSentenceText "Although there are no approved treatments, there are global efforts underway to find more accurate measures to guide treatment and research." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36881806> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36881806_5> a owl:NamedIndividual,
        gutprop:Sentence ;
