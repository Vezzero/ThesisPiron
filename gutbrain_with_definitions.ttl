<https://w3id.org/hereditary/ontology/gutbrain/resource/species/BacterialMutant> a owl:NamedIndividual,
        skos:Concept,
        gutprop:Species ;
    rdfs:label "Bacterial Mutant" ;
    dcterms:creator "Samuel Piron" ;
    rdfs:comment "A bacterial mutant is a microorganism that has undergone a genetic mutation, resulting in a change to its phenotype or function, often occurring spontaneously or induced by mutagenic agents. [Definition Source: llama3-8b-8192]" ;
    skos:broaderTransitive <http://purl.obolibrary.org/obo/NCBITaxon_2> ;
