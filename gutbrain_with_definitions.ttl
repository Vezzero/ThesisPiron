        <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/ec6626e15ecddd60> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/diseasedisorderorfinding/OleicAcidInducedAcne> a owl:NamedIndividual,
        skos:Concept,
        <https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding> ;
    rdfs:label "Oleic Acid-Induced Acne" ;
    dcterms:creator "Samuel Piron" ;
    rdfs:comment "Oleic_acid-induced_acne refers to a type of acne that is caused by the comedogenic properties of oleic acid, a fatty acid commonly found in certain skincare products and foods. [Definition Source: llama3-8b-8192]" ;
    skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/DiseaseDisorderOrFinding> ;
    gutprop:containedIn <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/17a19ecb40762004> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/diseasedisorderorfinding/PostinfectionDisorders> a owl:NamedIndividual,
        skos:Concept,
        <https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding> ;
    rdfs:label "Postinfection Disorder" ;
    dcterms:creator "Samuel Piron" ;
    rdfs:comment "Postinfection disorders refer to a group of conditions that occur as a result of an infection, often characterized by persistent or recurring symptoms, and can include autoimmune disorders, chronic fatigue syndrome, and fibromyalgia. [Definition Source: llama3-8b-8192]" ;
