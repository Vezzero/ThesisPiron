    rdfs:label "Clostridium Difficile Infection" ;
    rdfs:comment "A Clostridium difficile infection (CDI) is a type of gastrointestinal disease caused by the bacterium Clostridium difficile, characterized by diarrhea, colitis, and pseudomembranous colitis. [Definition Source: llama3-8b-8192]"^^xsd:string,
