        skos:Concept,
        gutprop:StatisticalTechnique ;
    rdfs:label "Randomization" ;
    rdfs:comment "A process involving chance used in therapeutic trials or other research endeavor for allocating experimental subjects, human or animal, between treatment and control groups, or among treatment groups. It may also apply to experiments on inanimate objects. [Definition Source: UMLS]",
