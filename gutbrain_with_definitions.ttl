    rdfs:comment "NCIT Match",
        "The determination of the amount of severe acute respiratory syndrome coronavirus 2 in a sample. [Definition Source: NCIT]" ;
    skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/DiseaseDisorderOrFinding> ;
    gutprop:containedIn <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/2b59befcbb2d4c70> .

<http://purl.obolibrary.org/obo/NCIT_C173382> a owl:NamedIndividual,
        skos:Concept,
        <https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding> ;
    rdfs:label "Covid-19 Terminology" ;
    rdfs:comment "NCIT Match",
        "Term sets created by various sources including NCI EVS to support collection and sharing of data related to research, testing, clinical observations, prevention, diagnosis and treatment for the severe acute respiratory syndrome 2 virus, which is the causative agent of the COVID-19 epidemic. [Definition Source: NCIT]" ;
    skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/DiseaseDisorderOrFinding> ;
    gutprop:affect <http://purl.obolibrary.org/obo/NCIT_C26845> ;
    gutprop:containedIn <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/1ac91510bea60c33>,
        <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/88529c3ac8ebd2dc>,
        <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/b4414394613f6e93>,
