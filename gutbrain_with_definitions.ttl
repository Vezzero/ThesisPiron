    gutprop:impact <http://purl.obolibrary.org/obo/NCBITaxon_656892> .

<https://uts.nlm.nih.gov/uts/umls/concept/C0080093> a owl:NamedIndividual,
        skos:Concept,
        gutprop:Chemical ;
    rdfs:label "N-Methyl-D-Aspartate Receptors" ;
    rdfs:comment "N-Methyl-D-Aspartate Receptors are a type of glutamate-gated ion channel receptors in the brain that play a crucial role in learning, memory, and synaptic plasticity. [Definition Source: llama3-8b-8192]"^^xsd:string,
        "UMLS Match"^^xsd:string ;
    skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/Chemical> ;
