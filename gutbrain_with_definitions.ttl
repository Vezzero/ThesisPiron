<https://w3id.org/hereditary/ontology/gutbrain/resource/species/Short-ChainFattyAcidProducingBacteria> a owl:NamedIndividual,
        skos:Concept,
        gutprop:Species ;
    rdfs:label "Short-Chain Fatty Acid Producing Bacteria" ;
    dcterms:creator "Samuel Piron" ;
    rdfs:comment "Short-chain fatty acid producing bacteria are a type of gut microbiota that convert non-digestible carbohydrates into short-chain fatty acids, primarily acetate, propionate, and butyrate, which play a crucial role in maintaining gut health and immune function. [Definition Source: llama3-8b-8192]" ;
    skos:broaderTransitive <http://purl.obolibrary.org/obo/NCBITaxon_2> ;
    skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/Bacteria> ;
    gutprop:containedIn <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/06c884701a909ade>,
