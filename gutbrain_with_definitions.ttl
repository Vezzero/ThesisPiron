        gutprop:Chemical ;
    rdfs:label "Occludin" ;
    rdfs:comment "Occludin is a transmembrane protein that forms part of the tight junction complex, playing a crucial role in regulating paracellular permeability and maintaining epithelial barrier function. [Definition Source: llama3-8b-8192]"^^xsd:string,
