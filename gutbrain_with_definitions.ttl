<http://purl.obolibrary.org/obo/NCIT_C283> a owl:NamedIndividual,
        skos:Concept,
        gutprop:DietarySupplement ;
    rdfs:label "Artificial Sweetener" ;
    rdfs:comment "A food additive which duplicates the effect of sugar on the taste, but with fewer calories. They are also called sugar substitutes. [Definition Source: NCIT]",
        "NCIT Match" ;
    skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/DietarySupplement> ;
