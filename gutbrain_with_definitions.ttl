<https://uts.nlm.nih.gov/uts/umls/concept/C0020456> a owl:NamedIndividual,
        skos:Concept,
        <https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding> ;
    rdfs:label "Hyperglycemia" ;
    rdfs:comment "Hyperglycemia is a medical condition characterized by elevated blood glucose levels above normal range, typically above 200 mg/dL, often caused by insulin resistance, impaired insulin secretion, or other factors. [Definition Source: llama3-8b-8192]"^^xsd:string,
        "UMLS Match"^^xsd:string ;
    skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/DiseaseDisorderOrFinding> ;
    gutprop:containedIn <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/979fcbe957d1e5b1> .

<https://uts.nlm.nih.gov/uts/umls/concept/C0021831> a owl:NamedIndividual,
        skos:Concept,
        <https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding> ;
    rdfs:label "Intestinal Diseases" ;
    rdfs:comment "Intestinal Diseases: A collective term for a range of disorders affecting the small and large intestines, including inflammatory bowel disease, malabsorption syndromes, and gastrointestinal infections. [Definition Source: llama3-8b-8192]"^^xsd:string,
        "UMLS Match"^^xsd:string ;
    skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/DiseaseDisorderOrFinding> ;
    gutprop:containedIn <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/0b4a212089bb9480> .

<https://uts.nlm.nih.gov/uts/umls/concept/C0023570> a owl:NamedIndividual,
        skos:Concept,
        gutprop:Drug ;
    rdfs:label "Levodopa" ;
    rdfs:comment "The naturally occurring form of DIHYDROXYPHENYLALANINE and the immediate precursor of DOPAMINE. Unlike dopamine itself, it can be taken orally and crosses the blood-brain barrier. It is rapidly taken up by dopaminergic neurons and converted to DOPAMINE. It is used for the treatment of PARKINSONIAN DISORDERS and is usually given with agents that inhibit its conversion to dopamine outside of the central nervous system. [Definition Source: UMLS]",
        "UMLS Match" ;
    skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/Drug> ;
    gutprop:changeEffect <http://purl.obolibrary.org/obo/NCIT_C26845> ;
    gutprop:containedIn <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/282684196a9d8709>,
        <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/af6c9526acea2113>,
        <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/cbf5c8d76e1dbb07> .

<https://uts.nlm.nih.gov/uts/umls/concept/C0023895> a owl:NamedIndividual,
        skos:Concept,
        <https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding> ;
    rdfs:label "Liver Diseases" ;
    rdfs:comment "Liver Diseases refer to a group of disorders that affect the liver, including inflammatory, metabolic, and neoplastic conditions, such as hepatitis, cirrhosis, and liver cancer. [Definition Source: llama3-8b-8192]"^^xsd:string,
        "UMLS Match"^^xsd:string ;
    skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/DiseaseDisorderOrFinding> ;
    gutprop:containedIn <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/8af057aedf863a30> .

<https://uts.nlm.nih.gov/uts/umls/concept/C0024485> a owl:NamedIndividual,
        skos:Concept,
        gutprop:BiomedicalTechnique ;
    rdfs:label "Magnetic Resonance Imaging" ;
    rdfs:comment "Non-invasive method of demonstrating internal anatomy based on the principle that atomic nuclei in a strong magnetic field absorb pulses of radiofrequency energy and emit them as radiowaves which can be reconstructed into computerized images. The concept includes proton spin tomographic techniques. [Definition Source: UMLS]",
        "UMLS Match" ;
    skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/BiomedicalTechnique> ;
    gutprop:containedIn <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/86b37331530f5e63> .

