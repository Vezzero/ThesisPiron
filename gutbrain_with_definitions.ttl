<http://purl.obolibrary.org/obo/OMIT_0004394> a owl:NamedIndividual,
        skos:Concept,
        <https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding> ;
    rdfs:label "Colic" ;
    rdfs:comment "Colic_complaints refers to a set of symptoms typically experienced by infants, including persistent crying, abdominal distension, and drawing up of the legs, often caused by gastrointestinal issues or other underlying conditions. [Definition Source: llama3-8b-8192]",
        "OMIT Match" ;
    skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/DiseaseDisorderOrFinding> ;
