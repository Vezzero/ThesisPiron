<https://uts.nlm.nih.gov/uts/umls/concept/C4699656> a owl:NamedIndividual,
        skos:Concept,
        <https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding> ;
    rdfs:label "Progressive Neurological Conditions" ;
    rdfs:comment "Progressive Neurological Conditions: A group of disorders characterized by a gradual and irreversible decline in neurological function, often affecting cognitive, motor, or sensory abilities, and typically without a cure. [Definition Source: llama3-8b-8192]"^^xsd:string,
        "UMLS Match"^^xsd:string ;
    skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/DiseaseDisorderOrFinding> ;
