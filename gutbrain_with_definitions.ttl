    skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/AnatomicSite> ;
    gutprop:containedIn <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/02a2bd1df0a5e6a2> .

<http://purl.obolibrary.org/obo/NCIT_C131176> a owl:NamedIndividual,
        skos:Concept,
        <https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding> ;
    rdfs:label "Immune-Mediated" ;
    rdfs:comment "NCIT Match",
        "Resulting from the activity of the immune system. [Definition Source: NCIT]" ;
    skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/DiseaseDisorderOrFinding> ;
    gutprop:containedIn <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/0ba404d86c13ff34>,
