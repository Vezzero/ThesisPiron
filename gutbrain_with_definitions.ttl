<https://w3id.org/hereditary/ontology/gutbrain/resource/statisticaltechnique/CochraneRiskOfBias> a owl:NamedIndividual,
        skos:Concept,
        gutprop:StatisticalTechnique ;
    rdfs:label "Cochrane Risk Of Bia" ;
    dcterms:creator "Samuel Piron" ;
    rdfs:comment "Cochrane Risk of Bias is a tool used to assess the quality of evidence in systematic reviews by evaluating the risk of bias in individual studies, considering factors such as randomization, allocation concealment, and blinding. [Definition Source: llama3-8b-8192]" ;
    skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/StatisticalTechnique> ;
    gutprop:containedIn <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/b73db61da80cd915> .

