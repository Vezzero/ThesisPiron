<http://purl.obolibrary.org/obo/OMIT_0002701> a owl:NamedIndividual,
        skos:Concept,
        <https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding> ;
    rdfs:label "Autistic Disorder" ;
    rdfs:comment "Autism-like behavior refers to a set of behavioral characteristics that resemble those typically observed in individuals with autism spectrum disorder (ASD), including difficulties with social interaction, communication, and repetitive behaviors. [Definition Source: llama3-8b-8192]",
        "OMIT Match" ;
    skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/DiseaseDisorderOrFinding> ;
