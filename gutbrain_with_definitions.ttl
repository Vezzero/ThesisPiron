    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36881806> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36881806_6> a owl:NamedIndividual,
        gutprop:Sentence ;
    rdfs:label "sentence_36881806_6" ;
    gutprop:hasSentenceText "]." ;
    gutprop:partOf <https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/36881806> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/36931666_10> a owl:NamedIndividual,
