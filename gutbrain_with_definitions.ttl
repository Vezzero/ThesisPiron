        <http://purl.obolibrary.org/obo/NCIT_C26696> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/food/NormalDiet> a owl:NamedIndividual,
        skos:Concept,
        gutprop:Food ;
    rdfs:label "Normal Diet" ;
    dcterms:creator "Samuel Piron" ;
    rdfs:comment "A normal diet refers to a standard or typical diet that provides adequate nutrition for an individual's needs, without any specific restrictions or modifications. [Definition Source: llama3-8b-8192]" ;
    skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/Food> ;
    gutprop:containedIn <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/d4861ba6c9fc4cc2> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/gene/AlphaSynA53t> a owl:NamedIndividual,
        skos:Concept,
        <https://w3id.org/brainteaser/ontology/schema/Gene> ;
    rdfs:label "Alpha Syn A53T" ;
    dcterms:creator "Samuel Piron" ;
    rdfs:comment "Alpha_syn_a53t is a mutant form of the human alpha-synuclein protein, specifically the A53T variant, which is associated with early-onset Parkinson's disease. [Definition Source: llama3-8b-8192]" ;
    skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/Gene> ;
    gutprop:containedIn <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/0a108d80851642e4>,
        <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/af434f015cdfb25a> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/gene/BaGene> a owl:NamedIndividual,
        skos:Concept,
        <https://w3id.org/brainteaser/ontology/schema/Gene> ;
    rdfs:label "Ba Gene" ;
    dcterms:creator "Samuel Piron" ;
    rdfs:comment "The \"ba_gene\" refers to a gene that is part of the Bacterial Artificial Chromosome (BAC) vector, used for cloning and sequencing large DNA fragments. [Definition Source: llama3-8b-8192]" ;
    skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/Gene> ;
    gutprop:containedIn <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/a07bd0ec853e5968> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/gene/BaiCd> a owl:NamedIndividual,
        skos:Concept,
        <https://w3id.org/brainteaser/ontology/schema/Gene> ;
    rdfs:label "Bai Cd" ;
    dcterms:creator "Samuel Piron" ;
    rdfs:comment "Bai_cd refers to the BAI1 metalloprotease domain-containing protein, a protein involved in various cellular processes, including cell adhesion and migration. [Definition Source: llama3-8b-8192]" ;
    skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/Gene> ;
    gutprop:containedIn <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/b472a4fde2f176d2> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/gene/BdnfMrna> a owl:NamedIndividual,
        skos:Concept,
        <https://w3id.org/brainteaser/ontology/schema/Gene> ;
    rdfs:label "Bdnf Mrna" ;
    dcterms:creator "Samuel Piron" ;
    rdfs:comment "\"bdnf_mrna\" refers to Brain-Derived Neurotrophic Factor messenger RNA, a type of RNA molecule that carries genetic information from DNA to the ribosome for protein synthesis. [Definition Source: llama3-8b-8192]" ;
    skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/Gene> ;
    gutprop:containedIn <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/c794c4f3dd06ee9b> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/gene/CfosMrna> a owl:NamedIndividual,
        skos:Concept,
        <https://w3id.org/brainteaser/ontology/schema/Gene> ;
    rdfs:label "Cfos Mrna" ;
    dcterms:creator "Samuel Piron" ;
    rdfs:comment "cfos_mrna refers to the messenger RNA molecule that encodes the transcription factor C-Fos, a key regulator of gene expression involved in various cellular processes, including cell proliferation, differentiation, and apoptosis. [Definition Source: llama3-8b-8192]" ;
    skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/Gene> ;
    gutprop:containedIn <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/f7b5cfe97c847b3e> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/gene/InflammatoryGene> a owl:NamedIndividual,
        skos:Concept,
        <https://w3id.org/brainteaser/ontology/schema/Gene> ;
    rdfs:label "Inflammatory Gene" ;
    dcterms:creator "Samuel Piron" ;
    rdfs:comment "An inflammatory gene is a gene that is involved in the regulation of the inflammatory response, typically encoding proteins that participate in the activation, recruitment, and signaling of immune cells, as well as the production of pro-inflammatory cytokines and chemokines. [Definition Source: llama3-8b-8192]" ;
    skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/Gene> ;
    gutprop:containedIn <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/71861238c76a54e9> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/gene/IntestinalGene> a owl:NamedIndividual,
        skos:Concept,
        <https://w3id.org/brainteaser/ontology/schema/Gene> ;
    rdfs:label "Intestinal Gene" ;
    dcterms:creator "Samuel Piron" ;
    rdfs:comment "An intestinal gene is a gene that is primarily expressed or functions in the intestines, playing a role in the development, maintenance, or response to the gut environment. [Definition Source: llama3-8b-8192]" ;
    skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/Gene> ;
    gutprop:containedIn <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/f4932208f3b7d245> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/gene/Lagr1Gene> a owl:NamedIndividual,
        skos:Concept,
        <https://w3id.org/brainteaser/ontology/schema/Gene> ;
    rdfs:label "Lagr-1 Gene" ;
    dcterms:creator "Samuel Piron" ;
    rdfs:comment "Lagr-1_gene is a gene that encodes a protein involved in the regulation of axon guidance and neuronal migration during embryonic development in Caenorhabditis elegans. [Definition Source: llama3-8b-8192]" ;
    skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/Gene> ;
    gutprop:containedIn <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/b3056f6e8dca12bb> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/gene/SigaGene> a owl:NamedIndividual,
        skos:Concept,
        <https://w3id.org/brainteaser/ontology/schema/Gene> ;
    rdfs:label "Siga Gene" ;
    dcterms:creator "Samuel Piron" ;
    rdfs:comment "The siga_gene is a gene that encodes the SigA protein, a serine protease involved in the activation of the complement system. [Definition Source: llama3-8b-8192]" ;
    skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/Gene> ;
    gutprop:containedIn <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/9ace027892db7a5a> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/gene/Smadcam-1> a owl:NamedIndividual,
        skos:Concept,
        <https://w3id.org/brainteaser/ontology/schema/Gene> ;
    rdfs:label "Smadcam-1" ;
    dcterms:creator "Samuel Piron" ;
    rdfs:comment "Smadcam-1 is a protein that belongs to the Smad family of transcriptional modulators, specifically a co-factor that interacts with Smad2 and Smad3 to regulate TGF-β signaling pathways. [Definition Source: llama3-8b-8192]" ;
    skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/Gene> ;
    gutprop:containedIn <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/ff4a3a1399cc2f13> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/gene/Sptl3> a owl:NamedIndividual,
        skos:Concept,
        <https://w3id.org/brainteaser/ontology/schema/Gene> ;
    rdfs:label "Sptl-3" ;
    dcterms:creator "Samuel Piron" ;
    rdfs:comment "Sptl-3 is a protein-coding gene in Caenorhabditis elegans that is involved in the regulation of muscle structure and function. [Definition Source: llama3-8b-8192]" ;
    skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/Gene> ;
    gutprop:containedIn <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/92ca1b118f4919f4> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/gene/UreaseAccessoryProteinsUree> a owl:NamedIndividual,
        skos:Concept,
        <https://w3id.org/brainteaser/ontology/schema/Gene> ;
    rdfs:label "Urease Accessory Proteins Uree" ;
    dcterms:creator "Samuel Piron" ;
    rdfs:comment "Urease_accessory_proteins_uree refers to proteins that assist in the enzymatic breakdown of urea into carbon dioxide and ammonia, catalyzed by urease. [Definition Source: llama3-8b-8192]" ;
    skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/Gene> ;
    gutprop:containedIn <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/8bd7f9410ae6c376>,
        <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/c298609a09af2b6d> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/human/AdenocarcinomaPatients> a owl:NamedIndividual,
        skos:Concept,
        gutprop:Human ;
    rdfs:label "Adenocarcinoma Patients" ;
    dcterms:creator "Samuel Piron" ;
    rdfs:comment "Adenocarcinoma_patients refers to individuals diagnosed with adenocarcinoma, a type of cancer that originates in glandular cells and typically affects organs such as the lungs, breast, pancreas, or colon. [Definition Source: llama3-8b-8192]" ;
    skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/Human> ;
    gutprop:containedIn <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/f21436ce402acf91> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/human/AlcoholOverconsumptionGroup> a owl:NamedIndividual,
        skos:Concept,
        gutprop:Human ;
    rdfs:label "Alcohol Overconsumption Group" ;
    dcterms:creator "Samuel Piron" ;
    rdfs:comment "Alcohol_overconsumption_group refers to a group of individuals who exhibit excessive and harmful patterns of alcohol consumption, often characterized by binge drinking, frequent intoxication, and negative consequences on their physical and mental health. [Definition Source: llama3-8b-8192]" ;
    skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/Human> ;
    gutprop:containedIn <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/da794a22d48f9947> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/human/ChronicRestraintStressGroup> a owl:NamedIndividual,
        skos:Concept,
        gutprop:Human ;
    rdfs:label "Chronic Restraint Stress Group" ;
    dcterms:creator "Samuel Piron" ;
    rdfs:comment "The \"chronic_restraint_stress_group\" refers to a group of animals subjected to chronic restraint stress, a type of experimental stress model used to study the effects of prolonged stress on physiological and behavioral responses. [Definition Source: llama3-8b-8192]" ;
    skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/Human> ;
    gutprop:containedIn <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/29c4ed0669f35a85>,
