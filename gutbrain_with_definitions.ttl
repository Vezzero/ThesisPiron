<https://uts.nlm.nih.gov/uts/umls/concept/C0317478> a owl:NamedIndividual,
        skos:Concept,
        gutprop:Species ;
    rdfs:label "Agathobacter Rectalis" ;
    rdfs:comment "A genus of aerobic, Gram-positive, rod shaped bacteria assigned to the phylum Firmicutes. This species is motile, non-spore forming, esculin positive, forms butyrate, produces abundant amounts of hydrogen, and utilizes glucose, cellobiose, melezitose, fructose, sucrose, raffinose, melibiose, starch, and inulin, but not glycerol. E. ractale is one of the most abundant species in the human gastrointestinal tract where it ferments carbohydrates. [Definition Source: UMLS]",
        "UMLS Match" ;
    skos:broaderTransitive <http://purl.obolibrary.org/obo/NCBITaxon_2> ;
    skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/Bacteria> ;
    gutprop:containedIn <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/fdef43bc7dd7865e> .

<https://uts.nlm.nih.gov/uts/umls/concept/C0317519> a owl:NamedIndividual,
        skos:Concept,
        gutprop:Species ;
    rdfs:label "Holdemanella Biformis" ;
    rdfs:comment "Holdemanella biformis is a species of Gram-negative, anaerobic, non-spore-forming bacterium that is commonly found in the human oral cavity and is associated with periodontal disease. [Definition Source: llama3-8b-8192]",
        "UMLS Match" ;
    skos:broaderTransitive <http://purl.obolibrary.org/obo/NCBITaxon_2> ;
