<https://uts.nlm.nih.gov/uts/umls/concept/C0023822> a owl:NamedIndividual,
        skos:Concept,
        gutprop:Chemical ;
    rdfs:label "High Density Lipoprotein Cholesterol" ;
    rdfs:comment "High Density Lipoprotein Cholesterol (HDL-C) is a type of lipoprotein that transports cholesterol from peripheral tissues to the liver for excretion, playing a key role in reverse cholesterol transport and considered a beneficial factor in cardiovascular health. [Definition Source: llama3-8b-8192]"^^xsd:string,
        "UMLS Match"^^xsd:string ;
    skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/Chemical> ;
    gutprop:containedIn <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/465cdc594f7c4bdc> .

<https://uts.nlm.nih.gov/uts/umls/concept/C0024623> a owl:NamedIndividual,
        skos:Concept,
        <https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding> ;
    rdfs:label "Malignant Neoplasm Of Stomach" ;
    rdfs:comment "A malignant neoplasm of the stomach is a type of cancer that originates in the stomach lining and grows uncontrollably, invading surrounding tissues and potentially spreading to other parts of the body. [Definition Source: llama3-8b-8192]"^^xsd:string,
        "UMLS Match"^^xsd:string ;
    skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/DiseaseDisorderOrFinding> ;
    gutprop:affect <http://purl.obolibrary.org/obo/MONDO_0004298> ;
    gutprop:containedIn <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/10b818b04266c133> .

<https://uts.nlm.nih.gov/uts/umls/concept/C0025285> a owl:NamedIndividual,
        skos:Concept,
        <https://w3id.org/brainteaser/ontology/schema/AnatomicalSite> ;
    rdfs:label "Meninges" ;
    rdfs:comment "The three membranes that cover the BRAIN and the SPINAL CORD. They are the dura mater, the arachnoid, and the pia mater. [Definition Source: UMLS]",
        "UMLS Match" ;
    skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/AnatomicSite> ;
    gutprop:containedIn <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/70dbe55f1ab155da> .

<https://uts.nlm.nih.gov/uts/umls/concept/C0025462> a owl:NamedIndividual,
        skos:Concept,
        <https://w3id.org/brainteaser/ontology/schema/AnatomicalSite> ;
    rdfs:label "Midbrain Structure" ;
    rdfs:comment "The middle of the three primitive cerebral vesicles of the embryonic brain. Without further subdivision, midbrain develops into a short, constricted portion connecting the PONS and the DIENCEPHALON. Midbrain contains two major parts, the dorsal TECTUM MESENCEPHALI and the ventral TEGMENTUM MESENCEPHALI, housing components of auditory, visual, and other sensorimoter systems. [Definition Source: UMLS]",
        "UMLS Match" ;
    skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/AnatomicSite> ;
    gutprop:containedIn <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/747c4bda48e16a75> .

