        skos:Concept,
        <https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding> ;
    rdfs:label "Metabolic Diseases" ;
    rdfs:comment "Metabolic Diseases: A group of disorders that result from abnormalities in the body's metabolic processes, including carbohydrate, protein, and fat metabolism, leading to various health problems. [Definition Source: llama3-8b-8192]"^^xsd:string,
        "UMLS Match"^^xsd:string ;
    skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/DiseaseDisorderOrFinding> ;
