<http://purl.obolibrary.org/obo/OMIT_0010167> a owl:NamedIndividual,
        skos:Concept,
        <https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding> ;
    rdfs:label "Muscle Rigidity" ;
    rdfs:comment "Muscle rigidity is a clinical sign characterized by an abnormal stiffness or resistance to passive movement of a muscle or a group of muscles. [Definition Source: llama3-8b-8192]",
