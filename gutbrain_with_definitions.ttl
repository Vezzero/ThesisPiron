    gutprop:target <https://www.ncbi.nlm.nih.gov/mesh/D000293>,
        <https://www.ncbi.nlm.nih.gov/mesh/D002648> .

<http://purl.obolibrary.org/obo/NCIT_C35120> a owl:NamedIndividual,
        skos:Concept,
        <https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding> ;
    rdfs:label "Vasovagal Syncope" ;
    rdfs:comment "An autonomic reflex response to emotional or orthostatic stress, which is characterized by paradoxical hypotension and bradycardia. [Definition Source: NCIT]",
        "NCIT Match" ;
    skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/DiseaseDisorderOrFinding> ;
