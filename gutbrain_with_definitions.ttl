        <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/e297eb1988fff3b8> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/dietarysupplement/MicrobiotaModulator> a owl:NamedIndividual,
        skos:Concept,
        gutprop:DietarySupplement ;
    rdfs:label "Microbiota Modulator" ;
    dcterms:creator "Samuel Piron" ;
    rdfs:comment "A microbiota modulator is a substance or agent that influences the composition, diversity, or function of the microbiota, which refers to the collective microbial communities residing within or on an organism. [Definition Source: llama3-8b-8192]" ;
    skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/DietarySupplement> ;
    gutprop:containedIn <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/5c418b1b5d514288> ;
    gutprop:influence <http://purl.obolibrary.org/obo/OGMS_0000045> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/dietarysupplement/Psychobiotic> a owl:NamedIndividual,
        skos:Concept,
        gutprop:DietarySupplement ;
    rdfs:label "Psychobiotic" ;
    dcterms:creator "Samuel Piron" ;
    rdfs:comment "A psychobiotic is a live microorganism that, when administered in adequate amounts, confers a health benefit on the host by modulating the brain-gut axis and influencing behavior, mood, or cognition. [Definition Source: llama3-8b-8192]" ;
    skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/DietarySupplement> ;
    gutprop:containedIn <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/1d7fef3a84cb9e13>,
        <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/75c5406fd47b31ae> ;
    gutprop:influence <http://purl.obolibrary.org/obo/NCIT_C124639>,
        <http://purl.obolibrary.org/obo/NCIT_C26696> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/diseasedisorderorfinding/AlterationsInTheEnteroendocrineSystem> a owl:NamedIndividual,
        skos:Concept,
        <https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding> ;
    rdfs:label "Alteration In The Enteroendocrine System" ;
    dcterms:creator "Samuel Piron" ;
    rdfs:comment "Alterations_in_the_enteroendocrine_system refers to changes or abnormalities in the functioning of the enteric nervous system and/or the endocrine cells of the gastrointestinal tract, which can affect gut motility, secretion, and hormone regulation. [Definition Source: llama3-8b-8192]" ;
    skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/DiseaseDisorderOrFinding> ;
    gutprop:containedIn <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/2c26be408ddd8753> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/diseasedisorderorfinding/AntipsychoticGeneratedMotilityEffects> a owl:NamedIndividual,
        skos:Concept,
        <https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding> ;
    rdfs:label "Antipsychotic-Generated Motility Effect" ;
    dcterms:creator "Samuel Piron" ;
    rdfs:comment "Antipsychotic-generated motility effects refer to the alteration of movement or motility patterns in the body, such as changes in muscle tone, gait, or movement coordination, that are induced by the use of antipsychotic medications. [Definition Source: llama3-8b-8192]" ;
    skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/DiseaseDisorderOrFinding> ;
    gutprop:containedIn <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/1864d59db29a3645> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/diseasedisorderorfinding/BiliaryAbnormalities> a owl:NamedIndividual,
        skos:Concept,
        <https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding> ;
    rdfs:label "Biliary Abnormality" ;
    dcterms:creator "Samuel Piron" ;
    rdfs:comment "\"Biliary abnormalities refer to any deviation from the normal structure or function of the biliary system, including the liver, bile ducts, and gallbladder.\" [Definition Source: llama3-8b-8192]" ;
    skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/DiseaseDisorderOrFinding> ;
    gutprop:affect <http://purl.obolibrary.org/obo/NCIT_C26845> ;
    gutprop:containedIn <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/44cf8b50575bfa26> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/diseasedisorderorfinding/DeleteriousMetabolicEffect> a owl:NamedIndividual,
        skos:Concept,
        <https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding> ;
    rdfs:label "Deleterious Metabolic Effect" ;
    dcterms:creator "Samuel Piron" ;
    rdfs:comment "A deleterious metabolic effect is a harmful or adverse outcome resulting from an abnormal metabolic process or a metabolic response to a disease or treatment. [Definition Source: llama3-8b-8192]" ;
    skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/DiseaseDisorderOrFinding> ;
    gutprop:containedIn <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/2599613e4f8f3da0> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/diseasedisorderorfinding/GastrointestinalAndMentalHealthSymptoms> a owl:NamedIndividual,
        skos:Concept,
        <https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding> ;
    rdfs:label "Gastrointestinal And Mental Health Symptom" ;
    dcterms:creator "Samuel Piron" ;
    rdfs:comment "\"Gastrointestinal_and_mental_health_symptoms\" refers to a set of symptoms that occur simultaneously in the gastrointestinal and mental health systems, often indicative of a complex condition or disorder. [Definition Source: llama3-8b-8192]" ;
    skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/DiseaseDisorderOrFinding> ;
    gutprop:containedIn <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/11f5f62d85056aa6> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/diseasedisorderorfinding/IncreasingAntibioticResistance> a owl:NamedIndividual,
        skos:Concept,
        <https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding> ;
    rdfs:label "Increasing Antibiotic Resistance" ;
    dcterms:creator "Samuel Piron" ;
    rdfs:comment "Increasing antibiotic resistance refers to the growing ability of microorganisms to withstand the effects of antibiotics, making them less effective in treating infections. [Definition Source: llama3-8b-8192]" ;
    skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/DiseaseDisorderOrFinding> ;
    gutprop:changeAbundance <http://purl.obolibrary.org/obo/NCBITaxon_656892> ;
    gutprop:containedIn <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/fa949d908d9f00aa> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/diseasedisorderorfinding/OligomerizationDisorder> a owl:NamedIndividual,
        skos:Concept,
        <https://w3id.org/brainteaser/ontology/schema/DiseaseDisorderOrFinding> ;
    rdfs:label "Oligomerization Disorder" ;
    dcterms:creator "Samuel Piron" ;
    rdfs:comment "Oligomerization disorder refers to a condition characterized by an abnormal or aberrant formation of protein oligomers, which can lead to various diseases or disorders. [Definition Source: llama3-8b-8192]" ;
    skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/DiseaseDisorderOrFinding> ;
    gutprop:containedIn <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/5e354226ff74a8e6> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/drug/AntibioticGrowthPromotant> a owl:NamedIndividual,
        skos:Concept,
        gutprop:Drug ;
    rdfs:label "Antibiotic Growth Promotant" ;
    dcterms:creator "Samuel Piron" ;
    rdfs:comment "An antibiotic growth promoter is a substance that enhances the growth rate of animals, often used in agriculture, while also promoting the growth of beneficial microorganisms in the gut, thereby improving animal health and reducing the need for antibiotics. [Definition Source: llama3-8b-8192]" ;
    skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/Drug> ;
    gutprop:administered <http://purl.obolibrary.org/obo/NCBITaxon_8782> ;
    gutprop:changeEffect <http://purl.obolibrary.org/obo/NCIT_C3137> ;
    gutprop:containedIn <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/86914dc425e46537>,
        <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/9ba6f625f9e0dbe9>,
        <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/e3106dac190d3a9c> ;
    gutprop:impact <http://purl.obolibrary.org/obo/OHMI_0000020>,
        <https://w3id.org/hereditary/ontology/gutbrain/resource/microbiome/PoultryGutMicrobiome> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/drug/Ct26> a owl:NamedIndividual,
