        skos:Concept,
        gutprop:Drug ;
    rdfs:label "Anti-Anxiety Agents" ;
    rdfs:comment "Agents that alleviate ANXIETY, tension, and ANXIETY DISORDERS, promote sedation, and have a calming effect without affecting clarity of consciousness or neurologic conditions. ADRENERGIC BETA-ANTAGONISTS are commonly used in the symptomatic treatment of anxiety but are not included here. [Definition Source: UMLS]",
        "UMLS Match" ;
    skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/Drug> ;
    gutprop:containedIn <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/9407e50bdf92343f> .

