        gutprop:BiomedicalTechnique ;
    rdfs:label "Metatranscriptomic" ;
    rdfs:comment "Derived from or associated with transcripts from an environmental sample. [Definition Source: UMLS]",
        "UMLS Match" ;
    skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/BiomedicalTechnique> ;
    gutprop:containedIn <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/dc1583d47365eeb5> .

<https://w3id.org/hereditary/ontology/gutbrain/resource/abstract/34448737> a owl:NamedIndividual,
        gutprop:PaperAbstract ;
    rdfs:label "abstract_34448737" ;
    gutprop:composedOf <https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34448737_1>,
        <https://w3id.org/hereditary/ontology/gutbrain/resource/sentence/34448737_2> ;
    gutprop:hasAbstractText "Burgeoning body of evidence from neuroscience is pouring in highlighting a potential association between gut microbiota with the pathophysiology of depression and anxiety. Manipulation of gut microbiota may be then useful to decode this role and to provide novel therapeutics for major depressive disorder (MDD), developing microbiota-related biomarkers to stratify patients at risk and to delineate more homogeneous biotypes of MDD." .

<https://w3id.org/hereditary/ontology/gutbrain/resource/biomedicaltechnique/16sRdnsAnalysis> a owl:NamedIndividual,
        skos:Concept,
        gutprop:BiomedicalTechnique ;
    rdfs:label "16S Rdna Analysis" ;
    dcterms:creator "Samuel Piron" ;
    rdfs:comment "16s_rdna_analysis refers to a type of molecular biology technique that involves the amplification and sequencing of the 16S ribosomal RNA gene to identify and characterize microbial communities. [Definition Source: llama3-8b-8192]" ;
    skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/BiomedicalTechnique> ;
    gutprop:containedIn <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/efc7841b4ade2cd4>,
        <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/f9e90940f1e93344> .

