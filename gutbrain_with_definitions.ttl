    rdfs:label "Headache Disorders" ;
    rdfs:comment "Headache Disorders: A group of conditions characterized by recurring or persistent headaches, often accompanied by other symptoms such as sensitivity to light and sound, nausea, and vomiting. [Definition Source: llama3-8b-8192]"^^xsd:string,
