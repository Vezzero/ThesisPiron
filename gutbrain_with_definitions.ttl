        "FACT-En Questionnaire" ;
    rdfs:comment "A subscale complement to the FACT-G developed specifically for evaluating the quality of life of patients with endometrial cancer. [Definition Source: NCIT]",
        "NCIT Match" ;
    skos:inScheme <https://w3id.org/hereditary/ontology/gutbrain/schema/conceptScheme/AnatomicSite> ;
    gutprop:containedIn <https://w3id.org/hereditary/ontology/gutbrain/resource/mention/d694d81e0716ed38> .

<http://purl.obolibrary.org/obo/NCIT_C119794> a owl:NamedIndividual,
