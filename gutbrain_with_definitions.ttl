<https://uts.nlm.nih.gov/uts/umls/concept/C0018893> a owl:NamedIndividual,
        skos:Concept,
        gutprop:Animal ;
    rdfs:label "Helminths" ;
    rdfs:comment "Commonly known as parasitic worms, this group includes the ACANTHOCEPHALA; NEMATODA; and PLATYHELMINTHS. Some authors consider certain species of LEECHES that can become temporarily parasitic as helminths. [Definition Source: UMLS]",
        "UMLS Match" ;
